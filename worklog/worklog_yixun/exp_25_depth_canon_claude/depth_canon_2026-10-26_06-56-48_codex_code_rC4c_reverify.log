     1	#!/usr/bin/env bash
     2	# ============================================================================
     3	# depth_canon_guardtests.sh -- the launcher guard suite of exp_25 depth_canon
     4	# (plan_depth_canon.md v8 §6 "Launcher guard suite", §4 gates).
     5	#
     6	# Isolation (exp_17 r3 BLOCKING findings): every case runs against a THROWAWAY
     7	# clone in `mktemp -d` -- a `git clone --shared` (objects read through the
     8	# alternates file, nothing written to the source repository) of the source HEAD,
     9	# sparse-checked-out, with the working-tree versions of this round's launcher
    10	# files overlaid and committed INSIDE the clone, `weights/` symlinked read-only.
    11	# Synthetic logs, smoke evidence, checkpoints and stubs (python -> fake trainer
    12	# for `train.py` only, findmnt, df, nvidia-smi) live in the same tmp dir. The
    13	# source repo, its experiment folder and the NAS are never written; the suite
    14	# never moves, hides or deletes a file outside its tmp dir.
    15	#
    16	# Usage (from anywhere, flac env first on PATH):  bash depth_canon_guardtests.sh
    17	# Optional: GUARD_NAS_READONLY=1 adds the production-path DRY_RUN cases, which
    18	# READ the real NAS (findmnt / df / stat of the save root; no writes).
    19	#
    20	# Written by the exp_25 Coder seat (Claude Opus, max effort) per plan_depth_canon.md v8 §4/§6.
    21	# ============================================================================
    22	set -euo pipefail
    23	
    24	SRC_REPO="$(git -C "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" rev-parse --show-toplevel)"
    25	EXPREL="worklog/worklog_yixun/exp_25_depth_canon_claude"
    26	OVERLAY=(depth_canon_launch.sh depth_canon_guardtests.sh depth_canon_make_pins.sh depth_canon_pins.sha256
    27	         depth_canon_audit_gate.py depth_canon_autolaunch.sh)   # rC-F2 3: the watcher too (U15 reads the clone)
    28	H="$(mktemp -d /tmp/depth_canon_guard.XXXXXX)"   # rB-F2 F2-3 (c): /tmp, never $TMPDIR
    29	case "$(readlink -f -- "$H")" in /tmp/depth_canon_guard.??????) ;;
    30	  *) echo "GUARD ABORTED: the tmp root '${H}' does not resolve under /tmp/depth_canon_guard.*"; exit 2 ;; esac
    31	trap 'rm -rf "$H"' EXIT
    32	R="$H/repo"
    33	PASS=0; FAIL=0; SKIP=0
    34	
    35	ok()   { echo "  PASS  $1"; PASS=$((PASS + 1)); }
    36	bad()  { echo "  FAIL  $1${2:+ -- $2}"; FAIL=$((FAIL + 1)); }
    37	skip() { echo "  SKIP  $1${2:+ -- $2}"; SKIP=$((SKIP + 1)); }
    38	FILTERED=0
    39	want() {   # GUARD_ONLY=P,T,...: run only the cases of those sections (the case name's leading letters)
    40	  [ -z "${GUARD_ONLY:-}" ] && return 0
    41	  case ",${GUARD_ONLY}," in *",${1%%[0-9]*},"*) return 0 ;; esac
    42	  FILTERED=$((FILTERED + 1)); return 1
    43	}
    44	expect() { local name="$1"; shift; want "$name" || return 0; if "$@"; then ok "$name"; else bad "$name"; fi; }
    45	
    46	make_clone() {   # a fresh clone of the source HEAD + the overlaid launcher files, committed
    47	  rm -rf "$R"
    48	  git clone -q --shared --no-checkout "$SRC_REPO" "$R"
    49	  git -C "$R" sparse-checkout set --cone src data/AR \
    50	    worklog/worklog_yixun/exp_07_fa_scratch_claude "$EXPREL"
    51	  git -C "$R" checkout -q --detach "$(git -C "$SRC_REPO" rev-parse HEAD)"
    52	  local f
    53	  for f in "${OVERLAY[@]}"; do
    54	    [ -e "$SRC_REPO/$EXPREL/$f" ] && cp "$SRC_REPO/$EXPREL/$f" "$R/$EXPREL/$f"
    55	  done
    56	  ln -s "$SRC_REPO/weights" "$R/weights"
    57	  ( cd "$R" && bash "$EXPREL/depth_canon_make_pins.sh" --write )
    58	  commit_clone "guard overlay"
    59	  write_audit ok || { echo "GUARD ABORTED: make_clone could not build the harness tie-audit fixture (reason above)" >&2; exit 1; }
    60	}
    61	
    62	write_audit() {   # write_audit <mode>: a REAL tie audit (the clone's audit script) of a tiny synthetic tree in
    63	                  # $H/audit_tree, harness-tagged, + sidecar + the harness contract; the audit report is a
    64	                  # PINNED file (rA A1 i), so the manifest is regenerated and the clone committed
    65	  ( cd "$R" && "$REAL_PY" - "$EXPREL" "$1" "$H" <<'PY'
    66	import importlib.util, json, os, shutil, sys
    67	import numpy as np
    68	exp, mode, h = sys.argv[1:4]
    69	spec = importlib.util.spec_from_file_location("guard_tie_audit", os.path.join(exp, "depth_canon_tie_audit.py"))
    70	audit = importlib.util.module_from_spec(spec)
    71	sys.modules[spec.name] = audit
