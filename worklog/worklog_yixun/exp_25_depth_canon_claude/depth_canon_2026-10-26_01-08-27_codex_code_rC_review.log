   163	def read_split_config(config_path):
   164	    """One dataset config -> the fields the loader uses, with the content hashes."""
   165	    with open(_abs(config_path)) as f:
   166	        cfg = json.load(f)
   167	    entries = cfg.get("datasets")
   168	    if not isinstance(entries, list) or len(entries) != 1:
   169	        raise ValueError(f"{config_path}: expected exactly one dataset entry, got {entries!r:.200}")
   170	    entry = entries[0]
   171	    for key in ("path", "json_file_path", "custom_metadata_module", "folder_name"):
