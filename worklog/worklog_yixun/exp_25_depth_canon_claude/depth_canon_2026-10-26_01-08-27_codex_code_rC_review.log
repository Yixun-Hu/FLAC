   328	def main(argv=None):
   329	    import argparse
   330	    repo = _repo_root(os.path.dirname(os.path.abspath(__file__)))
   331	    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   332	    ap.add_argument("--audit", default=os.path.join(repo, EXPREL, "depth_canon_tie_audit.json"))
   333	    ap.add_argument("--repo", default=repo)
   334	    ap.add_argument("--workers", type=int, default=8)
   335	    ap.add_argument("--print-sha", action="store_true", help="on success print only the report's sha256")
   336	    ap.add_argument("--rehash-worker", action="store_true",
   337	                    help="internal: the hasher child (stdin: a JSON list of paths; stdout: their sha256 or null)")
   338	    ap.add_argument("--harness-contract", default=None,
   339	                    help="guard suite only: honoured only under DEPTH_CANON_HARNESS (a /tmp dir with its marker) "
   340	                         "for a file inside it")
   341	    args = ap.parse_args(argv)
   342	    if args.rehash_worker:
   343	        print(json.dumps(_hash_paths(json.load(sys.stdin), args.workers)))
   344	        return 0
   345	    if args.harness_contract is not None:
   346	        h = os.path.realpath(os.environ.get("DEPTH_CANON_HARNESS") or "/nonexistent")
   347	        if not (h.startswith("/tmp/") and os.path.isfile(os.path.join(h, ".depth_canon_harness"))
   348	                and os.path.realpath(args.harness_contract).startswith(h + os.sep)):
   349	            print("TIE AUDIT GATE FAILED: --harness-contract is honoured only inside a guard harness "
   350	                  "(DEPTH_CANON_HARNESS under /tmp with its marker, the file inside it) - abort", file=sys.stderr)
   351	            return 2
   352	    ok, problems, summary = validate_tie_audit(args.audit, args.repo, workers=args.workers,
   353	                                               harness_contract=args.harness_contract)
   354	    if not ok:
   355	        print("TIE AUDIT GATE FAILED: " + "; ".join(problems) + " - abort", file=sys.stderr)
   356	        return 1
   357	    print(summary["audit_sha256"] if args.print_sha else
   358	          f"TIE AUDIT GATE OK: {args.audit} sha256 {summary['audit_sha256']}: {summary['n_maps']} maps "
   359	          "(the registered census), 0 survivors, 0 errors, hashes current, map bytes re-hashed")
   360	    return 0
   361	
   362	
   363	if __name__ == "__main__":
   364	    sys.exit(main())

