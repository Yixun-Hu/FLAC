   345	                  "counts": r["counts"]} for r in rows if r["survivor"]]
   346	    errors = [{"path": r["path"], "error": r["error"]} for r in rows if r["error"]]
   347	    subset = limit is not None or tuple(split_names) != tuple(SPLIT_CONFIGS)
   348	    # precedence (r3b-F1 fix 8): an unprocessed map makes the run INCOMPLETE whatever else it
   349	    # found -- a partially processed run is not an ordinary FAIL; survivors are still listed
   350	    verdict = ("INCOMPLETE" if errors else "FAIL" if survivors
   351	               else "REFUSED_SUBSET" if subset or len(rows) != n_union else "PASS")
   352	    widths = {r["img_w"] for r in rows if r["img_w"] is not None}
   353	    if len(widths) > 1:
   354	        raise ValueError(f"maps of different widths {sorted(widths)}")
   355	    img_w = widths.pop() if widths else 0
   356	    per, agree = summarize(rows, split_names, img_w)
   357	    code = {"script": os.path.relpath(os.path.abspath(__file__), REPO),
