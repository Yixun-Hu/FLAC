   292	def _init_worker(module_path, root_abs, pool_worker=True):
   293	    if pool_worker:  # one torch thread per process; the calling process is left alone
   294	        import torch
   295	        torch.set_num_threads(1)
   296	    _WORKER.update(module=load_metadata_module(module_path), root=root_abs)
