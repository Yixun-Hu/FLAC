   272	                   max_sep_deg=max_circular_sep_deg(cands, W), raw_tie_class=raw_class,
   273	                   raw_survivor=raw_j is None, raw_agree_set=raw_cands == cands,
   274	                   raw_agree_col=raw_survivors == survivors)
   275	    except Exception as err:  # noqa: BLE001 -- recorded, and the gate then refuses PASS
