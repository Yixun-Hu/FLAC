   193	def collect_maps(splits):
   194	    """``{key: {"path", "rep", "counts"}}`` over the union of the splits (deduplicated by
   195	    the resolved depth path; ``rep`` = the smallest item path that resolves to it) and
   196	    the per-split ledger rows ``{split, ..., n_items, n_unique_maps}``."""
   197	    roots = {s["root_abs"] for s in splits.values()}
   198	    modules = {s["custom_metadata_module_abs"] for s in splits.values()}
   199	    if len(roots) != 1 or len(modules) != 1:
   200	        raise ValueError(f"every split must use the same dataset root and metadata module, got "
   201	                         f"roots {sorted(roots)} modules {sorted(modules)}")
   202	    root = roots.pop()
   203	    maps, ledger = {}, []
   204	    for name, split in splits.items():
   205	        items = enumerate_items(split)
   206	        keys = set()
   207	        for item in items:
   208	            path, key = resolve_depth_path(item, root)
   209	            entry = maps.setdefault(key, {"path": os.path.normpath(path), "rep": item,
   210	                                          "counts": {n: 0 for n in splits}})
   211	            if entry["path"] != os.path.normpath(path):
   212	                raise ValueError(f"map key {key} resolves to two paths: {entry['path']} / {path}")
   213	            entry["counts"][name] += 1
   214	            entry["rep"] = min(entry["rep"], item)
   215	            keys.add(key)
   216	        ledger.append(dict(split, split=name, n_items=len(items), n_unique_maps=len(keys)))
   217	    return maps, ledger
