   111	def max_circular_sep_deg(cands, img_w):
   112	    """Largest circular distance between two candidate columns, in degrees (0 for one)."""
   113	    if len(cands) < 2:
   114	        return 0.0
   115	    cols = max(min((a - b) % img_w, (b - a) % img_w) for a in cands for b in cands if a != b)
   116	    return cols * 360.0 / img_w
