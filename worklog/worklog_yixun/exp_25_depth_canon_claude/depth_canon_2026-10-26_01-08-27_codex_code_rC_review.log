   359	            "src/data/dataset.py": "src/data/dataset.py", "custom_metadata_module": module_abs}
   360	    tool = {"script_sha256": _sha256_file(os.path.abspath(__file__)),
   361	            "code_sha256": {k: _sha256_file(_abs(v)) for k, v in code.items()},
   362	            "source_sha": _git("rev-parse", "HEAD"),
