    29	STUB_NVSMI = r'''#!/usr/bin/env bash
    30	# stub: one scenario line per POLL (the index,uuid query opens a poll); the last line repeats.
    31	# rA A3 scenarios exit NONZERO after plausible output (uuidrc / memrc / appsrc), print two memory
    32	# rows (memtwo), or name a process on a uuid outside the map (unknown); GPU 2 is a known other card.
    33	H="$DEPTH_CANON_HARNESS"; n="$(cat "$H/poll_n" 2>/dev/null || echo 0)"
    34	case "$*" in *index,uuid*) n=$((n + 1)); echo "$n" > "$H/poll_n" ;; esac
    35	total="$(wc -l < "$H/gpu_scenario")"; [ "$n" -le "$total" ] || n="$total"; [ "$n" -ge 1 ] || n=1
    36	line="$(sed -n "${n}p" "$H/gpu_scenario")"
    37	case "$*" in *index,uuid*) echo "$*" >> "$H/nvsmi_calls" ;; esac
    38	case "$line" in
    39	  fail) exit 1 ;;
    40	  commit*) case "$*" in *index,uuid*) git -C "$AUTOLAUNCH_TEST_REPO" -c user.name=t -c user.email=t@l \
    41	                                          commit -q --allow-empty -m "a commit after arming" ;; esac ;;
    42	esac
    43	case "$*" in
    44	  *index,uuid*) printf '0, GPU-test-0\n1, GPU-test-1\n2, GPU-test-2\n'; [ "$line" = uuidrc ] && exit 4; true ;;
    45	  *query-compute-apps*) [ "$line" = busy ] && echo "GPU-test-0, 4242, python, 32470 MiB"
    46	                        [ "$line" = busy1 ] && echo "GPU-test-1, 4343, python, 16000 MiB"
    47	                        [ "$line" = other ] && echo "GPU-test-2, 4444, python, 100 MiB"
    48	                        [ "$line" = unknown ] && echo "GPU-test-9, 4545, python, 100 MiB"
    49	                        [ "$line" = garbage ] && echo "garbage"
    50	                        [ "$line" = appsrc ] && exit 5
    51	                        true ;;
    52	  *memory.free*) [ "$line" = lowmem ] && echo 1000 || echo 40000
    53	                 [ "$line" = memtwo ] && echo 40000
    54	                 [ "$line" = memrc ] && exit 3
    55	                 true ;;
    56	esac
    57	'''
    58	FAKE_LAUNCHER = r'''#!/usr/bin/env bash
    59	# fake launcher: records MODE / EXPECT_HEAD; behaviour = the next "MODE rc text" scenario line
    60	H="$DEPTH_CANON_HARNESS"
    61	echo "MODE=${MODE} EXPECT_HEAD=${EXPECT_HEAD} DRY_RUN=${DRY_RUN:-unset} MB=${MB:-unset} ACC=${ACC:-unset}" >> "$H/launch_calls"
    62	env | grep -E '^(GO_TOKEN|AUTOLAUNCH_(LAUNCHER|POLL_S|STABLE_POLLS|MAX_POLLS))=' >> "$H/launch_env" || true
    63	n="$(( $(cat "$H/launch_n" 2>/dev/null || echo 0) + 1 ))"; echo "$n" > "$H/launch_n"
    64	total="$(wc -l < "$H/launch_scenario")"; [ "$n" -le "$total" ] || n="$total"
    65	read -r mode rc text <<<"$(sed -n "${n}p" "$H/launch_scenario")"
    66	[ "$mode" = "$MODE" ] || { echo "fake launcher: expected MODE=$mode, got $MODE"; exit 99; }
    67	sleep "${FAKE_SLEEP:-0}"
    68	echo "$text"
    69	exit "$rc"
    70	'''
