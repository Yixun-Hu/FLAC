   247	def _validate(audit_path, repo_root, c, workers, rehash, harness=False, deadline_s=REHASH_DEADLINE_S):
   248	    problems, summary = [], {}
   249	    try:
   250	        with open(audit_path, "rb") as f:
   251	            raw = f.read()
   252	        with open(audit_path + ".sha256") as f:
   253	            side = f.read()
   254	    except OSError as err:
   255	        return [f"{audit_path} (+ .sha256) unreadable ({err})"], summary
   256	    summary["audit_sha256"] = sha = hashlib.sha256(raw).hexdigest()
   257	    if side != f"{sha}  {os.path.basename(audit_path)}\n":
   258	        problems.append("the sha256 sidecar does not match the audit's bytes")
   259	    try:
   260	        rep = json.loads(raw, parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))
   261	    except ValueError as err:
   262	        return problems + [f"the report is not strict JSON ({err})"], summary
   263	    if harness:   # rA A1 (iv): a harness run validates ONLY a harness-tagged synthetic report
   264	        if type(rep) is not dict or set(rep) != set(REPORT_KEYS) | {"harness"} or rep["harness"] is not True:
   265	            return problems + ["a harness run validates only a harness-tagged report (harness: true)"], summary
   266	    elif type(rep) is not dict or list(rep) != list(REPORT_KEYS):
   267	        keys = list(rep) if type(rep) is dict else type(rep).__name__
   268	        return problems + [f"report keys {keys} != {list(REPORT_KEYS)} (a harness tag is never production)"], summary
   269	    _expect(problems, "schema_version", rep["schema_version"], 1)
   270	    _expect(problems, "gate", rep["gate"], PASS_GATE)
   271	    _expect(problems, "survivors", rep["survivors"], [])
   272	    _expect(problems, "errors", rep["errors"], [])
   273	    _expect(problems, "coverage", rep["coverage"], {"splits": list(SPLIT_NAMES), "limit": None, "subset": False,
   274	                                                   "n_maps_union": c["n_maps"], "n_maps_audited": c["n_maps"],
   275	                                                   "complete": True})
   276	    problems += _tool_problems(rep["tool"], repo_root, c)
   277	    audit = _load_audit_module(os.path.join(repo_root, c["audit_script"]))
   278	    with contextlib.redirect_stdout(io.StringIO()):    # the loader's progress prints are not the verdict
   279	        splits = {n: audit.read_split_config(c["splits"][n]["dataset_config"]) for n in SPLIT_NAMES}
   280	        maps, ledger = audit.collect_maps(splits)
   280	        maps, ledger = audit.collect_maps(splits)
   281	    for n, led in zip(SPLIT_NAMES, ledger):
   282	        if led["n_items"] != c["splits"][n]["n_items"]:
   283	            problems.append(f"{n}: the split JSON holds {led['n_items']} items, not the registered "
   284	                            f"{c['splits'][n]['n_items']}")
   285	        if led["custom_metadata_module"] != c["custom_metadata_module"]:
   286	            problems.append(f"{n}: metadata module {led['custom_metadata_module']} is not the registered one")
   287	    if len(maps) != c["n_maps"]:
   288	        problems.append(f"the splits resolve to {len(maps)} maps, not the registered {c['n_maps']}")
   289	    problems += _ledger_problems(rep["inputs"], ledger)
   290	    row_problems = _row_problems(rep["rows"], maps, audit, c["img_w"])
   291	    problems += row_problems
   292	    if not row_problems:
   293	        per, agree = audit.summarize(rep["rows"], list(SPLIT_NAMES), c["img_w"])
   294	        _expect(problems, "per_split (recomputed from the rows)", rep["per_split"], per)
   295	        _expect(problems, "agreement (recomputed from the rows)", rep["agreement"], agree)
   296	        if rehash:
   297	            problems += _rehash_problems(rep["rows"], maps, workers, deadline_s)
   298	    summary.update(n_maps=len(rep["rows"]) if isinstance(rep["rows"], list) else None,
   299	                   per_split=rep["per_split"],
   300	                   inputs=[{k: led[k] for k in ("split", "json_file_path", "json_abs", "n_items", "n_unique_maps")}
   301	                           for led in ledger],
   302	                   split_maps={n: sorted(k for k, e in maps.items() if e["counts"][n]) for n in SPLIT_NAMES})
   303	    return problems, summary
