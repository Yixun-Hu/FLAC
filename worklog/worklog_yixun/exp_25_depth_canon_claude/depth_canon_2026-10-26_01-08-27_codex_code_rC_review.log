   303	def run_rows(maps, module_path, root_abs, workers, limit=None):
   304	    """Rows in sorted-path order (``imap`` keeps the order whatever ``workers`` is)."""
   305	    tasks = [(k, maps[k]) for k in sorted(maps)][:limit]
   306	    if workers <= 1:
   307	        _init_worker(module_path, root_abs, pool_worker=False)
   308	        return [_task(t) for t in tasks]
   309	    import multiprocessing as mp
   310	    with mp.get_context("fork").Pool(workers, _init_worker, (module_path, root_abs)) as pool:
   311	        return list(pool.imap(_task, tasks, chunksize=8))
