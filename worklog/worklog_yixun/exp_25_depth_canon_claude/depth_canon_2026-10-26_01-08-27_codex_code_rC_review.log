     1	#!/usr/bin/env bash
     2	# ============================================================================
     3	# depth_canon_make_pins.sh -- the content-pin manifest of exp_25's training
     4	# path (plan_depth_canon.md v8 §4 gate (1)). One definition of WHAT is pinned:
     5	# the launcher compares the committed manifest's path column with `--list`
     6	# (coverage) and verifies it with `sha256sum -c --strict` (content).
     7	#
     8	#   --list    the pinned paths, one per line, LC_ALL=C sorted, unique
     9	#   (none)    the manifest on stdout: "<sha256>  <path>" per path, same order
    10	#   --write   (re)write depth_canon_pins.sha256 next to this script (atomic)
    11	#
    12	# Pinned: the fixed files below + every *.py directly inside each GLOB_DIRS
    13	# entry (src/training/losses/ and src/interface/ are imported by the training
    14	# wrapper, so they are pinned too -- a superset of the plan's list). Any missing
    15	# fixed file or empty directory is an error. Deterministic: same tree, same bytes.
    16	#
    17	# Written by the exp_25 Coder seat (Claude Opus, max effort) per plan_depth_canon.md v8 §4.
    18	# ============================================================================
    19	set -euo pipefail
    20	cd "$(git -C "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" rev-parse --show-toplevel)"
    21	EXPDIR="worklog/worklog_yixun/exp_25_depth_canon_claude"
    22	EXP07="worklog/worklog_yixun/exp_07_fa_scratch_claude"
    23	FIXED=(train.py defaults.ini src/__init__.py
    24	       src/configs/dataset_configs/custom_metadata/AR_md.py
    25	       src/configs/dataset_configs/AR/train/acousticroom_train.json data/AR/train.json
    26	       weights/FLAC/VAE.safetensors "$EXP07/FLAC_AR_BVp1.json" "$EXPDIR/FLAC_AR_CANON.json"
    27	       "$EXP07/assert_arm_configs.py"
    28	       "$EXP07/FLAC_AR_BV.json" "$EXP07/FLAC_AR_BF.json"    # opened by assert_arm_configs.py:105 (r3b-F1 fix 5)
    29	       "$EXPDIR/depth_canon_tie_audit.json" "$EXPDIR/depth_canon_tie_audit.json.sha256")   # rA A1 (i): committed + bound
    30	GLOB_DIRS=(src/data src/models src/training src/training/losses src/inference src/interface)
    31	
    32	pin_paths() {
    33	  local p d n
    34	  for p in "${FIXED[@]}"; do
    35	    [ -f "$p" ] || { echo "make_pins: missing pinned file $p" >&2; return 1; }
    36	    echo "$p"
    37	  done
    38	  for d in "${GLOB_DIRS[@]}"; do
    39	    n=0
    40	    for p in "$d"/*.py; do
    41	      [ -f "$p" ] || continue
    42	      echo "$p"; n=$((n + 1))
    43	    done
    44	    [ "$n" -gt 0 ] || { echo "make_pins: no *.py directly inside $d" >&2; return 1; }
    45	  done
    46	}
    47	
    48	PATHS="$(pin_paths | LC_ALL=C sort -u)"
    49	manifest() { local p; while IFS= read -r p; do sha256sum -- "$p"; done <<<"$PATHS"; }
    50	
    51	case "${1:-}" in
    52	  --list)  printf '%s\n' "$PATHS" ;;
    53	  "")      manifest ;;
    54	  --write) tmp="$(mktemp "$EXPDIR/.depth_canon_pins.XXXXXX")"
    55	           manifest > "$tmp" && mv -f "$tmp" "$EXPDIR/depth_canon_pins.sha256"
    56	           echo "wrote $EXPDIR/depth_canon_pins.sha256 ($(wc -l < "$EXPDIR/depth_canon_pins.sha256") files)" ;;
    57	  *)       echo "usage: $0 [--list | --write]" >&2; exit 2 ;;
    58	esac
