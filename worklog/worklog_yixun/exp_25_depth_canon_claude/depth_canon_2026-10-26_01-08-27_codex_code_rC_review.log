   344	# --------------------------------------------------------------------------- #
   345	def test_o_the_state_file_is_always_whole_json(rig):
   346	    token(rig)
   347	    path = rig["exp"] / "depth_canon_autolaunch_state.json"
   348	    seen, bad, stop = [], [], threading.Event()
   349	
   350	    def reader():
   351	        while not stop.is_set():
   352	            try:
   353	                text = path.read_text()
   354	            except FileNotFoundError:
   355	                continue
   356	            try:
   357	                seen.append(json.loads(text)["phase"])
   358	            except ValueError:
   359	                bad.append(text)
   360	    t = threading.Thread(target=reader)
   361	    t.start()
   362	    try:
   363	        rc, _ = run(rig, env={"AUTOLAUNCH_POLL_S": "0.05", "FAKE_SLEEP": "0.3"})
   364	    finally:
   365	        stop.set()
   366	        t.join()
   367	    assert rc == 0 and bad == []
   368	    order = [p for i, p in enumerate(seen) if i == 0 or p != seen[i - 1]]
   369	    assert order[-3:] == ["SMOKE_RUNNING", "FULL_RUNNING", "DONE"] and "WAITING_GPU" in order
   370	    assert not [p for p in os.listdir(rig["exp"]) if "autolaunch_state.json." in p]   # no temp left
