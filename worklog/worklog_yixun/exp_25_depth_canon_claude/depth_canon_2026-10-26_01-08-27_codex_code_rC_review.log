  2995	def test_timed_waits_for_the_requested_cuda_device_not_device_zero():
  2996	    """The reviewer's exact scenario. The kernels are large enough that the CPU
  2997	    runs far ahead of the GPU (launch cost ~1 ms vs ~0.5 s of work), so a
  2998	    synchronization on the WRONG device returns immediately while ours waits."""
  2999	    def queue_work(index, size=8192, iters=12):
  3000	        with torch.cuda.device(index):
  3001	            a = torch.randn(size, size, device=f"cuda:{index}")
  3002	            b = torch.randn(size, size, device=f"cuda:{index}")
  3003	            for _ in range(iters):
  3004	                a = torch.mm(a, b)
  3005	        return a
  3006	
  3007	    for index in (0, 1):                      # warm both CUDA contexts
  3008	        warm = queue_work(index, size=1024, iters=1)
  3009	        torch.cuda.synchronize(index)
  3010	        del warm
  3011	
  3012	    try:
  3013	        torch.cuda.synchronize(1)
  3014	        started = time.perf_counter()
  3015	        held = queue_work(1)

