   121	def run(r, env=None, max_polls=12, harness=True, timeout=120, path_prefix=None):
   122	    e = {k: v for k, v in os.environ.items()
   123	         if not k.startswith(("AUTOLAUNCH_", "DEPTH_CANON_", "GO_TOKEN", "MODE", "EXPECT_HEAD"))}
   124	    e["PATH"] = f"{r['h'] / 'bin'}:{path_prefix or FLAC_BIN}:{os.environ['PATH']}"
   125	    e["AUTOLAUNCH_TEST_REPO"] = str(r["repo"])
   126	    if harness:
   127	        e.update(DEPTH_CANON_HARNESS=str(r["h"]), AUTOLAUNCH_LAUNCHER=str(r["h"] / "fake_launch.sh"),
   128	                 AUTOLAUNCH_POLL_S="0", AUTOLAUNCH_MAX_POLLS=str(max_polls))
   129	    e.update(env or {})
   130	    p = subprocess.run(["bash", str(r["exp"] / "depth_canon_autolaunch.sh")], env=e, capture_output=True,
   131	                       text=True, timeout=timeout, cwd=str(r["h"]))
   132	    return p.returncode, p.stdout + p.stderr
