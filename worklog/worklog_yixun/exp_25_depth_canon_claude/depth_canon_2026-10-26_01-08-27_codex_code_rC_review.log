   109	def _tool_problems(tool, repo_root, c):
   110	    at = lambda p: os.path.join(repo_root, p)  # noqa: E731 -- an absolute p stays absolute
   111	    if type(tool) is not dict or list(tool) != list(TOOL_KEYS):
   112	        return [f"tool {tool!r:.200} is not {{{', '.join(TOOL_KEYS)}}}"]
   113	    out, script = [], _sha256(at(c["audit_script"]))
   114	    if script is None or tool["script_sha256"] != script:
   115	        out.append(f"tool.script_sha256: written by another audit script than {c['audit_script']}")
   116	    want = {"script": script, **{p: _sha256(at(p)) for p in c["code"]},
   117	            "custom_metadata_module": _sha256(at(c["custom_metadata_module"]))}
   118	    _expect(out, "tool.code_sha256 (current files)", tool["code_sha256"], want)
   119	    if not (isinstance(tool["source_sha"], str) and _HEX40.fullmatch(tool["source_sha"])):
   120	        out.append(f"tool.source_sha {tool['source_sha']!r} is not a 40-hex commit")
   121	    if tool["dirty_code"] != "":
   122	        out.append(f"tool.dirty_code {tool['dirty_code']!r}: the audit's code was not clean (or unknown)")
   123	    return out
