   115	def token(r, head=None, manifest=None, by="planner", path=None):
   116	    text = (f"head={head or r['head']}\nmanifest_sha256={manifest or pins_sha(r)}\n"
   117	            f"issued=2026-10-24T02:00:00-04:00\nby={by}\n")
   118	    (path or r["exp"] / "depth_canon_GO.token").write_text(text)
