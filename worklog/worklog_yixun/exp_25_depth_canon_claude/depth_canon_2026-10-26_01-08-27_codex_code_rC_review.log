   143	def _row_problems(rows, maps, audit, w):
   144	    """Per-row type/shape contract, then the census: exactly the expected map set, in the
   145	    audit's sorted order, with the expected per-split counts."""
   146	    if not isinstance(rows, list):
   147	        return [f"rows is {type(rows).__name__}, not a list"]
   148	    bad = []
   149	    for i, r in enumerate(rows):
   150	        why = None
   151	        if type(r) is not dict or list(r) != list(ROW_KEYS):
   152	            why = "row keys are not the audit's"
   153	        elif not (isinstance(r["path"], str) and isinstance(r["sha256"], str) and _HEX64.fullmatch(r["sha256"])):
   154	            why = f"path {r['path']!r} / sha256 {r['sha256']!r} malformed"
   155	        elif not (type(r["counts"]) is dict and list(r["counts"]) == list(SPLIT_NAMES)
   156	                  and all(type(v) is int and v >= 0 for v in r["counts"].values())):
   157	            why = f"counts {r['counts']!r} malformed"
   158	        elif type(r["img_w"]) is not int or r["img_w"] != w:
   159	            why = f"img_w {r['img_w']!r} != {w}"
   160	        elif type(r["j_star"]) is not int or not 0 <= r["j_star"] < w or type(r["dj"]) is not int \
   161	                or r["dj"] != (w - r["j_star"]) % w:
   162	            why = f"j_star {r['j_star']!r} / dj {r['dj']!r} inconsistent"
   163	        elif r["tie_class"] not in TIE_CLASSES or r["survivor"] is not False or r["error"] is not None:
   164	            why = f"tie_class {r['tie_class']!r} / survivor {r['survivor']!r} / error {r['error']!r}"
   165	        elif not (isinstance(r["candidates"], list) and r["candidates"]
   166	                  and all(type(x) is int and 0 <= x < w for x in r["candidates"])
   167	                  and r["candidates"] == sorted(set(r["candidates"])) and r["n_candidates"] == len(r["candidates"])
   168	                  and type(r["n_candidates"]) is int and r["j_star"] in r["candidates"]
   169	                  and r["survivors"] == [r["j_star"]]
   170	                  and (len(r["candidates"]) == 1) == (r["tie_class"] != "cross_column_image")):
   171	            why = "candidates / survivors / class inconsistent"
   172	        elif type(r["max_sep_deg"]) is not float or r["max_sep_deg"] != audit.max_circular_sep_deg(r["candidates"], w):
   173	            why = f"max_sep_deg {r['max_sep_deg']!r} != the candidates' separation"
   174	        elif r["raw_tie_class"] not in TIE_CLASSES + (None,) or (r["raw_tie_class"] is None) != r["raw_survivor"] \
   175	                or not all(type(r[k]) is bool for k in ("raw_survivor", "raw_agree_set", "raw_agree_col")):
   176	            why = "raw_* fields malformed"
   177	        if why:
   178	            bad.append(f"row {i}: {why}")
   179	    out = [f"{len(bad)} malformed row(s): " + "; ".join(bad[:5])] if bad else []
   180	    paths = [r.get("path") if isinstance(r, dict) else None for r in rows]
   181	    if paths != sorted(maps):
   182	        extra, gone = sorted(set(map(str, paths)) - set(maps)), sorted(set(maps) - set(map(str, paths)))
   183	        out.append(f"rows are not the {len(maps)} expected maps in order ({len(paths)} rows, "
   184	                   f"{len(paths) - len(set(map(str, paths)))} duplicate(s), unexpected {extra[:3]}, missing {gone[:3]})")
   185	    elif not bad:
   186	        wrong = [r["path"] for r in rows if r["counts"] != maps[r["path"]]["counts"]]
   187	        if wrong:
   188	            out.append(f"{len(wrong)} row(s) carry counts that are not the split census: {wrong[:3]}")
   189	    return out
