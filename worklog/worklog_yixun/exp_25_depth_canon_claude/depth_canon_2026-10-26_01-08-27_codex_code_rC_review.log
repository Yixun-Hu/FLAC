   314	def summarize(rows, split_names, img_w):
   315	    def cls(r):
   316	        return "error" if r["error"] else ("survivor" if r["survivor"] else r["tie_class"])
   317	    keys = ("none", "same_column", "cross_column_image", "survivor", "error")
   318	    per = {}
   319	    for s in split_names:
   320	        mine = [r for r in rows if r["counts"][s]]
   321	        p = {"maps": dict.fromkeys(keys, 0), "items": dict.fromkeys(keys, 0),
   322	             "dj_histogram_maps": [0] * img_w, "dj_histogram_items": [0] * img_w}
   323	        for r in mine:
   324	            p["maps"][cls(r)] += 1
   325	            p["items"][cls(r)] += r["counts"][s]
   326	            if r["dj"] is not None:
   327	                p["dj_histogram_maps"][r["dj"]] += 1
   328	                p["dj_histogram_items"][r["dj"]] += r["counts"][s]
   329	        per[s] = p
   330	    agree = {f: {"true": sum(r[f] is True for r in rows), "false": sum(r[f] is False for r in rows)}
   331	             for f in ("raw_agree_set", "raw_agree_col")}
   332	    return per, agree
