   126	def _ledger_problems(inputs, ledger):
   127	    """The inputs ledger == the one recomputed now, except the *_abs machine paths, which must
   128	    END with their relative paths (the committed audit validates in any checkout of the pin)."""
   129	    view = lambda led: [{k: v for k, v in r.items() if k not in ABS_FIELDS} if isinstance(r, dict) else r  # noqa: E731
   130	                        for r in led] if isinstance(led, list) else led
   131	    out = []
   132	    _expect(out, "inputs (vs the ledger recomputed from the current configs + split JSONs)", view(inputs),
   133	            view(json.loads(json.dumps(ledger))))
   134	    for i, led in enumerate(inputs if isinstance(inputs, list) else []):
   135	        for key, rel in ABS_FIELDS.items():
   136	            v, r = (led.get(key), led.get(rel)) if isinstance(led, dict) else (None, None)
   137	            if not (isinstance(v, str) and isinstance(r, str) and (
   138	                    v == r if os.path.isabs(r) else os.path.normpath(v).endswith(os.sep + os.path.normpath(r)))):
   139	                out.append(f"inputs[{i}].{key} {v!r} is not a path ending with its {rel} {r!r}")
   140	    return out
