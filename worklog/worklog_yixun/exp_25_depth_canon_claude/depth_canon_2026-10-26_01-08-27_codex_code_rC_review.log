    91	def _sha256(path):
    92	    try:
    93	        h = hashlib.sha256()
    94	        with open(path, "rb") as f:
    95	            for chunk in iter(lambda: f.read(1 << 20), b""):
    96	                h.update(chunk)
    97	        return h.hexdigest()
    98	    except OSError:
    99	        return None
