   255	        if not torch.equal(cloud, ref.permute(2, 0, 1)):
   256	            raise RuntimeError("the cloud AR_md built differs from the resolved file's content")
   257	        W = row["img_w"] = int(cloud.shape[2])
   258	        P = yr.column_profile(yr.recover_depth_proxy(cloud))
   259	        cands = [int(c) for c in torch.nonzero(P == P.max()).flatten().tolist()]
   260	        try:
   261	            _, dj, tie_class = yr.canonicalize_scene_metadata(_canon_md(cloud), W)
   262	            j_star = (W - dj) % W
   263	            if j_star not in cands:
   264	                raise RuntimeError(f"selected column {j_star} is not a candidate {cands}")
   265	            survivors = [j_star]
