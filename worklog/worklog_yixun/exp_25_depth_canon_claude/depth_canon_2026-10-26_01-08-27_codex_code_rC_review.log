   155	def _sha256_file(path):
   156	    h = hashlib.sha256()
   157	    with open(path, "rb") as f:
   158	        for chunk in iter(lambda: f.read(1 << 20), b""):
   159	            h.update(chunk)
   160	    return h.hexdigest()
