   306	def validate_tie_audit(audit_path, repo_root, *, contract=None, workers=8, rehash=True, harness_contract=None,
   307	                       rehash_deadline_s=REHASH_DEADLINE_S):
   308	    """``(ok, problems, summary)``. ``contract`` defaults to :data:`REGISTERED` (tests pass a
   309	    synthetic one). ``harness_contract``: a JSON file naming ONLY the splits / their counts / the
   310	    map count / the metadata module of a guard-suite tree; the report must then be harness-
   311	    tagged (production never accepts one). Any exception is a refusal, never a pass."""
   312	    try:
   313	        c, harness = (REGISTERED if contract is None else contract), harness_contract is not None
   314	        if harness:
   315	            with open(harness_contract) as f:
   316	                over = json.load(f)
   317	            if not isinstance(over, dict) or not set(over) <= set(HARNESS_KEYS):
   318	                return False, [f"the harness contract may name only {list(HARNESS_KEYS)}, got "
   319	                               f"{sorted(over) if isinstance(over, dict) else over!r}"], {}
   320	            c = dict(c, **over)
   321	        problems, summary = _validate(audit_path, os.path.abspath(repo_root), c, workers, rehash, harness,
   322	                                      rehash_deadline_s)
   323	    except Exception as err:  # noqa: BLE001 -- a crash is never a verdict
   324	        problems, summary = [f"validation crashed ({type(err).__name__}: {err})"], {}
   325	    return not problems, problems, summary
