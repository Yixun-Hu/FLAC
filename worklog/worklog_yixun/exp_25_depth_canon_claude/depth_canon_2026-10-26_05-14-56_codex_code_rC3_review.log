   415	    def _update_record_num(self, record_num: int) -> None:
   416	        if not record_num:
   417	            return
   418	        # Currently how we handle offline mode and syncing is not
   419	        # compatible with this assertion due to how the exit record
   420	        # is (mis)handled:
   421	        #   - using "always_send" in offline mode to trigger defer
   422	        #     state machine
   423	        #   - skipping the exit record in `wandb sync` mode so that
   424	        #     it is always executed as the last record
   425	        if not self._settings._offline and not self._settings._sync:
   426	            assert record_num == self._send_record_num + 1
   427	        self._send_record_num = record_num
   428	
   429	    def _update_end_offset(self, end_offset: int) -> None:
   430	        if not end_offset:
   431	            return
   432	        self._send_end_offset = end_offset
