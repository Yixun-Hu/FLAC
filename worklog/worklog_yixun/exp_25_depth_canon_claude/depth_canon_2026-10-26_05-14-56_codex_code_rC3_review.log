  1869	    def finish(
  1870	        self, exit_code: Optional[int] = None, quiet: Optional[bool] = None
  1871	    ) -> None:
  1872	        """Mark a run as finished, and finish uploading all data.
  1873	
  1874	        This is used when creating multiple runs in the same process. We automatically
  1875	        call this method when your script exits or if you use the run context manager.
  1876	
  1877	        Arguments:
  1878	            exit_code: Set to something other than 0 to mark a run as failed
