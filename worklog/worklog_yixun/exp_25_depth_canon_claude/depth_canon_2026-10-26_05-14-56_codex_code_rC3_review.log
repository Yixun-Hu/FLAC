   256	    def _update_summary_metrics(
   257	        self,
   258	        s: "MetricSummary",
   259	        kl: List[str],
   260	        v: "numbers.Real",
   261	        float_v: float,
   262	        goal_max: Optional[bool],
   263	    ) -> bool:
   264	        updated = False
   265	        best_key: Optional[Tuple[str, ...]] = None
   266	        if s.none:
   267	            return False
   268	        if s.copy:
   269	            # non key list copy already done in _update_summary
   270	            if len(kl) > 1:
   271	                _dict_nested_set(self._consolidated_summary, kl, v)
   272	                return True
   273	        if s.last:
   274	            last_key = tuple(kl + ["last"])
   275	            old_last = self._metric_track.get(last_key)
   276	            if old_last is None or float_v != old_last:
   277	                self._metric_track[last_key] = float_v
   278	                _dict_nested_set(self._consolidated_summary, last_key, v)
   279	                updated = True
   280	        if s.best:
   281	            best_key = tuple(kl + ["best"])
   282	        if s.max or best_key and goal_max:
   283	            max_key = tuple(kl + ["max"])
   284	            old_max = self._metric_track.get(max_key)
   285	            if old_max is None or float_v > old_max:
   286	                self._metric_track[max_key] = float_v
   287	                if s.max:
   288	                    _dict_nested_set(self._consolidated_summary, max_key, v)
   289	                    updated = True
   290	                if best_key:
   291	                    _dict_nested_set(self._consolidated_summary, best_key, v)
   292	                    updated = True
   293	        # defaulting to minimize if goal is not supecified
   294	        if s.min or best_key and not goal_max:
   295	            min_key = tuple(kl + ["min"])
   296	            old_min = self._metric_track.get(min_key)
   297	            if old_min is None or float_v < old_min:
   298	                self._metric_track[min_key] = float_v
   299	                if s.min:
   300	                    _dict_nested_set(self._consolidated_summary, min_key, v)
   301	                    updated = True
   302	                if best_key:
   303	                    _dict_nested_set(self._consolidated_summary, best_key, v)
   304	                    updated = True
   305	        if s.mean:
   306	            tot_key = tuple(kl + ["tot"])
   307	            num_key = tuple(kl + ["num"])
   308	            avg_key = tuple(kl + ["mean"])
   309	            tot = self._metric_track.get(tot_key, 0.0)
   310	            num = self._metric_track.get(num_key, 0)
   760	        if self._tb_watcher:
   761	            tbrecord = record.tbrecord
   762	            self._tb_watcher.add(tbrecord.log_dir, tbrecord.save, tbrecord.root_dir)
