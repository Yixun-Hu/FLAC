   195	printf 'WANDB_MODE=%s\n' "${WANDB_MODE-<unset>}" > "$(dirname "$(readlink -f "$0")")/fake_train_wandb_mode"
   196	declare -A A
   197	while [ $# -gt 0 ]; do case "$1" in --*) A["${1#--}"]="${2:-}"; shift 2 ;; *) shift ;; esac; done
   198	sc="${GUARD_SCENARIO:-ok}"; steps="${A[max-steps]}"; cad="${A[checkpoint-every]}"; rate="${GUARD_RATE:-3.9}"
   199	ns="${A[save-dir]}/${A[name]}/${A[experiment-name]}/checkpoints"
   200	stamp() { local t; t="$(python -c "print(int(2 + $1 * $rate))")"
   201	          if [ "$t" -ge 3600 ]; then printf '%d:%02d:%02d' $((t / 3600)) $((t % 3600 / 60)) $((t % 60))
   202	          else printf '%02d:%02d' $((t / 60)) $((t % 60)); fi; }
   203	[ "$sc" = no_ranks ] || echo "All distributed processes registered. Starting with 2 processes"
   204	[ "$sc" = no_banner ] || echo "canonicalize ENABLED img_w=512 tiebreak=image"
   205	if [ "$steps" -le 25 ]; then ns_list="$(seq 1 "$steps")"; else ns_list="1 10 2500 20000 $steps"; fi
   206	for n in $ns_list; do
   207	  loss=0.123; [ "$sc" = nan ] && [ "$n" = "$steps" ] && loss=nan; [ "$sc" = text_loss ] && loss=abc
   208	  post=", train/loss=${loss}"; [ "$sc" = no_loss ] && post=""
   209	  [ "$sc" = no_stamps ] || printf '\rEpoch 0:   0%%|          | %s/4550 [%s<1:00:00,  %ss/it, v_num=ab12%s]' "$n" "$(stamp "$n")" "$rate" "$post"
   210	done
   211	echo
   212	case "$sc" in   # src/training/diffusion.py on_fit_end, rank 0 (r3b-F1 fix 2)
   213	  no_latency) ;;
   214	  bad_latency) echo "canonicalize latency rank0 batches=0 samples=0 total_s=0.000000 mean_ms_per_batch=0.000" ;;
   215	  *) echo "canonicalize latency rank0 batches=${steps} samples=$((steps * 32)) total_s=0.087500 mean_ms_per_batch=3.500" ;;
   216	esac
   217	if [ "$cad" -le "$steps" ] || [ "$sc" = smoke_ckpt ]; then
   218	  mkdir -p "$ns"
   219	  for ((s = cad; s <= steps; s += cad)); do
   220	    [ "$sc" = no_endpoint_ckpt ] && [ "$s" = "$steps" ] && continue
   221	    printf 'ckpt %s\n' "$s" > "$ns/epoch=$((s / 4550))-step=$s.ckpt"
   222	  done
   223	  [ "$sc" = smoke_ckpt ] && printf 'x\n' > "$ns/epoch=0-step=10.ckpt"
   224	  [ "$sc" = foreign ] && printf 'x\n' > "$ns/notes.txt"
   225	  [ "$sc" = wrong_cadence ] && printf 'x\n' > "$ns/epoch=0-step=1234.ckpt"
   226	  [ "$sc" = stale ] && touch -d '2000-01-01 00:00:00' "$ns/epoch=0-step=2500.ckpt"
   227	fi
   228	[ "$sc" = no_endpoint ] || printf '`Trainer.fit` stopped: `max_steps=%s` reached.' "$steps"
   229	exit "${GUARD_TRAIN_RC:-0}"
