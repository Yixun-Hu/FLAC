   270	  if ! token_ok; then CLEAN=0; TOKEN_HEAD=""; write_state WAITING_TOKEN "$TOKEN_WHY (after a passing SMOKE)"; sleep "$POLL_S"; continue; fi
   271	  write_state FULL_RUNNING "MODE=FULL EXPECT_HEAD=${TOKEN_HEAD}"
   272	  rc=0; run_launcher FULL /dev/null || rc=$?       # FULL's output reaches this log through the tee
   273	  FULL_RC="$rc"
   274	  if [ "$rc" -eq 0 ]; then write_state DONE "SMOKE and FULL both exited 0"; exit 0; fi
   275	  write_state FAILED "stage=FULL rc=${rc}"
