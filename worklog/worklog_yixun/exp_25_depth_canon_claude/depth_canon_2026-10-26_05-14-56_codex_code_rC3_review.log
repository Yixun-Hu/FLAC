   228	    def _save_summary(self, summary_dict: SummaryDict, flush: bool = False) -> None:
   229	        summary = SummaryRecord()
   230	        for k, v in summary_dict.items():
   231	            update = summary.update.add()
   232	            update.key = k
   233	            update.value_json = json.dumps(v)
   234	        if flush:
   235	            record = Record(summary=summary)
   236	            self._dispatch_record(record)
   237	        elif not self._settings._offline:
   238	            # Send this summary update as a request since we arent persisting every update
   239	            summary_record = SummaryRecordRequest(summary=summary)
   240	            request_record = self._interface._make_request(
   241	                summary_record=summary_record
   242	            )
   243	            self._dispatch_record(request_record)
