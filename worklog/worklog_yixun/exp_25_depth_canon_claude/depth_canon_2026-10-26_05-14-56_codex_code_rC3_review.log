   165	class Profiler:
   166	    def __init__(self):
   167	        self.ticks = [[time(), None]]
   168	
   169	    def tick(self, msg):
   170	        self.ticks.append([time(), msg])
   171	
   172	    def __repr__(self):
   173	        rep = 80 * "=" + "\n"
   174	        for i in range(1, len(self.ticks)):
   175	            msg = self.ticks[i][1]
   176	            ellapsed = self.ticks[i][0] - self.ticks[i - 1][0]
   177	            rep += msg + f": {ellapsed*1000:.2f}ms\n"
   178	        rep += 80 * "=" + "\n\n\n"
   179	        return rep
