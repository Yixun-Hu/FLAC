   393	        handler_str = "send_request_" + request_type
   394	        send_handler = getattr(self, handler_str, None)
   395	        if request_type != "network_status":
   396	            logger.debug(f"send_request: {request_type}")
   397	        assert send_handler, f"unknown handle: {handler_str}"
   398	        send_handler(record)
