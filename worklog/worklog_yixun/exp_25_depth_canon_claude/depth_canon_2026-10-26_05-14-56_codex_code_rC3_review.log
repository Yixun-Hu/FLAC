   839	def _attach(
   840	    attach_id: Optional[str] = None,
   841	    run_id: Optional[str] = None,
   842	    *,
   843	    run: Optional["Run"] = None,
   844	) -> Union[Run, RunDisabled, None]:
   845	    """Attach to a run currently executing in another process/thread.
   846	
   847	    Arguments:
   848	        attach_id: (str, optional) The id of the run or an attach identifier
   849	            that maps to a run.
   850	        run_id: (str, optional) The id of the run to attach to.
   851	        run: (Run, optional) The run instance to attach
   852	    """
   853	    attach_id = attach_id or run_id
   854	    if not ((attach_id is None) ^ (run is None)):
   855	        raise UsageError("Either (`attach_id` or `run_id`) or `run` must be specified")
   856	
   857	    attach_id = attach_id or (run._attach_id if run else None)
   858	
   859	    if attach_id is None:
   860	        raise UsageError(
   861	            "Either `attach_id` or `run_id` must be specified or `run` must have `_attach_id`"
   862	        )
   863	    wandb._assert_is_user_process()
   864	
   865	    _wl = wandb_setup._setup()
   866	    assert _wl
   867	
   868	    _set_logger(_wl._get_logger())
   869	    if logger is None:
   870	        raise UsageError("logger is not initialized")
   871	
   872	    manager = _wl._get_manager()
   873	    response = manager._inform_attach(attach_id=attach_id) if manager else None
   874	    if response is None:
   875	        raise UsageError(f"Unable to attach to run {attach_id}")
   876	
   877	    settings: Settings = copy.copy(_wl._settings)
   878	    settings.update(
   879	        {
   880	            "run_id": attach_id,
   881	            "_start_time": response["_start_time"],
   882	            "_start_datetime": response["_start_datetime"],
   883	            "_offline": response["_offline"],
   884	        },
   885	        source=Source.INIT,
   886	    )
   887	
   888	    # TODO: consolidate this codepath with wandb.init()
   889	    mailbox = Mailbox()
   890	    backend = Backend(settings=settings, manager=manager, mailbox=mailbox)
   891	    backend.ensure_launched()
   892	    logger.info("attach backend started and connected")
   893	
   894	    if run is None:
   895	        run = Run(settings=settings)
   896	    else:
   897	        run._init(settings=settings)
   898	    run._set_library(_wl)
   899	    run._set_backend(backend)
   900	    backend._hack_set_run(run)
   901	    assert backend.interface
   902	
   903	    mailbox.enable_keepalive()
   904	
   905	    attach_handle = backend.interface.deliver_attach(attach_id)
   906	    # TODO: add progress to let user know we are doing something
   907	    attach_result = attach_handle.wait(timeout=30)
   908	    if not attach_result:
   909	        attach_handle.abandon()
   910	        raise UsageError("Timeout attaching to run")

