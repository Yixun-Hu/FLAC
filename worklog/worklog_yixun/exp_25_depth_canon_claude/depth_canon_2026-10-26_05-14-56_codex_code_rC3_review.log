   980	    def _init_run(
   981	        self,
   982	        run: "RunRecord",
   983	        config_dict: Optional[DictWithValues],
   984	    ) -> None:
   985	        # We subtract the previous runs runtime when resuming
   986	        start_time = (
   987	            run.start_time.ToMicroseconds() / 1e6
   988	        ) - self._resume_state.runtime
   989	        # TODO: we don't check inserted currently, ultimately we should make
   990	        # the upsert know the resume state and fail transactionally
   991	        server_run, inserted, server_messages = self._api.upsert_run(
   992	            name=run.run_id,
   993	            entity=run.entity or None,
   994	            project=run.project or None,
   995	            group=run.run_group or None,
   996	            job_type=run.job_type or None,
   997	            display_name=run.display_name or None,
   998	            notes=run.notes or None,
   999	            tags=run.tags[:] or None,
  1000	            config=config_dict or None,
  1001	            sweep_name=run.sweep_id or None,
  1002	            host=run.host or None,
  1003	            program_path=self._settings.program or None,
  1004	            repo=run.git.remote_url or None,
  1005	            commit=run.git.commit or None,
  1006	        )
  1007	        # TODO: we don't want to create jobs in sweeps, since the
  1008	        # executable doesn't appear to be consistent
  1009	        if hasattr(self._settings, "sweep_id") and self._settings.sweep_id:
  1010	            self._job_builder.disable = True
  1011	
  1012	        self._server_messages = server_messages or []
  1013	        self._run = run
  1014	        if self._resume_state.resumed:
  1015	            self._run.resumed = True
  1016	            if self._resume_state.wandb_runtime is not None:
  1017	                self._run.runtime = self._resume_state.wandb_runtime
  1018	        else:
  1019	            # If the user is not resuming, and we didn't insert on upsert_run then
  1020	            # it is likely that we are overwriting the run which we might want to
  1021	            # prevent in the future.  This could be a false signal since an upsert_run
  1022	            # message which gets retried in the network could also show up as not
  1023	            # inserted.
  1024	            if not inserted:
  1025	                # no need to flush this, it will get updated eventually
  1026	                self._telemetry_obj.feature.maybe_run_overwrite = True
  1027	        self._run.starting_step = self._resume_state.step
  1028	        self._run.start_time.FromMicroseconds(int(start_time * 1e6))
  1029	        self._run.config.CopyFrom(self._interface._make_config(config_dict))
  1030	        if self._resume_state.summary is not None:
  1031	            self._run.summary.CopyFrom(
  1032	                self._interface._make_summary_from_dict(self._resume_state.summary)
  1033	            )
  1034	        storage_id = server_run.get("id")
  1035	        if storage_id:
  1036	            self._run.storage_id = storage_id
  1037	        id = server_run.get("name")
  1038	        if id:
  1039	            self._api.set_current_run_id(id)
  1040	        display_name = server_run.get("displayName")
  1041	        if display_name:
  1042	            self._run.display_name = display_name
  1043	        project = server_run.get("project")
  1044	        # TODO: remove self._api.set_settings, and make self._project a property?
  1045	        if project:
  1540	        wandb._sentry.end_session()
