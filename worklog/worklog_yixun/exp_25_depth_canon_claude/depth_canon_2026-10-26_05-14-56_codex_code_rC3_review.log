   245	    def _save_history(
   246	        self,
   247	        history: HistoryRecord,
   248	    ) -> None:
   249	        for item in history.item:
   250	            # TODO(jhr) save nested keys?
   251	            k = item.key
   252	            v = json.loads(item.value_json)
   253	            if isinstance(v, numbers.Real):
   254	                self._sampled_history[k].add(v)
