   406	    def _flatten(self, dictionary: Dict) -> None:
   407	        if type(dictionary) == dict:
   408	            for k, v in list(dictionary.items()):
   409	                if type(v) == dict:
   410	                    self._flatten(v)
   411	                    dictionary.pop(k)
   412	                    for k2, v2 in v.items():
