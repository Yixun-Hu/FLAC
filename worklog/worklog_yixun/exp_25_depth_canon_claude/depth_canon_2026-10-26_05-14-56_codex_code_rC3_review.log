  1556	    def log(
  1557	        self,
  1558	        data: Dict[str, Any],
  1559	        step: Optional[int] = None,
  1560	        commit: Optional[bool] = None,
  1561	        sync: Optional[bool] = None,
  1562	    ) -> None:
  1563	        """Log a dictonary of data to the current run's history.
  1564	
  1565	        Use `wandb.log` to log data from runs, such as scalars, images, video,
  1566	        histograms, plots, and tables.
  1567	
  1568	        See our [guides to logging](https://docs.wandb.ai/guides/track/log) for
  1569	        live examples, code snippets, best practices, and more.
  1570	
  1571	        The most basic usage is `wandb.log({"train-loss": 0.5, "accuracy": 0.9})`.
  1572	        This will save the loss and accuracy to the run's history and update
  1573	        the summary values for these metrics.
  1574	
  1575	        Visualize logged data in the workspace at [wandb.ai](https://wandb.ai),
  1576	        or locally on a [self-hosted instance](https://docs.wandb.ai/guides/hosting)
  1577	        of the W&B app, or export data to visualize and explore locally, e.g. in
  1578	        Jupyter notebooks, with [our API](https://docs.wandb.ai/guides/track/public-api-guide).
  1579	
  1580	        In the UI, summary values show up in the run table to compare single values across runs.
  1581	        Summary values can also be set directly with `wandb.run.summary["key"] = value`.
  1582	
  1583	        Logged values don't have to be scalars. Logging any wandb object is supported.
  1584	        For example `wandb.log({"example": wandb.Image("myimage.jpg")})` will log an
  1585	        example image which will be displayed nicely in the W&B UI.
  1586	        See the [reference documentation](https://docs.wandb.com/ref/python/data-types)
  1587	        for all of the different supported types or check out our
  1588	        [guides to logging](https://docs.wandb.ai/guides/track/log) for examples,
  1589	        from 3D molecular structures and segmentation masks to PR curves and histograms.
  1590	        `wandb.Table`s can be used to logged structured data. See our
  1591	        [guide to logging tables](https://docs.wandb.ai/guides/data-vis/log-tables)
  1592	        for details.
  1593	
  1594	        Logging nested metrics is encouraged and is supported in the W&B UI.
  1595	        If you log with a nested dictionary like `wandb.log({"train":
  1596	        {"acc": 0.9}, "val": {"acc": 0.8}})`, the metrics will be organized into
  1597	        `train` and `val` sections in the W&B UI.
  1598	
  1599	        wandb keeps track of a global step, which by default increments with each
  1600	        call to `wandb.log`, so logging related metrics together is encouraged.
  1601	        If it's inconvenient to log related metrics together
  1602	        calling `wandb.log({"train-loss": 0.5}, commit=False)` and then
  1603	        `wandb.log({"accuracy": 0.9})` is equivalent to calling
  1604	        `wandb.log({"train-loss": 0.5, "accuracy": 0.9})`.
  1605	
  1606	        `wandb.log` is not intended to be called more than a few times per second.
  1607	        If you want to log more frequently than that it's better to aggregate
  1608	        the data on the client side or you may get degraded performance.
  1609	
  1610	        Arguments:
  1611	            data: (dict, optional) A dict of serializable python objects i.e `str`,
  1612	                `ints`, `floats`, `Tensors`, `dicts`, or any of the `wandb.data_types`.
  1613	            commit: (boolean, optional) Save the metrics dict to the wandb server
  1614	                and increment the step.  If false `wandb.log` just updates the current
  1615	                metrics dict with the data argument and metrics won't be saved until
  1616	                `wandb.log` is called with `commit=True`.
  1617	            step: (integer, optional) The global step in processing. This persists
  1618	                any non-committed earlier steps but defaults to not committing the
  1619	                specified step.
  1620	            sync: (boolean, True) This argument is deprecated and currently doesn't
  1621	                change the behaviour of `wandb.log`.
  1622	
  1623	        Examples:
  1624	            For more and more detailed examples, see
  1625	            [our guides to logging](https://docs.wandb.com/guides/track/log).
  1626	
  1627	            ### Basic usage
  1628	            <!--yeadoc-test:init-and-log-basic-->
  1629	            ```python
  1630	            import wandb
  1631	
  1632	            wandb.init()
  1633	            wandb.log({"accuracy": 0.9, "epoch": 5})
  1634	            ```
  1635	
  1710	            wandb.init()
  1711	            fig, ax = plt.subplots()
  1712	            x = np.linspace(0, 10)
  1713	            y = x * x
  1714	            ax.plot(x, y)  # plot y = x^2
  1715	            wandb.log({"chart": fig})
  1716	            ```
  1717	
  1718	            ### PR Curve
  1719	            ```python
  1720	            wandb.log({"pr": wandb.plots.precision_recall(y_test, y_probas, labels)})
  1721	            ```
  1722	
  1723	            ### 3D Object
  1724	            ```python
  1725	            wandb.log(
  1726	                {
  1727	                    "generated_samples": [
  1728	                        wandb.Object3D(open("sample.obj")),
  1729	                        wandb.Object3D(open("sample.gltf")),
  1730	                        wandb.Object3D(open("sample.glb")),
  1731	                    ]
  1732	                }
  1733	            )
  1734	            ```
  1735	
  1736	        Raises:
  1737	            wandb.Error: if called before `wandb.init`
  1738	            ValueError: if invalid data is passed
  1739	
  1740	        """
  1741	        if sync is not None:
  1742	            deprecate.deprecate(
  1743	                field_name=deprecate.Deprecated.run__log_sync,
  1744	                warning_message=(
  1745	                    "`sync` argument is deprecated and does not affect the behaviour of `wandb.log`"
  1746	                ),
  1747	            )
  1748	        self._log(data=data, step=step, commit=commit)
