   434	    def send_request_sender_read(self, record: "Record") -> None:
   435	        if self._ds is None:
   436	            self._ds = datastore.DataStore()
   437	            self._ds.open_for_scan(self._settings.sync_file)
   438	
   439	        # TODO(cancel_paused): implement cancel_set logic
   440	        # The idea is that there is an active request to cancel a
   441	        # message that is being read from the transaction log below
   442	
   443	        start_offset = record.request.sender_read.start_offset
   444	        final_offset = record.request.sender_read.final_offset
   445	        self._ds.seek(start_offset)
   446	
   447	        current_end_offset = 0
   448	        while current_end_offset < final_offset:
   449	            data = self._ds.scan_data()
   450	            assert data
   451	            current_end_offset = self._ds.get_offset()
   452	
   453	            send_record = wandb_internal_pb2.Record()
   454	            send_record.ParseFromString(data)
   455	            self._update_end_offset(current_end_offset)
   456	            self.send(send_record)
   457	
   458	            # make sure we perform deferred operations
   459	            self.debounce()
   460	
   461	        # make sure that we always update writer for every sended read request
   462	        self._maybe_report_status(always=True)
