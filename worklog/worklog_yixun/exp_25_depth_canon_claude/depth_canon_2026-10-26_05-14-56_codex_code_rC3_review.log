  1593	    def _flush_job(self) -> None:
  1594	        if self._job_builder.disable or self._settings.get("_offline", False):
  1595	            return
  1596	        self._job_builder.set_config(
  1597	            {k: v for k, v in self._consolidated_config.items() if k != "_wandb"}
  1598	        )
  1599	        summary_dict = self._cached_summary.copy()
  1600	        summary_dict.pop("_wandb", None)
  1601	        self._job_builder.set_summary(summary_dict)
  1602	        artifact = self._job_builder.build()
  1603	        if artifact is not None and self._run is not None:
  1604	            proto_artifact = self._interface._make_artifact(artifact)
  1605	            proto_artifact.run_id = self._run.run_id
  1606	            proto_artifact.project = self._run.project
  1607	            proto_artifact.entity = self._run.entity
  1608	            # TODO: this should be removed when the latest tag is handled
  1609	            # by the backend (WB-12116)
  1610	            proto_artifact.aliases.append("latest")

