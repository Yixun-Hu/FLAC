   146	class _CpuMetadataCarrier:
   147	    """exp_25: carries one batch's metadata container, untouched and on the CPU, from
   148	    ``transfer_batch_to_device`` to ``_canonicalize_batch`` (plan_depth_canon.md v8
   149	    §2.2; code review r2 BLOCKING).
   150	
   151	    Deliberately OPAQUE: not a Tensor, list, tuple, dict, namedtuple or dataclass, and
   152	    with no ``.to``. Under DDP on CUDA the step runs through
   153	    ``DistributedDataParallel._pre_forward``, whose ``torch.distributed.utils._to_kwargs``
   154	    -> ``_recursive_to`` (torch 2.7) moves Tensors/PackedSequences and descends only
   155	    into namedtuples and non-empty tuples, lists and dicts, returning every other
   156	    object unchanged -- so metadata inside this carrier is not moved a second time.
   157	    """
   158	
   159	    __slots__ = ("metadata",)
   160	
   161	    def __init__(self, metadata):
   162	        self.metadata = metadata
