   233	# launch <VAR=value ...>: the CLONE's launcher, harness mode, stubs first on PATH; sets OUT, RC
   234	launch() {
   235	  set +e
   236	  OUT="$(cd "$R" && env PATH="$BIN:$PATH" DEPTH_CANON_HARNESS="$H" \
   237	        EXPECT_HEAD="$(git -C "$R" rev-parse HEAD)" "$@" bash "$EXPREL/depth_canon_launch.sh" 2>&1)"
   238	  RC=$?
   239	  set -e
   240	}
   241	# case_rc <name> <want_rc> <want_text> <VAR=value ...>
   242	case_rc() {
   243	  local name="$1" want_rc="$2" want_txt="$3"; shift 3
   244	  want "$name" || return 0
   245	  launch "$@"
   246	  if [ "$RC" = "$want_rc" ] && grep -qF -- "$want_txt" <<<"$OUT"; then ok "$name (rc=$RC)"
   247	  else bad "$name" "want rc=$want_rc + '$want_txt'; got rc=$RC; last: $(tail -1 <<<"$OUT")"; fi
   248	}
   249	argv_of() { grep -m1 '^ARGV: ' <<<"$1" | sed 's/^ARGV: //' || true; }
   250	argval() {   # the token after <flag>, printed only when the flag occurs exactly once
   251	  local -a t; read -r -a t <<<"$1"; local i n=0 v=""
   252	  for ((i = 0; i < ${#t[@]}; i++)); do
   253	    if [ "${t[$i]}" = "$2" ]; then n=$((n + 1)); v="${t[$((i + 1))]:-}"; fi
   254	  done
   255	  [ "$n" -eq 1 ] && printf '%s' "$v"
   256	}
   257	has_value() { [ "$(argval "$1" "$2")" = "$3" ]; }
