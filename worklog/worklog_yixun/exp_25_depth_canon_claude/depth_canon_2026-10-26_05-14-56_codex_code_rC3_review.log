   250	  [ "$CLEAN" -ge "$STABLE_POLLS" ] || { sleep "$POLL_S"; continue; }
   251	  # fire -- the token is re-checked immediately before EACH launcher call
   252	  if ! token_ok; then CLEAN=0; TOKEN_HEAD=""; write_state WAITING_TOKEN "$TOKEN_WHY"; sleep "$POLL_S"; continue; fi
   253	  write_state SMOKE_RUNNING "MODE=SMOKE EXPECT_HEAD=${TOKEN_HEAD}"
   254	  CAP="$EXPDIR/depth_canon_${TS}_autolaunch_smoke_$((RETRIES + 1)).out"
