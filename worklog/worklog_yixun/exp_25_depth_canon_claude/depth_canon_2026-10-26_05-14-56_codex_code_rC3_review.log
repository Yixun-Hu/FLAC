  1566	    def get_local_info(self) -> "LocalInfo":
  1567	        """Queries the server to get the local version information.
  1568	
  1569	        First, we perform an introspection, if it returns empty we deduce that the
  1570	        docker image is out-of-date. Otherwise, we use the returned values to deduce the
  1571	        state of the local server.
  1572	        """
  1573	        local_info = wandb_internal_pb2.LocalInfo()
  1574	        if self._settings._offline:
  1575	            local_info.out_of_date = False
  1576	            return local_info
  1577	
  1578	        latest_local_version = "latest"
  1579	
  1580	        # Assuming the query is successful if the result is empty it indicates that
  1581	        # the backend is out of date since it doesn't have the desired field
  1582	        server_info = self.get_server_info()
  1583	        latest_local_version_info = server_info.get("latestLocalVersionInfo", {})
  1584	        if latest_local_version_info is None:
  1585	            local_info.out_of_date = False
  1586	        else:
  1587	            local_info.out_of_date = latest_local_version_info.get("outOfDate", True)
  1588	            local_info.version = latest_local_version_info.get(
  1589	                "latestVersionString", latest_local_version
  1590	            )
  1591	        return local_info
