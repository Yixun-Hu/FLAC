   765	    def _handle_defined_metric(self, record: Record) -> None:
   766	        metric = record.metric
   767	        if metric._control.overwrite:
   768	            self._metric_defines[metric.name].CopyFrom(metric)
   769	        else:
   770	            self._metric_defines[metric.name].MergeFrom(metric)
   771	
   772	        # before dispatching, make sure step_metric is defined, if not define it and
   773	        # dispatch it locally first
   774	        metric = self._metric_defines[metric.name]
   775	        if metric.step_metric and metric.step_metric not in self._metric_defines:
   776	            m = MetricRecord(name=metric.step_metric)
   777	            self._metric_defines[metric.step_metric] = m
   778	            mr = Record()
   779	            mr.metric.CopyFrom(m)
   780	            mr.control.local = True  # Don't store this, just send it
   781	            self._dispatch_record(mr)
