   793	    def handle_metric(self, record: Record) -> None:
   794	        """Handle MetricRecord.
   795	
   796	        Walkthrough of the life of a MetricRecord:
   797	
   798	        Metric defined:
   799	        - run.define_metric() parses arguments create wandb_metric.Metric
   800	        - build MetricRecord publish to interface
   801	        - handler (this function) keeps list of metrics published:
   802	          - self._metric_defines: Fully defined metrics
   803	          - self._metric_globs: metrics that have a wildcard
   804	        - dispatch writer and sender thread
   805	          - writer: records are saved to persistent store
   806	          - sender: fully defined metrics get mapped into metadata for UI
   807	
   808	        History logged:
   809	        - handle_history
   810	        - check if metric matches _metric_defines
   811	        - if not, check if metric matches _metric_globs
   812	        - if _metric globs match, generate defined metric and call _handle_metric
   813	
   814	        Args:
   815	            record (Record): Metric record to process
   816	        """
   817	        if record.metric.name:
   818	            self._handle_defined_metric(record)
   819	        elif record.metric.glob_name:
   820	            self._handle_glob_metric(record)
