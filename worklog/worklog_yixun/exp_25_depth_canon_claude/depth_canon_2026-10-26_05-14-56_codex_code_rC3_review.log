    38	
    39	_MASK64 = (1 << 64) - 1
    40	# SplitMix64's golden-ratio increment and its two finalising multipliers
    41	# (Steele/Lea/Flood, "Fast splittable pseudorandom number generators").
    42	_SPLITMIX64_GAMMA = 0x9E3779B97F4A7C15
    43	_SPLITMIX64_MIX1 = 0xBF58476D1CE4E5B9
    44	_SPLITMIX64_MIX2 = 0x94D049BB133111EB
    45	
    46	
    47	def _splitmix64(x: int) -> int:
    48	    """One SplitMix64 round: avalanche a 64-bit word into a 64-bit word."""
    49	    z = (x + _SPLITMIX64_GAMMA) & _MASK64
    50	    z = ((z ^ (z >> 30)) * _SPLITMIX64_MIX1) & _MASK64
    51	    z = ((z ^ (z >> 27)) * _SPLITMIX64_MIX2) & _MASK64
    52	    return z ^ (z >> 31)
    53	
    54	
    55	_MASK32 = (1 << 32) - 1
    56	# Domain of the (step, rank) packing below. 2**20 steps is 26x the pre-registered
    57	# 40,000-step budget and 2**12 ranks is 512x the 8-rank rung; both are asserted
    58	# rather than wrapped, because a wrap would silently alias one cell's yaw stream
    59	# onto another's.
    60	_YAW_AUG_RANK_BITS = 12
    61	_YAW_AUG_MAX_RANK = 1 << _YAW_AUG_RANK_BITS
    62	_YAW_AUG_MAX_STEP = 1 << (32 - _YAW_AUG_RANK_BITS)
    63	# Murmur3 fmix32 constants; both multipliers are odd, hence invertible mod 2**32.
    64	_FMIX32_MUL1 = 0x85EBCA6B
    65	_FMIX32_MUL2 = 0xC2B2AE35
    66	
    67	
    68	def _fmix32(x: int) -> int:
    69	    """Murmur3's 32-bit finaliser — a *bijection* of ``[0, 2**32)`` onto itself.
    70	
    71	    Each step is individually invertible (``x ^= x >> k`` for k >= 16 on 32 bits,
    72	    and multiplication by an odd constant mod 2**32), so the composition is a
    73	    permutation: distinct inputs can never collide. That property, not the
    74	    avalanche quality, is what the seed derivation needs.
    75	    """
    76	    x &= _MASK32
    77	    x ^= x >> 16
    78	    x = (x * _FMIX32_MUL1) & _MASK32
    79	    x ^= x >> 13
    80	    x = (x * _FMIX32_MUL2) & _MASK32
    81	    x ^= x >> 16
    82	    return x
    83	
    84	
    85	def _yaw_aug_step_seed(seed: int, step: int, rank: int) -> int:
    86	    """Deterministic generator seed for one (run seed, training step, rank).
    87	
    88	    The yaw offsets of exp_15's augmentation are a pure function of
    89	    ``(yaw_aug.seed, global_step, global_rank, within-batch index)`` — a
    90	    *counter-based* scheme with no stream state (plan §3.1, review F5). Nothing
    91	    is carried between steps, so a run killed at step N and resumed there
    92	    reproduces exactly the draws the uninterrupted run would have made; a
    93	    sequential ``torch.Generator`` would instead have to be checkpointed, and
    94	    PL checkpoints carry no RNG state.
    95	
    96	    **The result is 32 bits wide on purpose** (round-1 code review, finding 1).
    97	    The pinned torch CPU generator seeds MT19937 from the low 32 bits only, so
    98	    ``s`` and ``s + 2**32`` are the same stream: a nominally 63-bit hash bought
    99	    no extra entropy and *did* collide — 10 collisions over the armed 40,000-step
   100	    x 8-rank domain, e.g. (526, 2) and (10156, 7) drew identical yaws. Instead of
   101	    hashing and hoping, the counters are packed into one 32-bit word and mapped
   102	    through a **keyed bijection** of that word:
   103	
   104	        v = (step << 12) | rank                  (injective on the asserted domain)
   105	        out = fmix32(v ^ k_lo) ^ k_hi            (bijections: xor-by-key, fmix32)
   106	
   107	    ``k_lo``/``k_hi`` are the two halves of ``splitmix64(seed)``, so different run
   108	    seeds give unrelated assignments while, *for a fixed seed*, distinct
   109	    ``(step, rank)`` cells provably get distinct effective seeds and therefore
   110	    distinct MT19937 streams. Zero collisions by construction, not by luck.
   111	
   112	    Parameters
   113	    ----------
   114	    seed : int
   115	        The run's ``training.yaw_aug.seed``.
   116	    step : int
   117	        ``global_step`` at this optimisation step, in ``[0, 2**20)``.
   118	    rank : int
   119	        ``global_rank`` of this process, in ``[0, 2**12)``.
   120	
   121	    Returns
   122	    -------
   123	    int
   124	        A seed in ``[0, 2**32)``.
   125	    """
   126	    seed, step, rank = int(seed), int(step), int(rank)
   127	    if not 0 <= step < _YAW_AUG_MAX_STEP:
   128	        raise ValueError(
   129	            f"yaw_aug step must be in [0, {_YAW_AUG_MAX_STEP}), got {step}: outside "
   130	            "that domain the (step, rank) packing is no longer injective"
   131	        )
   132	    if not 0 <= rank < _YAW_AUG_MAX_RANK:
   133	        raise ValueError(
   134	            f"yaw_aug rank must be in [0, {_YAW_AUG_MAX_RANK}), got {rank}: outside "
   135	            "that domain the (step, rank) packing is no longer injective"
   136	        )
   137	
   138	    key = _splitmix64(seed & _MASK64)
   139	    k_lo = key & _MASK32
   140	    k_hi = (key >> 32) & _MASK32
   141	
   142	    v = ((step << _YAW_AUG_RANK_BITS) | rank) & _MASK32
   143	    return _fmix32(v ^ k_lo) ^ k_hi
   144	
