   539	    def send_request_network_status(self, record: "Record") -> None:
   540	        result = proto_util._result_from_record(record)
   541	        status_resp = result.response.network_status_response
   542	        while True:
   543	            try:
   544	                status_resp.network_responses.append(self._retry_q.get_nowait())
   545	            except queue.Empty:
   546	                break
   547	            except Exception as e:
   548	                logger.warning(f"Error emptying retry queue: {e}")
   549	        self._respond_result(result)
