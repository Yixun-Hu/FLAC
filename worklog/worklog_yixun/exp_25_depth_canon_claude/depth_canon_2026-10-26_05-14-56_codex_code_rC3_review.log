   529	    def _debounce_config(self) -> None:
   530	        config_value_dict = self._config_format(self._consolidated_config)
   531	        # TODO(jhr): check result of upsert_run?
   532	        if self._run:
   533	            self._api.upsert_run(
   534	                name=self._run.run_id, config=config_value_dict, **self._api_settings  # type: ignore
   535	            )
   536	        self._config_save(config_value_dict)
   537	        self._config_needs_debounce = False
