   464	    def send_request_check_version(self, record: "Record") -> None:
   465	        assert record.control.req_resp or record.control.mailbox_slot
   466	        result = proto_util._result_from_record(record)
   467	        current_version = (
   468	            record.request.check_version.current_version or wandb.__version__
   469	        )
   470	        messages = update.check_available(current_version)
   471	        if messages:
   472	            upgrade_message = messages.get("upgrade_message")
   473	            if upgrade_message:
   474	                result.response.check_version_response.upgrade_message = upgrade_message
   475	            yank_message = messages.get("yank_message")
   476	            if yank_message:
   477	                result.response.check_version_response.yank_message = yank_message
   478	            delete_message = messages.get("delete_message")
   479	            if delete_message:
   480	                result.response.check_version_response.delete_message = delete_message
   481	        self._respond_result(result)
