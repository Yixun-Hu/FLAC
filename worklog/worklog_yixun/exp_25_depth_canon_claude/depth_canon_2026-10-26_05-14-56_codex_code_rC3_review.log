    20	
    21	class InverseLR(torch.optim.lr_scheduler._LRScheduler):
    22	    """Implements an inverse decay learning rate schedule with an optional exponential
    23	    warmup. When last_epoch=-1, sets initial lr as lr.
    24	    inv_gamma is the number of steps/epochs required for the learning rate to decay to
    25	    (1 / 2)**power of its original value.
    26	    Args:
    27	        optimizer (Optimizer): Wrapped optimizer.
    28	        inv_gamma (float): Inverse multiplicative factor of learning rate decay. Default: 1.
    29	        power (float): Exponential factor of learning rate decay. Default: 1.
    30	        warmup (float): Exponential warmup factor (0 <= warmup < 1, 0 to disable)
    31	            Default: 0.
    32	        final_lr (float): The final learning rate. Default: 0.
    33	        last_epoch (int): The index of last epoch. Default: -1.
    34	        verbose (bool): If ``True``, prints a message to stdout for
    35	            each update. Default: ``False``.
    36	    """
    37	
    38	    def __init__(self, optimizer, inv_gamma=1., power=1., warmup=0., final_lr=0.,
    39	                 last_epoch=-1, verbose=False):
    40	        self.inv_gamma = inv_gamma
    41	        self.power = power
    42	        if not 0. <= warmup < 1:
    43	            raise ValueError('Invalid value for warmup')
    44	        self.warmup = warmup
    45	        self.final_lr = final_lr
    46	        super().__init__(optimizer, last_epoch) # verbose)
    47	
    48	    def get_lr(self):
    49	        if not self._get_lr_called_within_step:
    50	            import warnings
    51	            warnings.warn("To get the last learning rate computed by the scheduler, "
    52	                          "please use `get_last_lr()`.")
    53	
    54	        return self._get_closed_form_lr()
    55	
    56	    def _get_closed_form_lr(self):
    57	        warmup = 1 - self.warmup ** (self.last_epoch + 1)
    58	        lr_mult = (1 + self.last_epoch / self.inv_gamma) ** -self.power
    59	        return [warmup * max(self.final_lr, base_lr * lr_mult)
    60	                for base_lr in self.base_lrs]
    61	
    62	def create_optimizer_from_config(optimizer_config, parameters):
    63	    """Create optimizer from config.
    64	
    65	    Args:
    66	        parameters (iterable): parameters to optimize.
    67	        optimizer_config (dict): optimizer config.
    68	
    69	    Returns:
    70	        torch.optim.Optimizer: optimizer.
    71	    """
    72	
    73	    optimizer_type = optimizer_config["type"]
    74	
    75	    if optimizer_type == "FusedAdam":
    76	        from deepspeed.ops.adam import FusedAdam
    77	        optimizer = FusedAdam(parameters, **optimizer_config["config"])
    78	    else:
    79	        optimizer_fn = getattr(torch.optim, optimizer_type)
    80	        optimizer = optimizer_fn(parameters, **optimizer_config["config"])
    81	    return optimizer
    82	
    83	def create_scheduler_from_config(scheduler_config, optimizer):
    84	    """Create scheduler from config.
    85	
    86	    Args:
    87	        scheduler_config (dict): scheduler config.
    88	        optimizer (torch.optim.Optimizer): optimizer.
    89	
    90	    Returns:
    91	        torch.optim.lr_scheduler._LRScheduler: scheduler.
    92	    """
    93	    if scheduler_config["type"] == "InverseLR":
    94	        scheduler_fn = InverseLR
    95	    else:
    96	        scheduler_fn = getattr(torch.optim.lr_scheduler, scheduler_config["type"])
    97	    scheduler = scheduler_fn(optimizer, **scheduler_config["config"])
    98	    return scheduler
