   166	    def handle_request_defer(self, record: Record) -> None:
   167	        defer = record.request.defer
   168	        state = defer.state
   169	
   170	        logger.info(f"handle defer: {state}")
   171	        # only handle flush tb (sender handles the rest)
   172	        if state == defer.FLUSH_STATS:
   173	            # TODO(jhr): this could block so we dont really want to call shutdown
   174	            # from handler thread
   175	            if self._system_monitor is not None:
   176	                self._system_monitor.finish()
   177	        elif state == defer.FLUSH_TB:
   178	            if self._tb_watcher:
   179	                # shutdown tensorboard workers so we get all metrics flushed
   180	                self._tb_watcher.finish()
   181	                self._tb_watcher = None
   182	        elif state == defer.FLUSH_PARTIAL_HISTORY:
   183	            self._flush_partial_history()
   184	        elif state == defer.FLUSH_SUM:
   185	            self._save_summary(self._consolidated_summary, flush=True)
   186	
   187	        # defer is used to drive the sender finish state machine
   188	        self._dispatch_record(record, always_send=True)
