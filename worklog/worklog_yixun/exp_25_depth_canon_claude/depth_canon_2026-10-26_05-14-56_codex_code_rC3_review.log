   896	    def send_run(self, record: "Record", file_dir: Optional[str] = None) -> None:
   897	        run = record.run
   898	        error = None
   899	        is_wandb_init = self._run is None
   900	
   901	        # save start time of a run
   902	        self._start_time = run.start_time.ToMicroseconds() / 1e6
   903	
   904	        # update telemetry
   905	        if run.telemetry:
   906	            self._telemetry_obj.MergeFrom(run.telemetry)
   907	        if self._settings._sync:
   908	            self._telemetry_obj.feature.sync = True
   909	
   910	        # build config dict
   911	        config_value_dict: Optional[DictWithValues] = None
   912	        if run.config:
   913	            config_util.update_from_proto(self._consolidated_config, run.config)
   914	            config_value_dict = self._config_format(self._consolidated_config)
   915	            self._config_save(config_value_dict)
   916	
   917	        if is_wandb_init:
   918	            # Ensure we have a project to query for status
   919	            if run.project == "":
   920	                run.project = util.auto_project_name(self._settings.program)
   921	            # Only check resume status on `wandb.init`
   922	            error = self._maybe_setup_resume(run)
   923	
   924	        if error is not None:
   925	            if record.control.req_resp or record.control.mailbox_slot:
   926	                result = proto_util._result_from_record(record)
   927	                result.run_result.run.CopyFrom(run)
   928	                result.run_result.error.CopyFrom(error)
   929	                self._respond_result(result)
   930	            else:
   931	                logger.error("Got error in async mode: %s", error.message)
   932	            return
   933	
   934	        # Save the resumed config
   935	        if self._resume_state.config is not None:
   936	            # TODO: should we merge this with resumed config?
   937	            config_override = self._consolidated_config
   938	            config_dict = self._resume_state.config
   939	            config_dict = config_util.dict_strip_value_dict(config_dict)
   940	            config_dict.update(config_override)
   941	            self._consolidated_config.update(config_dict)
   942	            config_value_dict = self._config_format(self._consolidated_config)
   943	            self._config_save(config_value_dict)
   944	
   945	        # handle empty config
   946	        # TODO(jhr): consolidate the 4 ways config is built:
   947	        #            (passed config, empty config, resume config, send_config)
   948	        if not config_value_dict:
   949	            config_value_dict = self._config_format(None)
   950	            self._config_save(config_value_dict)
   951	
   952	        try:
   953	            self._init_run(run, config_value_dict)
   954	        except (CommError, UsageError) as e:
   955	            logger.error(e, exc_info=True)
   956	            if record.control.req_resp or record.control.mailbox_slot:
   957	                result = proto_util._result_from_record(record)
   958	                result.run_result.run.CopyFrom(run)
   959	                error = ProtobufErrorHandler.from_exception(e)
   960	                result.run_result.error.CopyFrom(error)
   961	                self._respond_result(result)
   962	            return
   963	
   964	        assert self._run  # self._run is configured in _init_run()
   965	
   966	        if record.control.req_resp or record.control.mailbox_slot:
   967	            result = proto_util._result_from_record(record)
   968	            # TODO: we could do self._interface.publish_defer(resp) to notify
   969	            # the handler not to actually perform server updates for this uuid
   970	            # because the user process will send a summary update when we resume
   971	            result.run_result.run.CopyFrom(self._run)
   972	            self._respond_result(result)
   973	
   974	        # Only spin up our threads on the first run message
   975	        if is_wandb_init:
   976	            self._start_run_threads(file_dir)
   977	        else:
   978	            logger.info("updated run: %s", self._run.run_id)
