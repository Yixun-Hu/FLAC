   496	    def _maybe_update_config(self, always: bool = False) -> None:
   497	        time_now = time.monotonic()
   498	        if (
   499	            not always
   500	            and time_now < self._debounce_config_time + self.UPDATE_CONFIG_TIME
   501	        ):
   502	            return
   503	        if self._config_needs_debounce:
   504	            self._debounce_config()
   505	        self._debounce_config_time = time_now
   506	
   507	    def _maybe_report_status(self, always: bool = False) -> None:
   508	        time_now = time.monotonic()
   509	        if (
   510	            not always
   511	            and time_now < self._debounce_status_time + self.UPDATE_STATUS_TIME
   512	        ):
   513	            return
   514	        self._debounce_status_time = time_now
   515	
   516	        status_report = wandb_internal_pb2.StatusReportRequest(
   517	            record_num=self._send_record_num,
   518	            sent_offset=self._send_end_offset,
   519	        )
   520	        status_time = time.time()
   521	        status_report.sync_time.FromMicroseconds(int(status_time * 1e6))
   522	        record = self._interface._make_request(status_report=status_report)
   523	        self._interface._publish(record)
   524	
   525	    def debounce(self, final: bool = False) -> None:
   526	        self._maybe_report_status(always=final)
   527	        self._maybe_update_config(always=final)
