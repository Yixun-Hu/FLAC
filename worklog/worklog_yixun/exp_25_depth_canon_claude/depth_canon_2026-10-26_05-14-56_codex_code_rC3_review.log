     1	# -*- coding: utf-8 -*-
     2	__author__ = 'S.H. Hawley'
     3	
     4	"""
     5	Routines for easily keeping track of & archiving run configurations.
     6	Supports config (.ini) files, pulling previous configs from WandB, 
     7	and overrides with command-line options.
     8	"""
     9	
    10	from pathlib import Path
    11	from ast import literal_eval 
    12	import argparse
    13	import configparser
    14	import wandb
    15	import sys
    16	import copy
    17	import distutils
    18	
    19	DEFAULTS_FILE = 'defaults.ini'
    20	
    21	def arg_eval(value):
    22	    "this just packages some type checking for parsing args"
    23	    try: 
    24	        val = literal_eval(str(value))
    25	    except (SyntaxError, ValueError, AssertionError):
    26	        val = value
    27	    return val
    28	
    29	def setup_gin(gin_file):
    30	    "called by read_defaults"
    31	    import gin
    32	    gin.parse_config_file(gin_file)
    33	    return {}, '' # read_defaults is expected to return two things
    34	
    35	def read_defaults(defaults_file=DEFAULTS_FILE):
    36	    "read the defaults file, setup defaults dict"
    37	    p = argparse.ArgumentParser(add_help=False)
    38	    p.add_argument('--config-file', required=False, default=defaults_file,
    39	        help='name of local configuration (.ini) file')
    40	    config_file = p.parse_known_args()[0].config_file
    41	    if '.gin' == Path(config_file).suffix:  # "full gin compatibility" = ignore all other prefigure code ;-)
    42	        print(f"prefigure: Switching to gin mode for config file {config_file}")
    43	        defaults, defaults_text = setup_gin(config_file)
    44	    else:
    45	        configp = configparser.ConfigParser()
    46	        configp.optionxform = str                 # don't change uppercase to lowercase
    47	        configp.read(config_file)
    48	        defaults, defaults_text = dict(configp.items('DEFAULTS')), ''
    49	        with open(config_file) as f:
    50	            defaults_text = f.readlines()
    51	    return defaults, defaults_text
    52	
    53	
    54	def setup_args(defaults, defaults_text='',):
    55	    """combine defaults from .ini file and add parseargs arguments, 
    56	        with help pull from .ini"""
    57	    p = argparse.ArgumentParser(formatter_class=argparse.ArgumentDefaultsHelpFormatter)  
    58	    p.add_argument('--config-file', required=False, default=DEFAULTS_FILE, #added so it appears on -h list
    59	        help='name of local configuration (.ini) file')
    60	    p.add_argument('--name', required=False, default=None, help='name of the run')
    61	    p.add_argument('--wandb-config', required=False,  help='wandb url to pull config from')
    62	
    63	    # add other command-line args using defaults .ini file
    64	    for key, value in defaults.items():
    65	        if (key in ['wandb_config','config_file']): break
    66	        help = ""
    67	        for i in range(len(defaults_text)):  # get the help string from defaults_text
    68	            if key in defaults_text[i]:
    69	                help = defaults_text[i-1].replace('# ','')
    70	        argname = '--'+key.replace('_','-')
    71	        if '--name' == argname: continue
    72	        val = Path(value) if ((type(value) == str) and ('_dir' in value)) else arg_eval(value)
    73	        val_type = type(val)
    74	        #print(f"argname: {argname}, val: {val}, val_type: {val_type}")
    75	        if val is None: # None is weird in Python
    76	            p.add_argument(argname, type=str, nargs='?', const=None, default=None, help=help)
    77	        elif (val_type != type(True)):   # gotta handle boolean values specially when dealing with argparse
    78	            p.add_argument(argname, default=val, type=val_type, help=help)
    79	        else: # normal string/int/etc
    80	            #val_type = bool(distutils.util.strtobool(val))
    81	            p.add_argument(argname, type=val_type, nargs='?', const=True, default=False, help=help)
    82	
    83	    args = p.parse_args() 
    84	        
    85	    return args
    86	    
    87	
    88	def pull_wandb_config(wandb_config, defaults):
    89	    """overwrites parts of defaults using wandb config info 
    90	       wandb_config is the url of one of your runs"""
    91	    api = wandb.Api()  # might get prompted for api key login the first time
    92	    splits = wandb_config.split('/')
    93	    entity, project, run_id = splits[3], splits[4], splits[-1].split('?')[0]
    94	    run = api.run(f"{entity}/{project}/{run_id}")
    95	    for key, value in run.config.items():
    96	        if 'OMITTED' != value: defaults[key] = arg_eval(value)
    97	    return defaults
    98	
    99	
   100	
   101	def push_wandb_config(wandb_logger, args, omit=[]): 
   102	    """
   103	    save config to wandb (for possible retrieval later)
   104	    Omit: list of args you don't want pushed to wandb; will push an empty string for these
   105	    """
   106	    if hasattr(wandb_logger.experiment.config, 'update'): #On multi-GPU runs, only process rank 0 has this attribute!
   107	        copy_args = copy.deepcopy(args)
   108	        for var_str in omit:  # don't push certain reserved settings to wandb
   109	            if hasattr(copy_args, var_str):
   110	                setattr(copy_args, var_str, 'OMITTED')
   111	        wandb_logger.experiment.config.update(copy_args)
   112	
   113	
   114	def get_all_args(defaults_file=DEFAULTS_FILE):
   115	    " Config setup."
   116	    args = {}
   117	    #   1. Default settings are in defaults ini (or some other config) file
   118	    defaults, defaults_text = read_defaults(defaults_file=defaults_file)
   119	    args = setup_args(defaults, defaults_text=defaults_text)  
   120	
   121	    #   2. if --wandb-config is given, pull config from wandb to override defaults
   122	    if args.wandb_config is not None:
   123	        defaults = pull_wandb_config(args.wandb_config, defaults) # 2.
   124	
   125	    #   3. Any new command-line arguments override whatever was set earlier
   126	    args = setup_args(defaults, defaults_text=defaults_text) # 3. this time cmd-line overrides what's there
   127	
   128	    return args
   129	
   130	
   131	if __name__ == '__main__':
   132	    # quick test
   133	    args = get_all_args(defaults_file='../examples/defaults.ini')
   134	    print("args = ",args)

