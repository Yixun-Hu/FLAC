   359	    def send(self, record: "Record") -> None:
   360	        self._update_record_num(record.num)
   361	        self._update_end_offset(record.control.end_offset)
   362	
   363	        record_type = record.WhichOneof("record_type")
   364	        assert record_type
   365	        handler_str = "send_" + record_type
   366	        send_handler = getattr(self, handler_str, None)
   367	        # Don't log output to reduce log noise
   368	        if record_type not in {"output", "request", "output_raw"}:
   369	            logger.debug(f"send: {record_type}")
   370	        assert send_handler, f"unknown send handler: {handler_str}"
   371	
   372	        context_id = context.context_id_from_record(record)
   373	        api_context = self._context_keeper.get(context_id)
   374	        try:
   375	            self._api.set_local_context(api_context)
   376	            send_handler(record)
   377	        except ContextCancelledError:
   378	            logger.debug(f"Record cancelled: {record_type}")
   379	            self._context_keeper.release(context_id)
   380	        finally:
   381	            self._api.clear_local_context()
   382	
