  1883	    def _finish(
  1884	        self, exit_code: Optional[int] = None, quiet: Optional[bool] = None
  1885	    ) -> None:
  1886	        if quiet is not None:
  1887	            self._quiet = quiet
  1888	        with telemetry.context(run=self) as tel:
  1889	            tel.feature.finish = True
  1890	        logger.info(f"finishing run {self._get_path()}")
  1891	        # detach jupyter hooks / others that needs to happen before backend shutdown
  1892	        for hook in self._teardown_hooks:
  1893	            if hook.stage == TeardownStage.EARLY:
  1894	                hook.call()
  1895	
  1896	        self._atexit_cleanup(exit_code=exit_code)
  1897	        if self._wl and len(self._wl._global_run_stack) > 0:
  1898	            self._wl._global_run_stack.pop()
  1899	        # detach logger / others meant to be run after we've shutdown the backend
  1900	        for hook in self._teardown_hooks:
  1901	            if hook.stage == TeardownStage.LATE:
  1902	                hook.call()
  1903	        self._teardown_hooks = []
  1904	        module.unset_globals()
  1905	
  1906	        # inform manager this run is finished
  1907	        manager = self._wl and self._wl._get_manager()
  1908	        if manager:
  1909	            manager._inform_finish(run_id=self._run_id)
  1910	
  1911	        self._is_finished = True
  1912	        # end sentry session
  1913	        wandb._sentry.end_session()
