   367	# (o) the state file is valid JSON at every observation and replaced atomically
   368	# --------------------------------------------------------------------------- #
   369	def test_o_the_state_file_is_always_whole_json(rig):
   370	    token(rig)
   371	    path = rig["exp"] / "depth_canon_autolaunch_state.json"
   372	    seen, bad, stop = [], [], threading.Event()
   373	
   374	    def reader():
   375	        while not stop.is_set():
   376	            try:
   377	                text = path.read_text()
   378	            except FileNotFoundError:
   379	                continue
   380	            try:
   381	                seen.append(json.loads(text)["phase"])
   382	            except ValueError:
   383	                bad.append(text)
   384	    t = threading.Thread(target=reader)
   385	    t.start()
   386	    try:
   387	        rc, _ = run(rig, env={"AUTOLAUNCH_POLL_S": "0.05", "FAKE_SLEEP": "0.3"})
   388	    finally:
   389	        stop.set()
   390	        t.join()
   391	    assert rc == 0 and bad == []
   392	    order = [p for i, p in enumerate(seen) if i == 0 or p != seen[i - 1]]
   393	    assert order[-3:] == ["SMOKE_RUNNING", "FULL_RUNNING", "DONE"] and "WAITING_GPU" in order
   394	    assert not [p for p in os.listdir(rig["exp"]) if "autolaunch_state.json." in p]   # no temp left
