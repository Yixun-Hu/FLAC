   117	def pins_sha(r):
   118	    return hashlib.sha256((r["exp"] / "depth_canon_pins.sha256").read_bytes()).hexdigest()
   119	
   120	
   121	def token(r, head=None, manifest=None, by="planner", path=None):
   122	    text = (f"head={head or r['head']}\nmanifest_sha256={manifest or pins_sha(r)}\n"
   123	            f"issued=2026-10-24T02:00:00-04:00\nby={by}\n")
   124	    (path or r["exp"] / "depth_canon_GO.token").write_text(text)
   125	
   126	
   127	def run(r, env=None, max_polls=12, harness=True, timeout=120, path_prefix=None):
   128	    e = {k: v for k, v in os.environ.items()
   129	         if not k.startswith(("AUTOLAUNCH_", "DEPTH_CANON_", "GO_TOKEN", "MODE", "EXPECT_HEAD"))}
   130	    e["PATH"] = f"{r['h'] / 'bin'}:{path_prefix or FLAC_BIN}:{os.environ['PATH']}"
   131	    e["AUTOLAUNCH_TEST_REPO"] = str(r["repo"])
   132	    if harness:
   133	        e.update(DEPTH_CANON_HARNESS=str(r["h"]), AUTOLAUNCH_LAUNCHER=str(r["h"] / "fake_launch.sh"),
   134	                 AUTOLAUNCH_POLL_S="0", AUTOLAUNCH_MAX_POLLS=str(max_polls))
   135	    e.update(env or {})
   136	    p = subprocess.run(["bash", str(r["exp"] / "depth_canon_autolaunch.sh")], env=e, capture_output=True,
   137	                       text=True, timeout=timeout, cwd=str(r["h"]))
   138	    return p.returncode, p.stdout + p.stderr
   139	
