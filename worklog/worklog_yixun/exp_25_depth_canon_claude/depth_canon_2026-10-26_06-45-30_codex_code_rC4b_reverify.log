   141	def state(r):
   142	    return json.loads((r["exp"] / "depth_canon_autolaunch_state.json").read_text())
   143	
   144	
   145	def calls(r):
   146	    path = r["h"] / "launch_calls"
   147	    return path.read_text().splitlines() if path.exists() else []
