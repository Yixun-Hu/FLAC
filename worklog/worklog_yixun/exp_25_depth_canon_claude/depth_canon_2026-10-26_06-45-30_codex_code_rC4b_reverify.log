   109	def gpu(r, lines):
   110	    (r["h"] / "gpu_scenario").write_text("\n".join(lines) + "\n")
   111	
   112	
   113	def launches(r, lines):
   114	    (r["h"] / "launch_scenario").write_text("\n".join(lines) + "\n")
