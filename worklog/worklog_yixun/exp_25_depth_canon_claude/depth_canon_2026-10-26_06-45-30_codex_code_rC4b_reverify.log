   435	def _launcher_rc7_remap():
   436	    """The launcher's terminal code for a NON-GPU-gate exit 7 (train.py's own status), from its source."""
   437	    import re
   438	    src = open(os.path.join(REPO, EXPREL, "depth_canon_launch.sh")).read()
   439	    m = re.search(r"^RC_TRAINER7=(\d+)\b", src, re.M)
   440	    assert m, "the launcher defines no RC_TRAINER7 (rB-F2 F2-1: rc 7 is reserved for the GPU gate)"
   441	    return int(m.group(1)), src
