   446	    transient refusal -- the launcher remaps it to a terminal code, documented in its header,
   447	    and the watcher makes ONE attempt and enters FAILED."""
   448	    remap, src = _launcher_rc7_remap()
   449	    assert remap not in (0, 7) and f"{remap} " in src.split("set -euo pipefail")[0]
