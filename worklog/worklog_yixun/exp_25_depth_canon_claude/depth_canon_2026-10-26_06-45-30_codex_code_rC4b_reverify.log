    98	    _git(repo, "commit", "-q", "-m", "init")
    99	    (h / "bin" / "nvidia-smi").write_text(STUB_NVSMI)
   100	    (h / "fake_launch.sh").write_text(FAKE_LAUNCHER)
   101	    for f in (h / "bin" / "nvidia-smi", h / "fake_launch.sh"):
   102	        os.chmod(f, 0o755)
   103	    r = {"repo": repo, "exp": exp, "h": h, "head": _git(repo, "rev-parse", "HEAD")}
   104	    gpu(r, ["free"])
   105	    launches(r, ["SMOKE 0 smoke ok", "FULL 0 full ok"])
   106	    return r
