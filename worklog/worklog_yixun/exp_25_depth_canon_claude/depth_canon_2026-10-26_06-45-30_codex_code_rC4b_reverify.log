ocol and is stamped", "tie_break": "highest score, ties broken by the smallest parsed (src_node, rec_node) identity (meshgrid_engine.argmax_by_global_index over the bank's identity order)", "walk_gate_note": "a canonical run is one whose numbers are bound to the pre-registered bytes END TO END: the walk must have been driven against the sparse-bank digest document (membership re-checked, every digested file hashed on the read that consumed it, the observation proven to be the digested file and to decode to the scored tensor) and the digest and the loader must have read one root. A run missing any of them is a sensitivity check no matter how registered its settings were", "walk_gates": {"bank_membership_rechecked_against_the_digest": true, "digested_bytes_reverified_on_every_post_gate_read": true, "observation_is_the_digested_file_and_decodes_to_the_scored_tensor": true, "one_dataset_root_for_the_digest_and_the_loader": true}}, "provenance": {"agree_ckpt": "weights/AGREE/AGREE_fullAR.pt", "audit_report": "outputs_loc/exp22/g1_audit/geometry_audit_report.json", "binding_checked": {"agree_ckpt_sha256": "3a13243d6c6a11082697592c2c5db84790d37859451df2963eb51d655b23c787", "branch": "z_band", "d1_manifest_sha256": "4edd066ec831d3159fdc99ea7f22affb5b4e999d4450419306d7c9aa6db4bb8f", "dataset_config": "src/configs/dataset_configs/AR/eval/acousticroom_unseeneval.json", "dataset_config_sha256": "063c66c2411cde4b1f07ec7c5331150b322517cf0067a0ef3def819368423b55", "g1_report_sha256": "a03c3d25c31959a4f67a836928759a2374712cbf2d75e2419beeb691ec871fcd", "model_config_sha256": "f3eafef4456666e4705ddaf35540f6b9f1f746189814cec000bac794ba2a7ec9", "room_manifest_sha256": {"Apartments/Apartments_idx_42": "cddaa611b429b04e93355ebe72c1980183f918efc4dd4f5f83f8304e79075331", "Apartments/Apartments_idx_50": "f8822f614f5bd11522959134ec1d093178199137f88fe35f362fe32ee20ded4d", "Auditorium/Auditorium_idx_1": "72f0b1d36fd4ea7c0378863d108d64ff74c80c6431ce84bfc777538e82c97d07", "Bathrooms/Bathrooms_id