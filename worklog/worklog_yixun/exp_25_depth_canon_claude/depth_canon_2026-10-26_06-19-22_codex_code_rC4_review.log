 def test_l_a_second_instance_is_refused(rig):
     token(rig)
     lock = open(rig["exp"] / ".depth_canon_autolaunch.lock", "w")
     fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
     try:
