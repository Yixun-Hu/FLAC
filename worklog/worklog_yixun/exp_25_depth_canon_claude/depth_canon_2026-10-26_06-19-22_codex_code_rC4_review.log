import math,re,sys
text=open(sys.argv[1],encoding='utf-8',errors='replace').read().replace('\\r','\\n')
stamps={}
for m in re.finditer(r'(\\d+)/(\\d+) \\[(?:(\\d+):)?(\\d+):(\\d+)<',text):
    stamps[int(m.group(1))]=int(m.group(3) or 0)*3600+int(m.group(4))*60+int(m.group(5))
late=[n for n in stamps if n>=10]
n1,n2=min(late),max(stamps)
rate=(stamps[n2]-stamps[n1])/(n2-n1)
loss_re=re.compile(r'(?:"'^|['"\\s,\\[])train/loss=(["'^,'"\\]\\s]+)')
step_re=re.compile(r'\\| (\\d+)/\\d+ \\[')
losses=[v for line in text.split('\\n') for m in [step_re.search(line)] if m and int(m.group(1))>=1 for v in loss_re.findall(line)]
print('stamp_range',n1,stamps[n1],n2,stamps[n2], 'delta_steps',n2-n1,'delta_s',stamps[n2]-stamps[n1])
print('rate_s_per_step',rate,'projection_h',rate*40000/3600)
print('loss_count',len(losses),'all_finite',all(math.isfinite(float(v)) for v in losses),'last',float(losses[-1]))
print('stamp_keys',sorted(stamps))
PY" in /home/yixunhu/codespace/exp-25-depth-canon
