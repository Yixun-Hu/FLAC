   512	def _literal(text, name):
   513	    import re
   514	    found = re.findall(rf"^{name}=(\S+)", text, re.M)
   515	    assert len(found) == 1, f"{name}: expected exactly one top-level assignment, found {found}"
   516	    return found[0]
