     1	#!/usr/bin/env bash
     2	# ============================================================================
     3	# depth_canon_autolaunch.sh -- exp_25 depth_canon: the unattended watcher that fires the
     4	# CANON training (MODE=SMOKE, then MODE=FULL of depth_canon_launch.sh) the moment both A6000s
     5	# are free, with no human in the loop (Yixun pre-approved the GO, 2026-10-24).
     6	#
     7	#   GO token   $EXPDIR/depth_canon_GO.token, written by the Planner, never by this watcher:
     8	#              head=<40 hex> / manifest_sha256=<sha256 of depth_canon_pins.sha256's bytes> /
     9	#              issued=<full ISO-8601 with offset> / by=planner: exactly four newline-terminated
    10	#              key=value lines and nothing else (every line counts, blank ones too). Valid only while head == `git rev-parse HEAD`, manifest_sha256 == the pins
    11	#              file's sha256 and the pinned paths + launcher kit are clean (else WAITING_TOKEN),
    12	#              re-checked on every poll AND immediately before each launcher call.
    13	#   GPUs       GPU 0 and GPU 1 each >= 12288 MiB free (12 GiB, v14), and compute processes on them (uuid ->
    14	#              index mapped) per GPU_OCCUPANCY_POLICY (= the launcher's): `shared` (pinned, plan v14) -- they
    15	#              are co-tenants, NOT dirty, logged as ONE `co-tenants:` line whenever their pid set changes (pid,
    16	#              used memory, readlink /proc/<pid>/cwd); `idle` -- any one is DIRTY and logged once per change
    17	#              through the state reason (v10). Any nonzero nvidia-smi status (even after plausible output), a
    18	#              malformed row, a non-numeric used_memory on ANY row (the nounits query; the launcher refuses it
    19	#              with rc 7 -- rC-F2), a process on an unknown uuid, or not exactly one memory row is DIRTY. Fire after
    20	#              3 consecutive clean polls (60 s apart); a dirty poll resets the count; a heartbeat every 30 min.
    21	#   Fire       `MB=32 ACC=1 DRY_RUN=0 MODE=SMOKE` (literal; harness-only state scrubbed in production)
    22	#              -> rc 0 -> FULL -> rc 0: DONE (exit 0); FULL rc != 0: FAILED (exit 1). A SMOKE refused
    23	#              by the launcher's GPU gate -- its DEDICATED rc 7 (rA A6e), never a text match -- is
    24	#              transient: back to WAITING_GPU, at most 5 retries; any other SMOKE failure is FAILED
    25	#              (exit 1) and FULL is never attempted.
    26	#   State      $EXPDIR/depth_canon_autolaunch_state.json, replaced atomically (tmp + mv) on every
    27	#              change; log $EXPDIR/depth_canon_<TS>_autolaunch.log.
    28	#   Never      terminates or signals any process, writes outside $EXPDIR, or touches the NAS (the
    29	#              launcher does, behind its own gates).
    30	#   Harness    DEPTH_CANON_HARNESS=<dir under /tmp with .depth_canon_harness> (tests only) enables
    31	#              GO_TOKEN / AUTOLAUNCH_LAUNCHER (both under /tmp) / AUTOLAUNCH_POLL_S /
    32	#              AUTOLAUNCH_STABLE_POLLS / AUTOLAUNCH_MAX_POLLS (exit 3 "poll budget exhausted").
    33	#              Outside the harness any of them is refused (exit 2): production values are fixed.
    34	# Exit: 0 DONE | 1 FAILED | 2 a precondition refused | 3 harness poll budget exhausted.
    35	#
    36	# Written by the exp_25 Coder seat (Claude Opus 5.5, max effort), round 3d.
    37	# ============================================================================
    38	set -euo pipefail
    39	
    40	REPO="$(git -C "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" rev-parse --show-toplevel)"
    41	cd "$REPO"
    42	EXPDIR="worklog/worklog_yixun/exp_25_depth_canon_claude"
    43	LAUNCHER="$EXPDIR/depth_canon_launch.sh"
    44	PINS="$EXPDIR/depth_canon_pins.sha256"
    45	TOKEN="$EXPDIR/depth_canon_GO.token"
    46	STATE="$EXPDIR/depth_canon_autolaunch_state.json"
    47	MIN_GPU_FREE_MIB=12288           # = depth_canon_launch.sh MIN_GPU_FREE_MIB (12 GiB, v14)
    48	# = depth_canon_launch.sh GPU_OCCUPANCY_POLICY (v14): shared = co-tenants logged, not dirty; idle = dirty
    49	GPU_OCCUPANCY_POLICY=shared
    50	POLL_S=60; STABLE_POLLS=3; MAX_POLLS=0; HEARTBEAT_S=1800
    51	MAX_GPU_RETRIES=5                # fixed
    52	GPU_REFUSAL_RC=7                 # depth_canon_launch.sh: every GPU-gate refusal (rA A6e), the one transient class
    53	PY_PIN="/home/yixunhu/miniconda3/envs/flac/bin/python"   # = depth_canon_launch.sh PY_PIN (rA A6a)
    54	
    55	die() { echo "$*"; exit 2; }
    56	case "$GPU_OCCUPANCY_POLICY" in idle|shared) ;;   # = the launcher's self-check (rC-F1)
    57	  *) die "CONFIG ERROR: GPU_OCCUPANCY_POLICY must be idle or shared" ;; esac
    58	
    59	# --- preconditions -------------------------------------------------------------------- #
    60	HARNESS="${DEPTH_CANON_HARNESS:-}"
    61	under_tmp() { case "$(readlink -f -- "$1" 2>/dev/null)" in /tmp/?*) return 0 ;; esac; return 1; }
    62	if [ -n "$HARNESS" ]; then
    63	  HREAL="$(readlink -f -- "$HARNESS" 2>/dev/null || true)"
    64	  case "$HREAL" in /tmp/?*) ;; *) die "DEPTH_CANON_HARNESS must be a directory under /tmp (got '${HARNESS}') - abort" ;; esac
    65	  [ -f "$HREAL/.depth_canon_harness" ] || die "DEPTH_CANON_HARNESS '${HARNESS}' lacks the .depth_canon_harness marker - abort"
    66	  if [ -n "${GO_TOKEN:-}" ]; then under_tmp "$GO_TOKEN" || die "GO_TOKEN must be under /tmp - abort"; TOKEN="$GO_TOKEN"; fi
    67	  if [ -n "${AUTOLAUNCH_LAUNCHER:-}" ]; then
    68	    under_tmp "$AUTOLAUNCH_LAUNCHER" || die "AUTOLAUNCH_LAUNCHER must be a path under /tmp - abort"
    69	    LAUNCHER="$AUTOLAUNCH_LAUNCHER"
    70	  fi
    71	  POLL_S="${AUTOLAUNCH_POLL_S:-$POLL_S}"; STABLE_POLLS="${AUTOLAUNCH_STABLE_POLLS:-$STABLE_POLLS}"
    72	  MAX_POLLS="${AUTOLAUNCH_MAX_POLLS:-$MAX_POLLS}"
    73	  [[ "$POLL_S" =~ ^[0-9]+(\.[0-9]+)?$ && "$STABLE_POLLS" =~ ^[1-9][0-9]*$ && "$MAX_POLLS" =~ ^[0-9]+$ ]] \
    74	    || die "AUTOLAUNCH_POLL_S / _STABLE_POLLS / _MAX_POLLS must be numbers - abort"
    75	else
    76	  for v in GO_TOKEN AUTOLAUNCH_LAUNCHER AUTOLAUNCH_POLL_S AUTOLAUNCH_STABLE_POLLS AUTOLAUNCH_MAX_POLLS; do
    77	    [ -z "${!v:-}" ] || die "${v} is honoured only under DEPTH_CANON_HARNESS (production values are fixed) - abort"
    78	  done
    79	fi
    80	exec 8>"$EXPDIR/.depth_canon_autolaunch.lock" || die "cannot open ${EXPDIR}/.depth_canon_autolaunch.lock - abort"
    81	flock -n 8 || die "another autolaunch watcher holds ${EXPDIR}/.depth_canon_autolaunch.lock - abort"
    82	PY="$(command -v python 2>/dev/null || true)"
    83	[ -n "$PY" ] && [ "$(readlink -f -- "$PY")" = "$(readlink -f -- "$PY_PIN")" ] \
    84	  || die "'python' on PATH is '${PY:-absent}', not the launcher's pinned flac interpreter ${PY_PIN} - abort"
    85	[ -f "$LAUNCHER" ] || die "the launcher ${LAUNCHER} is missing - abort"
    86	command -v nvidia-smi >/dev/null || die "nvidia-smi is not on PATH - abort"
    87	
    88	TS="$(date '+%Y-%m-%d_%H-%M-%S')"
    89	LOG="$EXPDIR/depth_canon_${TS}_autolaunch.log"
    90	exec 3>&1 4>&2
    91	exec > >(tee -a "$LOG") 2>&1
    92	TEE_PID=$!
    93	drain() {   # rA A6f: at exit, close our ends of the tee and wait (bounded, signal-free) for it to finish
    94	  local rc=$? i st
    95	  exec 1>&3 2>&4
    96	  for ((i = 0; i < 600; i++)); do
    97	    st="$(cut -d' ' -f3 "/proc/${TEE_PID}/stat" 2>/dev/null)" || break
    98	    [ -n "$st" ] && [ "$st" != Z ] || break
    99	    sleep 0.1
   100	  done
   101	  exit "$rc"
   102	}
   103	trap drain EXIT
   104	STARTED="$(date -Iseconds)"
   105	echo "=== exp_25 depth_canon autolaunch -- ${TS} -- pid $$ -- launcher ${LAUNCHER} -- harness=${HARNESS:-none} ==="
   106	echo "poll ${POLL_S} s, fire after ${STABLE_POLLS} clean polls, <= ${MAX_GPU_RETRIES} GPU-gate retries, min free ${MIN_GPU_FREE_MIB} MiB, GPU occupancy policy ${GPU_OCCUPANCY_POLICY}"
   107	
   108	# --- state (atomic: tmp + mv) ------------------------------------------------------------ #
   109	PHASE=""; REASON=""; TOKEN_HEAD=""; CLEAN=0; RETRIES=0; SMOKE_RC=""; FULL_RC=""; LAST_STATE=""
   110	GPU_COTENANTS=""; LAST_COTENANT_PIDS=""   # rC-F1: the co-tenants of the last poll / the pid set last logged
   111	write_state() {   # write_state <phase> <reason>: only when something changed
   112	  PHASE="$1"; REASON="$2"
   113	  local key="${PHASE}|${REASON}|${TOKEN_HEAD}|${CLEAN}|${RETRIES}|${SMOKE_RC}|${FULL_RC}"
   114	  [ "$key" != "$LAST_STATE" ] || return 0
   115	  LAST_STATE="$key"
   116	  "$PY" - "$STATE.tmp.$$" "$PHASE" "$REASON" "$$" "$STARTED" "$TOKEN_HEAD" "$CLEAN" "$RETRIES" \
   117	      "$SMOKE_RC" "$FULL_RC" "$LOG" <<'PY'
   118	import datetime, json, sys
   119	out, phase, reason, pid, started, head, clean, retries, smoke, full, log = sys.argv[1:12]
   120	num = lambda v: int(v) if v != "" else None  # noqa: E731
   121	st = {"schema_version": 1, "kind": "depth_canon_autolaunch_state", "phase": phase, "reason": reason,
   122	      "watcher_pid": int(pid), "started": started,
   123	      "updated": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
   124	      "token_head": head or None, "clean_polls": int(clean), "gpu_retries": int(retries),
   125	      "smoke_rc": num(smoke), "full_rc": num(full), "log": log}
   126	with open(out, "w") as f:
   127	    json.dump(st, f, indent=1)
   128	    f.write("\n")
   129	PY
   130	  mv -f "$STATE.tmp.$$" "$STATE"
   131	  echo "[$(date -Iseconds)] phase ${PHASE}: ${REASON}"
   132	}
   133	
   134	# --- the GO token ------------------------------------------------------------------------ #
   135	token_ok() {   # 0 = valid (TOKEN_HEAD set); 1 = invalid (TOKEN_WHY set)
   136	  local line key val head="" man="" issued="" by="" n=0 total=0 cur
   137	  TOKEN_WHY=""
   138	  [ -f "$TOKEN" ] || { TOKEN_WHY="no GO token at ${TOKEN}"; return 1; }
   139	  while IFS= read -r line || [ -n "$line" ]; do
   140	    total=$((total + 1))            # rB-F2 F2-5: EVERY logical line counts, blank ones included
   141	    [ -n "$line" ] || continue
   142	    key="${line%%=*}"; val="${line#*=}"
   143	    [ "$key" != "$line" ] || { TOKEN_WHY="GO token line '${line}' is not key=value"; return 1; }
   144	    case "$key" in
   145	      head) head="$val" ;; manifest_sha256) man="$val" ;; issued) issued="$val" ;; by) by="$val" ;;
   146	      *) TOKEN_WHY="GO token has an unknown key '${key}'"; return 1 ;;
   147	    esac
   148	    n=$((n + 1))
   149	  done < "$TOKEN"
   150	  [ "$n" -eq 4 ] && [ "$total" -eq 4 ] && [ "$(wc -l < "$TOKEN")" -eq 4 ] \
   151	    || { TOKEN_WHY="GO token must be exactly the four newline-terminated lines head, manifest_sha256, issued, by and nothing else (got ${n} keys, ${total} lines, $(wc -l < "$TOKEN") newlines)"; return 1; }
   152	  [[ "$head" =~ ^[0-9a-f]{40}$ && "$man" =~ ^[0-9a-f]{64}$ ]] && [ "$by" = planner ] \
   153	    && [[ "$issued" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?([+-][0-9]{2}:[0-9]{2}|Z)$ ]] \
   154	    || { TOKEN_WHY="GO token is malformed (head / manifest_sha256 / issued as full ISO-8601 with offset / by)"; return 1; }
   155	  cur="$(git rev-parse HEAD)"
   156	  [ "$head" = "$cur" ] || { TOKEN_WHY="GO token head ${head} != HEAD ${cur} (re-issue the token at this HEAD)"; return 1; }
   157	  cur="$(sha256sum "$PINS" 2>/dev/null | awk '{print $1}')"
   158	  [ "$man" = "$cur" ] || { TOKEN_WHY="GO token manifest_sha256 ${man} != ${PINS} sha256 ${cur:-unreadable}"; return 1; }
   159	  mapfile -t pinned < <(awk '{print $2}' "$PINS")   # rA A6d: the launcher refuses a dirty pinned tree
   160	  cur="$(git status --porcelain --untracked-files=all -- "${pinned[@]}" "$PINS" "$EXPDIR/depth_canon_launch.sh" \
   161	    "$EXPDIR/depth_canon_make_pins.sh" "$EXPDIR/depth_canon_audit_gate.py" 2>&1)" \
   162	    || { TOKEN_WHY="git status of the pinned paths failed (${cur//$'\n'/; })"; return 1; }
   163	  [ -z "$cur" ] || { TOKEN_WHY="pinned paths are dirty (commit or restore, then re-issue the token): ${cur//$'\n'/; }"; return 1; }
   164	  TOKEN_HEAD="$head"
   165	}
   166	
   167	# --- the GPUs ---------------------------------------------------------------------------- #
   168	gpu_clean() {   # 0 = both cards usable (memory floor; occupancy per GPU_OCCUPANCY_POLICY); 1 = dirty (GPU_WHY set). rA A3: strict
   169	  local out rc line g pid uuid name mib busy="" pids=""
   170	  local -A IDX=()
   171	  GPU_WHY=""; GPU_COTENANTS=""
   172	  rc=0; out="$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader 2>/dev/null)" || rc=$?
   173	  [ "$rc" -eq 0 ] || { GPU_WHY="nvidia-smi --query-gpu=index,uuid exited ${rc}"; return 1; }
   174	  while IFS= read -r line; do
   175	    [[ "$line" =~ ^([0-9]+),[[:space:]]*(GPU-[0-9A-Za-z-]+)$ ]] || { GPU_WHY="malformed index,uuid row '${line}'"; return 1; }
   176	    [ -z "${IDX[${BASH_REMATCH[2]}]:-}" ] || { GPU_WHY="duplicate uuid ${BASH_REMATCH[2]}"; return 1; }
   177	    IDX[${BASH_REMATCH[2]}]="${BASH_REMATCH[1]}"
   178	  done <<<"$out"
   179	  for g in 0 1; do
   180	    printf '%s\n' "${IDX[@]}" | grep -qx "$g" || { GPU_WHY="no uuid for GPU ${g} in nvidia-smi output"; return 1; }
   181	  done
   182	  # rC-F2 (Codex rC NIT): nounits -> used_memory is a bare MiB number, required to be [0-9]+ like the launcher's
   183	  rc=0; out="$(nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name,used_memory --format=csv,noheader,nounits 2>/dev/null)" || rc=$?
   184	  [ "$rc" -eq 0 ] || { GPU_WHY="nvidia-smi --query-compute-apps exited ${rc}"; return 1; }
   185	  while IFS= read -r line; do
   186	    [ -n "$line" ] || continue
   187	    [[ "$line" =~ ^(GPU-[0-9A-Za-z-]+),[[:space:]]*([0-9]+),[[:space:]]*([^,]*),[[:space:]]*([^,]*)$ ]] \
   188	      || { GPU_WHY="unparsable compute-apps line '${line}'"; return 1; }
   189	    uuid="${BASH_REMATCH[1]}"; pid="${BASH_REMATCH[2]}"; name="${BASH_REMATCH[3]}"; mib="${BASH_REMATCH[4]}"
   190	    [[ "$mib" =~ ^[0-9]+$ ]] || { GPU_WHY="non-numeric used_memory in compute-app row '${line}' - waiting"; return 1; }
   191	    [ -n "${IDX[$uuid]:-}" ] || { GPU_WHY="compute process ${pid} on an unknown uuid ${uuid}"; return 1; }
   192	    case "${IDX[$uuid]}" in 0|1)
   193	      busy="${busy}GPU ${IDX[$uuid]}: pid ${pid} (${name}, ${mib} MiB, cwd $(readlink "/proc/${pid}/cwd" 2>/dev/null || echo '?')); "
   194	      pids="${pids}${pid}"$'\n' ;;
   195	    esac
   196	  done <<<"$out"
   197	  if [ "$GPU_OCCUPANCY_POLICY" = idle ]; then
   198	    [ -z "$busy" ] || { GPU_WHY="foreign compute process(es): ${busy}"; return 1; }
   199	  else   # shared (rC-F1): co-tenants never make the poll dirty; ONE log line per change of their pid set
   200	    GPU_COTENANTS="$busy"
   201	    pids="$(printf '%s' "$pids" | sort -nu | tr '\n' ' ')"
   202	    if [ "$pids" != "$LAST_COTENANT_PIDS" ]; then
   203	      LAST_COTENANT_PIDS="$pids"
   204	      echo "[$(date -Iseconds)] co-tenants: ${GPU_COTENANTS:-none on GPU 0/1}"
   205	    fi
   206	  fi
   207	  for g in 0 1; do
   208	    rc=0; out="$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits -i "$g" 2>/dev/null)" || rc=$?
   209	    [ "$rc" -eq 0 ] || { GPU_WHY="nvidia-smi memory.free of GPU ${g} exited ${rc}"; return 1; }
   210	    [[ "$out" =~ ^[[:space:]]*([0-9]+)[[:space:]]*$ ]] || { GPU_WHY="memory.free of GPU ${g} is not exactly one number ('${out//$'\n'/|}')"; return 1; }
   211	    [ "${BASH_REMATCH[1]}" -ge "$MIN_GPU_FREE_MIB" ] || { GPU_WHY="GPU ${g} has ${BASH_REMATCH[1]} MiB free < ${MIN_GPU_FREE_MIB} MiB"; return 1; }
   212	  done
   213	}
   214	
   215	run_launcher() {   # run_launcher <MODE> <capture file>; returns the launcher's rc
   216	  local rc
   217	  set +e   # rA A4: the literal rung, and no harness-only state reaches the launcher
   218	  if [ -n "$HARNESS" ]; then   # (the harness keeps DEPTH_CANON_HARNESS: its fake launcher reads it)
   219	    env -u GO_TOKEN -u AUTOLAUNCH_LAUNCHER -u AUTOLAUNCH_POLL_S -u AUTOLAUNCH_STABLE_POLLS -u AUTOLAUNCH_MAX_POLLS \
   220	      MB=32 ACC=1 DRY_RUN=0 MODE="$1" EXPECT_HEAD="$TOKEN_HEAD" bash "$LAUNCHER" 2>&1 | tee "$2"
   221	  else
   222	    env -u DEPTH_CANON_HARNESS -u GO_TOKEN -u AUTOLAUNCH_LAUNCHER -u AUTOLAUNCH_POLL_S -u AUTOLAUNCH_STABLE_POLLS \
   223	      -u AUTOLAUNCH_MAX_POLLS MB=32 ACC=1 DRY_RUN=0 MODE="$1" EXPECT_HEAD="$TOKEN_HEAD" bash "$LAUNCHER" 2>&1 | tee "$2"
   224	  fi
   225	  rc="${PIPESTATUS[0]}"
   226	  set -e
   227	  return "$rc"
   228	}
   229	
   230	# --- the loop ---------------------------------------------------------------------------- #
   231	write_state WAITING_TOKEN "starting"
   232	POLLS=0; LAST_BEAT="$(date +%s)"
   233	while :; do
   234	  POLLS=$((POLLS + 1))
   235	  if [ "$MAX_POLLS" -gt 0 ] && [ "$POLLS" -gt "$MAX_POLLS" ]; then
   236	    echo "poll budget exhausted (${MAX_POLLS}) in phase ${PHASE}"; exit 3
   237	  fi
   238	  if [ $(( $(date +%s) - LAST_BEAT )) -ge "$HEARTBEAT_S" ]; then
   239	    echo "[$(date -Iseconds)] heartbeat: phase ${PHASE} (${REASON}), clean polls ${CLEAN}/${STABLE_POLLS}"
   240	    LAST_BEAT="$(date +%s)"
   241	  fi
   242	  if ! token_ok; then
   243	    CLEAN=0; TOKEN_HEAD=""; write_state WAITING_TOKEN "$TOKEN_WHY"; sleep "$POLL_S"; continue
   244	  fi
   245	  if ! gpu_clean; then   # write_state prints (and records) the reason once per change
   246	    CLEAN=0; write_state WAITING_GPU "GPUs not free: ${GPU_WHY}"; sleep "$POLL_S"; continue
   247	  fi
   248	  CLEAN=$((CLEAN + 1))
   249	  write_state WAITING_GPU "clean poll ${CLEAN}/${STABLE_POLLS}"
   250	  [ "$CLEAN" -ge "$STABLE_POLLS" ] || { sleep "$POLL_S"; continue; }
   251	  # fire -- the token is re-checked immediately before EACH launcher call
   252	  if ! token_ok; then CLEAN=0; TOKEN_HEAD=""; write_state WAITING_TOKEN "$TOKEN_WHY"; sleep "$POLL_S"; continue; fi
   253	  write_state SMOKE_RUNNING "MODE=SMOKE EXPECT_HEAD=${TOKEN_HEAD}"
   254	  CAP="$EXPDIR/depth_canon_${TS}_autolaunch_smoke_$((RETRIES + 1)).out"
   255	  rc=0; run_launcher SMOKE "$CAP" || rc=$?
   256	  SMOKE_RC="$rc"
   257	  if [ "$rc" -ne 0 ]; then
   258	    if [ "$rc" -eq "$GPU_REFUSAL_RC" ]; then   # rA A6e: the launcher's dedicated rc, never a text match
   259	      RETRIES=$((RETRIES + 1)); CLEAN=0
   260	      if [ "$RETRIES" -gt "$MAX_GPU_RETRIES" ]; then
   261	        write_state FAILED "stage=SMOKE rc=${rc}: the launcher's GPU gate refused ${RETRIES} times (> ${MAX_GPU_RETRIES} retries)"
   262	        exit 1
   263	      fi
   264	      write_state WAITING_GPU "SMOKE refused by the launcher's GPU gate (rc ${rc}); retry ${RETRIES}/${MAX_GPU_RETRIES} after re-stabilizing"
   265	      sleep "$POLL_S"; continue
   266	    fi
   267	    write_state FAILED "stage=SMOKE rc=${rc} (see ${CAP}); FULL not attempted"
   268	    exit 1
   269	  fi
   270	  if ! token_ok; then CLEAN=0; TOKEN_HEAD=""; write_state WAITING_TOKEN "$TOKEN_WHY (after a passing SMOKE)"; sleep "$POLL_S"; continue; fi
   271	  write_state FULL_RUNNING "MODE=FULL EXPECT_HEAD=${TOKEN_HEAD}"
   272	  rc=0; run_launcher FULL /dev/null || rc=$?       # FULL's output reaches this log through the tee
   273	  FULL_RC="$rc"
   274	  if [ "$rc" -eq 0 ]; then write_state DONE "SMOKE and FULL both exited 0"; exit 0; fi
   275	  write_state FAILED "stage=FULL rc=${rc}"
   276	  exit 1
   277	done
diff --git a/worklog/worklog_yixun/exp_25_depth_canon_claude/depth_canon_autolaunch.sh b/worklog/worklog_yixun/exp_25_depth_canon_claude/depth_canon_autolaunch.sh
index 2d6d281..4bb5e1f 100644
--- a/worklog/worklog_yixun/exp_25_depth_canon_claude/depth_canon_autolaunch.sh
+++ b/worklog/worklog_yixun/exp_25_depth_canon_claude/depth_canon_autolaunch.sh
@@ -1,270 +1,273 @@
 #!/usr/bin/env bash
 # ============================================================================
 # depth_canon_autolaunch.sh -- exp_25 depth_canon: the unattended watcher that fires the
 # CANON training (MODE=SMOKE, then MODE=FULL of depth_canon_launch.sh) the moment both A6000s
 # are free, with no human in the loop (Yixun pre-approved the GO, 2026-10-24).
 #
 #   GO token   $EXPDIR/depth_canon_GO.token, written by the Planner, never by this watcher:
 #              head=<40 hex> / manifest_sha256=<sha256 of depth_canon_pins.sha256's bytes> /
 #              issued=<full ISO-8601 with offset> / by=planner: exactly four newline-terminated
 #              key=value lines and nothing else (every line counts, blank ones too). Valid only while head == `git rev-parse HEAD`, manifest_sha256 == the pins
 #              file's sha256 and the pinned paths + launcher kit are clean (else WAITING_TOKEN),
 #              re-checked on every poll AND immediately before each launcher call.
 #   GPUs       GPU 0 and GPU 1 each >= 12288 MiB free (12 GiB, v14), and compute processes on them (uuid ->
 #              index mapped) per GPU_OCCUPANCY_POLICY (= the launcher's): `shared` (pinned, plan v14) -- they
 #              are co-tenants, NOT dirty, logged as ONE `co-tenants:` line whenever their pid set changes (pid,
 #              used memory, readlink /proc/<pid>/cwd); `idle` -- any one is DIRTY and logged once per change
 #              through the state reason (v10). Any nonzero nvidia-smi status (even after plausible output), a
-#              malformed row, a process on an unknown uuid, or not exactly one memory row is DIRTY. Fire after
+#              malformed row, a non-numeric used_memory on ANY row (the nounits query; the launcher refuses it
+#              with rc 7 -- rC-F2), a process on an unknown uuid, or not exactly one memory row is DIRTY. Fire after
 #              3 consecutive clean polls (60 s apart); a dirty poll resets the count; a heartbeat every 30 min.
