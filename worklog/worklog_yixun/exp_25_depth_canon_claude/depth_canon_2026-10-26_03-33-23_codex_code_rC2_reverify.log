   527	def _watcher_with_policy(r, policy):
   528	    """Commit a copy of the watcher whose policy literal is <policy> into the rig's repo."""
   529	    path = r["exp"] / "depth_canon_autolaunch.sh"
   530	    text = path.read_text()
   531	    assert text.count("\nGPU_OCCUPANCY_POLICY=shared\n") == 1
   532	    path.write_text(text.replace("\nGPU_OCCUPANCY_POLICY=shared\n", f"\nGPU_OCCUPANCY_POLICY={policy}\n"))
   533	    _git(r["repo"], "add", "-A")
   534	    _git(r["repo"], "commit", "-q", "-m", f"policy {policy}")
   535	    r["head"] = _git(r["repo"], "rev-parse", "HEAD")
