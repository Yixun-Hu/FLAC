   434	# --- (8) GPU free memory on both cards + occupancy per GPU_OCCUPANCY_POLICY (never kills anything) --- #
   435	declare -A FREE_OF=()
   436	COT_N=(0 0)                       # co-tenant compute processes on GPU 0 / GPU 1
   437	COTENANTS=()                      # gpu pid used_mib cwd -- four words per co-tenant, for the SMOKE evidence
   438	if [ "$DRY_RUN" = "1" ]; then
   439	  echo "GPU memory gate SKIPPED under DRY_RUN"
   440	else
   441	  # rA A3: every query's exit status is checked (a nonzero status refuses even after plausible
   442	  # output), memory is exactly one number per card, every compute-app row parses and names a
   443	  # known uuid. rA A6e: EVERY GPU-gate refusal exits 7 (gpu_refuse) -- the watcher's one transient class.
   444	  gpu_query() {   # gpu_query <nvidia-smi args...> -> GPU_OUT; refuses (gpu_refuse) on any nonzero status
   445	    local rc=0
   446	    GPU_OUT="$(nvidia-smi "$@" 2>/dev/null)" || rc=$?
   447	    [ "$rc" -eq 0 ] || gpu_refuse "GPU GATE FAILED: nvidia-smi $* exited ${rc} (stdout '${GPU_OUT//$'\n'/|}') - refusing to launch blind"
   448	  }
   449	  for G in 0 1; do
   450	    gpu_query -i "$G" --query-gpu=memory.free --format=csv,noheader,nounits
   451	    [[ "$GPU_OUT" =~ ^[[:space:]]*([0-9]+)[[:space:]]*$ ]] || gpu_refuse \
   452	      "GPU GATE FAILED: the free memory of GPU ${G} is not exactly one number ('${GPU_OUT//$'\n'/|}') - refusing to launch blind"
   453	    FREE="${BASH_REMATCH[1]}"; FREE_OF[$G]="$FREE"
   454	    [ "$FREE" -ge "$MIN_GPU_FREE_MIB" ] || gpu_refuse \
   455	      "GPU GATE FAILED: GPU ${G} free ${FREE} MiB < ${MIN_GPU_FREE_MIB} MiB (12 GiB) - abort; wait for the card, this launcher kills nothing"
   456	  done
   457	  echo "GPU memory gate OK: GPU 0 and GPU 1 each >= ${MIN_GPU_FREE_MIB} MiB free"
   458	  # r3b-F1 fix 7 (Codex r3b HIGH 7) made ANY compute process on GPU 0 / GPU 1 refuse -- now policy `idle`.
   459	  # rC-F1 (plan v14): under the pinned `shared` they are co-tenants, disclosed (pid, card, used MiB, cwd) and
   460	  # never refused; the strict parsing below refuses either way. Read-only: nothing is signalled.
   461	  declare -A UUID_OF=() IDX_OF=()
   462	  gpu_query --query-gpu=index,uuid --format=csv,noheader
   463	  while IFS= read -r line; do
   464	    [[ "$line" =~ ^([0-9]+),[[:space:]]*(GPU-[0-9A-Za-z-]+)$ ]] || gpu_refuse \
   465	      "GPU GATE FAILED: malformed index,uuid row '${line}' - refusing to launch blind"
   466	    [ -z "${UUID_OF[${BASH_REMATCH[1]}]:-}" ] && [ -z "${IDX_OF[${BASH_REMATCH[2]}]:-}" ] || gpu_refuse \
   467	      "GPU GATE FAILED: a duplicate index or uuid in '${line}' - refusing to launch blind"
   468	    UUID_OF[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}"; IDX_OF[${BASH_REMATCH[2]}]="${BASH_REMATCH[1]}"
   469	  done <<<"$GPU_OUT"
   470	  for G in 0 1; do
