   360	        return why
   361	    log = ev.get("log", ABSENT)      # the evidence is bound to the bytes of the log it summarizes
   362	    if not (isinstance(log, str) and os.path.isfile(log)):
   363	        return f"log = {show(log)} (want an existing log file)"
   364	    try:
