   519	def test_constants_mirror_the_launcher():
   520	    """The watcher's floor and policy are the launcher's pinned literals (12 GiB, shared)."""
   521	    watcher = open(WATCHER).read()
   522	    launcher = open(os.path.join(REPO, EXPREL, "depth_canon_launch.sh")).read()
   523	    for name, want in (("MIN_GPU_FREE_MIB", "12288"), ("GPU_OCCUPANCY_POLICY", "shared")):
   524	        assert _literal(watcher, name) == _literal(launcher, name) == want, name
