   393	# --- (6) NAS gate on the save root: identity, free space, write probe --------- #
   394	nas_identity_ok() {   # the CIFS share must be what holds <path>
   395	  local line
   396	  line="$(findmnt -n -T "$1" -o FSTYPE,SOURCE 2>/dev/null || true)"
   397	  grep -qE "^${NAS_FSTYPE}[[:space:]]+${NAS_SOURCE//./\\.}\$" <<<"$line" && return 0
   398	  echo "NAS GATE FAILED: identity -- ${1} is on '$(tr '\n' ';' <<<"$line")', not '${NAS_FSTYPE} ${NAS_SOURCE}' - abort"
   399	  return 1
   400	}
   401	nas_gate() {
   402	  local anc="$SAVE_ROOT" avail probe
   403	  while [ ! -e "$anc" ] && [ "$anc" != "/" ]; do anc="$(dirname "$anc")"; done
   404	  nas_identity_ok "$anc" || return 1
   405	  avail="$(df -P -B1 "$anc" 2>/dev/null | awk 'NR==2{print $4}' || true)"
   406	  [[ "$avail" =~ ^[0-9]+$ ]] || { echo "NAS GATE FAILED: free space -- df failed on ${anc} - abort"; return 1; }
   407	  [ "$avail" -ge $((MIN_NAS_FREE_GIB * 1024 * 1024 * 1024)) ] || {
   408	    echo "NAS GATE FAILED: free space -- ${avail} bytes available on ${anc} < ${MIN_NAS_FREE_GIB} GiB - abort"; return 1; }
   409	  if [ "$DRY_RUN" = "1" ]; then
   410	    echo "NAS gate OK: ${anc} is ${NAS_FSTYPE} ${NAS_SOURCE}, ${avail} bytes free; write probe SKIPPED under DRY_RUN"
   411	    return 0
   412	  fi
   413	  mkdir -p "$SAVE_ROOT" || { echo "NAS GATE FAILED: write probe -- cannot create ${SAVE_ROOT} - abort"; return 1; }
   414	  nas_identity_ok "$SAVE_ROOT" || return 1
   415	  probe="$SAVE_ROOT/.depth_canon_write_probe_$$"
   416	  if ! { printf 'probe\n' > "$probe" && [ "$(cat "$probe")" = probe ] && rm -f "$probe" && [ ! -e "$probe" ]; } 2>/dev/null; then
   417	    rm -f "$probe" 2>/dev/null || true
   418	    echo "NAS GATE FAILED: write probe -- could not create, read back and remove a file in ${SAVE_ROOT} - abort"; return 1
   419	  fi
   420	  echo "NAS gate OK: ${SAVE_ROOT} is ${NAS_FSTYPE} ${NAS_SOURCE}, ${avail} bytes free, write probe created + removed"
   421	}
   422	nas_gate || exit 2
