   427	    echo "RUN NAMESPACE NOT EMPTY: ${RUN_NS} already holds files - a FULL run must own its namespace; move it aside deliberately - abort"; exit 2
   428	  fi
   429	elif [ -n "$(find "$RUN_NS" -name '*.ckpt' -print -quit 2>/dev/null)" ]; then
   430	  echo "SMOKE NAMESPACE HOLDS CHECKPOINTS under ${RUN_NS} - a smoke must never leave one; move them aside - abort"; exit 2
