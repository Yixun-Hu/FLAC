  1100	def resolve_cond_autocast(mode):
  1101	    """Map a ``--cond-autocast`` mode to ``(enabled, dtype)`` for the conditioning call.
  1102	
  1103	    ``'default'`` -> ``(True, None)``: ``torch.amp.autocast(device)`` with no explicit
  1104	    dtype, i.e. the torch per-device default (fp16 on cuda) -- byte-identical to the
  1105	    exp_01/exp_02 protocol. ``'bf16'`` -> ``(True, torch.bfloat16)``: matches
  1106	    ``finetune_cond``'s bf16-mixed training precision. ``'off'`` -> ``(False, None)``:
  1107	    no autocast (fp32), for exactness measurements.
  1108	    """
  1109	    modes = {"default": (True, None), "bf16": (True, torch.bfloat16), "off": (False, None)}
  1110	    if mode not in modes:
  1111	        raise ValueError(f"Unknown cond_autocast: {mode!r}; valid options: {sorted(modes)}.")
  1112	    return modes[mode]
