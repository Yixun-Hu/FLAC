   722	        "schema_version": STREAM_SCHEMA_VERSION,
   723	        # The rule this run actually used: 1 (six-decimal context_poses) for AR/HAA,
   724	        # 2 (room-qualified capture ids) when the loader exposed them. Reported per
   725	        # run rather than as a global constant so an AR sidecar is byte-identical
   726	        # to the ones written before capture ids existed.
   727	        "fingerprint_schema": stream.fingerprint_schema(),
   728	        "rotate_mode": plan.mode,
