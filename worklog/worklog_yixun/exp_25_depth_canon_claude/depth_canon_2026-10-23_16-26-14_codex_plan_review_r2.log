   211	            if (isinstance(frame_avg_max_fwd_samples, bool)
   212	                    or not isinstance(frame_avg_max_fwd_samples, int)):
   213	                raise ValueError(
   214	                    "frame_avg_max_fwd_samples must be an int or None, got "
   215	                    f"{frame_avg_max_fwd_samples!r}"
   216	                )
   217	            if frame_avg_max_fwd_samples < 1:
   218	                raise ValueError(
   219	                    f"frame_avg_max_fwd_samples must be >= 1, got {frame_avg_max_fwd_samples}"
   220	                )
   221	        self.frame_avg_max_fwd_samples = frame_avg_max_fwd_samples
   222	
   223	        # exp_15: random-yaw TRAINING augmentation (plan §§3.1, 6.3). Off by
   224	        # default and read only by training_step; validation/test are untouched.
   225	        # The RAW arguments are validated — never coerced — with the same rules
   226	        # the factory applies, so direct construction is as fail-closed as the
   227	        # config path (round-1 review, finding 4): bool("false") is True and
   228	        # int("512") is 512, and either would have armed or disarmed the
   229	        # treatment on a typo without a word of complaint.
