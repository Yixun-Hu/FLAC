   199	def validate_are_lambda(value, who):
   200	    """One place that decides whether a lambda is admissible, for both sources."""
   201	    if isinstance(value, bool) or not isinstance(value, (int, float)):
   202	        raise ValueError(f"{who} must be a number in [0, 1], got {value!r}")
   203	    if not 0.0 <= float(value) <= 1.0:
   204	        raise ValueError(f"{who} must be in [0, 1], got {value!r}")
   205	    return float(value)
