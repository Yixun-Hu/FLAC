   547	def sample_context_ids(md):
   548	    """Ordered fingerprint of the reference sources this sample actually drew.
   549	
   550	    ``AR_md.get_custom_metadata`` picks the K context sources with
   551	    ``np.random.choice`` per sample and does NOT expose their paths, so the
   552	    strongest identity that reaches ``eval_FLAC`` is each source's 3D position
   553	    (``context_poses``, listener-relative, one row per reference in draw order).
   554	    Distinct sources sit metres apart, so a fixed 6-decimal rendering identifies
   555	    the draw exactly while being byte-stable across machines.
   556	
   557	    Read BEFORE any rotation: ``rotate_scene_metadata`` rewrites ``context_poses``,
   558	    and a fingerprint taken afterwards would encode the rotation instead of the
   559	    item (and could never match its unrotated pair).
   560	
   561	    The rendering is FAIL-CLOSED on its own assumptions (review N4). A six-decimal
   562	    string is only a stable identity while the tensor is exactly what the AR loader
   563	    produces --- ``torch.vstack`` of float32 ``[K, 3]`` positions --- and the
   564	    measured sensitivity is not academic: on the real unseen split, rendering the
   565	    same positions as float64 changes two strings and float16 changes 5,032. A
   566	    silently different dtype would therefore produce hashes that mismatch across
   567	    machines for no scientific reason, so it raises instead.
   568	
   569	    exp_19 R3: when the loader DOES expose the reference captures' ids
   570	    (``context_capture_ids``, RAF), those are preferred -- see
   571	    ``capture_id_fingerprints``. Datasets without them are unaffected, byte for
   572	    byte, which is a hard requirement: other sessions pair evaluation cells by
   573	    these fingerprints' digests.
   574	    """
   575	    capture_ids = capture_id_fingerprints(md)
   576	    if capture_ids is not None:
   577	        return capture_ids
   578	    poses = md.get('context_poses', None)
   579	    if poses is None:
   580	        return []
   581	    _validate_context_poses(poses)
   582	    out = []
   583	    for row in poses:
   584	        vals = []
   585	        for v in row:
   586	            val = float(v)
   587	            if val == 0.0:
   588	                val = 0.0  # normalise -0.0, whose rendering would differ
   589	            vals.append(f'{val:.{CONTEXT_ID_PRECISION}f}')
   590	        out.append(','.join(vals))
   591	    return out
