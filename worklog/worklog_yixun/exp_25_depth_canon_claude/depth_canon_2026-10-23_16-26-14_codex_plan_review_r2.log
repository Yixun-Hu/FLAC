   730	        "rotate_deg": plan.rotate_deg,
   731	        "img_w": stream.img_w,
   732	        "stream_count": len(stream),
   733	        "input_tuples": stream.input_tuples(),
   734	        "offsets": stream.offsets,
   735	        "assignment_tuples": stream.assignment_tuples(),
   736	        "input_hash": stream.input_hash(),
   737	        "assignment_hash": stream.assignment_hash(),
