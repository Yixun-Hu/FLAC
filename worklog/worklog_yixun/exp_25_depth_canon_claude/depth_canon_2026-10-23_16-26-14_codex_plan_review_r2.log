   247	def _are_declared(model_config):
   248	    """Does this parsed model config declare the ARE objective at all?"""
   249	    training = (model_config or {}).get("training") or {}
   250	    return ARE_LAMBDA_KEY in training or ARE_ANCHOR_KEY in training
