     6	YAW_AUG_KEYS = ("enabled", "img_w", "seed")
     7	
     8	
     9	def _parse_yaw_aug_config(training_config):
    10	    """Validate ``training.yaw_aug`` and return the wrapper kwargs it implies.
    11	
    12	    exp_15's training-side random-yaw augmentation (plan §§3.1, 6.2). Every
    13	    failure mode here is fail-closed: a malformed block must stop the launch, not
    14	    quietly train the wrong arm — the whole experiment is one treatment against
    15	    one historical control, so a silently-off (or silently-on) augmentation is
    16	    unrecoverable after the fact.
    17	
    18	    Returns ``{}`` unless the block is present *and* enabled, so the disabled
    19	    path's construction call stays literally the pre-change call (plan §3.3-4:
    20	    the control was trained through that call).
    21	    """
    22	    if "yaw_aug" not in training_config:
    23	        return {}
    24	
    25	    block = training_config["yaw_aug"]
    26	    if not isinstance(block, dict):
    27	        raise ValueError(
    28	            f"training.yaw_aug must be an object with keys {list(YAW_AUG_KEYS)}, "
    29	            f"got {type(block).__name__}"
    30	        )
    31	
    32	    unknown = [k for k in block if k not in YAW_AUG_KEYS]
    33	    if unknown:
    34	        raise ValueError(
    35	            f"training.yaw_aug has unknown key(s) {sorted(unknown)}; "
    36	            f"allowed keys are {list(YAW_AUG_KEYS)}"
    37	        )
    38	
    39	    enabled = block.get("enabled", None)
    40	    if not isinstance(enabled, bool):
    41	        raise ValueError(
    42	            "training.yaw_aug.enabled must be a literal boolean (true/false), got "
    43	            f"{enabled!r}"
    44	        )
    45	
    46	    if not enabled:
    47	        return {}
    48	
    49	    if training_config.get("cond_method", "vanilla") == "fa_invariant":
    50	        raise ValueError(
    51	            "training.yaw_aug.enabled=true with cond_method='fa_invariant' is an "
    52	            "untested combination and out of scope for exp_15: frame averaging "
    53	            "already symmetrises over the yaw subgroup."
    54	        )
    55	
    56	    for key in ("img_w", "seed"):
    57	        if key not in block:
    58	            raise ValueError(
    59	                f"training.yaw_aug.enabled=true requires '{key}' (no default is "
    60	                "assumed: the applied rotation must be stated by the config)"
    61	            )
    62	        if isinstance(block[key], bool) or not isinstance(block[key], int):
    63	            raise ValueError(
    64	                f"training.yaw_aug.{key} must be an int, got {block[key]!r}"
    65	            )
    66	
    67	    if block["img_w"] <= 0:
    68	        raise ValueError(
    69	            f"training.yaw_aug.img_w must be > 0, got {block['img_w']}"
    70	        )
    71	
    72	    return {
    73	        "yaw_aug_enabled": True,
    74	        "yaw_aug_img_w": int(block["img_w"]),
    75	        "yaw_aug_seed": int(block["seed"]),
    76	    }
    77	
    78	
    79	def _parse_frame_avg_cap_config(training_config):
    80	    """Validate ``training.frame_avg_max_fwd_samples`` and return its wrapper kwargs.
    81	
    82	    exp_14's treatment (plan §3.1). The frame-average chunk plan — how many orbit
    83	    angles share one conditioner forward, and therefore one train-mode DINOv3
    84	    RoPE draw — used to be derived from a module constant
    85	    (``yaw_rotation.FRAME_AVG_MAX_FWD_SAMPLES``), which announcement 06 flags as
    86	    "derived, not declared": the same JSON at a different micro-batch, or a month
    87	    apart, trains a different method. Declaring it here puts it in the config that
    88	    ``train.py`` embeds into every checkpoint, so an arm's chunk plan is auditable
    89	    after the fact and comparable across arms.
    90	
    91	    Absent key -> ``{}``, so the wrapper construction call is LITERALLY the
    92	    pre-change call and every recipe already in the record is byte-identical.
    93	
    94	    Every failure mode is fail-closed on the RAW value: a coerced ``int("32")`` or
    95	    a ``True`` that ``isinstance(_, int)`` happily accepts would arm the wrong
    96	    chunk plan for a six-day run without a word of complaint.
    97	    """
    98	    key = "frame_avg_max_fwd_samples"
    99	    if key not in training_config:
   100	        return {}
   240	        return AutoencoderTrainingWrapper(
   241	            model, 
