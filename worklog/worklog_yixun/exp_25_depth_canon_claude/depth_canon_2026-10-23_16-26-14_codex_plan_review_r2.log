   107	def draw_yaw_offsets(n: int, img_w: int, generator: torch.Generator) -> torch.Tensor:
   108	    """
   109	    Draw ``n`` independent panorama-column yaw offsets ``d ~ Uniform{0..img_w-1}``.
   110	
   111	    The unit of a *drawn* rotation is one panorama column, never a degree: an
   112	    integer column shift is applied by :func:`rotate_scene_metadata` with no
   113	    interpolation, so the offset that is recorded is exactly the offset that is
   114	    applied (``dj == d``; pinned by test). Angles come from
   115	    :func:`offsets_to_radians`.
   116	
   117	    The draw is taken from the CALLER'S generator and from nothing else. Two
   118	    properties follow, and both are load-bearing for exp_14's design:
   119	
   120	    * **Global-RNG isolation.** The evaluation's own sampling noise is drawn from
   180	    """
   181	    img_w = int(img_w)
   182	    if img_w <= 0:
   183	        raise ValueError(f"img_w must be > 0, got {img_w}")
   184	    if isinstance(offsets, torch.Tensor):
   185	        offsets = offsets.tolist()
   186	    return [float(int(d)) * 2.0 * math.pi / float(img_w) for d in offsets]
