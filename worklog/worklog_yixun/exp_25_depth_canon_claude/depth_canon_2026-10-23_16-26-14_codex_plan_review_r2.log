   238	class GeometryConditioner(Conditioner):
   239	    def __init__(self, 
   240	                 vit_model, 
   241	                 vit_proj,
   242	                 lin_proj,
   243	                 output_dim: int,
   244	                 max_value: float = 5.0,
   245	                 dim: int = 512,
   246	                 model_type: str = "vit",
   247	                 token_pool: str = "linear",
   248	                 gradient_checkpointing: bool = False,
   249	                 name="GeometryConditioner"):
   250	        super().__init__(dim, output_dim, project_out=False)
   251	        self.name = name
   252	        self.vit = vit_model
   253	        self.proj_out = vit_proj
   254	        self.lin_proj = lin_proj
   255	        self.max_value = max_value
   256	        self.model_type = model_type
   257	        self.token_pool = token_pool
   258	
   259	        # Opt-in activation checkpointing for the ViT backbone: trades backward-time
   260	        # recompute for a large activation-memory saving with numerically identical
   261	        # weights/gradients (lets the C4 frame-averaging arm fit micro-batch 32 on a
   262	        # 48GB card). Absent/False -> byte-identical to before. Wrapped explicitly at
   263	        # our own call site rather than via HF's gradient_checkpointing_enable() —
   264	        # see _checkpoint_vit_layers for the transformers==4.57.0 review finding.
   265	        if gradient_checkpointing:
   266	            self._vit_ckpt_layers = _checkpoint_vit_layers(self.vit)
   267	
   268	    def forward(self, coord, device: tp.Union[torch.device, str] = "cuda") -> tp.Tuple[torch.Tensor, torch.Tensor]:
   269	        self.vit.to(device)
   270	        self.proj_out.to(device)
   271	
   272	        depth_coords, coords = [], []
   273	        for c in coord:
   274	            coords.append(c['coord'].float().to(device))
   275	            depth_coords.append(c['depth'].float().to(device))
   276	
   277	        coord = torch.stack(coords, dim=0)  # [B, 3] or [B, N, 3]
   278	        if coord.ndim == 2:
   279	            coord = coord.unsqueeze(1) # [B, 1, 3]
   280	        depth_coord = torch.stack(depth_coords, dim=0)
   281	
   282	        encoded_coords = []
   283	        for i in range(coord.shape[1]):
   284	            c = (coord[:, i, :, None, None] - depth_coord) / self.max_value # [B, 3, H, W]
   285	            if self.model_type == 'dino':
   286	                outputs = self.vit(c)
   287	                pooled_output = outputs.pooler_output
   288	                c = self.lin_proj(pooled_output).unsqueeze(1)  # [B, 1, D]
   289	            elif self.model_type == 'vit':
   290	                c = self.vit(c) 
   291	                c = self.proj_out(c) 
   292	                if self.token_pool == "mean":
   293	                    c = c.mean(dim=1, keepdim=True)  # [B, 1, D]
   294	                elif self.token_pool == "linear":
   295	                    c = self.lin_proj(c.permute(0, 2, 1)).squeeze(-1).unsqueeze(1)  # [B, 1, D]
   296	                else:
   297	                    raise ValueError(f"Unknown token_pool: {self.token_pool}")
   298	            else: 
   299	                raise NotImplementedError('model_type must be either "dino" or "vit"')
   300	            encoded_coords.append(c)
   301	        out = torch.cat(encoded_coords, dim=1)  # [B, N, D]
   302	
   303	        return [out, torch.ones(out.shape[0], 1).to(device)]
