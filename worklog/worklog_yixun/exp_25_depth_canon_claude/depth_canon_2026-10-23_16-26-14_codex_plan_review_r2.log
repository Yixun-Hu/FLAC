   422	    def _check_yaw_aug_metadata(self, metadata):
   423	        """Fail-closed schema validation of one training batch (plan §3.1, F7).
   424	
   425	        Every check is a hard error rather than a skip: a batch that quietly
   426	        declined to rotate would train the treatment arm as a partial control and
   427	        nothing downstream could detect it. In particular the panorama width is
   428	        validated against the ACTUAL depth tensor, never trusted from the config
   429	        — a config/data mismatch would otherwise roll by the wrong number of
   430	        columns and desynchronise depth from the poses.
   431	        """
   432	        if not isinstance(metadata, (list, tuple)):
   433	            raise ValueError(
   434	                f"yaw_aug: metadata must be a list of per-sample dicts, got "
   435	                f"{type(metadata).__name__}"
   436	            )
   437	        if len(metadata) == 0:
   438	            raise ValueError("yaw_aug: metadata is empty; nothing to augment")
   439	
   440	        for i, md in enumerate(metadata):
   441	            if not isinstance(md, dict):
   442	                raise ValueError(
   443	                    f"yaw_aug: metadata[{i}] must be a dict, got {type(md).__name__}"
   444	                )
   445	            if "depth" not in md:
   446	                raise ValueError(f"yaw_aug: metadata[{i}] has no 'depth' field")
   447	            depth = md["depth"]
   448	            if not torch.is_tensor(depth):
   449	                raise ValueError(
   450	                    f"yaw_aug: metadata[{i}]['depth'] must be a tensor, got "
   451	                    f"{type(depth).__name__}"
   452	                )
   453	            if depth.ndim != 3 or depth.shape[0] != 3:
   454	                raise ValueError(
   455	                    f"yaw_aug: metadata[{i}]['depth'] must have shape [3, H, W], got "
   456	                    f"{list(depth.shape)}"
   457	                )
   458	            if depth.shape[2] != self.yaw_aug_img_w:
   459	                raise ValueError(
   460	                    f"yaw_aug: metadata[{i}]['depth'] is {depth.shape[2]} columns "
   461	                    f"wide but yaw_aug_img_w is {self.yaw_aug_img_w}"
   462	                )
   463	            for key in POSE_KEYS:
   464	                # REQUIRED, not optional: rotate_scene_metadata skips absent keys,
   465	                # so a sample missing one would be rotated only partially (depth
   466	                # and three poses moved, the fourth left behind) — geometric
   467	                # nonsense that nothing downstream could detect.
   468	                if key not in md:
   469	                    raise ValueError(f"yaw_aug: metadata[{i}] has no {key!r} pose field")
   470	                pose = md[key]
   471	                if not torch.is_tensor(pose):
   472	                    raise ValueError(
   473	                        f"yaw_aug: metadata[{i}][{key!r}] must be a tensor, got "
   474	                        f"{type(pose).__name__}"
   475	                    )
   476	                # ndim first: a 0-d pose would make shape[-1] raise IndexError.
   477	                if pose.ndim < 1 or pose.shape[-1] != 3:
   478	                    raise ValueError(
   479	                        f"yaw_aug: metadata[{i}][{key!r}] must have trailing "
   480	                        f"dimension 3, got shape {list(pose.shape)}"
   481	                    )
   482	
   483	    def _apply_yaw_aug(self, metadata):
   484	        """Rotate each sample's conditioning by its own freshly drawn yaw.
   485	
   486	        The offsets are a pure function of ``(yaw_aug_seed, global_step,
   487	        global_rank, index)`` — see :func:`_yaw_aug_step_seed`. The generator is
   488	        private to this call, so the global python/NumPy/torch streams are left
   489	        untouched and the augmented arm differs from the control only through the
   490	        treatment, never through RNG displacement.
   491	
   492	        ``reals`` (the target RIR), ``context_audio``, ``padding_mask`` and
   493	        ``scene`` are not rotated: a rigid yaw of the whole scene leaves the
   494	        impulse response unchanged, which is exactly what makes the rotated
   495	        conditioning + unchanged target a valid training pair.
   496	        """
   497	        self._check_yaw_aug_metadata(metadata)
   498	
   499	        generator = torch.Generator()
   500	        generator.manual_seed(
   501	            _yaw_aug_step_seed(self.yaw_aug_seed, int(self.global_step), int(self.global_rank))
   502	        )
   503	        offsets = draw_yaw_offsets(len(metadata), self.yaw_aug_img_w, generator)
   504	        angles = offsets_to_radians(offsets, self.yaw_aug_img_w)
   505	        return [
   506	            rotate_scene_metadata(md, alpha, self.yaw_aug_img_w)
   507	            for md, alpha in zip(metadata, angles)
   508	        ]
   509	
   510	    def _compute_conditioning(self, metadata):
   511	        """Dispatch conditioning by cond_method (exp_03 plan §2c).
   512	
   513	        ``fa_invariant`` routes through the Route-1 yaw-symmetrized path
   514	        (cylindrical pose features + C4 frame average of the ViT conditioners);
   515	        ``vanilla`` is the unchanged single conditioner pass. Called from
   516	        training_step, validation_step AND test_step so all inference/training
   517	        sites share one dispatch point (the repo's flow_source precedent). The
   518	        raise is a backstop; the constructor already rejects unknown values.
   519	
   520	        ``max_fwd_samples`` is passed as a KEYWORD: the parameter after ``angles``
   521	        is ``vit_ids``, so a positional slip would disable the frame average
   522	        instead of changing the chunk plan.
   523	
   524	        The no-cap case takes a SEPARATE branch that issues the original
   525	        four-argument call verbatim (r1 review finding 1). ``max_fwd_samples=None``
   526	        is numerically identical, but "identical behaviour" and "the literal
   527	        pre-change call" are different guarantees, and every arm already in the
   528	        record — including the cluster's in-flight exp_12C run — was trained
   529	        through the four-argument form. Only an arm that DECLARES a cap gets a
   530	        different call shape.
   560	                self.are_anchor["sample_rate"], self.are_anchor["sample_size"],
   561	                anchor_cfg)
   562	        return self._are_bank
   563	
   564	    def _are_anchors(self, metadata, like):
   565	        """Per-sample anchors for one batch, shape-checked against the latent.
   566	
   567	        ``compute_are_anchors`` is looked up as a module global on purpose: it is
   568	        the seam the tests spy on to prove that a non-ARE arm never enters this
   569	        code at all.
   570	        """
   571	        anchors = compute_are_anchors(self._are_anchor_bank(), metadata, self.device)
   572	        if tuple(anchors.shape) != tuple(like.shape):
   573	            raise ValueError(
   574	                f"ARE anchor shape {tuple(anchors.shape)} does not match the latent "
   575	                f"shape {tuple(like.shape)}: the anchor's sample_size/hop disagree "
   576	                "with the pretransform actually in use")
   577	        return anchors
   578	
   579	    def _are_residual_target(self, diffusion_input, metadata):
   580	        """``z -> z - lambda*A(p)`` — the TRAINING half of the reparameterisation.
   581	
   582	        Called from ``training_step`` AND ``validation_step``; ``test_step`` adds
   583	        the anchor back instead (CLAUDE.md's all-dispatch-sites rule). Consumes no
   584	        RNG, so an ARE arm sees exactly the noise sequence its lambda=0 control saw.
   585	        """
   586	        anchors = self._are_anchors(metadata, diffusion_input)
   587	        return diffusion_input - self.are_lambda * anchors.to(diffusion_input.dtype)
   588	
   589	    def training_step(self, batch, batch_idx):
   590	        reals, metadata = batch
   591	
   592	        # exp_15: TRAINING-ONLY random yaw of the conditioning (plan §6.3).
   593	        if self.yaw_aug_enabled:
   594	            metadata = self._apply_yaw_aug(metadata)
   595	
   596	        p = Profiler()
   597	
   598	        if reals.ndim == 4 and reals.shape[0] == 1:
   599	            reals = reals[0]
   600	
   601	        loss_info = {}
   602	
   603	        diffusion_input = reals
   604	
   605	        if not self.pre_encoded:
   606	            loss_info["audio_reals"] = diffusion_input
   607	
   608	        p.tick("setup")
   609	        conditioning = self._compute_conditioning(metadata)
   610	
   611	        # If mask_padding is on, randomly drop the padding masks to allow for learning silence padding
   612	        use_padding_mask = self.mask_padding and random.random() > self.mask_padding_dropout
   613	
   614	        # Check for wrapped padding masks to avoid interpolation error
   615	        first_padding_mask = metadata[0]["padding_mask"]
   616	        if isinstance(first_padding_mask, list) and len(first_padding_mask) == 1:
   617	            padding_masks = torch.stack([md["padding_mask"][0] for md in metadata], dim=0).to(self.device) # Shape (batch_size, sequence_length)
   618	        else:
   619	            padding_masks = torch.stack([md["padding_mask"] for md in metadata], dim=0).to(self.device) # Shape (batch_size, sequence_length)
   620	
   621	        p.tick("conditioning")
   622	        if self.diffusion.pretransform is not None:
   623	            self.diffusion.pretransform.to(self.device)
   624	
   625	            if not self.pre_encoded:
   626	                with torch.amp.autocast('cuda') and torch.set_grad_enabled(self.diffusion.pretransform.enable_grad):
   627	                    self.diffusion.pretransform.train(self.diffusion.pretransform.enable_grad)
   628	                    diffusion_input = self.diffusion.pretransform.encode(diffusion_input)
   629	                    p.tick("pretransform")
