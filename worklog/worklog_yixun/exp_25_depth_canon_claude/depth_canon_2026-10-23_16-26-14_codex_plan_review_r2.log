   641	            context_ids=sample_context_ids(md),
   642	            img_w=img_w,
   643	            offset=None if offset is None else int(offset),
   644	            dataset_idx=None if idx is None else int(idx),
   645	            fingerprint_schema=context_fingerprint_schema(md),
   646	        )
