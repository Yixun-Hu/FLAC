   140	class RIRConditioner(Conditioner):
   141	    def __init__(self, 
   142	                 output_dim: int, 
   143	                 in_channels: int = 2,
   144	                 n_fft: int = 511,
   145	                 win_length: int = 248,
   146	                 hop_length: int = 62,
   147	                 project_out: bool = False, 
   148	                 name: str = "RIRConditioner"):
   149	        input_dim = 512 
   150	        super().__init__(input_dim, output_dim, project_out=project_out)
   151	        self.name = name
   152	        self.net = AudioResNet18(in_channels)
   153	        self.stft = torchaudio.transforms.Spectrogram(
   154	            n_fft=n_fft, 
   155	            win_length=win_length, 
   156	            hop_length=hop_length, 
   157	            power=None, 
   158	        )
   159	
   160	    def forward(self, audios: tp.List[torch.Tensor], device: tp.Union[torch.device, str]) -> tp.Tuple[torch.Tensor, torch.Tensor]:
   161	        self.net = self.net.to(device)
   162	        audios = torch.stack(audios, dim=0) # [B, N, C, T]
   163	        audios = audios.to(device)
   164	        if audios.dim() == 3:
   165	            audios = audios.unsqueeze(1)
   166	        B, N, C, T = audios.shape
   167	        audios = audios.view(B * N, C, T)  # [B*N, C, T]
   168	        audios = self.stft(audios)  # [B*N, C, F, T]
   169	
   170	        audios = torch.sqrt(
   171	            torch.clamp((audios.real**2) + (audios.imag**2), min=1e-8)
   172	        )
   173	
   174	        encoded = self.net(audios) # [batch, 512]
   175	        encoded = encoded.view(B, N, -1)
   176	        out = self.proj_out(encoded)  # [B, N, D]
   177	
   178	        return [out, torch.ones(encoded.shape[0], 1).to(device)]
