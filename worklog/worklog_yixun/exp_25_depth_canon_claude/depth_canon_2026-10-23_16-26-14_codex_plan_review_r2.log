   208	def resolve_are_lambda(training_config, are_lambda=None):
   209	    """``(lambda_or_None, source)`` — which anchor weight this evaluation applies.
   210	
   211	    Announcement 05 governs this: an eval flag is part of the experiment
   212	    definition, and a mismatch between the flag and how the checkpoint was
   213	    trained produces plausible, catastrophically wrong numbers. So:
   214	
   215	    * no flag -> the arm's OWN declared ``training.are_lambda`` (``None`` for
   216	      every arm already in the record, which is how their records stay
   217	      byte-identical);
   218	    * an explicit ``--are-lambda`` OVERRIDES it, including ``0.0`` — that is the
   219	      AR3 sweep, and 0.0 must be distinguishable from "not an ARE run";
   220	    * a flag on an arm with no ``training.are_anchor`` block is a HARD error, not
   221	      a silent no-op: without the calibrated constants there is no ``A`` to add
   222	      back, and recording a lambda that influenced nothing is exactly the failure
   223	      announcement 05 exists to prevent.
   224	
   225	    This resolves the DOSE only. Which anchor it is a dose OF is decided by
   226	    :func:`resolve_are_from_checkpoint`, which binds it to the checkpoint.
   227	    """
   228	    training_config = training_config or {}
   229	    declared = training_config.get(ARE_LAMBDA_KEY, None)
   230	    has_anchor = isinstance(training_config.get(ARE_ANCHOR_KEY, None), dict)
   231	
   232	    if are_lambda is None:
   233	        if declared is None:
   234	            return None, None
   235	        lam = validate_are_lambda(declared, f"model config training.{ARE_LAMBDA_KEY}")
   236	    else:
   237	        lam = validate_are_lambda(are_lambda, "--are-lambda")
   238	
   239	    if not has_anchor:
   240	        raise ValueError(
   241	            f"an ARE lambda ({lam}) was requested but the model config declares no "
   242	            f"training.{ARE_ANCHOR_KEY} block, so the analytic anchor cannot be "
   243	            "computed. Point --model-config at the ARE arm's config.")
   244	    return lam, ("model_config" if are_lambda is None else "cli")
