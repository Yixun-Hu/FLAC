   179	
   180	**`src/data/yaw_rotation.py` — additions only (~170 lines)**
   181	```python
   182	TIE_CLASSES = ("none", "same_column", "cross_column_image", "cross_column_source",
   183	               "cross_column_context", "stabilized")
   184	
   185	def recover_depth_proxy(depth: torch.Tensor) -> torch.Tensor:
   186	    """[3,H,W] camera-frame point cloud -> [H,W] bitwise yaw-stable depth proxy
   187	    D = z / (-sin(phi_row)); phi built exactly as AR_md.convert_equirect_to_camera_coord.
   188	    Not an exact inverse of the raw map (8.9e-16); bitwise invariant under rotate_scene_metadata."""
   189	    _check_depth(depth)                                   # ndim 3, C==3, H even, finite, floating
   190	    H = depth.shape[1]
   191	    phi = (torch.arange(H) + 0.5) * math.pi / H - math.pi / 2
   192	    s = torch.sin(phi)
   193	    if float(s.abs().min()) <= 0.0: raise ValueError("zero sin(phi) row: depth proxy undefined")
   194	    return depth[2] / (-s.to(device=depth.device, dtype=depth.dtype))[:, None]
   195	
   196	def column_profile(D): return D.max(dim=0).values
   197	
   198	def _rel_azimuths(poses_xy, c, W):   # wrapped (phi - theta_c) mod 2pi, +inf for degenerate rows
   199	    ...
   200	
   201	def canonical_column(D, source=None, context=None) -> Tuple[int, str]:
   202	    P = column_profile(D); W = P.shape[0]
   203	    cands = torch.nonzero(P == P.max()).flatten().tolist()
   204	    if len(cands) == 1: return cands[0], "none"
   205	    if len(set(c for c in cands)) == 1: return cands[0], "same_column"   # unreachable by construction of P; kept explicit
   206	    def rooted(c): return torch.roll(D, shifts=-c, dims=1)              # [H,W] image read from column c
   207	    keys = [(rooted(c), c) for c in cands]
   208	    best = _lex_max_images([k for k, _ in keys]); cands = [c for k, c in keys if torch.equal(k, best)]
   209	    if len(cands) == 1: return cands[0], "cross_column_image"
   210	    if source is not None and float(torch.hypot(source[0], source[1])) >= 1e-6:
   211	        rel = [(_rel_azimuth_scalar(source, c, W), c) for c in cands]
   212	        m = min(r for r, _ in rel); cands = [c for r, c in rel if r == m]
   213	        if len(cands) == 1: return cands[0], "cross_column_source"
   214	    if context is not None and context.shape[0] > 0:
   215	        keyed = [(tuple(sorted(_rel_azimuths(context, c, W).tolist())), c) for c in cands]
   216	        m = min(k for k, _ in keyed); cands = [c for k, c in keyed if k == m]
   217	        if len(cands) == 1: return cands[0], "cross_column_context"
   218	    return min(cands), "stabilized"       # joint input has a nontrivial stabilizer: all candidates give the same input
   219	
   220	def canonical_shift(j_star, img_w): return (int(img_w) - int(j_star)) % int(img_w)
   221	
   222	def canonicalize_scene_metadata(md, img_w, pose_keys=POSE_KEYS):
   223	    """-> (md_canon, dj, tie_class). One call to the reviewed rotate_scene_metadata."""
   224	    _check_canon_inputs(md, img_w)                        # exact pose shapes, finite, floating; depth width == img_w
   225	    D = recover_depth_proxy(md["depth"])
   226	    j_star, tie_class = canonical_column(D, md.get("source"), md.get("context_poses"))
   227	    dj = canonical_shift(j_star, img_w)
   228	    out = rotate_scene_metadata(md, offsets_to_radians([dj], img_w)[0], img_w, pose_keys)
   229	    j_check, tc_check = canonical_column(recover_depth_proxy(out["depth"]), out.get("source"), out.get("context_poses"))
   230	    if j_check != 0 or tc_check != tie_class:
   231	        raise RuntimeError(f"canonicalization post-condition failed: j*={j_check} class={tc_check} after shift {dj}")
   232	    return out, dj, tie_class
   233	
   234	def canonical_depth_sha256(depth_canon) -> str:           # sha256 of recover_depth_proxy(depth_canon) bytes (float64, C-contiguous)
   235	    ...
   236	```
