   769	def verify_stream_count(stream, dataset_count, expected=None):
   770	    """Substitution guard: one stream position per split item, and the right split.
   771	
   772	    Two independent checks, because they catch different failures:
   773	
   774	    * ``len(stream) == dataset_count`` --- a short stream means items were dropped,
   775	      a long one that they were served twice. This compares the run against
   776	      itself, so it can only detect an inconsistency, never a wrong split.
   777	    * ``... == expected`` --- the campaign's PRE-REGISTERED item count (6,337 for
   778	      the published unseen split, announcement 01). Without it the first check is
   779	      tautological: a zero-item or subsampled dataset is perfectly self-consistent
   780	      and used to produce a valid-looking artifact (review B1). Supplied by the
   781	      launch kit; omitting it leaves only the weaker check.
   782	
   783	    Either failure FAILS the cell rather than reporting a number (plan §3.3).
   784	    """
   785	    got = len(stream)
   786	    if dataset_count is None:
   787	        raise RuntimeError(
   788	            "cannot verify the rotation stream: the dataset item count is unknown."
   789	        )
   790	    dataset_count = int(dataset_count)
   791	    if got != dataset_count:
   792	        raise RuntimeError(
   793	            f"rotation stream has {got} positions but the dataset holds {dataset_count} "
   794	            "items: the evaluated split does not match the configured one (dropped, "
   795	            "duplicated or substituted items). Refusing to report metrics."
   796	        )
   797	    if expected is None:
   798	        return
   799	    expected = int(expected)
   800	    if expected <= 0:
   801	        raise RuntimeError(
   802	            f"expected_stream_count must be a positive item count, got {expected}."
   803	        )
   804	    if dataset_count != expected:
   805	        raise RuntimeError(
   806	            f"rotation stream and dataset agree on {got} items, but the pre-registered "
   807	            f"split has {expected}: this cell evaluated a different split than the "
   808	            "campaign declares (announcement 01 forbids new or subsampled eval "
   809	            "configurations). Refusing to report metrics."
