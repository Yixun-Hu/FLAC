    86	def wrap_angle(phi):
    87	    """
    88	    Wrap an angle into the half-open interval ``(-pi, pi]``.
    89	
    90	    The interval is closed at ``+pi`` and open at ``-pi``, so an input of exactly
    91	    ``-pi`` maps to ``+pi`` (and ``+pi`` stays ``+pi``). Works elementwise on
    92	    Python floats and on ``torch.Tensor`` inputs alike.
    93	
    94	    Parameters
    95	    ----------
    96	    phi : float or torch.Tensor
    97	        Angle(s) in radians.
    98	
    99	    Returns
   100	    -------
   101	    float or torch.Tensor
   102	        The wrapped angle(s) in ``(-pi, pi]``, same type as the input.
   103	    """
   104	    return math.pi - (math.pi - phi) % (2.0 * math.pi)
