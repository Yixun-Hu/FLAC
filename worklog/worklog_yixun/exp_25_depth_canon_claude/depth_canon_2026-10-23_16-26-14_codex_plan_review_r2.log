    99	        src_n = f"S00{node}"
   100	        other_src_ir_path = os.path.join(dir_name, f"{src_n}_{rec_n}_hybrid_IR.wav")
   101	        if os.path.exists(other_src_ir_path):
   102	            valid_other_src_ir_paths.append(other_src_ir_path)
   103	    try:
   104	        select_other_src_ir_paths = np.random.choice(valid_other_src_ir_paths, num_ref_sources, replace=False)
   105	    except Exception as e:
   106	        select_other_src_ir_paths = np.random.choice(valid_other_src_ir_paths, num_ref_sources, replace=True)
   107	    all_ref_irs = []
   108	    all_ref_src_pos = []
   109	    
   110	    for fp in select_other_src_ir_paths:
   111	        ref_wav, rate = torchaudio.load(fp)
   112	        assert rate == 22050, "IR sampling rate must be 22050!"
   113	        if ref_wav.shape[1] < max_len:
   114	            ref_wav = torch.cat([ref_wav, torch.zeros(ref_wav.shape[0], max_len - ref_wav.shape[1])], dim=1)
   115	        else:
   116	            ref_wav = ref_wav[:, :max_len]
   117	        ref_wav = ref_wav.unsqueeze(0) # C=1
   118	        all_ref_irs.append(ref_wav)
   119	
   120	        src_loc, rec_loc = get_receiver_source_location(fp, metadata_path=metadata_path)
   121	        
   122	        proj_src_loc = get_3d_point_camera_coord(rec_loc, src_loc)
   123	        
   124	        all_ref_src_pos.append(torch.Tensor(proj_src_loc).float())
   125	    all_ref_irs = torch.cat(all_ref_irs, dim=0)
   126	    all_ref_src_pos = torch.vstack(all_ref_src_pos)
   127	    return all_ref_irs, all_ref_src_pos
   150	    def __repr__(self):
   151	        rep = 80 * "=" + "\n"
   152	        for i in range(1, len(self.ticks)):
   153	            msg = self.ticks[i][1]
   154	            ellapsed = self.ticks[i][0] - self.ticks[i - 1][0]
   155	            rep += msg + f": {ellapsed*1000:.2f}ms\n"
   156	        rep += 80 * "=" + "\n\n\n"
   157	        return rep
