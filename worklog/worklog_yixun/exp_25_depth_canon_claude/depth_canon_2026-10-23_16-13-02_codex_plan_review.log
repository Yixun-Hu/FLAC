   153	def test_every_offset_round_trips_through_rotate_scene_metadata_quantisation():
   154	    """``rotate_scene_metadata`` re-quantises its angle to ``dj`` columns. For the
   155	    drawn angles that re-quantisation must be the IDENTITY (dj == d) for every
   156	    offset in the support — otherwise the recorded offset is not the applied one."""
   157	    img_w = 512
