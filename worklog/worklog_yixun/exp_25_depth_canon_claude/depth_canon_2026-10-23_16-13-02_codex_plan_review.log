   580	# §6.5-2,3,6,7,8 the training_step hook
   581	# --------------------------------------------------------------------------- #
   582	def _enabled_wrapper(img_w=16, seed=42, step=0, rank=0, **overrides):
   583	    wrapper = _build_wrapper(
   584	        yaw_aug={"enabled": True, "img_w": img_w, "seed": seed}, **overrides
   585	    )
   586	    _attach_stub_trainer(wrapper, global_step=step, global_rank=rank)
   587	    return wrapper
