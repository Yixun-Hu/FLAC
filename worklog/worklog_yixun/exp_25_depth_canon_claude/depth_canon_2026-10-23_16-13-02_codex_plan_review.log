   175	def _consistent_depth(H=4, W=512):
   176	    """A geometrically consistent equirectangular depth point cloud (same
   177	    construction as test_yaw_symmetry)."""
   178	    j = torch.arange(W, dtype=torch.float32)
   179	    theta = (j + 0.5) * 2.0 * math.pi / W - math.pi
   180	    i = torch.arange(H, dtype=torch.float32)
   181	    el = (i + 0.5) * math.pi / H - math.pi / 2.0
   182	    d = 3.0
   183	    theta_g = theta.view(1, W).expand(H, W)
   184	    el_g = el.view(H, 1).expand(H, W)
   185	    return torch.stack([d * torch.cos(el_g) * torch.cos(theta_g),
   186	                        d * torch.cos(el_g) * torch.sin(theta_g),
   187	                        d * torch.sin(el_g)], dim=0).contiguous()
   188	
