   121	def resolve_rotation_plan(rotate_mode='fixed', rotate_deg=0.0, rotate_seed=None,
   122	                          eval_seed=None):
   123	    """Resolve (and validate) the rotation protocol before anything else runs.
   124	
   125	    Every failure here is a HARD error, never a silent precedence rule --- this is
   126	    the announcement-05 trap (eval-protocol flags are part of the experiment): a
   127	    mismatched flag produces plausible-looking, catastrophically wrong numbers.
   128	
   129	    - ``random`` with a non-zero ``rotate_deg``: a fixed angle and a per-sample
   130	      draw are mutually exclusive protocols, so there is no correct winner.
   131	    - ``fixed`` with an explicit ``rotate_seed``: silently ignoring it would let a
   132	      manifest record a rotation seed that influenced nothing (review B4).
   133	    - ``random`` with no seed anywhere: the assignment would be unreproducible.
   134	
   135	    In ``random`` mode an omitted ``rotate_seed`` resolves to the EVAL seed
   136	    (Yixun 2026-08-10), so a cell's rotation assignment is a function of the seed
   137	    it already reports.
   138	    """
   139	    if rotate_mode not in ROTATE_MODES:
   140	        raise ValueError(
   141	            f"Unknown rotate_mode: {rotate_mode!r}; valid options: {list(ROTATE_MODES)}."
   142	        )
   143	    if rotate_mode == 'fixed':
   144	        if rotate_seed is not None:
   145	            raise ValueError(
   146	                f"rotate_seed={rotate_seed!r} (--rotate-seed) is meaningless with "
   147	                "rotate_mode='fixed' and must not be silently ignored: a fixed rotation "
   148	                "draws nothing. Pass --rotate-mode random to use it."
   149	            )
   150	        return RotationPlan('fixed', float(rotate_deg), None)
   151	
   152	    if float(rotate_deg) != 0.0:
   153	        raise ValueError(
   154	            f"rotate_mode='random' is incompatible with rotate_deg={rotate_deg!r} "
   155	            "(--rotate-deg): a per-sample random yaw and a single fixed angle are "
   156	            "different protocols. Drop --rotate-deg (or use --rotate-mode fixed)."
   157	        )
   158	    resolved = rotate_seed if rotate_seed is not None else eval_seed
   159	    if resolved is None:
   160	        raise ValueError(
   161	            "--rotate-mode random needs a rotation seed: pass --rotate-seed, or an "
   162	            "eval --seed for it to default to. An unseeded assignment is not reproducible."
   163	        )
   164	    return RotationPlan('random', None, int(resolved))
