   219	            for name, param in model.state_dict().items():
   220	                if isinstance(param, Parameter):
   221	                    # backwards compatibility for serialized parameters
   222	                    param = param.data
   223	                ema_copy.state_dict()[name].copy_(param)
   224	
   225	        use_ema = training_config.get("use_ema", False)
