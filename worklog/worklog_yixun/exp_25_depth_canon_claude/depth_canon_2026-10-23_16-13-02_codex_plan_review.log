  1100	# =========================================================================== #
  1101	# ROUND-1 FIX BATCH — F2: the opt-in .stream.json sidecar (review B2, ruling 1)
  1102	# =========================================================================== #
  1103	# A hash without its preimage is unfalsifiable: two cells can only be declared
  1104	# rotation-matched, never diagnosed when they are not. The sidecar carries the
  1105	# full canonical tuples and the offsets, so a mismatch can be localised to a
  1106	# position. It is a SEPARATE file precisely so the metrics record and its path
  1107	# stay byte-identical in both modes (the STEP-0 snapshots are untouched by F2).
  1108	def test_yaw_column_shift_is_the_quantisation_rotate_scene_metadata_applies():
  1109	    """The recorded fixed-mode offset must be the column shift actually applied,
  1110	    so both come from one function rather than two copies of a rule."""
  1111	    assert yr.yaw_column_shift(0.0, 512) == 0
  1112	    assert yr.yaw_column_shift(math.radians(90.0), 512) == 128
  1113	    assert yr.yaw_column_shift(math.radians(45.0), 512) == 64
  1114	    assert yr.yaw_column_shift(math.radians(5.625), 512) == 8
  1115	    assert yr.yaw_column_shift(math.radians(360.0), 512) == 0     # wraps
  1116	    assert yr.yaw_column_shift(math.radians(-90.0), 512) == 384   # wraps
  1117	
  1118	    # ...and it is EXACTLY what rotate_scene_metadata rolls by: reconstructing the
  1119	    # rotation from yaw_column_shift alone must reproduce the real output bit for
  1120	    # bit, at angles on and off the column grid.
  1121	    depth = _make_md(seed=2)["depth"]
  1122	    for deg in (0.0, 45.0, 90.0, 5.625, 200.0, 37.3):
  1123	        alpha = math.radians(deg)
  1124	        dj = yr.yaw_column_shift(alpha, IMG_W)
  1125	        rot = yr.azimuth_rotation_matrix(dj * 2.0 * math.pi / IMG_W)
  1126	        expected = torch.einsum("ij,jhw->ihw", rot.to(depth.dtype),
  1127	                                torch.roll(depth, shifts=dj, dims=2))
  1128	        got = yr.rotate_scene_metadata({"depth": depth}, alpha, IMG_W)["depth"]
  1129	        assert torch.equal(got, expected), f"{deg} deg"
  1130	
