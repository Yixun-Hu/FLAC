   239	    if not has_anchor:
   240	        raise ValueError(
   241	            f"an ARE lambda ({lam}) was requested but the model config declares no "
   242	            f"training.{ARE_ANCHOR_KEY} block, so the analytic anchor cannot be "
   243	            "computed. Point --model-config at the ARE arm's config.")
