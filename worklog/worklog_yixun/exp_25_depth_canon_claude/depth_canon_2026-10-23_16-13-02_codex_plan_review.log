   268	    def forward(self, coord, device: tp.Union[torch.device, str] = "cuda") -> tp.Tuple[torch.Tensor, torch.Tensor]:
   269	        self.vit.to(device)
   270	        self.proj_out.to(device)
   271	
   272	        depth_coords, coords = [], []
   273	        for c in coord:
   274	            coords.append(c['coord'].float().to(device))
   275	            depth_coords.append(c['depth'].float().to(device))
   276	
   277	        coord = torch.stack(coords, dim=0)  # [B, 3] or [B, N, 3]
   278	        if coord.ndim == 2:
   279	            coord = coord.unsqueeze(1) # [B, 1, 3]
   280	        depth_coord = torch.stack(depth_coords, dim=0)
   281	
   282	        encoded_coords = []
   283	        for i in range(coord.shape[1]):
   284	            c = (coord[:, i, :, None, None] - depth_coord) / self.max_value # [B, 3, H, W]
   285	            if self.model_type == 'dino':
   286	                outputs = self.vit(c)
   287	                pooled_output = outputs.pooler_output
   288	                c = self.lin_proj(pooled_output).unsqueeze(1)  # [B, 1, D]
   289	            elif self.model_type == 'vit':
   290	                c = self.vit(c) 
   291	                c = self.proj_out(c) 
