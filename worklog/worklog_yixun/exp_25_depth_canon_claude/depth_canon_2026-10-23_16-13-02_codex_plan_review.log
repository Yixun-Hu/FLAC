   190	def _make_md(seed=0, n_ctx=4, img_w=512):
   191	    g = torch.Generator().manual_seed(seed)
   192	    return {
   193	        "idx": seed,
   194	        "relpath": f"scene{seed}/id0/S001_R00{seed}_hybrid_IR.wav",
   195	        "scene": f"scene{seed}",
   196	        "source": torch.randn(3, generator=g),
   197	        "source_vit": torch.randn(1, 3, generator=g),
   198	        "context_poses": torch.randn(n_ctx, 3, generator=g),
   199	        "context_poses_vit": torch.randn(n_ctx, 3, generator=g),
   200	        "context_audio": torch.randn(n_ctx, 16, generator=g),
   201	        "depth": _consistent_depth(4, img_w),
   202	    }
