   100	class RotationPlan(NamedTuple):
   101	    """The resolved yaw-rotation protocol for one evaluation run.
   102	
   103	    ``mode='fixed'``  -- the legacy behaviour: every sample is rotated by the same
   104	    ``rotate_deg`` (0.0 meaning "not rotated at all"); ``rotate_seed`` is None.
   105	
   106	    ``mode='random'`` -- exp_14's estimand: each sample independently draws a
   107	    panorama-column offset from a generator seeded with ``rotate_seed``, so no
   108	    single angle describes the run and ``rotate_deg`` is None (recorded as JSON
   109	    ``null``), not 0.0 -- an unrotated run and a randomly-rotated one must never
   110	    be readable as the same protocol.
   111	    """
   112	    mode: str
   113	    rotate_deg: Optional[float]
   114	    rotate_seed: Optional[int]
   115	
   116	    @property
   117	    def is_random(self):
   118	        return self.mode == 'random'
