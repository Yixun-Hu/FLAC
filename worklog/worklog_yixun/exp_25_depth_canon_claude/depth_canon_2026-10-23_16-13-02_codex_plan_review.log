   428	def test_draws_are_resume_exact():
   429	    """The property the counter-based scheme exists for (plan §3.1, review F5).
   430	
   431	    A run killed at step N and resumed there must make exactly the draws the
   432	    uninterrupted run would have made: there is no stream state to checkpoint,
   433	    only the (seed, step, rank) counter, which the resumed process rebuilds from
   434	    the checkpoint's ``global_step``.
   435	    """
   436	    n, img_w, N, M = 8, 512, 25, 12
   437	
   438	    uninterrupted = [
   439	        _offsets(42, step, 0, n=n, img_w=img_w) for step in range(N + M)
   440	    ]
   441	    # leg 1: steps 0..N-1, then the process dies (its generators die with it)
   442	    leg1 = [_offsets(42, step, 0, n=n, img_w=img_w) for step in range(N)]
   443	    # leg 2: a fresh process resumes at N with nothing but the counter
   444	    leg2 = [_offsets(42, step, 0, n=n, img_w=img_w) for step in range(N, N + M)]
   445	
   446	    assert all(torch.equal(x, y) for x, y in zip(uninterrupted, leg1 + leg2))
   447	
