   159	    for d, alpha in zip(offsets, yr.offsets_to_radians(offsets, img_w)):
   160	        dj = int(round(alpha * img_w / (2.0 * math.pi))) % img_w
   161	        assert dj == d, f"offset {d} re-quantised to {dj}"
