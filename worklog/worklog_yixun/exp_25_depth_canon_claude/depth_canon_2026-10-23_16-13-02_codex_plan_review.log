   609	def _manual_rotate(md, d, img_w):
   610	    """A reference rotation computed from first principles, NOT via
   611	    ``rotate_scene_metadata`` — otherwise the test would only prove the code
   612	    agrees with itself."""
   613	    alpha = d * 2.0 * np.pi / img_w
   614	    c, s = float(np.cos(alpha)), float(np.sin(alpha))
   615	    rot = torch.tensor([[c, -s, 0.0], [s, c, 0.0], [0.0, 0.0, 1.0]], dtype=torch.float32)
   616	    out = dict(md)
   617	    rolled = torch.roll(md["depth"], shifts=d, dims=2)
   618	    out["depth"] = torch.einsum("ij,jhw->ihw", rot, rolled)
   619	    for key in ("source", "source_vit", "context_poses", "context_poses_vit"):
   620	        if key in md:
   621	            out[key] = torch.einsum("ij,...j->...i", rot, md[key])
   622	    return out
   623	
