   137	    has_lambda = ARE_LAMBDA_KEY in training_config
   138	    has_anchor = ARE_ANCHOR_KEY in training_config
   139	
   140	    if not has_lambda:
   141	        if has_anchor:
   142	            raise ValueError(
   143	                f"training.{ARE_ANCHOR_KEY} is declared but training.{ARE_LAMBDA_KEY} "
   144	                "is not: an anchor block with no lambda would be parsed, recorded and "
   145	                "then ignored. State the lambda (0.0 for a declared control) or drop "
   146	                "the block.")
   147	        return {}
   148	
   149	    lam = training_config[ARE_LAMBDA_KEY]
   150	    if isinstance(lam, bool) or not isinstance(lam, (int, float)):
   151	        raise ValueError(
   152	            f"training.{ARE_LAMBDA_KEY} must be a number in [0, 1] (the weight of the "
   153	            f"analytic anchor in the target reparameterisation), got {lam!r}")
   154	    if not 0.0 <= float(lam) <= 1.0:
   155	        raise ValueError(
   156	            f"training.{ARE_LAMBDA_KEY} must be in [0, 1], got {lam!r}")
   157	
   158	    if not has_anchor:
   159	        raise ValueError(
   160	            f"training.{ARE_LAMBDA_KEY}={lam!r} requires a training.{ARE_ANCHOR_KEY} "
   161	            "block carrying the calibrated constants "
   162	            f"{list(are_anchor.ANCHOR_REQUIRED_KEYS)}: no default is assumed, because "
   163	            "an anchor placed at an uncalibrated onset is a different method.")
