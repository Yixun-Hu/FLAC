   165	    block = training_config[ARE_ANCHOR_KEY]
   166	    if not isinstance(block, dict):
   167	        raise ValueError(
   168	            f"training.{ARE_ANCHOR_KEY} must be an object with keys "
   169	            f"{list(are_anchor.ANCHOR_REQUIRED_KEYS)}, got {type(block).__name__}")
   170	
   171	    allowed = set(are_anchor.ANCHOR_REQUIRED_KEYS) | set(are_anchor.ANCHOR_OPTIONAL_KEYS)
   172	    unknown = sorted(k for k in block if k not in allowed)
   173	    if unknown:
   174	        # sample_rate / sample_size are named separately: they are not "unknown",
   175	        # they are the MODEL config's, and letting the block restate them would
   176	        # let the anchor's time base disagree with the audio the run trains on.
   177	        restated = [k for k in unknown if k in are_anchor.ANCHOR_MODEL_KEYS]
