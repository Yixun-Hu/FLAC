   157	```python
   158	def recover_depth_from_pointcloud(depth: torch.Tensor) -> torch.Tensor:
   159	    """[3,H,W] camera-frame point cloud -> [H,W] per-pixel depth, bitwise yaw-invariant.
   160	    D = z / (-sin(phi_row)); phi built exactly as AR_md.convert_equirect_to_camera_coord."""
   161	    _check_depth(depth)                         # ndim 3, C==3, finite
   162	    H = depth.shape[1]
   163	    phi = (torch.arange(H) + 0.5) * math.pi / H - math.pi / 2   # float32, same recipe as AR_md
   164	    s = torch.sin(phi).to(device=depth.device, dtype=depth.dtype)
   165	    return depth[2] / (-s)[:, None]
   166	
   167	def column_profile(D: torch.Tensor) -> torch.Tensor:          # [H,W] -> [W]
   168	    return D.max(dim=0).values
   169	
   170	def canonical_column(P, source=None) -> Tuple[int, bool]:
   171	    """Column of the deepest pixel with the equivariant tie-break (plan §2.1 C).
   172	    Returns (j_star, residual_tie)."""
   173	    W = P.shape[0]; M = P.max(); cands = torch.nonzero(P == M).flatten().tolist()
   174	    if len(cands) == 1: return cands[0], False
   175	    keyed = [(tuple(torch.roll(P, -c).tolist()), c) for c in cands]   # circular profile from c
   176	    best = max(k for k, _ in keyed); cands = [c for k, c in keyed if k == best]
   177	    if len(cands) == 1: return cands[0], False
   178	    if source is not None and float(torch.hypot(source[0], source[1])) >= 1e-6:
   179	        phi_s = math.atan2(float(source[1]), float(source[0]))
   180	        rel = [((phi_s - ((c + 0.5) * 2 * math.pi / W - math.pi)) % (2 * math.pi), c) for c in cands]

