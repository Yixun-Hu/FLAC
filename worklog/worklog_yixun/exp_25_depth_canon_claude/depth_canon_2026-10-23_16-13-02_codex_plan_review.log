   473	def _capture_wrapper_kwargs(monkeypatch, training_overrides):
   474	    """Build through the real factory with the wrapper class stubbed out.
   475	
   476	    ``create_training_wrapper_from_config`` imports the wrapper inside the
   477	    function body, so patching the module attribute intercepts construction; the
   478	    model is never touched on the diffusion_cond branch, hence the sentinel.
   479	    """
   480	    captured = {}
   481	
   482	    class _Stub:
   483	        def __init__(self, model, **kwargs):
   484	            captured["model"] = model
   485	            captured["kwargs"] = kwargs
   486	
   487	    monkeypatch.setattr(tdiff, "DiffusionCondTrainingWrapper", _Stub)
   488	    cfg = _base_config()
   489	    cfg["training"].update(training_overrides)
   490	    create_training_wrapper_from_config(cfg, _SENTINEL_MODEL)
   491	    return captured
