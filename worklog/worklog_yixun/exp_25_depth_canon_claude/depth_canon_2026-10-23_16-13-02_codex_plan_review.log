   581	def yaw_transform_consistency(
   582	    depth: torch.Tensor, img_w: int, angles_deg: Tuple[float, ...]
   583	) -> Dict[float, float]:
   584	    """
   585	    Verify that yaw-rotating a depth panorama keeps it a valid equirectangular map.
   586	
   587	    A consistent equirectangular depth point cloud stores, at column ``j``, a 3D
   588	    vector whose horizontal azimuth equals that column's azimuth ``theta_j`` (because
   589	    ``x = d*cos(phi)*cos(theta)`` and ``y = d*cos(phi)*sin(theta)``). A physically
   590	    correct yaw rotation --- a horizontal roll of ``dj`` columns together with a
   591	    matching rotation of the stored vectors about z --- must preserve this property.
   592	    If the roll direction and the rotation-matrix sign disagree, the rotated map is
   593	    no longer a valid panorama and the per-column azimuth deviation becomes large
   594	    (about twice the rotation angle). This is the automated sign sanity-check.
   595	
   596	    Parameters
   597	    ----------
   598	    depth : torch.Tensor
   599	        A single depth point cloud of shape ``[3, H, W]`` in the panorama camera frame.
   600	    img_w : int
   601	        Panorama width in pixels (number of azimuth columns).
   602	    angles_deg : Tuple[float, ...]
   603	        Yaw angles in degrees to test for consistency (0 deg is always included as a
   604	        control).
   605	
   606	    Returns
   607	    -------
   608	    Dict[float, float]
   609	        Mapping from angle in degrees to the maximum per-pixel azimuth deviation in
   610	        radians, excluding near-pole pixels where azimuth is undefined. Values near
   611	        zero indicate a geometrically consistent transform.
   612	    """
   613	    j = torch.arange(img_w, device=depth.device, dtype=depth.dtype)
   614	    theta = ((j + 0.5) * 2.0 * math.pi / img_w - math.pi).unsqueeze(0)
   615	
   616	    def max_dev(pc: torch.Tensor) -> float:
   617	        x, y = pc[0], pc[1]
   618	        az = torch.atan2(y, x)
   619	        diff = (az - theta + math.pi) % (2.0 * math.pi) - math.pi
   620	        mag = torch.sqrt(x * x + y * y)
   621	        mask = mag > 1e-3
   622	        if bool(mask.sum() == 0):
   623	            return float("nan")
   624	        return float(diff[mask].abs().max().item())
   625	
   626	    report = {0.0: max_dev(depth)}
   627	    for deg in angles_deg:
   628	        rotated = rotate_scene_metadata({"depth": depth}, math.radians(deg), img_w)["depth"]
   629	        assert isinstance(rotated, torch.Tensor)
   630	        report[float(deg)] = max_dev(rotated)
   631	    return report

