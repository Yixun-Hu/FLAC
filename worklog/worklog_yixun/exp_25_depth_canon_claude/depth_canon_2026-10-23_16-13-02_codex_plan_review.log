   341	def build_output_paths(
   342	    ckpt_path,
   343	    steps,
   344	    cfg_scale,
   345	    eval_name,
   346	    cond_method='vanilla',
   347	    rotate_deg=0.0,
   348	    n_angles=4,
   349	    rotate_mode='fixed',
   350	    rotate_seed=None,
   351	    are_lambda=None,
   352	):
   353	    """Construct the metrics-JSON and predictions-.pt output paths for one run.
   354	
   355	    Pure (no filesystem access): both paths sit in ``ckpt_path``'s directory,
   356	    named ``<ckpt>_<kind>_<steps>_<cfg>_<eval_name><method><rot>.<ext>``.
   357	
   358	    The vanilla + ``rotate_deg == 0`` name is byte-identical to the legacy
   359	    ``eval_FLAC`` output, so exp_01 / exp_02 artifacts reproduce exactly. A
   360	    non-vanilla ``cond_method`` inserts ``_<cond_method>_a<n_angles>`` and a
   361	    non-zero ``rotate_deg`` appends ``_rot<int(rotate_deg)>``. Both suffixes now
   362	    also land on the predictions name -- fixing the exp_02 bug where two
   363	    ``rotate_deg`` values sharing an ``eval_name`` overwrote one predictions file.
   364	
   365	    ``rotate_mode='random'`` (exp_14) replaces the angle suffix with
   366	    ``_rotrand<rotate_seed>``; the fixed-mode names are unchanged down to the byte.
   367	
   368	    Returns
   369	    -------
   370	    dict
   371	        ``{'metrics': <...>.json, 'predictions': <...>.pt}``.
   372	    """
   373	    ckpt_name = os.path.basename(ckpt_path).replace('.ckpt', '')
   374	    directory = os.path.dirname(ckpt_path)
   375	    method_suffix = '' if cond_method == 'vanilla' else f'_{cond_method}_a{n_angles}'
   376	    rot = rotation_suffix(rotate_mode, rotate_deg, rotate_seed)
   377	    stem = f'{steps}_{cfg_scale}_{eval_name}{method_suffix}{rot}{are_suffix(are_lambda)}'
   378	    return {
   379	        'metrics': os.path.join(directory, f'{ckpt_name}_metrics_{stem}.json'),
   380	        'predictions': os.path.join(directory, f'{ckpt_name}_predictions_{stem}.pt'),
   381	    }
