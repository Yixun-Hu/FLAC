   484	def _stream_of(n=3, img_w=512, offsets=(102, 435, 348)):
   485	    stream = eval_FLAC.RotationStream()
   486	    for i in range(n):
   487	        md = _make_md(seed=i, img_w=img_w)
   488	        md["idx"] = i
   489	        stream.record(md, offsets[i], img_w)
   490	    return stream
