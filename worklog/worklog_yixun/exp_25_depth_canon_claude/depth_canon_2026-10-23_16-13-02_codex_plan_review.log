   253	def resolve_are_from_checkpoint(embedded_model_config, file_model_config,
   254	                                are_lambda=None):
   255	    """``(lambda_or_None, source, anchor_block_or_None)`` — BOUND TO THE CHECKPOINT.
   256	
   257	    Round-1 defect (r1 code review, finding 2): ``evaluate_model`` read the
   258	    checkpoint and the ``--model-config`` JSON as two independent objects and then
   259	    took lambda AND the calibrated constants from the JSON alone. A checkpoint
   260	    trained against one anchor could therefore be evaluated against another — it
   261	    would load cleanly, the numbers would look plausible, and the metrics row
   262	    would record the *file's* provenance rather than the artifact's. Announcement
   263	    05's whole point is that this class of mismatch is invisible after the fact.
   264	
   265	    The rule, applied only when ARE is in play so that every non-ARE evaluation
   266	    stays byte-identical to the rows already committed:
   267	
   268	    1. The checkpoint MUST carry an embedded ``model_config``. Without it there is
   269	       no way to prove which anchor trained these weights, and an assumed one is
   270	       exactly what this function exists to forbid.
   271	    2. The embedded config and the ``--model-config`` file must agree
   272	       TYPE-STRICTLY (``1`` is not ``1.0``, which is precisely the distinction the
   273	       factory enforces).
   274	    3. The anchor block is then taken from the EMBEDDED config — the artifact is
   275	       the authority, the file is only checked against it.
   276	    4. ``--are-lambda`` may override the **dose** (AR3's ``{0, 0.5, 1}`` sweep) and
   277	       nothing else. It can never change *which* anchor is added back.
   278	
   279	    An arm is "in play" if either side declares ARE, so a checkpoint trained with
   280	    ARE cannot be quietly evaluated through a non-ARE config (which would silently
   281	    skip the add-back and report the residual as if it were an RIR).
   282	    """
   283	    embedded_declares = isinstance(embedded_model_config, dict) and _are_declared(
   284	        embedded_model_config)
   285	    file_declares = _are_declared(file_model_config)
   286	
   287	    if not (embedded_declares or file_declares or are_lambda is not None):
   288	        return None, None, None
   289	
   290	    if not isinstance(embedded_model_config, dict):
   291	        raise ValueError(
   292	            "ARE evaluation requires the checkpoint's embedded 'model_config', and this "
   293	            "checkpoint carries none. Without it the anchor this arm was TRAINED "
   294	            "against cannot be proven, and evaluating against an assumed one would "
   295	            "produce plausible, unfalsifiable numbers (announcement 05). Re-export the "
   296	            "checkpoint from a run whose train.py embedded its config.")
   297	
   298	    diff = _load_exp16_readback().type_strict_diff(
   299	        embedded_model_config, file_model_config,
   300	        label_a="the checkpoint", label_b="--model-config")
   301	    if diff is not None:
   302	        raise ValueError(
   303	            "the checkpoint's embedded model_config does not match --model-config "
   304	            f"(type-strict); first difference: {diff}. Refusing to evaluate: the "
   305	            "add-back anchor would not be the anchor this checkpoint was trained "
   306	            "against, and the metrics row would record the file's provenance rather "
   307	            "than the artifact's.")
   308	
   309	    embedded_training = embedded_model_config.get("training") or {}
   310	    lam, source = resolve_are_lambda(embedded_training, are_lambda)
   311	    if lam is None:
   312	        # reachable only when a --are-lambda was passed against a config that
   313	        # declares neither key; resolve_are_lambda has already raised for that.
   314	        return None, None, None
   315	    return lam, source, dict(embedded_training[ARE_ANCHOR_KEY])
   316	
