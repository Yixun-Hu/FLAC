    72	    camera_matrix[:3, 3] = np.array([-lis_x, -lis_y, -lis_z])
    73	    point_4d = np.append(point_3d, 1.0)
    74	    camera_coord_point = camera_matrix @ point_4d
    75	    return camera_coord_point[:3]
