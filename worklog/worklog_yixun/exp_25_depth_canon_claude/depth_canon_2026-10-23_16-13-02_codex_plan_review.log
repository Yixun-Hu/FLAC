     1	"""Physically-consistent azimuthal (yaw) rotation of FLAC scene conditioning.
     2	
     3	For a mono room impulse response, rigidly rotating the whole scene (room geometry
     4	+ source + listener) about the vertical axis leaves the ground-truth RIR unchanged.
     5	This module applies that rotation to the *conditioning* metadata only: the
     6	equirectangular depth panorama (a horizontal circular roll together with a rotation
     7	of its stored per-pixel 3D vectors) and the source/context pose vectors (a rotation
     8	about z). ``context_audio`` (the reference RIR waveforms) and the target RIR are
     9	yaw-invariant and are intentionally left untouched.
    10	
    11	Used both by the standalone rotation-invariance diagnostic and by ``eval_FLAC.py``
    12	(via its optional ``--rotate-deg`` flag).
    13	"""
    14	import math
    15	from typing import Dict, List, Sequence, Tuple
    16	
    17	import torch
    18	
    19	POSE_KEYS: Tuple[str, ...] = ("source", "source_vit", "context_poses", "context_poses_vit")
    20	
    21	# Yaw subgroup G = C4 aligned with the panorama columns (90 deg = 128 columns of
    22	# W=512 -> exact roll). Single source of truth for the frame-averaging angles.
    23	DEFAULT_FRAME_ANGLES: Tuple[float, ...] = (0.0, 90.0, 180.0, 270.0)
    24	
    25	# Largest number of samples fed to the ViT conditioners in ONE frame-averaging
    26	# forward. The orbit used to run one angle at a time: at the training micro-batch
    27	# (8) that is a ~8-sample, ~512-token ViT forward per angle per conditioner, and
    28	# exp_11's P0 profiling measured every orbit cell at only 28-34% GPU utilisation
    29	# -- latency/kernel-launch bound, not compute bound. Stacking the rotated
    30	# variants along the batch dimension turns C small forwards into a few large
    31	# ones. 64 is a PER-RANK conditioner batch equal to the effective global batch,
    32	# so one orbit chunk costs about one ordinary step's worth of activations; the
    33	# batched peak is requalified by the 8x8 P0 spot cells (real forward + backward +
    34	# checkpoint recompute), not inferred from the sequential measurement.
    35	#
    36	# DISCLOSED RECIPE CHANGE (exp_11, approved as such). The averaging ARITHMETIC is
    37	# identical -- same terms, same order, same divisor. The augmentation SCHEDULE is
    38	# not: train-mode DINOv3 draws a random RoPE position rescale once per forward
    39	# (pos_embed_rescale 2.0), so angles sharing a chunk now share one draw where the
    40	# per-angle loop gave them independent draws, and fewer draws are taken overall.
    41	# This is applied identically to every arm INCLUDING the contemporaneous C4L
    42	# bridge, which is therefore the sole inferential comparator; historical rows
    43	# evaluated under the per-angle loop are labelled legacy-loop. In eval mode the
    44	# rescale is off, so eval-mode batched and loop results agree numerically.
    45	#
    46	# This is the DEFAULT, not the only value: announcement 06 requires every FA arm
    47	# to declare its effective chunk plan, and exp_14 makes the cap a per-arm config
    48	# key (``training.frame_avg_max_fwd_samples``) passed to
    49	# :func:`invariant_conditioning` as ``max_fwd_samples``. Nothing assigns to this
    50	# name at runtime -- see :func:`resolve_frame_avg_cap`.
    51	FRAME_AVG_MAX_FWD_SAMPLES: int = 64
    52	
    53	# Recorded in evaluation provenance so a metrics row states which orbit execution
    54	# produced it ('batched' here, 'loop' for the legacy per-angle path).
    55	ORBIT_EXECUTION: str = "batched"
