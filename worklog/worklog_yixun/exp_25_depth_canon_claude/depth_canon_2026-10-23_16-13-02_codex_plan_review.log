   823	def apply_rotation_plan(metadata, plan, generator=None, stream=None):
   824	    """Apply one batch's yaw rotation, per the resolved :class:`RotationPlan`.
   825	
   826	    Fixed mode reproduces the legacy eval-loop branch exactly: nothing at all
   827	    happens at ``rotate_deg == 0`` (the same list object is returned, and no
   828	    ``depth`` key is required), and a non-zero angle rotates every sample by it.
   829	    Passing a ``stream`` in fixed mode (``--record-stream``) additionally records
   830	    each position with the run's CONSTANT column shift --- 0 for an unrotated Z
   831	    cell --- taken from :func:`yaw_column_shift`, the same rule the rotation
   832	    itself applies. Recording never changes what is returned.
   833	
   834	    Random mode draws the WHOLE batch's offsets first --- one contiguous slice of
   835	    the dedicated generator's stream, in item order --- and only then does any
   836	    per-sample work. That ordering is what makes the assignment independent of
   837	    how the loader chunks the split. Each sample's PRE-rotation identity is
   838	    recorded into ``stream`` before it is rotated, so the audit describes the item
   839	    rather than the rotation.
   840	
   841	    Both ``generator`` and ``stream`` are required in random mode: a missing
   842	    generator would silently draw from the global RNG (perturbing the
   843	    evaluation's own sampling noise), and a missing stream would run an
   844	    unauditable assignment. Neither is used in fixed mode.
   845	    """
   846	    if plan.is_random:
   847	        if generator is None or stream is None:
   848	            raise ValueError(
   849	                "random rotation mode requires both a dedicated generator and a "
   850	                "RotationStream: without them the assignment is neither isolated "
   851	                "from the global RNG nor auditable."
   852	            )
   853	        if len(metadata) == 0:
   854	            return metadata
   855	        img_w = _batch_img_w(metadata)
   856	        # Draw the whole batch up front, in stream order, BEFORE any per-sample work.
   857	        offsets = draw_yaw_offsets(len(metadata), img_w, generator).tolist()
   858	        angles = offsets_to_radians(offsets, img_w)
   859	        rotated = []
   860	        for md, offset, alpha in zip(metadata, offsets, angles):
   861	            stream.record(md, offset, img_w)
   862	            rotated.append(rotate_scene_metadata(md, alpha, img_w))
   863	        return rotated
   864	
   865	    # Fixed mode. With no stream and no angle there is nothing to do at all --
   866	    # not even a depth lookup, which the legacy branch never made.
   867	    if stream is None and plan.rotate_deg == 0.0:
   868	        return metadata
   869	    if len(metadata) == 0:
   870	        return metadata
   871	    img_w = _batch_img_w(metadata)
   872	    alpha_rad = math.radians(plan.rotate_deg)
   873	    if stream is not None:
   874	        dj = yaw_column_shift(alpha_rad, img_w)
   875	        for md in metadata:
   876	            stream.record(md, dj, img_w)
   877	    if plan.rotate_deg != 0.0:
   878	        return [rotate_scene_metadata(md, alpha_rad, img_w) for md in metadata]
   879	    return metadata
