  1285	# =========================================================================== #
  1286	# ROUND-1 FIX BATCH — F5: prove the ordering through a REAL multi-worker loader
  1287	# =========================================================================== #
  1288	# Review N5: every other test drives the helper directly or through an empty stub
  1289	# loader, so worker-process ordering was argued (PyTorch 2.7 defaults to
  1290	# in_order=True; the repo pins shuffle=False / drop_last=false) rather than
  1291	# observed. This observes it: two worker processes, a ragged batch split, and the
  1292	# assertion that the golden seed-42 offsets land on items 0..7 in sampler order.
  1293	class _TinyEvalDataset(torch.utils.data.Dataset):
  1294	    """8 in-memory items shaped like the AR eval loader's output.
  1295	
  1296	    Module-level (not a closure) so it survives pickling to worker processes, and
  1297	    the tensors are built per __getitem__ so the workers copy a description rather
  1298	    than ~200 kB of panoramas.
  1299	    """
  1300	
  1301	    def __init__(self, n=8, img_w=IMG_W, height=4):
  1302	        self.n, self.img_w, self.height = n, img_w, height
  1303	
  1304	    def __len__(self):
  1305	        return self.n
  1306	
  1307	    def __getitem__(self, idx):
  1308	        g = torch.Generator().manual_seed(1000 + idx)
  1309	        info = {
  1310	            "idx": idx,
  1311	            "relpath": f"sceneA/000{idx}/S00{idx}_R000_hybrid_IR.wav",
  1312	            "scene": "sceneA",
  1313	            "context_poses": torch.randn(2, 3, generator=g),
  1314	            "depth": torch.randn(3, self.height, self.img_w, generator=g),
  1315	        }
  1316	        return torch.zeros(1, 16), info
  1317	
  1318	
  1319	def test_random_offsets_attach_in_sampler_order_through_a_multiworker_dataloader():
  1320	    from src.data.dataset import collation_fn   # the eval loader's own collate
  1321	
  1322	    dataset = _TinyEvalDataset()
  1323	    loader = torch.utils.data.DataLoader(
  1324	        dataset, batch_size=3, shuffle=False, drop_last=False, num_workers=2,
  1325	        collate_fn=collation_fn,
  1326	    )
  1327	
  1328	    plan = eval_FLAC.resolve_rotation_plan("random", 0.0, 42, 42)
  1329	    stream = eval_FLAC.RotationStream()
  1330	    g = _gen(42)
  1331	    batch_sizes = []
  1332	    for reals, metadata in loader:
  1333	        batch_sizes.append(len(metadata))
  1334	        eval_FLAC.apply_rotation_plan(metadata, plan, g, stream)
  1335	
  1336	    assert batch_sizes == [3, 3, 2], "ragged tail batch expected (drop_last=False)"
  1337	    # the pre-registered assignment, item by item, across a worker boundary
  1338	    assert stream.offsets == GOLDEN_SEED42_W512[:8]
  1339	    assert [r.dataset_idx for r in stream.rows] == list(range(8))
  1340	    assert [r.target_id for r in stream.rows] == [
  1341	        f"{i}|sceneA/000{i}/S00{i}_R000_hybrid_IR.wav" for i in range(8)]
  1342	    # and both guards accept the stream this really produced
  1343	    eval_FLAC.verify_stream_positions(stream)
  1344	    eval_FLAC.verify_stream_count(stream, len(dataset), 8)
