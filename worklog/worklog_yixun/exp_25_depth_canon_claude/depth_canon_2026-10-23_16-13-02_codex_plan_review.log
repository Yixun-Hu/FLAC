   590	def _spy_conditioning(wrapper):
   591	    """Record the metadata list each ``_compute_conditioning`` call receives."""
   592	    seen = []
   593	    original = wrapper._compute_conditioning
   594	
   595	    def _spy(metadata):
   596	        seen.append(metadata)
   597	        return original(metadata)
   598	
   599	    wrapper._compute_conditioning = _spy
   600	    return seen
