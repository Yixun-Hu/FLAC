   179	            raise ValueError(
   180	                f"training.{ARE_ANCHOR_KEY} may not restate {restated}: they are read "
   181	                "from the model config (sample_rate / sample_size), so a second copy "
   182	                "could silently disagree with the audio being trained on.")
   183	        raise ValueError(
   184	            f"training.{ARE_ANCHOR_KEY} has unknown key(s) {unknown}; allowed keys are "
   185	            f"{sorted(allowed)}")
