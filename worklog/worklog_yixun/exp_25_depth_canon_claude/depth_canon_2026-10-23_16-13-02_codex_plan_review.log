   510	    def _compute_conditioning(self, metadata):
   511	        """Dispatch conditioning by cond_method (exp_03 plan §2c).
   512	
   513	        ``fa_invariant`` routes through the Route-1 yaw-symmetrized path
   514	        (cylindrical pose features + C4 frame average of the ViT conditioners);
   515	        ``vanilla`` is the unchanged single conditioner pass. Called from
   516	        training_step, validation_step AND test_step so all inference/training
   517	        sites share one dispatch point (the repo's flow_source precedent). The
   518	        raise is a backstop; the constructor already rejects unknown values.
   519	
   520	        ``max_fwd_samples`` is passed as a KEYWORD: the parameter after ``angles``
   521	        is ``vit_ids``, so a positional slip would disable the frame average
   522	        instead of changing the chunk plan.
   523	
   524	        The no-cap case takes a SEPARATE branch that issues the original
   525	        four-argument call verbatim (r1 review finding 1). ``max_fwd_samples=None``
   526	        is numerically identical, but "identical behaviour" and "the literal
   527	        pre-change call" are different guarantees, and every arm already in the
   528	        record — including the cluster's in-flight exp_12C run — was trained
   529	        through the four-argument form. Only an arm that DECLARES a cap gets a
   530	        different call shape.
   531	        """
   532	        if self.cond_method == "fa_invariant":
   533	            if self.frame_avg_max_fwd_samples is None:
