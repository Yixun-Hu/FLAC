   383	
   384	# Decimal places used to fingerprint a context-source position. Reference sources
   385	# in AR sit metres apart, so 1e-6 m never merges two of them, and a fixed-width
   386	# decimal string is stable across machines in a way float repr is not.
   387	CONTEXT_ID_PRECISION = 6
   388	
   389	# Version of the context-fingerprint rule (precision, field order, dtype pin).
   390	# Recorded next to every fingerprint we persist: the rendering is stable only
   391	# under the assumptions asserted in sample_context_ids, so a future change to any
   392	# of them must be visible as a schema bump rather than as silently incomparable
   393	# hashes. Codex code review N4 measured the fragility on the real unseen split:
   394	# rendering the same positions as float64 changed two six-decimal strings and
   395	# float16 changed 5,032 of them.
   396	CONTEXT_FINGERPRINT_SCHEMA = 1
   397	
   398	# Schema 2 (exp_19 R3): room-qualified, zero-padded CAPTURE IDs, used only when the
   399	# batch metadata actually carries them (``context_capture_ids``, int64). RAF's
   400	# receivers all sit inside one 1.46 m array and its placements are re-occupied to
   401	# sub-centimetre precision, so two different draws can render to the SAME
   402	# six-decimal position fingerprint -- the identity schema 1 relies on. Datasets
   403	# that expose no ids (AR, HAA) keep schema 1 BYTE-identically: the constant above
   404	# is deliberately NOT bumped, because a peer session pairs AR cells by these
   405	# digests and validates their sidecars against the literal 1.
   406	CONTEXT_ID_FINGERPRINT_SCHEMA = 2
   407	
   408	# Width the capture id is zero-padded to before it enters a fingerprint, so the
   409	# rendering of one id is fixed regardless of its magnitude.
   410	CONTEXT_CAPTURE_ID_WIDTH = 6

