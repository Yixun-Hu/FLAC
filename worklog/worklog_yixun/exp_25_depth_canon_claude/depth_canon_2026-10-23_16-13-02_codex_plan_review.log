   334	def test_step_seed_is_a_valid_32_bit_generator_seed():
   335	    """32 bits, because that is all the pinned torch CPU generator keeps.
   336	
   337	    See ``test_torch_cpu_generator_ignores_high_seed_bits``: returning a wider
   338	    value would only *look* like more entropy.
   339	    """
   340	    for seed, step, rank in [(0, 0, 0), (42, 0, 0), (42, 39999, 7), (2**31, 10**6, 63)]:
   341	        value = tdiff._yaw_aug_step_seed(seed, step, rank)
   342	        assert isinstance(value, int)
   343	        assert 0 <= value < 2**32
   344	
   345	
   346	def test_torch_cpu_generator_ignores_high_seed_bits():
   347	    """Pinned-environment documentation test (round-1 review, finding 1).
   348	
   349	    torch 2.7.0's CPU MT19937 seeds from the low 32 bits only, so ``s`` and
   350	    ``s + 2**32`` are the same stream. This is *why* _yaw_aug_step_seed derives a
   351	    keyed 32-bit bijection instead of a well-avalanched 63-bit hash: only an
   352	    injection into the 32-bit space can promise distinct streams.
   353	    """
   354	    a = torch.randint(0, 512, (32,), generator=torch.Generator().manual_seed(12345))
   355	    b = torch.randint(0, 512, (32,), generator=torch.Generator().manual_seed(12345 + 2**32))
   356	    assert torch.equal(a, b), (
   357	        "the pinned torch CPU generator no longer aliases seeds modulo 2**32; the "
   358	        "assumption behind the 32-bit bijection in _yaw_aug_step_seed has changed "
   359	        "and the derivation should be revisited (a wider seed would now be usable)"
   360	    )
