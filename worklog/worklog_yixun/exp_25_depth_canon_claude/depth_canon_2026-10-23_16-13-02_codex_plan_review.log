   463	PRE_CHANGE_WRAPPER_KWARGS = {
   464	    "lr", "mask_padding", "mask_padding_dropout", "use_ema", "log_loss_info",
   465	    "optimizer_configs", "pre_encoded", "cfg_dropout_prob", "timestep_sampler",
