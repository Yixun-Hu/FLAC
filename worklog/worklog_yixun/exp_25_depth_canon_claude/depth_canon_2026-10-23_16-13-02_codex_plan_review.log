    85	def rot_token(rotate_deg):
    86	    """The decimal-safe rendering of a yaw offset, with no empty case.
    87	
    88	    ``rot_suffix`` renders 0 as the empty string so unrotated filenames stay
    89	    byte-identical to the legacy ones. An eval NAME cannot do that -- `rot` with
    90	    nothing after it is not a name -- so the R3 naming uses this instead:
    91	    ``0 -> '0'``, ``5.625 -> '5p625'``.
    92	    """
    93	    d = float(rotate_deg)
    94	    return str(int(d)) if d.is_integer() else repr(d).replace('.', 'p')
