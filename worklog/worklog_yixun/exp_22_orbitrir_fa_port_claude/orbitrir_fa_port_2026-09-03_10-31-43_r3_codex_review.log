   307	    missing = list(missing)
   308	    stray = [k for k in unexpected if not k.startswith(whitelist_prefixes)]
   309	    n_benign = len(list(unexpected)) - len(stray)
   310	    print(f"Checkpoint load: {len(missing)} missing, {len(stray)} stray unexpected, "
   311	          f"{n_benign} whitelisted wrapper-leftover keys.")
   312	    if not (missing or stray):
   313	        return
   314	    msg = (f"Checkpoint did not load cleanly: {len(missing)} missing keys "
   315	           f"(first: {missing[:5]}), {len(stray)} stray unexpected keys "
   316	           f"(first: {stray[:5]}). Wrong model-config/checkpoint pairing? "
   317	           "Re-export the checkpoint or fix the model-config/checkpoint pairing.")
   318	    raise RuntimeError(msg)
