    85	        ``'context_poses'`` row -> ``(r_i, z_i, wrap(phi_i - phi_ref))``.
    86	    """
    87	    out: Dict[str, object] = dict(md)
    88	
    89	    source = md.get("source")
    90	    context = md.get("context_poses")
    91	
    92	    # Candidate poses for the fallback reference azimuth: source + context rows.
    93	    cand_r = []
    94	    cand_phi = []
    95	
    96	    r_s = phi_s = sz = None
    97	    if source is not None:
    98	        assert isinstance(source, torch.Tensor)
    99	        sx, sy, sz = source[..., 0], source[..., 1], source[..., 2]
