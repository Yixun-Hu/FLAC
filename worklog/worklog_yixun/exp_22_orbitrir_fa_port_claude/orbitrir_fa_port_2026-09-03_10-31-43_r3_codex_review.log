+    "checkpoint": "the model_config embedded in the checkpoint by the training run",
+    "model_config": ("the --model-config JSON's training block -- this checkpoint carries "
+                     "no embedded model_config, so the JSON is the only authority available"),
+}
+
+OFF_DIAGONAL_WARNING = (
+    "Off-diagonal evaluation (an fa_invariant checkpoint under vanilla conditioning, or "
+    "the reverse) yields plausible-looking metrics that are comparable to nothing."
+)
+
+INHERIT_REMEDY = (
+    "Omit --cond-method / --frame-avg-angles to inherit the trained protocol, or pass "
+    f"{CONDITIONING_OVERRIDE_FLAG} to evaluate off-diagonal on purpose."
