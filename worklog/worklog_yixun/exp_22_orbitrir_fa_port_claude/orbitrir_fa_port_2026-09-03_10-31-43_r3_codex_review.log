   112	        cand_phi.append(phi_c.reshape(-1))
   113	
   114	    # Reference azimuth: target source, unless degenerate -> largest-r pose.
   115	    # The fallback pose must itself be non-degenerate (its azimuth defined);
   116	    # if even the largest r is < eps the scene is all-degenerate -> dphi == 0.
   117	    phi_ref = None
   118	    if r_s is not None and bool(r_s >= eps):
   119	        phi_ref = phi_s
   120	    elif cand_r:
   121	        all_r = torch.cat(cand_r)
