   115	    ``whitelist_prefixes``. Any other mismatch raises ``RuntimeError`` unless
   116	    ``allow_partial_load`` is set, which downgrades it to a printed warning.
   117	    """
   118	    missing = list(missing)
   119	    stray = [k for k in unexpected if not k.startswith(whitelist_prefixes)]
   120	    n_benign = len(list(unexpected)) - len(stray)
   121	    print(f"Checkpoint load: {len(missing)} missing, {len(stray)} stray unexpected, "
   122	          f"{n_benign} whitelisted wrapper-leftover keys.")
