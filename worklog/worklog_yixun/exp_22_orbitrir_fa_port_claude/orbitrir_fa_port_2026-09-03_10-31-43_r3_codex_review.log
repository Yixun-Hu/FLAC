+    ({"state_dict": {}, "model_config": {"training": {"use_ema": False}}},
+     ("vanilla", None, "checkpoint")),
+    # bare/exported checkpoint -> the --model-config training block
+    ({"state_dict": {}}, ("fa_invariant", [0.0, 180.0], "model_config")),
+    # embedded model_config without a training block -> same fallback
+    ({"state_dict": {}, "model_config": {"model_type": "diffusion_cond"}},
+     ("fa_invariant", [0.0, 180.0], "model_config")),
+    # embedded training block of the wrong type is not a training block
+    ({"state_dict": {}, "model_config": {"training": None}},
+     ("fa_invariant", [0.0, 180.0], "model_config")),
+])
