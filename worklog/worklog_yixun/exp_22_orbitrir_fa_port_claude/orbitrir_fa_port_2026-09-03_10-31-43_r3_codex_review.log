   192	def test_embedded_config_without_cond_method_means_vanilla(tmp_path, monkeypatch):
   193	    """An embedded training block with no ``cond_method`` key means vanilla.
   194	
   195	    It is the factory default (``training_config.get("cond_method", "vanilla")``),
   196	    so an absent key is a positive statement about the weights -- never ``None``
   197	    and never a reason to fall through to the ``--model-config``. Proven twice:
   198	    on the helper, and end-to-end where the embedded (silent = vanilla) block
   199	    beats an ``fa_invariant`` model config, leaving a single conditioner pass.
   200	    """
   201	    method, angles, source = eval_FLAC.trained_conditioning(
   202	        {"state_dict": {}, "model_config": {"training": {"use_ema": False}}},
