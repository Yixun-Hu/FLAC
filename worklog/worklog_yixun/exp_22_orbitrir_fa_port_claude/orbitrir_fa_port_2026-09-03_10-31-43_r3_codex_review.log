+def test_override_flag_on_a_matching_run_is_not_recorded(tmp_path, monkeypatch):
+    """The flag alone does not taint a record: an on-protocol run stays
+    ``conditioning_override: false`` even when the flag is passed, so the field
+    means "this run was off-diagonal", not "someone typed the flag"."""
+    _run_eval(
+        tmp_path, monkeypatch,
+        ckpt_extra=_embedded({"cond_method": "fa_invariant"}),
+        cond_method="fa_invariant", allow_conditioning_override=True,
+    )
+    assert _saved_metrics(tmp_path)["conditioning_override"] is False
