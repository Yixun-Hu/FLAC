   422	        self.events = events
   423	        self._delegate = delegate
   424	        self.calls = []
   425	
   426	    def __call__(self, *args, **kwargs):
   427	        self.events.append(self.name)
   428	        self.calls.append((args, kwargs))
   429	        return self._delegate(*args, **kwargs)
