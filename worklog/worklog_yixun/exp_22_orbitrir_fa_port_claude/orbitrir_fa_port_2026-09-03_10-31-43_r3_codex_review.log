   207	        depth = torch.roll(depth, shifts=dj, dims=2)
   208	        rot_d = rot.to(device=depth.device, dtype=depth.dtype)
   209	        out["depth"] = torch.einsum("ij,jhw->ihw", rot_d, depth)
