+# --------------------------------------------------------------------------- #
+# 6. eval_pl: same guard, no override flag
+# --------------------------------------------------------------------------- #
+def _run_eval_pl(tmp_path, monkeypatch, config_training=None, ckpt_extra=None,
+                 model_factory=None):
+    """Drive ``eval_pl.main`` with everything heavy faked.
+
+    Stubbed at ``eval_pl``'s namespace: the CLI parser (``get_all_args``), the
+    model factory, the dataloader, the training wrapper (which supplies
+    ``metrics_dict``) and ``pl`` itself -- replaced by a namespace exposing only
+    the two attributes ``main`` uses, so no real Trainer is constructed and the
+    installed ``pytorch_lightning`` module is never patched.
+
+    ``model_factory`` overrides the model-factory stub -- pass
+    ``_fail_if_model_built`` to assert the guard fires before construction.
+    """
+    training = {"use_ema": False, "metrics": {}}
+    training.update(config_training or {})
+    model_cfg = tmp_path / "model.json"
+    model_cfg.write_text(json.dumps({
+        "model_type": "diffusion_cond", "sample_size": 64, "sample_rate": 22050,
+        "audio_channels": 1, "training": training,
+    }))
+    dataset_cfg = tmp_path / "dataset.json"
+    dataset_cfg.write_text(json.dumps({"datasets": [{"id": "toy"}]}))
+    ckpt = tmp_path / "toy.ckpt"
+    payload = {"state_dict": {}}
+    payload.update(ckpt_extra or {})
+    torch.save(payload, str(ckpt))
+
+    args = types.SimpleNamespace(
+        seed=42, model_config=str(model_cfg), val_dataset_config=str(dataset_cfg),
+        batch_size=2, num_workers=0, cfg_scale=1.0, steps=1, store_predictions=False,
+        num_gpus=1, num_nodes=1, precision="32", accum_batches=1, gradient_clip_val=0.0,
+        ckpt_path=str(ckpt),
+    )
+    tested = {}
+
+    class _FakeTrainer:
+        def __init__(self, **kwargs):
+            tested["trainer_kwargs"] = kwargs
+
+        def test(self, module, dataloader, ckpt_path=None):
+            tested["ckpt_path"] = ckpt_path
+
+    monkeypatch.setattr(eval_pl, "get_all_args", lambda: args)
+    monkeypatch.setattr(eval_pl, "create_model_from_config",
+                        model_factory or (lambda cfg: object()))
+    monkeypatch.setattr(eval_pl, "create_dataloader_from_config", lambda *a, **k: [])
+    monkeypatch.setattr(
+        eval_pl, "create_training_wrapper_from_config",
+        lambda cfg, model: types.SimpleNamespace(
+            metrics_dict={"T60": 1.23}, store_predictions=False
+        ),
+    )
+    monkeypatch.setattr(eval_pl, "pl", types.SimpleNamespace(
+        seed_everything=lambda seed, workers=False: None, Trainer=_FakeTrainer,
+    ))
+
+    eval_pl.main()
+    return tested, json.loads((tmp_path / "toy_metrics_1_1.0_.json").read_text())
+
+
+def test_eval_pl_mismatching_config_and_checkpoint_raises(tmp_path, monkeypatch):
