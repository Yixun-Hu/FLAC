+# --------------------------------------------------------------------------- #
+# 4. deliberate override
+# --------------------------------------------------------------------------- #
+def test_override_permits_mismatch_and_records_it(tmp_path, monkeypatch):
+    """``allow_conditioning_override`` lets an off-diagonal run proceed, and BOTH
+    output records (metrics JSON and predictions sidecar) carry the runtime
+    protocol, the trained protocol, its source and the override flag -- so the
+    numbers cannot be mistaken later for on-protocol ones."""
+    dispatch_spy, module = _run_eval(
+        tmp_path, monkeypatch,
+        ckpt_extra=_embedded({"cond_method": "fa_invariant",
+                              "frame_avg_angles": [0, 90, 180, 270]}),
+        cond_method="vanilla", allow_conditioning_override=True, store_predictions=True,
+    )
+    assert _dispatched(dispatch_spy)[0] == "vanilla"
+    assert len(module.conditioner.calls) == 1
+
+    record = _saved_metrics(tmp_path)
+    assert record["conditioning_override"] is True
+    assert record["cond_method"] == "vanilla"
+    assert record["frame_avg_angles"] is None
+    assert record["trained_cond_method"] == "fa_invariant"
+    assert record["trained_frame_avg_angles"] == [0.0, 90.0, 180.0, 270.0]
+    assert record["cond_method_source"] == "checkpoint"
+
+    predictions = sorted(Path(tmp_path).glob("*_predictions_*.pt"))
+    assert len(predictions) == 1
+    meta = torch.load(str(predictions[0]))["meta"]
+    assert meta["conditioning_override"] is True
+    assert meta["cond_method"] == "vanilla"
+    assert meta["trained_cond_method"] == "fa_invariant"
+    assert meta["trained_frame_avg_angles"] == [0.0, 90.0, 180.0, 270.0]
+    assert meta["cond_method_source"] == "checkpoint"
+
