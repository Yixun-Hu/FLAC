   206	def effective_frame_angles(cond_method, frame_avg_angles):
   207	    """Normalize one side of a frame-angle comparison to a float tuple, or ``None``.
   208	
   209	    ``None`` means *no constraint*. Under ``'vanilla'`` the frame-average angles
   210	    are never consumed, so an unspecified orbit constrains nothing; under
   211	    ``'fa_invariant'`` an unspecified orbit IS a statement, because
   212	    ``resolve_conditioning_options`` substitutes :data:`DEFAULT_FRAME_ANGLES`.
   213	
   214	    Angles are coerced to floats so ``[0, 90]`` from a JSON config compares equal
   215	    to ``(0.0, 90.0)`` from the CLI. The comparison stays a **sequence** compare:
   216	    a reordered orbit counts as different even though the frame average is a mean
   217	    over it, because the orbit is recorded (and reproduced) as a sequence and
   218	    float summation is not associative.
   219	    """
   220	    if frame_avg_angles is not None:
   221	        return tuple(float(a) for a in frame_avg_angles)
   222	    if cond_method == "fa_invariant":
   223	        return tuple(float(a) for a in DEFAULT_FRAME_ANGLES)
   224	    return None
   225	
   226	
   227	def frame_angles_record(cond_method, frame_avg_angles):
   228	    """JSON-friendly orbit for the output records.
   229	
   230	    A list of floats under ``'fa_invariant'`` -- the orbit the run actually
   231	    averaged over, resolved default included -- and ``None`` under any other
   232	    method, which consumes no orbit: a record must never imply an orbit that was
   233	    not used, even when one was passed alongside a vanilla run.
   234	    """
   235	    if cond_method != "fa_invariant":
   236	        return None
   237	    return list(effective_frame_angles(cond_method, frame_avg_angles))
