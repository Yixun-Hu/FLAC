   160	def trained_conditioning(checkpoint, model_config):
   161	    """Recover the conditioning protocol a checkpoint's weights were trained under.
   162	
   163	    Two authorities, in order:
   164	
   165	    1. ``train.py``'s checkpoint-embedder callback writes the whole
   166	       ``model_config`` into every training checkpoint, so
   167	       ``checkpoint['model_config']['training']`` is the config that actually
   168	       built the training wrapper -- the authoritative record. A ``training``
   169	       block with **no** ``cond_method`` key means ``'vanilla'``: that is the
   170	       factory default (``src/training/factory.py`` passes
   171	       ``training_config.get("cond_method", "vanilla")``), so an absent key is a
   172	       positive statement about the weights, not missing information.
   173	    2. Exported / bare checkpoints (a ``state_dict`` and nothing else) carry no
   174	       embedded config. There the ``--model-config`` JSON's ``training`` block is
   175	       the only authority available, and is used as the fallback -- with the same
   176	       absent-key-means-vanilla rule.
   177	
   178	    Parameters
   179	    ----------
   180	    checkpoint : dict
   181	        The raw ``torch.load`` result (not the extracted ``state_dict``).
   182	    model_config : dict
   183	        The parsed ``--model-config`` JSON, used only for the fallback.
   184	
   185	    Returns
   186	    -------
   187	    Tuple[str, Optional[Sequence[float]], str]
   188	        ``(cond_method, frame_avg_angles, source)`` where ``source`` is
   189	        ``'checkpoint'`` or ``'model_config'`` and ``frame_avg_angles`` is left
   190	        exactly as declared (``None`` when the config declares no orbit).
   191	    """
   192	    embedded = checkpoint.get("model_config") if isinstance(checkpoint, dict) else None
   193	    training = embedded.get("training") if isinstance(embedded, dict) else None
   194	
   195	    if isinstance(training, dict):
   196	        source = "checkpoint"
   197	    else:
   198	        source = "model_config"
   199	        training = model_config.get("training") if isinstance(model_config, dict) else None
   200	        if not isinstance(training, dict):
   201	            training = {}
   202	
   203	    return training.get("cond_method", "vanilla"), training.get("frame_avg_angles", None), source
