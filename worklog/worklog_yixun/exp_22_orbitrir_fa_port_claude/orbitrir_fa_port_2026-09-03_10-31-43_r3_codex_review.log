   145	def test_inherits_trained_method_and_orbit_from_embedded_config(tmp_path, monkeypatch):
   146	    """No ``--cond-method``: the checkpoint's embedded training block decides.
   147	
   148	    The ``--model-config`` JSON here declares NO method (i.e. vanilla), so an
   149	    inherited ``fa_invariant`` can only have come from the checkpoint -- and the
   150	    non-default orbit ``[0, 180]`` (ints, as a JSON config carries them) must
   151	    arrive at the dispatcher coerced to floats.
   152	    """
   153	    dispatch_spy, module = _run_eval(
   154	        tmp_path, monkeypatch,
   155	        ckpt_extra=_embedded({"cond_method": "fa_invariant", "frame_avg_angles": [0, 180]}),
   156	    )
   157	    method, angles = _dispatched(dispatch_spy)
   158	    assert method == "fa_invariant"
   159	    assert angles == (0.0, 180.0)
   160	    assert all(isinstance(a, float) for a in angles)
   161	    assert len(module.conditioner.calls) == 2, "base pass + one frame angle"
   162	
   163	    record = _saved_metrics(tmp_path)
   164	    assert record["cond_method"] == "fa_invariant"
   165	    assert record["frame_avg_angles"] == [0.0, 180.0]
   166	    assert record["trained_cond_method"] == "fa_invariant"
   167	    assert record["trained_frame_avg_angles"] == [0.0, 180.0]
   168	    assert record["cond_method_source"] == "checkpoint"
   169	    assert record["conditioning_override"] is False
   170	    # the inherited protocol reaches the filename too (two-angle orbit -> a2)
   171	    assert "_fa_invariant_a2" in _metrics_path(tmp_path).name
