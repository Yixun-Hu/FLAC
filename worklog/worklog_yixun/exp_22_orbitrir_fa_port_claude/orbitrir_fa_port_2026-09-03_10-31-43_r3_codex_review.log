diff --git a/src/tests/test_eval_paths.py b/src/tests/test_eval_paths.py
new file mode 100644
index 0000000..be18ddb
--- /dev/null
+++ b/src/tests/test_eval_paths.py
@@ -0,0 +1,568 @@
+"""Tests for ``eval_FLAC``'s evaluation helpers and their wiring into
+``evaluate_model`` / the CLI: output-path construction, the metrics record, the
+``--cond-autocast`` mode table, the predictions-sidecar meta, checkpoint-load
+integrity checking, the fail-fast option validation, the argparse flag surface,
+and a one-batch end-to-end flow proving the eval loop rotates the conditioning
+metadata BEFORE handing it to the shared conditioning dispatcher.
+
+REGRESSION PIN: the vanilla + ``rotate_deg == 0`` filenames asserted below are
+exactly the names this script produced before the conditioning / rotation flags
+existed -- ``<ckpt>_metrics_<steps>_<cfg>_<eval_name>.json`` and the matching
+``<ckpt>_predictions_<steps>_<cfg>_<eval_name>.pt``. They must never drift, or
+already-published results stop being reproducible under their own names.
+
+``build_output_paths`` is a pure string function, so ``CKPT`` below need not
+exist on disk; the leading directory is preserved by ``os.path.join``.
+"""
+import json
+import math
+import os
+import subprocess
+import sys
+import types
+from pathlib import Path
+
+import pytest
+import torch
+
+import eval_FLAC  # noqa: E402  (heavy but side-effect-free at import; argparse is under main())
+import src.inference.sampling as sampling  # noqa: E402  (sampler patched in the flow test)
+from src.data.yaw_rotation import (  # noqa: E402
+    DEFAULT_FRAME_ANGLES,
+    dispatch_conditioning as real_dispatch_conditioning,
+    rotate_scene_metadata as real_rotate_scene_metadata,
+)
+
+
+CKPT = "weights/FLAC/FLAC_EMA.ckpt"
+REPO_ROOT = str(Path(__file__).resolve().parents[2])
+
+
+# --------------------------------------------------------------------------- #
+# build_output_paths
+# --------------------------------------------------------------------------- #
+def test_legacy_vanilla_paths():
+    """Vanilla + rot0 reproduces the pre-flag filenames exactly (both artifacts)."""
+    paths = eval_FLAC.build_output_paths(
+        CKPT, steps=1, cfg_scale=1.0, eval_name="unseen_K1_seed42",
+        cond_method="vanilla", rotate_deg=0.0,
+    )
+    assert paths["metrics"] == (
+        "weights/FLAC/FLAC_EMA_metrics_1_1.0_unseen_K1_seed42.json"
+    )
+    assert paths["predictions"] == (
+        "weights/FLAC/FLAC_EMA_predictions_1_1.0_unseen_K1_seed42.pt"
+    )
+
+
+def test_legacy_rot_metrics_path():
+    """``--eval-name yaw_rot180 --rotate-deg 180``.
+
+    The metrics name keeps the doubled ``_rot180`` -- the suffix is appended
+    unconditionally, on top of whatever the caller spelled into ``eval_name``;
+    that shape is pinned, not accidental. The predictions name now carries the
+    same rot suffix, so two ``rotate_deg`` values sharing one ``eval_name`` no
+    longer overwrite a single predictions file.
+    """
+    paths = eval_FLAC.build_output_paths(
+        CKPT, steps=1, cfg_scale=1.0, eval_name="yaw_rot180",
+        cond_method="vanilla", rotate_deg=180.0,
+    )
+    assert paths["metrics"] == (
+        "weights/FLAC/FLAC_EMA_metrics_1_1.0_yaw_rot180_rot180.json"
+    )
+    assert paths["predictions"] == (
+        "weights/FLAC/FLAC_EMA_predictions_1_1.0_yaw_rot180_rot180.pt"
+    )
+
+
+def test_fa_invariant_paths():
+    """fa_invariant tags both filenames with method + angle count, before rot."""
+    paths = eval_FLAC.build_output_paths(
+        CKPT, steps=1, cfg_scale=1.0, eval_name="unseen_K1",
+        cond_method="fa_invariant", rotate_deg=90.0, n_angles=4,
+    )
+    assert paths["metrics"] == (
+        "weights/FLAC/FLAC_EMA_metrics_1_1.0_unseen_K1_fa_invariant_a4_rot90.json"
+    )
+    assert paths["predictions"] == (
+        "weights/FLAC/FLAC_EMA_predictions_1_1.0_unseen_K1_fa_invariant_a4_rot90.pt"
+    )
+    # Method tag precedes the rot suffix.
+    assert paths["metrics"].index("_fa_invariant_a4") < paths["metrics"].index("_rot90")
+
+
+def test_fa_invariant_rot0_has_method_no_rot_suffix():
+    """fa_invariant at rot0: method tag present, no rot suffix."""
+    paths = eval_FLAC.build_output_paths(
+        CKPT, steps=1, cfg_scale=1.0, eval_name="unseen_K1",
+        cond_method="fa_invariant", rotate_deg=0.0, n_angles=4,
+    )
+    assert paths["metrics"] == (
+        "weights/FLAC/FLAC_EMA_metrics_1_1.0_unseen_K1_fa_invariant_a4.json"
+    )
+    assert paths["predictions"] == (
+        "weights/FLAC/FLAC_EMA_predictions_1_1.0_unseen_K1_fa_invariant_a4.pt"
+    )
+
+
+def test_metrics_and_predictions_share_suffix():
+    """The metrics/predictions names differ ONLY by kind + extension (no drift)."""
+    paths = eval_FLAC.build_output_paths(
+        CKPT, steps=1, cfg_scale=1.0, eval_name="e",
+        cond_method="fa_invariant", rotate_deg=270.0, n_angles=4,
+    )
+    m = paths["metrics"].replace("_metrics_", "_KIND_").removesuffix(".json")
+    p = paths["predictions"].replace("_predictions_", "_KIND_").removesuffix(".pt")
+    assert m == p
+
+
+def test_build_output_paths_n_angles_reflected():
+    """Angle count is encoded in the method tag (a2 vs default a4)."""
+    paths = eval_FLAC.build_output_paths(
+        CKPT, steps=1, cfg_scale=1.0, eval_name="e",
+        cond_method="fa_invariant", rotate_deg=0.0, n_angles=2,
+    )
+    assert "_fa_invariant_a2" in paths["metrics"]
+    assert "_fa_invariant_a2" in paths["predictions"]
+
+
+def test_rot_suffix_collision_free():
+    """Fractional rotation angles must produce distinct names.
+
+    Truncating the angle (``int(rotate_deg)``) maps 37.3 and 37.9 onto the same
+    ``_rot37`` stem, so one point of a fine-grained yaw sweep would silently
+    overwrite the other's metrics AND predictions. The ``'g'`` formatting keeps
+    them apart while leaving integer-valued angles in their bare legacy form.
+    """
+    a = eval_FLAC.build_output_paths(
+        CKPT, steps=1, cfg_scale=1.0, eval_name="sweep",
+        cond_method="vanilla", rotate_deg=37.3,
+    )
+    b = eval_FLAC.build_output_paths(
+        CKPT, steps=1, cfg_scale=1.0, eval_name="sweep",
+        cond_method="vanilla", rotate_deg=37.9,
+    )
+    assert a["metrics"] != b["metrics"]
+    assert a["predictions"] != b["predictions"]
+    assert a["metrics"].endswith("_sweep_rot37.3.json")
+    assert b["metrics"].endswith("_sweep_rot37.9.json")
+    assert a["predictions"].endswith("_sweep_rot37.3.pt")
+    assert b["predictions"].endswith("_sweep_rot37.9.pt")
+
+    # Integer-valued angles keep the legacy bare form (no trailing '.0').
+    for deg, tag in ((90.0, "_rot90"), (270.0, "_rot270")):
+        paths = eval_FLAC.build_output_paths(
+            CKPT, steps=1, cfg_scale=1.0, eval_name="sweep",
+            cond_method="vanilla", rotate_deg=deg,
+        )
+        assert paths["metrics"].endswith(f"_sweep{tag}.json")
+        assert paths["predictions"].endswith(f"_sweep{tag}.pt")
+
+    # rot0 carries no rot suffix at all.
+    zero = eval_FLAC.build_output_paths(
+        CKPT, steps=1, cfg_scale=1.0, eval_name="sweep",
+        cond_method="vanilla", rotate_deg=0.0,
+    )
+    assert zero["metrics"].endswith("_sweep.json")
+    assert "_rot" not in os.path.basename(zero["metrics"])
+    assert "_rot" not in os.path.basename(zero["predictions"])
+
+
+# --------------------------------------------------------------------------- #
+# build_metrics_record
+# --------------------------------------------------------------------------- #
+def test_metrics_json_records_method_vanilla():
+    """Record keeps the original keys and adds cond_method + frame_avg_angles."""
+    rec = eval_FLAC.build_metrics_record(
+        {"T60": 1.23}, CKPT, rotate_deg=0.0, cond_method="vanilla",
+        frame_avg_angles=None,
+    )
+    # original keys preserved (the pre-flag JSONs had exactly these three)
+    assert rec["metrics"] == {"T60": 1.23}
+    assert rec["ckpt_path"] == CKPT
+    assert rec["rotate_deg"] == 0.0
+    # new keys
+    assert rec["cond_method"] == "vanilla"
+    assert rec["frame_avg_angles"] is None
+    assert rec["cond_autocast"] == "default"  # omitted kwarg -> the original protocol
+    json.loads(json.dumps(rec))  # must be JSON-dumpable like the real call
+
+
+def test_metrics_json_records_method_fa_invariant():
+    rec = eval_FLAC.build_metrics_record(
+        {"C50": 4.5}, CKPT, rotate_deg=90.0, cond_method="fa_invariant",
+        frame_avg_angles=[0.0, 90.0, 180.0, 270.0], cond_autocast="bf16",
+    )
+    assert rec["cond_method"] == "fa_invariant"
+    assert rec["frame_avg_angles"] == [0.0, 90.0, 180.0, 270.0]
+    assert rec["rotate_deg"] == 90.0
+    assert rec["cond_autocast"] == "bf16"
+    json.loads(json.dumps(rec))
+
+
+# --------------------------------------------------------------------------- #
+# cond-autocast control + predictions sidecar meta
+# --------------------------------------------------------------------------- #
+@pytest.mark.parametrize(
+    "mode,expected",
+    [
+        ("default", (True, None)),          # torch per-device default = original protocol
+        ("bf16", (True, torch.bfloat16)),   # matches bf16-mixed training precision
+        ("off", (False, None)),             # fp32, for exactness measurements
+    ],
+)
+def test_resolve_cond_autocast_modes(mode, expected):
+    assert eval_FLAC.resolve_cond_autocast(mode) == expected
+
+
+def test_resolve_cond_autocast_unknown_raises():
+    with pytest.raises(ValueError, match="cond_autocast"):
+        eval_FLAC.resolve_cond_autocast("fp8")
+
+
+def test_predictions_meta_includes_cond_autocast():
+    meta = eval_FLAC.build_predictions_meta(
+        "ds.json", seed=42, n_samples=7, cond_method="fa_invariant",
+        frame_avg_angles=[0.0, 90.0], rotate_deg=0.0, batch_size=32,
+        cond_autocast="bf16",
+    )
+    assert meta["cond_autocast"] == "bf16"
+    assert meta["n_samples"] == 7
+    for key in ("dataset_config", "seed", "cond_method", "frame_avg_angles",
+                "rotate_deg", "batch_size"):
+        assert key in meta
+
+
+# --------------------------------------------------------------------------- #
+# checkpoint-load integrity
+# --------------------------------------------------------------------------- #
+def test_load_integrity_real_state_dict():
+    """Through a real ``load_state_dict`` (tiny model built by the real factories):
+    a clean load passes; the whitelisted training-wrapper leftovers
+    (``diffusion_ema.`` / ``losses.``, the pattern a wrapper checkpoint leaves
+    behind after the ``diffusion.`` strip) pass; a dropped model key raises
+    RuntimeError naming the key."""
+    from test_cond_dispatch import _base_config
+    from src.models.factory import create_model_from_config
+    model = create_model_from_config(_base_config())
+
+    missing, unexpected = model.load_state_dict(model.state_dict(), strict=False)
+    eval_FLAC.check_load_integrity(missing, unexpected)  # clean: must not raise
+
+    sd = dict(model.state_dict())
+    sd["diffusion_ema.initted"] = torch.tensor(True)
+    sd["diffusion_ema.step"] = torch.tensor(0)
+    sd["losses.some_loss_buffer"] = torch.zeros(1)
+    missing, unexpected = model.load_state_dict(sd, strict=False)
+    assert len(unexpected) == 3
+    eval_FLAC.check_load_integrity(missing, unexpected)  # whitelisted: no raise
+
+    sd = dict(model.state_dict())
+    dropped = sorted(sd)[0]
+    del sd[dropped]
+    missing, unexpected = model.load_state_dict(sd, strict=False)
+    with pytest.raises(RuntimeError) as exc:
+        eval_FLAC.check_load_integrity(missing, unexpected)
+    assert dropped in str(exc.value)
+
+
+def test_load_integrity_stray_and_missing_are_fatal():
+    """A non-whitelisted unexpected key hard-errors naming it; so does a missing
+    key. There is no escape hatch: a mismatched load always raises."""
+    with pytest.raises(RuntimeError) as exc:
+        eval_FLAC.check_load_integrity([], ["totally.stray_key"])
+    assert "totally.stray_key" in str(exc.value)
+
+    with pytest.raises(RuntimeError) as exc:
+        eval_FLAC.check_load_integrity(["model.gone"], [])
+    assert "model.gone" in str(exc.value)
+
+
+# --------------------------------------------------------------------------- #
+# evaluate_model: fail-fast option validation
+# --------------------------------------------------------------------------- #
+def _fail_if_model_built(*args, **kwargs):
+    pytest.fail("evaluate_model reached model construction")
+
+
+def test_evaluate_model_unknown_cond_method_raises_fast(tmp_path, monkeypatch):
+    """An unknown programmatic cond_method raises ValueError BEFORE any file,
+    model or dataloader work: every path argument points at a nonexistent file
+    (late validation would surface FileNotFoundError instead), and reaching
+    model construction trips a loud sentinel rather than the expected error."""
+    monkeypatch.setattr(eval_FLAC, "create_model_from_config", _fail_if_model_built)
+    with pytest.raises(ValueError, match="cond_method"):
+        eval_FLAC.evaluate_model(
+            str(tmp_path / "missing_model.json"),
+            str(tmp_path / "missing_dataset.json"),
+            str(tmp_path / "missing.ckpt"),
+            steps=1, cfg_scale=1.0, device="cpu", cond_method="canon",
+        )
+
+
+@pytest.mark.parametrize("bad_angles", [[], [90.0, 180.0]])
+def test_evaluate_model_bad_frame_avg_angles_raise_fast(tmp_path, monkeypatch, bad_angles):
+    """Because the option check goes through the SHARED
+    ``resolve_conditioning_options`` (the same validator the training wrapper
+    calls), an fa_invariant orbit that is empty or does not start at 0 deg is
+    rejected up front too -- before any file/model work -- instead of surfacing
+    from ``invariant_conditioning`` after the first batch has been loaded."""
+    monkeypatch.setattr(eval_FLAC, "create_model_from_config", _fail_if_model_built)
+    with pytest.raises(ValueError):
+        eval_FLAC.evaluate_model(
+            str(tmp_path / "missing_model.json"),
+            str(tmp_path / "missing_dataset.json"),
+            str(tmp_path / "missing.ckpt"),
+            steps=1, cfg_scale=1.0, device="cpu",
+            cond_method="fa_invariant", frame_avg_angles=bad_angles,
+        )
+
+
+def test_evaluate_model_unknown_cond_autocast_raises_fast(tmp_path, monkeypatch):
+    """Programmatic callers fail fast, before any file/model work (paths are
+    nonexistent: late validation would surface FileNotFoundError instead)."""
+    monkeypatch.setattr(eval_FLAC, "create_model_from_config", _fail_if_model_built)
+    with pytest.raises(ValueError, match="cond_autocast"):
+        eval_FLAC.evaluate_model(
+            str(tmp_path / "m.json"), str(tmp_path / "d.json"), str(tmp_path / "c.ckpt"),
+            steps=1, cfg_scale=1.0, device="cpu", cond_autocast="fp8",
+        )
+
+
+# --------------------------------------------------------------------------- #
+# CLI surface
+# --------------------------------------------------------------------------- #
+def _run_cli(*args):
+    return subprocess.run(
+        [sys.executable, "eval_FLAC.py", *args], capture_output=True, cwd=REPO_ROOT
+    )
+
+
+def test_parser_conditioning_flags():
+    """argparse polices the conditioning flag surface: --cond-autocast and
+    --cond-method reject values outside their choices (exit 2, 'invalid
+    choice'), while the valid combination -- every conditioning flag together --
+    gets past choices and past a zero-argument store_true parse to the
+    required-args error (exit 2, but none of the parse-shape complaints)."""
+    bad_autocast = _run_cli("--cond-autocast", "fp8")
+    assert bad_autocast.returncode == 2
+    assert b"invalid choice" in bad_autocast.stderr
+
+    bad_method = _run_cli("--cond-method", "canon")
+    assert bad_method.returncode == 2
+    assert b"invalid choice" in bad_method.stderr
+
+    good = _run_cli("--cond-method", "fa_invariant", "--frame-avg-angles", "0,180",
+                    "--cond-autocast", "bf16")
+    assert good.returncode == 2                           # missing required args...
+    assert b"invalid choice" not in good.stderr           # ...not a rejected choice,
+    assert b"unrecognized arguments" not in good.stderr    # ...not an unknown flag,
+    assert b"expected one argument" not in good.stderr     # ...not store_true wanting a value
+
+
+# --------------------------------------------------------------------------- #
+# evaluate_model: one-batch flow -- rotation THEN dispatch, and the save stage
+# --------------------------------------------------------------------------- #
+IMG_W = 512
+
+
+class _RecordingConditioner:
+    """Minimal stand-in for ``MultiConditioner``: records every call and returns
+    a conditioning dict carrying one ViT id, so ``fa_invariant`` actually runs
+    its C4 frame-average loop (base pass + one pass per non-identity angle)."""
+
+    def __init__(self):
+        self.calls = []
+
+    def __call__(self, metadata, device, **kwargs):
+        self.calls.append((metadata, device, kwargs))
+        return {
+            "source": [torch.zeros(len(metadata), 1, 4), None],
+            "source_vit": [torch.zeros(len(metadata), 2, 4), None],
+        }
+
+
+class _FakeEvalModule:
+    """Stand-in for the PL wrapper ``evaluate_model`` drives, faking exactly what
+    the function touches: chainable ``eval()/requires_grad_()/to()``, a
+    ``.device``, and a ``.diffusion`` exposing ``conditioner``,
+    ``get_conditioning_inputs``, ``model`` (a bare object, so the objective
+    lookup falls through to 'rectified_flow'), ``pretransform=None`` (no VAE
+    decode; latent length == sample_size), ``io_channels`` and ``dist_shift``."""
+
+    def __init__(self):
+        self.conditioner = _RecordingConditioner()
+        self.diffusion = types.SimpleNamespace(
+            conditioner=self.conditioner,
+            get_conditioning_inputs=lambda conditioning: {},
+            model=object(),
+            pretransform=None,
+            io_channels=1,
+            dist_shift=None,
+        )
+        self.device = "cpu"
+
+    def eval(self):
+        return self
+
+    def requires_grad_(self, flag):
+        return self
+
+    def to(self, device):
+        return self
+
+
+class _OrderSpy:
+    """Pass-through recorder sharing one event log with its siblings, so the
+    ORDER of the calls it wraps is observable, not just their arguments."""
+
+    def __init__(self, name, events, delegate):
+        self.name = name
+        self.events = events
+        self._delegate = delegate
+        self.calls = []
+
+    def __call__(self, *args, **kwargs):
+        self.events.append(self.name)
+        self.calls.append((args, kwargs))
+        return self._delegate(*args, **kwargs)
+
+
+def _make_md(seed):
+    g = torch.Generator().manual_seed(seed)
+    return {
+        "scene": f"scene{seed}",
+        "depth": torch.randn(3, 4, IMG_W, generator=g),
+        "source": torch.randn(3, generator=g),
+        "source_vit": torch.randn(3, generator=g),
+        "context_poses": torch.randn(2, 3, generator=g),
+        "context_poses_vit": torch.randn(2, 3, generator=g),
+    }
+
+
+@pytest.mark.parametrize(
+    "cond_method,rotate_deg,metrics_name,angles_record,n_cond_calls",
+    [
+        # fa_invariant + a 90 deg pre-rotation: both suffixes on the filename,
+        # 4 conditioner passes (base + 3 frame angles).
+        ("fa_invariant", 90.0,
+         "toy_metrics_1_1.0_onebatch_fa_invariant_a4_rot90.json",
+         [0.0, 90.0, 180.0, 270.0], 4),
+        # vanilla + no rotation: the pre-flag filename, a single conditioner pass.
+        ("vanilla", 0.0, "toy_metrics_1_1.0_onebatch.json", None, 1),
+    ],
+)
+def test_one_batch_flow_rotation_then_dispatch(
+    tmp_path, monkeypatch, cond_method, rotate_deg, metrics_name, angles_record, n_cond_calls
+):
+    """End-to-end through ONE batch on CPU: the eval loop must apply the
+    ``--rotate-deg`` rotation FIRST and hand the ROTATED metadata to the single
+    shared ``dispatch_conditioning`` call, with the configured method and the
+    resolved angle tuple -- then save through ``build_output_paths`` /
+    ``build_metrics_record``.
+
+    This is the ordering the rotation-robustness protocol depends on: dispatch
+    before rotation (or dispatching the pre-rotation metadata) would still
+    produce plausible numbers, so it is pinned by a shared event log plus a
+    tensor-level comparison of what the dispatcher received.
+
+    Everything below the wiring is faked at ``eval_FLAC``'s namespace: the two
+    factories, the dataloader (one batch), the metric callback, and the module
+    -global sampler ``src.inference.sampling.sample_discrete_euler`` (imported
+    inside the loop, hence patched on its own module).
+
+    The toy model config declares the SAME ``cond_method`` this run requests: the
+    trained-as protocol guard refuses an explicit method that contradicts the
+    checkpoint's (here: bare checkpoint -> the model config is the authority), and
+    this test is about rotation/dispatch ordering, not about the guard. The guard
+    itself is covered in ``test_protocol_guard.py``.
+    """
+    model_cfg = tmp_path / "model.json"
+    model_cfg.write_text(json.dumps({
+        "model_type": "diffusion_cond", "sample_size": 64, "sample_rate": 22050,
+        "audio_channels": 1, "training": {"use_ema": False, "cond_method": cond_method},
+    }))
+    dataset_cfg = tmp_path / "dataset.json"
+    dataset_cfg.write_text(json.dumps({"datasets": [{"id": "toy"}]}))
+    ckpt = tmp_path / "toy.ckpt"
+    torch.save({"state_dict": {}}, str(ckpt))
+
+    reals = torch.randn(2, 1, 64)
+    metadata = [_make_md(0), _make_md(1)]
+    original_depths = [md["depth"].clone() for md in metadata]
+
+    module = _FakeEvalModule()
+    monkeypatch.setattr(
+        eval_FLAC, "create_model_from_config",
+        lambda cfg: types.SimpleNamespace(load_state_dict=lambda sd, strict=False: ([], [])),
+    )
+    monkeypatch.setattr(
+        eval_FLAC, "create_training_wrapper_from_config", lambda cfg, model: module
+    )
+    monkeypatch.setattr(
+        eval_FLAC, "create_dataloader_from_config", lambda *a, **k: [(reals, metadata)]
+    )
+    monkeypatch.setattr(
+        eval_FLAC, "create_metric_callback_from_config",
+        lambda *a, **k: types.SimpleNamespace(
+            update_metrics=lambda *a, **k: None,
+            compute_metrics=lambda split: {},
+        ),
+    )
+    monkeypatch.setattr(
+        sampling, "sample_discrete_euler", lambda model, x, *a, **k: torch.zeros_like(x)
+    )
+
+    events = []
+    rotate_spy = _OrderSpy("rotate", events, real_rotate_scene_metadata)
+    dispatch_spy = _OrderSpy("dispatch", events, real_dispatch_conditioning)
+    monkeypatch.setattr(eval_FLAC, "rotate_scene_metadata", rotate_spy)
+    monkeypatch.setattr(eval_FLAC, "dispatch_conditioning", dispatch_spy)
+
+    eval_FLAC.evaluate_model(
+        str(model_cfg), str(dataset_cfg), str(ckpt),
+        steps=1, cfg_scale=1.0, device="cpu", eval_name="onebatch",
+        cond_method=cond_method, rotate_deg=rotate_deg, cond_autocast="off",
+    )
+
+    # (a) ordering: every rotation happens before the single dispatch call.
+    assert len(dispatch_spy.calls) == 1, "the eval loop must dispatch exactly once per batch"
+    if rotate_deg == 0.0:
+        assert rotate_spy.calls == [], "no rotation must run at --rotate-deg 0"
+        assert events == ["dispatch"]
+    else:
+        assert events == ["rotate"] * len(metadata) + ["dispatch"], (
+            "the conditioning must be rotated BEFORE it reaches the dispatcher"
+        )
+
+    # (b) the dispatcher received the ROTATED metadata, not the originals.
+    seen_conditioner, seen_md, seen_device = dispatch_spy.calls[0][0][:3]
+    assert seen_conditioner is module.diffusion.conditioner
+    assert seen_device == module.device
+    if rotate_deg == 0.0:
+        assert seen_md is metadata
+    else:
+        expected = [
+            real_rotate_scene_metadata(md, math.radians(rotate_deg), IMG_W) for md in metadata
+        ]
+        for got, exp, orig in zip(seen_md, expected, original_depths):
+            assert torch.equal(got["depth"], exp["depth"]), "not the rotated depth"
+            assert not torch.equal(got["depth"], orig), "the ORIGINAL depth reached the dispatcher"
+            assert torch.equal(got["source"], exp["source"])
+
+    # (c) method + resolved angle tuple reached the dispatcher.
+    seen_method, seen_angles = dispatch_spy.calls[0][0][3:5]
+    assert seen_method == cond_method
+    assert isinstance(seen_angles, tuple) and seen_angles == tuple(DEFAULT_FRAME_ANGLES)
+    assert len(module.conditioner.calls) == n_cond_calls
+
+    # (d) the metrics JSON landed at the build_output_paths name, with the record.
+    metrics_path = tmp_path / metrics_name
+    assert metrics_path.exists(), f"metrics not written to {metrics_path}"
+    saved = json.loads(metrics_path.read_text())
+    assert saved["cond_method"] == cond_method
+    assert saved["frame_avg_angles"] == angles_record
+    assert saved["rotate_deg"] == rotate_deg
+    assert saved["cond_autocast"] == "off"
+    assert saved["ckpt_path"] == str(ckpt)
diff --git a/src/tests/test_protocol_guard.py b/src/tests/test_protocol_guard.py
new file mode 100644
index 0000000..a13d639
--- /dev/null
+++ b/src/tests/test_protocol_guard.py
@@ -0,0 +1,554 @@
+"""Tests for the trained-as conditioning protocol guard in both eval entry points.
+
+A checkpoint trained under ``fa_invariant`` conditioning and evaluated with
+``vanilla`` (or the reverse) produces plausible-looking metrics that are
+catastrophically wrong in BOTH directions -- nothing in the numbers announces the
+error. The training method is recoverable, so evaluation must not depend on a CLI
+default: ``train.py``'s embedder callback stores the whole ``model_config`` in
+every training checkpoint, and ``training.cond_method`` / ``training.frame_avg_angles``
+there say what the weights actually trained under (an absent ``cond_method`` key
+means ``'vanilla'`` -- the factory default -- not "unknown"). Exported/bare
+checkpoints carry no embedded config, so the ``--model-config`` JSON's training
+block is the fallback authority.
+
+Four layers are pinned separately:
+
+1. **Recovery** -- :func:`eval_FLAC.trained_conditioning` over the embedded /
+   bare / no-key / no-training-block table.
+2. **Inheritance** -- ``evaluate_model`` with no explicit method dispatches the
+   TRAINED one (and the trained orbit), for both authorities.
+3. **Refusal** -- an explicit contradicting method or orbit raises before the
+   model is built, naming both protocols, the source it read the trained one
+   from, and the override flag; ``--allow-conditioning-override`` permits the
+   run and the output records disclose it.
+4. **eval_pl** -- the same guard with no override flag, plus the protocol fields
+   in the metrics JSON it writes.
+
+The one-batch harness (fake factories / dataloader / metric callback / sampler)
+is shared with ``test_eval_paths.py`` rather than duplicated, so the two files
+cannot drift on what ``evaluate_model``'s surroundings look like.
+"""
+import json
+import types
+from pathlib import Path
+
+import pytest
+import torch
+
+import eval_FLAC
+import eval_pl
+import src.inference.sampling as sampling  # noqa: E402  (sampler patched per run)
+from src.data.yaw_rotation import (
+    DEFAULT_FRAME_ANGLES,
+    dispatch_conditioning as real_dispatch_conditioning,
+    resolve_conditioning_options,
+)
+from test_eval_paths import _FakeEvalModule, _OrderSpy, _fail_if_model_built, _make_md
+
+
+# --------------------------------------------------------------------------- #
+# fixtures: toy configs + checkpoints
+# --------------------------------------------------------------------------- #
+def _embedded(training):
+    """A *training* checkpoint: what ``ModelConfigEmbedderCallback`` leaves behind."""
+    return {"model_config": {"model_type": "diffusion_cond", "training": training}}
+
+
+def _write_case(tmp_path, config_training=None, ckpt_extra=None):
+    """Write the toy model config, dataset config and checkpoint; return their paths.
+
+    ``config_training`` extends the ``--model-config`` training block (the
+    fallback authority); ``ckpt_extra`` extends the checkpoint dict (pass
+    :func:`_embedded` to make it a training checkpoint rather than a bare one).
+    """
+    training = {"use_ema": False}
+    training.update(config_training or {})
+    model_cfg = tmp_path / "model.json"
+    model_cfg.write_text(json.dumps({
+        "model_type": "diffusion_cond", "sample_size": 64, "sample_rate": 22050,
+        "audio_channels": 1, "training": training,
+    }))
+    dataset_cfg = tmp_path / "dataset.json"
+    dataset_cfg.write_text(json.dumps({"datasets": [{"id": "toy"}]}))
+    ckpt = tmp_path / "toy.ckpt"
+    payload = {"state_dict": {}}
+    payload.update(ckpt_extra or {})
+    torch.save(payload, str(ckpt))
+    return str(model_cfg), str(dataset_cfg), str(ckpt)
+
+
+def _run_eval(tmp_path, monkeypatch, config_training=None, ckpt_extra=None,
+              model_factory=None, **kwargs):
+    """Drive ``evaluate_model`` through ONE fake batch on CPU.
+
+    Returns ``(dispatch_spy, module)``: the spy records what reached the shared
+    ``dispatch_conditioning`` (method + angle tuple), and the module's recording
+    conditioner counts the passes, so "which protocol actually ran" is observed
+    at the dispatcher, not inferred from the record it writes.
+
+    ``model_factory`` overrides the stub for ``create_model_from_config`` -- pass
+    ``_fail_if_model_built`` to assert the guard fires before construction.
+    """
+    model_cfg, dataset_cfg, ckpt = _write_case(tmp_path, config_training, ckpt_extra)
+    module = _FakeEvalModule()
+
+    monkeypatch.setattr(
+        eval_FLAC, "create_model_from_config",
+        model_factory or (lambda cfg: types.SimpleNamespace(
+            load_state_dict=lambda sd, strict=False: ([], []))),
+    )
+    monkeypatch.setattr(
+        eval_FLAC, "create_training_wrapper_from_config", lambda cfg, model: module
+    )
+    monkeypatch.setattr(
+        eval_FLAC, "create_dataloader_from_config",
+        lambda *a, **k: [(torch.randn(2, 1, 64), [_make_md(0), _make_md(1)])],
+    )
+    monkeypatch.setattr(
+        eval_FLAC, "create_metric_callback_from_config",
+        lambda *a, **k: types.SimpleNamespace(
+            update_metrics=lambda *a, **k: None, compute_metrics=lambda split: {},
+        ),
+    )
+    monkeypatch.setattr(
+        sampling, "sample_discrete_euler", lambda model, x, *a, **k: torch.zeros_like(x)
+    )
+    dispatch_spy = _OrderSpy("dispatch", [], real_dispatch_conditioning)
+    monkeypatch.setattr(eval_FLAC, "dispatch_conditioning", dispatch_spy)
+
+    eval_FLAC.evaluate_model(
+        model_cfg, dataset_cfg, ckpt, steps=1, cfg_scale=1.0, device="cpu",
+        eval_name="guard", cond_autocast="off", **kwargs
+    )
+    return dispatch_spy, module
+
+
+def _dispatched(dispatch_spy):
+    """``(cond_method, angles)`` as seen by the shared dispatcher."""
+    assert len(dispatch_spy.calls) == 1, "the eval loop must dispatch exactly once per batch"
+    return dispatch_spy.calls[0][0][3:5]
+
+
+def _metrics_path(tmp_path):
+    paths = sorted(Path(tmp_path).glob("*_metrics_*.json"))
+    assert len(paths) == 1, f"expected exactly one metrics JSON, got {paths}"
+    return paths[0]
+
+
+def _saved_metrics(tmp_path):
+    return json.loads(_metrics_path(tmp_path).read_text())
+
+
+# --------------------------------------------------------------------------- #
+# 1. inheritance -- embedded checkpoint config is the authority
+# --------------------------------------------------------------------------- #
+def test_inherits_trained_method_and_orbit_from_embedded_config(tmp_path, monkeypatch):
+    """No ``--cond-method``: the checkpoint's embedded training block decides.
+
+    The ``--model-config`` JSON here declares NO method (i.e. vanilla), so an
+    inherited ``fa_invariant`` can only have come from the checkpoint -- and the
+    non-default orbit ``[0, 180]`` (ints, as a JSON config carries them) must
+    arrive at the dispatcher coerced to floats.
+    """
+    dispatch_spy, module = _run_eval(
+        tmp_path, monkeypatch,
+        ckpt_extra=_embedded({"cond_method": "fa_invariant", "frame_avg_angles": [0, 180]}),
+    )
+    method, angles = _dispatched(dispatch_spy)
+    assert method == "fa_invariant"
+    assert angles == (0.0, 180.0)
+    assert all(isinstance(a, float) for a in angles)
+    assert len(module.conditioner.calls) == 2, "base pass + one frame angle"
+
+    record = _saved_metrics(tmp_path)
+    assert record["cond_method"] == "fa_invariant"
+    assert record["frame_avg_angles"] == [0.0, 180.0]
+    assert record["trained_cond_method"] == "fa_invariant"
+    assert record["trained_frame_avg_angles"] == [0.0, 180.0]
+    assert record["cond_method_source"] == "checkpoint"
+    assert record["conditioning_override"] is False
+    # the inherited protocol reaches the filename too (two-angle orbit -> a2)
+    assert "_fa_invariant_a2" in _metrics_path(tmp_path).name
+
+
+def test_inherits_from_model_config_for_bare_checkpoint(tmp_path, monkeypatch):
+    """An exported/bare checkpoint (``state_dict`` only) carries no embedded
+    config, so the ``--model-config`` training block is the fallback authority --
+    and the record says which authority answered."""
+    dispatch_spy, module = _run_eval(
+        tmp_path, monkeypatch, config_training={"cond_method": "fa_invariant"}
+    )
+    method, angles = _dispatched(dispatch_spy)
+    assert method == "fa_invariant"
+    assert angles == tuple(DEFAULT_FRAME_ANGLES), "no declared orbit -> the resolver default"
+    assert len(module.conditioner.calls) == 4, "base pass + three frame angles"
+
+    record = _saved_metrics(tmp_path)
+    assert record["cond_method_source"] == "model_config"
+    assert record["trained_cond_method"] == "fa_invariant"
+    assert record["trained_frame_avg_angles"] == list(DEFAULT_FRAME_ANGLES)
+
+
+def test_embedded_config_without_cond_method_means_vanilla(tmp_path, monkeypatch):
+    """An embedded training block with no ``cond_method`` key means vanilla.
+
+    It is the factory default (``training_config.get("cond_method", "vanilla")``),
+    so an absent key is a positive statement about the weights -- never ``None``
+    and never a reason to fall through to the ``--model-config``. Proven twice:
+    on the helper, and end-to-end where the embedded (silent = vanilla) block
+    beats an ``fa_invariant`` model config, leaving a single conditioner pass.
+    """
+    method, angles, source = eval_FLAC.trained_conditioning(
+        {"state_dict": {}, "model_config": {"training": {"use_ema": False}}},
+        {"training": {"cond_method": "fa_invariant"}},
+    )
+    assert (method, angles, source) == ("vanilla", None, "checkpoint")
+
+    dispatch_spy, module = _run_eval(
+        tmp_path, monkeypatch,
+        config_training={"cond_method": "fa_invariant"},
+        ckpt_extra=_embedded({"use_ema": False}),
+    )
+    assert _dispatched(dispatch_spy)[0] == "vanilla"
+    assert len(module.conditioner.calls) == 1, "vanilla must run exactly one pass"
+    assert _saved_metrics(tmp_path)["frame_avg_angles"] is None
