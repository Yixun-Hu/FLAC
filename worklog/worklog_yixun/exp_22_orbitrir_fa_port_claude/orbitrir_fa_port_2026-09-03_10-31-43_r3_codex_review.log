+def trained_conditioning(checkpoint, model_config):
+    """Recover the conditioning protocol a checkpoint's weights were trained under.
+
+    Two authorities, in order:
+
+    1. ``train.py``'s checkpoint-embedder callback writes the whole
+       ``model_config`` into every training checkpoint, so
+       ``checkpoint['model_config']['training']`` is the config that actually
+       built the training wrapper -- the authoritative record. A ``training``
+       block with **no** ``cond_method`` key means ``'vanilla'``: that is the
+       factory default (``src/training/factory.py`` passes
+       ``training_config.get("cond_method", "vanilla")``), so an absent key is a
+       positive statement about the weights, not missing information.
+    2. Exported / bare checkpoints (a ``state_dict`` and nothing else) carry no
+       embedded config. There the ``--model-config`` JSON's ``training`` block is
+       the only authority available, and is used as the fallback -- with the same
+       absent-key-means-vanilla rule.
+
+    Parameters
+    ----------
+    checkpoint : dict
+        The raw ``torch.load`` result (not the extracted ``state_dict``).
+    model_config : dict
+        The parsed ``--model-config`` JSON, used only for the fallback.
+
+    Returns
+    -------
+    Tuple[str, Optional[Sequence[float]], str]
+        ``(cond_method, frame_avg_angles, source)`` where ``source`` is
+        ``'checkpoint'`` or ``'model_config'`` and ``frame_avg_angles`` is left
+        exactly as declared (``None`` when the config declares no orbit).
+    """
+    embedded = checkpoint.get("model_config") if isinstance(checkpoint, dict) else None
+    training = embedded.get("training") if isinstance(embedded, dict) else None
+
+    if isinstance(training, dict):
+        source = "checkpoint"
+    else:
+        source = "model_config"
+        training = model_config.get("training") if isinstance(model_config, dict) else None
+        if not isinstance(training, dict):
+            training = {}
+
+    return training.get("cond_method", "vanilla"), training.get("frame_avg_angles", None), source
