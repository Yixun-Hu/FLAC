    26	def wrap_angle(phi):
    27	    """
    28	    Wrap an angle into the half-open interval ``(-pi, pi]``.
    29	
    30	    The interval is closed at ``+pi`` and open at ``-pi``, so an input of exactly
    31	    ``-pi`` maps to ``+pi`` (and ``+pi`` stays ``+pi``). Works elementwise on
    32	    Python floats and on ``torch.Tensor`` inputs alike.
    33	
    34	    Parameters
    35	    ----------
    36	    phi : float or torch.Tensor
    37	        Angle(s) in radians.
    38	
    39	    Returns
    40	    -------
    41	    float or torch.Tensor
    42	        The wrapped angle(s) in ``(-pi, pi]``, same type as the input.
    43	    """
    44	    return math.pi - (math.pi - phi) % (2.0 * math.pi)
