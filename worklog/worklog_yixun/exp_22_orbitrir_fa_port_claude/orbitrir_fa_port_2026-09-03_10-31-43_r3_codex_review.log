   140	def azimuth_rotation_matrix(alpha_rad: float) -> torch.Tensor:
   141	    """
   142	    Build a 3x3 rotation matrix about the vertical (z) axis.
   143	
   144	    Parameters
   145	    ----------
   146	    alpha_rad : float
   147	        Rotation angle in radians. Positive values rotate the (x, y) plane
   148	        counter-clockwise, which corresponds to increasing azimuth.
   149	
   150	    Returns
   151	    -------
   152	    torch.Tensor
   153	        A ``[3, 3]`` float32 rotation matrix leaving the z component unchanged.
   154	    """
   155	    c = math.cos(alpha_rad)
   156	    s = math.sin(alpha_rad)
   157	    return torch.tensor([[c, -s, 0.0], [s, c, 0.0], [0.0, 0.0, 1.0]], dtype=torch.float32)
