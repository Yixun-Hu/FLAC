+def test_trained_conditioning_defaults_to_vanilla_without_any_training_block():
+    """Neither authority declares anything -> vanilla, no orbit. Never ``None``
+    as a method: a missing declaration is still a claim about the weights."""
+    assert eval_FLAC.trained_conditioning({"state_dict": {}}, {}) == (
+        "vanilla", None, "model_config"
+    )
