    80	def _run_eval(tmp_path, monkeypatch, config_training=None, ckpt_extra=None,
    81	              model_factory=None, **kwargs):
    82	    """Drive ``evaluate_model`` through ONE fake batch on CPU.
    83	
    84	    Returns ``(dispatch_spy, module)``: the spy records what reached the shared
    85	    ``dispatch_conditioning`` (method + angle tuple), and the module's recording
    86	    conditioner counts the passes, so "which protocol actually ran" is observed
    87	    at the dispatcher, not inferred from the record it writes.
