   101	        phi_s = torch.atan2(sy, sx)
   102	        cand_r.append(r_s.reshape(1))
   103	        cand_phi.append(phi_s.reshape(1))
   104	
   105	    r_c = phi_c = cz = None
   106	    if context is not None:
   107	        assert isinstance(context, torch.Tensor)
   108	        cx, cy, cz = context[..., 0], context[..., 1], context[..., 2]
   109	        r_c = torch.sqrt(cx * cx + cy * cy)
   110	        phi_c = torch.atan2(cy, cx)
