   360	@_needs_dino
   361	def test_checkpoint_executes_once_per_layer_train_grad(
   362	    cond_on, conditioning, vit_id, counting_checkpoint
   363	):
   364	    """A train-mode, grad-enabled conditioner forward invokes the REAL
   365	    ``torch.utils.checkpoint.checkpoint`` exactly once per encoder layer, every
   366	    call pinned to ``use_reentrant=False`` (required for DDP
   367	    find_unused_parameters); backward then succeeds through the checkpointed graph
   368	    (every layer's params receive grads) WITHOUT re-entering ``checkpoint`` — the
   369	    non-reentrant recompute happens inside the saved-tensor hooks."""
   370	    vit = _shared_vit(cond_on)
   371	    n_layers = len(vit.layer)
   372	    assert n_layers == vit.config.num_hidden_layers
   373	    assert n_layers == EXPECTED_NUM_LAYERS, (
   374	        f"pinned backbone should have {EXPECTED_NUM_LAYERS} encoder layers, got {n_layers}"
   375	    )
