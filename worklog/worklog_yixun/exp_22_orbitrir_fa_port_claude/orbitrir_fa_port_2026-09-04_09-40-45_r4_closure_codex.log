   222	
   223	class _CountingCheckpoint:
   224	    """Counting shim for ``torch.utils.checkpoint.checkpoint``: records each call's
   225	    ``use_reentrant`` and delegates to the REAL checkpoint so autograd semantics
   226	    are exercised, not stubbed."""
   227	
   228	    def __init__(self, real):
   229	        self.real = real
   230	        self.use_reentrant_seen = []
   231	
   232	    def __call__(self, fn, *args, **kwargs):
   233	        self.use_reentrant_seen.append(kwargs.get("use_reentrant", "ABSENT"))
   234	        return self.real(fn, *args, **kwargs)
   235	
   236	    @property
   237	    def count(self):
   238	        return len(self.use_reentrant_seen)
   239	
