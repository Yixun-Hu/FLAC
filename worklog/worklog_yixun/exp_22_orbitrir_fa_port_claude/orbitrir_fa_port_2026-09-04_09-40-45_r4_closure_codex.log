   379	        assert counting_checkpoint.count == n_layers, (
   380	            f"expected {n_layers} checkpoint invocations during forward, "
   381	            f"saw {counting_checkpoint.count}"
   382	        )
   383	        assert all(u is False for u in counting_checkpoint.use_reentrant_seen), (
   384	            counting_checkpoint.use_reentrant_seen
   385	        )
   386	        out.float().pow(2).mean().backward()
   387	        # backward must not re-enter checkpoint()
   388	        assert counting_checkpoint.count == n_layers
   389	        # gradients flowed through every checkpointed layer
   390	        for i, layer in enumerate(vit.layer):
   391	            assert any(p.grad is not None for p in layer.parameters()), (
   392	                f"layer {i} received no gradients through checkpointing"
   393	            )
   394	        print(
   395	            f"\nmeasured checkpoint invocations: {counting_checkpoint.count} "
   396	            f"(= num layers {n_layers}), use_reentrant pinned False on all calls"
   397	        )
   398	    finally:
   399	        cond_on.zero_grad(set_to_none=True)
