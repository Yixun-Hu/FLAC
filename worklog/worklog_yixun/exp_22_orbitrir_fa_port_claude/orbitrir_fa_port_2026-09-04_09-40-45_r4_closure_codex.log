   213	def _state_hash(module: nn.Module) -> str:
   214	    """sha256 over the full state_dict (keys + raw bytes)."""
   215	    h = hashlib.sha256()
   216	    sd = module.state_dict()
   217	    for k in sorted(sd):
   218	        h.update(k.encode())
   219	        h.update(sd[k].detach().cpu().contiguous().numpy().tobytes())
   220	    return h.hexdigest()
