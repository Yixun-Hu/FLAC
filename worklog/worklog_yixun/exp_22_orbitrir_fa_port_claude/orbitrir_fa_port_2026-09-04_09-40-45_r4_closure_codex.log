   247	
   248	def _batch(conditioning: dict, vit_id: str, batch_size: int = 2, seed: int = SEED):
   249	    """Minimal REAL per-sample metadata dicts, exactly as ``MultiConditioner``
   250	    consumes them: a 3-vector pose under the ViT conditioner's id plus the shared
   251	    ``depth`` panorama at the (C, img_h, img_w) the config demands. Depth values
   252	    are non-negative (metres), poses are small offsets — the conditioner forms
   253	    ``(pose - depth) / max_value`` and feeds that to the backbone."""
   254	    channels, img_h, img_w = _depth_shape(conditioning)
   255	    g = torch.Generator().manual_seed(seed)
   256	    return [
   257	        {
   258	            vit_id: torch.randn(3, generator=g),
   259	            "depth": torch.rand(channels, img_h, img_w, generator=g) * 5.0,
   260	        }
   261	        for _ in range(batch_size)
   262	    ]
   263	
   264	
   265	def _run_vit_conditioner(mc, conditioning: dict, vit_id: str, seed: int):
   266	    """One real backbone forward through the production path: ``MultiConditioner``
   267	    restricted to a single ViTCoordinates id (the same ``only_ids`` route the
   268	    rotation-frame conditioning uses), so the observed checkpoint-call count is
   269	    one encoder pass, not two. Seeded because the backbone's rotary position
   270	    embedding is randomly rescaled in training mode."""
   271	    batch = _batch(conditioning, vit_id)
   272	    torch.manual_seed(seed)
   273	    out = mc(batch, device="cpu", only_ids=[vit_id])
   274	    return out[vit_id][0]
