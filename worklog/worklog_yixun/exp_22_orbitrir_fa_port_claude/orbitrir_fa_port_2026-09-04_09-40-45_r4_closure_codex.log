   445	@_needs_dino
   446	def test_gradient_identity_on_vs_off(cond_off, cond_on, conditioning, vit_id):
   447	    """Identical weights, identical seed, identical input, float32 CPU: parameter
   448	    grads with checkpointing ON are ``torch.allclose`` (atol=1e-6, rtol=1e-5) to
   449	    the plain path. The non-reentrant recompute is deterministic here (no dropout,
   450	    no stochastic depth, and the randomly rescaled position embedding is computed
   451	    once outside the checkpointed region), so the flag changes memory, never
   452	    numerics."""
   453	    # The comparison is only meaningful if the two stacks carry the same weights.
   454	    sd_off, sd_on = cond_off.state_dict(), cond_on.state_dict()
   455	    assert list(sd_off) == list(sd_on)
   456	    for k in sd_off:
   457	        assert torch.equal(sd_on[k], sd_off[k]), f"weights differ before backward: {k}"
   458	
   459	    grads_off = _param_grads(cond_off, conditioning, vit_id)
   460	    grads_on = _param_grads(cond_on, conditioning, vit_id)
   461	    assert set(grads_off) == set(grads_on)
   462	    assert len(grads_off) > 100, f"suspiciously few grad tensors: {len(grads_off)}"
   463	    max_diff = 0.0
   464	    for n in grads_off:
   465	        assert torch.allclose(grads_on[n], grads_off[n], atol=1e-6, rtol=1e-5), (
   466	            f"grad mismatch for {n}: max abs diff "
   467	            f"{(grads_on[n] - grads_off[n]).abs().max().item():.3e}"
   468	        )
   469	        max_diff = max(max_diff, (grads_on[n] - grads_off[n]).abs().max().item())
   470	    print(
   471	        f"\ngradient-identity max abs diff over {len(grads_off)} tensors: {max_diff:.3e}"
   472	    )
