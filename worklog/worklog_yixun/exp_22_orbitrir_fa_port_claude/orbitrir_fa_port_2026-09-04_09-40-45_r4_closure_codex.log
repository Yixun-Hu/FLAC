   102	    test_loader = DataLoader(test_dataset, shuffle=False, batch_size=1, num_workers=0)
   103	
   104	    # Create metric callback
   105	    metric_callback = create_metrics_callback(args)
   106	
   107	    # Evaluation
   108	    split_name = get_split_name(args)
   109	    print(f'Start evaluation of {args.baseline} on {args.dataset} dataset ({split_name})')
   110	    
   111	    with torch.no_grad():
   112	        for data in tqdm.tqdm(test_loader):
   113	            # Unpack data
   114	            out_wav, depth, proj_source_pose, tgt_wav = data
   115	            depth_coord = depth
   116	            scene = None
   117	
   118	            # Move to GPU
   119	            out_wav = out_wav.cuda()
   120	            tgt_wav = tgt_wav.cuda()
   121	            
   122	            # Compute geometry
   123	            geom = (depth_coord[:, :3, :, :] - proj_source_pose[:, :, None, None])
   124	            
   125	            # Update metrics
   126	            if scene is not None:
   127	                metric_callback.update_metrics("test", out_wav, tgt_wav, 
   128	                                              depth=[geom], scene=scene)
   129	            else:
   130	                metric_callback.update_metrics("test", out_wav, tgt_wav, 
   131	                                              depth=[geom])
   132	
   133	    # Compute and display metrics
   134	    metrics_dict = metric_callback.compute_metrics("test")
   135	    for metric_name, metric_value in metrics_dict.items():
   136	        display_name = metric_name
   137	        if metric_name == 'T60' or 'to' in metric_name:
   138	            display_name += ' (%)'
   139	        elif metric_name == 'EDT':
   140	            display_name += ' (ms)'
   141	        elif metric_name == 'C50':
   142	            display_name += ' (dB)'
   143	        print(f'Test/{display_name}: {metric_value}')
   144	    
   145	    # Save metrics to file
   146	    if args.out_dir is not None:
   147	        os.makedirs(args.out_dir, exist_ok=True)
   148	        
   149	        metrics_to_save = {
   150	            "metrics": metrics_dict,
   151	            "dataset": args.dataset,
   152	            "baseline": args.baseline,
   153	            "split": split_name,
   154	            "num_shot": args.num_shot,
   155	        }
   156	        
   157	        filename = f"{args.dataset}_{args.baseline}_{split_name}_{args.num_shot}_metrics.json"
   158	        path2save = os.path.join(args.out_dir, filename)
   159	        
   160	        with open(path2save, 'w') as f:
   161	            json.dump(metrics_to_save, f, indent=4)
   162	        
   163	        print(f"\nMetrics saved to {path2save}")

