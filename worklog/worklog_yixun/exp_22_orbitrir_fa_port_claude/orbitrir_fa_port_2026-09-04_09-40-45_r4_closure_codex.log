    18	VANILLA_PATH = os.path.join(CONFIG_DIR, "FLAC_AR.json")
    19	FA_PATH = os.path.join(CONFIG_DIR, "FLAC_AR_FA.json")
    20	
    21	VIT_IDS = ("source_vit", "context_poses_vit")
    22	EXPECTED_ANGLES = [0.0, 90.0, 180.0, 270.0]
    23	
    24	# Symmetric diff the two configs are allowed to have: path -> value added by the
    25	# frame-averaged config. Every path is absent from the vanilla config.
    26	EXPECTED_DIFF = {
    27	    "training.cond_method": ("str", "fa_invariant"),
    28	    "training.frame_avg_angles": tuple(("float", a) for a in EXPECTED_ANGLES),
    29	    "model.conditioning.configs[source_vit].config.gradient_checkpointing": ("bool", True),
    30	    "model.conditioning.configs[context_poses_vit].config.gradient_checkpointing": ("bool", True),
    31	}
    32	
    33	
    34	def _load(path):
    35	    with open(path) as f:
    36	        return json.load(f)  # fails the test if the JSON is malformed
    37	
    38	
    39	def _flatten(node, path="", out=None):
    40	    """Flatten a config to ``dotted.path -> leaf``.
    41	
    42	    Dicts are walked by key. ``conditioning.configs`` is walked by each entry's
    43	    ``id`` rather than by position, so reordering the conditioner list cannot
    44	    hide a changed value behind a shifted index. Other lists are walked by index,
    45	    except lists holding only scalars (``frame_avg_angles``, ``c_mults``, ...),
    46	    which are compared whole -- an order-sensitive comparison that reports one
    47	    path per declared list instead of one per element. Leaves are recorded as
    48	    ``(type-name, value)`` pairs -- scalar-list elements included -- so a value
    49	    that changes only its type (``true`` -> ``1``) still registers as a change.
    50	    """
    51	    out = {} if out is None else out
    52	    if isinstance(node, dict):
    53	        for key, value in node.items():
    54	            _flatten(value, f"{path}.{key}" if path else str(key), out)
    55	    elif isinstance(node, list):
    56	        if path.endswith("conditioning.configs"):
    57	            seen = set()
    58	            for entry in node:
    59	                assert isinstance(entry, dict) and "id" in entry, \
    60	                    f"{path}: conditioner entry without an 'id': {entry!r}"
    61	                assert entry["id"] not in seen, f"{path}: duplicate id {entry['id']!r}"
    62	                seen.add(entry["id"])
    63	                _flatten(entry, f"{path}[{entry['id']}]", out)
    64	        elif any(isinstance(value, (dict, list)) for value in node):
    65	            for i, value in enumerate(node):
    66	                _flatten(value, f"{path}[{i}]", out)
    67	        else:
    68	            out[path] = tuple((type(value).__name__, value) for value in node)
    69	    else:
    70	        out[path] = (type(node).__name__, node)
    71	    return out
    72	
    73	
    74	def _conditioner(config, cond_id):
    75	    for entry in config["model"]["conditioning"]["configs"]:
