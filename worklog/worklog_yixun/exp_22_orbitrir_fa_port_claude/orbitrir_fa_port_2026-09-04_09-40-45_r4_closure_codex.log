   424	# --------------------------------------------------------------------------------------
   425	# GRADIENT identity ON vs OFF (numerics untouched end-to-end, not just at init)
   426	# --------------------------------------------------------------------------------------
   427	
   428	def _param_grads(mc, conditioning: dict, vit_id: str, seed: int = 123):
   429	    """Seeded conditioner forward+backward; returns {name: grad clone}."""
   430	    try:
   431	        mc.train()
   432	        mc.zero_grad(set_to_none=True)
   433	        out = _run_vit_conditioner(mc, conditioning, vit_id, seed=seed)
   434	        out.float().pow(2).mean().backward()
   435	        return {
   436	            n: p.grad.detach().clone()
   437	            for n, p in mc.named_parameters()
   438	            if p.grad is not None
   439	        }
   440	    finally:
   441	        mc.zero_grad(set_to_none=True)
   442	        mc.eval()
   443	
