    78	    pytest.fail(f"no conditioner with id {cond_id!r} in {sorted(e.get('id') for e in config['model']['conditioning']['configs'])}")
    79	
    80	
    81	def _vit_blocks(config):
    82	    return {cond_id: _conditioner(config, cond_id)["config"]["ViT"] for cond_id in VIT_IDS}
    83	
    84	
    85	def test_fa_config_differs_in_exactly_four_leaves():
    86	    flat_vanilla = _flatten(_load(VANILLA_PATH))
    87	    flat_fa = _flatten(_load(FA_PATH))
    88	
    89	    removed = sorted(set(flat_vanilla) - set(flat_fa))
    90	    changed = sorted(p for p in set(flat_vanilla) & set(flat_fa) if flat_vanilla[p] != flat_fa[p])
