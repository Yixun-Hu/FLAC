   187	def _build(conditioning_cfg: dict):
   188	    """Seeded build of the conditioner stack. The backbone weights come from the
   189	    cached pretrained snapshot (identical every time); the seed pins the randomly
   190	    initialised projection heads, so two builds share byte-identical weights —
   191	    which ``test_state_dict_identical_flag_on_vs_off`` verifies independently."""
   192	    from src.models.conditioners import create_multi_conditioner_from_conditioning_config
   193	
