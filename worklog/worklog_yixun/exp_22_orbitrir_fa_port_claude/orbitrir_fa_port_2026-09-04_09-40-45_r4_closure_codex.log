   241	@pytest.fixture()
   242	def counting_checkpoint(monkeypatch):
   243	    shim = _CountingCheckpoint(torch.utils.checkpoint.checkpoint)
   244	    monkeypatch.setattr(torch.utils.checkpoint, "checkpoint", shim)
   245	    return shim
