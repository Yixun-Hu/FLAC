   351	# --------------------------------------------------------------------------- #
   352	# 9. NEGATIVE: stale (unrotated) depth in the averaging loop breaks invariance
   353	# --------------------------------------------------------------------------- #
   354	def _stale_depth_conditioning(cond, metadata, device, angles=yr.DEFAULT_FRAME_ANGLES,
   355	                              vit_ids=VIT_IDS):
   356	    """Deliberately BROKEN mimic of ``invariant_conditioning``: per frame angle
   357	    it rotates the ``*_vit`` poses but feeds the STALE (unrotated) depth map —
   358	    the exact stale-depth bug class. Test-local only; exists to prove the C4
   359	    invariance assertions in this file can actually catch that bug."""
   360	    md_inv = [yr.cylindrical_pose_features(md) for md in metadata]
   361	    base = cond(md_inv, device)
   362	    present = [i for i in vit_ids if i in base]
   363	    img_w = int(metadata[0]["depth"].shape[-1])
   364	    accum = {i: base[i][0].clone() for i in present}
   365	    for g in angles[1:]:
   366	        variants = []
   367	        for m in md_inv:
   368	            v = yr.rotate_scene_metadata(m, math.radians(g), img_w,
   369	                                         pose_keys=tuple(present))
   370	            v["depth"] = m["depth"]  # BUG under test: depth not co-rotated
   371	            variants.append(v)
   372	        part = cond(variants, device, only_ids=present)
   373	        for i in present:
   374	            accum[i] = accum[i] + part[i][0]
   375	    for i in present:
   376	        base[i][0] = accum[i] / float(len(angles))
   377	    return base
   378	
   379	
   380	def test_stale_depth_fails_invariance():
   381	    cond = _build_cond()
   382	    md = _batch(2)
   383	    broken_0 = _stale_depth_conditioning(cond, md, DEV)
   384	    correct_0 = yr.invariant_conditioning(cond, md, DEV)
   385	    rot = [yr.rotate_scene_metadata(m, math.radians(90.0), 512) for m in md]
   386	    broken_g = _stale_depth_conditioning(cond, rot, DEV)
   387	    for key in VIT_IDS:
   388	        inv_div = float((broken_g[key][0] - broken_0[key][0]).abs().max())
   389	        avg_div = float((broken_0[key][0] - correct_0[key][0]).abs().max())
   390	        print(
   391	            f"{key}: stale-depth invariance divergence {inv_div:.3e}, "
   392	            f"divergence from correct orbit average {avg_div:.3e}"
   393	        )
   394	        # The broken variant must FAIL the same C4 invariance check the
   395	        # positive test uses...
   396	        assert not torch.allclose(broken_g[key][0], broken_0[key][0], atol=1e-5), (
   397	            f"{key}: stale-depth variant unexpectedly passed the C4 invariance "
   398	            "check — the FakeGeometry/depth fixtures are too weak to pin the "
   399	            "stale-depth bug"
   400	        )
   401	        # ...and must not reproduce the correct orbit average either.
   402	        assert not torch.allclose(broken_0[key][0], correct_0[key][0], atol=1e-5), (
   403	            f"{key}: stale-depth variant matches the correct orbit average"
   404	        )

