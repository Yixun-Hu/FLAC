   157	        self.net = self.net.to(device)
   158	        audios = torch.stack(audios, dim=0) # [B, N, C, T]
   159	        audios = audios.to(device)
   160	        if audios.dim() == 3:
   161	            audios = audios.unsqueeze(1)
   162	        B, N, C, T = audios.shape
   163	        audios = audios.view(B * N, C, T)  # [B*N, C, T]
   164	        audios = self.stft(audios)  # [B*N, C, F, T]
   165	
   166	        audios = torch.sqrt(
   167	            torch.clamp((audios.real**2) + (audios.imag**2), min=1e-8)
   168	        )
   169	
   170	        encoded = self.net(audios) # [batch, 512]
   171	        encoded = encoded.view(B, N, -1)
   172	        out = self.proj_out(encoded)  # [B, N, D]
   173	
   174	        return [out, torch.ones(encoded.shape[0], 1).to(device)]
   175	    
   176	class GeometryConditioner(Conditioner):
   177	    def __init__(self, 
   178	                 vit_model, 
   179	                 vit_proj,
   180	                 lin_proj,
   181	                 output_dim: int,
   182	                 max_value: float = 5.0,
   183	                 dim: int = 512,
   184	                 model_type: str = "vit",
   185	                 name="GeometryConditioner"):
   186	        super().__init__(dim, output_dim, project_out=False)
   187	        self.name = name
   188	        self.vit = vit_model
   189	        self.proj_out = vit_proj
   190	        self.lin_proj = lin_proj
   191	        self.max_value = max_value
   192	        self.model_type = model_type    
   193	
   194	    def forward(self, coord, device: tp.Union[torch.device, str] = "cuda") -> tp.Tuple[torch.Tensor, torch.Tensor]:
   195	        self.vit.to(device)
   196	        self.proj_out.to(device)
   197	
   198	        depth_coords, coords = [], []
   199	        for c in coord:
   200	            coords.append(c['coord'].float().to(device))
   201	            depth_coords.append(c['depth'].float().to(device))
   202	
   203	        coord = torch.stack(coords, dim=0)  # [B, 3] or [B, N, 3]
   204	        if coord.ndim == 2:
   205	            coord = coord.unsqueeze(1) # [B, 1, 3]
   206	        depth_coord = torch.stack(depth_coords, dim=0)
   207	
   208	        encoded_coords = []
   209	        for i in range(coord.shape[1]):
   210	            c = (coord[:, i, :, None, None] - depth_coord) / self.max_value # [B, 3, H, W]
   211	            if self.model_type == 'dino':
   212	                outputs = self.vit(c)
   213	                pooled_output = outputs.pooler_output
   214	                c = self.lin_proj(pooled_output).unsqueeze(1)  # [B, 1, D]
   215	            elif self.model_type == 'vit':
   216	                c = self.vit(c) 
   217	                c = self.proj_out(c) 
   218	                c = self.lin_proj(c.permute(0, 2, 1)).squeeze(-1).unsqueeze(1)  # [B, 1, D]
   219	            else: 
   220	                raise NotImplementedError('model_type must be either "dino" or "vit"')
   221	            encoded_coords.append(c)
   222	        out = torch.cat(encoded_coords, dim=1)  # [B, N, D]
   223	
   224	        return [out, torch.ones(out.shape[0], 1).to(device)]
   225	
   226	class DistEmbedderConditioner(Conditioner):
   227	    def __init__(self, 
   228	                 output_dim: int,
   229	                 project_out: bool = False,
   230	                 max_val: float = 5.0,
   231	                 funcs=[torch.sin, torch.cos], 
   232	                 num_freqs=20, 
   233	                 max_freq=10, 
   234	                 ch_dim=1, 
   235	                 include_in=True, 
   236	                 name: str = "DistEmbedderConditioner", 
   237	                 dist_embedder_proj: tp.Optional[torch.nn.Module] = None):
   238	        
   239	        in_dim = (len(funcs) * num_freqs + (1 if include_in else 0)) * 3
   240	        super().__init__(in_dim, output_dim, project_out=False)
   241	        self.funcs = funcs
   242	        self.num_functions = list(range(len(funcs)))
   243	        self.freqs = torch.nn.Parameter(2.0**torch.from_numpy(np.linspace(start=0.0,stop=max_freq, num=num_freqs).astype(np.single)), requires_grad=False)
   244	        self.ch_dim = ch_dim
   245	        self.include_in = include_in
   246	        self.max_val = max_val
   247	        self.name = name
   248	        self.dist_embedder_proj = dist_embedder_proj
   249	
   250	    def forward(self, x_input, device: tp.Union[torch.device, str] = "cuda") -> tp.Tuple[torch.Tensor, torch.Tensor]:
   251	        x_input = torch.stack(x_input, dim=0).to(device)
   252	
   253	        if x_input.dim() == 2:
   254	            x_input = x_input.unsqueeze(1)
   255	
   256	        outs = []
   257	        for i in range(x_input.shape[1]):
   258	            x = (x_input[:, i:(i+1)]) / self.max_val 
   259	            if self.include_in:
   260	                out_list = [x]
   261	            else:
   262	                out_list = []
   263	            for func in self.funcs:
   264	                for freq in self.freqs:
   265	                    out_list.append(func(x*freq))
   266	            out = torch.cat(out_list, dim=self.ch_dim).view(x_input.shape[0], -1)
   267	            out = self.dist_embedder_proj(out)
   268	            outs.append(out)
   269	        out = torch.stack(outs, dim=1)
   270	
   271	        return [out, torch.ones(out.shape[0], 1).to(out.device)]
   272	
   273	class MultiConditioner(nn.Module):
   274	    """
   275	    A module that applies multiple conditioners to an input dictionary based on the keys
   276	
   277	    Args:
   278	        conditioners: a dictionary of conditioners with keys corresponding to the keys of the conditioning input dictionary (e.g. "prompt")
   279	        default_keys: a dictionary of default keys to use if the key is not in the input dictionary (e.g. {"prompt_t5": "prompt"})
   280	    """
   281	    def __init__(self, conditioners: tp.Dict[str, Conditioner], default_keys: tp.Dict[str, str] = {}, pre_encoded_keys: tp.List[str] = []):
   282	        super().__init__()
   283	
   284	        self.conditioners = nn.ModuleDict(conditioners)
   285	        self.default_keys = default_keys
   286	        self.pre_encoded_keys = pre_encoded_keys
   287	
   288	    def forward(self, batch_metadata: tp.List[tp.Dict[str, tp.Any]], device: tp.Union[torch.device, str], only_ids: tp.Optional[tp.Iterable[str]] = None) -> tp.Dict[str, tp.Any]:
   289	        # only_ids: when given, run (and return) exactly the conditioners whose id
   290	        # is in this collection; default None keeps the full behaviour unchanged.
   291	        # Used by yaw_rotation.invariant_conditioning to re-run only the ViT
   292	        # conditioners per rotation frame without re-running stateful non-ViT ones.
   293	        output = {}
   294	
   295	        for key, conditioner in self.conditioners.items():
   296	            if only_ids is not None and key not in only_ids:
   297	                continue
   298	            condition_key = key
   299	
   300	            conditioner_inputs = []
   301	
   302	            for x in batch_metadata:
   303	                if condition_key not in x:
   304	                    if condition_key in self.default_keys:
   305	                        condition_key = self.default_keys[condition_key]
   306	                    else:
   307	                        raise ValueError(f"Conditioner key {condition_key} not found in batch metadata")
   308	                
   309	                if conditioner.name == 'GeometryConditioner':
   310	                    add_input = 'depth'
   311	                    if add_input not in x:
   312	                        raise ValueError(f"Conditioner {key} requires depth input, but it is not present in the batch metadata")
   313	                    else:
   314	                        if isinstance(x[condition_key], list) or isinstance(x[condition_key], tuple) and len(x[condition_key]) == 1:
   315	                            coord = x[condition_key][0]
   316	                        else: 
   317	                            coord = x[condition_key]
   318	                    if isinstance(x[add_input], list) or isinstance(x[add_input], tuple) and len(x[add_input]) == 1:
   319	                        conditioner_input = {'coord': coord, 'depth': x[add_input][0]}
   320	                    else:
   321	                        conditioner_input = {'coord': x[condition_key], 'depth': x[add_input]}
   322	
   323	                else:
   324	                    #Unwrap the condition info if it's a single-element list or tuple, this is to support collation functions that wrap everything in a list
   325	                    if isinstance(x[condition_key], list) or isinstance(x[condition_key], tuple) and len(x[condition_key]) == 1:
   326	                        conditioner_input = x[condition_key][0]
   327	                    else:
   328	                        conditioner_input = x[condition_key]
   329	
   330	                conditioner_inputs.append(conditioner_input)
   331	
   332	            if key in self.pre_encoded_keys:
   333	                output[key] = [torch.stack(conditioner_inputs, dim=0).to(device), None]
   334	            else:
   335	                output[key] = conditioner(conditioner_inputs, device=device)
   336	
   337	        return output
   338	    
   339	def create_multi_conditioner_from_conditioning_config(config: tp.Dict[str, tp.Any], pretransform=None) -> MultiConditioner:
   340	    """
   341	    Create a MultiConditioner from a conditioning config dictionary
   342	
   343	    Args:
   344	        config: the conditioning config dictionary
   345	        device: the device to put the conditioners on
   346	    """
   347	    conditioners = {}
   348	    cond_dim = config["cond_dim"]
   349	    
   350	    default_keys = config.get("default_keys", {})
   351	
   352	    pre_encoded_keys = config.get("pre_encoded_keys", [])
   353	
   354	    vit_model = None
   355	    dist_embedder_proj = None
   356	
   357	    for conditioner_info in config["configs"]:
   358	        id = conditioner_info["id"]
   359	        conditioner_type = conditioner_info["type"]
   360	        conditioner_config = {"output_dim": cond_dim}
   361	        conditioner_config.update(conditioner_info["config"])
   362	
   363	        if conditioner_type == "rir":
   364	            conditioners[id] = RIRConditioner(**conditioner_config)
   365	
   366	        elif conditioner_type == "ViTCoordinates":
   367	            if vit_model is None: 
   368	                vit_config = conditioner_config.pop("ViT", {})
   369	
   370	                # DINO Encoder
   371	                if vit_config.get('hf_model_name_or_path', None) is not None:
   372	                    model_name_or_path = vit_config.get('hf_model_name_or_path', None)
   373	
   374	                    # Optional `revision` selects a Hugging Face Hub revision (branch, tag, or
   375	                    # commit hash). Branches and tags may move; use a full commit hash to pin an
   376	                    # immutable snapshot for reproducible training. If omitted, Transformers uses
   377	                    # the repository's default revision (`main`).
   378	                    revision = vit_config.get('revision', None)
   379	                    hf_kwargs = {'revision': revision} if revision else {}
   380	
   381	                    if vit_config.get('from_scratch', False):
   382	                        print(f"Loading ViT model from scratch: {model_name_or_path}...")
   383	                        vit_model = AutoModel.from_config(AutoConfig.from_pretrained(model_name_or_path, **hf_kwargs))
   384	                    else:
   385	                        print(f"Loading ViT model from {model_name_or_path}...")
   386	                        vit_model = AutoModel.from_pretrained(model_name_or_path, **hf_kwargs)
   387	
   388	                    if vit_config.get('freeze', False):
   389	                        print('Freezing ViT model parameters...')
   390	                        for param in vit_model.parameters():
   391	                            param.requires_grad = False
   392	                    
   393	                    if 'convnext' in model_name_or_path:
   394	                        hidden_size = vit_model.config.hidden_sizes[-1]  
   395	                        raise NotImplementedError("ConvNeXt-based conditioners are not currently tested and may require changes")  
   396	                    else:
   397	                        hidden_size = vit_model.config.hidden_size
   398	
   399	                    channels=vit_config.get('ch_dim', 3)
   400	                    assert channels == 3, "Only 3 channels are supported"
   401	                    
   402	                    n_trainable_params = sum(p.numel() for p in vit_model.parameters() if p.requires_grad)
   403	                    n_total_params = sum(p.numel() for p in vit_model.parameters())
   404	                    print(f"{n_trainable_params / 1e6:.2f}M/{n_total_params / 1e6:.2f}M parameters are trainable")
   405	
   406	                    lin_proj = nn.Linear(hidden_size, cond_dim) if cond_dim != hidden_size else nn.Identity()
   407	                    vit_proj = nn.Identity()
   408	                    model_type = 'dino'
   409	
   410	                else: # Simple ViT Encoder (from xRIR)
   411	                    vit_model = SimpleViT(image_size=(vit_config['img_h'],vit_config['img_w']), patch_size=(vit_config['patch_h'], vit_config['patch_w']), dim=512, depth=12, heads=8, mlp_dim=512, channels=vit_config.get('ch_dim', 3))
   412	                    vit_proj = nn.Linear(512, cond_dim) if cond_dim != 512 else nn.Identity() 
   413	                    lin_proj = nn.Linear(256, 1) 
   414	                    model_type = 'vit'
   415	            else:
   416	                conditioner_config.pop("ViT", None)
   417	            conditioners[id] = GeometryConditioner(**conditioner_config, vit_model=vit_model, vit_proj=vit_proj, lin_proj=lin_proj, model_type=model_type)
   418	
   419	        elif conditioner_type == "dist_embedder":
   420	            if dist_embedder_proj is None and not conditioner_config.get("init_cond", False): # share the same projection for all DistEmbedderConditioners
   421	                in_channels = conditioner_config.get('in_channels', 3)
   422	                dist_embedder_proj = nn.Linear((2 * conditioner_config['num_freqs'] + (1 if conditioner_config['include_in'] else 0)) * in_channels, cond_dim)
   423	            conditioner_config.pop('in_channels', None)
   424	            conditioners[id] = DistEmbedderConditioner(**conditioner_config, dist_embedder_proj=dist_embedder_proj)
   425	        
   426	        elif conditioner_type == "pretransform":
   427	            sample_rate = conditioner_config.pop("sample_rate", None)
   428	            assert sample_rate is not None, "Sample rate must be specified for pretransform conditioners"
   429	
   430	            use_model_pretransform = conditioner_config.pop("use_model_pretransform", False)
   431	
   432	            if not use_model_pretransform:
   433	                cond_pretransform = create_pretransform_from_config(conditioner_config.pop("pretransform_config"), sample_rate=sample_rate)
   434	            else:
   435	                assert pretransform is not None, "Model pretransform must be specified for pretransform conditioners"
   436	                cond_pretransform = pretransform
   437	
   438	            if conditioner_config.get("pretransform_ckpt_path", None) is not None:
   439	                cond_pretransform.load_state_dict(load_ckpt_state_dict(conditioner_config.pop("pretransform_ckpt_path")), strict=True)
   440	
   441	            conditioners[id] = PretransformConditioner(cond_pretransform, **conditioner_config)
   442	
   443	        else:
   444	            raise ValueError(f"Unknown conditioner type: {conditioner_type}")
   445	
   446	    return MultiConditioner(conditioners, default_keys=default_keys, pre_encoded_keys=pre_encoded_keys)

