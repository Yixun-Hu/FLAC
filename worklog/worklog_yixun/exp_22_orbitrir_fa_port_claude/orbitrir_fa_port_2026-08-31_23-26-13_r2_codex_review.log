     1	"""Tests for ``src.data.yaw_rotation.invariant_conditioning`` and the new
     2	``only_ids`` parameter of ``src.models.conditioners.MultiConditioner.forward``.
     3	
     4	These exercise the *real* ``MultiConditioner`` populated with small deterministic
     5	fake conditioners (duck-typed ``nn.Module`` s registered under the exact FLAC ids
     6	``source`` / ``source_vit`` / ``context_poses`` / ``context_poses_vit`` /
     7	``context_audio``). The fakes are cheap stand-ins for the DINOv3 geometry stack,
     8	the dist-embedder pose stack and the RIR encoder respectively; they let us assert
     9	the frame-averaging contract without loading any pretrained backbone:
    10	
    11	- C4 frame closure gives exact end-to-end invariance: depth MUST roll together
    12	  with the ``*_vit`` poses, and non-ViT conditioners run once.
    13	- pose entries are invariant at arbitrary angles via the cylindrical features.
    14	- the caller's metadata is never mutated.
    15	"""
    16	import copy
    17	import math
    18	
    19	import torch
    20	from torch import nn
    21	
    22	from src.data import yaw_rotation as yr
    23	from src.models.conditioners import MultiConditioner
