   139	def azimuth_rotation_matrix(alpha_rad: float) -> torch.Tensor:
   140	    """
   141	    Build a 3x3 rotation matrix about the vertical (z) axis.
   142	
   143	    Parameters
   144	    ----------
   145	    alpha_rad : float
   146	        Rotation angle in radians. Positive values rotate the (x, y) plane
   147	        counter-clockwise, which corresponds to increasing azimuth.
   148	
   149	    Returns
   150	    -------
   151	    torch.Tensor
   152	        A ``[3, 3]`` float32 rotation matrix leaving the z component unchanged.
   153	    """
   154	    c = math.cos(alpha_rad)
   155	    s = math.sin(alpha_rad)
   156	    return torch.tensor([[c, -s, 0.0], [s, c, 0.0], [0.0, 0.0, 1.0]], dtype=torch.float32)
   157	
