   101	def _neutralize_for_steps(wrapper, monkeypatch):
   102	    """Stub everything the step methods touch *after* conditioning, so a dispatch
   103	    test never depends on the DiT maths, the sampler, the metric callback, a
   104	    Lightning Trainer or the logger. Instance-level stubs live on the fresh
   105	    per-test wrapper (no leakage); the module-global sampler goes through
   106	    monkeypatch (auto-undone)."""
   107	    # DiT forward (training_step + validation_step) -> zeros shaped like input.
   108	    wrapper.diffusion.forward = lambda x, t, **kw: torch.zeros_like(x)
   109	    # training_step: logging + optimizer-lr readout.
   110	    wrapper.log_dict = lambda *a, **k: None
   111	    wrapper.trainer = types.SimpleNamespace(
   112	        optimizers=[types.SimpleNamespace(param_groups=[{"lr": 5e-6}])]
   113	    )
   114	    # test_step: attrs normally set by set_test_config (which builds a heavy
   115	    # AcousticMetricsCallback) + a no-op sampler and metric sink.
   116	    wrapper.samples = 64
   117	    wrapper.steps = 1
   118	    wrapper.cfg_scale = 1.0
   119	    wrapper.store_predictions = False
   120	    wrapper.preds = []
   121	    wrapper.metric_callback = types.SimpleNamespace(update_metrics=lambda *a, **k: None)
   122	    monkeypatch.setattr(tdiff, "sample_discrete_euler", lambda model, x, *a, **k: x)
