    57	def _make_md(seed: int = 0) -> dict:
    58	    g = torch.Generator().manual_seed(seed)
    59	    return {
    60	        "source": torch.randn(3, generator=g),
    61	        "source_vit": torch.randn(1, 3, generator=g),
    62	        "context_poses": torch.randn(4, 3, generator=g),
    63	        "context_poses_vit": torch.randn(4, 3, generator=g),
    64	        "context_audio": torch.randn(4, 1, 256, generator=g),
    65	        "depth": _consistent_depth(8, 512),
    66	    }
