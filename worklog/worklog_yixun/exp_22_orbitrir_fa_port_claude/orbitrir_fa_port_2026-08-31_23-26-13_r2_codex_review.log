    29	# --------------------------------------------------------------------------- #
    30	# geometrically consistent synthetic depth (adapted from test_yaw_symmetry)
    31	# --------------------------------------------------------------------------- #
    32	def _consistent_depth(H: int = 8, W: int = 512) -> torch.Tensor:
    33	    """Geometrically consistent but NON-axisymmetric equirectangular depth
    34	    point cloud.
    35	
    36	    At column ``j`` the stored vector's xy-azimuth still equals that column's
    37	    own azimuth ``theta_j``, so roll + z-rotation composes exactly. Unlike a
    38	    constant-radius panorama — for which ``rotate_scene_metadata`` is a *fixed
    39	    point* of the depth map, hiding stale-depth bugs — the radial distance
    40	    varies with azimuth (periods 2*pi and pi, so every C4 roll changes the
    41	    map). This is what lets the stale-depth negative test detect a depth/pose
    42	    co-rotation bug."""
    43	    j = torch.arange(W, dtype=torch.float32)
    44	    theta = (j + 0.5) * 2.0 * math.pi / W - math.pi
    45	    i = torch.arange(H, dtype=torch.float32)
    46	    el = (i + 0.5) * math.pi / H - math.pi / 2.0
    47	    theta_g = theta.view(1, W).expand(H, W)
    48	    el_g = el.view(H, 1).expand(H, W)
    49	    # Azimuth-dependent radius, strictly positive (minimum 3.0 - 1.5 = 1.5).
    50	    d = 3.0 + 1.0 * torch.sin(theta_g) + 0.5 * torch.sin(2.0 * theta_g)
    51	    x = d * torch.cos(el_g) * torch.cos(theta_g)
    52	    y = d * torch.cos(el_g) * torch.sin(theta_g)
    53	    z = d * torch.sin(el_g)
    54	    return torch.stack([x, y, z], dim=0).contiguous()
    55	
