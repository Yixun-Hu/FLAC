   331	def test_pose_depth_corotation():
   332	    # A pose sitting on the sight-line of column j must land on the sight-line of
   333	    # column j + dj, i.e. exactly where that depth column was rolled to.
   334	    W = 512
   335	    j = 100
   336	    theta_j = _column_azimuth(j, W)
   337	    md = {
   338	        "source": torch.tensor([math.cos(theta_j), math.sin(theta_j), 0.0]),
   339	        "depth": _consistent_depth(8, W),
   340	    }
   341	    alpha = math.radians(90.0)
   342	    dj = int(round(alpha * W / (2.0 * math.pi))) % W
   343	    out = yr.rotate_scene_metadata(md, alpha, W)
   344	
   345	    az = math.atan2(float(out["source"][1]), float(out["source"][0]))
   346	    assert abs(_wrap(az - _column_azimuth((j + dj) % W, W))) < 1e-5
   347	
   348	    # and the depth column itself did move to (j + dj) % W.
   349	    rot = yr.azimuth_rotation_matrix(dj * 2.0 * math.pi / W)
   350	    moved = torch.einsum("ij,jh->ih", rot, md["depth"][:, :, j])
   351	    assert torch.allclose(out["depth"][:, :, (j + dj) % W], moved, atol=1e-6)
