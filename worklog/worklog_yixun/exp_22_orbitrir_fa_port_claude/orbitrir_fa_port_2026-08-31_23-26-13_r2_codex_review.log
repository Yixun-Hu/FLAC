   247	
   248	        p.tick("conditioning")
   249	        if self.diffusion.pretransform is not None:
   250	            self.diffusion.pretransform.to(self.device)
   251	
   252	            if not self.pre_encoded:
   253	                with torch.amp.autocast('cuda') and torch.set_grad_enabled(self.diffusion.pretransform.enable_grad):
   254	                    self.diffusion.pretransform.train(self.diffusion.pretransform.enable_grad)
   255	                    diffusion_input = self.diffusion.pretransform.encode(diffusion_input)
   256	                    p.tick("pretransform")
   257	
   258	                    # If mask_padding is on, interpolate the padding masks to the size of the pretransformed input
   259	                    padding_masks = F.interpolate(padding_masks.unsqueeze(1).float(), size=diffusion_input.shape[2], mode="nearest").squeeze(1).bool()
   260	            else:
   261	                # Apply scale to pre-encoded latents if needed, as the pretransform encode function will not be run
   262	                if hasattr(self.diffusion.pretransform, "scale") and self.diffusion.pretransform.scale != 1.0:
   263	                    diffusion_input = diffusion_input / self.diffusion.pretransform.scale
   264	
   265	        if self.timestep_sampler == "uniform":
   266	            # Draw uniformly distributed continuous timesteps
   267	            t = self.rng.draw(reals.shape[0])[:, 0].to(self.device)
   268	        elif self.timestep_sampler == "logit_normal":
   269	            t = torch.sigmoid(torch.randn(reals.shape[0], device=self.device))
   270	        elif self.timestep_sampler == "trunc_logit_normal":
   271	            # Draw from logistic truncated normal distribution
   272	            t = truncated_logistic_normal_rescaled(reals.shape[0]).to(self.device)
   273	            # Flip the distribution
   274	            t = 1 - t
   275	        elif self.timestep_sampler == "log_snr":
   276	            t = sample_timesteps_logsnr(reals.shape[0], mean_logsnr=self.mean_logsnr, std_logsnr=self.std_logsnr).to(self.device)
   277	        elif self.timestep_sampler == "ones":
   278	            t = torch.ones(reals.shape[0], device=self.device)
   279	        else:
   280	            raise ValueError(f"Invalid timestep_sampler: {self.timestep_sampler}")
   281	
   282	        if self.diffusion.dist_shift is not None:
   283	            print('Applying distribution shift to timesteps')
   284	            t = self.diffusion.dist_shift.time_shift(t, reals.shape[2])
   285	
   286	        if self.p_one_shot > 0:
   287	            print('Applying one-shot timesteps')
   288	            # Set t to 1 with probability p_one_shot
   289	            t = torch.where(torch.rand_like(t) < self.p_one_shot, torch.ones_like(t), t)
   290	
   291	        # Calculate the noise schedule parameters for those timesteps
   292	        if self.diffusion_objective in ["v"]:
   293	            alphas, sigmas = get_alphas_sigmas(t)
   294	        elif self.diffusion_objective in ["rectified_flow", "rf_denoiser"]:
   295	            alphas, sigmas = 1-t, t
   296	        
   297	        # Combine the ground truth data and the noise
   298	        alphas = alphas[:, None, None]
   299	        sigmas = sigmas[:, None, None]
   300	        noise = torch.randn_like(diffusion_input)
   301	
   302	        noised_inputs = diffusion_input * alphas + noise * sigmas
   303	
   304	        if self.diffusion_objective == "v":
   305	            targets = noise * alphas - diffusion_input * sigmas
   306	        elif self.diffusion_objective in ["rectified_flow", "rf_denoiser"]:
   307	            targets = noise - diffusion_input
   308	
   309	        p.tick("noise")
   310	        extra_args = {}
   311	        if use_padding_mask:
   312	            extra_args["mask"] = padding_masks
   313	
   314	        output = self.diffusion(noised_inputs, t, cond=conditioning, cfg_dropout_prob = self.cfg_dropout_prob, **extra_args)
   315	        
   316	        p.tick("diffusion")
   317	        loss_info.update({
   318	            "output": output,
   319	            "targets": targets,
   320	            "padding_mask": padding_masks if use_padding_mask else None,
   321	        })
   322	
   323	        loss, losses = self.losses(loss_info)
   324	
   325	        p.tick("loss")
   326	        if self.log_loss_info:
   327	            # Loss debugging logs
   328	            num_loss_buckets = 10
   329	            bucket_size = 1 / num_loss_buckets
   330	            loss_all = F.mse_loss(output, targets, reduction="none")
   331	
   332	            sigmas = rearrange(self.all_gather(sigmas), "w b c n -> (w b) c n").squeeze()
   333	
   334	            # gather loss_all across all GPUs
   335	            loss_all = rearrange(self.all_gather(loss_all), "w b c n -> (w b) c n")
   336	
   337	            # Bucket loss values based on corresponding sigma values, bucketing sigma values by bucket_size
   338	            loss_all = torch.stack([loss_all[(sigmas >= i) & (sigmas < i + bucket_size)].mean() for i in torch.arange(0, 1, bucket_size).to(self.device)])
   339	
   340	            # Log bucketed losses with corresponding sigma bucket values, if it's not NaN
   341	            debug_log_dict = {
   342	                f"model/loss_all_{i/num_loss_buckets:.1f}": loss_all[i].detach() for i in range(num_loss_buckets) if not torch.isnan(loss_all[i])
   343	            }
   344	
   345	            self.log_dict(debug_log_dict)
   346	
   347	        log_dict = {
   348	            'train/loss': loss.detach(),
   349	            'train/std_data': diffusion_input.std(),
   350	            'train/lr': self.trainer.optimizers[0].param_groups[0]['lr']
   351	        }
   352	
   353	        for loss_name, loss_value in losses.items():
   354	            log_dict[f"train/{loss_name}"] = loss_value.detach()
   355	
   356	        self.log_dict(log_dict, prog_bar=True, on_step=True)
   357	        p.tick("log")
   358	        #print(f"Profiler: {p}")
   359	        return loss
