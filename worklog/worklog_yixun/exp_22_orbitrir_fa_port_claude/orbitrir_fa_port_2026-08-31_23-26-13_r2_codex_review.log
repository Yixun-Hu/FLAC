    96	
    97	class FakeGeometry(nn.Module):
    98	    """GeometryConditioner stand-in (name matched so MultiConditioner feeds it
    99	    ``{'coord', 'depth'}``). Deterministic *nonlinear* function of the
   100	    coord−depth difference field with a genuinely nonzero-mean coord–depth
   101	    interaction: ``tanh`` is applied per-pixel BEFORE pooling, so the coord
   102	    contribution does not cancel out of the pooled statistic (a zero-mean
   103	    linear weight would let it cancel), and the azimuthal pooling weight is
   104	    strictly positive and non-uniform, so the statistic is also sensitive to
   105	    the depth roll offset. A wrong implementation that rotates depth without
   106	    the ``*_vit`` poses (or vice versa) therefore changes the C4 average and
   107	    fails the invariance test."""
   108	
   109	    def __init__(self, out_dim: int = 6, name: str = "GeometryConditioner"):
   110	        super().__init__()
   111	        self.name = name
   112	        self.out_dim = out_dim
   113	        self.calls = 0
   114	        g = torch.Generator().manual_seed(0)
   115	        self.register_buffer("proj", torch.randn(3, out_dim, generator=g))
   116	
   117	    def forward(self, coord_list, device=DEV):
   118	        self.calls += 1
   119	        coords, depths = [], []
   120	        for c in coord_list:
   121	            coords.append(c["coord"].float().to(device))
   122	            depths.append(c["depth"].float().to(device))
   123	        coord = torch.stack(coords, dim=0)  # [B, 3] or [B, N, 3]
   124	        if coord.ndim == 2:
   125	            coord = coord.unsqueeze(1)  # [B, 1, 3]
   126	        depth = torch.stack(depths, dim=0)  # [B, 3, H, W]
   127	        B, N, _ = coord.shape
   128	        W = depth.shape[-1]
   129	        col = torch.arange(W, device=device, dtype=coord.dtype)
   130	        # Strictly positive (in [0.5, 1.5]), non-uniform, full-period profile:
   131	        # nonzero mean (== 1) so the coord term survives pooling; period W so
   132	        # every nontrivial C4 roll misaligns depth content against it.
   133	        w = (1.0 + 0.5 * torch.cos(2.0 * math.pi * col / W)).view(1, 1, 1, W)
   134	        outs = []
   135	        for i in range(N):
   136	            diff = coord[:, i, :, None, None] - depth  # [B, 3, H, W]
   137	            pooled = (torch.tanh(diff) * w).mean(dim=(2, 3))  # [B, 3]
   138	            outs.append(pooled)
   139	        stacked = torch.stack(outs, dim=1)  # [B, N, 3]
   140	        out = torch.tanh(stacked @ self.proj)  # [B, N, out_dim]
   141	        return [out, torch.ones(B, 1, device=device)]
   142	
   143	
   144	class FakeRIR(nn.Module):
   145	    """RIR encoder stand-in: constant-shaped output, a call counter, and an
   146	    internal BatchNorm1d whose ``num_batches_tracked`` must increment exactly
   147	    once per ``invariant_conditioning`` call (the single-pass regression
   148	    guard)."""
   149	
   150	    def __init__(self, out_dim: int = 8, name: str = "RIRConditioner"):
   151	        super().__init__()
   152	        self.name = name
   153	        self.out_dim = out_dim
   154	        self.calls = 0
   155	        self.bn = nn.BatchNorm1d(out_dim)
   156	
   157	    def forward(self, audios_list, device=DEV):
   158	        self.calls += 1
   159	        audios = torch.stack(audios_list, dim=0).to(device)  # [B, N, C, T]
   160	        B, N = audios.shape[0], audios.shape[1]
   161	        flat = audios.reshape(B * N, -1)[:, : self.out_dim]  # [B*N, out_dim]
   162	        feat = self.bn(flat)  # increments num_batches_tracked by 1
   163	        out = feat.reshape(B, N, self.out_dim)
   164	        return [out, torch.ones(B, 1, device=device)]
   165	
   166	
   167	def _build_cond(with_geometry: bool = True) -> MultiConditioner:
   168	    conditioners = {
   169	        "source": FakeDist(),
   170	        "context_poses": FakeDist(),
   171	        "context_audio": FakeRIR(),
   172	    }
   173	    if with_geometry:
   174	        conditioners["source_vit"] = FakeGeometry()
   175	        conditioners["context_poses_vit"] = FakeGeometry()
   176	    return MultiConditioner(conditioners)
