   159	def rotate_scene_metadata(
   160	    md: Dict[str, object],
   161	    alpha_rad: float,
   162	    img_w: int,
   163	    pose_keys: Tuple[str, ...] = POSE_KEYS,
   164	) -> Dict[str, object]:
   165	    """
   166	    Apply a physically-consistent yaw rotation to a single sample's metadata.
   167	
   168	    The equirectangular depth map is rolled horizontally by the integer number of
   169	    columns closest to ``alpha_rad`` and its stored per-pixel 3D vectors are rotated
   170	    about z. All pose vectors are rotated about z by the same effective angle.
   171	    ``context_audio``, ``scene`` and any other field pass through unchanged. The
   172	    rotation is exact (no interpolation) because the column shift is quantised and
   173	    the rotation matrix uses the matching effective angle.
   174	
   175	    Parameters
   176	    ----------
   177	    md : Dict[str, object]
   178	        One per-sample metadata dict as produced by the AR/HAA metadata module.
   179	        Expected tensor fields: ``depth`` of shape ``[3, H, W]`` and pose fields
   180	        (``source``, ``source_vit``, ``context_poses``, ``context_poses_vit``)
   181	        whose last dimension is 3.
   182	    alpha_rad : float
   183	        Requested yaw rotation angle in radians.
   184	    img_w : int
   185	        Panorama width in pixels (number of azimuth columns), e.g. 512.
   186	    pose_keys : Tuple[str, ...], optional
   187	        Which pose fields to rotate. Defaults to rotating all of ``POSE_KEYS``.
   188	        Restricting it (e.g. to the ``*_vit`` keys only) leaves the unlisted pose
   189	        fields bit-identical; ``depth`` handling is unaffected.
   190	
   191	    Returns
   192	    -------
   193	    Dict[str, object]
   194	        A shallow-copied metadata dict with ``depth`` and the selected pose fields
   195	        replaced by their rotated versions. The original dict is not mutated.
   196	    """
   197	    dj = int(round(alpha_rad * img_w / (2.0 * math.pi))) % img_w
   198	    alpha_eff = dj * 2.0 * math.pi / img_w
   199	    rot = azimuth_rotation_matrix(alpha_eff)
   200	
   201	    out: Dict[str, object] = dict(md)
   202	
   203	    if "depth" in md:
   204	        depth = md["depth"]
   205	        assert isinstance(depth, torch.Tensor)
   206	        depth = torch.roll(depth, shifts=dj, dims=2)
   207	        rot_d = rot.to(device=depth.device, dtype=depth.dtype)
   208	        out["depth"] = torch.einsum("ij,jhw->ihw", rot_d, depth)
   209	
   210	    for key in pose_keys:
   211	        if key in md:
   212	            pose = md[key]
   213	            assert isinstance(pose, torch.Tensor)
   214	            rot_p = rot.to(device=pose.device, dtype=pose.dtype)
   215	            out[key] = torch.einsum("ij,...j->...i", rot_p, pose)
   216	
   217	    return out
   218	
