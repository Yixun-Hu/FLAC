   274	def test_rotation_preserves_panorama_consistency():
   275	    # A yaw rotation must map a valid equirectangular panorama to another valid
   276	    # one: at every column the stored azimuth still equals the column azimuth.
   277	    # This holds at 37.3 deg too, because the module quantises to alpha_eff and
   278	    # the roll and the rotation matrix share that same effective angle.
   279	    W = 512
   280	    depth = _consistent_depth(8, W)
   281	    assert _max_azimuth_dev(depth) < 1e-4, "the fixture itself is inconsistent"
   282	    for deg in (90.0, 180.0, 270.0, 37.3):
   283	        out = yr.rotate_scene_metadata({"depth": depth}, math.radians(deg), W)
   284	        dev = _max_azimuth_dev(out["depth"])
   285	        assert dev < 1e-4, f"{deg} deg: azimuth deviation {dev} rad"
