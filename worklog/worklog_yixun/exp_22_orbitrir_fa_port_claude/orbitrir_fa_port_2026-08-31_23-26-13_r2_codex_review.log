   288	def test_wrong_sign_breaks_consistency():
   289	    # Negative control for the test above: compose the WRONG transform by hand
   290	    # (roll forward, but rotate the stored vectors backwards) and check that the
   291	    # consistency measure blows up. Without this, a sign error in the module
   292	    # could hide behind a check that passes for every transform.
   293	    W = 512
   294	    depth = _consistent_depth(8, W)
   295	    alpha = math.radians(90.0)
   296	    dj = int(round(alpha * W / (2.0 * math.pi))) % W
   297	    alpha_eff = dj * 2.0 * math.pi / W
   298	
   299	    rolled = torch.roll(depth, shifts=dj, dims=2)
   300	    rot_wrong = yr.azimuth_rotation_matrix(-alpha_eff)
   301	    wrong = torch.einsum("ij,jhw->ihw", rot_wrong, rolled)
   302	
   303	    assert _max_azimuth_dev(wrong) > 1.0, "a sign error went undetected"
   304	    # ... while the module's own transform, measured the same way, is exact.
   305	    right = yr.rotate_scene_metadata({"depth": depth}, alpha, W)["depth"]
   306	    assert _max_azimuth_dev(right) < 1e-4
