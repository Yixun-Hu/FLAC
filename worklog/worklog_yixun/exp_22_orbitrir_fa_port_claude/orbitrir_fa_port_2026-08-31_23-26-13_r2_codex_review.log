   220	def invariant_conditioning(
   221	    conditioner,
   222	    metadata: "list",
   223	    device,
   224	    angles: Tuple[float, ...] = DEFAULT_FRAME_ANGLES,
   225	    vit_ids: Tuple[str, ...] = ("source_vit", "context_poses_vit"),
   226	) -> Dict[str, object]:
   227	    """
   228	    Compute yaw-symmetrized FLAC conditioning.
   229	
   230	    Two sub-paths are symmetrized independently:
   231	
   232	    1. **Pose path** (``source`` / ``context_poses`` dist-embedders): the absolute
   233	       ``(x, y, z)`` poses are replaced by intrinsically yaw-invariant cylindrical
   234	       features ``(r, z, dphi)`` via :func:`cylindrical_pose_features`. These are
   235	       exactly invariant at *any* yaw angle.
   236	    2. **ViT path** (``vit_ids``, e.g. the DINOv3 depth-panorama conditioners): a
   237	       C4 **frame average** ``(1/|G|) sum_g f(g . x)`` over ``angles``. The depth
   238	       map and the ``*_vit`` pose keys are rotated *together* by each frame angle;
   239	       averaging their conditioner outputs makes the result exactly invariant on
   240	       the panorama-aligned yaw subgroup G.
   241	
   242	    All remaining conditioners (e.g. the ``context_audio`` RIR encoder, which is
   243	    already yaw-invariant and may carry BatchNorm running stats) are run **exactly
   244	    once** — only the ``vit_ids`` conditioners are re-run per frame. The caller's
   245	    ``metadata`` is never mutated (its ``source`` / ``depth`` stay raw for the
   246	    downstream metric callback).
   247	
   248	    Parameters
   249	    ----------
   250	    conditioner : MultiConditioner
   251	        The FLAC conditioner. Must accept ``conditioner(batch, device)`` and the
   252	        optional ``only_ids=`` keyword (to re-run a subset of conditioners).
   253	    metadata : list of dict
   254	        Per-sample metadata dicts. ``depth`` (shape ``[3, H, W]``), the pose keys
   255	        and any conditioner inputs are read but not modified.
   256	    device : torch.device or str
   257	        Device passed through to ``conditioner``.
   258	    angles : Tuple[float, ...], optional
   259	        Frame-average angles in **degrees**; ``angles[0]`` must be ``0.0`` (the
   260	        identity / base pass). Defaults to :data:`DEFAULT_FRAME_ANGLES`.
   261	    vit_ids : Tuple[str, ...], optional
   262	        Conditioning ids whose outputs are frame-averaged (the ViT depth path).
   263	
   264	    Returns
   265	    -------
   266	    Dict[str, object]
   267	        The conditioner output dict ``{id: [tensor, mask]}``; the ``vit_ids``
   268	        tensors are replaced by their frame average, all masks come from the base
   269	        (angle-0) pass, and all other entries are the single base-pass outputs.
   270	
   271	    Raises
   272	    ------
   273	    ValueError
   274	        If ``angles`` is empty or ``angles[0] != 0.0``.
   275	    """
   276	    if len(angles) == 0:
   277	        raise ValueError("angles must be non-empty")
   278	    if angles[0] != 0.0:
   279	        raise ValueError(f"angles[0] must be 0.0 (the identity pass), got {angles[0]}")
   280	
   281	    # 1. cylindrical (yaw-invariant) pose features; never mutates the caller's md.
   282	    md_inv = [cylindrical_pose_features(md) for md in metadata]
   283	
   284	    # 2. single full pass -> all conditioning entries (non-ViT ids run once here).
   285	    base = conditioner(md_inv, device)
   286	
   287	    present = [i for i in vit_ids if i in base]
   288	    if not present or len(angles) == 1 or "depth" not in metadata[0]:
   289	        return base
   290	
   291	    # 3. frame-average ONLY the ViT conditioners over the rotation subgroup.
   292	    img_w = int(metadata[0]["depth"].shape[-1])
   293	    accum = {i: base[i][0].clone() for i in present}
   294	    for g in angles[1:]:
   295	        variants = [
   296	            rotate_scene_metadata(m, math.radians(g), img_w, pose_keys=tuple(present))
   297	            for m in md_inv
   298	        ]
   299	        part = conditioner(variants, device, only_ids=present)
   300	        for i in present:
   301	            accum[i] = accum[i] + part[i][0]
   302	
   303	    for i in present:
   304	        base[i][0] = accum[i] / float(len(angles))
   305	
   306	    return base
   307	
   308	
   309	def dispatch_conditioning(
   310	    conditioner,
   311	    metadata: "list",
   312	    device,
   313	    cond_method: str = "vanilla",
   314	    frame_avg_angles: Optional[Sequence[float]] = None,
   315	) -> Dict[str, object]:
   316	    """
   317	    Compute FLAC conditioning by the requested method.
   318	
   319	    This is the one dispatch point shared by the training wrapper (and, in a
   320	    later commit, the evaluation entry point), so a new conditioning method
   321	    cannot be wired into one site and forgotten in another.
   322	
   323	    Parameters
   324	    ----------
   325	    conditioner : MultiConditioner
   326	        The FLAC conditioner, called as ``conditioner(batch, device)``.
   327	    metadata : list of dict
   328	        Per-sample metadata dicts; never mutated.
   329	    device : torch.device or str
   330	        Device passed through to ``conditioner``.
   331	    cond_method : str, optional
   332	        ``'vanilla'`` (default) for the unchanged single conditioner pass, or
   333	        ``'fa_invariant'`` for the yaw-symmetrized path
   334	        (:func:`invariant_conditioning`).
   335	    frame_avg_angles : Sequence[float], optional
   336	        Frame-average angles in degrees used by ``'fa_invariant'``; ``None``
   337	        (default) means :data:`DEFAULT_FRAME_ANGLES`. Unused by ``'vanilla'``.
   338	
   339	    Returns
   340	    -------
   341	    Dict[str, object]
   342	        The conditioner output dict ``{id: [tensor, mask]}``.
   343	
   344	    Raises
   345	    ------
   346	    ValueError
   347	        If ``cond_method`` is not one of the valid options.
   348	    """
   349	    if cond_method == "fa_invariant":
   350	        angles = (
   351	            tuple(frame_avg_angles) if frame_avg_angles is not None else DEFAULT_FRAME_ANGLES
   352	        )
   353	        return invariant_conditioning(conditioner, metadata, device, angles)
   354	    if cond_method == "vanilla":
   355	        return conditioner(metadata, device)
   356	    raise ValueError(
   357	        f"Unknown cond_method: {cond_method!r}. "
   358	        "Valid options: 'vanilla', 'fa_invariant'."
   359	    )

