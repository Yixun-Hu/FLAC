    25	def wrap_angle(phi):
    26	    """
    27	    Wrap an angle into the half-open interval ``(-pi, pi]``.
    28	
    29	    The interval is closed at ``+pi`` and open at ``-pi``, so an input of exactly
    30	    ``-pi`` maps to ``+pi`` (and ``+pi`` stays ``+pi``). Works elementwise on
    31	    Python floats and on ``torch.Tensor`` inputs alike.
    32	
    33	    Parameters
    34	    ----------
    35	    phi : float or torch.Tensor
    36	        Angle(s) in radians.
    37	
    38	    Returns
    39	    -------
    40	    float or torch.Tensor
    41	        The wrapped angle(s) in ``(-pi, pi]``, same type as the input.
    42	    """
    43	    return math.pi - (math.pi - phi) % (2.0 * math.pi)
    44	
    45	
    46	def cylindrical_pose_features(
    47	    md: Dict[str, object], eps: float = 1e-6
    48	) -> Dict[str, object]:
    49	    """
    50	    Replace absolute pose vectors with yaw-invariant cylindrical features.
    51	
    52	    Each pose ``(x, y, z)`` becomes ``(r, z, dphi)`` where ``r = sqrt(x^2 + y^2)``
    53	    and ``dphi`` is the azimuth measured *relative* to a scene-intrinsic reference
    54	    azimuth. Because every azimuth in a rigidly yaw-rotated scene shifts by the
    55	    same amount, the relative ``dphi`` (and ``r``, ``z``) are invariant under any
    56	    yaw rotation, making these features an exact invariant of the C-infinity yaw
    57	    group.
    58	
    59	    The reference azimuth is the target source's azimuth. If the source lies on
    60	    the vertical axis (``r_s < eps``, azimuth undefined) the reference falls back
    61	    to the azimuth of the largest-``r`` pose among ``{source, context poses}`` --
    62	    still a scene-intrinsic quantity, so invariance is preserved in the fallback.
    63	    If *every* pose is degenerate (largest ``r`` also ``< eps``) every ``dphi``
    64	    is exactly ``0``.
    65	
    66	    Only ``'source'`` and ``'context_poses'`` are transformed; ``'*_vit'`` poses,
    67	    ``'depth'`` and all other keys pass through untouched (same objects). The
    68	    input dict is not mutated: a shallow copy is returned with fresh tensors for
    69	    the replaced keys, preserving each pose tensor's dtype and device.
    70	
    71	    Parameters
    72	    ----------
    73	    md : Dict[str, object]
    74	        One per-sample metadata dict. ``'source'`` (shape ``[3]``) and, optionally,
    75	        ``'context_poses'`` (shape ``[N, 3]``) are read; the last dimension is
    76	        ordered ``(x, y, z)``.
    77	    eps : float, optional
    78	        Radius below which a pose azimuth is treated as undefined (default 1e-6).
    79	
    80	    Returns
    81	    -------
    82	    Dict[str, object]
    83	        A shallow copy of ``md`` with ``'source'`` -> ``(r_s, z_s, 0.0)`` and each
    84	        ``'context_poses'`` row -> ``(r_i, z_i, wrap(phi_i - phi_ref))``.
    85	    """
    86	    out: Dict[str, object] = dict(md)
    87	
    88	    source = md.get("source")
    89	    context = md.get("context_poses")
    90	
    91	    # Candidate poses for the fallback reference azimuth: source + context rows.
    92	    cand_r = []
    93	    cand_phi = []
    94	
    95	    r_s = phi_s = sz = None
    96	    if source is not None:
    97	        assert isinstance(source, torch.Tensor)
    98	        sx, sy, sz = source[..., 0], source[..., 1], source[..., 2]
    99	        r_s = torch.sqrt(sx * sx + sy * sy)
   100	        phi_s = torch.atan2(sy, sx)
   101	        cand_r.append(r_s.reshape(1))
   102	        cand_phi.append(phi_s.reshape(1))
   103	
   104	    r_c = phi_c = cz = None
   105	    if context is not None:
   106	        assert isinstance(context, torch.Tensor)
   107	        cx, cy, cz = context[..., 0], context[..., 1], context[..., 2]
   108	        r_c = torch.sqrt(cx * cx + cy * cy)
   109	        phi_c = torch.atan2(cy, cx)
   110	        cand_r.append(r_c.reshape(-1))
   111	        cand_phi.append(phi_c.reshape(-1))
   112	
   113	    # Reference azimuth: target source, unless degenerate -> largest-r pose.
   114	    # The fallback pose must itself be non-degenerate (its azimuth defined);
   115	    # if even the largest r is < eps the scene is all-degenerate -> dphi == 0.
   116	    phi_ref = None
   117	    if r_s is not None and bool(r_s >= eps):
   118	        phi_ref = phi_s
   119	    elif cand_r:
   120	        all_r = torch.cat(cand_r)
   121	        all_phi = torch.cat(cand_phi)
   122	        max_idx = int(torch.argmax(all_r))
   123	        if bool(all_r[max_idx] >= eps):
   124	            phi_ref = all_phi[max_idx]
   125	
   126	    if source is not None:
   127	        out["source"] = torch.stack([r_s, sz, torch.zeros_like(r_s)])
   128	
   129	    if context is not None:
   130	        if phi_ref is not None:
   131	            dphi = wrap_angle(phi_c - phi_ref)
   132	        else:
   133	            dphi = torch.zeros_like(r_c)
   134	        out["context_poses"] = torch.stack([r_c, cz, dphi], dim=-1)
   135	
   136	    return out
