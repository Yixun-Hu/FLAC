   309	def test_alpha_eff_quantisation():
   310	    # The requested angle is quantised to a whole number of columns and the
   311	    # rotation matrix uses that same quantised angle -- depth and poses must both
   312	    # follow alpha_eff, not the requested alpha.
   313	    W = 512
   314	    alpha = math.radians(37.3)
   315	    dj = int(round(alpha * W / (2.0 * math.pi))) % W
   316	    assert dj == 53 == round(37.3 / 360.0 * W)
   317	    alpha_eff = 53 * 2.0 * math.pi / W
   318	
   319	    md = _make_md(seed=11)
   320	    out = yr.rotate_scene_metadata(md, alpha, W)
   321	    rot = yr.azimuth_rotation_matrix(alpha_eff)
   322	
   323	    expected_depth = torch.einsum("ij,jhw->ihw", rot, torch.roll(md["depth"], 53, dims=2))
   324	    assert torch.allclose(out["depth"], expected_depth, atol=1e-6)
   325	    assert torch.allclose(out["source"], rot @ md["source"], atol=1e-6)
   326	
   327	    # 90 deg is exactly a quarter of the columns -> no quantisation error at all.
   328	    assert int(round(math.radians(90.0) * W / (2.0 * math.pi))) % W == 128
