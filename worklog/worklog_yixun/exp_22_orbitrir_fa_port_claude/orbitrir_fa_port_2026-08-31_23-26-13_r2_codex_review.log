    31	    def __repr__(self):
    32	        rep = 80 * "=" + "\n"
    33	        for i in range(1, len(self.ticks)):
    34	            msg = self.ticks[i][1]
    35	            ellapsed = self.ticks[i][0] - self.ticks[i - 1][0]
    36	            rep += msg + f": {ellapsed*1000:.2f}ms\n"
    37	        rep += 80 * "=" + "\n\n\n"
    38	        return rep
