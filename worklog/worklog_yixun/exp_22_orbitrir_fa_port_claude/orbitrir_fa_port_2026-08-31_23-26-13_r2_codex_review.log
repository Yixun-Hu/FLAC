    28	def _wrap(x):
    29	    """Wrap an angle (Python float or tensor) into ``[-pi, pi)``."""
    30	    return (x + math.pi) % (2.0 * math.pi) - math.pi
    31	
    32	
    33	def _consistent_depth(H: int = 8, W: int = 512) -> torch.Tensor:
    34	    """Build a geometrically consistent equirectangular depth point cloud.
    35	
    36	    At column ``j`` the stored 3D vector's horizontal azimuth equals that
    37	    column's own azimuth ``theta_j = (j + 0.5) * 2*pi / W - pi`` (because
    38	    ``x = d*cos(phi)*cos(theta)`` and ``y = d*cos(phi)*sin(theta)``), so a
    39	    horizontal roll together with a matching rotation of the stored vectors about
    40	    z is an exact symmetry of the map.
    41	    """
    42	    j = torch.arange(W, dtype=torch.float32)
    43	    theta = (j + 0.5) * 2.0 * math.pi / W - math.pi  # [W]
    44	    i = torch.arange(H, dtype=torch.float32)
    45	    el = (i + 0.5) * math.pi / H - math.pi / 2.0  # elevation [H]
    46	    d = 3.0
    47	    theta_g = theta.view(1, W).expand(H, W)
    48	    el_g = el.view(H, 1).expand(H, W)
    49	    x = d * torch.cos(el_g) * torch.cos(theta_g)
    50	    y = d * torch.cos(el_g) * torch.sin(theta_g)
    51	    z = d * torch.sin(el_g)
    52	    return torch.stack([x, y, z], dim=0).contiguous()  # [3, H, W]
    53	
    54	
    55	def _column_azimuth(j, W: int):
    56	    """Azimuth ``theta_j`` of panorama column ``j`` out of ``W``."""
    57	    return (j + 0.5) * 2.0 * math.pi / W - math.pi
    58	
    59	
    60	def _max_azimuth_dev(pc: torch.Tensor) -> float:
    61	    """Largest ``|stored azimuth - column azimuth|`` over a depth map, in radians.
    62	
    63	    Near-vertical pixels (horizontal magnitude below 1e-3) are masked out: their
    64	    azimuth is numerically undefined.
    65	    """
    66	    W = pc.shape[-1]
    67	    theta = _column_azimuth(torch.arange(W, dtype=torch.float32), W).unsqueeze(0)
    68	    x, y = pc[0], pc[1]
    69	    dev = _wrap(torch.atan2(y, x) - theta)
    70	    mask = torch.sqrt(x * x + y * y) > 1e-3
    71	    assert bool(mask.any()), "every pixel was masked out"
    72	    return float(dev[mask].abs().max())
    73	
