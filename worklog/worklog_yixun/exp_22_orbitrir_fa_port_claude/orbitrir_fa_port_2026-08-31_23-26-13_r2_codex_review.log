   234	
   235	        p.tick("setup")
   236	        conditioning = self._compute_conditioning(metadata)
   237	
   238	        # If mask_padding is on, randomly drop the padding masks to allow for learning silence padding
   239	        use_padding_mask = self.mask_padding and random.random() > self.mask_padding_dropout
   240	
   241	        # Check for wrapped padding masks to avoid interpolation error
   242	        first_padding_mask = metadata[0]["padding_mask"]
   243	        if isinstance(first_padding_mask, list) and len(first_padding_mask) == 1:
   244	            padding_masks = torch.stack([md["padding_mask"][0] for md in metadata], dim=0).to(self.device) # Shape (batch_size, sequence_length)
   245	        else:
