    78	    input, with a call counter."""
    79	
    80	    def __init__(self, out_dim: int = 8, name: str = "DistEmbedderConditioner"):
    81	        super().__init__()
    82	        self.name = name
    83	        self.out_dim = out_dim
    84	        self.calls = 0
    85	
    86	    def forward(self, x_list, device=DEV):
    87	        self.calls += 1
    88	        x = torch.stack(x_list, dim=0).to(device)  # [B, 3] or [B, N, 3]
    89	        if x.dim() == 2:
    90	            x = x.unsqueeze(1)  # [B, 1, 3]
    91	        B, N, _ = x.shape
    92	        feat = torch.tanh(x.sum(dim=-1, keepdim=True))  # [B, N, 1]
    93	        out = feat.expand(B, N, self.out_dim).contiguous()
    94	        return [out, torch.ones(B, N, device=device)]
