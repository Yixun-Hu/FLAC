+++ b/src/tests/test_vit_gradient_checkpointing_dinov3.py
@@ -0,0 +1,497 @@
+"""DINOv3-backed integration tests for the opt-in ``gradient_checkpointing`` flag.
+
+Companion to ``test_vit_gradient_checkpointing.py``: that file pins the adapter's
+contract on tiny in-file **stub** backbones (no download, no network, always
+runs); this file proves the SAME contract on the real pretrained geometry
+backbone the project actually trains with, so a change in the encoder's layer
+container, layer signature, or base-class ``__call__`` hook is caught here rather
+than in a training run.
+
+Runs only when the pinned backbone snapshot is already present in the local
+Hugging Face cache; otherwise every test skips (see ``_dinov3_cached``). Nothing
+here reaches the network: the module forces offline Hub resolution before the
+loads (env var at import time, plus the already-imported module constants pinned
+for the duration of the module).
+
+Config provenance: the conditioner stack is built from the IN-TREE model config
+``src/configs/model_configs/FLAC/AR/FLAC_AR.json``. Its ``model.conditioning``
+block is deep-copied, and ``gradient_checkpointing: true`` is injected in memory
+into both ``ViTCoordinates`` entries (ids ``source_vit`` / ``context_poses_vit``)
+for the flag-ON build; the flag-OFF build uses the untouched copy. No JSON is
+ever written. Reading the config this repository ships — rather than one living
+outside the checkout — is deliberate: it exercises the exact conditioning
+topology and the exact pinned backbone id that ship here, and it cannot silently
+degrade into a permanent skip because some external file is absent.
+
+Surfaces under test:
+
+* default/absent: the unmodified in-tree conditioning block leaves every encoder
+  layer UNWRAPPED (no instance ``forward``, no marker) and sets no
+  ``_vit_ckpt_layers`` marker — byte-identical behavior to before the flag.
+* shared backbone: both ``ViTCoordinates`` conditioners hold the SAME backbone
+  object (the factory invariant the frame-averaging path relies on).
+* enabled (structural): every encoder layer's INSTANCE forward is wrapped exactly
+  ONCE despite both conditioners carrying the flag over that one shared backbone
+  (idempotency), with a ``functools.wraps`` chain exactly one deep.
+* enabled (EXECUTION proof): a counting shim around the real
+  ``torch.utils.checkpoint.checkpoint`` observes exactly one invocation per
+  encoder layer during a train-mode grad-enabled conditioner forward (count
+  unchanged by backward — the non-reentrant recompute does not re-enter
+  ``checkpoint``), every call pinned to ``use_reentrant=False``, and ZERO
+  invocations under ``eval()`` or ``torch.no_grad()``. Metadata flags are never
+  trusted; only observed calls count.
+* GRADIENT identity: same weights, same seed, same input, float32 CPU —
+  forward+backward through the flag-ON and flag-OFF stacks gives parameter grads
+  that are ``torch.allclose`` (atol=1e-6, rtol=1e-5) over >100 tensors. The flag
+  changes memory, never numerics.
+* state_dict identity ON vs OFF: identical key list, every tensor
+  ``torch.equal``, identical parameter names and count. The adapter replaces
+  instance forwards only; it registers no modules/params/buffers.
+
+Execution notes: CPU only, float32, batch of 2, one backbone forward per test
+(the conditioner stack is invoked through ``MultiConditioner.forward`` restricted
+to a single ``ViTCoordinates`` id, which is the real production call path). The
+backbone is loaded exactly twice for the whole module (the ``cond_off`` /
+``cond_on`` module-scoped fixtures). The repo-root/``src/tests`` conftest
+prepends the checkout to ``sys.path`` so ``src.*`` resolves here, not to a stale
+installed copy.
+"""
+import copy
+import hashlib
+import json
+import os
+import random
+import sys
+
+# Offline Hub: resolve the pinned backbone strictly from the local cache. Set
+# BEFORE importing any transformers-backed module so ``from_pretrained`` never
+# reaches the network. ``huggingface_hub.constants`` snapshots this env var at
+# ITS import time, so a full-suite run in which an earlier test module already
+# imported transformers would miss it — the ``_offline_hf`` fixture below closes
+# that hole by pinning the already-imported constants for this module.
+os.environ.setdefault("HF_HUB_OFFLINE", "1")
+os.environ.setdefault("TRANSFORMERS_OFFLINE", "1")
+
+import numpy as np
+import pytest
+import torch
+import torch.utils.checkpoint
+from torch import nn
+
+from src.models.conditioners import create_multi_conditioner_from_conditioning_config
+
+SEED = 42
+
+_REPO_ROOT = os.path.dirname(
+    os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+)  # src/tests/ -> src/ -> repo root
+_MODEL_CONFIG = os.path.join(
+    _REPO_ROOT, "src", "configs", "model_configs", "FLAC", "AR", "FLAC_AR.json"
+)
+
+# The pinned backbone is a 12-layer ViT-S/16; the execution proof asserts the
+# observed checkpoint-call count against this depth as well as against the
+# loaded config, so a silently swapped backbone fails loudly.
+EXPECTED_NUM_LAYERS = 12
+
+
+# --------------------------------------------------------------------------------------
+# Config plumbing: everything comes from the in-tree model config.
+# --------------------------------------------------------------------------------------
+
+def _conditioning_block() -> dict:
+    """The ``model.conditioning`` block of the shipped AR model config."""
+    with open(_MODEL_CONFIG) as f:
+        return json.load(f)["model"]["conditioning"]
+
+
+def _vit_entries(conditioning: dict) -> list:
+    return [c for c in conditioning["configs"] if c["type"] == "ViTCoordinates"]
+
+
+def _vit_ids(conditioning: dict) -> list:
+    return [c["id"] for c in _vit_entries(conditioning)]
+
+
+def _backbone_repo_id(conditioning: dict) -> str:
+    """The Hub id the config pins for the geometry backbone."""
+    return _vit_entries(conditioning)[0]["config"]["ViT"]["hf_model_name_or_path"]
+
+
+def _depth_shape(conditioning: dict) -> tuple:
+    """Depth-panorama shape the config demands: (channels, img_h, img_w)."""
+    vit_cfg = _vit_entries(conditioning)[0]["config"]["ViT"]
+    return (int(vit_cfg["ch_dim"]), int(vit_cfg["img_h"]), int(vit_cfg["img_w"]))
+
+
+def _with_gc(conditioning: dict, value: bool = True) -> dict:
+    """Deep-copy the conditioning block and inject ``gradient_checkpointing`` into
+    every ViTCoordinates conditioner config (in-memory only; no JSON is written)."""
+    cfg = copy.deepcopy(conditioning)
+    for c in cfg["configs"]:
+        if c["type"] == "ViTCoordinates":
+            c["config"]["gradient_checkpointing"] = value
+    return cfg
+
+
+# --------------------------------------------------------------------------------------
+# Environment guard: skip (don't error) when the backbone is not cached locally.
+# --------------------------------------------------------------------------------------
+
+def _dinov3_cached() -> bool:
+    """True iff the backbone the in-tree config pins is fully present in the local
+    Hugging Face cache. Purely local: ``local_files_only=True`` makes
+    ``snapshot_download`` resolve from disk and raise instead of contacting the
+    Hub, so this never performs a network request."""
+    try:
+        from huggingface_hub import snapshot_download
+
+        repo_id = _backbone_repo_id(_conditioning_block())
+        snapshot_download(repo_id, local_files_only=True)
+        return True
+    except Exception:
+        return False
+
+
+_needs_dino = pytest.mark.skipif(
+    not _dinov3_cached(),
+    reason="requires the DINOv3 snapshot in the local HF cache",
+)
+
+
+@pytest.fixture(scope="module", autouse=True)
+def _offline_hf():
+    """Pin fully-offline Hub resolution for this module, then undo it.
+
+    The env vars cover a fresh interpreter; pinning the already-imported
+    constants covers a full-suite run where another test module imported
+    transformers (and therefore froze the offline flag) before this one."""
+    mp = pytest.MonkeyPatch()
+    mp.setenv("HF_HUB_OFFLINE", "1")
+    mp.setenv("TRANSFORMERS_OFFLINE", "1")
+    for mod_name, attr in (
+        ("huggingface_hub.constants", "HF_HUB_OFFLINE"),
+        ("transformers.utils.hub", "_is_offline_mode"),
+    ):
+        mod = sys.modules.get(mod_name)
+        if mod is not None and hasattr(mod, attr):
+            mp.setattr(mod, attr, True)
+    try:
+        yield
+    finally:
+        mp.undo()
+
+
+# --------------------------------------------------------------------------------------
+# Helpers
+# --------------------------------------------------------------------------------------
+
+def _build(conditioning_cfg: dict):
+    """Seeded build of the conditioner stack. The backbone weights come from the
+    cached pretrained snapshot (identical every time); the seed pins the randomly
+    initialised projection heads, so two builds share byte-identical weights —
+    which ``test_state_dict_identical_flag_on_vs_off`` verifies independently."""
+    torch.manual_seed(SEED)
+    np.random.seed(SEED)
+    random.seed(SEED)
+    return create_multi_conditioner_from_conditioning_config(copy.deepcopy(conditioning_cfg))
+
+
+def _geometry_conditioners(mc):
+    return [
+        c for c in mc.conditioners.values()
+        if getattr(c, "name", None) == "GeometryConditioner"
+    ]
+
+
+def _shared_vit(mc):
+    geoms = _geometry_conditioners(mc)
+    assert geoms, "no GeometryConditioner in the built stack"
+    return geoms[0].vit
+
+
+def _state_hash(module: nn.Module) -> str:
+    """sha256 over the full state_dict (keys + raw bytes)."""
+    h = hashlib.sha256()
+    sd = module.state_dict()
+    for k in sorted(sd):
+        h.update(k.encode())
+        h.update(sd[k].detach().cpu().contiguous().numpy().tobytes())
+    return h.hexdigest()
+
+
+class _CountingCheckpoint:
+    """Counting shim for ``torch.utils.checkpoint.checkpoint``: records each call's
+    ``use_reentrant`` and delegates to the REAL checkpoint so autograd semantics
+    are exercised, not stubbed."""
+
+    def __init__(self, real):
+        self.real = real
+        self.use_reentrant_seen = []
+
+    def __call__(self, fn, *args, **kwargs):
+        self.use_reentrant_seen.append(kwargs.get("use_reentrant", "ABSENT"))
+        return self.real(fn, *args, **kwargs)
+
+    @property
+    def count(self):
+        return len(self.use_reentrant_seen)
+
+
+@pytest.fixture()
+def counting_checkpoint(monkeypatch):
+    shim = _CountingCheckpoint(torch.utils.checkpoint.checkpoint)
+    monkeypatch.setattr(torch.utils.checkpoint, "checkpoint", shim)
+    return shim
+
+
+def _batch(conditioning: dict, vit_id: str, batch_size: int = 2, seed: int = SEED):
+    """Minimal REAL per-sample metadata dicts, exactly as ``MultiConditioner``
+    consumes them: a 3-vector pose under the ViT conditioner's id plus the shared
+    ``depth`` panorama at the (C, img_h, img_w) the config demands. Depth values
+    are non-negative (metres), poses are small offsets — the conditioner forms
+    ``(pose - depth) / max_value`` and feeds that to the backbone."""
+    channels, img_h, img_w = _depth_shape(conditioning)
+    g = torch.Generator().manual_seed(seed)
+    return [
+        {
+            vit_id: torch.randn(3, generator=g),
+            "depth": torch.rand(channels, img_h, img_w, generator=g) * 5.0,
+        }
+        for _ in range(batch_size)
+    ]
+
+
+def _run_vit_conditioner(mc, conditioning: dict, vit_id: str, seed: int):
+    """One real backbone forward through the production path: ``MultiConditioner``
+    restricted to a single ViTCoordinates id (the same ``only_ids`` route the
+    rotation-frame conditioning uses), so the observed checkpoint-call count is
+    one encoder pass, not two. Seeded because the backbone's rotary position
+    embedding is randomly rescaled in training mode."""
+    batch = _batch(conditioning, vit_id)
+    torch.manual_seed(seed)
+    out = mc(batch, device="cpu", only_ids=[vit_id])
+    return out[vit_id][0]
+
+
+# --------------------------------------------------------------------------------------
+# Heavy fixtures: exactly two full backbone builds, shared across the module.
+# --------------------------------------------------------------------------------------
+
+@pytest.fixture(scope="module")
+def conditioning():
+    return _conditioning_block()
+
+
+@pytest.fixture(scope="module")
+def vit_id(conditioning):
+    ids = _vit_ids(conditioning)
+    assert ids == ["source_vit", "context_poses_vit"], ids
+    return ids[0]
+
+
+@pytest.fixture(scope="module")
+def cond_off(_offline_hf, conditioning):
+    return _build(conditioning)
+
+
+@pytest.fixture(scope="module")
+def cond_on(_offline_hf, conditioning):
+    return _build(_with_gc(conditioning, True))
+
+
+# --------------------------------------------------------------------------------------
+# default / absent -> layers untouched (byte-identical behavior to before the flag)
+# --------------------------------------------------------------------------------------
+
+@_needs_dino
+def test_default_flag_absent_leaves_layers_unwrapped(cond_off):
+    """The unmodified in-tree conditioning block leaves every encoder layer with
+    its plain class forward (no instance-level override, no wrap marker) and sets
+    no ``_vit_ckpt_layers`` marker on the conditioners."""
+    vit = _shared_vit(cond_off)
+    assert len(vit.layer) > 0
+    for layer in vit.layer:
+        assert "forward" not in layer.__dict__
+        assert not getattr(layer, "_flac_ckpt_wrapped", False)
+    for geom in _geometry_conditioners(cond_off):
+        assert getattr(geom, "_vit_ckpt_layers", None) is None
+
+
+@_needs_dino
+def test_conditioners_share_one_backbone(cond_off):
+    """Documents the shared-backbone invariant the factory guarantees: both
+    ViTCoordinates conditioners wrap the SAME backbone object, so the flag on
+    either conditioner checkpoints the one shared encoder."""
+    geoms = _geometry_conditioners(cond_off)
+    assert len(geoms) == 2
+    assert geoms[0].vit is geoms[1].vit
+
+
+# --------------------------------------------------------------------------------------
+# enabled -> structural wiring (each layer wrapped exactly once, marker recorded)
+# --------------------------------------------------------------------------------------
+
+@_needs_dino
+def test_enabled_wraps_every_layer_exactly_once(cond_on):
+    """``gradient_checkpointing: true`` wraps every encoder layer's INSTANCE forward
+    and records the marker; despite BOTH ViTCoordinates conditioners carrying the
+    flag over the one shared backbone, each layer is wrapped exactly once
+    (idempotent), so no double checkpointing."""
+    vit = _shared_vit(cond_on)
+    n_layers = len(vit.layer)
+    assert n_layers > 0
+    for layer in vit.layer:
+        assert "forward" in layer.__dict__, "layer forward not instance-wrapped"
+        assert getattr(layer, "_flac_ckpt_wrapped", False) is True
+        inner = getattr(layer.forward, "__wrapped__", None)
+        assert inner is not None, "wrapper must expose __wrapped__ (functools.wraps)"
+        # exactly one wrap: the wrapped target is the plain bound method, not
+        # another checkpoint wrapper
+        assert getattr(inner, "__wrapped__", None) is None, "layer wrapped twice"
+    for geom in _geometry_conditioners(cond_on):
+        assert geom._vit_ckpt_layers == n_layers
+
+
+# --------------------------------------------------------------------------------------
+# enabled -> EXECUTION proof (checkpoint really runs; metadata is never trusted)
+# --------------------------------------------------------------------------------------
+
+@_needs_dino
+def test_checkpoint_executes_once_per_layer_train_grad(
+    cond_on, conditioning, vit_id, counting_checkpoint
+):
+    """A train-mode, grad-enabled conditioner forward invokes the REAL
+    ``torch.utils.checkpoint.checkpoint`` exactly once per encoder layer, every
+    call pinned to ``use_reentrant=False`` (required for DDP
+    find_unused_parameters); backward then succeeds through the checkpointed graph
+    (every layer's params receive grads) WITHOUT re-entering ``checkpoint`` — the
+    non-reentrant recompute happens inside the saved-tensor hooks."""
+    vit = _shared_vit(cond_on)
+    n_layers = len(vit.layer)
+    assert n_layers == vit.config.num_hidden_layers
+    assert n_layers == EXPECTED_NUM_LAYERS, (
+        f"pinned backbone should have {EXPECTED_NUM_LAYERS} encoder layers, got {n_layers}"
+    )
+    try:
+        cond_on.train()
+        out = _run_vit_conditioner(cond_on, conditioning, vit_id, seed=0)
+        assert counting_checkpoint.count == n_layers, (
+            f"expected {n_layers} checkpoint invocations during forward, "
+            f"saw {counting_checkpoint.count}"
+        )
+        assert all(u is False for u in counting_checkpoint.use_reentrant_seen), (
+            counting_checkpoint.use_reentrant_seen
+        )
+        out.float().pow(2).mean().backward()
+        # backward must not re-enter checkpoint()
+        assert counting_checkpoint.count == n_layers
+        # gradients flowed through every checkpointed layer
+        for i, layer in enumerate(vit.layer):
+            assert any(p.grad is not None for p in layer.parameters()), (
+                f"layer {i} received no gradients through checkpointing"
+            )
+        print(
+            f"\nmeasured checkpoint invocations: {counting_checkpoint.count} "
+            f"(= num layers {n_layers}), use_reentrant pinned False on all calls"
+        )
+    finally:
+        cond_on.zero_grad(set_to_none=True)
+        cond_on.eval()
+
+
+@_needs_dino
+def test_checkpoint_not_invoked_eval_or_no_grad(
+    cond_on, conditioning, vit_id, counting_checkpoint
+):
+    """``eval()`` (grad enabled) and ``train()`` + ``torch.no_grad()`` both bypass
+    checkpointing entirely (zero invocations): inference stays zero-overhead, and
+    the grad gate is load-bearing, not just the training gate."""
+    try:
+        cond_on.eval()
+        _run_vit_conditioner(cond_on, conditioning, vit_id, seed=0)
+        assert counting_checkpoint.count == 0
+
+        cond_on.train()
+        with torch.no_grad():
+            _run_vit_conditioner(cond_on, conditioning, vit_id, seed=0)
+        assert counting_checkpoint.count == 0
+    finally:
+        cond_on.zero_grad(set_to_none=True)
+        cond_on.eval()
+
+
+# --------------------------------------------------------------------------------------
+# GRADIENT identity ON vs OFF (numerics untouched end-to-end, not just at init)
+# --------------------------------------------------------------------------------------
+
+def _param_grads(mc, conditioning: dict, vit_id: str, seed: int = 123):
+    """Seeded conditioner forward+backward; returns {name: grad clone}."""
+    try:
+        mc.train()
+        mc.zero_grad(set_to_none=True)
+        out = _run_vit_conditioner(mc, conditioning, vit_id, seed=seed)
+        out.float().pow(2).mean().backward()
+        return {
+            n: p.grad.detach().clone()
+            for n, p in mc.named_parameters()
+            if p.grad is not None
+        }
+    finally:
+        mc.zero_grad(set_to_none=True)
+        mc.eval()
+
+
+@_needs_dino
+def test_gradient_identity_on_vs_off(cond_off, cond_on, conditioning, vit_id):
+    """Identical weights, identical seed, identical input, float32 CPU: parameter
+    grads with checkpointing ON are ``torch.allclose`` (atol=1e-6, rtol=1e-5) to
+    the plain path. The non-reentrant recompute is deterministic here (no dropout,
+    no stochastic depth, and the randomly rescaled position embedding is computed
+    once outside the checkpointed region), so the flag changes memory, never
+    numerics."""
+    # The comparison is only meaningful if the two stacks carry the same weights.
+    sd_off, sd_on = cond_off.state_dict(), cond_on.state_dict()
+    assert list(sd_off) == list(sd_on)
+    for k in sd_off:
+        assert torch.equal(sd_on[k], sd_off[k]), f"weights differ before backward: {k}"
+
+    grads_off = _param_grads(cond_off, conditioning, vit_id)
+    grads_on = _param_grads(cond_on, conditioning, vit_id)
+    assert set(grads_off) == set(grads_on)
+    assert len(grads_off) > 100, f"suspiciously few grad tensors: {len(grads_off)}"
+    max_diff = 0.0
+    for n in grads_off:
+        assert torch.allclose(grads_on[n], grads_off[n], atol=1e-6, rtol=1e-5), (
+            f"grad mismatch for {n}: max abs diff "
+            f"{(grads_on[n] - grads_off[n]).abs().max().item():.3e}"
+        )
+        max_diff = max(max_diff, (grads_on[n] - grads_off[n]).abs().max().item())
+    print(
+        f"\ngradient-identity max abs diff over {len(grads_off)} tensors: {max_diff:.3e}"
+    )
+
+
+# --------------------------------------------------------------------------------------
+# state_dict identity ON vs OFF
+# --------------------------------------------------------------------------------------
+
+@_needs_dino
+def test_state_dict_identical_flag_on_vs_off(cond_off, cond_on):
+    """Same seed, flag ON vs OFF -> identical state_dict keys AND values, identical
+    parameter names, identical parameter count. The adapter replaces instance
+    forwards only; it registers no modules/params/buffers, so nothing downstream
+    that fingerprints the architecture can notice the flag."""
+    sd_off, sd_on = cond_off.state_dict(), cond_on.state_dict()
+    assert list(sd_off) == list(sd_on)
+    assert len(sd_off) > 0, "conditioner stack exposed no state to compare"
+    for k in sd_off:
+        assert torch.equal(sd_on[k], sd_off[k]), f"value changed for {k}"
+
+    names_off = [n for n, _ in cond_off.named_parameters()]
+    names_on = [n for n, _ in cond_on.named_parameters()]
+    assert names_off == names_on
+    assert sum(p.numel() for p in cond_off.parameters()) == sum(
+        p.numel() for p in cond_on.parameters()
+    )
+    assert _state_hash(cond_on) == _state_hash(cond_off)
