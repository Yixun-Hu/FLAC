   236	class GeometryConditioner(Conditioner):
   237	    def __init__(self, 
   238	                 vit_model, 
   239	                 vit_proj,
   240	                 lin_proj,
   241	                 output_dim: int,
   242	                 max_value: float = 5.0,
   243	                 dim: int = 512,
   244	                 model_type: str = "vit",
   245	                 gradient_checkpointing: bool = False,
   246	                 name="GeometryConditioner"):
   247	        super().__init__(dim, output_dim, project_out=False)
   248	        self.name = name
   249	        self.vit = vit_model
   250	        self.proj_out = vit_proj
   251	        self.lin_proj = lin_proj
   252	        self.max_value = max_value
   253	        self.model_type = model_type    
   254	
   255	        # Opt-in activation checkpointing for the ViT backbone: trades backward-time
   256	        # recompute for a large activation-memory saving with numerically identical
   257	        # weights/gradients (lets the C4 frame-averaging arm fit micro-batch 32 on a
   258	        # 48GB card). Absent/False -> byte-identical to before. Wrapped explicitly at
   259	        # our own call site rather than via HF's gradient_checkpointing_enable() —
   260	        # see _checkpoint_vit_layers for the transformers==4.57.0 rationale.
   261	        if gradient_checkpointing:
   262	            self._vit_ckpt_layers = _checkpoint_vit_layers(self.vit)
   263	
   264	    def forward(self, coord, device: tp.Union[torch.device, str] = "cuda") -> tp.Tuple[torch.Tensor, torch.Tensor]:
   265	        self.vit.to(device)
   266	        self.proj_out.to(device)
   267	
   268	        depth_coords, coords = [], []
   269	        for c in coord:
   270	            coords.append(c['coord'].float().to(device))
   271	            depth_coords.append(c['depth'].float().to(device))
   272	
   273	        coord = torch.stack(coords, dim=0)  # [B, 3] or [B, N, 3]
   274	        if coord.ndim == 2:
   275	            coord = coord.unsqueeze(1) # [B, 1, 3]
   276	        depth_coord = torch.stack(depth_coords, dim=0)
   277	
   278	        encoded_coords = []
   279	        for i in range(coord.shape[1]):
   280	            c = (coord[:, i, :, None, None] - depth_coord) / self.max_value # [B, 3, H, W]
   281	            if self.model_type == 'dino':
   282	                outputs = self.vit(c)
   283	                pooled_output = outputs.pooler_output
   284	                c = self.lin_proj(pooled_output).unsqueeze(1)  # [B, 1, D]
   285	            elif self.model_type == 'vit':
   286	                c = self.vit(c) 
   287	                c = self.proj_out(c) 
   288	                c = self.lin_proj(c.permute(0, 2, 1)).squeeze(-1).unsqueeze(1)  # [B, 1, D]
   289	            else: 
   290	                raise NotImplementedError('model_type must be either "dino" or "vit"')
   291	            encoded_coords.append(c)
   292	        out = torch.cat(encoded_coords, dim=1)  # [B, N, D]
   293	
   294	        return [out, torch.ones(out.shape[0], 1).to(device)]
