   318	        self.dist_embedder_proj = dist_embedder_proj
   319	
   320	    def forward(self, x_input, device: tp.Union[torch.device, str] = "cuda") -> tp.Tuple[torch.Tensor, torch.Tensor]:
   321	        x_input = torch.stack(x_input, dim=0).to(device)
   322	
   323	        if x_input.dim() == 2:
