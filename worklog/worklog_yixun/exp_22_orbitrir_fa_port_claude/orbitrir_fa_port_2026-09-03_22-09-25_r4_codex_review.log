   173	        encoded = self.net(audios) # [batch, 512]
   174	        encoded = encoded.view(B, N, -1)
   175	        out = self.proj_out(encoded)  # [B, N, D]
   176	
   177	        return [out, torch.ones(encoded.shape[0], 1).to(device)]
