   306	                 name: str = "DistEmbedderConditioner", 
   307	                 dist_embedder_proj: tp.Optional[torch.nn.Module] = None):
   308	        
   309	        in_dim = (len(funcs) * num_freqs + (1 if include_in else 0)) * 3
   310	        super().__init__(in_dim, output_dim, project_out=False)
   311	        self.funcs = funcs
   312	        self.num_functions = list(range(len(funcs)))
   313	        self.freqs = torch.nn.Parameter(2.0**torch.from_numpy(np.linspace(start=0.0,stop=max_freq, num=num_freqs).astype(np.single)), requires_grad=False)
   314	        self.ch_dim = ch_dim
