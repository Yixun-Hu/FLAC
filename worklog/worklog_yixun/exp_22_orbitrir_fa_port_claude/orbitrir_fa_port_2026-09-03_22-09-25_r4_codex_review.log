   179	def _make_vit_ckpt_forward(layer: nn.Module, orig_forward):
   180	    """Instance-level forward wrapper applying non-reentrant activation
   181	    checkpointing to one ViT encoder layer. Checkpoints ONLY when the layer is in
   182	    training mode AND grad is enabled; eval/no_grad calls pass through unchanged
   183	    (zero overhead). ``torch.utils.checkpoint.checkpoint`` is resolved by
   184	    attribute at call time so its invocation is observable (and shimmable) in
   185	    tests. ``use_reentrant=False`` is REQUIRED for DDP find_unused_parameters
   186	    compatibility; the non-reentrant path also supports the kwargs DINOv3 layers
   187	    receive (attention_mask, position_embeddings)."""
   188	    @functools.wraps(orig_forward)
   189	    def ckpt_forward(*args, **kwargs):
   190	        if layer.training and torch.is_grad_enabled():
   191	            return torch.utils.checkpoint.checkpoint(
   192	                orig_forward, *args, use_reentrant=False, **kwargs
   193	            )
   194	        return orig_forward(*args, **kwargs)
   195	    return ckpt_forward
   196	
   197	
   198	def _checkpoint_vit_layers(vit: nn.Module) -> int:
   199	    """Wrap every encoder layer of ``vit`` (its ``.layer`` nn.ModuleList) with
   200	    explicit non-reentrant activation checkpointing; returns the number of
   201	    checkpointed layers.
   202	
   203	    This deliberately does not rely on HF's ``gradient_checkpointing_enable()``:
   204	    in transformers 4.57.0, DINOv3 delegates checkpointing to the
   205	    ``GradientCheckpointingLayer.__call__`` base-class hook
   206	    (transformers/modeling_layers.py), whose enable-time ``functools.partial``
   207	    binds ``torch.utils.checkpoint.checkpoint`` opaquely and gates only on
   208	    ``.training`` — invisible to instrumentation and easy to mistake for a no-op
   209	    (``modeling_dinov3_vit.py`` itself never references
   210	    ``_gradient_checkpointing_func``). Checkpointing each layer's forward at OUR
   211	    call site keeps the semantics pinned, additionally gates on
   212	    ``torch.is_grad_enabled()``, and is directly testable.
   213	
   214	    Instance-level forward replacement only: registers no modules/params/buffers,
   215	    so the state_dict stays byte-identical. Idempotent across the two
   216	    ViTCoordinates conditioners that share one backbone (already-wrapped layers
   217	    are skipped — never double-checkpointed). Fail-closed: a backbone without a
   218	    non-empty ``nn.ModuleList`` at ``.layer`` (e.g. the in-repo SimpleViT) raises
   219	    ValueError rather than silently ignoring the request."""
   220	    layers = getattr(vit, "layer", None)
   221	    if not isinstance(layers, nn.ModuleList) or len(layers) == 0:
   222	        raise ValueError(
   223	            "gradient_checkpointing=True was requested for GeometryConditioner, "
   224	            f"but the wrapped ViT backbone ({type(vit).__name__}) has no non-empty "
   225	            "nn.ModuleList at .layer to checkpoint (expected an HF DINOv3-style "
   226	            "encoder). Remove the flag or use a compatible backbone."
   227	        )
   228	    for layer in layers:
   229	        if getattr(layer, "_flac_ckpt_wrapped", False):
   230	            continue
   231	        layer.forward = _make_vit_ckpt_forward(layer, layer.forward)
   232	        layer._flac_ckpt_wrapped = True
   233	    return len(layers)
