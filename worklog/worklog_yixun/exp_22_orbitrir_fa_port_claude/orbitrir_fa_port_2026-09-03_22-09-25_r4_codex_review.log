   343	class MultiConditioner(nn.Module):
   344	    """
   345	    A module that applies multiple conditioners to an input dictionary based on the keys
   346	
   347	    Args:
   348	        conditioners: a dictionary of conditioners with keys corresponding to the keys of the conditioning input dictionary (e.g. "prompt")
   349	        default_keys: a dictionary of default keys to use if the key is not in the input dictionary (e.g. {"prompt_t5": "prompt"})
   350	    """
   351	    def __init__(self, conditioners: tp.Dict[str, Conditioner], default_keys: tp.Dict[str, str] = {}, pre_encoded_keys: tp.List[str] = []):
   352	        super().__init__()
   353	
   354	        self.conditioners = nn.ModuleDict(conditioners)
   355	        self.default_keys = default_keys
   356	        self.pre_encoded_keys = pre_encoded_keys
   357	
   358	    def forward(self, batch_metadata: tp.List[tp.Dict[str, tp.Any]], device: tp.Union[torch.device, str], only_ids: tp.Optional[tp.Iterable[str]] = None) -> tp.Dict[str, tp.Any]:
   359	        # only_ids: when given, run (and return) exactly the conditioners whose id
   360	        # is in this collection; default None keeps the full behaviour unchanged.
   361	        # Used by yaw_rotation.invariant_conditioning to re-run only the ViT
   362	        # conditioners per rotation frame without re-running stateful non-ViT ones.
   363	        output = {}
   364	
   365	        for key, conditioner in self.conditioners.items():
   366	            if only_ids is not None and key not in only_ids:
   367	                continue
   368	            condition_key = key
   369	
   370	            conditioner_inputs = []
   371	
   372	            for x in batch_metadata:
   373	                if condition_key not in x:
   374	                    if condition_key in self.default_keys:
   375	                        condition_key = self.default_keys[condition_key]
   376	                    else:
   377	                        raise ValueError(f"Conditioner key {condition_key} not found in batch metadata")
   378	                
   379	                if conditioner.name == 'GeometryConditioner':
   380	                    add_input = 'depth'
   381	                    if add_input not in x:
   382	                        raise ValueError(f"Conditioner {key} requires depth input, but it is not present in the batch metadata")
   383	                    else:
   384	                        if isinstance(x[condition_key], list) or isinstance(x[condition_key], tuple) and len(x[condition_key]) == 1:
   385	                            coord = x[condition_key][0]
   386	                        else: 
   387	                            coord = x[condition_key]
   388	                    if isinstance(x[add_input], list) or isinstance(x[add_input], tuple) and len(x[add_input]) == 1:
   389	                        conditioner_input = {'coord': coord, 'depth': x[add_input][0]}
   390	                    else:
   391	                        conditioner_input = {'coord': x[condition_key], 'depth': x[add_input]}
   392	
   393	                else:
   394	                    #Unwrap the condition info if it's a single-element list or tuple, this is to support collation functions that wrap everything in a list
   395	                    if isinstance(x[condition_key], list) or isinstance(x[condition_key], tuple) and len(x[condition_key]) == 1:
   396	                        conditioner_input = x[condition_key][0]
   397	                    else:
   398	                        conditioner_input = x[condition_key]
   399	
   400	                conditioner_inputs.append(conditioner_input)
   401	
   402	            if key in self.pre_encoded_keys:
   403	                output[key] = [torch.stack(conditioner_inputs, dim=0).to(device), None]
   404	            else:
   405	                output[key] = conditioner(conditioner_inputs, device=device)
   406	
   407	        return output
   408	    
   409	def create_multi_conditioner_from_conditioning_config(config: tp.Dict[str, tp.Any], pretransform=None) -> MultiConditioner:
   410	    """
   411	    Create a MultiConditioner from a conditioning config dictionary
   412	
   413	    Args:
   414	        config: the conditioning config dictionary
   415	        device: the device to put the conditioners on
   416	    """
   417	    conditioners = {}
   418	    cond_dim = config["cond_dim"]
   419	    
   420	    default_keys = config.get("default_keys", {})
   421	
   422	    pre_encoded_keys = config.get("pre_encoded_keys", [])
   423	
   424	    vit_model = None
   425	    dist_embedder_proj = None
   426	
   427	    for conditioner_info in config["configs"]:
   428	        id = conditioner_info["id"]
   429	        conditioner_type = conditioner_info["type"]
   430	        conditioner_config = {"output_dim": cond_dim}
   431	        conditioner_config.update(conditioner_info["config"])
   432	
   433	        if conditioner_type == "rir":
   434	            conditioners[id] = RIRConditioner(**conditioner_config)
   435	
   436	        elif conditioner_type == "ViTCoordinates":
   437	            if vit_model is None: 
   438	                vit_config = conditioner_config.pop("ViT", {})
   439	
   440	                # DINO Encoder
   441	                if vit_config.get('hf_model_name_or_path', None) is not None:
   442	                    model_name_or_path = vit_config.get('hf_model_name_or_path', None)
   443	
   444	                    # Optional `revision` selects a Hugging Face Hub revision (branch, tag, or
   445	                    # commit hash). Branches and tags may move; use a full commit hash to pin an
   446	                    # immutable snapshot for reproducible training. If omitted, Transformers uses
   447	                    # the repository's default revision (`main`).
   448	                    revision = vit_config.get('revision', None)
   449	                    hf_kwargs = {'revision': revision} if revision else {}
   450	
   451	                    if vit_config.get('from_scratch', False):
   452	                        print(f"Loading ViT model from scratch: {model_name_or_path}...")
   453	                        vit_model = AutoModel.from_config(AutoConfig.from_pretrained(model_name_or_path, **hf_kwargs))
   454	                    else:
   455	                        print(f"Loading ViT model from {model_name_or_path}...")
   456	                        vit_model = AutoModel.from_pretrained(model_name_or_path, **hf_kwargs)
   457	
   458	                    if vit_config.get('freeze', False):
   459	                        print('Freezing ViT model parameters...')
   460	                        for param in vit_model.parameters():
   461	                            param.requires_grad = False
   462	                    
   463	                    if 'convnext' in model_name_or_path:
   464	                        hidden_size = vit_model.config.hidden_sizes[-1]  
   465	                        raise NotImplementedError("ConvNeXt-based conditioners are not currently tested and may require changes")  
   466	                    else:
   467	                        hidden_size = vit_model.config.hidden_size
   468	
   469	                    channels=vit_config.get('ch_dim', 3)
   470	                    assert channels == 3, "Only 3 channels are supported"
   471	                    
   472	                    n_trainable_params = sum(p.numel() for p in vit_model.parameters() if p.requires_grad)
   473	                    n_total_params = sum(p.numel() for p in vit_model.parameters())
   474	                    print(f"{n_trainable_params / 1e6:.2f}M/{n_total_params / 1e6:.2f}M parameters are trainable")
   475	
   476	                    lin_proj = nn.Linear(hidden_size, cond_dim) if cond_dim != hidden_size else nn.Identity()
   477	                    vit_proj = nn.Identity()
   478	                    model_type = 'dino'
   479	
   480	                else: # Simple ViT Encoder (from xRIR)
   481	                    vit_model = SimpleViT(image_size=(vit_config['img_h'],vit_config['img_w']), patch_size=(vit_config['patch_h'], vit_config['patch_w']), dim=512, depth=12, heads=8, mlp_dim=512, channels=vit_config.get('ch_dim', 3))
   482	                    vit_proj = nn.Linear(512, cond_dim) if cond_dim != 512 else nn.Identity() 
   483	                    lin_proj = nn.Linear(256, 1) 
   484	                    model_type = 'vit'
   485	            else:
   486	                conditioner_config.pop("ViT", None)
   487	            conditioners[id] = GeometryConditioner(**conditioner_config, vit_model=vit_model, vit_proj=vit_proj, lin_proj=lin_proj, model_type=model_type)
   488	
   489	        elif conditioner_type == "dist_embedder":
   490	            if dist_embedder_proj is None and not conditioner_config.get("init_cond", False): # share the same projection for all DistEmbedderConditioners
   491	                in_channels = conditioner_config.get('in_channels', 3)
   492	                dist_embedder_proj = nn.Linear((2 * conditioner_config['num_freqs'] + (1 if conditioner_config['include_in'] else 0)) * in_channels, cond_dim)
   493	            conditioner_config.pop('in_channels', None)
   494	            conditioners[id] = DistEmbedderConditioner(**conditioner_config, dist_embedder_proj=dist_embedder_proj)
   495	        
   496	        elif conditioner_type == "pretransform":
   497	            sample_rate = conditioner_config.pop("sample_rate", None)
   498	            assert sample_rate is not None, "Sample rate must be specified for pretransform conditioners"
   499	
   500	            use_model_pretransform = conditioner_config.pop("use_model_pretransform", False)
   501	
   502	            if not use_model_pretransform:
   503	                cond_pretransform = create_pretransform_from_config(conditioner_config.pop("pretransform_config"), sample_rate=sample_rate)
   504	            else:
   505	                assert pretransform is not None, "Model pretransform must be specified for pretransform conditioners"
   506	                cond_pretransform = pretransform
   507	
   508	            if conditioner_config.get("pretransform_ckpt_path", None) is not None:
   509	                cond_pretransform.load_state_dict(load_ckpt_state_dict(conditioner_config.pop("pretransform_ckpt_path")), strict=True)
   510	
   511	            conditioners[id] = PretransformConditioner(cond_pretransform, **conditioner_config)
   512	
   513	        else:
   514	            raise ValueError(f"Unknown conditioner type: {conditioner_type}")
   515	
   516	    return MultiConditioner(conditioners, default_keys=default_keys, pre_encoded_keys=pre_encoded_keys)

