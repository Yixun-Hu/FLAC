   139	class RIRConditioner(Conditioner):
   140	    def __init__(self, 
   141	                 output_dim: int, 
   142	                 in_channels: int = 2,
   143	                 n_fft: int = 511,
   144	                 win_length: int = 248,
   145	                 hop_length: int = 62,
   146	                 project_out: bool = False, 
   147	                 name: str = "RIRConditioner"):
   148	        input_dim = 512 
   149	        super().__init__(input_dim, output_dim, project_out=project_out)
   150	        self.name = name
   151	        self.net = AudioResNet18(in_channels)
   152	        self.stft = torchaudio.transforms.Spectrogram(
   153	            n_fft=n_fft, 
   154	            win_length=win_length, 
   155	            hop_length=hop_length, 
   156	            power=None, 
   157	        )
   158	
   159	    def forward(self, audios: tp.List[torch.Tensor], device: tp.Union[torch.device, str]) -> tp.Tuple[torch.Tensor, torch.Tensor]:
   160	        self.net = self.net.to(device)
   161	        audios = torch.stack(audios, dim=0) # [B, N, C, T]
   162	        audios = audios.to(device)
   163	        if audios.dim() == 3:
   164	            audios = audios.unsqueeze(1)
   165	        B, N, C, T = audios.shape
   166	        audios = audios.view(B * N, C, T)  # [B*N, C, T]
   167	        audios = self.stft(audios)  # [B*N, C, F, T]
   168	
   169	        audios = torch.sqrt(
   170	            torch.clamp((audios.real**2) + (audios.imag**2), min=1e-8)
   171	        )
