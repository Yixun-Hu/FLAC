    25	def _wrap(x):
    26	    """Wrap an angle (Python float or tensor) into ``[-pi, pi)``."""
    27	    return (x + math.pi) % (2.0 * math.pi) - math.pi
    28	
    29	
    30	def _consistent_depth(H: int = 8, W: int = 512) -> torch.Tensor:
    31	    """Build a geometrically consistent equirectangular depth point cloud.
    32	
    33	    At column ``j`` the stored 3D vector's horizontal azimuth equals that
    34	    column's own azimuth ``theta_j = (j + 0.5) * 2*pi / W - pi`` (because
    35	    ``x = d*cos(phi)*cos(theta)`` and ``y = d*cos(phi)*sin(theta)``), so a
    36	    horizontal roll together with a matching rotation of the stored vectors about
    37	    z is an exact symmetry of the map.
    38	    """
    39	    j = torch.arange(W, dtype=torch.float32)
    40	    theta = (j + 0.5) * 2.0 * math.pi / W - math.pi  # [W]
    41	    i = torch.arange(H, dtype=torch.float32)
    42	    el = (i + 0.5) * math.pi / H - math.pi / 2.0  # elevation [H]
    43	    d = 3.0
    44	    theta_g = theta.view(1, W).expand(H, W)
    45	    el_g = el.view(H, 1).expand(H, W)
    46	    x = d * torch.cos(el_g) * torch.cos(theta_g)
    47	    y = d * torch.cos(el_g) * torch.sin(theta_g)
    48	    z = d * torch.sin(el_g)
    49	    return torch.stack([x, y, z], dim=0).contiguous()  # [3, H, W]
    50	
    51	
    52	def _column_azimuth(j, W: int):
    53	    """Azimuth ``theta_j`` of panorama column ``j`` out of ``W``."""
    54	    return (j + 0.5) * 2.0 * math.pi / W - math.pi
    55	
    56	
    57	def _max_azimuth_dev(pc: torch.Tensor) -> float:
    58	    """Largest ``|stored azimuth - column azimuth|`` over a depth map, in radians.
    59	
    60	    Near-vertical pixels (horizontal magnitude below 1e-3) are masked out: their
    61	    azimuth is numerically undefined.
    62	    """
    63	    W = pc.shape[-1]
    64	    theta = _column_azimuth(torch.arange(W, dtype=torch.float32), W).unsqueeze(0)
    65	    x, y = pc[0], pc[1]
    66	    dev = _wrap(torch.atan2(y, x) - theta)
    67	    mask = torch.sqrt(x * x + y * y) > 1e-3
    68	    assert bool(mask.any()), "every pixel was masked out"
    69	    return float(dev[mask].abs().max())
