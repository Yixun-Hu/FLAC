index 0000000..7747101
--- /dev/null
+++ b/src/tests/test_portability.py
@@ -0,0 +1,97 @@
+"""Checks that a plain checkout of this repository is runnable as-is.
+
+Covers the three things that break outside the authors' machine: configs still
+pointing at absolute/placeholder paths, metrics importing a patched copy of
+open_clip off ``sys.path``, and a ViT loader that fights Lightning over device
+placement.
+"""
+import json
+import os
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+FORBIDDEN = ("/path/to", "/home/amandine", "/media/amandine")
+
+
+def _string_leaves(node):
+    if isinstance(node, dict):
+        node = list(node.values())
+    if isinstance(node, list):
+        for value in node:
+            yield from _string_leaves(value)
+    elif isinstance(node, str):
+        yield node
+
+
+def test_configs_parse_and_are_repo_relative():
+    paths = [os.path.join(d, f)
+             for d, _, files in os.walk(os.path.join(REPO_ROOT, "src", "configs"))
+             for f in files if f.endswith(".json")]
+    paths.append(os.path.join(REPO_ROOT, "AGREE", "AGREE", "model_configs", "dinoV3.json"))
+    assert paths, "no config files were discovered"
+    for path in sorted(paths):
+        with open(path) as f:
+            config = json.load(f)  # fails the test if the JSON is malformed
+        for leaf in _string_leaves(config):
+            assert not any(bad in leaf for bad in FORBIDDEN), f"{path}: {leaf!r}"
+            assert not leaf.startswith("FLAC/"), f"{path}: repo-prefixed path {leaf!r}"
+
+
+def test_agree_and_metric_callback_importable():
+    from AGREE.AGREE.factory import get_model_config
+    from AGREE.AGREE.model import AGREE
+    import src.metrics.metric_callback as metric_callback
+
+    assert metric_callback.get_model_config is get_model_config
+    assert metric_callback.CLIP is AGREE
+
+
+class _StubViT(torch.nn.Module):
+    """Stand-in for a Hugging Face backbone: has parameters and a `.config`."""
+
+    def __init__(self, hidden_size=8):
+        super().__init__()
+        self.proj = torch.nn.Linear(hidden_size, hidden_size)
+        self.config = SimpleNamespace(hidden_size=hidden_size)
+
+
+def _load_call(monkeypatch, owner, attr, **vit_overrides):
+    """Build a one-ViT multi-conditioner and return the single (args, kwargs) load call."""
+    from src.models import conditioners
+
+    vit = {"hf_model_name_or_path": "stub/model", "ch_dim": 3, "freeze": False,
+           "from_scratch": False, "img_h": 256, "img_w": 512}
+    vit.update(vit_overrides)
+    calls = []
+
+    def spy(*args, **kwargs):
+        calls.append((args, kwargs))
+        return _StubViT()
+
+    monkeypatch.setattr(getattr(conditioners, owner), attr, spy)
+    # from_scratch only forwards the (already spied) AutoConfig result through this.
+    monkeypatch.setattr(conditioners.AutoModel, "from_config", lambda config: _StubViT())
+    conditioners.create_multi_conditioner_from_conditioning_config({
+        "cond_dim": 256,
+        "configs": [{"id": "source_vit", "type": "ViTCoordinates",
+                     "config": {"ViT": vit, "max_value": 1}}],
+    })
+    assert len(calls) == 1, f"expected exactly one load call, got {len(calls)}"
+    return calls[0]
+
+
+@pytest.mark.parametrize("owner, attr, branch", [
+    ("AutoModel", "from_pretrained", {}),
+    ("AutoConfig", "from_pretrained", {"from_scratch": True}),
+])
+def test_vit_loader_revision_and_no_device_map(monkeypatch, owner, attr, branch):
+    args, kwargs = _load_call(monkeypatch, owner, attr, revision="deadbeef", **branch)
+    assert args == ("stub/model",)
+    assert "device_map" not in kwargs
+    assert kwargs == {"revision": "deadbeef"}
+
+    args, kwargs = _load_call(monkeypatch, owner, attr, **branch)
+    assert (args, kwargs) == (("stub/model",), {})
