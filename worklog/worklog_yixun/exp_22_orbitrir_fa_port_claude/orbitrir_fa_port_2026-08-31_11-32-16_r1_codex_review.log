     1	"""Physically-consistent azimuthal (yaw) rotation of FLAC scene conditioning.
     2	
     3	For a mono room impulse response, rigidly rotating the whole scene (room geometry
     4	+ source + listener) about the vertical axis leaves the ground-truth RIR unchanged.
     5	This module applies that rotation to the *conditioning* metadata only: the
     6	equirectangular depth panorama (a horizontal circular roll together with a rotation
     7	of its stored per-pixel 3D vectors) and the source/context pose vectors (a rotation
     8	about z). ``context_audio`` (the reference RIR waveforms) and the target RIR are
     9	yaw-invariant and are intentionally left untouched.
    10	
    11	Used by ``eval_FLAC.py`` (via its optional ``--rotate-deg`` flag).
    12	"""
    13	import math
    14	from typing import Dict, Tuple
    15	
    16	import torch
    17	
    18	POSE_KEYS: Tuple[str, ...] = ("source", "source_vit", "context_poses", "context_poses_vit")
    19	
    20	
    21	def azimuth_rotation_matrix(alpha_rad: float) -> torch.Tensor:
    22	    """
    23	    Build a 3x3 rotation matrix about the vertical (z) axis.
    24	
    25	    Parameters
    26	    ----------
    27	    alpha_rad : float
    28	        Rotation angle in radians. Positive values rotate the (x, y) plane
    29	        counter-clockwise, which corresponds to increasing azimuth.
    30	
    31	    Returns
    32	    -------
    33	    torch.Tensor
    34	        A ``[3, 3]`` float32 rotation matrix leaving the z component unchanged.
    35	    """
    36	    c = math.cos(alpha_rad)
    37	    s = math.sin(alpha_rad)
    38	    return torch.tensor([[c, -s, 0.0], [s, c, 0.0], [0.0, 0.0, 1.0]], dtype=torch.float32)
    39	
    40	
    41	def rotate_scene_metadata(
    42	    md: Dict[str, object],
    43	    alpha_rad: float,
    44	    img_w: int,
    45	    pose_keys: Tuple[str, ...] = POSE_KEYS,
    46	) -> Dict[str, object]:
    47	    """
    48	    Apply a physically-consistent yaw rotation to a single sample's metadata.
    49	
    50	    The equirectangular depth map is rolled horizontally by the integer number of
    51	    columns closest to ``alpha_rad`` and its stored per-pixel 3D vectors are rotated
    52	    about z. All pose vectors are rotated about z by the same effective angle.
    53	    ``context_audio``, ``scene`` and any other field pass through unchanged. The
    54	    rotation is exact (no interpolation) because the column shift is quantised and
    55	    the rotation matrix uses the matching effective angle.
    56	
    57	    Parameters
    58	    ----------
    59	    md : Dict[str, object]
    60	        One per-sample metadata dict as produced by the AR/HAA metadata module.
    61	        Expected tensor fields: ``depth`` of shape ``[3, H, W]`` and pose fields
    62	        (``source``, ``source_vit``, ``context_poses``, ``context_poses_vit``)
    63	        whose last dimension is 3.
    64	    alpha_rad : float
    65	        Requested yaw rotation angle in radians.
    66	    img_w : int
    67	        Panorama width in pixels (number of azimuth columns), e.g. 512.
    68	    pose_keys : Tuple[str, ...], optional
    69	        Which pose fields to rotate. Defaults to rotating all of ``POSE_KEYS``.
    70	        Restricting it (e.g. to the ``*_vit`` keys only) leaves the unlisted pose
    71	        fields bit-identical; ``depth`` handling is unaffected.
    72	
    73	    Returns
    74	    -------
    75	    Dict[str, object]
    76	        A shallow-copied metadata dict with ``depth`` and the selected pose fields
    77	        replaced by their rotated versions. The original dict is not mutated.
    78	    """
    79	    dj = int(round(alpha_rad * img_w / (2.0 * math.pi))) % img_w
    80	    alpha_eff = dj * 2.0 * math.pi / img_w
    81	    rot = azimuth_rotation_matrix(alpha_eff)
    82	
    83	    out: Dict[str, object] = dict(md)
    84	
    85	    if "depth" in md:
    86	        depth = md["depth"]
    87	        assert isinstance(depth, torch.Tensor)
    88	        depth = torch.roll(depth, shifts=dj, dims=2)
    89	        rot_d = rot.to(device=depth.device, dtype=depth.dtype)
    90	        out["depth"] = torch.einsum("ij,jhw->ihw", rot_d, depth)
    91	
    92	    for key in pose_keys:
    93	        if key in md:
    94	            pose = md[key]
    95	            assert isinstance(pose, torch.Tensor)
    96	            rot_p = rot.to(device=pose.device, dtype=pose.dtype)
    97	            out[key] = torch.einsum("ij,...j->...i", rot_p, pose)
    98	
    99	    return out

