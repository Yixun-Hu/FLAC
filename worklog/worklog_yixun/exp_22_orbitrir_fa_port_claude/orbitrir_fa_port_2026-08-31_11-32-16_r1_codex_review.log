    34	
    35	    training_config = model_config.get('training', None)
    36	    
    37	    # Load ckpt
    38	    ckpt = torch.load(ckpt_path, map_location='cpu')
    39	    state_dict = ckpt['state_dict']
    40	    for key in list(state_dict.keys()):
    41	        if key.startswith('diffusion.'):
    42	            new_key = key.replace('diffusion.', '')
    43	            state_dict[new_key] = state_dict.pop(key)
    44	    
    45	    # Use EMA weights if available
    46	    if training_config.get("use_ema", False) and any(k.startswith('diffusion_ema.ema_model.') for k in state_dict.keys()):
    47	        print('Using EMA model')
    48	        for key in list(state_dict.keys()):
    49	            if key.startswith('diffusion_ema.ema_model.'):
    50	                new_key = key.replace('diffusion_ema.ema_model.', 'model.')
    51	                state_dict[new_key] = state_dict.pop(key)
    52	        training_config['use_ema'] = False
    53	
    54	    # Build model
    55	    model = create_model_from_config(model_config)
    56	    model.load_state_dict(state_dict, strict=False)
    57	
    58	    model_type = model_config.get('model_type', None)
    59	    assert model_type is not None, 'model_type must be specified in model config'
    60	
    61	    model_config['training'] = training_config
    62	    module = create_training_wrapper_from_config(model_config, model)
    63	    module.eval().requires_grad_(False)
    64	    module.to(device)
    65	    
    66	    with torch.amp.autocast(device):
    67	        model = module.diffusion.model
    68	
    69	    if module.diffusion.pretransform is not None:
    70	            samples = model_config["sample_size"] // module.diffusion.pretransform.downsampling_ratio
    71	    else: 
    72	        samples = model_config["sample_size"]
    73	    
    74	    # Fix seed
    75	    if isinstance(seed, str):
    76	        seed = int(seed)
    77	    pl.seed_everything(seed, workers=True)
    78	
    79	    # Dataloader Eval
    80	    with open(dataset_config_path) as f:
    81	        dataset_config = json.load(f)
    82	
    83	    eval_dl = create_dataloader_from_config(
    84	        dataset_config,
    85	        batch_size=batch_size,
    86	        num_workers=num_workers,
    87	        sample_rate=model_config["sample_rate"],
    88	        sample_size=model_config["sample_size"],
    89	        audio_channels=model_config.get("audio_channels", 1),
    90	        shuffle=False
    91	    )
    92	
    93	    # Metrics 
    94	    metric_callback = create_metric_callback_from_config(model_config, dataset_id=dataset_config['datasets'][0]['id'])
    95	
    96	    # Eval
    97	    c=0
    98	    if store_predictions:
    99	        decoded_samples = []
   100	
   101	    with torch.no_grad():
   102	        for batch in tqdm(eval_dl, desc="Evaluating"):
   103	            reals, metadata = batch
   104	            reals = reals.to(device)
   105	
   106	            # Optional yaw-rotation diagnostic: physically rotate the conditioning
   107	            # (depth panorama + source/context poses) while leaving context_audio
   108	            # and the target RIR fixed. See src/data/yaw_rotation.py.
   109	            if rotate_deg != 0.0:
   110	                alpha_rad = math.radians(rotate_deg)
   111	                img_w = int(metadata[0]["depth"].shape[-1])
   112	                metadata = [rotate_scene_metadata(md, alpha_rad, img_w) for md in metadata]
   113	
   114	            with torch.amp.autocast(device):
   115	                conditioning = module.diffusion.conditioner(metadata, module.device)
   116	            cond_inputs = module.diffusion.get_conditioning_inputs(conditioning) 
   117	
   118	            noise = torch.randn([reals.shape[0], module.diffusion.io_channels, samples]).to(module.device)
   119	
   120	            if hasattr(model, "diffusion_objective"):
   121	                objective = model.diffusion_objective
   122	            else:
   123	                objective = getattr(model, "objective", "rectified_flow")
   124	
   125	            if objective == "v":
   126	                from src.inference.sampling import sample
   127	                fakes = sample(model, noise, steps, 0, **cond_inputs, cfg_scale=cfg_scale, dist_shift=module.diffusion.dist_shift, batch_cfg=True)
   128	            elif objective == "rectified_flow":
   129	                from src.inference.sampling import sample_discrete_euler
   130	                fakes = sample_discrete_euler(model, noise, steps, **cond_inputs, cfg_scale=cfg_scale, dist_shift=module.diffusion.dist_shift, batch_cfg=True, disable_tqdm=True)
   131	            elif objective == "rf_denoiser":
   132	                from src.inference.sampling import sample_flow_pingpong
   133	                logsnr = torch.linspace(-6, 2, steps+1).to(module.device)
   134	                sigmas = torch.sigmoid(-logsnr)
   135	                sigmas[0] = 1.0
   136	                sigmas[-1] = 0.0
   137	                fakes = sample_flow_pingpong(model, noise, sigmas=sigmas, **cond_inputs, cfg_scale=cfg_scale, dist_shift=module.diffusion.dist_shift, batch_cfg=True, disable_tqdm=True)
   138	            else:
   139	                raise ValueError(f"Unknown diffusion objective: {objective}")
   140	
   141	            # Decode 
   142	            if module.diffusion.pretransform is not None:
   143	                fakes = module.diffusion.pretransform.decode(fakes)
   144	            
   145	            if store_predictions:
   146	                decoded_samples.append(fakes.cpu())
   147	            
   148	            # Clamp and pad if necessary
   149	            fakes = fakes.clamp(-1.0, 1.0) 
   150	            if fakes.shape != reals.shape:
   151	                if fakes.shape[-1] < reals.shape[-1]:
   152	                    fakes = torch.nn.functional.pad(fakes, (0, reals.shape[-1] - fakes.shape[-1]))
   153	                else:
   154	                    reals = torch.nn.functional.pad(reals, (0, fakes.shape[-1] - reals.shape[-1]))
   155	    
   156	            # Compute metrics
   157	            scene_list = [md["scene"] for md in metadata]
   158	            depth_list = [md["depth"] if 'depth' in md else None for md in metadata]
   159	            query_list = [md["source"] if 'source' in md else None for md in metadata]
   160	            depthMinusSource_list = [(d[:3, :, :] - source_pose[:, None, None]).unsqueeze(0).float().to(device) for d, source_pose in zip(depth_list, query_list)]
   161	            metric_callback.update_metrics("test", fakes, reals, scene_list, depth=depthMinusSource_list)
   162	            c += reals.shape[0]
   163	    
   164	
   165	    # Compute and print metrics
   166	    metrics_dict = metric_callback.compute_metrics("test")
   167	    for metric_name, metric_value in metrics_dict.items():
   168	        if metric_name == 'T60' or 'to' in metric_name:
   169	            metric_name += ' (%)'
   170	        elif metric_name == 'EDT':
   171	            metric_name += ' (ms)'
   172	        elif metric_name == 'C50':
   173	            metric_name += ' (dB)'
   174	        print('Test/' + metric_name, metric_value)
   175	    
   176	    # Save metrics in a file 
   177	    metrics_to_save = {
   178	        "metrics": metrics_dict,
   179	        "ckpt_path": ckpt_path,
   180	        "rotate_deg": rotate_deg,
   181	    }
   182	        
   183	    ckpt_name = os.path.basename(ckpt_path).replace('.ckpt', '')
   184	    rot_suffix = '' if rotate_deg == 0.0 else f'_rot{int(rotate_deg)}'
   185	    path2save = os.path.join(os.path.dirname(ckpt_path), ckpt_name + '_metrics_' + str(steps) + '_' + str(cfg_scale) + '_' + eval_name + rot_suffix + '.json')
   186	    with open(path2save, 'w') as f:
   187	        json.dump(metrics_to_save, f, indent=4)
   188	    
   189	    print(f"Metrics saved to {path2save}")
   190	
   191	    if store_predictions:
   192	        decoded_samples_all = torch.cat(decoded_samples, dim=0) 
   193	        path2save_preds = os.path.join(os.path.dirname(ckpt_path), ckpt_name + '_predictions_' + str(steps) + '_' + str(cfg_scale) + '_' + eval_name + '.pt')
   194	        torch.save(decoded_samples_all, path2save_preds)
   195	        print(f"Decoded samples saved to {path2save_preds}")
   196	
   197	    print("Evaluation complete!")
   198	    return
