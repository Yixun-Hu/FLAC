new file mode 100644
index 0000000..bdfdc28
--- /dev/null
+++ b/src/tests/test_yaw_symmetry.py
@@ -0,0 +1,226 @@
+"""Tests for the yaw-rotation helpers in ``src.data.yaw_rotation``.
+
+Covers:
+- ``rotate_scene_metadata``'s ``pose_keys`` parameter: the default rotates every
+  key of ``POSE_KEYS``, while a restricted tuple leaves the unlisted pose fields
+  bit-identical.
+- Physical consistency of the rotation: rolling the equirectangular depth
+  panorama and rotating its stored 3D vectors must leave every column's stored
+  azimuth equal to that column's own azimuth. A hand-built wrong-sign variant is
+  the negative control that proves the check has teeth.
+- Column quantisation of the effective angle, pose/depth co-rotation, and the
+  non-mutating contract of ``rotate_scene_metadata``.
+"""
+import copy
+import math
+
+import torch
+
+from src.data import yaw_rotation as yr
+
+
+# --------------------------------------------------------------------------- #
+# helpers
+# --------------------------------------------------------------------------- #
+def _wrap(x):
+    """Wrap an angle (Python float or tensor) into ``[-pi, pi)``."""
+    return (x + math.pi) % (2.0 * math.pi) - math.pi
+
+
+def _consistent_depth(H: int = 8, W: int = 512) -> torch.Tensor:
+    """Build a geometrically consistent equirectangular depth point cloud.
+
+    At column ``j`` the stored 3D vector's horizontal azimuth equals that
+    column's own azimuth ``theta_j = (j + 0.5) * 2*pi / W - pi`` (because
+    ``x = d*cos(phi)*cos(theta)`` and ``y = d*cos(phi)*sin(theta)``), so a
+    horizontal roll together with a matching rotation of the stored vectors about
+    z is an exact symmetry of the map.
+    """
+    j = torch.arange(W, dtype=torch.float32)
+    theta = (j + 0.5) * 2.0 * math.pi / W - math.pi  # [W]
+    i = torch.arange(H, dtype=torch.float32)
+    el = (i + 0.5) * math.pi / H - math.pi / 2.0  # elevation [H]
+    d = 3.0
+    theta_g = theta.view(1, W).expand(H, W)
+    el_g = el.view(H, 1).expand(H, W)
+    x = d * torch.cos(el_g) * torch.cos(theta_g)
+    y = d * torch.cos(el_g) * torch.sin(theta_g)
+    z = d * torch.sin(el_g)
+    return torch.stack([x, y, z], dim=0).contiguous()  # [3, H, W]
+
+
+def _column_azimuth(j, W: int):
+    """Azimuth ``theta_j`` of panorama column ``j`` out of ``W``."""
+    return (j + 0.5) * 2.0 * math.pi / W - math.pi
+
+
+def _max_azimuth_dev(pc: torch.Tensor) -> float:
+    """Largest ``|stored azimuth - column azimuth|`` over a depth map, in radians.
+
+    Near-vertical pixels (horizontal magnitude below 1e-3) are masked out: their
+    azimuth is numerically undefined.
+    """
+    W = pc.shape[-1]
+    theta = _column_azimuth(torch.arange(W, dtype=torch.float32), W).unsqueeze(0)
+    x, y = pc[0], pc[1]
+    dev = _wrap(torch.atan2(y, x) - theta)
+    mask = torch.sqrt(x * x + y * y) > 1e-3
+    assert bool(mask.any()), "every pixel was masked out"
+    return float(dev[mask].abs().max())
+
+
+def _make_md(seed: int = 0, source=None) -> dict:
+    g = torch.Generator().manual_seed(seed)
+    if source is None:
+        source = torch.randn(3, generator=g)
+    else:
+        source = torch.as_tensor(source, dtype=torch.float32)
+    return {
+        "source": source,
+        "source_vit": torch.randn(1, 3, generator=g),
+        "context_poses": torch.randn(4, 3, generator=g),
+        "context_poses_vit": torch.randn(4, 3, generator=g),
+        "depth": _consistent_depth(8, 512),
+    }
+
+
+# --------------------------------------------------------------------------- #
+# rotate_scene_metadata pose_keys param
+# --------------------------------------------------------------------------- #
+def test_rotate_pose_keys_default():
+    md = _make_md(seed=5)
+    alpha = math.pi / 2.0  # 90 deg == 128 columns of W=512 -> exact
+    out = yr.rotate_scene_metadata(md, alpha, 512)
+    rot = yr.azimuth_rotation_matrix(alpha)
+    for key in yr.POSE_KEYS:
+        expected = torch.einsum("ij,...j->...i", rot.to(md[key].dtype), md[key])
+        assert torch.allclose(out[key], expected, atol=1e-6), f"{key} mismatch"
+    # depth is rotated (rolled + rotated), so it must differ from the input.
+    assert not torch.equal(out["depth"], md["depth"])
+
+
+def test_rotate_pose_keys_restricted():
+    md = _make_md(seed=6)
+    alpha = math.pi / 2.0
+    out = yr.rotate_scene_metadata(
+        md, alpha, 512, pose_keys=("source_vit", "context_poses_vit")
+    )
+    rot = yr.azimuth_rotation_matrix(alpha)
+    # non-listed pose keys pass through bit-identical.
+    assert torch.equal(out["source"], md["source"])
+    assert torch.equal(out["context_poses"], md["context_poses"])
+    # listed *_vit keys are rotated.
+    for key in ("source_vit", "context_poses_vit"):
+        expected = torch.einsum("ij,...j->...i", rot.to(md[key].dtype), md[key])
+        assert torch.allclose(out[key], expected, atol=1e-6), f"{key} mismatch"
+    # depth handling is unchanged -> still rotated.
+    assert not torch.equal(out["depth"], md["depth"])
+
+
+# --------------------------------------------------------------------------- #
+# physical consistency of the rotation
+# --------------------------------------------------------------------------- #
+def test_rotation_preserves_panorama_consistency():
+    # A yaw rotation must map a valid equirectangular panorama to another valid
+    # one: at every column the stored azimuth still equals the column azimuth.
+    # This holds at 37.3 deg too, because the module quantises to alpha_eff and
+    # the roll and the rotation matrix share that same effective angle.
+    W = 512
+    depth = _consistent_depth(8, W)
+    assert _max_azimuth_dev(depth) < 1e-4, "the fixture itself is inconsistent"
+    for deg in (90.0, 180.0, 270.0, 37.3):
+        out = yr.rotate_scene_metadata({"depth": depth}, math.radians(deg), W)
+        dev = _max_azimuth_dev(out["depth"])
+        assert dev < 1e-4, f"{deg} deg: azimuth deviation {dev} rad"
+
+
+def test_wrong_sign_breaks_consistency():
+    # Negative control for the test above: compose the WRONG transform by hand
+    # (roll forward, but rotate the stored vectors backwards) and check that the
+    # consistency measure blows up. Without this, a sign error in the module
+    # could hide behind a check that passes for every transform.
+    W = 512
+    depth = _consistent_depth(8, W)
+    alpha = math.radians(90.0)
+    dj = int(round(alpha * W / (2.0 * math.pi))) % W
+    alpha_eff = dj * 2.0 * math.pi / W
+
+    rolled = torch.roll(depth, shifts=dj, dims=2)
+    rot_wrong = yr.azimuth_rotation_matrix(-alpha_eff)
+    wrong = torch.einsum("ij,jhw->ihw", rot_wrong, rolled)
+
+    assert _max_azimuth_dev(wrong) > 1.0, "a sign error went undetected"
+    # ... while the module's own transform, measured the same way, is exact.
+    right = yr.rotate_scene_metadata({"depth": depth}, alpha, W)["depth"]
+    assert _max_azimuth_dev(right) < 1e-4
+
+
+def test_alpha_eff_quantisation():
+    # The requested angle is quantised to a whole number of columns and the
+    # rotation matrix uses that same quantised angle -- depth and poses must both
+    # follow alpha_eff, not the requested alpha.
+    W = 512
+    alpha = math.radians(37.3)
+    dj = int(round(alpha * W / (2.0 * math.pi))) % W
+    assert dj == 53 == round(37.3 / 360.0 * W)
+    alpha_eff = 53 * 2.0 * math.pi / W
+
+    md = _make_md(seed=11)
+    out = yr.rotate_scene_metadata(md, alpha, W)
+    rot = yr.azimuth_rotation_matrix(alpha_eff)
+
+    expected_depth = torch.einsum("ij,jhw->ihw", rot, torch.roll(md["depth"], 53, dims=2))
+    assert torch.allclose(out["depth"], expected_depth, atol=1e-6)
+    assert torch.allclose(out["source"], rot @ md["source"], atol=1e-6)
+
+    # 90 deg is exactly a quarter of the columns -> no quantisation error at all.
+    assert int(round(math.radians(90.0) * W / (2.0 * math.pi))) % W == 128
+
+
+def test_pose_depth_corotation():
+    # A pose sitting on the sight-line of column j must land on the sight-line of
+    # column j + dj, i.e. exactly where that depth column was rolled to.
+    W = 512
+    j = 100
+    theta_j = _column_azimuth(j, W)
+    md = {
+        "source": torch.tensor([math.cos(theta_j), math.sin(theta_j), 0.0]),
+        "depth": _consistent_depth(8, W),
+    }
+    alpha = math.radians(90.0)
+    dj = int(round(alpha * W / (2.0 * math.pi))) % W
+    out = yr.rotate_scene_metadata(md, alpha, W)
+
+    az = math.atan2(float(out["source"][1]), float(out["source"][0]))
+    assert abs(_wrap(az - _column_azimuth((j + dj) % W, W))) < 1e-5
+
+    # and the depth column itself did move to (j + dj) % W.
+    rot = yr.azimuth_rotation_matrix(dj * 2.0 * math.pi / W)
+    moved = torch.einsum("ij,jh->ih", rot, md["depth"][:, :, j])
+    assert torch.allclose(out["depth"][:, :, (j + dj) % W], moved, atol=1e-6)
+
+
+def test_rotate_does_not_mutate_input():
+    md = _make_md(seed=9)
+    md["scene"] = "room7"
+    md["context_audio"] = torch.randn(4, 1, 16, generator=torch.Generator().manual_seed(9))
+    md_ref = copy.deepcopy(md)
+
+    out = yr.rotate_scene_metadata(md, math.radians(90.0), 512)
+
+    # every input tensor is bit-identical to its pre-call copy.
+    for key, ref in md_ref.items():
+        if isinstance(ref, torch.Tensor):
+            assert torch.equal(md[key], ref), f"{key} was mutated"
+        else:
+            assert md[key] == ref, f"{key} was mutated"
+
+    # a fresh dict, with fresh tensors for the rotated keys.
+    assert out is not md
+    for key in ("depth",) + yr.POSE_KEYS:
+        assert out[key] is not md[key], f"{key} was replaced in place"
+
+    # untouched keys pass through as the SAME objects, unrotated.
+    assert out["scene"] is md["scene"]
+    assert out["context_audio"] is md["context_audio"]
+    assert torch.equal(out["context_audio"], md_ref["context_audio"])

