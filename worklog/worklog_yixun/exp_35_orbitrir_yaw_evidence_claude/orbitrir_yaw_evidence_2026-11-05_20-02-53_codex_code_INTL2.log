    69	say() { printf '%s\n' "$*"; }
    70	rec() {   # <title> <command...>: the command, its output, its rc (recorded, never judged)
    71	  say ""; say "### $1"; shift; printf '$'; printf ' %q' "$@"; printf '\n'; "$@" 2>&1; say "(rc $?)"
    72	}
    73	need() {  # <what> <command...>: a hard check
    74	  local what="$1"; shift
    75	  if "$@" >/dev/null 2>&1; then say "CHECK OK: $what"; else say "CHECK FAILED: $what"; FAIL=1; fi
    76	}
    77	sha() { sha256sum < "$1" 2>/dev/null | cut -c1-64; }
    78	eq() { [ "$1" = "$2" ]; }
    79	procs_named() {   # PIDs other than this script with an argv element whose basename is exactly $1 (no pgrep: no self-match)
    80	  local d pid a; local -a argv
    81	  for d in /proc/[0-9]*; do
    82	    pid=${d#/proc/}; [ "$pid" = "$$" ] && continue
    83	    { mapfile -d '' argv < "$d/cmdline"; } 2>/dev/null || continue
    84	    for a in "${argv[@]}"; do [ "${a##*/}" = "$1" ] && { say "$pid"; break; }; done
    85	  done
    86	  return 0
    87	}
    88	procs_glob() {    # the same, for a basename glob
    89	  local d pid a; local -a argv
    90	  for d in /proc/[0-9]*; do
    91	    pid=${d#/proc/}; [ "$pid" = "$$" ] && continue
    92	    { mapfile -d '' argv < "$d/cmdline"; } 2>/dev/null || continue
    93	    for a in "${argv[@]}"; do [[ "${a##*/}" == $1 ]] && { say "$pid"; break; }; done
    94	  done
    95	  return 0
    96	}
