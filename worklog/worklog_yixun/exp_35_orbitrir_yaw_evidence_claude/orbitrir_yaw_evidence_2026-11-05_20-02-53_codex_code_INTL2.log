   152	  need "pip freeze ${PIN_PIP:0:8}… (the plan's environment)" eq "$("$PY" -B -m pip freeze 2>/dev/null | sha256sum | cut -c1-64)" "$PIN_PIP"
   153	  need "s44 status line (§13 B1)" grep -qx $'ACEattn\t44\t0\t/home/yixunhu/codespace/flac-fork-attn/outputs_FLAC/exp30_ACEattn_s44/epoch=8-step=40000.ckpt' "$QSTATUS"
