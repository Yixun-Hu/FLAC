   196	  ladder_checks "$draft"
   197	  rec "git status of the run worktree (untracked shown)" git -C "$RUN" status --short
   198	  rec "§8: the evaluator closure since d6ca307a" git -C "$RUN" diff --stat d6ca307a "$H35" -- eval_FLAC.py src ':(exclude)src/tests' data/AR
   199	  need "§8: only src/localization/* changed since d6ca307a" eq "$(git -C "$RUN" diff --name-only d6ca307a "$H35" -- \
   200	    eval_FLAC.py src ':(exclude)src/tests' data/AR | grep -v '^src/localization/')" ""
   201	  local cells_txt; cells_txt="$(mktemp)"
   202	  ( cd "$RUN" && CUDA_VISIBLE_DEVICES= "$PY" -B - "$X25" > "$cells_txt" 2>/dev/null ) <<'PYEOF'
   203	import hashlib, importlib.util, json, sys
   204	sys.dont_write_bytecode = True
   205	x = sys.argv[1]
   206	m = json.load(open(f"{x}/depth_canon_cells.json"))
   207	rows = [r for r in m["cells"] if r["order"] >= 230]
   208	print("rows", len(m["cells"]), "exp35", len(rows))
   209	print("exp35_rows_sha256", hashlib.sha256(("\n".join(json.dumps(r, separators=(",", ":")) for r in rows) + "\n").encode()).hexdigest())
   210	s = importlib.util.spec_from_file_location("mk", f"{x}/depth_canon_make_cells.py"); mk = importlib.util.module_from_spec(s); s.loader.exec_module(mk)
   211	out = mk.render(mk.build_manifest(exp35=False)); out = out.encode() if isinstance(out, str) else out
   212	print("exp25_only_render_sha256", hashlib.sha256(out).hexdigest())
   213	PYEOF
   214	  cat "$cells_txt"
   215	  need "346 rows / 116 exp_35 rows" grep -qx 'rows 346 exp35 116' "$cells_txt"
   216	  need "the 116 exp_35 rows 500d6f5e…" grep -qx 'exp35_rows_sha256 500d6f5ed9c70700fdd4c778895fc84e01f7756fbac84ad2471a9346ab9252ea' "$cells_txt"
   217	  need "the exp_25-only render = d6ca307a's manifest (1073ef64…)" grep -qx "exp25_only_render_sha256 $(git -C "$RUN" show d6ca307a:"$X25"/depth_canon_cells.json | sha256sum | cut -c1-64)" "$cells_txt"
   218	  rm -f -- "$cells_txt"
   219	  need "make_cells --check (the committed manifest has not drifted)" bash -c 'cd "$1" && CUDA_VISIBLE_DEVICES= "$2" -B "$3/depth_canon_make_cells.py" --check' _ "$RUN" "$PY" "$X25"
   220	  rec "versions" versions
   221	  rec "nvidia-smi" nvidia-smi
   222	  rec "GPU map / memory" nvidia-smi --query-gpu=index,uuid,memory.used,memory.free,utilization.gpu --format=csv,noheader
   223	  rec "compute apps" nvidia-smi --query-compute-apps=pid,gpu_uuid,used_memory --format=csv,noheader
   224	  rec "his s43 ranks" ps -o pid,ppid,lstart,etime,cmd -p "$RANK0,$TRAINER"
   225	  local p; for p in "$RANK0" "$TRAINER"; do say "pid $p: cwd $(readlink /proc/$p/cwd) fd1 $(readlink /proc/$p/fd/1) fd2 $(readlink /proc/$p/fd/2)"; done
   226	  rec "his log" stat -c 'inode %i size %s mtime %y' "$HIS_LOG"
   227	  local step; step="$("$PY" -B "$GUARD" --log "$HIS_LOG" 2>/dev/null | "$PY" -B -c 'import json,sys; print(json.load(sys.stdin)["step"]["global"])' 2>/dev/null)"
   228	  need "the guard reads his global step (${step:-none})" bash -c '[[ "$1" =~ ^[0-9]+$ ]]' _ "$step"
   229	  rec "the guard over the last 1,000 steps (his current rate; baseline = step - 1000)" "$PY" -B "$GUARD" --log "$HIS_LOG" --baseline-step "$(( ${step:-1000} - 1000 ))"
   230	  say "the predictor for chunk 1 (CTL K1, 17.6 min): step ${step:-?}: earliest s43 end in $(( (40000 - ${step:-40000}) * 35 / 10 )) s; needed > $(( 2 * 1056 + 1800 )) s"
   231	  rec "his queue, evaluator and admission helper (§13 NIT 3)" "$PY" -B "$SUP" --external-shas
   232	  rec "s44 completion evidence (§13 B1)" grep -n -E $'^ACEattn\t44\t0\t|^EVAL_DONE ACEattn s44 ' "$QSTATUS" "$QLOG"
   233	  rec "the reservation directory" ls -la "$RES"
   234	  rec "the reservation schema the supervisor writes and authenticates" grep -n -E '^RES_KEYS|"holder": "exp35"' "$SUP"
   235	  if [ "$FAIL" != 0 ]; then say "CAPTURE REFUSED before the tuple: at least one CHECK failed (see above)"; return 1; fi
   236	
   237	  local tuple="$TUPLE_DIR/exp35_approved_cotenants_${TS}.json" copy="$MAINX/exp35_approved_cotenants_${TS}.json" tsha
   238	  say ""; say "### the approved co-tenant tuple (a new file: ${tuple})"
   239	  ( set -o noclobber; "$PY" -B "$IDH" --snapshot --gpu-uuid "$GPU1" --pid "$TRAINER" > "$tuple" ) || { say "CHECK FAILED: the tuple snapshot"; FAIL=1; }
   240	  tsha="$(sha "$tuple")"; cat "$tuple"; say "bytes $(stat -c %s "$tuple" 2>/dev/null); sha256 ${tsha}"
   241	  need "the tuple validates against its sha256" "$PY" -B "$IDH" --validate "$tuple" --approved-sha256 "$tsha"
   242	  need "the tuple is exactly his GPU 1 rank (pid, cwd, fd1 = fd2 = his log)" "$PY" -B -c '
   243	import json, sys
   244	d = json.load(open(sys.argv[1])); p = d["processes"]
   245	ok = (d["gpu_uuid"] == sys.argv[2] and len(p) == 1 and p[0]["pid"] == int(sys.argv[3])
   246	      and p[0]["cwd"] == "/home/yixunhu/codespace/flac-fork-attn" and p[0]["fd1"] == p[0]["fd2"] == sys.argv[4])
   247	sys.exit(0 if ok else 1)' "$tuple" "$GPU1" "$TRAINER" "$HIS_LOG"
   248	  need "the live GPU 1 set equals the tuple" "$PY" -B "$IDH" --check --approved "$tuple" --approved-sha256 "$tsha" --gpu-uuid "$GPU1" --pids "$(gpu1_pids)"
   249	  say ""; say "### the supervisor's read-only dry run in the launch environment"
   250	  dry_run "$tuple" "$tsha"
   251	  if [ "$FAIL" != 0 ]; then say "CAPTURE REFUSED: at least one CHECK failed (see above); no record copy, no seal"; return 1; fi
   252	  need "the tuple's record copy (a new file in the main checkout) is byte-identical" bash -c \
   253	    'set -o noclobber; cat "$1" > "$2" && [ "$(sha256sum < "$2" | cut -c1-64)" = "$3" ]' _ "$tuple" "$copy" "$tsha"
   254	  [ "$FAIL" = 0 ] || { say "CAPTURE REFUSED: the record copy"; return 1; }
   255	  { printf 'h35 %s\nscript_sha256 %s\ntuple %s %s\ntuple_copy %s %s\ncampaign_digest %s\n' "$H35" "$SELF_SHA" \
   256	      "$tuple" "$tsha" "$copy" "$(sha "$copy")" "$PIN_DIGEST"
   257	    local e name path want; for e in "${PINS[@]}"; do IFS='|' read -r name path want <<<"$e"; printf 'pin_%s %s %s\n' "$name" "$path" "$want"; done
   258	    printf 'pip_freeze %s\nversions %s\nhis_step %s\n' "$PIN_PIP" "$PIN_VERSIONS" "$step"; } >> "$draft"
   259	  say "CAPTURE CHECKS OK (the seal is written after this log is closed)"
   260	  return 0
   261	}
