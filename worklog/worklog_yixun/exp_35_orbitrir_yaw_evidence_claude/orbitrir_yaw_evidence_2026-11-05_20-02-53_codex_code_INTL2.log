   189	capture() {   # <draft file>
   190	  local draft="$1"
   191	  say "=== exp_35 phase (i) launch capture -- $(date -Is) -- host $(hostname) -- H35 ${H35} ==="
   192	  say "this script: ${SELF_SHA}  $0"
   193	  script_check
   194	  common_checks
