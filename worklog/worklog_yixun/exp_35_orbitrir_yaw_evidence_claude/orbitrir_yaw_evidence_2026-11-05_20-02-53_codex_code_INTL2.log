   156	ladder_checks() {   # <draft>: the four-rung ladder at H35 (untracked transcripts in the run worktree), content + sha256
   157	  local short="${H35:0:8}" k f n
   158	  local -a pat=("1_exp25_byte_guard" "2_supervisor_live_dry_run" "3_runner_dry_run_phase_i" "4_all_suites_in_worktree")
   159	  for k in 0 1 2 3; do
   160	    n="$(ls "$RUNX"/orbitrir_yaw_evidence_*_LADDER_${pat[$k]}_at_${short}.log 2>/dev/null | wc -l)"
   161	    need "exactly one ladder rung $((k + 1)) transcript at ${short}" eq "$n" 1
   162	    f="$(ls "$RUNX"/orbitrir_yaw_evidence_*_LADDER_${pat[$k]}_at_${short}.log 2>/dev/null | head -n 1)"
   163	    say "ladder rung $((k + 1)): ${f##*/} sha256 $(sha "$f")"
   164	    printf 'ladder_%s %s %s\n' "$((k + 1))" "${f##*/}" "$(sha "$f")" >> "$1"
   165	    case $k in
   166	      0) need "rung 1: ec3fcd08… and the md identical" bash -c 'grep -q "sha256 of the re-collected JSON: ec3fcd08e3d210524b50246d9bfdf084e72835432a5d06450085e0cad12eb6e0" "$1" && grep -q "md == the committed exp_25 md: identical" "$1"' _ "$f" ;;
   167	      1) need "rung 2: DRY RUN OK and the worktree unchanged" bash -c 'grep -q "^DRY RUN OK" "$1" && grep -q "IDENTICAL" "$1"' _ "$f" ;;
   168	      2) need "rung 3: runner rc 0 and the digest ${PIN_DIGEST:0:8}…" bash -c 'grep -q "runner rc 0" "$1" && grep -q "evaluator tree digest $2" "$1"' _ "$f" "$PIN_DIGEST" ;;
   169	      3) need "rung 4: a pytest summary with passes and no failure or error" bash -c 'l="$(grep -E "^[0-9]+ passed" "$1" | tail -n 1)"; [ -n "$l" ] && ! printf "%s" "$l" | grep -q -E "failed|error"' _ "$f"
   170	         rec "rung 4 summary" bash -c 'grep -E "^[0-9]+ passed" "$1" | tail -n 1' _ "$f" ;;
   171	    esac
   172	  done
