   263	seal_write() {   # <draft> <capture log>: the seal, a NEW file, only after a fully passing capture
   264	  local seal="$MAINX/orbitrir_yaw_evidence_${TS}_phase_i_capture_seal.txt"
   265	  ( set -o noclobber; { cat "$1"; printf 'capture_log %s %s\nsealed_at %s %s\n' "$2" "$(sha "$2")" "$(date +%s)" "$(date -Is)"; } > "$seal" ) \
   266	    || { say "SEAL REFUSED: ${seal} exists"; return 1; }
   267	  say "SEAL ${seal} sha256 $(sha "$seal")"
   268	  say "LAUNCH LINE: EXPECT_SCRIPT_SHA256=${SELF_SHA} bash $0 launch ${H35} ${seal} $(sha "$seal")"
   269	}
   270	
   271	launch() {
   272	  local seal="${3:-}" ssha="${4:-}" tuple tsha copy csha clog clsha age suplog pid found
   273	  say "=== exp_35 phase (i) LAUNCH -- $(date -Is) -- H35 ${H35} -- seal ${seal} ${ssha} ==="
   274	  say "this script: ${SELF_SHA}  $0"
   275	  script_check
   276	  need "the seal is a regular file in the main checkout's exp_35 folder" bash -c '[ -f "$1" ] && [ ! -L "$1" ] && [ "$(dirname "$1")" = "$2" ]' _ "$seal" "$MAINX"
   277	  need "the seal's sha256 is the given value" eq "$(sha "$seal")" "$ssha"
   278	  [ "$FAIL" = 0 ] || { say "LAUNCH REFUSED: the seal"; return 1; }
   279	  cat "$seal"
   280	  sv() { awk -v k="$1" '$1 == k {$1 = ""; sub(/^ /, ""); print; exit}' "$seal"; }
   281	  need "the seal names this H35" eq "$(sv h35)" "$H35"
   282	  need "the seal names this script" eq "$(sv script_sha256)" "$SELF_SHA"
   283	  need "the seal names the pinned campaign digest" eq "$(sv campaign_digest)" "$PIN_DIGEST"
   284	  read -r tuple tsha <<<"$(sv tuple)"; read -r copy csha <<<"$(sv tuple_copy)"; read -r clog clsha <<<"$(sv capture_log)"
   285	  need "the tuple is the canonical run-worktree file" bash -c '[[ "$1" == "$2"/exp35_approved_cotenants_*.json ]] && [ -f "$1" ] && [ ! -L "$1" ]' _ "$tuple" "$TUPLE_DIR"
   286	  need "the tuple still hashes to the sealed value" eq "$(sha "$tuple")" "$tsha"
   287	  need "the record copy is the main-checkout file of the same name, byte-identical" bash -c '[ "$1" = "$2/${3##*/}" ] && [ "$(sha256sum < "$1" | cut -c1-64)" = "$4" ] && [ "$4" = "$5" ]' _ "$copy" "$MAINX" "$tuple" "$csha" "$tsha"
   288	  need "the capture log still hashes to the sealed value and shows CAPTURE CHECKS OK" bash -c '[ "$(sha256sum < "$1" | cut -c1-64)" = "$2" ] && grep -q "^CAPTURE CHECKS OK" "$1" && ! grep -q "^CHECK FAILED" "$1"' _ "$clog" "$clsha"
   289	  age=$(( $(date +%s) - $(sv sealed_at | awk '{print $1}') ))
   290	  need "the seal is current (${age} s old <= ${SEAL_MAX_AGE_S} s)" test "$age" -ge 0 -a "$age" -le "$SEAL_MAX_AGE_S"
   291	  local k name path want; for k in 1 2 3 4; do
   292	    read -r name want <<<"$(sv "ladder_$k")"; need "ladder rung $k transcript unchanged since the capture" eq "$(sha "$RUNX/$name")" "$want"; done
