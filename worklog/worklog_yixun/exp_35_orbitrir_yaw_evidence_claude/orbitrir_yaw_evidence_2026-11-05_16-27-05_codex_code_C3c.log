   322	  for p in "$DUMP_DIR".staging-*; do
   323	    case "$p" in *.incomplete-*) ;; *) [ -e "$p" ] && return 1 ;; esac
   324	  done
   325	  "$PY" "$COLLECT" --verify-cell "$STEM" --pin "$EXPECT_HEAD" --cells "$CELLS" --farm-root "$FARM_ROOT" \
   326	    --dump-root "$DUMP_ROOT" --base-dir "$REPO" --campaign-digest "$CAMPAIGN_DIGEST" "${extra[@]}" 2>&1 | grep -v -e pkg_resources -e declare_namespace | sed 's/^/    /'
   327	  return "${PIPESTATUS[0]}"
   328	}
   329	prepare_cell() {   # sets the cell globals; 0 = run it, 3 = SKIP, 1 = refused (message printed)
   330	  local cid="$1" what p dest
   331	  IFS=$'\x1f' read -r ARM BLOCK TARGET SHA NASM NASK LINK METRICS STREAM CANON CANON_PROBE RECEIPT \
   332	    DUMP DUMP_DIR STEM CACHED NOFLASH < <(cell_fields "$cid")
   333	  mapfile -t ARGV < <(jq -r --arg c "$cid" '.cells[] | select(.cell == $c) | .argv[]' "$PLAN")
   334	  stage_ckpt "$TARGET" "$SHA" "$NASM" "$NASK" "$CACHED" || return 1
   335	  if [ -L "$LINK" ] || [ -e "$LINK" ]; then
   336	    farm_entry_ok "$LINK" "$CACHED" \
   337	      || { echo "FARM GATE FAILED: ${LINK} exists and is not a hard link of the verified ${CACHED} - abort"; return 1; }
   338	  elif [ "$DRY_RUN" = 0 ]; then
   339	    mkdir -p "$(dirname "$LINK")" && ( farm_ok "$(dirname "$LINK")" ) && ln -- "$CACHED" "$LINK" \
   340	      && farm_entry_ok "$LINK" "$CACHED" || { echo "FARM GATE FAILED: cannot hard-link ${LINK} - abort"; return 1; }
   341	  fi
   342	  if complete_and_verified; then echo "CELL ${cid} | ${BLOCK} | SKIP (complete and verified)"; return 3; fi
   343	  mapfile -t STALE < <(existing_artifacts)
   344	  what="run"; [ "${#STALE[@]}" -gt 0 ] && what="QUARANTINE ${#STALE[@]} artifact(s), then run"
   345	  echo "CELL ${cid} | ${BLOCK} | ${ARM} | $([ "$DRY_RUN" = 1 ] && echo would) ${what}"
   346	  for p in "${STALE[@]}"; do
   347	    dest="${p}.incomplete-${TS}"
   348	    if [ "$DRY_RUN" = 1 ]; then echo "  would quarantine ${p}"; continue; fi
   349	    [ ! -e "$dest" ] && mv -- "$p" "$dest" || { echo "QUARANTINE FAILED: ${p} - abort"; return 1; }
   350	    echo "  QUARANTINED ${p} -> ${dest}"
   351	  done
   352	  return 0
   353	}
   354	N_SEL="${#CELL_IDS[@]}"
   355	if [ "$DRY_RUN" = 1 ]; then
   356	  for cid in "${CELL_IDS[@]}"; do
   357	    prepare_cell "$cid"; st=$?
   358	    [ "$st" -eq 1 ] && exit 2
   359	    [ "$st" -eq 0 ] && echo "DRYRUN ${cid} argv: $(jq -c --arg c "$cid" '.cells[] | select(.cell == $c) | .argv' "$PLAN")"
   360	    [ "$st" -eq 0 ] && [ "$NOFLASH" = true ] && echo "  (exp_35: spawned through ${NO_FLASH_LAUNCHER}, PYTHONPATH=${REPO}/${NO_FLASH_DIR})"
   361	  done
   362	  echo "=== DRY_RUN summary: ${N_SEL} cell(s) planned; nothing evaluated, linked, created or moved ==="
   363	  exit 0
   364	fi
   365	
   366	run_cell() {   # lane cell sha spawn-digest link cache no_flash argv... -- a background job: evaluate, receipt, verify
   367	  local lane="$1" cid="$2" sha="$3" spawn="$4" link="$5" cache="$6" noflash="$7"; shift 7
   368	  local clog="$LOGDIR/depth_canon_${TS}_eval_${cid}.log" rc=0 post measured nbytes out backend=()
   369	  if [ "$noflash" = true ]; then   # exp_35 (§11 B1, §12 H4 c): the pinned launcher, the overlay ONLY on PYTHONPATH
   370	    lane_state "$lane" || {      # Codex C2 BLOCKING 1: the lane / identity at the real pre-exec boundary
   371	      echo "  !! FAILED ${cid}: LANE CHANGED before the launch on GPU ${lane} (${LANE_WHY}); not launched, no receipt"
   372	      return 6; }
   373	    CUDA_VISIBLE_DEVICES="$lane" HF_HUB_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$REPO/$NO_FLASH_DIR" \
   374	      "$PY" "$NO_FLASH_LAUNCHER" "$EVAL_PROG" "$@" > "$clog" 2>&1 || rc=$?
   375	  else
   376	    CUDA_VISIBLE_DEVICES="$lane" HF_HUB_OFFLINE=1 "$PY" "$EVAL_PROG" "$@" > "$clog" 2>&1 || rc=$?
   377	  fi
   378	  if [ "$rc" -ne 0 ]; then echo "  !! FAILED ${cid}: the evaluator exited rc=${rc} (log ${clog})"; return 1; fi
   379	  post="$(tree_digest)" || post=""
   380	  if [ "$post" != "$CAMPAIGN_DIGEST" ] || [ -n "$(tree_dirty)" ]; then
   381	    echo "  !! FAILED ${cid}: the relevant tree changed while the cell ran (digest '${post}' != ${CAMPAIGN_DIGEST}); no receipt"
   382	    return 4
   383	  fi
   384	  measured="$(sha256sum -- "$link" | awk '{print $1}')"   # the file the evaluator opened, hashed again
   385	  nbytes="$(stat -c %s -- "$link")"                        # == the length eval_FLAC reports it loaded
   386	  if [ "$measured" != "$sha" ] || ! farm_entry_ok "$link" "$cache"; then
   387	    echo "  !! FAILED ${cid}: the evaluated checkpoint ${link} now hashes to '${measured}', not ${sha} (or left the cache inode); no receipt"
   388	    return 1
   389	  fi
   390	  if [ "$noflash" = true ]; then   # exp_35 §3b: the log must prove the SDPA backend, else a hard stop
   391	    out="$("$PY" "$COLLECT" --check-backend-log "$clog" --backend-target "$EVAL_PROG" 2>&1)" || {
   392	      echo "  !! FAILED ${cid}: BACKEND EVIDENCE missing from ${clog}; no receipt, the campaign stops:"
   393	      grep -v -e pkg_resources -e declare_namespace <<<"$out" | sed 's/^/    /'
   394	      return 5; }
   395	    backend=(--attention-backend sdpa --no-flash-overlay-sha256 "$NO_FLASH_OVERLAY_SHA256"
   396	             --no-flash-launcher-sha256 "$NO_FLASH_LAUNCHER_SHA256" --backend-target "$EVAL_PROG")
   397	  fi
   398	  "$PY" "$COLLECT" --write-receipt "$cid" --plan-json "$PLAN" --cells "$CELLS" --base-dir "$REPO" \
   399	    --lane "$lane" --log "$clog" --rc 0 --pin "$EXPECT_HEAD" --ckpt-sha "$measured" --ckpt-bytes "$nbytes" \
   400	    --farm-root "$FARM_ROOT" \
   401	    --spawn-digest "$spawn" --post-digest "$post" \
   402	    --dump-root "$DUMP_ROOT" "${VERIFY_EXTRA[@]}" "${backend[@]}" --verify-after >> "$clog" 2>&1 \
   403	    || { echo "  !! FAILED ${cid}: post-run verification refused the cell (log ${clog})"; return 1; }
   404	  echo "  DONE ${cid} on GPU ${lane}: complete and verified"
   405	}
   406	declare -A LANE_PID=() PID_CELL=() PID_LANE=() GPU_NOTE=()
   407	N_SKIP=0; N_DONE=0; FAILED=(); ABORT=""; DRIFT=""; NEXT=0; POLLS=0; i=0; READY=""
   408	reap() {   # collect every finished job; never waits on a running one, never signals anything
   409	  local pid st running=" $(jobs -rp | tr '\n' ' ') "
   410	  for pid in "${!PID_CELL[@]}"; do
   411	    case "$running" in *" ${pid} "*) continue ;; esac
   412	    st=0; wait "$pid" || st=$?
   413	    if [ "$st" -eq 0 ]; then N_DONE=$((N_DONE + 1)); else FAILED+=("${PID_CELL[$pid]}"); fi
   414	    if [ "$st" -eq 4 ]; then DRIFT=1; ABORT="${ABORT:-PIN DRIFT: the relevant tree changed while ${PID_CELL[$pid]} ran}"; fi
   415	    if [ "$st" -eq 5 ]; then ABORT="${ABORT:-BACKEND EVIDENCE missing for ${PID_CELL[$pid]}: no further cell is spawned}"; fi
   416	    if [ "$st" -eq 6 ]; then ABORT="${ABORT:-LANE CHANGED before the launch of ${PID_CELL[$pid]}: no further cell is spawned}"; fi
   417	    unset "LANE_PID[${PID_LANE[$pid]}]" "PID_CELL[$pid]" "PID_LANE[$pid]"
   418	  done
   419	}
   420	RE_MAP='^([0-9]+),[[:space:]]*(GPU-[0-9A-Za-z-]+)$'
   421	RE_APP='^([0-9]+),[[:space:]]*(GPU-[0-9A-Za-z-]+),[[:space:]]*([^,]*),[[:space:]]*([0-9]+|\[N/A\])$'
   422	lane_state() {   # <gpu>: 0 usable | 1 not now (LANE_WHY) | 2 a query failed / is malformed (fail closed)
   423	  local lane="$1" out rc line want pid uuid occ="" free pids=""
   424	  local -A byidx=() byuuid=()
   425	  out="$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader 2>/dev/null)"; rc=$?
   426	  [ "$rc" -eq 0 ] && [ -n "$out" ] || { LANE_WHY="nvidia-smi --query-gpu=index,uuid failed (rc ${rc})"; return 2; }
   427	  while IFS= read -r line; do
   428	    [[ "$line" =~ $RE_MAP ]] || { LANE_WHY="malformed index,uuid row '${line}'"; return 2; }
   429	    [ -z "${byidx[${BASH_REMATCH[1]}]:-}" ] && [ -z "${byuuid[${BASH_REMATCH[2]}]:-}" ] \
   430	      || { LANE_WHY="duplicate index or uuid in the nvidia-smi map ('${line}')"; return 2; }
   431	    byidx[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}"; byuuid[${BASH_REMATCH[2]}]="${BASH_REMATCH[1]}"
   432	  done <<<"$out"
   433	  want="${byidx[$lane]:-}"
   434	  [ -n "$want" ] || { LANE_WHY="GPU ${lane} has no uuid in the nvidia-smi index map"; return 2; }
   435	  out="$(nvidia-smi --query-compute-apps=pid,gpu_uuid,process_name,used_memory --format=csv,noheader,nounits 2>/dev/null)"; rc=$?
   436	  [ "$rc" -eq 0 ] || { LANE_WHY="nvidia-smi --query-compute-apps failed (rc ${rc})"; return 2; }
   437	  while IFS= read -r line; do
   438	    [ -n "$line" ] || continue
   439	    [[ "$line" =~ $RE_APP ]] || { LANE_WHY="malformed compute-app row '${line}'"; return 2; }
   440	    pid="${BASH_REMATCH[1]}"; uuid="${BASH_REMATCH[2]}"
   441	    [ -n "${byuuid[$uuid]:-}" ] || { LANE_WHY="compute process ${pid} sits on an unknown uuid ${uuid}"; return 2; }
   442	    [ "$uuid" = "$want" ] && occ+=" pid ${pid} (${BASH_REMATCH[3]}, ${BASH_REMATCH[4]} MiB, cwd $(readlink "/proc/${pid}/cwd" 2>/dev/null || echo '?'))" \
   443	      && pids+="${pids:+,}${pid}"
   444	  done <<<"$out"
   445	  out="$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits -i "$lane" 2>/dev/null)"; rc=$?
   446	  [ "$rc" -eq 0 ] && [[ "$out" =~ ^[[:space:]]*([0-9]+)[[:space:]]*$ ]] \
   447	    || { LANE_WHY="nvidia-smi memory.free of GPU ${lane} failed or is not one number (rc ${rc}: '${out//$'\n'/|}')"; return 2; }
   448	  free="${BASH_REMATCH[1]}"
   449	  [ "$free" -ge "$MIN_GPU_FREE_MIB" ] || { LANE_WHY="${free} MiB free < ${MIN_GPU_FREE_MIB} MiB"; return 1; }
   450	  LANE_WHY=""
   451	  if [ -n "$occ" ]; then
   452	    [ "$ALLOW_SHARED_GPU" = 1 ] || { LANE_WHY="occupied by foreign compute process(es):${occ}"; return 1; }
   453	    LANE_WHY="shared with${occ} (ALLOW_SHARED_GPU=1)"
   454	  fi
   455	  if [ -n "$COTENANTS" ]; then   # exp_35 §12 B1.1: the foreign set EQUALS the approved identity tuple
   456	    out="$("$PY" "$IDENTITY" --check --approved "$COTENANTS" --approved-sha256 "$COTENANTS_SHA" --gpu-uuid "$want" \
   457	      --pids "$pids" 2>&1)" \
   458	      || { LANE_WHY="co-tenant identity check refused GPU ${lane}: ${out//$'\n'/; }"; return 2; }
   459	    LANE_WHY="${LANE_WHY} [identity tuple OK: ${pids:-none}]"
   460	  fi
   461	  return 0
   462	}
   463	pick_lane() {   # LANE = the next idle lane (round-robin) lane_state accepts; a failed query aborts
   464	  local k lane st; LANE=""
   465	  for ((k = 0; k < ${#LANES[@]}; k++)); do
   466	    lane="${LANES[$(( (NEXT + k) % ${#LANES[@]} ))]}"
   467	    [ -z "${LANE_PID[$lane]:-}" ] || continue
   468	    lane_state "$lane"; st=$?
   469	    [ "$st" -eq 2 ] && { ABORT="GPU GATE FAILED: ${LANE_WHY}"; return 1; }
