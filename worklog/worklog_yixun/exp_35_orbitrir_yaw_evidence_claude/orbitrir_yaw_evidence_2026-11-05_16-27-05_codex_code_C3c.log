    39	class FakeProc:
    40	    """A spawned runner / probe: alive for ``polls`` world sleeps, its evaluator (pid + 1) on ``uuid`` meanwhile."""
    41	
    42	    def __init__(self, world, pid, polls, rc, uuid, on_exit):
    43	        self.w, self.pid, self.left, self.rc, self.uuid, self.on_exit = world, pid, polls, rc, uuid, on_exit
    44	        self.returncode = None
    45	        proc_entry(world.procdir, pid, ppid=1, cmdline=b"bash\x00runner\x00")
    46	        proc_entry(world.procdir, pid + 1, ppid=pid, cmdline=b"python\x00eval_FLAC.py\x00")
    47	        world.apps.append((pid + 1, uuid))
    48	
    49	    def tick(self):
    50	        if self.returncode is None:
    51	            self.left -= 1
    52	            if self.left <= 0:
    53	                self.w.apps.remove((self.pid + 1, self.uuid))
    54	                shutil.rmtree(self.w.procdir / str(self.pid + 1))
    55	                shutil.rmtree(self.w.procdir / str(self.pid))
    56	                self.returncode = self.rc
    57	                if self.on_exit:
    58	                    self.on_exit(self)
    59	
    60	    def poll(self):
    61	        return self.returncode
