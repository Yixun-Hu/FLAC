  2119	    problems += [f"{len(invalid)} cell(s) failed verification ({', '.join(invalid[:3])})"] if invalid else []
  2120	    problems += [f"the cells span {len(digests)} campaign digests"] if len(digests) > 1 else []
  2121	    problems += [f"CTL K{k} {st} (E1 must be equal): {'; '.join(why[:2])}" for k, (st, why) in ctl.items() if st != "equal"]
  2122	    problems += [f"external exp_25 cells: {x}" for x in external_why]
