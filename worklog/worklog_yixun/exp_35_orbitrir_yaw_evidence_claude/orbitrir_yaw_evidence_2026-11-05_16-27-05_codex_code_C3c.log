   306	}
   307	VERIFY_EXTRA=(); [ -n "$CANON_MANIFEST" ] && VERIFY_EXTRA=(--canon-ckpt-manifest "$CANON_MANIFEST")
   308	existing_artifacts() {   # every artifact of the current cell that exists (one path per line)
   309	  local p
   310	  for p in "$METRICS" "$STREAM" "$CANON_PROBE" "$RECEIPT" "$DUMP_DIR" "$DUMP_DIR".staging-*; do
   311	    case "$p" in *.staging-*.incomplete-*) continue ;; esac            # already parked
   312	    { [ -e "$p" ] || [ -L "$p" ]; } && printf '%s\n' "$p"
   313	  done
   314	}
   315	complete_and_verified() {   # 0 = SKIP; the collector runs is_complete exactly once
   316	  local extra=("${VERIFY_EXTRA[@]}") p
   317	  [ -f "$METRICS" ] && [ -f "$STREAM" ] && [ -f "$RECEIPT" ] || return 1
   318	  [ -z "$CANON" ] || [ -f "$CANON" ] || return 1
