  2078	                                      for s in seeds if ("BF-pin", sub, k, s, deg) in idx]
  2079	    ext = lambda fmt, k, seeds: [external[fmt.format(k=k, s=s)] for s in seeds  # noqa: E731
  2080	                                 if fmt.format(k=k, s=s) in external]
  2081	    if e2["status"] == "PASS":
  2082	        b45 = {m: _seed_stats({k: [r for r in e2["rows45"] if (r["method"], r["K"]) == (label, str(k))] for k in ks},
  2083	                              f"A6 CSV '{label}' 45 deg s42-46 (E2 PASS)") for m, label in A6_METHODS.items()}
  2084	    elif e2["status"] == "FAIL":
  2085	        b45 = {m: _e2_fail_45(m, idx, external, e2f) for m in A6_METHODS}
  2086	    else:
  2087	        b45 = {m: {"source": f"pending: E2 {e2['status']}", "1": None, "8": None} for m in A6_METHODS}
  2088	    c45 = sorted((e for e in cells.values() if e["valid"] and e["row"]["block"] == "CANON-45"), key=lambda e: e["row"]["seed"])
  2089	    b45["CANON"] = _pointed({k: [_point(name=n, external=external) for n in [f"exp25_CANON_C4_S40000_K{k}_s42_th45"]
  2090	                                 if n in external] + [_point(e) for e in c45 if e["row"]["K"] == k] for k in ks},
  2091	                            "exp_25 C4+45 th45 s42 (external, d6ca307a) + exp_35 CANON-45 s43-46")
  2092	    b = {"45": b45, "R": {"FLAC": _seed_stats({k: ext("exp25_P1_R_S40000_K{k}_s{s}", k, SEEDS) for k in ks},
  2093	                                              "exp_25 P1-pin R s42-46 (external, d6ca307a)"),
  2094	                          "CANON": _seed_stats({k: ext("exp25_CANON_R_S40000_K{k}_s{s}", k, SEEDS) for k in ks},
  2095	                                               "exp_25 CANON R s42-46 (external, d6ca307a)"),
  2096	                          "OrbitRIR": _seed_stats({k: h35("R", k, SEEDS, None) for k in ks}, "exp_35 BF-pin R s42-46")}}
  2097	    a = {"FLAC": {"ref": "external_reference.exp25.table.P1"}, "CANON": {"ref": "external_reference.exp25.table.CANON"},
  2098	         "OrbitRIR": _seed_stats({k: h35("T", k, SEEDS, 0) for k in ks}, "exp_35 BF-pin T s42-46"),
  2099	         "historical_bf": BF_HISTORICAL_EXP35}
  2100	    c = dict({arm: {"ref": f"external_reference.exp25.tier3.{arm}"} for arm in ("CANON", "P1", "YAW")},
  2101	             BF={"ref": "tier3.BF.arms.BF"})
  2102	    return a, b, c
