   241	                     sidecar_sha256="3" * 64, log_sha256="4" * 64)
   242	        c.update(**{"E1": {"e1": {"rc": 0, "verdict": "equal", "out": "ok"}},
   243	                    "E2": {"e2": {"rc": 1, "verdict": "FAIL", "out": "x"}}}.get(c["gate"], {}))
   244	    st.update(baseline={"time": 1.0, "step": 100, "log": {"path": "/x.log", "inode": 5, "size": 9}},
   245	              lane={"uuid": G1, "shared": True}, reservation={"uuid": G1, "epoch": 1, "path": f"/r/{G1}.json"},
   246	              his_log_anchor={"inode": 5, "device": 2, "size": 9, "offset": 9, "tail_sha256": "5" * 64},
