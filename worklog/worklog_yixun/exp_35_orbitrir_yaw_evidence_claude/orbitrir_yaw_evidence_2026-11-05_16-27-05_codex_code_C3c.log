   233	# --- the farm: a real local directory (never a symlink out of the checkout) ---------- #
   234	farm_ok() {   # <dir>: absent (DRY_RUN) or a real directory under the repo / harness
   235	  [ ! -L "$1" ] || die "FARM GATE FAILED: ${1} is a symlink - abort"
   236	  [ -e "$1" ] || return 0
   237	  case "$(readlink -f -- "$1")" in "$(readlink -f "$REPO")"/?*|"${HREAL:-/nonexistent}"/?*) ;;
   238	    *) die "FARM GATE FAILED: ${1} resolves outside this checkout - abort" ;; esac
   239	}
   240	farm_ok "$FARM_ROOT"
   241	
   242	# --- the checkpoint cache: a free-space gate on the local filesystem BEFORE any copy --- #
   243	CACHE_DIR="$FARM_ROOT/.ckpt_cache"; CACHE_MARGIN=$((2 * 1024 * 1024 * 1024))
   244	farm_ok "$CACHE_DIR"
   245	NEED=0; N_STAGE=0
   246	while IFS=$'\x1f' read -r target sha; do
   247	  [ -f "$CACHE_DIR/${sha}.ckpt" ] && continue
   248	  [ -f "$target" ] || die "CHECKPOINT MISSING: ${target} - abort"
   249	  NEED=$((NEED + $(stat -c %s -- "$target"))); N_STAGE=$((N_STAGE + 1))
   250	done < <(jq -r '[.cells[] | (.target + "\u001f" + .sha256)] | unique[]' "$PLAN")
   251	anc="$CACHE_DIR"; while [ ! -e "$anc" ]; do anc="$(dirname "$anc")"; done
   252	AVAIL="$(df -B1 --output=avail -- "$anc" 2>/dev/null | tail -n 1 | tr -d ' ')"
   253	[[ "$AVAIL" =~ ^[0-9]+$ ]] || die "CACHE SPACE GATE FAILED: df cannot report the free space of ${anc} - abort"
   254	echo "checkpoint cache space: ${N_STAGE} checkpoint(s) to stage = $((NEED)) B + ${CACHE_MARGIN} B margin = $((NEED + CACHE_MARGIN)) B needed; ${AVAIL} B available on ${anc}"
   255	[ "$AVAIL" -ge $((NEED + CACHE_MARGIN)) ] || die "CACHE SPACE GATE FAILED: $((NEED + CACHE_MARGIN)) B needed > ${AVAIL} B available - abort"
   256	
   257	# --- per cell: checkpoint, link, (predicate), (run) ----------------------------------- #
   258	declare -A SHA_DONE=() CKPT_SIZE=()
   259	cache_ok() {   # <cache> <sha>: the immutable-cache contract (regular, 0444, the source's size) + a full re-hash
   260	  local got mode size
   261	  { [ -f "$1" ] && [ ! -L "$1" ]; } || { CACHE_WHY="${1} is not a regular file"; return 1; }
   262	  mode="$(stat -c %a -- "$1")"; size="$(stat -c %s -- "$1")"
   263	  [ "$mode" = 444 ] || { CACHE_WHY="${1} has mode ${mode}, not the immutable 0444"; return 1; }
   264	  [ "$size" = "${CKPT_SIZE[$2]:-}" ] || { CACHE_WHY="${1} is ${size} bytes, the source is ${CKPT_SIZE[$2]:-unknown}"; return 1; }
   265	  got="$(sha256sum -- "$1" | awk '{print $1}')"
   266	  [ "$got" = "$2" ] || { CACHE_WHY="${1} hashes to ${got}, not ${2}"; return 1; }
   267	}
   268	stage_ckpt() {   # target sha nas-manifest nas-key cache: the verified immutable cache file (once per sha)
   269	  local target="$1" want="$2" nasm="$3" key="$4" cache="$5" got tmp
   270	  [ -f "$target" ] || { echo "CHECKPOINT MISSING: ${target} - abort"; return 1; }
   271	  if [ -n "$nasm" ]; then
   272	    grep -qxF "${want}  ${key}" "$nasm" 2>/dev/null || { echo "NAS MANIFEST CHECK FAILED: ${nasm} does not list '${want}  ${key}' - abort"; return 1; }
   273	  fi
   274	  [ -n "${SHA_DONE[$want]:-}" ] && return 0
   275	  CKPT_SIZE[$want]="$(stat -c %s -- "$target")"
   276	  if [ "$DRY_RUN" = 1 ]; then   # read-only: hash the source, stage nothing
   277	    got="$(sha256sum -- "$target" | awk '{print $1}')"
   278	    [ "$got" = "$want" ] || { echo "CHECKPOINT SHA MISMATCH: ${target} is ${got}, the manifest pins ${want} - abort"; return 1; }
   279	    echo "checkpoint OK (DRY_RUN, not staged): ${target} (${want})"
   280	  elif [ -e "$cache" ] || [ -L "$cache" ]; then   # rB-F2 F2-6 (a): the immutable-cache contract, then the bytes
   281	    cache_ok "$cache" "$want" || { echo "CACHE GATE FAILED: ${CACHE_WHY} - abort"; return 1; }
   282	    echo "checkpoint OK: cached ${cache} re-verified (0444, ${CKPT_SIZE[$want]} bytes, ${want})"
   283	  else
   284	    mkdir -p "$CACHE_DIR" && ( farm_ok "$CACHE_DIR" ) || { echo "CACHE GATE FAILED: cannot create ${CACHE_DIR} - abort"; return 1; }
   285	    tmp="$CACHE_DIR/.staging-${want}-$$"
   286	    cp --no-preserve=all -- "$target" "$tmp" || { rm -f -- "$tmp"; echo "CACHE GATE FAILED: cannot copy ${target} - abort"; return 1; }
   287	    got="$(sha256sum -- "$tmp" | awk '{print $1}')"
   288	    if [ "$got" != "$want" ]; then
   289	      rm -f -- "$tmp"; echo "CHECKPOINT SHA MISMATCH: the copy of ${target} is ${got}, the manifest pins ${want} - abort"; return 1
   290	    fi
   291	    { chmod 0444 -- "$tmp" && mv -n -T -- "$tmp" "$cache" && [ ! -e "$tmp" ]; } \
   292	      || { rm -f -- "$tmp"; echo "CACHE GATE FAILED: cannot publish ${cache} - abort"; return 1; }
   293	    echo "checkpoint OK: ${target} -> ${cache} (the local copy hashes to the pin ${want})"
   294	  fi
   295	  SHA_DONE[$want]=1
   296	}
   297	farm_entry_ok() {   # <entry> <cache>: a regular file (never a symlink) on the cache file's inode
   298	  [ ! -L "$1" ] && [ -f "$1" ] && [ ! -L "$2" ] && [ -f "$2" ] \
   299	    && [ "$(stat -c '%d:%i:%s' -- "$1")" = "$(stat -c '%d:%i:%s' -- "$2")" ]
   300	}
   301	cell_fields() {
   302	  jq -r --arg c "$1" '.cells[] | select(.cell == $c) | [.arm, .block, .target, .sha256,
   303	      (.nas_manifest // ""), (.nas_manifest_key // ""), .link, .metrics, .stream, (.canon // ""),
   304	      .canon_probe, .receipt, (.dump | tostring), .dump_dir, .stem, .cache, (.no_flash // false | tostring)]
