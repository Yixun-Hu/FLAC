   167	# --- the plan: selection, checkpoints, paths, argv (depth_canon_collect.py) --------- #
   168	PLAN="$LOGDIR/depth_canon_${TS}_eval_plan.json"
   169	PLAN_ARGS=(--plan "$PLAN" --cells "$CELLS" --farm-root "$FARM_ROOT" --no-dump-blocks "$NO_DUMP"
   170	           --campaign-digest "$CAMPAIGN_DIGEST")
   171	[ -n "$DUMP_ROOT" ] && PLAN_ARGS+=(--dump-root "$DUMP_ROOT")
   172	[ -n "$BLOCKS" ] && PLAN_ARGS+=(--blocks "$BLOCKS")
   173	[ -n "$ONLY" ] && PLAN_ARGS+=(--only "$ONLY")
   174	[ -n "$LIMIT" ] && PLAN_ARGS+=(--limit "$LIMIT")
   175	[ -n "$CANON_MANIFEST" ] && PLAN_ARGS+=(--canon-ckpt-manifest "$CANON_MANIFEST")
   176	"$PY" "$COLLECT" "${PLAN_ARGS[@]}" || die "PLAN REFUSED (see above) - abort"
   177	DUMP_ROOT="$(jq -r .dump_root "$PLAN")"
   178	mapfile -t CELL_IDS < <(jq -r '.cells[].cell' "$PLAN")
   179	echo "plan: ${#CELL_IDS[@]} cell(s); dump root ${DUMP_ROOT}; farm ${FARM_ROOT}; lanes ${LANES_CSV}"
   180	while read -r path sha; do   # Codex C3a HIGH 1: the configs of the SELECTED (planned) cells
   181	  [ -f "$path" ] || die "CONFIG MISSING: ${path} - abort"
   182	  got="$(sha256sum "$path" | awk '{print $1}')"
   183	  [ "$got" = "$sha" ] || die "CONFIG PIN FAILED: ${path} is ${got}, the manifest pins ${sha} - abort"
   184	done < <(jq -r --slurpfile plan "$PLAN" '($plan[0].cells | map(.cell)) as $sel | [.cells[] | select(.cell | IN($sel[]))
   185	                 | (.model_config + " " + .model_config_sha256), (.dataset_config + " " + .dataset_config_sha256)]
   186	                 | unique[]' "$CELLS")
   187	echo "configs OK: every model / dataset config of the selection matches its manifest pin"
   188	[ "$(jq '[.cells[] | select(.no_flash == true)] | length' "$PLAN")" = "$N_NOFLASH" ] \
   189	  || die "PLAN REFUSED: the plan's exp_35 cells are not the ${N_NOFLASH} counted for the relevant tree - abort"
   190	if [ -n "$COTENANTS" ]; then   # exp_35 §12 B1.1: the approved identity tuple of a SHARED lane
   191	  [ "$N_NOFLASH" -gt 0 ] || die "EXP35_APPROVED_COTENANTS is an exp_35 gate: this selection holds no exp_35 cell - abort"
   192	  [ "$ALLOW_SHARED_GPU" = 1 ] || die "EXP35_APPROVED_COTENANTS names the co-tenants of a shared card: it needs ALLOW_SHARED_GPU=1 - abort"
   193	  [[ "$COTENANTS_SHA" =~ ^[0-9a-f]{64}$ ]] \
   194	    || die "EXP35_APPROVED_COTENANTS needs EXP35_APPROVED_COTENANTS_SHA256 (the launch entry's sha256 of its bytes) - abort"
   195	  "$PY" "$IDENTITY" --validate "$COTENANTS" --approved-sha256 "$COTENANTS_SHA" || die "CO-TENANT TUPLE REFUSED: ${COTENANTS} - abort"
   196	elif [ "$ALLOW_SHARED_GPU" = 1 ] && [ "$N_NOFLASH" -gt 0 ]; then
   197	  die "an exp_35 cell shares a card only with the approved identity tuple: set EXP35_APPROVED_COTENANTS - abort"
   198	fi
   199	if [ "$N_NOFLASH" -gt 0 ]; then   # exp_35 §11 B1: the launcher's own checks, on the CPU, before any spawn
   200	  PREFLIGHT_LOG="$LOGDIR/depth_canon_${TS}_no_flash_preflight.log"
   201	  { CUDA_VISIBLE_DEVICES= HF_HUB_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$REPO/$NO_FLASH_DIR" \
   202	      "$PY" "$NO_FLASH_LAUNCHER" --preflight > "$PREFLIGHT_LOG" 2>&1 \
   203	    && "$PY" "$COLLECT" --check-backend-log "$PREFLIGHT_LOG" --backend-target=--preflight 2>&1 \
   204	       | grep -v -e pkg_resources -e declare_namespace; [ "${PIPESTATUS[0]}" -eq 0 ]; } \
   205	    || die "NO-FLASH PRE-FLIGHT FAILED (log ${PREFLIGHT_LOG}) - abort"
   206	  echo "no-flash pre-flight OK: ${N_NOFLASH} exp_35 cell(s) spawn through ${NO_FLASH_LAUNCHER} (log ${PREFLIGHT_LOG})"
   207	fi
   208	
   209	# --- the dump root, verified ONCE: on the NAS share, created, write-probed ----------- #
   210	nas_identity_ok() {
   211	  local line
   212	  line="$(findmnt -n -T "$1" -o FSTYPE,SOURCE 2>/dev/null || true)"
   213	  grep -qE "^${NAS_FSTYPE}[[:space:]]+${NAS_SOURCE//./\\.}\$" <<<"$line" && return 0
   214	  echo "DUMP ROOT GATE FAILED: ${1} is on '$(tr '\n' ';' <<<"$line")', not '${NAS_FSTYPE} ${NAS_SOURCE}' - abort"
   215	  return 1
   216	}
   217	if [ "$(jq '[.cells[] | select(.dump)] | length' "$PLAN")" -gt 0 ]; then
   218	  [[ "$DUMP_ROOT" = /?* && "$DUMP_ROOT" != *.staging-* ]] || die "DUMP ROOT GATE FAILED: '${DUMP_ROOT}' must be absolute, no '.staging-' - abort"
   219	  [ ! -L "$DUMP_ROOT" ] || die "DUMP ROOT GATE FAILED: ${DUMP_ROOT} is a symlink - abort"
   220	  anc="$DUMP_ROOT"; while [ ! -e "$anc" ] && [ "$anc" != / ]; do anc="$(dirname "$anc")"; done
   221	  nas_identity_ok "$anc" || exit 2
   222	  if [ "$DRY_RUN" = 1 ]; then
   223	    echo "dump root OK under DRY_RUN: ${DUMP_ROOT} ($([ -d "$DUMP_ROOT" ] && echo exists || echo 'would be created'))"
   224	  else
   225	    mkdir -p "$DUMP_ROOT" && nas_identity_ok "$DUMP_ROOT" || die "DUMP ROOT GATE FAILED: cannot create ${DUMP_ROOT} - abort"
   226	    probe="$DUMP_ROOT/.depth_canon_eval_probe_$$"
   227	    { printf 'probe\n' > "$probe" && [ "$(cat "$probe")" = probe ] && rm -f "$probe" && [ ! -e "$probe" ]; } 2>/dev/null \
   228	      || { rm -f "$probe" 2>/dev/null; die "DUMP ROOT GATE FAILED: write probe in ${DUMP_ROOT} - abort"; }
   229	    echo "dump root OK: ${DUMP_ROOT} is ${NAS_FSTYPE} ${NAS_SOURCE}, write probe created + removed"
   230	  fi
   230	  fi
   231	fi
