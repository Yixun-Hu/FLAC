    96	            text = stat.read_text()
    97	            new = text.replace(" 887766 ", " 999999 ") if swap == "start_time" else text.replace(
    98	                "3028196 (", "3028197 (", 1)
    99	            assert new != text
   100	            stat.write_text(new)
   101	        return real(path, *a, **kw)
   102	    monkeypatch.setattr(G.os, "readlink", readlink)
   103	    with pytest.raises(ValueError, match="changed during"):
