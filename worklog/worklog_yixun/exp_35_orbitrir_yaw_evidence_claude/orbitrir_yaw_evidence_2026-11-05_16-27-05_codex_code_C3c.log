  2002	    p, found = cell_paths(row, os.path.join(farm_root, row["arm"], os.path.basename(target)), dump_root), []
  2003	    for rel in (p.metrics, p.stream, p.canon, p.receipt, p.dump_dir):
  2004	        parent, name = os.path.split(os.path.join(base_dir, rel))
  2005	        try:
