    37	def fake_proc(root, pid, *, start=887766, cwd="/home/yixunhu/codespace/flac-fork-attn", cmdline=CMDLINE,
    38	              fd1="/home/yixunhu/codespace/flac-fork-attn/logs/train_s43.log", fd2=None, comm="pt_main (thr) 1"):
    39	    """One /proc/<pid> entry: stat (a comm with spaces and parentheses), cmdline, cwd and fd links."""
    40	    base = root / str(pid)
    41	    if base.exists():
    42	        shutil.rmtree(base)
    43	    (base / "fd").mkdir(parents=True)
    44	    fields = ["S"] + ["7"] * 18 + [str(start)] + ["0"] * 30          # fields 3 .. 52; field 22 = start
    45	    (base / "stat").write_text(f"{pid} ({comm}) " + " ".join(fields) + "\n")
    46	    (base / "cmdline").write_bytes(cmdline)
    47	    os.symlink(cwd, base / "cwd")
    48	    os.symlink(fd1, base / "fd" / "1")
    49	    os.symlink(fd2 or fd1, base / "fd" / "2")
    50	    return root
