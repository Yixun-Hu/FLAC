   471	      [ -z "$LANE_WHY" ] || echo "  GPU ${lane}: ${LANE_WHY}"
   472	      LANE="$lane"; NEXT=$(( (NEXT + k + 1) % ${#LANES[@]} )); return 0
   473	    fi
   474	    if [ "${GPU_NOTE[$lane]:-}" != "${READY}#${POLLS}" ]; then   # once per waiting cell / poll
   475	      echo "  GPU ${lane}: ${LANE_WHY} - waiting (nothing is ever signalled)"
   476	      GPU_NOTE[$lane]="${READY}#${POLLS}"
   477	    fi
   478	  done
   479	  return 1
   480	}
   481	gpu_wait() {   # one counted poll of the GPU gate; sets ABORT when the budget is spent
   482	  POLLS=$((POLLS + 1))
   483	  if [ "$GPU_MAX_POLLS" -gt 0 ] && [ "$POLLS" -ge "$GPU_MAX_POLLS" ]; then
   484	    ABORT="GPU GATE: no usable lane (>= ${MIN_GPU_FREE_MIB} MiB free, unoccupied) after ${POLLS} poll(s)"; return
   485	  fi
   486	  sleep "$GPU_POLL_SECONDS"
   487	}
   488	while :; do
   489	  reap
   490	  if [ -n "$ABORT" ] || [ "$i" -ge "$N_SEL" ]; then [ "${#PID_CELL[@]}" -eq 0 ] && break; sleep 2; continue; fi
   491	  if [ -z "$READY" ]; then
   492	    prepare_cell "${CELL_IDS[$i]}"; st=$?
   493	    [ "$st" -eq 1 ] && { ABORT="cell ${CELL_IDS[$i]} refused"; continue; }
   494	    [ "$st" -eq 3 ] && { N_SKIP=$((N_SKIP + 1)); i=$((i + 1)); continue; }
   495	    READY="${CELL_IDS[$i]}"
   496	  fi
   497	  [ "${#PID_CELL[@]}" -lt "${#LANES[@]}" ] || { sleep 2; continue; }
   498	  if ! pick_lane; then
   499	    [ -n "$ABORT" ] && continue
   500	    if [ "${#PID_CELL[@]}" -gt 0 ]; then sleep 10; continue; fi   # a lane is busy: re-check soon
   501	    gpu_wait; continue
   502	  fi
   503	  POLLS=0
   504	  [ "$(git rev-parse HEAD)" = "$EXPECT_HEAD" ] || { ABORT="PIN DRIFT: HEAD moved during the campaign"; DRIFT=1; continue; }
   505	  SPAWN_DIGEST="$(tree_digest)" || SPAWN_DIGEST=""     # the evaluated bytes, before EVERY spawn (Codex rB)
   506	  if [ "$SPAWN_DIGEST" != "$CAMPAIGN_DIGEST" ] || [ -n "$(tree_dirty)" ]; then
   507	    ABORT="PIN DRIFT: the relevant tree changed during the campaign (digest '${SPAWN_DIGEST}' != ${CAMPAIGN_DIGEST}); no further cell is spawned"
   508	    DRIFT=1; continue
   509	  fi
   510	  lane_state "$LANE"; st=$?                  # re-checked immediately before the spawn (Codex rB HIGH)
   511	  if [ "$st" -ne 0 ]; then
   512	    [ "$st" -eq 2 ] && { ABORT="GPU GATE FAILED: ${LANE_WHY}"; continue; }
   513	    echo "  GPU ${LANE}: changed at the re-check before the spawn (${LANE_WHY}) - not spawned"
   514	    gpu_wait; continue
   515	  fi
   516	  farm_entry_ok "$LINK" "$CACHED" || { ABORT="FARM GATE FAILED: ${LINK} is no longer the hard link of ${CACHED}"; continue; }
   517	  # rB-F2 F2-6 (b): the contract + a full re-hash of the very file the evaluator will open, right now
   518	  cache_ok "$CACHED" "$SHA" || { ABORT="CACHE GATE FAILED before the spawn of ${READY}: ${CACHE_WHY}"; continue; }
   519	  echo "  checkpoint re-verified before the spawn: ${CACHED} (0444, ${CKPT_SIZE[$SHA]} bytes, ${SHA})"
   520	  echo "  RUN ${READY} on GPU ${LANE} (log $LOGDIR/depth_canon_${TS}_eval_${READY}.log)"
   521	  run_cell "$LANE" "$READY" "$SHA" "$SPAWN_DIGEST" "$LINK" "$CACHED" "$NOFLASH" "${ARGV[@]}" &
   522	  LANE_PID[$LANE]=$!; PID_CELL[$!]="$READY"; PID_LANE[$!]="$LANE"
   523	  READY=""; i=$((i + 1))
   524	done
   525	COMPLETE=$((N_SKIP + N_DONE))
   526	echo "=== summary: selected ${N_SEL} | skipped (complete and verified) ${N_SKIP} | ran ok ${N_DONE} | failed ${#FAILED[@]} | not run $((N_SEL - COMPLETE - ${#FAILED[@]})) ==="
   527	for c in "${FAILED[@]}"; do echo "  FAILED ${c}"; done
   528	echo "completion: ${COMPLETE}/${N_SEL} selected cell(s) complete and verified (manifest: $(jq '.cells | length' "$CELLS") cells)"
   529	[ -z "$ABORT" ] || { echo "ABORTED: ${ABORT} - abort"; [ -z "$DRIFT" ] || exit 4; exit 2; }
   530	[ "${#FAILED[@]}" -eq 0 ] && [ "$COMPLETE" -eq "$N_SEL" ] && { echo "CAMPAIGN SELECTION COMPLETE"; exit 0; }
   531	echo "CAMPAIGN SELECTION INCOMPLETE - re-run to resume"
   532	exit 1

