     1	#!/usr/bin/env python3
     2	"""exp_35 training guard (plan_orbitrir_yaw_evidence.md r2 §7 "Guard", r3 §12 B2, r4 §13 NIT 1): a READ-ONLY parser
     3	of Yixun's s43 training log. It reads that one file; it writes nothing and signals nothing.
     4	
     5	The log is PyTorch Lightning's tqdm bar, ``Epoch E:  P%|bar| n/T [elapsed<remaining, rate, postfix]``, refreshed
     6	with ``\\r`` (``\\n`` works too). For each step n of an epoch the FIRST line that shows it gives the time step n
     7	completed (a postfix refresh repeats the line; the epoch-end validation re-prints the last step with a later elapsed);
     8	the elapsed field restarts with each epoch, so the validation between epochs lies in no window (PL's bar reset after
     9	it, "Epoch E: 0/T [00:00<" under the old label once step T was seen, is skipped). Windows align to the
    10	epoch's step counter -- [0, 100], [100, 200], ... and [0, 500], ... -- and a window is complete once a step at or past
    11	its end was seen (an epoch's tail beyond its last full window is in none). Only the bytes up to the last line
    12	terminator are parsed (a line being written is not).
    13	
    14	  STOP (exit 1), judged over the completed windows that END after the baseline step (our first spawn; before a
    15	  baseline nothing is judged), thresholds exact and strict: any 500-step window > 9.712 s/step; any 100-step window
    16	  > 9.950 s/step; the mean s/step since the baseline (the within-epoch elapsed of the steps after it) > 8.521.
    17	  HARD STOP (exit 2): against the persisted anchor the log's inode changed or its size shrank, or the 4 KiB before
    18	  the anchor offset changed (a copy-truncate-and-regrow); a step went backwards within an epoch, an epoch number
    19	  went backwards, or the bar total changed (a restart or another run in the same file); no training-bar line.
    20	  REFUSED (exit 3): the log or the anchor file is unreadable, the anchor is malformed (its exact schema and types
    21	  are checked before anything is judged), or the arguments are bad.   OK (exit 0): none of these.
    22	
    23	  --log PATH [--baseline-step N] [--anchor FILE]   prints the observation (JSON, with the NEW anchor) and exits 0-3
    24	
    25	Written by the exp_35 Coder (Claude Opus 5.5, max effort) per plan_orbitrir_yaw_evidence.md r2/r3/r4.
    26	"""
    27	import argparse
    28	import hashlib
    29	import json
    30	import os
    31	import re
    32	import sys
    33	
    34	W500, W100, MEAN = 9.712, 9.950, 8.521        # §7: s/step, strict >
    35	ANCHOR_BYTES = 4096                             # §13 NIT 1: the sha256 of the last 4 KiB parsed
    36	EXIT_OK, EXIT_STOP, EXIT_HARD, EXIT_REFUSED = 0, 1, 2, 3
    37	MAX_STEPS = 40000                               # the s43 training's max_steps
    38	ANCHOR_KEYS = ("inode", "device", "size", "offset", "tail_sha256")
    39	LINE = re.compile(r"Epoch (\d+):\s+\d+%\|[^|\r\n]*\|\s*(\d+)/(\d+) \[(\d+(?::\d\d){1,2})<")
    40	
    41	
    42	def _seconds(text):
    43	    parts = [int(x) for x in text.split(":")]
    44	    return parts[0] * 60 + parts[1] if len(parts) == 2 else parts[0] * 3600 + parts[1] * 60 + parts[2]
    45	
    46	
    47	def parse(text):
    48	    """``({epoch: {"total": T, "steps": {n: elapsed s}}}, errors)`` -- the first sighting of each step; a repeat is
    49	    accepted only for the latest step (a refresh, the post-validation re-print)."""
    50	    epochs, errors, last = {}, [], None
    51	    for m in LINE.finditer(text):
    52	        e, n, total, el = int(m[1]), int(m[2]), int(m[3]), _seconds(m[4])
    53	        if last is not None and e < last:
    54	            return epochs, [f"epoch {e} after epoch {last}: a restart in the same log"]
    55	        first = epochs[min(epochs)]["total"] if epochs else total
    56	        if total != first:
    57	            return epochs, [f"epoch {e}: the bar total changed ({first} -> {total}): another run in the same log"]
    58	        ep = epochs.setdefault(e, {"total": total, "steps": {}})
    59	        top = max(ep["steps"]) if ep["steps"] else None
    60	        if (n, el, top) == (0, 0, total):
    61	            continue        # PL resets the bar under the OLD label after the validation (the real s43 log)
    62	        if top is not None and (n < top or (n > top and el < ep["steps"][top])):
    63	            return epochs, [f"epoch {e}: step {n} at {el} s after step {top} at {ep['steps'][top]} s: the bar went backwards"]
    64	        ep["steps"].setdefault(n, el)
    65	        last = e
    66	    return epochs, errors
    67	
    68	
    69	def windows(epochs, size):
    70	    """Completed ``size``-step windows ``(epoch, start, global end, s/step)``: from the last sample at or before the
    71	    start to the first sample at or after the end, within one epoch."""
    72	    out = []
    73	    for e, ep in sorted(epochs.items()):
    74	        ns, T = sorted(ep["steps"]), ep["total"]
    75	        for a in range(0, T - size + 1, size):
    76	            lo, hi = [n for n in ns if n <= a], [n for n in ns if n >= a + size]
    77	            if lo and hi:
    78	                out.append((e, a, e * T + a + size, (ep["steps"][hi[0]] - ep["steps"][lo[-1]]) / (hi[0] - lo[-1])))
    79	    return out
    80	
    81	
    82	def mean_since(epochs, baseline):
    83	    """``(mean s/step, steps)`` of the steps completed after global step ``baseline`` (within-epoch elapsed only)."""
    84	    t = steps = 0
    85	    for e, ep in epochs.items():
    86	        ns = [n for n in sorted(ep["steps"]) if e * ep["total"] + n >= baseline]
    87	        if len(ns) > 1:
    88	            t, steps = t + ep["steps"][ns[-1]] - ep["steps"][ns[0]], steps + ns[-1] - ns[0]
    89	    return (t / steps if steps else None), steps
    90	
    91	
    92	def judge(epochs, baseline):
    93	    """(STOP reasons, the window summary): thresholds over the windows ending after ``baseline`` and the mean."""
    94	    reasons, summary = [], {}
    95	    for size, limit in ((500, W500), (100, W100)):
    96	        got = [w for w in windows(epochs, size) if baseline is not None and w[2] > baseline]
    97	        reasons += [f"the {size}-step window epoch {e} steps {a}-{a + size} ran {r:.3f} s/step > {limit}"
    98	                    for e, a, _, r in got if r > limit]
    99	        worst = max(got, key=lambda w: w[3], default=None)
   100	        summary[str(size)] = {"judged": len(got), "limit": limit, "worst": None if worst is None else {
   101	            "epoch": worst[0], "start": worst[1], "s_per_step": worst[3]}}
   102	    mean, n = mean_since(epochs, baseline) if baseline is not None else (None, 0)
   103	    reasons += [f"the mean since the baseline step {baseline} ran {mean:.3f} s/step over {n} steps > {MEAN}"] if (
   104	        mean is not None and mean > MEAN) else []
   105	    return reasons, summary, {"s_per_step": mean, "steps": n, "limit": MEAN}
   106	
   107	
   108	def read_log(path):
   109	    """``(stat, bytes, end)``: ONE fd, ``st_size`` bytes from offset 0, ``end`` = just past the last terminator."""
   110	    fd = os.open(path, os.O_RDONLY)
   111	    try:
   112	        st, chunks, off = os.fstat(fd), [], 0
   113	        while off < st.st_size:
   114	            b = os.pread(fd, st.st_size - off, off)
   115	            if not b:
   116	                break
   117	            chunks.append(b)
   118	            off += len(b)
   119	    finally:
   120	        os.close(fd)
   121	    raw = b"".join(chunks)
   122	    return st, raw, max(raw.rfind(b"\r"), raw.rfind(b"\n")) + 1
   123	
   124	
   125	def anchor_of(st, raw, end):
   126	    return {"inode": st.st_ino, "device": st.st_dev, "size": len(raw), "offset": end,
   127	            "tail_sha256": hashlib.sha256(raw[max(0, end - ANCHOR_BYTES):end]).hexdigest()}
   128	
   129	
   130	def anchor_schema_reasons(anchor):
   131	    """[] iff ``anchor`` is None or exactly what ``anchor_of`` writes (Codex C3b NIT 1)."""
   132	    if anchor is None:
   133	        return []
   134	    ok = isinstance(anchor, dict) and list(anchor) == list(ANCHOR_KEYS) and all(
   135	        type(anchor[k]) is int and anchor[k] >= 0 for k in ANCHOR_KEYS[:4]) and anchor["offset"] <= anchor["size"] \
   136	        and isinstance(anchor["tail_sha256"], str) and re.fullmatch(r"[0-9a-f]{64}", anchor["tail_sha256"]) is not None
   137	    return [] if ok else [f"the persisted anchor is malformed: {anchor!r:.200}"]
   138	
   139	
   140	def anchor_reasons(st, raw, anchor):
   141	    """HARD STOP reasons of this read against the persisted ``anchor`` (None: the first observation)."""
   142	    if anchor is None:
   143	        return []
   144	    if (st.st_ino, st.st_dev) != (anchor["inode"], anchor["device"]):
   145	        return [f"the log's inode changed ({anchor['inode']} -> {st.st_ino}): rotated or replaced"]
   146	    if len(raw) < anchor["size"]:
   147	        return [f"the log shrank ({anchor['size']} -> {len(raw)} bytes)"]
   148	    off = anchor["offset"]
   149	    if hashlib.sha256(raw[max(0, off - ANCHOR_BYTES):off]).hexdigest() != anchor["tail_sha256"]:
   150	        return [f"the {ANCHOR_BYTES} bytes before the anchor offset {off} changed: a copy-truncate-and-regrow"]
   151	    return []
   152	
   153	
   154	def observe(path, *, baseline=None, anchor=None):
   155	    """One read-only observation of the log: status, exit code, reasons, the step, the windows, the new anchor."""
   156	    out = {"status": "REFUSED", "exit": EXIT_REFUSED, "reasons": [], "baseline": baseline,
   157	           "thresholds": {"w500": W500, "w100": W100, "mean": MEAN}}
   158	    if anchor_schema_reasons(anchor):
   159	        return dict(out, reasons=anchor_schema_reasons(anchor))
   160	    try:
   161	        st, raw, end = read_log(path)
   162	    except OSError as err:
   163	        return dict(out, reasons=[f"the log {path} is unreadable ({err})"])
   164	    epochs, errors = parse(raw[:end].decode("utf-8", "replace"))
   165	    hard = anchor_reasons(st, raw, anchor) + errors + ([] if epochs else ["no training-bar line in the log"])
   166	    reasons, summary, mean = judge(epochs, baseline) if not hard else ([], {}, None)
   167	    e = max(epochs) if epochs else None
   168	    n = max(epochs[e]["steps"]) if e is not None else None
   169	    step = None if e is None else {"epoch": e, "n": n, "total": epochs[e]["total"], "global": e * epochs[e]["total"] + n}
   170	    status = "HARD_STOP" if hard else "STOP" if reasons else "OK"
   171	    return dict(out, status=status, exit={"HARD_STOP": EXIT_HARD, "STOP": EXIT_STOP, "OK": EXIT_OK}[status],
   172	                reasons=hard or reasons, step=step, finished=bool(step and step["global"] >= MAX_STEPS),
   173	                windows=summary, mean_since_baseline=mean, anchor=anchor_of(st, raw, end),
   174	                log={"path": path, "inode": st.st_ino, "size": len(raw), "mtime": st.st_mtime})
   175	
   176	
   177	def main(argv=None):
   178	    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   179	    ap.add_argument("--log", required=True)
   180	    ap.add_argument("--baseline-step", type=int, default=None)
   181	    ap.add_argument("--anchor", default=None, help="a JSON file holding the persisted anchor (read only)")
   182	    args = ap.parse_args(argv)
   183	    anchor = None
   184	    if args.anchor:
   185	        try:
   186	            with open(args.anchor) as f:
   187	                anchor = json.load(f)
   188	        except (OSError, ValueError) as err:
   189	            print(json.dumps({"status": "REFUSED", "exit": EXIT_REFUSED, "reasons": [f"the anchor is unreadable ({err})"]}))
   190	            return EXIT_REFUSED
   191	    report = observe(args.log, baseline=args.baseline_step, anchor=anchor)
   192	    print(json.dumps(report, indent=1))
   193	    return report["exit"]
   194	
   195	
   196	if __name__ == "__main__":
   197	    sys.exit(main())
     1	#!/usr/bin/env python3
     2	"""exp_35 co-tenant identity (plan_orbitrir_yaw_evidence.md r3 §12 B1.1-B1.2): the approved identity tuple
     3	of the foreign compute processes a shared lane may hold, bound MECHANICALLY through /proc -- PID, start time
     4	(``/proc/<pid>/stat`` field 22), cwd, the sha256 of ``/proc/<pid>/cmdline``, and ``readlink /proc/<pid>/fd/1``
     5	and ``fd/2`` (the log the process writes) -- never an asserted string.
     6	
     7	Used by ``depth_canon_eval_run.sh`` at its lane checks (``--check``; any extra / missing / changed process
     8	refuses the cell) and by ``exp35_supervisor.py``. Read-only: it reads /proc, writes nothing, signals nothing.
     9	
    10	  --snapshot --gpu-uuid U --pid P [--pid Q]   print the tuple of live processes (the launch entry freezes it)
    11	  --validate FILE                             exit 0 iff FILE is a well-formed tuple
    12	  --check --approved FILE --gpu-uuid U --pids P,Q   exit 0 iff the observed set EQUALS the tuple (1 mismatch,
    13	                                              2 refused: unreadable / malformed)
    14	
    15	Written by the exp_35 Coder (Claude Opus 5.5, max effort) per plan_orbitrir_yaw_evidence.md r3 §12.
    16	"""
    17	import argparse
    18	import hashlib
    19	import json
    20	import os
    21	import re
    22	import sys
    23	
    24	SCHEMA_VERSION = 1
    25	FIELDS = ("pid", "start_time", "cwd", "cmdline_sha256", "fd1", "fd2")
    26	TUPLE_KEYS = ("schema_version", "gpu_uuid", "processes")
    27	
    28	
    29	def _stat_identity(text):
    30	    """``(pid, start time)`` from a ``/proc/<pid>/stat`` line: field 1 and field 22 (fields 3.. follow the
    31	    comm, which may hold spaces and parentheses -- hence the LAST ')')."""
    32	    return int(text.split(" ", 1)[0]), int(text[text.rindex(")") + 2:].split()[19])
    33	
    34	
    35	def proc_identity(pid, proc="/proc"):
    36	    """The identity of a LIVE process from ``proc``; ``ValueError`` when it is gone or unreadable, or when
    37	    its entry changed during the sample (Codex C2 HIGH 1): every field is read through ONE directory fd of
    38	    ``/proc/<pid>`` (bound to that process, dead or alive), between two stat reads that must agree."""
    39	    pid = int(pid)
    40	    try:
    41	        fd = os.open(os.path.join(proc, str(pid)), os.O_RDONLY | os.O_DIRECTORY)
    42	    except OSError as err:
    43	        raise ValueError(f"process {pid}: its /proc identity is unreadable ({type(err).__name__}: {err})") from err
    44	    opener = lambda path, flags: os.open(path, flags, dir_fd=fd)  # noqa: E731
    45	    try:
    46	        with open("stat", opener=opener) as f:
    47	            first = _stat_identity(f.read())
    48	        with open("cmdline", "rb", opener=opener) as f:
    49	            cmdline = f.read()
    50	        links = [os.readlink(p, dir_fd=fd) for p in ("cwd", "fd/1", "fd/2")]
    51	        with open("stat", opener=opener) as f:
    52	            second = _stat_identity(f.read())
    53	    except (OSError, ValueError, IndexError) as err:
    54	        raise ValueError(f"process {pid}: its /proc identity is unreadable ({type(err).__name__}: {err})") from err
    55	    finally:
    56	        os.close(fd)
    57	    if not first == second == (pid, first[1]):
    58	        raise ValueError(f"process {pid}: its /proc entry changed during the sample ((pid, start time) {first} -> "
    59	                         f"{second}): PID reuse, no identity")
    60	    return {"pid": pid, "start_time": first[1], "cwd": links[0],
    61	            "cmdline_sha256": hashlib.sha256(cmdline).hexdigest(), "fd1": links[1], "fd2": links[2]}
    62	
    63	
    64	def tuple_reasons(doc):
    65	    """Named reasons ``doc`` is not a well-formed approved tuple ([] = valid)."""
    66	    if not isinstance(doc, dict) or list(doc) != list(TUPLE_KEYS):
    67	        return [f"the tuple's keys are {list(doc) if isinstance(doc, dict) else doc!r}, not {list(TUPLE_KEYS)}"]
    68	    out = [] if doc["schema_version"] == SCHEMA_VERSION and type(doc["schema_version"]) is int else [
    69	        f"schema_version {doc['schema_version']!r} != {SCHEMA_VERSION}"]
    70	    if not (isinstance(doc["gpu_uuid"], str) and re.fullmatch(r"GPU-[0-9A-Za-z-]+", doc["gpu_uuid"])):
    71	        out.append(f"gpu_uuid {doc['gpu_uuid']!r} is not a GPU uuid")
    72	    procs = doc["processes"]
    73	    if not (isinstance(procs, list) and procs):
    74	        return out + ["processes must be a non-empty list"]
    75	    for p in procs:
    76	        if not (isinstance(p, dict) and list(p) == list(FIELDS) and type(p["pid"]) is int and p["pid"] > 0
    77	                and type(p["start_time"]) is int and all(isinstance(p[k], str) and p[k] for k in FIELDS[2:])
    78	                and re.fullmatch(r"[0-9a-f]{64}", p["cmdline_sha256"])):
    79	            out.append(f"malformed process entry {p!r:.160}")
    80	    pids = [p.get("pid") for p in procs if isinstance(p, dict)]
    81	    return out + ([f"duplicate pids {pids}"] if len(set(pids)) != len(pids) else [])
    82	
    83	
    84	def load_tuple(path, sha256=None):
    85	    """The approved tuple at ``path``; ``ValueError`` when it is unreadable or malformed, or (Codex C2
    86	    BLOCKING 1) when the bytes read -- ONCE, then parsed -- do not hash to the launch entry's ``sha256``."""
    87	    try:
    88	        with open(path, "rb") as f:
    89	            raw = f.read()
    90	    except OSError as err:
    91	        raise ValueError(f"the approved tuple {path} is unreadable ({err})") from err
    92	    got = hashlib.sha256(raw).hexdigest()
    93	    if sha256 is not None and got != sha256:
    94	        raise ValueError(f"the approved tuple {path} hashes to {got}, the launch entry pins {sha256}")
    95	    try:
    96	        doc = json.loads(raw)
    97	    except ValueError as err:
    98	        raise ValueError(f"the approved tuple {path} is unreadable ({err})") from err
    99	    reasons = tuple_reasons(doc)
   100	    if reasons:
   101	        raise ValueError(f"the approved tuple {path} is malformed: " + "; ".join(reasons))
   102	    return doc
   103	
   104	
   105	def check_reasons(observed_pids, gpu_uuid, approved, proc="/proc"):
   106	    """[] iff the foreign compute processes observed on ``gpu_uuid`` are EXACTLY the approved tuple's,
   107	    each with its identity unchanged (a reused PID has another start time / cmdline / cwd / log)."""
   108	    out = [] if gpu_uuid == approved["gpu_uuid"] else [
   109	        f"the lane is {gpu_uuid}, the approved tuple names {approved['gpu_uuid']}"]
   110	    want, got = sorted(p["pid"] for p in approved["processes"]), sorted(set(observed_pids))
   111	    if got != want or len(got) != len(observed_pids):
   112	        out.append(f"the foreign compute processes on {gpu_uuid} are {sorted(observed_pids)}, the approved tuple "
   113	                   f"{want} (an extra, missing or replaced process)")
   114	    for p in approved["processes"]:
   115	        try:
   116	            live = proc_identity(p["pid"], proc)
   117	        except ValueError as err:
   118	            out.append(str(err))
   119	            continue
   120	        changed = [k for k in FIELDS if live[k] != p[k]]
   121	        if changed:
   122	            out.append(f"process {p['pid']}: {changed} differ from the approved tuple (PID reuse or another process)")
   123	    return out
   124	
   125	
   126	def _pids(text):
   127	    return [int(x) for x in text.split(",") if x.strip()] if text else []
   128	
   129	
   130	def main(argv=None):
   131	    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   132	    mode = ap.add_mutually_exclusive_group(required=True)
   133	    mode.add_argument("--snapshot", action="store_true")
   134	    mode.add_argument("--validate", metavar="FILE")
   135	    mode.add_argument("--check", action="store_true")
   136	    ap.add_argument("--approved")
   137	    ap.add_argument("--approved-sha256", default=None, help="the launch entry's sha256 of the tuple's bytes")
   138	    ap.add_argument("--gpu-uuid")
   139	    ap.add_argument("--pid", type=int, action="append", default=[])
