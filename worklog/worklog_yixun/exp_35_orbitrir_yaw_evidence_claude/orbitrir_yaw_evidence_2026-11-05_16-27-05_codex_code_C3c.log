   348	def gpu_map(text):
   349	    """``{index: uuid}`` from ``nvidia-smi --query-gpu=index,uuid --format=csv,noheader``; ValueError when malformed."""
   350	    out = {}
   351	    for line in [ln for ln in text.splitlines() if ln.strip()]:
   352	        m = re.fullmatch(r"\s*(\d+),\s*(GPU-[0-9A-Za-z-]+)\s*", line)
   353	        if not m or int(m[1]) in out or m[2] in out.values():
   354	            raise ValueError(f"malformed or duplicate nvidia-smi index,uuid row {line!r}")
   355	        out[int(m[1])] = m[2]
   356	    if not out:
   357	        raise ValueError("nvidia-smi lists no GPU")
   358	    return out
