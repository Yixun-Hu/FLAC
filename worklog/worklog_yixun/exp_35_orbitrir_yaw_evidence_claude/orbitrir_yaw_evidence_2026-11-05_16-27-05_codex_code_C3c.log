    87	def test_an_entry_that_changes_during_the_sample_is_refused(proc, monkeypatch, swap):
    88	    """Codex C2 HIGH 1: stat is read before AND after cmdline / cwd / fd; a PID reused in between (its
    89	    entry rewritten after the first stat read) never yields a mixed identity."""
