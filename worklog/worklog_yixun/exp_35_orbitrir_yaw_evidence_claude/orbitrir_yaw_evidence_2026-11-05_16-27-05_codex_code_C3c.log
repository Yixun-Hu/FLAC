   372	def descendants(pid, proc="/proc"):
   373	    """``pid`` and every process below it (by the ppid of ``/proc/<p>/stat``): our runner's own subtree."""
   374	    parent = {}
   375	    for name in os.listdir(proc):
   376	        if name.isdigit():
   377	            try:
   378	                with open(os.path.join(proc, name, "stat")) as f:
   379	                    text = f.read()
   380	                parent[int(name)] = int(text[text.rindex(")") + 2:].split()[1])
   381	            except (OSError, ValueError, IndexError):
   382	                continue
   383	    out, todo = set(), [pid] if pid in parent else []
   384	    while todo:
   385	        p = todo.pop()
   386	        out.add(p)
   387	        todo += [c for c, pp in parent.items() if pp == p and c not in out]
   388	    return out
