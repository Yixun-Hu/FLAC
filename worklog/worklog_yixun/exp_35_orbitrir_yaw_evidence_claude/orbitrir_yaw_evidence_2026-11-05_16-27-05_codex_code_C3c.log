   361	def compute_apps(text):
   362	    """``[(pid, uuid)]`` from ``nvidia-smi --query-compute-apps=pid,gpu_uuid --format=csv,noheader``."""
   363	    out = []
   364	    for line in [ln for ln in text.splitlines() if ln.strip()]:
   365	        m = re.fullmatch(r"\s*(\d+),\s*(GPU-[0-9A-Za-z-]+)\s*", line)
   366	        if not m:
   367	            raise ValueError(f"malformed nvidia-smi compute-app row {line!r}")
   368	        out.append((int(m[1]), m[2]))
   369	    return out
