  2072	def tables(cells, external, e2, e2f):
  2073	    """§1 (a) theta = 0, (b) 45 degrees and random yaw, (c) the Tier 3 spread. A reused exp_25 row is a pointer
  2074	    into ``external_reference`` (§5 item 3); every computed mean names its source; the A6 CSV reaches (b) only as
  2075	    E2's PASS rows (§5 item 6); on an E2 FAIL the 45-degree FLAC / OrbitRIR points are the s42 one-pin cells (§4)."""
