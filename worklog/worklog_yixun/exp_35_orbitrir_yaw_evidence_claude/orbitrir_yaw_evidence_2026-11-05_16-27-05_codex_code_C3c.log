  2114	    problems = [f"E2 {e2['status']} but {len(present)} E2-FAIL cell(s) exist ({', '.join(present[:3])}): that block "
  2115	                "runs only after an E2 FAIL (§14 A1)"] if present and not fail else []
  2116	    problems += [f"stream registry: {x}" for x in registry_why] + [
