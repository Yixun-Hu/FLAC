   138	
   139	def _gate_reasons(c, latched):
   140	    """A chunk's gate result: well formed; passed when gates_verified; a failure only under the stop latch."""
   141	    g, n = c["gate"], c["n"]
   142	    if g is None or (c["state"] == "runner_verified" and not any(k in c for k in GATE_KEYS[g])):
   143	        return []
   144	    if not all(k in c for k in GATE_KEYS[g]):
   145	        return [f"chunk {n}: an incomplete {g} result"]
   146	    if g == "PROBE":
   147	        pc = c["probe_contract"]
   148	        if not (isinstance(pc, dict) and list(pc) == ["rc", "out"] and type(pc["rc"]) is int and isinstance(pc["out"], str)):
   149	            return [f"chunk {n}: a malformed probe contract result"]
   150	        passed = pc["rc"] == 0 and all(_hex(c[k]) for k in GATE_KEYS[g][1:])
   151	    else:
   152	        r, (names, other, good) = c[GATE_KEYS[g][0]], VERDICTS[g]
   153	        if not (isinstance(r, dict) and list(r) == ["rc", "verdict", "out"] and type(r["rc"]) is int
   154	                and isinstance(r["out"], str) and r["verdict"] == names.get(r["rc"], other)):
   155	            return [f"chunk {n}: a malformed {g} result {r!r:.120}"]
   156	        passed = r["rc"] in good
   157	    if not passed and (c["state"] == "gates_verified" or not latched):
   158	        return [f"chunk {n}: a failed {g} result in a {c['state']} chunk" + ("" if latched else " without the stop latch")]
   159	    return []
   160	
   161	
   162	def _chunk_reasons(c, latched):
   163	    """Codex C3b BLOCKING 1: each state carries exactly the evidence it claims."""
   164	    n, st, cell = c["n"], c["state"], c["kind"] == "cell"
   165	    keys, base, flight = set(c), set(CHUNK_BASE), set(CHUNK_BASE + CHUNK_FLIGHT)
   166	    if st == "planned":
   167	        return [] if keys == base else [f"chunk {n}: a planned chunk carries {sorted(keys - base)}"]
   168	    if not flight <= keys:
   169	        return [f"chunk {n} ({st}): missing {sorted(flight - keys)}"]
   170	    out = [] if (isinstance(c["lane"], str) and GPU_RE.fullmatch(c["lane"]) and type(c["shared"]) is bool
   171	                 and c["shared"] == (c["lane"] == GPU1_UUID) and _text(c["started"]) and _text(c["log"])) else [
   172	        f"chunk {n}: a malformed lane / shared / started / log"]
   173	    rc_key = "runner_rc" if cell else "probe_rc"
   174	    run, receipt = {"ended", rc_key}, {"receipt_sha256", "campaign_digest"} if cell else set()
   175	    extra = keys - flight
   176	    if st == "in_flight":                         # a crash mid-chunk (bare) or a recorded failure (under the latch)
   177	        if extra and (extra != run or not latched or type(c[rc_key]) is not int or not _text(c["ended"])):
   178	            return out + [f"chunk {n}: in flight with {sorted(extra)} (a recorded failure: exactly {sorted(run)}, an int "
   179	                          "rc and its end, under the stop latch)"]
   180	        return out
   181	    gate, adopt = set(GATE_KEYS[c["gate"]]), {"adopted_at_restart"} if cell else set()
   182	    final = {"final_guard"} if st == "gates_verified" else set()
   183	    need = run | receipt | (gate | final if st == "gates_verified" else set())
   184	    if not need <= extra or extra - run - receipt - gate - adopt - final:
   185	        return out + [f"chunk {n} ({st}): carries {sorted(extra)}, needs {sorted(need)}"]
   186	    adopted = c.get("adopted_at_restart") is True
   187	    if "adopted_at_restart" in c and not adopted:
   188	        out.append(f"chunk {n}: adopted_at_restart {c['adopted_at_restart']!r}")
   189	    if not ((type(c[rc_key]) is int and c[rc_key] == 0) or (adopted and c[rc_key] is None)):
   190	        out.append(f"chunk {n}: rc {c[rc_key]!r} in a {st} chunk")
   191	    if not (_text(c["ended"]) or (adopted and c["ended"] is None)):
   192	        out.append(f"chunk {n}: ended {c['ended']!r}")
   193	    if cell and not (_hex(c["receipt_sha256"]) and _hex(c["campaign_digest"])):
   194	        out.append(f"chunk {n}: the receipt / campaign digest are not sha256 values")
   195	    fg = c.get("final_guard")
   196	    if st == "gates_verified" and not (
   197	            isinstance(fg, dict) and list(fg) == ["status", "exit", "t", "time", "step", "anchor"] and fg["status"] == "OK"
   198	            and type(fg["exit"]) is int and fg["exit"] == 0 and _num(fg["t"]) and _text(fg["time"])
   199	            and type(fg["step"]) is int and fg["step"] >= 0 and fg["anchor"] is not None
   200	            and not guard_module().anchor_schema_reasons(fg["anchor"])):
   201	        out.append(f"chunk {n}: gates_verified without a passing final-guard record ({fg!r:.120})")
   202	    return out + _gate_reasons(c, latched)
   203	
   204	
   205	def _top_reasons(doc, his_log, reservations):
   206	    """baseline (on THE configured log), the guard anchor, lane + reservation (in THE configured directory), the latch,
   207	    the events -- exact (Codex C3b BLOCKING 1, C3c BLOCKING 1)."""
   208	    b, lane, res, latch = doc["baseline"], doc["lane"], doc["reservation"], doc["stop_latch"]
   209	    out = [] if b is None or (isinstance(b, dict) and list(b) == ["time", "step", "log"] and _num(b["time"])
   210	                              and type(b["step"]) is int and b["step"] >= 0 and isinstance(b["log"], dict)
   211	                              and list(b["log"]) == ["path", "inode", "size"] and b["log"]["path"] == his_log
   212	                              and type(b["log"]["inode"]) is int and b["log"]["inode"] >= 0
   213	                              and type(b["log"]["size"]) is int and b["log"]["size"] >= 0) else [
   214	        f"a malformed baseline, or one on another log than {his_log}: {b!r:.160}"]
   215	    out += guard_module().anchor_schema_reasons(doc["his_log_anchor"])
   216	    if (lane is None) != (res is None):
   217	        out.append("the lane and the reservation must be set together")
   218	    elif lane is not None and not (
   219	            isinstance(lane, dict) and list(lane) == ["uuid", "shared"] and isinstance(lane["uuid"], str)
   220	            and GPU_RE.fullmatch(lane["uuid"]) and type(lane["shared"]) is bool and lane["shared"] == (lane["uuid"] == GPU1_UUID)
   221	            and isinstance(res, dict) and list(res) == ["uuid", "epoch", "path", "sha256"] and res["uuid"] == lane["uuid"]
   222	            and type(res["epoch"]) is int and res["epoch"] >= 1 and res["path"] == reservation_path(reservations, res["uuid"])
   223	            and _hex(res["sha256"])):
   224	        out.append(f"the lane {lane!r} and the reservation {res!r} do not agree")
   225	    if latch is not None and not (isinstance(latch, dict) and list(latch) == ["reason", "time"]
   226	                                  and _text(latch["reason"]) and _text(latch["time"])):
   227	        out.append(f"a malformed stop latch {latch!r:.120}")
   228	    if not (isinstance(doc["events"], list) and all(isinstance(e, dict) and _num(e.get("t")) and _text(e.get("time"))
   229	                                                    and _text(e.get("what")) for e in doc["events"])):
   230	        out.append("malformed events")
   231	    return out
   232	
   233	
   234	def state_reasons(doc, *, h35, cells_sha256, supervisor_sha256, approved_sha256, his_log, reservations):
   235	    if not isinstance(doc, dict) or list(doc) != list(STATE_KEYS):
   236	        return [f"the state's keys are not {list(STATE_KEYS)}"]
   237	    out = [f"{k}: {doc[k]!r} != {want!r}" for k, want in (
   238	        ("schema_version", STATE_SCHEMA), ("campaign", "exp35"), ("h35", h35), ("cells_sha256", cells_sha256),
   239	        ("supervisor_sha256", supervisor_sha256), ("approved_sha256", approved_sha256)) if doc[k] != want]
   240	    plan = [(c["n"], c["kind"], c["cell"], c["gate"]) for c in chunk_plan()]
   241	    if not isinstance(doc["chunks"], list) or not all(isinstance(c, dict) for c in doc["chunks"]) or [
   242	            (c.get("n"), c.get("kind"), c.get("cell"), c.get("gate")) for c in doc["chunks"]] != plan:
   243	        return out + ["the state's chunks are not the frozen 33-chunk order"]
   244	    states = [c.get("state") for c in doc["chunks"]]
   245	    out += [f"chunk {i + 1}: unknown state {s!r}" for i, s in enumerate(states) if s not in CHUNK_STATES]
   246	    if out:
   247	        return out
   248	    done = 0
   249	    while done < len(states) and states[done] == "gates_verified":
   250	        done += 1
   251	    if any(s != "planned" for s in states[done + 1:]):
   252	        out.append(f"chunk order violated: {states[:done + 3]}... (only the first unfinished chunk may be started)")
   253	    latched = doc["stop_latch"] is not None
   254	    out += [x for c in doc["chunks"] for x in _chunk_reasons(c, latched)] + _top_reasons(doc, his_log, reservations)
   255	    digests = {c["campaign_digest"] for c in doc["chunks"] if "campaign_digest" in c}
   256	    out += [f"the chunks carry {len(digests)} campaign digests"] if len(digests) > 1 else []
   257	    started = any(s != "planned" for s in states)
   258	    if started != (doc["baseline"] is not None):
   259	        out.append("a baseline exactly when a chunk has started")
   260	    if started and done < len(states) and doc["reservation"] is None:
   261	        out.append("a started, unfinished campaign holds no reservation")
   262	    return out
   263	
   264	
   265	def load_state(path, *, h35, cells_sha256, supervisor_sha256, approved_sha256, his_log, reservations):
   266	    """The state, None when absent; ``ValueError`` when a pin is malformed or the state corrupt / inconsistent."""
   267	    if _pin_reasons(h35, cells_sha256, supervisor_sha256, approved_sha256):
   268	        raise ValueError(_pin_reasons(h35, cells_sha256, supervisor_sha256, approved_sha256)[0])
   269	    try:
   270	        with open(path) as f:
   271	            doc = json.load(f)
   272	    except FileNotFoundError:
   273	        return None
   274	    except (OSError, ValueError) as err:
   275	        raise ValueError(f"the supervisor state {path} is corrupt ({err})") from err
   276	    why = state_reasons(doc, h35=h35, cells_sha256=cells_sha256, supervisor_sha256=supervisor_sha256,
   277	                        approved_sha256=approved_sha256, his_log=his_log, reservations=reservations)
   278	    if why:
   279	        raise ValueError(f"the supervisor state {path} is inconsistent: " + "; ".join(why))
   280	    return doc

