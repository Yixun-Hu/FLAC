   268	def detect(world, cfg, max_seconds):
   269	    """The READ-ONLY detector (A7 r2 (v)(1), r3 (d)): both cards observed every POLL_S s; ``(0, 'EVENT CANDIDATE ...')``
   270	    once a card was free at WINDOW_POLLS consecutive polls (GPU 0 first), ``(3, 'EVENT TIMEOUT ...')`` when the next
   271	    poll would lie past ``max_seconds``, ``(4, 'EVENT UNREADABLE ...')`` at the first unreadable input. A poll later
   272	    than POLL_SLACK_S restarts every window at that poll (no catch-up burst). It keeps no memory across runs."""
   273	    start = due = world.now()
   274	    streak = {c: [] for c in CARDS}
   275	    while True:
   276	        world.sleep(due - world.now())
   277	        if world.now() - due > POLL_SLACK_S:
   278	            streak, due = {c: [] for c in CARDS}, world.now()
   279	        try:
   280	            seen = {c: observe(world, cfg, c) for c in CARDS}
   281	        except Unreadable as err:
   282	            return 4, f"EVENT UNREADABLE at {iso(world.now())}: {err} (busy: nothing admitted)"
   283	        for c, o in seen.items():
   284	            streak[c] = streak[c] + [o["t"]] if o["free"] else []
   285	        ready = [c for c in CARDS if len(streak[c]) >= WINDOW_POLLS]
   286	        if ready:
   287	            c = "GPU0" if "GPU0" in ready else ready[0]
   288	            first, last = streak[c][-WINDOW_POLLS], streak[c][-1]
   289	            return 0, (f"EVENT CANDIDATE {c} {CARDS[c]} index {seen[c]['index']}: free at {WINDOW_POLLS} consecutive "
   290	                       f"polls {POLL_S} s apart, {iso(first)} .. {iso(last)} (read-only detector: only the launcher's "
   291	                       "sealed capture admits a card)")
   292	        due += POLL_S
   293	        if due - start > max_seconds:
   294	            counts = ", ".join(f"{c} {len(streak[c])}/{WINDOW_POLLS}" for c in CARDS)
   295	            return 3, f"EVENT TIMEOUT at {iso(world.now())} after {max_seconds} s: no candidate (consecutive free polls {counts}); re-arm"
