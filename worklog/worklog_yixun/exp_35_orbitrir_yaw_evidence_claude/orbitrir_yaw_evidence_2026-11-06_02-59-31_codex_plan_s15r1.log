   102	[ -z "$LIMIT" ] || [[ "$LIMIT" =~ ^[1-9][0-9]*$ ]] || die "--limit must be a positive integer - abort"
   103	[[ "$GPU_POLL_SECONDS" =~ ^[0-9]+$ && "$GPU_MAX_POLLS" =~ ^[0-9]+$ ]] || die "GPU_POLL_SECONDS / GPU_MAX_POLLS must be integers - abort"
   104	
