   412	    st=0; wait "$pid" || st=$?
   413	    if [ "$st" -eq 0 ]; then N_DONE=$((N_DONE + 1)); else FAILED+=("${PID_CELL[$pid]}"); fi
   414	    if [ "$st" -eq 4 ]; then DRIFT=1; ABORT="${ABORT:-PIN DRIFT: the relevant tree changed while ${PID_CELL[$pid]} ran}"; fi
   415	    if [ "$st" -eq 5 ]; then ABORT="${ABORT:-BACKEND EVIDENCE missing for ${PID_CELL[$pid]}: no further cell is spawned}"; fi
   416	    if [ "$st" -eq 6 ]; then ABORT="${ABORT:-LANE CHANGED before the launch of ${PID_CELL[$pid]}: no further cell is spawned}"; fi
   417	    unset "LANE_PID[${PID_LANE[$pid]}]" "PID_CELL[$pid]" "PID_LANE[$pid]"
   418	  done
   419	}
   420	RE_MAP='^([0-9]+),[[:space:]]*(GPU-[0-9A-Za-z-]+)$'
   421	RE_APP='^([0-9]+),[[:space:]]*(GPU-[0-9A-Za-z-]+),[[:space:]]*([^,]*),[[:space:]]*([0-9]+|\[N/A\])$'
   422	lane_state() {   # <gpu>: 0 usable | 1 not now (LANE_WHY) | 2 a query failed / is malformed (fail closed)
   423	  local lane="$1" out rc line want pid uuid occ="" free pids=""
   424	  local -A byidx=() byuuid=()
   425	  out="$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader 2>/dev/null)"; rc=$?
   426	  [ "$rc" -eq 0 ] && [ -n "$out" ] || { LANE_WHY="nvidia-smi --query-gpu=index,uuid failed (rc ${rc})"; return 2; }
   427	  while IFS= read -r line; do
   428	    [[ "$line" =~ $RE_MAP ]] || { LANE_WHY="malformed index,uuid row '${line}'"; return 2; }
   429	    [ -z "${byidx[${BASH_REMATCH[1]}]:-}" ] && [ -z "${byuuid[${BASH_REMATCH[2]}]:-}" ] \
   430	      || { LANE_WHY="duplicate index or uuid in the nvidia-smi map ('${line}')"; return 2; }
   431	    byidx[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}"; byuuid[${BASH_REMATCH[2]}]="${BASH_REMATCH[1]}"
   432	  done <<<"$out"
   433	  want="${byidx[$lane]:-}"
   434	  [ -n "$want" ] || { LANE_WHY="GPU ${lane} has no uuid in the nvidia-smi index map"; return 2; }
   435	  out="$(nvidia-smi --query-compute-apps=pid,gpu_uuid,process_name,used_memory --format=csv,noheader,nounits 2>/dev/null)"; rc=$?
   436	  [ "$rc" -eq 0 ] || { LANE_WHY="nvidia-smi --query-compute-apps failed (rc ${rc})"; return 2; }
   437	  while IFS= read -r line; do
   438	    [ -n "$line" ] || continue
   439	    [[ "$line" =~ $RE_APP ]] || { LANE_WHY="malformed compute-app row '${line}'"; return 2; }
   440	    pid="${BASH_REMATCH[1]}"; uuid="${BASH_REMATCH[2]}"
   441	    [ -n "${byuuid[$uuid]:-}" ] || { LANE_WHY="compute process ${pid} sits on an unknown uuid ${uuid}"; return 2; }
   442	    [ "$uuid" = "$want" ] && occ+=" pid ${pid} (${BASH_REMATCH[3]}, ${BASH_REMATCH[4]} MiB, cwd $(readlink "/proc/${pid}/cwd" 2>/dev/null || echo '?'))" \
   443	      && pids+="${pids:+,}${pid}"
   444	  done <<<"$out"
   445	  out="$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits -i "$lane" 2>/dev/null)"; rc=$?
   446	  [ "$rc" -eq 0 ] && [[ "$out" =~ ^[[:space:]]*([0-9]+)[[:space:]]*$ ]] \
   447	    || { LANE_WHY="nvidia-smi memory.free of GPU ${lane} failed or is not one number (rc ${rc}: '${out//$'\n'/|}')"; return 2; }
   448	  free="${BASH_REMATCH[1]}"
   449	  [ "$free" -ge "$MIN_GPU_FREE_MIB" ] || { LANE_WHY="${free} MiB free < ${MIN_GPU_FREE_MIB} MiB"; return 1; }
   450	  LANE_WHY=""
   451	  if [ -n "$occ" ]; then
   452	    [ "$ALLOW_SHARED_GPU" = 1 ] || { LANE_WHY="occupied by foreign compute process(es):${occ}"; return 1; }
   453	    LANE_WHY="shared with${occ} (ALLOW_SHARED_GPU=1)"
   454	  fi
   455	  if [ -n "$COTENANTS" ]; then   # exp_35 §12 B1.1: the foreign set EQUALS the approved identity tuple
   456	    out="$("$PY" "$IDENTITY" --check --approved "$COTENANTS" --approved-sha256 "$COTENANTS_SHA" --gpu-uuid "$want" \
   457	      --pids "$pids" 2>&1)" \
   458	      || { LANE_WHY="co-tenant identity check refused GPU ${lane}: ${out//$'\n'/; }"; return 2; }
   459	    LANE_WHY="${LANE_WHY} [identity tuple OK: ${pids:-none}]"
   460	  fi
   461	  return 0
   462	}
   463	pick_lane() {   # LANE = the next idle lane (round-robin) lane_state accepts; a failed query aborts
   464	  local k lane st; LANE=""
   465	  for ((k = 0; k < ${#LANES[@]}; k++)); do
   466	    lane="${LANES[$(( (NEXT + k) % ${#LANES[@]} ))]}"
   467	    [ -z "${LANE_PID[$lane]:-}" ] || continue
   468	    lane_state "$lane"; st=$?
