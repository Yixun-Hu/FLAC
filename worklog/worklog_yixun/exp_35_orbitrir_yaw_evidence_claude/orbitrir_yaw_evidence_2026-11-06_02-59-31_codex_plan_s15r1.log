   514	    gpu_wait; continue
   515	  fi
   516	  farm_entry_ok "$LINK" "$CACHED" || { ABORT="FARM GATE FAILED: ${LINK} is no longer the hard link of ${CACHED}"; continue; }
   517	  # rB-F2 F2-6 (b): the contract + a full re-hash of the very file the evaluator will open, right now
   518	  cache_ok "$CACHED" "$SHA" || { ABORT="CACHE GATE FAILED before the spawn of ${READY}: ${CACHE_WHY}"; continue; }
   519	  echo "  checkpoint re-verified before the spawn: ${CACHED} (0444, ${CKPT_SIZE[$SHA]} bytes, ${SHA})"
   520	  echo "  RUN ${READY} on GPU ${LANE} (log $LOGDIR/depth_canon_${TS}_eval_${READY}.log)"
   521	  run_cell "$LANE" "$READY" "$SHA" "$SPAWN_DIGEST" "$LINK" "$CACHED" "$NOFLASH" "${ARGV[@]}" &
   522	  LANE_PID[$LANE]=$!; PID_CELL[$!]="$READY"; PID_LANE[$!]="$LANE"
   523	  READY=""; i=$((i + 1))
   524	done
   525	COMPLETE=$((N_SKIP + N_DONE))
   526	echo "=== summary: selected ${N_SEL} | skipped (complete and verified) ${N_SKIP} | ran ok ${N_DONE} | failed ${#FAILED[@]} | not run $((N_SEL - COMPLETE - ${#FAILED[@]})) ==="
   527	for c in "${FAILED[@]}"; do echo "  FAILED ${c}"; done
   528	echo "completion: ${COMPLETE}/${N_SEL} selected cell(s) complete and verified (manifest: $(jq '.cells | length' "$CELLS") cells)"
   529	[ -z "$ABORT" ] || { echo "ABORTED: ${ABORT} - abort"; [ -z "$DRIFT" ] || exit 4; exit 2; }
   530	[ "${#FAILED[@]}" -eq 0 ] && [ "$COMPLETE" -eq "$N_SEL" ] && { echo "CAMPAIGN SELECTION COMPLETE"; exit 0; }
   531	echo "CAMPAIGN SELECTION INCOMPLETE - re-run to resume"
   532	exit 1

