   484	    ABORT="GPU GATE: no usable lane (>= ${MIN_GPU_FREE_MIB} MiB free, unoccupied) after ${POLLS} poll(s)"; return
   485	  fi
   486	  sleep "$GPU_POLL_SECONDS"
   487	}
   488	while :; do
   489	  reap
   490	  if [ -n "$ABORT" ] || [ "$i" -ge "$N_SEL" ]; then [ "${#PID_CELL[@]}" -eq 0 ] && break; sleep 2; continue; fi
   491	  if [ -z "$READY" ]; then
   492	    prepare_cell "${CELL_IDS[$i]}"; st=$?
   493	    [ "$st" -eq 1 ] && { ABORT="cell ${CELL_IDS[$i]} refused"; continue; }
   494	    [ "$st" -eq 3 ] && { N_SKIP=$((N_SKIP + 1)); i=$((i + 1)); continue; }
   495	    READY="${CELL_IDS[$i]}"
   496	  fi
   497	  [ "${#PID_CELL[@]}" -lt "${#LANES[@]}" ] || { sleep 2; continue; }
   498	  if ! pick_lane; then
   499	    [ -n "$ABORT" ] && continue
   500	    if [ "${#PID_CELL[@]}" -gt 0 ]; then sleep 10; continue; fi   # a lane is busy: re-check soon
   501	    gpu_wait; continue
   502	  fi
   503	  POLLS=0
   504	  [ "$(git rev-parse HEAD)" = "$EXPECT_HEAD" ] || { ABORT="PIN DRIFT: HEAD moved during the campaign"; DRIFT=1; continue; }
   505	  SPAWN_DIGEST="$(tree_digest)" || SPAWN_DIGEST=""     # the evaluated bytes, before EVERY spawn (Codex rB)
   506	  if [ "$SPAWN_DIGEST" != "$CAMPAIGN_DIGEST" ] || [ -n "$(tree_dirty)" ]; then
   507	    ABORT="PIN DRIFT: the relevant tree changed during the campaign (digest '${SPAWN_DIGEST}' != ${CAMPAIGN_DIGEST}); no further cell is spawned"
   508	    DRIFT=1; continue
   509	  fi
   510	  lane_state "$LANE"; st=$?                  # re-checked immediately before the spawn (Codex rB HIGH)
