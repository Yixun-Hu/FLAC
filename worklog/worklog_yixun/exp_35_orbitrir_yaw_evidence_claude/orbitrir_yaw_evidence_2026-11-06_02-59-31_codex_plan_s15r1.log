    97	ALLOW_SHARED_GPU="${ALLOW_SHARED_GPU:-0}"
    98	case "$ALLOW_SHARED_GPU" in 0|1) ;; *) die "ALLOW_SHARED_GPU must be 0 or 1 (got '${ALLOW_SHARED_GPU}') - abort" ;; esac
    99	[[ "$LANES_CSV" =~ ^[0-9]+(,[0-9]+)*$ ]] || die "--lanes must be a comma list of GPU indices (got '${LANES_CSV}') - abort"
