FILE:exp35_phase_i_watch.sh
     1	#!/usr/bin/env bash
     2	# exp_35 phase (i) watcher (Planner; READ-ONLY; never signals, kills or writes anything). Exits -- one notification -- when
     3	# the supervisor process is gone, its log shows a STOP LATCH, or the state holds at least N gates_verified chunks.
     4	# Usage: bash exp35_phase_i_watch.sh <supervisor pid> <supervisor log> <state json> <N> [poll seconds, default 60]
     5	set -u
     6	PID="$1"; LOG="$2"; STATE="$3"; N="$4"; POLL="${5:-60}"
     7	alive() { tr '\0' ' ' < "/proc/$PID/cmdline" 2>/dev/null | grep -q 'exp35_supervisor.py'; }
     8	while :; do
     9	  if ! alive; then echo "EVENT: the supervisor (pid $PID) is gone"; break; fi
    10	  if grep -q 'STOP LATCH' "$LOG" 2>/dev/null; then echo "EVENT: STOP LATCH in $LOG"; break; fi
    11	  n="$(jq '[.chunks[] | select(.state == "gates_verified")] | length' "$STATE" 2>/dev/null)"
    12	  if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge "$N" ]; then echo "EVENT: milestone, $n chunks gates_verified (>= $N)"; break; fi
    13	  sleep "$POLL"
    14	done
    15	date -Is
    16	jq -c '{latch: .stop_latch, lane: .lane, states: [.chunks[] | .state]}' "$STATE" 2>/dev/null | cut -c1-900
    17	tail -n 6 "$LOG" 2>/dev/null | cut -c1-300

