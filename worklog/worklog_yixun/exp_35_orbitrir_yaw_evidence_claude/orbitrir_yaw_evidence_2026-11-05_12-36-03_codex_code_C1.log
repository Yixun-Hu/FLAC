    61	def fake_repo(tmp_path, transformer=None):
    62	    """A throwaway checkout: the real overlay + launcher, a stand-in transformer, a target."""
    63	    root = tmp_path / "repo"
    64	    ov = root / "overlays" / "no_flash"
    65	    ov.mkdir(parents=True)
    66	    shutil.copy(OVERLAY, ov / "flash_attn.py")
    67	    shutil.copy(LAUNCHER, ov / "exp35_no_flash_launch.py")
    68	    (root / "src" / "models").mkdir(parents=True)
    69	    (root / "src" / "__init__.py").write_text("")
    70	    (root / "src" / "models" / "__init__.py").write_text("")
    71	    (root / "src" / "models" / "transformer.py").write_text(transformer if transformer is not None
    72	                                                             else _fallback_block())
    73	    (root / "target.py").write_text(TARGET)
    74	    return root
