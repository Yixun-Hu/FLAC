    85	def _flags(row):
    86	    """``{flag: value-or-None}`` of a row's evaluator argv; every flag exactly once."""
    87	    args, out, i = row["eval_args"], {}, 0
    88	    while i < len(args):
    89	        flag = args[i]
    90	        assert flag.startswith("--") and flag not in out, (row["cell"], flag)
    91	        if i + 1 < len(args) and not args[i + 1].startswith("--"):
    92	            out[flag], i = args[i + 1], i + 2
    93	        else:
    94	            out[flag], i = None, i + 1
    95	    return out
