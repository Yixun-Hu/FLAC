    68	class ScaledSinusoidalEmbedding(nn.Module):
    69	    def __init__(self, dim, theta = 10000):
    70	        super().__init__()
    71	        assert (dim % 2) == 0, 'dimension must be divisible by 2'
    72	        self.scale = nn.Parameter(torch.ones(1) * dim ** -0.5)
    73	
    74	        half_dim = dim // 2
    75	        freq_seq = torch.arange(half_dim).float() / half_dim
    76	        inv_freq = theta ** -freq_seq
    77	        self.register_buffer('inv_freq', inv_freq, persistent = False)
    78	
    79	    def forward(self, x, pos = None, seq_start_pos = None):
    80	        seq_len, device = x.shape[1], x.device
    81	
    82	        if pos is None:
    83	            pos = torch.arange(seq_len, device = device)
    84	
    85	        if seq_start_pos is not None:
    86	            pos = pos - seq_start_pos[..., None]
    87	
    88	        emb = einsum('i, j -> i j', pos, self.inv_freq)
    89	        emb = torch.cat((emb.sin(), emb.cos()), dim = -1)
