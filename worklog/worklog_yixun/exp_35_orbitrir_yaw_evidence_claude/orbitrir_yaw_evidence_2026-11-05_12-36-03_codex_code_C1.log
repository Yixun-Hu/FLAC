   365	# --------------------------------------------------------------------------- #
   366	# §12 H4 (a): the pinned evaluator / probe tree starts no Python child process
   367	# --------------------------------------------------------------------------- #
   368	PROBE = os.path.join(REPO, "worklog", "worklog_yixun", "exp_25_depth_canon_claude", "depth_canon_cond_probe.py")
   369	SPAWNERS = {"subprocess": {"run", "Popen", "call", "check_call", "check_output", "getoutput", "getstatusoutput"},
   370	            "os": {"system", "popen", "execl", "execle", "execlp", "execlpe", "execv", "execve", "execvp", "execvpe",
   371	                   "spawnl", "spawnle", "spawnlp", "spawnlpe", "spawnv", "spawnve", "spawnvp", "spawnvpe",
   372	                   "posix_spawn", "posix_spawnp", "fork", "forkpty"},
   373	            "pty": {"spawn", "fork"}, "asyncio": {"create_subprocess_exec", "create_subprocess_shell"},
   374	            "multiprocessing": {"Process", "Pool", "get_context", "set_start_method"}}
   375	
   376	
   377	def _resolve(name):
   378	    """``src.a.b`` -> its file under this checkout (module or package), else None."""
   379	    base = os.path.join(REPO, *name.split("."))
   380	    for cand in (base + ".py", os.path.join(base, "__init__.py")):
   381	        if os.path.isfile(cand):
   382	            return cand
   383	    return None
   384	
   385	
   386	def _import_closure(roots):
   387	    """Every ``src`` file reachable from ``roots`` through ANY import statement (lazy ones too), with
   388	    each imported module's parent packages."""
   389	    seen, todo = set(), list(roots)
   390	    while todo:
   391	        path = todo.pop()
   392	        if path in seen:
   393	            continue
   394	        seen.add(path)
   395	        rel = os.path.relpath(path, REPO)[:-len(".py")].replace(os.sep, ".")
   396	        pkg = rel.rsplit(".", 1)[0] if not rel.endswith("__init__") else rel[:-len(".__init__")]
   397	        names = []
   398	        for node in ast.walk(ast.parse(open(path).read(), path)):
   399	            if isinstance(node, ast.Import):
   400	                names += [a.name for a in node.names]
   401	            elif isinstance(node, ast.ImportFrom):
   402	                base = node.module or ""
   403	                if node.level:
   404	                    parts = pkg.split(".")[:len(pkg.split(".")) - node.level + 1]
