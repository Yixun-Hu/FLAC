   195	def test_flags_per_block_class(manifest):
   196	    by = collections.defaultdict(list)
   197	    for c in _exp25(manifest):                       # exp_35's blocks: test_exp35_make_cells.py
   198	        by[c["block"]].append(c)
   199	    for block, cells in by.items():
   200	        for c in cells:
   201	            f = _flags(c)
   202	            canon, allow = "--canonicalize" in f, "--allow-canon-mismatch" in f
   203	            assert (canon, allow) == (c["canonicalize"], c["allow_canon_mismatch"])
   204	            assert f.get("--canonicalize", None) is None and f.get("--allow-canon-mismatch") is None
   205	            rot = _rot(f)
   206	            if c["arm"] == "CANON" and block != "D-i":
   207	                assert canon and not allow, c["cell"]
   208	            if block in ("T", "T-dup", "S"):
   209	                assert (c["arm"], rot) == ("CANON", ("fixed", 0))
   210	            if block == "T-dup":
   211	                assert c["seed"] == 42 and c["cell"].endswith("_dup")
   212	            if block == "C4+45":
   213	                assert c["arm"] == "CANON" and c["seed"] == 42 and rot[0] == "fixed"
   214	            if block == "R":
   215	                assert c["arm"] == "CANON" and rot == ("random", c["seed"])
   216	            if block == "D-i":
   217	                assert (c["arm"], canon, allow, rot, c["seed"]) == ("CANON", False, True, ("fixed", 0), 42)
   218	            if block == "D-ii":
   219	                assert (c["arm"], canon, allow, rot, c["seed"]) == ("P1", True, True, ("fixed", 0), 42)
   220	            if block in ("P1-pin", "YAW-pin"):
   221	                assert c["arm"] == block.split("-")[0] and not canon and not allow
   222	            if block == "TRAJ":
   223	                assert c["arm"] == "CANON" and c["seed"] == 42 and rot[0] == "fixed"
   224	            assert c["split"] == ("seen" if block == "S" or c["subblock"] == "S" else "unseen")
   225	    c4 = {(c["K"], _rot(_flags(c))[1]) for c in by["C4+45"]}
   226	    assert c4 == {(k, d) for k in (1, 8) for d in (90, 180, 270, 45)}
   227	    assert {(c["K"], c["seed"]) for c in by["T"]} == {(k, s) for k in (1, 8) for s in SEEDS}
   228	    assert {(c["K"], c["seed"]) for c in by["R"]} == {(k, s) for k in (1, 8) for s in SEEDS}
   229	    traj = {(c["step"], c["K"], _rot(_flags(c))[1]) for c in by["TRAJ"]}
   230	    assert traj == {(s, k, d) for s in range(2500, 40000, 2500) for k in (1, 8)
   231	                    for d in (0, 90, 180, 270)}                        # 40k = the T / C4 cells
   232	    for block in ("P1-pin", "YAW-pin"):
   233	        subs = collections.Counter(c["subblock"] for c in by[block])
   234	        assert subs == ({"T": 10, "R": 10, "C4": 8} | ({"S": 10} if block == "YAW-pin" else {}))
   235	    assert all(c["step"] == 40000 for c in manifest["cells"] if c["block"] != "TRAJ")
