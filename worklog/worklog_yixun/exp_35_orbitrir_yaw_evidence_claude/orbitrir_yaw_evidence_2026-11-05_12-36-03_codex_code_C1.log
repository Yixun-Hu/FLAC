    39	def _fallback_block():
    40	    """The real transformer.py's flash-attention import block, verbatim (lines 12-18 at the pin)."""
    41	    with open(os.path.join(REPO, "src", "models", "transformer.py")) as f:
    42	        text = f.read()
    43	    start = text.index("try:\n    from flash_attn import flash_attn_func\n")
    44	    end = text.index("    flash_attn_func = None\n", start) + len("    flash_attn_func = None\n")
    45	    return text[start:end]
