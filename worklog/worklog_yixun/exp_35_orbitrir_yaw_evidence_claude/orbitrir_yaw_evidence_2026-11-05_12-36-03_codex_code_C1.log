    77	def launch(root, *args, env=None, launcher=None):
    78	    """Run the launcher of ``root`` (cwd = root); ``env`` values of None delete the variable."""
    79	    e = {k: v for k, v in os.environ.items() if k != "PYTHONPATH"}
    80	    e.update(PYTHONDONTWRITEBYTECODE="1", CUDA_VISIBLE_DEVICES="", TARGET_REPORT=str(root.parent / "report.json"))
    81	    for k, v in (env or {}).items():
    82	        if v is None:
    83	            e.pop(k, None)
    84	        else:
    85	            e[k] = v
    86	    report = root.parent / "report.json"
    87	    if report.exists():
    88	        report.unlink()
    89	    p = subprocess.run([PY, str(launcher or root / "overlays" / "no_flash" / "exp35_no_flash_launch.py"), *args],
    90	                       env=e, cwd=str(root), capture_output=True, text=True, timeout=300)
    91	    return p.returncode, p.stdout, p.stderr, (json.loads(report.read_text()) if report.exists() else None)
    92	
