    22	REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    23	OVERLAY_DIR = os.path.join(REPO, "overlays", "no_flash")
    24	OVERLAY = os.path.join(OVERLAY_DIR, "flash_attn.py")
    25	LAUNCHER = os.path.join(OVERLAY_DIR, "exp35_no_flash_launch.py")
    26	PY = sys.executable
    27	OVERLAY_SHA256 = "0d0e52ca693e236a2e0a44cd61f61539fdf995cff5132d1f621181a0f3e7c023"   # plan §3b, verified
    28	MESSAGE = "exp35 no-flash overlay: flash_attn disabled, attention backend = torch SDPA"
    29	FALLBACK = "flash_attn not installed, disabling Flash Attention"
    30	SENTINEL = "EXP35_NO_FLASH_LAUNCHER"
