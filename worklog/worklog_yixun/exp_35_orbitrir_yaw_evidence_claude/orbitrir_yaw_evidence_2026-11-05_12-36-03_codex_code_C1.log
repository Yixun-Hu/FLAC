   319	WORKERS = r'''
   320	import importlib.util, json, os, sys
   321	import torch
   322	from torch.utils.data import DataLoader, Dataset
   323	
   324	
   325	class Probe(Dataset):
   326	    def __len__(self):
   327	        return 1
   328	
   329	    def __getitem__(self, i):
   330	        import src.models.transformer as T
   331	        spec = importlib.util.find_spec("flash_attn")
   332	        return json.dumps({"pid": os.getpid(), "transformer": T.__file__, "flash_none": T.flash_attn_func is None,
   333	                           "origin": spec.origin if spec else None})
   334	
   335	
   336	if __name__ == "__main__":
   337	    out = {"parent": os.getpid()}
   338	    for ctx in ("fork", "spawn"):
   339	        loader = DataLoader(Probe(), batch_size=None, num_workers=1, multiprocessing_context=ctx)
   340	        out[ctx] = json.loads(next(iter(loader)))
   341	    with open(os.environ["TARGET_REPORT"], "w") as f:
   342	        json.dump(out, f)
   343	'''
   344	
   345	
   346	def test_dataloader_fork_and_spawn_workers_run_the_sdpa_path(tmp_path):
   347	    """§12 H4 (b): a forked worker inherits the asserted modules, a spawned one rebuilds them from the
   348	    parent's explicit sys.path -- both report this checkout's transformer and flash_attn_func None."""
   349	    target = tmp_path / "workers.py"
   350	    target.write_text(WORKERS)
   351	    report = tmp_path / "workers.json"
   352	    p = subprocess.run([PY, LAUNCHER, str(target)], env=_real_env(TARGET_REPORT=str(report)), cwd=REPO,
   353	                       capture_output=True, text=True, timeout=900)
   354	    assert p.returncode == 0, p.stderr
   355	    rep = json.loads(report.read_text())
   356	    want = os.path.join(REPO, "src", "models", "transformer.py")
   357	    for ctx in ("fork", "spawn"):
   358	        w = rep[ctx]
   359	        assert w["pid"] != rep["parent"], ctx
   360	        assert os.path.realpath(w["transformer"]) == want and w["flash_none"] is True, (ctx, w)
   361	        assert os.path.realpath(w["origin"]) == OVERLAY, (ctx, w)
   362	    assert p.stdout.count(MESSAGE) == 2                     # the parent's import and the spawned worker's
