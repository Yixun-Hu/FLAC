   124	    n = SPLITS[split]["expected_stream_count"]
   125	    rotate_seed = seed if mode == "random" else None
   126	    cond = ARM_COND_FLAGS[arm] + COMMON_FLAGS[2:] if arm in ARM_COND_FLAGS else COMMON_FLAGS
   127	    args = ["--model-config", ARMS[arm]["model_config"], "--dataset-config", config, *cond,
   128	            "--expected-stream-count", str(n), "--seed", str(seed), "--rotate-mode", mode]
   129	    args += ["--rotate-seed", str(seed)] if mode == "random" else ["--rotate-deg", str(deg)]
   130	    args += (["--canonicalize"] if canonicalize else []) + (["--allow-canon-mismatch"] if allow else [])
   131	    args += ["--eval-name", name]
   132	    metrics = eval_FLAC.build_output_paths(
   133	        "farm/x.ckpt", 1, 1.0, name, cond_method=cond[1], rotate_deg=float(deg or 0), n_angles=4,
   134	        rotate_mode=mode, rotate_seed=rotate_seed, are_lambda=None, canonicalize=canonicalize,
   135	        canon_mismatch=mismatch)["metrics"]
   136	    suffix = os.path.basename(metrics)[len("x_metrics_"):-len(".json")]
   137	    return {"cell": name, "block": block, "subblock": sub, "arm": arm, "step": step, "split": split,
   138	            "K": k, "seed": seed, "rotate_mode": mode, "rotate_deg": deg, "rotate_seed": rotate_seed,
   139	            "canonicalize": canonicalize, "allow_canon_mismatch": allow, "canon_in_play": in_play,
   140	            "canon_trained": trained if in_play else None, "canon_mismatch": mismatch,
   141	            "model_config": ARMS[arm]["model_config"],
   142	            "model_config_sha256": ARMS[arm]["model_config_sha256"], "dataset_config": config,
   143	            "dataset_config_sha256": config_sha, "expected_stream_count": n, "dump": True,
   144	            "metrics_suffix": suffix, "eval_args": args}
   145	
   146	
   147	def _pin_rows(arm):
   148	    """P1-pin / YAW-pin: T (theta 0) + R (random) + C4/45 (seed 42) [+ S for YAW]."""
   149	    block = f"{arm}-pin"
   150	    rows = [_row(block, "T", arm, ENDPOINT, "unseen", k, s, ("fixed", 0)) for k in KS for s in SEEDS]
   151	    rows += [_row(block, "R", arm, ENDPOINT, "unseen", k, s, ("random", None)) for k in KS for s in SEEDS]
   152	    rows += [_row(block, "C4", arm, ENDPOINT, "unseen", k, 42, ("fixed", d))
   153	             for k in KS for d in C4_ANGLES + (OFF_ORBIT,)]
   154	    if arm == "YAW":
   155	        rows += [_row(block, "S", arm, ENDPOINT, "seen", k, s, ("fixed", 0)) for k in KS for s in SEEDS]
   156	    return rows
   157	
   158	
   159	def _exp35_blocks():
   160	    """exp_35 (plan_orbitrir_yaw_evidence.md r2 §1): phase (i) CTL / BF-pin / BF-dup, phase (ii) the
   161	    off-orbit figure cells; every row seed 42-46 / K1, K8 unless the plan narrows it."""
   162	    E, U = ENDPOINT, "unseen"
   163	    off = lambda block, arm: [_row(block, "OFF", arm, E, U, k, s, ("fixed", d), arm == "CANON")  # noqa: E731
   164	                              for k in KS for s in SEEDS for d in OFF_ANGLES]
   165	    return {
   166	        "CTL": [_row("CTL", "T", "P1", E, U, k, 42, ("fixed", 0)) for k in KS],
   167	        "BF-pin": [_row("BF-pin", "T", "BF", E, U, k, s, ("fixed", 0)) for k in KS for s in SEEDS]
   168	        + [_row("BF-pin", "R", "BF", E, U, k, s, ("random", None)) for k in KS for s in SEEDS]
   169	        + [_row("BF-pin", "C4", "BF", E, U, k, 42, ("fixed", d)) for k in KS for d in C4_ANGLES + (OFF_ORBIT,)],
   170	        "BF-dup": [_row("BF-dup", "T", "BF", E, U, k, 42, ("fixed", 0), dup=True) for k in KS],
   171	        "OFF-P1": off("OFF-P1", "P1"), "OFF-BF": off("OFF-BF", "BF"), "OFF-CANON": off("OFF-CANON", "CANON"),
   172	        "CANON-45": [_row("CANON-45", "OFF", "CANON", E, U, k, s, ("fixed", OFF_ORBIT), True)
   173	                     for k in KS for s in SEEDS[1:]],
   174	    }
   175	
   176	
   177	def build_manifest(exp35=True):
   178	    """The 330-row manifest; ``exp35=False``: the exp_25 manifest exactly as committed at its pin."""
   179	    E, U = ENDPOINT, "unseen"
   180	    blocks = {
   181	        "T": [_row("T", "T", "CANON", E, U, k, s, ("fixed", 0), True) for k in KS for s in SEEDS],
   182	        "T-dup": [_row("T-dup", "T", "CANON", E, U, k, 42, ("fixed", 0), True, dup=True) for k in KS],
   183	        "C4+45": [_row("C4+45", "C4", "CANON", E, U, k, 42, ("fixed", d), True)
   184	                  for k in KS for d in C4_ANGLES + (OFF_ORBIT,)],
   185	        "R": [_row("R", "R", "CANON", E, U, k, s, ("random", None), True) for k in KS for s in SEEDS],
   186	        "D-i": [_row("D-i", "D", "CANON", E, U, k, 42, ("fixed", 0), allow=True) for k in KS],
   187	        "D-ii": [_row("D-ii", "D", "P1", E, U, k, 42, ("fixed", 0), True, True) for k in KS],
   188	        "S": [_row("S", "S", "CANON", E, "seen", k, s, ("fixed", 0), True) for k in KS for s in SEEDS],
   189	        "P1-pin": _pin_rows("P1"),
   190	        "YAW-pin": _pin_rows("YAW"),
   191	        "TRAJ": [_row("TRAJ", "TRAJ", "CANON", step, U, k, 42, ("fixed", d), True)
   192	                 for step in range(CADENCE, ENDPOINT, CADENCE) for k in KS for d in (0,) + C4_ANGLES],
   193	    }
   194	    names = EXP25_BLOCKS + (EXP35_BLOCKS if exp35 else ())
   195	    blocks.update(_exp35_blocks() if exp35 else {})
   196	    cells = []
   197	    for priority, block in enumerate(names):
   198	        for row in blocks[block]:
   199	            cells.append({"cell": row.pop("cell"), "order": len(cells), "priority": priority, **row})
   200	    head = {"schema_version": SCHEMA_VERSION, "generator": f"{EXPREL}/depth_canon_make_cells.py",
   201	            "plan": "plan_depth_canon.md v9 §5" + (
   202	                "; exp_35 rows: plan_orbitrir_yaw_evidence.md r2 §1, §11" if exp35 else ""),
   203	            "blocks": list(names), "block_counts": {b: len(blocks[b]) for b in names}, "common_flags": COMMON_FLAGS}
   204	    head.update({"arm_cond_flags": ARM_COND_FLAGS} if exp35 else {})
   205	    return {**head, "img_w": IMG_W, "seeds": list(SEEDS), "dump_root": DUMP_ROOT, "farm_root": FARM_ROOT,
   206	            "splits": {s: {"split_json": v["split_json"], "expected_stream_count": v["expected_stream_count"]}
   207	                       for s, v in SPLITS.items()},
   208	            "arms": {a: ARMS[a] for a in EXP25_ARMS + (("BF",) if exp35 else ())}, "cells": cells}
   209	
   210	
   211	def render(manifest):
   212	    """Deterministic bytes: a pretty header, then one compact cell per line."""
   213	    head = {k: v for k, v in manifest.items() if k != "cells"}
   214	    return (json.dumps(head, indent=1)[:-2] + ',\n "cells": [\n'
   215	            + ",\n".join("  " + json.dumps(c, separators=(",", ":")) for c in manifest["cells"])
   216	            + "\n ]\n}\n")
   217	
   218	
   219	def main(argv=None):
   220	    import argparse
   221	    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   222	    ap.add_argument("--write", action="store_true", help=f"write {os.path.relpath(OUT, REPO)}")
   223	    ap.add_argument("--check", action="store_true", help="exit 1 if the committed file drifted")
   224	    args = ap.parse_args(argv)
   225	    text = render(build_manifest())
   226	    if args.check:
   227	        with open(OUT) as f:
   228	            same = f.read() == text
   229	        print("cells manifest OK" if same else f"cells manifest DRIFTED from the generator: {OUT}")
   230	        return 0 if same else 1
   231	    if args.write:
   232	        with open(OUT, "w") as f:
   233	            f.write(text)
   234	        print(f"wrote {OUT}")
   235	        return 0
   236	    sys.stdout.write(text)
   237	    return 0
   238	
   239	
   240	if __name__ == "__main__":
   241	    sys.exit(main())

