    48	TARGET = r'''
    49	import json, os, sys
    50	import src.models.transformer as T
    51	report = {"argv": sys.argv, "name": __name__, "path": sys.path[:2], "pythonpath": os.environ.get("PYTHONPATH"),
    52	          "flash_none": T.flash_attn_func is None, "transformer": T.__file__, "dont_write": sys.dont_write_bytecode,
    53	          "path_all": sys.path}
    54	with open(os.environ["TARGET_REPORT"], "w") as f:
    55	    json.dump(report, f)
    56	if os.environ.get("TARGET_EXIT"):
    57	    sys.exit(int(os.environ["TARGET_EXIT"]))
    58	'''
