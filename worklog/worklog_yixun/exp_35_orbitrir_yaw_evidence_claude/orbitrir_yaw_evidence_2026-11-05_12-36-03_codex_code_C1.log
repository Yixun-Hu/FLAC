    94	def _sentinel(stdout):
    95	    lines = [ln for ln in stdout.splitlines() if ln.startswith(SENTINEL + " ")]
    96	    assert len(lines) == 1, stdout
    97	    return dict(tok.split("=", 1) for tok in lines[0].split()[1:])
    98	
    99	
   100	def _pair_then_sentinel(stdout):
   101	    lines = stdout.splitlines()
   102	    msg = [i for i, ln in enumerate(lines) if ln == MESSAGE]
   103	    fb = [i for i, ln in enumerate(lines) if ln == FALLBACK]
   104	    sent = [i for i, ln in enumerate(lines) if ln.startswith(SENTINEL + " ")]
   105	    return len(msg) == len(fb) == len(sent) == 1 and fb[0] == msg[0] + 1 and sent[0] > fb[0]
