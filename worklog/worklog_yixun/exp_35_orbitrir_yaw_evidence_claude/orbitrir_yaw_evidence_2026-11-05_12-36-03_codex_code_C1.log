   850	def canonical_stream_hash(tuples):
   851	    """sha256 over an ordered tuple stream, in the pre-registered serialization.
   852	
   853	    One JSON array per tuple (``sort_keys=True``, ``separators=(",", ":")``),
   854	    LF-joined, UTF-8 (plan §3.3, review B5). Fixed here rather than left to
   855	    ``json`` defaults because this string is the cross-machine contract: two cells
   856	    are declared rotation-matched iff these digests agree, so whitespace or key
   857	    ordering may never depend on the writer.
   858	    """
   859	    payload = "\n".join(
   860	        json.dumps(list(t), sort_keys=True, separators=(",", ":")) for t in tuples
   861	    )
   862	    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
