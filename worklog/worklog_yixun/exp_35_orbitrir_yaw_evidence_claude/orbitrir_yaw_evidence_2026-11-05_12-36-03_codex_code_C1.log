   520	        raise FileNotFoundError(f"expected exactly one depth_canon_*_exp25_CANON_checkpoints.sha256 in "
   521	                                f"{expdir}, found {len(hits)}: pass --canon-ckpt-manifest")
   522	    return hits[0]
