   498	def load_canon_index(path, run_ns):
   499	    """``{step: (path, sha256)}`` from the launcher's FULL checkpoint manifest (``sha256sum``
   500	    lines). Every line must be one checkpoint of the CANON run namespace; any other line,
   501	    a malformed digest or a duplicate step is a ``ValueError`` (fail-closed)."""
   502	    pat = re.compile(re.escape(run_ns.rstrip("/")) + r"/checkpoints/epoch=\d+-step=(\d+)\.ckpt")
   503	    index = {}
   504	    with open(path) as f:
   505	        for line in f.read().splitlines():
   506	            sha, sep, ckpt = line.partition("  ")
   507	            m = pat.fullmatch(ckpt) if sep and eval_FLAC._is_sha256_hex(sha) else None
   508	            if m is None:
   509	                raise ValueError(f"{path}: {line!r} is not a checkpoint of the CANON run {run_ns}")
   510	            if int(m.group(1)) in index:
   511	                raise ValueError(f"{path}: duplicate step {m.group(1)}")
   512	            index[int(m.group(1))] = (ckpt, sha)
   513	    return index
