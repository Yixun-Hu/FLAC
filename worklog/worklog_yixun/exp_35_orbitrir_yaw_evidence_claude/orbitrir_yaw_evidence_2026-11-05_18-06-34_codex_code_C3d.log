    66	# --------------------------------------------------------------------------- #
    67	# the end-of-training predictor (§13 B1): spawn shared only if s43 cannot end before the cell does
    68	# --------------------------------------------------------------------------- #
    69	def _report(step, mtime):
    70	    return {"step": {"global": step}, "log": {"mtime": mtime}, "finished": step >= 40000}
    71	
    72	
    73	def test_the_predictor_uses_3_5_s_per_step_from_the_last_log_write():
    74	    chunk = next(c for c in S.chunk_plan() if c["cell"] == "exp35_BF_T_S40000_K8_s42")        # 35 min planning
    75	    need = 2 * 35 * 60 + 1800
    76	    step = 40000 - 2000                                                                       # earliest end: 7000 s
    77	    ok, d = S.predictor_ok(_report(step, 1000.0), now=1000.0 + 7000 - need - 1, chunk=chunk)
    78	    assert ok and d["earliest_end"] == 1000.0 + 2000 * 3.5 and d["needed_after"] < d["earliest_end"]
    79	    ok, _ = S.predictor_ok(_report(step, 1000.0), now=1000.0 + 7000 - need, chunk=chunk)       # equal: no
    80	    assert not ok
    81	    ok, _ = S.predictor_ok(_report(step, 0.0), now=1000.0 + 7000 - need - 1, chunk=chunk)     # a stale log write
    82	    assert not ok
