   260	def test_states_carrying_their_evidence_load(tmp_path):
   261	    assert _load(tmp_path, _done(_state(), 7)) is not None
   262	    crash = _done(_state(), 7)                                                  # died while chunk 8 ran
   263	    crash["chunks"][7].update(state="in_flight", lane=G1, shared=True, started="t", log="y.log")
   264	    assert _load(tmp_path, crash) is not None
   265	    failed = _done(_state(), 7)                                                 # chunk 8 failed: recorded + latched
   266	    failed["chunks"][7].update(state="in_flight", lane=G1, shared=True, started="t", log="y.log", ended="t2",
   267	                               runner_rc=1)
   268	    failed["stop_latch"] = {"reason": "chunk 8 exited rc 1", "time": "t2"}
   269	    assert _load(tmp_path, failed) is not None
   270	    done = _done(_state(), 33)
   271	    done.update(lane=None, reservation=None)                                    # released at the end
   272	    assert _load(tmp_path, done) is not None
   273	    early = _state()                                                            # a hand-over before our first spawn
   274	    early.update(lane={"uuid": G0, "shared": False}, reservation={"uuid": G0, "epoch": 1, "path": f"/r/{G0}.json"})
   275	    assert _load(tmp_path, early) is not None
