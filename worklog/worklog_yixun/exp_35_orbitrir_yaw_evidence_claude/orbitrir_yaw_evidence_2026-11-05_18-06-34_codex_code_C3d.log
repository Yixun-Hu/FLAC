   232	# --------------------------------------------------------------------------- #
   233	# Codex C3b BLOCKING 1: a state carries the evidence of every claim it makes -- or it refuses
   234	# --------------------------------------------------------------------------- #
   235	def _done(st, upto):
   236	    """Chunks 1..upto exactly as the loop leaves them: gates_verified with all their evidence."""
   237	    for c in st["chunks"][:upto]:
   238	        c.update(state="gates_verified", lane=G1, shared=True, started="t0", log="x.log", ended="t1")
   239	        if c["kind"] == "cell":
   240	            c.update(runner_rc=0, receipt_sha256="1" * 64, campaign_digest="d" * 64)
   241	        else:
   242	            c.update(probe_rc=0, probe_contract={"rc": 0, "out": "BF PROBE VALID"}, probe_json_sha256="2" * 64,
   243	                     sidecar_sha256="3" * 64, log_sha256="4" * 64)
   244	        c.update(**{"E1": {"e1": {"rc": 0, "verdict": "equal", "out": "ok"}},
   245	                    "E2": {"e2": {"rc": 1, "verdict": "FAIL", "out": "x"}}}.get(c["gate"], {}))
   246	        c["final_guard"] = {"status": "OK", "exit": 0, "t": 2.0, "time": "t2", "step": 101, "anchor": dict(ANCHOR)}
   247	    st.update(baseline={"time": 1.0, "step": 100, "log": {"path": "/x.log", "inode": 5, "size": 9}},
   248	              lane={"uuid": G1, "shared": True}, reservation={"uuid": G1, "epoch": 1, "path": f"/r/{G1}.json"},
   249	              his_log_anchor=dict(ANCHOR),
   250	              events=[{"t": 1.0, "time": "t", "what": "supervisor started (a new state)"}])
   251	    return st
   252	
