   381	def _eps_cond(results):
   382	    """max fp32 conditioning relL2 over the registered offsets, conditioner ids and items."""
   383	    if "fp32" not in results:
   384	        return None
   385	    value, key, cid, pos = _eps_max(results, OFFSET_KEYS)
   386	    return {"value": value, "threshold": EPS_COND_THRESHOLD, "pass": value <= EPS_COND_THRESHOLD,
   387	            "argmax": {"key": key, "id": cid, "position": pos}}
