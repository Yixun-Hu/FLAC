   221	def test_the_trainer_gone_hands_over_to_gpu0_in_the_registered_order(tmp_path, monkeypatch):
   222	    """§12 B1.4: (a) GPU 0 free twice 60 s apart, (b) its file O_EXCL, (c) the state with epoch + 1, (d) the GPU 1 file
   223	    removed -- so our reservation is never absent and the state never names a file that does not exist."""
   224	    w, cfg, s = _sup(tmp_path)
   225	    p1 = S.create_reservation(cfg["reservations"], G1, epoch=1, h35=cfg["h35"], now=w.t)
   226	    s.st.update(reservation={"uuid": G1, "epoch": 1, "path": p1}, lane={"uuid": G1, "shared": True})
   227	    w.remove_trainers()
   228	    order, real = [], (S.create_reservation, S.write_state, S.remove_reservation)
   229	    monkeypatch.setattr(S, "create_reservation", lambda *a, **k: (order.append(("create", a[1])), real[0](*a, **k))[1])
   230	    monkeypatch.setattr(S, "write_state", lambda path, doc: (order.append(("state", (doc["reservation"] or {}).get(
   231	        "epoch"))), real[1](path, doc))[1])
   232	    monkeypatch.setattr(S, "remove_reservation", lambda path: (order.append(("remove", os.path.basename(path))), real[2](path))[1])
   233	    assert s.ready(CH1) == (G0, 0, False)
   234	    steps = [o for o in order if o[0] != "state" or o[1] == 2]
   235	    assert steps[steps.index(("create", G0)):][:3] == [("create", G0), ("state", 2), ("remove", f"{G1}.json")]
   236	    assert [p.name for p in w.res.iterdir()] == [f"{G0}.json"] and s.st["lane"] == {"uuid": G0, "shared": False}
   237	    free = [e for e in s.st["events"] if e["what"].startswith("GPU 0 free")]
   238	    assert len(free) == 2 and free[1]["t"] - free[0]["t"] >= S.HANDOVER_GAP_S
