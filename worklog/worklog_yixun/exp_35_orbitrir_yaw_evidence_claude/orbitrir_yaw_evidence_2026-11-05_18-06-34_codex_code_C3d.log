  1109	def _bf_block_reasons(blk, label, P, ids):
  1110	    """One protocol x quarter turn (or determinism) record: the four stages, the conditioner ids, a BOOL mask, and
  1111	    every per-id / all / stage vector with its summary."""
  1112	    if not (isinstance(blk, dict) and list(blk) == list(P["stages"]) and isinstance(blk["cond"], dict)):
  1113	        return [f"{label}: not the stages {list(P['stages'])}"]
  1114	    c = blk["cond"]
  1115	    out = [] if type(c.get("masks_equal")) is bool else [f"{label}.cond.masks_equal {c.get('masks_equal')!r} is not a bool"]
  1116	    if not (c.get("ids") == ids and isinstance(c.get("per_id"), dict) and sorted(c["per_id"]) == ids):
  1117	        return out + [f"{label}.cond ids / per_id {c.get('ids')!r} are not the conditioner ids {ids}"]
  1118	    for lab, node in [(f"{label}.cond.per_id.{i}", c["per_id"][i]) for i in ids] + [(f"{label}.cond.all", c.get("all"))] \
  1119	            + [(f"{label}.{st}", blk[st]) for st in P["stages"][1:]]:
  1120	        out += _bf_vector_reasons(node, lab, P["n_items"])
  1121	    return out
  1122	
