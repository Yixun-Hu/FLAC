   218	def _proc(tmp, table):
   219	    """A fake /proc: ``{pid: ppid}`` stat files."""
   220	    for pid, ppid in table.items():
   221	        os.makedirs(tmp / str(pid), exist_ok=True)
   222	        (tmp / str(pid) / "stat").write_text(f"{pid} (python x) S {ppid} 1 1 0 -1 4194304 0 0 0 0 0 0 0 0 20 0 1 0 999 0 0\n")
   223	    return str(tmp)
