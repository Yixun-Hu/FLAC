   347	
   348	def _append(acc, cmp):
   349	    c = cmp["cond"]
   350	    if acc["cond"]["ids"] not in (None, c["ids"]):
   351	        raise RuntimeError(f"conditioner ids changed between batches: {acc['cond']['ids']} -> {c['ids']}")
   352	    acc["cond"]["ids"] = c["ids"]
   353	    acc["cond"]["masks_equal"] = acc["cond"]["masks_equal"] and c["masks_equal"]
   354	    for target, src in [(acc["cond"]["per_id"].setdefault(i, _pair_lists()), c[i]) for i in c["ids"]] + \
   355	            [(acc["cond"]["all"], c["all"])] + [(acc[s], cmp[s]) for s in STAGES[1:]]:
   356	        for k in ("relL2", "relLinf"):
   357	            target[k].extend(float(v) for v in src[k])
   358	
   359	
   360	def _finish(acc):
   361	    for d in list(acc["cond"]["per_id"].values()) + [acc["cond"]["all"]] + [acc[s] for s in STAGES[1:]]:
   362	        d["summary"] = summarize({k: np.array(d[k]) for k in ("relL2", "relLinf")})
   363	    return acc
