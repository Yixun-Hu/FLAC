   983	def _probe_length_reasons(prov, ckpt_sha256, receipts, label="CANON"):
   984	    """rB-F3 F3-2 (Codex rA3/rB3 HIGH): the probe's ``ckpt_bytes_loaded`` == the one length every
   985	    verified CANON@40k cell receipt holds for the same checkpoint. No such receipt, receipts that
   986	    disagree or name other bytes -> the length is NOT verifiable (a reason, never a silent pass).
   987	    exp_35: ``label="B-F"`` -- the same rule over the verified B-F@40k cell receipts."""
   988	    arm, label, step = label, "probe provenance.ckpt_bytes_loaded", PROBE_CONTRACT["ckpt_step"]
   989	    if not receipts:
   990	        return [f"{label} is not verifiable: the selection holds no verified {arm}@{step} cell receipt "
   991	                "(the length of the checkpoint bytes the campaign loaded)"]
   992	    out = [f"{label} is not verifiable: a verified {arm}@{step} cell receipt's ckpt_sha256_loaded "
   993	           f"{r.get('ckpt_sha256_loaded')!r} is not the probe's checkpoint {ckpt_sha256}"
   994	           for r in receipts if r.get("ckpt_sha256_loaded") != ckpt_sha256]
   995	    sizes = [r.get("ckpt_bytes_loaded") for r in receipts]
   996	    bad = [n for n in sizes if type(n) is not int or n <= 0]
   997	    if bad:
   998	        return out + [f"{label} is not verifiable: a verified {arm}@{step} cell receipt's ckpt_bytes_loaded "
   999	                      f"{bad[0]!r} is not a positive int"]
  1000	    if len(set(sizes)) != 1:
  1001	        return out + [f"{label} is not verifiable: the verified {arm}@{step} cell receipts disagree on "
  1002	                      f"ckpt_bytes_loaded ({sorted(set(sizes))})"]
  1003	    _eq(out, f"{label} (vs the verified {arm}@{step} cell receipts' ckpt_bytes_loaded)",
  1004	        prov.get("ckpt_bytes_loaded"), sizes[0])
  1005	    return out
