   197	def _rehash_argv(workers):
   198	    """The hasher child: this gate in ``--rehash-worker`` mode (stdin: JSON paths; stdout: JSON digests)."""
   199	    return [sys.executable, os.path.abspath(__file__), "--rehash-worker", "--workers", str(max(1, workers))]
   200	
   201	
   202	def _rehash_in_child(paths, workers, deadline_s):
   203	    """``(digests, None)`` or ``(None, why)``. Past the deadline the child's own process group is
   204	    SIGKILLed and the gate fails closed; a child that still does not exit (an uninterruptible read)
   205	    is abandoned after 10 s, never waited on."""
   206	    try:
   207	        proc = subprocess.Popen(_rehash_argv(workers), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
   208	                                stderr=subprocess.PIPE, text=True, start_new_session=True)
   209	    except OSError as err:
   210	        return None, f"the map re-hash child could not start ({err})"
   211	    try:
   212	        out, err = proc.communicate(json.dumps(paths), timeout=deadline_s)
   213	    except subprocess.TimeoutExpired:
   214	        try:
   215	            os.killpg(proc.pid, signal.SIGKILL)
   216	        except OSError:
   217	            pass
   218	        try:
   219	            proc.communicate(timeout=10)
   220	        except subprocess.TimeoutExpired:
   221	            pass
   222	        return None, (f"the map re-hash exceeded its {deadline_s:g} s wall-clock deadline (a hung NAS read?); "
   223	                      "the gate fails closed")
   224	    if proc.returncode != 0:
   225	        return None, f"the map re-hash child exited {proc.returncode} ({err.strip()[-300:]!r})"
   226	    try:
   227	        digests = json.loads(out)
   228	    except ValueError:
   229	        return None, "the map re-hash child printed no JSON"
   230	    if not (isinstance(digests, list) and len(digests) == len(paths)
   231	            and all(d is None or (isinstance(d, str) and _HEX64.fullmatch(d)) for d in digests)):
   232	        return None, "the map re-hash child's answer is malformed"
   233	    return digests, None
