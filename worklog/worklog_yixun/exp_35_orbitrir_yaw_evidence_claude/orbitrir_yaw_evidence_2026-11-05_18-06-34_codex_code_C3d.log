   941	    if not (args.h35 and re.fullmatch(r"[0-9a-f]{40}", args.h35) and args.approved and _hex(args.approved_sha256)):
   942	        print("SUPERVISOR REFUSED: --h35 (40-hex), --approved and --approved-sha256 (64-hex) are required")
   943	        return 2
   944	    if not (_hex(_sha_file(os.path.join(REPO, CELLS))) and _hex(_sha_file(os.path.abspath(__file__)))):
   945	        print(f"SUPERVISOR REFUSED: the cells manifest {CELLS} or the supervisor cannot be hashed (a pin, C3c BLOCKING 1)")
