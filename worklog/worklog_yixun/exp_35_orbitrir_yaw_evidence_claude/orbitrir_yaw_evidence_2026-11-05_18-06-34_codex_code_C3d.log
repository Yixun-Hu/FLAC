   236	def _rehash_problems(rows, maps, workers, deadline_s=REHASH_DEADLINE_S):
   237	    now, why = _rehash_in_child([maps[r["path"]]["path"] for r in rows], workers, deadline_s)
   238	    if why:
   239	        return [why]
   240	    missing = [r["path"] for r, h in zip(rows, now) if h is None]
   241	    changed = [r["path"] for r, h in zip(rows, now) if h is not None and h != r["sha256"]]
   242	    return ([f"{len(missing)} depth map(s) missing / unreadable now: {missing[:3]}"] if missing else []) + (
   243	        [f"{len(changed)} depth map(s) changed since the audit (current sha256 != the row): {changed[:3]}"]
   244	        if changed else [])
