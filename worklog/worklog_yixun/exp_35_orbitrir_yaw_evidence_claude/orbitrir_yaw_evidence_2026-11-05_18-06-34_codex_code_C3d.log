  1807	                                    dump_root=dump_root)
  1808	    _, _, new, why2 = _verified_cell(new_name, manifest=manifest, pin=pin, base_dir=base_dir, farm_root=farm_root,
  1809	                                     dump_root=dump_root)
  1810	    refused = why + why2
