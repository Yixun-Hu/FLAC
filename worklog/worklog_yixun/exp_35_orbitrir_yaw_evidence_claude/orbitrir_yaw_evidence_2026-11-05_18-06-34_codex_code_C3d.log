   172	    cfg = {"h35": "a" * 40, "state": str(tmp_path / "state.json"), "approved": approved, "approved_sha256": sha,
   173	           "reservations": str(w.res), "his_log": str(w.log), "cells_sha256": "c" * 64, "supervisor_sha256": "d" * 64,
   174	           "proc": str(w.procdir), "logdir": str(tmp_path / "logs"), "probe_json": str(tmp_path / "orbitrir_bf_cond_probe.json")}
   175	    os.makedirs(cfg["logdir"])
   176	    g = FakeGates()
   177	    g.probe_json = cfg["probe_json"]
   178	    return w, g, cfg
