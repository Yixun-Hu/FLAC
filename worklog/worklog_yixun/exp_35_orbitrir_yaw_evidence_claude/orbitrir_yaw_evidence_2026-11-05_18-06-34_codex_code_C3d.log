   306	class SpoilAfterVerify(FakeGates):
   307	    """Spoils the reservation right after a cell's verification: between its watch and the next spawn."""
   308	
   309	    def __init__(self, world, cell, how):
   310	        super().__init__()
   311	        self.w, self.cell, self.how = world, cell, how
   312	
   313	    def verify(self, chunk):
   314	        out = super().verify(chunk)
   315	        if chunk["cell"] == self.cell:
   316	            SPOIL[self.how](self.w)
   317	        return out
