   367	def gpu_map(text):
   368	    """``{index: uuid}`` from ``nvidia-smi --query-gpu=index,uuid --format=csv,noheader``; ValueError when malformed."""
   369	    out = {}
   370	    for line in [ln for ln in text.splitlines() if ln.strip()]:
   371	        m = re.fullmatch(r"\s*(\d+),\s*(GPU-[0-9A-Za-z-]+)\s*", line)
   372	        if not m or int(m[1]) in out or m[2] in out.values():
   373	            raise ValueError(f"malformed or duplicate nvidia-smi index,uuid row {line!r}")
   374	        out[int(m[1])] = m[2]
   375	    if not out:
   376	        raise ValueError("nvidia-smi lists no GPU")
   377	    return out
