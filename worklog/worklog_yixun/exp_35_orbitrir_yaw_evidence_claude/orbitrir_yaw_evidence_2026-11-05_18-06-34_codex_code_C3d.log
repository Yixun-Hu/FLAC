  1096	def _bf_vector_reasons(node, label, n):
  1097	    """One stage record: ``relL2`` / ``relLinf`` exactly ``n`` finite, non-negative values each, and its summary the
  1098	    recomputation from those items (Codex C3a BLOCKING 1: no stored summary is trusted)."""
  1099	    from src.tools import depth_canon_stats as stats
  1100	    if not (isinstance(node, dict) and all(isinstance(node.get(m), list) and len(node[m]) == n and all(
  1101	            _finite(x) and x >= 0 for x in node[m]) for m in ("relL2", "relLinf"))):
  1102	        return [f"{label}: relL2 / relLinf are not {n} finite, non-negative values each"]
  1103	    out = []
  1104	    _eq(out, f"{label}.summary (recomputed from its items)", node.get("summary"),
  1105	        {m: stats.paired_summary(node[m]) for m in ("relL2", "relLinf")})
  1106	    return out
  1107	
