  1865	    ok = len(res["rows"]) == 14 and all(r["pass"] for r in res["rows"])
  1866	    rows45 = [r for r in table if r["angle_deg"] == "45" and r["method"] in A6_METHODS.values() and int(r["seed"]) in SEEDS]
  1867	    return dict(res, status="PASS" if ok else "FAIL", rows45=rows45 if ok else [], **{"pass": ok})   # (b)'s 45 deg: on PASS
