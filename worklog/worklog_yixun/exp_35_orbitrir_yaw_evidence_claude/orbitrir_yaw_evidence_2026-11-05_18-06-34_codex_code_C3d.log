             int(argv[argv.index("--lanes") + 1])]
         self.spawned.append({"argv": argv, "env": env, "log": log, "t": self.t, "uuid": uuid, "sleeps": len(self.sleeps),
                              "files": sorted(p.name for p in self.res.iterdir())})
