   714	            c["e2"] = {"rc": rc, "verdict": {0: "PASS", 1: "FAIL"}.get(rc, "REFUSED"), "out": out[-2000:]}
   715	            bad = rc not in (0, 1) and "E2 refused"
   716	        elif c["gate"] == "PROBE":
   717	            rel, digest = os.path.relpath(c["log"], REPO), self.campaign_digest()
   718	            rc, out = self.g.finalize(rel, digest)
   719	            j = self.cfg.get("probe_json") or os.path.join(HERE, "orbitrir_bf_cond_probe.json")
