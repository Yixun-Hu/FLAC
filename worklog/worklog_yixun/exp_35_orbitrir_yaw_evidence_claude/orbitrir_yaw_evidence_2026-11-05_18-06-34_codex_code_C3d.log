   151	        r, (names, other, good) = c[GATE_KEYS[g][0]], VERDICTS[g]
   152	        if not (isinstance(r, dict) and list(r) == ["rc", "verdict", "out"] and type(r["rc"]) is int
   153	                and isinstance(r["out"], str) and r["verdict"] == names.get(r["rc"], other)):
   154	            return [f"chunk {n}: a malformed {g} result {r!r:.120}"]
   155	        passed = r["rc"] in good
   156	    if not passed and (c["state"] == "gates_verified" or not latched):
   157	        return [f"chunk {n}: a failed {g} result in a {c['state']} chunk" + ("" if latched else " without the stop latch")]
