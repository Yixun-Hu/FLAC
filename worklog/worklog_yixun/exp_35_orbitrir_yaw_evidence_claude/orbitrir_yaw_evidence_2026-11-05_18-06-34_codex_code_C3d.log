    27	def proc_entry(root, pid, *, ppid=1, start=887766, cmdline=CMD, cwd="/home/yixunhu/codespace/flac-fork-attn"):
    28	    base = root / str(pid)
    29	    shutil.rmtree(base, ignore_errors=True)
    30	    (base / "fd").mkdir(parents=True)
    31	    fields = ["S", str(ppid)] + ["7"] * 17 + [str(start)] + ["0"] * 30           # field 4 ppid, field 22 start
    32	    (base / "stat").write_text(f"{pid} (python x) " + " ".join(fields) + "\n")
    33	    (base / "cmdline").write_bytes(cmdline)
    34	    os.symlink(cwd, base / "cwd")
    35	    for fd in ("1", "2"):
