   161	def tuple_file(world):
   162	    I = S.identity_module()
   163	    doc = {"schema_version": 1, "gpu_uuid": G1, "processes": [I.proc_identity(TR1, str(world.procdir))]}
   164	    path = world.tmp / "approved.json"
   165	    path.write_bytes(json.dumps(doc).encode())
   166	    return str(path), hashlib.sha256(path.read_bytes()).hexdigest()
