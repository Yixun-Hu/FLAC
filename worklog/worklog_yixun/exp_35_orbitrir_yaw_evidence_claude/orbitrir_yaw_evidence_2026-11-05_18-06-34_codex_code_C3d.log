  1835	def exp35_e2(*, pin, manifest, base_dir=REPO, csv_path=None, farm_root=None, dump_root=None):
  1836	    """§4 E2 (decides only the 45-degree source): ``exp35_BF_T_S40000_K{1,8}_s42`` vs the sha-pinned A6 CSV row
  1837	    (method ``FA B-F@40k``, angle 0, seed 42) -- PASS iff all 14 |differences| are within E2_TOLERANCE."""
  1838	    import csv
  1839	    import hashlib
  1840	    path = csv_path or A6_CSV
  1841	    res = {"status": "REFUSED", "pass": None, "csv": path, "csv_sha256": None, "rows": [], "rows45": [], "reasons": [],
  1842	           "rule": "|new - A6 CSV| <= " + ", ".join(f"{k} {v:g}" for k, v in E2_TOLERANCE.items()) + " (all 14)"}
  1843	    try:
  1844	        with open(path, "rb") as f:
  1845	            raw = f.read()
  1846	    except OSError as err:
  1847	        return dict(res, reasons=[f"the A6 CSV {path} is unreadable ({err})"])
  1848	    res["csv_sha256"] = hashlib.sha256(raw).hexdigest()
  1849	    if res["csv_sha256"] != A6_CSV_SHA256:
  1850	        return dict(res, reasons=[f"the A6 CSV hashes to {res['csv_sha256']}, not the pinned {A6_CSV_SHA256}"])
  1851	    table = list(csv.DictReader(raw.decode().splitlines()))
  1852	    for k in (1, 8):
  1853	        hits = [r for r in table if (r["method"], r["K"], r["angle_deg"], r["seed"]) == ("FA B-F@40k", str(k), "0", "42")]
  1854	        _, _, new, why = _verified_cell(f"exp35_BF_T_S40000_K{k}_s42", manifest=manifest, pin=pin, base_dir=base_dir,
  1855	                                        farm_root=farm_root, dump_root=dump_root)
  1856	        res["reasons"] += why + ([] if len(hits) == 1 else [f"the A6 CSV holds {len(hits)} FA B-F@40k K{k} theta 0 s42 rows"])
  1857	        if why or len(hits) != 1:
  1858	            continue
  1859	        for key, tol in E2_TOLERANCE.items():
  1860	            a, b = float(new["metrics"]["metrics"][key]), float(hits[0][key])
  1861	            res["rows"].append({"K": k, "metric": key, "new": a, "a6": b, "abs_diff": abs(a - b), "tolerance": tol,
  1862	                                "pass": abs(a - b) <= tol})
  1863	    if res["reasons"]:
