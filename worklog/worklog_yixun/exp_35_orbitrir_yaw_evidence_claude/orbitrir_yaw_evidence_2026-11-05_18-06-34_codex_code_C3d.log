   110	    def probe_exit(self, proc):
   111	        """The probe's own outputs: its JSON and the sha256 sidecar (finalization is the gates' business)."""
   112	        (self.tmp / "orbitrir_bf_cond_probe.json").write_text('{"fake": true}')
   113	        (self.tmp / "orbitrir_bf_cond_probe.json.sha256").write_text("x  orbitrir_bf_cond_probe.json\n")
   114	
   115	    def at_spawn(self, k, fn):
   116	        """Run ``fn`` once the k-th spawn happened (on the next sleep)."""
   117	        self.hooks.append((lambda w: len(w.spawned) >= k, fn))
