  1817	    out, rm, nm = [], ref["receipt"]["dump_evidence"]["manifest"], new["receipt"]["dump_evidence"]["manifest"]
  1818	    for label, a, b in (("waveform sha256", nm["sha256"], pinned["waveform_sha256"]),
  1819	                        ("COMPLETE marker", new["receipt"]["dump_evidence"]["marker"], pinned["waveform_sha256"] + "\n"),
  1820	                        ("dump n / dtype / shape", [nm["n"], nm["dtype"], nm["shape"]],
  1821	                         [CTL_DUMP_SHAPE[0], "float32", CTL_DUMP_SHAPE]),
  1822	                        ("dump input_hash", nm["input_hash"], rm["input_hash"]),
  1823	                        ("stream sidecar sha256", hashlib.sha256(new["stream_raw"]).hexdigest(), pinned["stream_sha256"]),
