    69	def strict_diff(got, want, label):
    70	    """The first TYPE-strict difference as text, or None (dict key sets, list order, bool vs int)."""
    71	    if type(got) is not type(want):
    72	        return f"{label}: {got!r} is not {want!r} ({type(got).__name__} vs {type(want).__name__})"
    73	    if isinstance(want, dict):
    74	        if set(got) != set(want):
    75	            return f"{label}: keys {sorted(got)} != {sorted(want)}"
    76	        return next((d for k in want for d in [strict_diff(got[k], want[k], f"{label}.{k}")] if d), None)
    77	    if isinstance(want, list):
    78	        if len(got) != len(want):
    79	            return f"{label}: {len(got)} entries != {len(want)}"
    80	        return next((d for i, (a, b) in enumerate(zip(got, want)) for d in [strict_diff(a, b, f"{label}[{i}]")]
    81	                     if d), None)
    82	    return None if got == want else f"{label}: {got!r} != {want!r}"
