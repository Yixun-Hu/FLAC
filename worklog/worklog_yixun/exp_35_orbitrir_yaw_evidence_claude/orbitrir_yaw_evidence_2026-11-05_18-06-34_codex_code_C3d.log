    64	class FakeWorld:
    65	    def __init__(self, tmp):
    66	        self.tmp, self.procdir, self.res = tmp, tmp / "proc", tmp / "reservations"
    67	        self.procdir.mkdir()
    68	        self.res.mkdir()
    69	        self.log = tmp / "train_s43.log"
    70	        TG.write_log(self.log, [4.23, 4.23, 4.23])
    71	        self.t = os.stat(self.log).st_mtime
    72	        self.gpus = {0: G0, 1: G1}
    73	        self.apps = [(TR0, G0), (TR1, G1)]
    74	        proc_entry(self.procdir, TR0)
    75	        proc_entry(self.procdir, TR1)
    76	        self.procs, self.spawned, self.sleeps, self.hooks, self.pid = [], [], [], [], 50000
    77	        self.behaviour = lambda argv: (2, 0)
    78	
    79	    def now(self):
    80	        return self.t
    81	
    82	    def sleep(self, s):
    83	        if len(self.sleeps) >= 600:                   # a supervisor that would wait for ever fails, not hangs
    84	            raise RuntimeError("the supervisor waited past the fake world's horizon (600 sleeps)")
    85	        self.t += s
    86	        self.sleeps.append(s)
    87	        for p in list(self.procs):
    88	            p.tick()
    89	        for hook in [h for h in self.hooks if h[0](self)]:
    90	            self.hooks.remove(hook)
    91	            hook[1](self)
    92	
    93	    def nvsmi(self, query):
    94	        rows = self.gpus.items() if query == "map" else self.apps
    95	        return "".join(f"{a}, {b}\n" for a, b in rows)
    96	
    97	    def spawn(self, argv, env, log):
    98	        self.pid += 10
    99	        polls, rc = self.behaviour(argv)
   100	        uuid = self.gpus[int(env["CUDA_VISIBLE_DEVICES"])] if "--lanes" not in argv else self.gpus[
   101	            int(argv[argv.index("--lanes") + 1])]
   102	        self.spawned.append({"argv": argv, "env": env, "log": log, "t": self.t, "uuid": uuid, "sleeps": len(self.sleeps),
   103	                             "files": sorted(p.name for p in self.res.iterdir())})
   104	        with open(log, "w") as f:
   105	            f.write(f"fake {argv[1]}\n")
   106	        p = FakeProc(self, self.pid, polls, rc, uuid, self.probe_exit if "--arm" in argv else None)
   107	        self.procs.append(p)
   108	        return p
