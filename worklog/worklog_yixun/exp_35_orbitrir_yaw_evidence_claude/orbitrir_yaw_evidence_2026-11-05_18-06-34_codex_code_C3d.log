   111	def test_the_state_is_written_atomically(tmp_path, monkeypatch):
   112	    path, calls = str(tmp_path / "state.json"), []
   113	    real = os.fsync
   114	    monkeypatch.setattr(S.os, "fsync", lambda fd: (calls.append(os.fstat(fd).st_mode), real(fd)))
   115	    S.write_state(path, _state())
   116	    assert json.load(open(path)) == _state() and len(calls) == 2           # the temp file, then the directory
   117	    assert [p.name for p in tmp_path.iterdir()] == ["state.json"]
   118	    import stat
   119	    assert stat.S_ISREG(calls[0]) and stat.S_ISDIR(calls[1])
