   375	def _eps_max(results, keys):
   376	    """``(value, key, conditioner id, position)`` of the max fp32 conditioning relL2 over ``keys``."""
   377	    return max((v, k, i, pos) for k in keys for i, d in results["fp32"][k]["cond"]["per_id"].items()
   378	               for pos, v in enumerate(d["relL2"]))
