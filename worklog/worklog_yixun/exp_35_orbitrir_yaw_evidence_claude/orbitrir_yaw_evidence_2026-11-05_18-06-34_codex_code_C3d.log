   126	class FakeGates:
   127	    def __init__(self):
   128	        self.calls, self.e1_rc, self.e2_rc, self.finalize_rc, self.bad_verify = [], {1: 0, 8: 0}, 0, 0, set()
   129	        self.probe_json = None
   130	
   131	    def verify(self, chunk):
   132	        self.calls.append(("verify", chunk["cell"]))
   133	        if chunk["cell"] in self.bad_verify:
   134	            return False, {"reasons": ["INVALID"]}
   135	        return True, {"receipt_sha256": hashlib.sha256(chunk["cell"].encode()).hexdigest(), "campaign_digest": "d" * 64}
   136	
   137	    def e1(self, k):
   138	        self.calls.append(("E1", k))
   139	        return self.e1_rc[k], "E1 out"
   140	
   141	    def e2(self):
   142	        self.calls.append(("E2",))
   143	        return self.e2_rc, "E2 out"
   144	
   145	    def finalize(self, log, digest):
   146	        """As the collector does: the probe JSON's provenance.launch names the log + its sha256 and the digest, the
   147	        JSON is rewritten and its sidecar sealed (only on success)."""
   148	        self.calls.append(("finalize", log, digest))
   149	        if self.finalize_rc == 0 and self.probe_json:
   150	            with open(os.path.join(S.REPO, log), "rb") as f:
   151	                log_sha = hashlib.sha256(f.read()).hexdigest()
   152	            text = json.dumps({"provenance": {"launch": {"campaign_digest": digest, "log_path": log,
   153	                                                         "log_sha256": log_sha}}}, indent=1) + "\n"
   154	            with open(self.probe_json, "w") as f:
   155	                f.write(text)
   156	            with open(self.probe_json + ".sha256", "w") as f:
   157	                f.write(f"{hashlib.sha256(text.encode()).hexdigest()}  {os.path.basename(self.probe_json)}\n")
   158	        return self.finalize_rc, "BF PROBE VALID" if self.finalize_rc == 0 else "BF PROBE INVALID"
