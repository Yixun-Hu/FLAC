+@pytest.mark.parametrize("target", ["the mark", "a staged temp", "a planned directory"])
+@pytest.mark.parametrize("err", [errno.EIO, errno.EACCES], ids=["EIO", "EACCES"])
+def test_a_creation_whose_follow_up_probe_fails_is_never_treated_as_absent(env, monkeypatch, target, err):
+    state, docs = env
+    a, sub = docs / "a.md", docs / "sub"
+    a.write_bytes(b"a\n")
+    t = txn(state)
+    t.create(sub / "n.md", b"n\n", parents=True)
+    t.append(a, "a2\n")
+    created, real_open, real_mkdir = [], os.open, os.mkdir
+    suffix = rt.MANIFEST if target == "the mark" else ".records_txn.tmp"
+
+    def open_then_raise(path, flags, *args, **kwargs):
+        fd = real_open(path, flags, *args, **kwargs)
+        if target != "a planned directory" and os.fspath(path).endswith(suffix) and flags & os.O_CREAT and not created:
+            created.append(os.fspath(path))
+            os.close(fd)
+            raise OSError(errno.EIO, "injected after the real creation")
+        return fd
+
+    def mkdir_then_raise(path, *args, **kwargs):
+        real_mkdir(path, *args, **kwargs)
+        if target == "a planned directory" and os.fspath(path) == str(sub.resolve()) and not created:
+            created.append(os.fspath(path))
+            raise OSError(errno.EIO, "injected after the real creation")
+    monkeypatch.setattr(rt.os, "open", open_then_raise)
+    monkeypatch.setattr(rt.os, "mkdir", mkdir_then_raise)
+    fail_lstat(monkeypatch, created, err)                # the follow-up probe of the created object fails
+    with pytest.raises(rt.RecoveryNeeded, match="may not be ours") as refused:
+        t.commit()
+    monkeypatch.undo()
+    assert os.path.lexists(created[0]) and (state / rt.MANIFEST).exists() and a.read_bytes() == b"a\n"
+    if target == "a staged temp":                        # and status never reports it as missing
+        line = next(x for x in str(refused.value).splitlines() if x.startswith("  [") and created[0] in x)
+        assert "unknown" in line.split("staged temp", 1)[1] and "missing" not in line.split("staged temp", 1)[1]
+    if target == "a planned directory":                  # ... nor as absent
+        assert f"  planned directory {created[0]}: unknown" in str(refused.value).splitlines()
+    with pytest.raises(rt.RecoveryNeeded):
+        rt.Transaction(state)
