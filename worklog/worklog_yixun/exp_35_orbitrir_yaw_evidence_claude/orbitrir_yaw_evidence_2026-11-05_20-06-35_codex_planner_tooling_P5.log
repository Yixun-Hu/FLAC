+def fail_lstat(monkeypatch, paths, err=errno.EIO):
+    """From now on, lstat of any path in `paths` (a list that may grow) raises `err` - an unknown, not an absence."""
+    real_lstat = os.lstat
+
+    def lstat(path, *args, **kwargs):
+        if os.fspath(path) in paths:
+            raise OSError(err, os.strerror(err))
+        return real_lstat(path, *args, **kwargs)
+    monkeypatch.setattr(rt.os, "lstat", lstat)
