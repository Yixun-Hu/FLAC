+    ok = side == f"{hashlib.sha256(raw).hexdigest()}  {os.path.basename(path)}\n" and isinstance(rep, dict)
+    return raw, rep, [] if ok else [f"the B-F probe's sha256 sidecar does not match {path} (or it is no object)"]
