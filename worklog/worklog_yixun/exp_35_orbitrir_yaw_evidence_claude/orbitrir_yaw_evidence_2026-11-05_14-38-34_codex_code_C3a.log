  1791	        if diff is not None:
  1792	            out.append(f"CTL K{k} record {key} differs from the exp_25 cell: {diff}")
  1793	    rest = lambda d: {x: v for x, v in d.items() if x not in ("metrics", "by_scene", "source_sha", "eval_name")}  # noqa
  1794	    _eq(out, f"CTL K{k} record (every other key but source_sha / eval_name)", rest(new["metrics"]), rest(ref["metrics"]))
