   162	    cfg = dict(json.load(open(cfg_path)), sample_size=64)
   163	    open(cfg_path, "w").write(json.dumps(cfg))
   164	    torch.save({"state_dict": {"diffusion_ema.ema_model.model.w": torch.ones(2)}, "model_config": cfg}, ckpt_path)
   165	    (tmp_path / "data.json").write_text(json.dumps({"datasets": [{"id": "toy"}]}))
   166	    sha = lambda p: hashlib.sha256(open(p, "rb").read()).hexdigest()  # noqa: E731
   167	    if registered:
   168	        monkeypatch.setattr(probe, "REGISTERED_BF", {
   169	            "n_items": 5, "batch_size": bs, "seed": 42, "device": "cpu", "model_config": cfg_path,
   170	            "model_config_sha256": sha(cfg_path), "dataset_config": str(tmp_path / "data.json"),
   171	            "dataset_config_sha256": sha(str(tmp_path / "data.json"))})
   172	    toy = TP._toy_module()
   173	    monkeypatch.setattr(eval_FLAC, "create_model_from_config",
   174	                        lambda c: types.SimpleNamespace(load_state_dict=lambda sd, strict=False: ([], [])))
   175	    monkeypatch.setattr(eval_FLAC, "create_training_wrapper_from_config", lambda c, m: toy)
   176	    monkeypatch.setattr(eval_FLAC, "create_dataloader_from_config", lambda *a, **k: TP._ToyLoader(n_loader, bs))
   177	    out = tmp_path / "bf_probe.json"
