   390	def run_probe(module, reals, metadata, img_w, seed, batch_size, latent_len, protocols=None):
   391	    """Per protocol and offset key: stagewise B-vs-A comparisons for every item, A run
   392	    twice for the determinism floor, the Tier-1 record, eps_cond and the control p99."""
   393	    protocols = PROTOCOLS if protocols is None else protocols
   394	    n = len(metadata)
   395	    if reals.shape[0] != n:
   396	        raise ValueError(f"{reals.shape[0]} reals for {n} metadata items")
   397	    offsets = draw_offsets(n, img_w, seed)
   398	    noise = noise_bank(n, (module.diffusion.io_channels, latent_len), seed)
   399	    acc = {p: {k: _new_acc() for k in OFFSET_KEYS} for p in protocols}
   400	    det = {p: _new_acc() for p in protocols}
   401	    items = []
   402	    for start in range(0, n, batch_size):
   403	        sl = slice(start, min(start + batch_size, n))
   404	        a_list, b_lists, tier1 = canonical_pairs(list(metadata[sl]), {k: v[sl] for k, v in offsets.items()},
   405	                                                 img_w)
   406	        items += tier1
   407	        for p, proto in protocols.items():
   408	            sa = run_stages(module, a_list, noise[sl], reals[sl], proto)
   409	            _append(det[p], compare_stages(run_stages(module, a_list, noise[sl], reals[sl], proto), sa))
   410	            for key in OFFSET_KEYS:
   411	                _append(acc[p][key], compare_stages(
   412	                    run_stages(module, b_lists[key], noise[sl], reals[sl], proto), sa))
   413	    results = {p: {k: _finish(acc[p][k]) for k in OFFSET_KEYS} for p in protocols}
   414	    pooled = {p: _pooled(results[p]) for p in protocols}
   415	    eps = _eps_cond(results)
   416	    control = {p: dict({k: results[p][k]["waveform"]["summary"]["relL2"]["p99"] for k in OFFSET_KEYS},
   417	                       pooled=pooled[p]["waveform"]["relL2"]["p99"]) for p in protocols}
   418	    pairs = [o for it in items for o in it["offsets"].values()]
   419	    t1 = {"n_pairs": len(pairs)} | {f: sum(o[f] for o in pairs)
   420	                                    for f in ("depth_sha_equal", "class_equal", "dj_corotates")}
   421	    verdict = {"eps_cond": bool(eps and eps["pass"]),
   422	               "tier1": all(t1[f] == t1["n_pairs"] for f in ("depth_sha_equal", "class_equal", "dj_corotates")),
   423	               "masks": all(results[p][k]["cond"]["masks_equal"] for p in protocols for k in OFFSET_KEYS)}
   424	    verdict = {"pass": all(verdict.values()), **verdict}
   425	    return {"offsets": offsets, "items": items, "tier1": t1, "results": results, "pooled": pooled,
   426	            "determinism": {p: _finish(det[p]) for p in protocols}, "eps_cond": eps,
   427	            "control_p99": control, "verdict": verdict}
   428	
   429	
   430	def run_probe_bf(module, reals, metadata, img_w, seed, batch_size, latent_len, protocols=None):
   431	    """exp_35: per protocol and quarter turn, stagewise B-vs-A comparisons for every item with the FA
   432	    conditioning (no canonicalization), A run twice for the determinism floor, eps_cond REPORTED (no
   433	    verdict), the control p99 (per offset and pooled) and the verdict: masks equal AND the floor exactly 0."""
   434	    protocols = PROTOCOLS if protocols is None else protocols
   435	    n = len(metadata)
   436	    if reals.shape[0] != n:
   437	        raise ValueError(f"{reals.shape[0]} reals for {n} metadata items")
   438	    offsets, keys = bf_offsets(n), BF_OFFSET_KEYS
   439	    noise = noise_bank(n, (module.diffusion.io_channels, latent_len), seed)
   440	    acc = {p: {k: _new_acc() for k in keys} for p in protocols}
   441	    det = {p: _new_acc() for p in protocols}
   442	    for start in range(0, n, batch_size):
   443	        sl = slice(start, min(start + batch_size, n))
   444	        a_list, b_lists = bf_pairs(list(metadata[sl]), {k: v[sl] for k, v in offsets.items()}, img_w)
   445	        for p, proto in protocols.items():
   446	            run = lambda mds: run_stages(module, mds, noise[sl], reals[sl], proto, cond_fn=bf_conditioning)  # noqa
   447	            sa = run(a_list)
   448	            _append(det[p], compare_stages(run(a_list), sa))
   449	            for key in keys:
   450	                _append(acc[p][key], compare_stages(run(b_lists[key]), sa))
   451	    results = {p: {k: _finish(acc[p][k]) for k in keys} for p in protocols}
   452	    pooled = {p: _pooled(results[p], keys) for p in protocols}
   453	    value, key, cid, pos = _eps_max(results, keys) if "fp32" in results else (None,) * 4
   454	    control = {p: dict({k: results[p][k]["waveform"]["summary"]["relL2"]["p99"] for k in keys},
   455	                       pooled=pooled[p]["waveform"]["relL2"]["p99"]) for p in protocols}
   456	    masks = all(d["cond"]["masks_equal"] for p in protocols for d in list(acc[p].values()) + [det[p]])
   457	    exact = all(v == 0.0 for p in protocols for d in [det[p]["cond"]["all"]] + [det[p][s] for s in STAGES[1:]]
   458	                for v in d["relL2"])
   459	    return {"offsets": offsets, "items": [{} for _ in range(n)], "results": results, "pooled": pooled,
   460	            "determinism": {p: _finish(det[p]) for p in protocols},
   461	            "eps_cond": {"value": value, "argmax": {"key": key, "id": cid, "position": pos}},
   462	            "control_p99": control, "verdict": {"pass": bool(masks and exact), "masks": bool(masks),
   463	                                                "determinism": bool(exact)}}
