   222	    objective = (model.diffusion_objective if hasattr(model, "diffusion_objective")
   223	                 else getattr(model, "objective", "rectified_flow"))
   224	    if objective != "rectified_flow":
   225	        raise ValueError(f"the probe mirrors the rectified_flow 1-step path only, got {objective!r}")
   226	    velocities = []
   227	
   228	    def recording_model(x, t, **kw):
   229	        v = model(x, t, **kw)
   230	        velocities.append(v)
   231	        return v
   232	
   233	    with matmul_precision(protocol["matmul_precision"]), torch.no_grad():
   234	        ctx = (contextlib.nullcontext() if not enabled else torch.amp.autocast(device_type)
   235	               if dtype is None else torch.amp.autocast(device_type, dtype=dtype))
