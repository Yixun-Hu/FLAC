   549	def _sha256_file(path):
   550	    import hashlib
   551	    h = hashlib.sha256()
   552	    with open(path, "rb") as f:
   553	        for chunk in iter(lambda: f.read(1 << 20), b""):
   554	            h.update(chunk)
   555	    return h.hexdigest()
