   332	# --------------------------------------------------------------------------- #
   333	# the probe proper (no I/O)
   334	# --------------------------------------------------------------------------- #
   335	EPS_COND_THRESHOLD = 1e-5
   336	
   337	
   338	def _pair_lists():
   339	    return {"relL2": [], "relLinf": []}
   340	
   341	
   342	def _new_acc():
   343	    acc = {"cond": {"ids": None, "masks_equal": True, "per_id": {}, "all": _pair_lists()}}
   344	    acc.update({s: _pair_lists() for s in STAGES[1:]})
   345	    return acc
   346	
   347	
   348	def _append(acc, cmp):
   349	    c = cmp["cond"]
   350	    if acc["cond"]["ids"] not in (None, c["ids"]):
   351	        raise RuntimeError(f"conditioner ids changed between batches: {acc['cond']['ids']} -> {c['ids']}")
   352	    acc["cond"]["ids"] = c["ids"]
   353	    acc["cond"]["masks_equal"] = acc["cond"]["masks_equal"] and c["masks_equal"]
   354	    for target, src in [(acc["cond"]["per_id"].setdefault(i, _pair_lists()), c[i]) for i in c["ids"]] + \
   355	            [(acc["cond"]["all"], c["all"])] + [(acc[s], cmp[s]) for s in STAGES[1:]]:
   356	        for k in ("relL2", "relLinf"):
   357	            target[k].extend(float(v) for v in src[k])
   358	
   359	
   360	def _finish(acc):
   361	    for d in list(acc["cond"]["per_id"].values()) + [acc["cond"]["all"]] + [acc[s] for s in STAGES[1:]]:
   362	        d["summary"] = summarize({k: np.array(d[k]) for k in ("relL2", "relLinf")})
   363	    return acc
   364	
   365	
   366	def _pooled(results_p, keys=OFFSET_KEYS):
   367	    """Per stage, the summary over the registered offsets' items together."""
   368	    out = {}
   369	    for s in STAGES:
   370	        rows = [results_p[k]["cond"]["all"] if s == "cond" else results_p[k][s] for k in keys]
   371	        out[s] = summarize({m: np.array([v for r in rows for v in r[m]]) for m in ("relL2", "relLinf")})
   372	    return out
   373	
   374	
   375	def _eps_max(results, keys):
   376	    """``(value, key, conditioner id, position)`` of the max fp32 conditioning relL2 over ``keys``."""
   377	    return max((v, k, i, pos) for k in keys for i, d in results["fp32"][k]["cond"]["per_id"].items()
   378	               for pos, v in enumerate(d["relL2"]))
   379	
   380	
   381	def _eps_cond(results):
   382	    """max fp32 conditioning relL2 over the registered offsets, conditioner ids and items."""
   383	    if "fp32" not in results:
   384	        return None
   385	    value, key, cid, pos = _eps_max(results, OFFSET_KEYS)
   386	    return {"value": value, "threshold": EPS_COND_THRESHOLD, "pass": value <= EPS_COND_THRESHOLD,
   387	            "argmax": {"key": key, "id": cid, "position": pos}}
