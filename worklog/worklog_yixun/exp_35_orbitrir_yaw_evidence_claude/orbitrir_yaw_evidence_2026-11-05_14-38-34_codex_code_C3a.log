    65	def draw_offsets(n_items, img_w, seed):
    66	    """``{key: [d_i per item]}``: the four fixed column offsets and one independent
    67	    uniform draw in ``[1, img_w - 1]`` per item from a generator seeded with
    68	    ``seed + RANDOM_OFFSET_SEED_SHIFT``."""
    69	    _check_int("n_items", n_items, 1)
