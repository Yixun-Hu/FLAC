   593	def write_report(report, out):
   594	    """``json.dumps(indent=1)`` + newline, then the ``sha256sum`` sidecar."""
   595	    import hashlib
   596	    import json
   597	    text = json.dumps(report, indent=1) + "\n"
   598	    with open(out, "w") as f:
   599	        f.write(text)
   600	    with open(out + ".sha256", "w") as f:
   601	        f.write(f"{hashlib.sha256(text.encode()).hexdigest()}  {os.path.basename(out)}\n")
