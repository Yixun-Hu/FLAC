   172	PLAN_ARGS=(--plan "$PLAN" --cells "$CELLS" --farm-root "$FARM_ROOT" --no-dump-blocks "$NO_DUMP"
   173	           --campaign-digest "$CAMPAIGN_DIGEST")
   174	[ -n "$DUMP_ROOT" ] && PLAN_ARGS+=(--dump-root "$DUMP_ROOT")
   175	[ -n "$BLOCKS" ] && PLAN_ARGS+=(--blocks "$BLOCKS")
   176	[ -n "$ONLY" ] && PLAN_ARGS+=(--only "$ONLY")
   177	[ -n "$LIMIT" ] && PLAN_ARGS+=(--limit "$LIMIT")
   178	[ -n "$CANON_MANIFEST" ] && PLAN_ARGS+=(--canon-ckpt-manifest "$CANON_MANIFEST")
   179	"$PY" "$COLLECT" "${PLAN_ARGS[@]}" || die "PLAN REFUSED (see above) - abort"
   180	DUMP_ROOT="$(jq -r .dump_root "$PLAN")"
   181	mapfile -t CELL_IDS < <(jq -r '.cells[].cell' "$PLAN")
   182	echo "plan: ${#CELL_IDS[@]} cell(s); dump root ${DUMP_ROOT}; farm ${FARM_ROOT}; lanes ${LANES_CSV}"
   183	[ "$(jq '[.cells[] | select(.no_flash == true)] | length' "$PLAN")" = "$N_NOFLASH" ] \
   184	  || die "PLAN REFUSED: the plan's exp_35 cells are not the ${N_NOFLASH} counted for the relevant tree - abort"
   185	if [ -n "$COTENANTS" ]; then   # exp_35 §12 B1.1: the approved identity tuple of a SHARED lane
   186	  [ "$N_NOFLASH" -gt 0 ] || die "EXP35_APPROVED_COTENANTS is an exp_35 gate: this selection holds no exp_35 cell - abort"
   187	  [ "$ALLOW_SHARED_GPU" = 1 ] || die "EXP35_APPROVED_COTENANTS names the co-tenants of a shared card: it needs ALLOW_SHARED_GPU=1 - abort"
   188	  [[ "$COTENANTS_SHA" =~ ^[0-9a-f]{64}$ ]] \
   189	    || die "EXP35_APPROVED_COTENANTS needs EXP35_APPROVED_COTENANTS_SHA256 (the launch entry's sha256 of its bytes) - abort"
   190	  "$PY" "$IDENTITY" --validate "$COTENANTS" --approved-sha256 "$COTENANTS_SHA" || die "CO-TENANT TUPLE REFUSED: ${COTENANTS} - abort"
   191	elif [ "$ALLOW_SHARED_GPU" = 1 ] && [ "$N_NOFLASH" -gt 0 ]; then
   192	  die "an exp_35 cell shares a card only with the approved identity tuple: set EXP35_APPROVED_COTENANTS - abort"
   193	fi
   194	if [ "$N_NOFLASH" -gt 0 ]; then   # exp_35 §11 B1: the launcher's own checks, on the CPU, before any spawn
   195	  PREFLIGHT_LOG="$LOGDIR/depth_canon_${TS}_no_flash_preflight.log"
   196	  { CUDA_VISIBLE_DEVICES= HF_HUB_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$REPO/$NO_FLASH_DIR" \
   197	      "$PY" "$NO_FLASH_LAUNCHER" --preflight > "$PREFLIGHT_LOG" 2>&1 \
   198	    && "$PY" "$COLLECT" --check-backend-log "$PREFLIGHT_LOG" --backend-target=--preflight 2>&1 \
   199	       | grep -v -e pkg_resources -e declare_namespace; [ "${PIPESTATUS[0]}" -eq 0 ]; } \
   200	    || die "NO-FLASH PRE-FLIGHT FAILED (log ${PREFLIGHT_LOG}) - abort"
   201	  echo "no-flash pre-flight OK: ${N_NOFLASH} exp_35 cell(s) spawn through ${NO_FLASH_LAUNCHER} (log ${PREFLIGHT_LOG})"
   202	fi
   203	
   204	# --- the dump root, verified ONCE: on the NAS share, created, write-probed ----------- #
   205	nas_identity_ok() {
   206	  local line
   207	  line="$(findmnt -n -T "$1" -o FSTYPE,SOURCE 2>/dev/null || true)"
   208	  grep -qE "^${NAS_FSTYPE}[[:space:]]+${NAS_SOURCE//./\\.}\$" <<<"$line" && return 0
   209	  echo "DUMP ROOT GATE FAILED: ${1} is on '$(tr '\n' ';' <<<"$line")', not '${NAS_FSTYPE} ${NAS_SOURCE}' - abort"
   210	  return 1
   211	}
   212	if [ "$(jq '[.cells[] | select(.dump)] | length' "$PLAN")" -gt 0 ]; then
   213	  [[ "$DUMP_ROOT" = /?* && "$DUMP_ROOT" != *.staging-* ]] || die "DUMP ROOT GATE FAILED: '${DUMP_ROOT}' must be absolute, no '.staging-' - abort"
   214	  [ ! -L "$DUMP_ROOT" ] || die "DUMP ROOT GATE FAILED: ${DUMP_ROOT} is a symlink - abort"
   215	  anc="$DUMP_ROOT"; while [ ! -e "$anc" ] && [ "$anc" != / ]; do anc="$(dirname "$anc")"; done
   216	  nas_identity_ok "$anc" || exit 2
   217	  if [ "$DRY_RUN" = 1 ]; then
   218	    echo "dump root OK under DRY_RUN: ${DUMP_ROOT} ($([ -d "$DUMP_ROOT" ] && echo exists || echo 'would be created'))"
   219	  else
   220	    mkdir -p "$DUMP_ROOT" && nas_identity_ok "$DUMP_ROOT" || die "DUMP ROOT GATE FAILED: cannot create ${DUMP_ROOT} - abort"
   221	    probe="$DUMP_ROOT/.depth_canon_eval_probe_$$"
   222	    { printf 'probe\n' > "$probe" && [ "$(cat "$probe")" = probe ] && rm -f "$probe" && [ ! -e "$probe" ]; } 2>/dev/null \
   223	      || { rm -f "$probe" 2>/dev/null; die "DUMP ROOT GATE FAILED: write probe in ${DUMP_ROOT} - abort"; }
   224	    echo "dump root OK: ${DUMP_ROOT} is ${NAS_FSTYPE} ${NAS_SOURCE}, write probe created + removed"
   225	  fi
   226	fi
   227	
   228	# --- the farm: a real local directory (never a symlink out of the checkout) ---------- #
   229	farm_ok() {   # <dir>: absent (DRY_RUN) or a real directory under the repo / harness
   230	  [ ! -L "$1" ] || die "FARM GATE FAILED: ${1} is a symlink - abort"
   231	  [ -e "$1" ] || return 0
   232	  case "$(readlink -f -- "$1")" in "$(readlink -f "$REPO")"/?*|"${HREAL:-/nonexistent}"/?*) ;;
   233	    *) die "FARM GATE FAILED: ${1} resolves outside this checkout - abort" ;; esac
   234	}
   235	farm_ok "$FARM_ROOT"
   236	
   237	# --- the checkpoint cache: a free-space gate on the local filesystem BEFORE any copy --- #
   238	CACHE_DIR="$FARM_ROOT/.ckpt_cache"; CACHE_MARGIN=$((2 * 1024 * 1024 * 1024))
   239	farm_ok "$CACHE_DIR"
   240	NEED=0; N_STAGE=0
   241	while IFS=$'\x1f' read -r target sha; do
   242	  [ -f "$CACHE_DIR/${sha}.ckpt" ] && continue
   243	  [ -f "$target" ] || die "CHECKPOINT MISSING: ${target} - abort"
   244	  NEED=$((NEED + $(stat -c %s -- "$target"))); N_STAGE=$((N_STAGE + 1))
   245	done < <(jq -r '[.cells[] | (.target + "\u001f" + .sha256)] | unique[]' "$PLAN")
   246	anc="$CACHE_DIR"; while [ ! -e "$anc" ]; do anc="$(dirname "$anc")"; done
   247	AVAIL="$(df -B1 --output=avail -- "$anc" 2>/dev/null | tail -n 1 | tr -d ' ')"
   248	[[ "$AVAIL" =~ ^[0-9]+$ ]] || die "CACHE SPACE GATE FAILED: df cannot report the free space of ${anc} - abort"
   249	echo "checkpoint cache space: ${N_STAGE} checkpoint(s) to stage = $((NEED)) B + ${CACHE_MARGIN} B margin = $((NEED + CACHE_MARGIN)) B needed; ${AVAIL} B available on ${anc}"
   250	[ "$AVAIL" -ge $((NEED + CACHE_MARGIN)) ] || die "CACHE SPACE GATE FAILED: $((NEED + CACHE_MARGIN)) B needed > ${AVAIL} B available - abort"
   251	
   252	# --- per cell: checkpoint, link, (predicate), (run) ----------------------------------- #
   253	declare -A SHA_DONE=() CKPT_SIZE=()
   254	cache_ok() {   # <cache> <sha>: the immutable-cache contract (regular, 0444, the source's size) + a full re-hash
   255	  local got mode size
   256	  { [ -f "$1" ] && [ ! -L "$1" ]; } || { CACHE_WHY="${1} is not a regular file"; return 1; }
   257	  mode="$(stat -c %a -- "$1")"; size="$(stat -c %s -- "$1")"
   258	  [ "$mode" = 444 ] || { CACHE_WHY="${1} has mode ${mode}, not the immutable 0444"; return 1; }
   259	  [ "$size" = "${CKPT_SIZE[$2]:-}" ] || { CACHE_WHY="${1} is ${size} bytes, the source is ${CKPT_SIZE[$2]:-unknown}"; return 1; }
   260	  got="$(sha256sum -- "$1" | awk '{print $1}')"
   261	  [ "$got" = "$2" ] || { CACHE_WHY="${1} hashes to ${got}, not ${2}"; return 1; }
   262	}
   263	stage_ckpt() {   # target sha nas-manifest nas-key cache: the verified immutable cache file (once per sha)
   264	  local target="$1" want="$2" nasm="$3" key="$4" cache="$5" got tmp
   265	  [ -f "$target" ] || { echo "CHECKPOINT MISSING: ${target} - abort"; return 1; }
   266	  if [ -n "$nasm" ]; then
   267	    grep -qxF "${want}  ${key}" "$nasm" 2>/dev/null || { echo "NAS MANIFEST CHECK FAILED: ${nasm} does not list '${want}  ${key}' - abort"; return 1; }
   268	  fi
   269	  [ -n "${SHA_DONE[$want]:-}" ] && return 0
   270	  CKPT_SIZE[$want]="$(stat -c %s -- "$target")"
   271	  if [ "$DRY_RUN" = 1 ]; then   # read-only: hash the source, stage nothing
   272	    got="$(sha256sum -- "$target" | awk '{print $1}')"
   273	    [ "$got" = "$want" ] || { echo "CHECKPOINT SHA MISMATCH: ${target} is ${got}, the manifest pins ${want} - abort"; return 1; }
   274	    echo "checkpoint OK (DRY_RUN, not staged): ${target} (${want})"
   275	  elif [ -e "$cache" ] || [ -L "$cache" ]; then   # rB-F2 F2-6 (a): the immutable-cache contract, then the bytes
   276	    cache_ok "$cache" "$want" || { echo "CACHE GATE FAILED: ${CACHE_WHY} - abort"; return 1; }
   277	    echo "checkpoint OK: cached ${cache} re-verified (0444, ${CKPT_SIZE[$want]} bytes, ${want})"
   278	  else
   279	    mkdir -p "$CACHE_DIR" && ( farm_ok "$CACHE_DIR" ) || { echo "CACHE GATE FAILED: cannot create ${CACHE_DIR} - abort"; return 1; }
   280	    tmp="$CACHE_DIR/.staging-${want}-$$"
   281	    cp --no-preserve=all -- "$target" "$tmp" || { rm -f -- "$tmp"; echo "CACHE GATE FAILED: cannot copy ${target} - abort"; return 1; }
   282	    got="$(sha256sum -- "$tmp" | awk '{print $1}')"
   283	    if [ "$got" != "$want" ]; then
   284	      rm -f -- "$tmp"; echo "CHECKPOINT SHA MISMATCH: the copy of ${target} is ${got}, the manifest pins ${want} - abort"; return 1
   285	    fi
   286	    { chmod 0444 -- "$tmp" && mv -n -T -- "$tmp" "$cache" && [ ! -e "$tmp" ]; } \
   287	      || { rm -f -- "$tmp"; echo "CACHE GATE FAILED: cannot publish ${cache} - abort"; return 1; }
   288	    echo "checkpoint OK: ${target} -> ${cache} (the local copy hashes to the pin ${want})"
   289	  fi
   290	  SHA_DONE[$want]=1
   291	}
   292	farm_entry_ok() {   # <entry> <cache>: a regular file (never a symlink) on the cache file's inode
   293	  [ ! -L "$1" ] && [ -f "$1" ] && [ ! -L "$2" ] && [ -f "$2" ] \
   294	    && [ "$(stat -c '%d:%i:%s' -- "$1")" = "$(stat -c '%d:%i:%s' -- "$2")" ]
   295	}
   296	cell_fields() {
   297	  jq -r --arg c "$1" '.cells[] | select(.cell == $c) | [.arm, .block, .target, .sha256,
   298	      (.nas_manifest // ""), (.nas_manifest_key // ""), .link, .metrics, .stream, (.canon // ""),
   299	      .canon_probe, .receipt, (.dump | tostring), .dump_dir, .stem, .cache, (.no_flash // false | tostring)]
   300	      | join("\u001f")' "$PLAN"
   301	}
   302	VERIFY_EXTRA=(); [ -n "$CANON_MANIFEST" ] && VERIFY_EXTRA=(--canon-ckpt-manifest "$CANON_MANIFEST")
   303	existing_artifacts() {   # every artifact of the current cell that exists (one path per line)
   304	  local p
   305	  for p in "$METRICS" "$STREAM" "$CANON_PROBE" "$RECEIPT" "$DUMP_DIR" "$DUMP_DIR".staging-*; do
   306	    case "$p" in *.staging-*.incomplete-*) continue ;; esac            # already parked
   307	    { [ -e "$p" ] || [ -L "$p" ]; } && printf '%s\n' "$p"
   308	  done
   309	}
   310	complete_and_verified() {   # 0 = SKIP; the collector runs is_complete exactly once
   311	  local extra=("${VERIFY_EXTRA[@]}") p
   312	  [ -f "$METRICS" ] && [ -f "$STREAM" ] && [ -f "$RECEIPT" ] || return 1
   313	  [ -z "$CANON" ] || [ -f "$CANON" ] || return 1
   314	  if [ "$DUMP" = true ]; then [ -d "$DUMP_DIR" ] && [ -f "$DUMP_DIR/COMPLETE" ] || return 1
   315	  else extra+=(--no-dump); fi
   316	  [ "$NOFLASH" = true ] && extra+=(--backend-target "$EVAL_PROG")       # exp_35: the log names the launched target
   317	  for p in "$DUMP_DIR".staging-*; do
   318	    case "$p" in *.incomplete-*) ;; *) [ -e "$p" ] && return 1 ;; esac
   319	  done
   320	  "$PY" "$COLLECT" --verify-cell "$STEM" --pin "$EXPECT_HEAD" --cells "$CELLS" --farm-root "$FARM_ROOT" \
   321	    --dump-root "$DUMP_ROOT" --base-dir "$REPO" --campaign-digest "$CAMPAIGN_DIGEST" "${extra[@]}" 2>&1 | grep -v -e pkg_resources -e declare_namespace | sed 's/^/    /'
   322	  return "${PIPESTATUS[0]}"
   323	}
   324	prepare_cell() {   # sets the cell globals; 0 = run it, 3 = SKIP, 1 = refused (message printed)
   325	  local cid="$1" what p dest
   326	  IFS=$'\x1f' read -r ARM BLOCK TARGET SHA NASM NASK LINK METRICS STREAM CANON CANON_PROBE RECEIPT \
   327	    DUMP DUMP_DIR STEM CACHED NOFLASH < <(cell_fields "$cid")
   328	  mapfile -t ARGV < <(jq -r --arg c "$cid" '.cells[] | select(.cell == $c) | .argv[]' "$PLAN")
   329	  stage_ckpt "$TARGET" "$SHA" "$NASM" "$NASK" "$CACHED" || return 1
   330	  if [ -L "$LINK" ] || [ -e "$LINK" ]; then
   331	    farm_entry_ok "$LINK" "$CACHED" \
   332	      || { echo "FARM GATE FAILED: ${LINK} exists and is not a hard link of the verified ${CACHED} - abort"; return 1; }
   333	  elif [ "$DRY_RUN" = 0 ]; then
   334	    mkdir -p "$(dirname "$LINK")" && ( farm_ok "$(dirname "$LINK")" ) && ln -- "$CACHED" "$LINK" \
   335	      && farm_entry_ok "$LINK" "$CACHED" || { echo "FARM GATE FAILED: cannot hard-link ${LINK} - abort"; return 1; }
   336	  fi
   337	  if complete_and_verified; then echo "CELL ${cid} | ${BLOCK} | SKIP (complete and verified)"; return 3; fi
   338	  mapfile -t STALE < <(existing_artifacts)
   339	  what="run"; [ "${#STALE[@]}" -gt 0 ] && what="QUARANTINE ${#STALE[@]} artifact(s), then run"
   340	  echo "CELL ${cid} | ${BLOCK} | ${ARM} | $([ "$DRY_RUN" = 1 ] && echo would) ${what}"
   341	  for p in "${STALE[@]}"; do
   342	    dest="${p}.incomplete-${TS}"
   343	    if [ "$DRY_RUN" = 1 ]; then echo "  would quarantine ${p}"; continue; fi
   344	    [ ! -e "$dest" ] && mv -- "$p" "$dest" || { echo "QUARANTINE FAILED: ${p} - abort"; return 1; }
   345	    echo "  QUARANTINED ${p} -> ${dest}"
   346	  done
   347	  return 0
   348	}
   349	N_SEL="${#CELL_IDS[@]}"
   350	if [ "$DRY_RUN" = 1 ]; then
   351	  for cid in "${CELL_IDS[@]}"; do
   352	    prepare_cell "$cid"; st=$?
   353	    [ "$st" -eq 1 ] && exit 2
   354	    [ "$st" -eq 0 ] && echo "DRYRUN ${cid} argv: $(jq -c --arg c "$cid" '.cells[] | select(.cell == $c) | .argv' "$PLAN")"
   355	    [ "$st" -eq 0 ] && [ "$NOFLASH" = true ] && echo "  (exp_35: spawned through ${NO_FLASH_LAUNCHER}, PYTHONPATH=${REPO}/${NO_FLASH_DIR})"
   356	  done
   357	  echo "=== DRY_RUN summary: ${N_SEL} cell(s) planned; nothing evaluated, linked, created or moved ==="
   358	  exit 0
   359	fi
   360	
   361	run_cell() {   # lane cell sha spawn-digest link cache no_flash argv... -- a background job: evaluate, receipt, verify
   362	  local lane="$1" cid="$2" sha="$3" spawn="$4" link="$5" cache="$6" noflash="$7"; shift 7
   363	  local clog="$LOGDIR/depth_canon_${TS}_eval_${cid}.log" rc=0 post measured nbytes out backend=()
   364	  if [ "$noflash" = true ]; then   # exp_35 (§11 B1, §12 H4 c): the pinned launcher, the overlay ONLY on PYTHONPATH
   365	    lane_state "$lane" || {      # Codex C2 BLOCKING 1: the lane / identity at the real pre-exec boundary
   366	      echo "  !! FAILED ${cid}: LANE CHANGED before the launch on GPU ${lane} (${LANE_WHY}); not launched, no receipt"
   367	      return 6; }
   368	    CUDA_VISIBLE_DEVICES="$lane" HF_HUB_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$REPO/$NO_FLASH_DIR" \
   369	      "$PY" "$NO_FLASH_LAUNCHER" "$EVAL_PROG" "$@" > "$clog" 2>&1 || rc=$?
   370	  else
   371	    CUDA_VISIBLE_DEVICES="$lane" HF_HUB_OFFLINE=1 "$PY" "$EVAL_PROG" "$@" > "$clog" 2>&1 || rc=$?
   372	  fi
   373	  if [ "$rc" -ne 0 ]; then echo "  !! FAILED ${cid}: the evaluator exited rc=${rc} (log ${clog})"; return 1; fi
   374	  post="$(tree_digest)" || post=""
   375	  if [ "$post" != "$CAMPAIGN_DIGEST" ] || [ -n "$(tree_dirty)" ]; then
   376	    echo "  !! FAILED ${cid}: the relevant tree changed while the cell ran (digest '${post}' != ${CAMPAIGN_DIGEST}); no receipt"
   377	    return 4
   378	  fi
   379	  measured="$(sha256sum -- "$link" | awk '{print $1}')"   # the file the evaluator opened, hashed again
   380	  nbytes="$(stat -c %s -- "$link")"                        # == the length eval_FLAC reports it loaded
   381	  if [ "$measured" != "$sha" ] || ! farm_entry_ok "$link" "$cache"; then
   382	    echo "  !! FAILED ${cid}: the evaluated checkpoint ${link} now hashes to '${measured}', not ${sha} (or left the cache inode); no receipt"
   383	    return 1
   384	  fi
   385	  if [ "$noflash" = true ]; then   # exp_35 §3b: the log must prove the SDPA backend, else a hard stop
   386	    out="$("$PY" "$COLLECT" --check-backend-log "$clog" --backend-target "$EVAL_PROG" 2>&1)" || {
   387	      echo "  !! FAILED ${cid}: BACKEND EVIDENCE missing from ${clog}; no receipt, the campaign stops:"
   388	      grep -v -e pkg_resources -e declare_namespace <<<"$out" | sed 's/^/    /'
   389	      return 5; }
   390	    backend=(--attention-backend sdpa --no-flash-overlay-sha256 "$NO_FLASH_OVERLAY_SHA256"
   391	             --no-flash-launcher-sha256 "$NO_FLASH_LAUNCHER_SHA256" --backend-target "$EVAL_PROG")
   392	  fi
   393	  "$PY" "$COLLECT" --write-receipt "$cid" --plan-json "$PLAN" --cells "$CELLS" --base-dir "$REPO" \
   394	    --lane "$lane" --log "$clog" --rc 0 --pin "$EXPECT_HEAD" --ckpt-sha "$measured" --ckpt-bytes "$nbytes" \
   395	    --farm-root "$FARM_ROOT" \
   396	    --spawn-digest "$spawn" --post-digest "$post" \
   397	    --dump-root "$DUMP_ROOT" "${VERIFY_EXTRA[@]}" "${backend[@]}" --verify-after >> "$clog" 2>&1 \
   398	    || { echo "  !! FAILED ${cid}: post-run verification refused the cell (log ${clog})"; return 1; }
   399	  echo "  DONE ${cid} on GPU ${lane}: complete and verified"
   400	}
   401	declare -A LANE_PID=() PID_CELL=() PID_LANE=() GPU_NOTE=()
   402	N_SKIP=0; N_DONE=0; FAILED=(); ABORT=""; DRIFT=""; NEXT=0; POLLS=0; i=0; READY=""
   403	reap() {   # collect every finished job; never waits on a running one, never signals anything
   404	  local pid st running=" $(jobs -rp | tr '\n' ' ') "
   405	  for pid in "${!PID_CELL[@]}"; do
   406	    case "$running" in *" ${pid} "*) continue ;; esac
   407	    st=0; wait "$pid" || st=$?
   408	    if [ "$st" -eq 0 ]; then N_DONE=$((N_DONE + 1)); else FAILED+=("${PID_CELL[$pid]}"); fi
   409	    if [ "$st" -eq 4 ]; then DRIFT=1; ABORT="${ABORT:-PIN DRIFT: the relevant tree changed while ${PID_CELL[$pid]} ran}"; fi
   410	    if [ "$st" -eq 5 ]; then ABORT="${ABORT:-BACKEND EVIDENCE missing for ${PID_CELL[$pid]}: no further cell is spawned}"; fi
   411	    if [ "$st" -eq 6 ]; then ABORT="${ABORT:-LANE CHANGED before the launch of ${PID_CELL[$pid]}: no further cell is spawned}"; fi
   412	    unset "LANE_PID[${PID_LANE[$pid]}]" "PID_CELL[$pid]" "PID_LANE[$pid]"
   413	  done
   414	}
   415	RE_MAP='^([0-9]+),[[:space:]]*(GPU-[0-9A-Za-z-]+)$'
   416	RE_APP='^([0-9]+),[[:space:]]*(GPU-[0-9A-Za-z-]+),[[:space:]]*([^,]*),[[:space:]]*([0-9]+|\[N/A\])$'
   417	lane_state() {   # <gpu>: 0 usable | 1 not now (LANE_WHY) | 2 a query failed / is malformed (fail closed)
   418	  local lane="$1" out rc line want pid uuid occ="" free pids=""
   419	  local -A byidx=() byuuid=()
   420	  out="$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader 2>/dev/null)"; rc=$?
   421	  [ "$rc" -eq 0 ] && [ -n "$out" ] || { LANE_WHY="nvidia-smi --query-gpu=index,uuid failed (rc ${rc})"; return 2; }
   422	  while IFS= read -r line; do
   423	    [[ "$line" =~ $RE_MAP ]] || { LANE_WHY="malformed index,uuid row '${line}'"; return 2; }
   424	    [ -z "${byidx[${BASH_REMATCH[1]}]:-}" ] && [ -z "${byuuid[${BASH_REMATCH[2]}]:-}" ] \
   425	      || { LANE_WHY="duplicate index or uuid in the nvidia-smi map ('${line}')"; return 2; }
   426	    byidx[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}"; byuuid[${BASH_REMATCH[2]}]="${BASH_REMATCH[1]}"
   427	  done <<<"$out"
   428	  want="${byidx[$lane]:-}"
   429	  [ -n "$want" ] || { LANE_WHY="GPU ${lane} has no uuid in the nvidia-smi index map"; return 2; }
   430	  out="$(nvidia-smi --query-compute-apps=pid,gpu_uuid,process_name,used_memory --format=csv,noheader,nounits 2>/dev/null)"; rc=$?
   431	  [ "$rc" -eq 0 ] || { LANE_WHY="nvidia-smi --query-compute-apps failed (rc ${rc})"; return 2; }
   432	  while IFS= read -r line; do
   433	    [ -n "$line" ] || continue
   434	    [[ "$line" =~ $RE_APP ]] || { LANE_WHY="malformed compute-app row '${line}'"; return 2; }
   435	    pid="${BASH_REMATCH[1]}"; uuid="${BASH_REMATCH[2]}"
   436	    [ -n "${byuuid[$uuid]:-}" ] || { LANE_WHY="compute process ${pid} sits on an unknown uuid ${uuid}"; return 2; }
   437	    [ "$uuid" = "$want" ] && occ+=" pid ${pid} (${BASH_REMATCH[3]}, ${BASH_REMATCH[4]} MiB, cwd $(readlink "/proc/${pid}/cwd" 2>/dev/null || echo '?'))" \
   438	      && pids+="${pids:+,}${pid}"
   439	  done <<<"$out"
   440	  out="$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits -i "$lane" 2>/dev/null)"; rc=$?
   441	  [ "$rc" -eq 0 ] && [[ "$out" =~ ^[[:space:]]*([0-9]+)[[:space:]]*$ ]] \
