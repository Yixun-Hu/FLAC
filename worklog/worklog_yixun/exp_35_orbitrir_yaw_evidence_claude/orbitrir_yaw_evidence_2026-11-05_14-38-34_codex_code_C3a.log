  1784	                         [CTL_DUMP_SHAPE[0], "float32", CTL_DUMP_SHAPE]),
  1785	                        ("dump input_hash", nm["input_hash"], rm["input_hash"]),
  1786	                        ("stream sidecar sha256", hashlib.sha256(new["stream_raw"]).hexdigest(), pinned["stream_sha256"]),
  1787	                        ("ckpt loaded", [new["metrics"].get(x) for x in LOAD_KEYS], list(CTL_LOADED))):
