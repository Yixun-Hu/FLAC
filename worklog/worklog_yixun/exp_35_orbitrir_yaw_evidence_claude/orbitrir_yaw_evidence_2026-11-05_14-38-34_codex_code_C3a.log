   129	# ---- §12 B1.1: the approved identity tuple, enforced by the runner too ---- #
   130	def _tuple(clone, tmp_path, pids, gpu=1, edit=None):
   131	    p = subprocess.run([sys.executable, str(clone / IDENTITY), "--snapshot", "--gpu-uuid", UUID[gpu]]
   132	                       + [x for pid in pids for x in ("--pid", str(pid))], capture_output=True, text=True,
   133	                       check=True, env=dict(os.environ, PYTHONDONTWRITEBYTECODE="1"))
   134	    doc = json.loads(p.stdout)
   135	    if edit:
   136	        edit(doc)
   137	    path = tmp_path / "approved.json"
   138	    path.write_text(json.dumps(doc))
   139	    import hashlib                                     # Codex C2 BLOCKING 1: the launch entry pins its bytes
   140	    return {"EXP35_APPROVED_COTENANTS": str(path),
   141	            "EXP35_APPROVED_COTENANTS_SHA256": hashlib.sha256(path.read_bytes()).hexdigest()}
