  1798	def exp35_e2(*, pin, manifest, base_dir=REPO, csv_path=None, farm_root=None, dump_root=None):
  1799	    """§4 E2 (decides only the 45-degree source): ``exp35_BF_T_S40000_K{1,8}_s42`` vs the sha-pinned A6 CSV row
  1800	    (method ``FA B-F@40k``, angle 0, seed 42) -- PASS iff all 14 |differences| are within E2_TOLERANCE."""
  1801	    import csv
  1802	    import hashlib
  1803	    path = csv_path or A6_CSV
  1804	    res = {"status": "REFUSED", "pass": None, "csv": path, "csv_sha256": None, "rows": [], "rows45": [], "reasons": [],
  1805	           "rule": "|new - A6 CSV| <= " + ", ".join(f"{k} {v:g}" for k, v in E2_TOLERANCE.items()) + " (all 14)"}
  1806	    try:
  1807	        with open(path, "rb") as f:
  1808	            raw = f.read()
  1809	    except OSError as err:
  1810	        return dict(res, reasons=[f"the A6 CSV {path} is unreadable ({err})"])
  1811	    res["csv_sha256"] = hashlib.sha256(raw).hexdigest()
  1812	    if res["csv_sha256"] != A6_CSV_SHA256:
  1813	        return dict(res, reasons=[f"the A6 CSV hashes to {res['csv_sha256']}, not the pinned {A6_CSV_SHA256}"])
  1814	    table = list(csv.DictReader(raw.decode().splitlines()))
  1815	    for k in (1, 8):
  1816	        hits = [r for r in table if (r["method"], r["K"], r["angle_deg"], r["seed"]) == ("FA B-F@40k", str(k), "0", "42")]
  1817	        _, _, new, why = _verified_cell(f"exp35_BF_T_S40000_K{k}_s42", manifest=manifest, pin=pin, base_dir=base_dir,
  1818	                                        farm_root=farm_root, dump_root=dump_root)
  1819	        res["reasons"] += why + ([] if len(hits) == 1 else [f"the A6 CSV holds {len(hits)} FA B-F@40k K{k} theta 0 s42 rows"])
  1820	        if why or len(hits) != 1:
  1821	            continue
  1822	        for key, tol in E2_TOLERANCE.items():
  1823	            a, b = float(new["metrics"]["metrics"][key]), float(hits[0][key])
  1824	            res["rows"].append({"K": k, "metric": key, "new": a, "a6": b, "abs_diff": abs(a - b), "tolerance": tol,
  1825	                                "pass": abs(a - b) <= tol})
  1826	    if res["reasons"]:
  1827	        return dict(res, rows=[])
  1828	    ok = len(res["rows"]) == 14 and all(r["pass"] for r in res["rows"])
  1829	    rows45 = [r for r in table if r["angle_deg"] == "45" and r["method"] in A6_METHODS.values() and int(r["seed"]) in SEEDS]
  1830	    return dict(res, status="PASS" if ok else "FAIL", rows45=rows45 if ok else [], **{"pass": ok})   # (b)'s 45 deg: on PASS
