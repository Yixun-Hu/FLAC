   634	def main(argv=None):
   635	    import argparse
   636	    import json
   637	    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   638	    ap.add_argument("--ckpt-path", required=True)
   639	    ap.add_argument("--arm", choices=("CANON", "BF"), default="CANON",
   640	                    help="exp_35: BF = the B-F frame-average control (quarter turns, no canonicalization)")
   641	    ap.add_argument("--model-config", default=None, help="default: the arm's registered config")
   642	    ap.add_argument("--dataset-config", default=DEFAULT_DATASET_CONFIG)
   643	    ap.add_argument("--n-items", type=int, default=64)
   644	    ap.add_argument("--batch-size", type=int, default=64)
   645	    ap.add_argument("--num-workers", type=int, default=4)
   646	    ap.add_argument("--seed", type=int, default=42)
   647	    ap.add_argument("--device", default="cuda")
   648	    ap.add_argument("--allow-canon-mismatch", action="store_true",
   649	                    help="probe a checkpoint NOT trained with canonicalization (labelled diagnostic)")
   650	    ap.add_argument("--out", default=None, help="default: the arm's registered output")
   651	    ap.add_argument("--diagnostic", action="store_true",
   652	                    help=f"run OFF the registered contract: the JSON records registered=false and the "
   653	                         f"exit code is {DIAGNOSTIC_EXIT} (never 0), so it can never serve as the control")
   654	    args = ap.parse_args(argv)
   655	    bf = args.arm == "BF"
   656	    args.model_config = args.model_config or (BF_DEFAULT_MODEL_CONFIG if bf else DEFAULT_MODEL_CONFIG)
   657	    args.out = args.out or (BF_DEFAULT_OUT if bf else os.path.join(EXPDIR, "depth_canon_cond_probe.json"))
   658	    if bf and args.allow_canon_mismatch:
   659	        ap.error("--allow-canon-mismatch: canonicalization is out of scope for --arm BF (frame averaging "
