    79	def _pose_blind(conditioner, metadata, device, angles, max_fwd_samples=None):
    80	    """An exactly invariant stand-in for the frame average: the conditioner on pose-free metadata."""
    81	    flat = [dict(md, source=torch.zeros(3), context_poses=torch.zeros_like(md["context_poses"])) for md in metadata]
    82	    return conditioner(flat, device)
