   209	def run_stages(module, md_list, noise, reals, protocol, cond_fn=None):
   210	    """The four stages for one list of (already canonical) metadata dicts, mirroring
   211	    ``eval_FLAC.evaluate_model``'s loop: conditioner under the protocol's cond autocast,
   212	    ``get_conditioning_inputs``, ``sample_discrete_euler`` with 1 step / cfg 1.0 /
   213	    ``batch_cfg=True`` / the wrapper's ``dist_shift`` on the GIVEN noise (the DiT's one
   214	    output recorded as the velocity), decode, ``clamp(-1, 1)``, pad to ``reals``. ``cond_fn``
   215	    (exp_35: :func:`bf_conditioning`) replaces the plain conditioner call, inside the same autocast."""
   216	    import eval_FLAC as ev
