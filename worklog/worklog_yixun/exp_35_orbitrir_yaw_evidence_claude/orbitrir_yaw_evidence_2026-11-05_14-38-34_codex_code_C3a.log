  1688	        with open(path, "rb") as f:
  1689	            raw = f.read()
  1690	    except OSError as err:
  1691	        return None, [f"{path} unreadable ({err})"]
  1692	    if hashlib.sha256(raw).hexdigest() != sha256:
  1693	        return None, [f"{path} hashes to {hashlib.sha256(raw).hexdigest()}, not the pinned sha256 {sha256}"]
  1694	    return json.loads(raw), []
