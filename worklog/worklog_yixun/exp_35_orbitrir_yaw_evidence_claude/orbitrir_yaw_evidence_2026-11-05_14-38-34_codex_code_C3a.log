   237	def _e2_world(tmp, monkeypatch, offsets=None, drop=None):
   238	    rows = []
   239	    for k in (1, 8):
   240	        r = _row(f"exp35_BF_T_S40000_K{k}_s42")
   241	        T.write_cell(tmp, r)
   242	        m = T.default_metrics(r)
   243	        vals = {key: round(m[key], 4) + (offsets or {}).get((k, key), 0.0) for key in C.E2_TOLERANCE}
   244	        rows.append(dict({"method": "FA B-F@40k", "K": k, "angle_deg": 0, "seed": 42, "source_json": "x.json",
   245	                          "RIR_to_geom_R@1": 1, "RIR_to_geom_R@5": 1, "RIR_to_geom_R@10": 1}, **vals))
   246	        rows.append(dict(rows[-1], method="Vanilla P1@40k", T60=0.0))        # another method's row: never read
   247	    rows = [x for x in rows if not (drop and (x["method"], x["K"]) == drop)]
   248	    path = tmp / "yaw_metrics_raw.csv"
   249	    with open(path, "w", newline="") as f:
   250	        w = csv.DictWriter(f, fieldnames=CSV_COLUMNS)
   251	        w.writeheader()
   252	        w.writerows(rows)
   253	    monkeypatch.setattr(C, "A6_CSV_SHA256", _sha(path))
   254	    return str(path)
