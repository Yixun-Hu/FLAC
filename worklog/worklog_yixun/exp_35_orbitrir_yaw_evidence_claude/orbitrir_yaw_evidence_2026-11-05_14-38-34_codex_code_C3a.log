   177	def build_manifest(exp35=True):
   178	    """The 330-row manifest; ``exp35=False``: the exp_25 manifest exactly as committed at its pin."""
   179	    E, U = ENDPOINT, "unseen"
   180	    blocks = {
   181	        "T": [_row("T", "T", "CANON", E, U, k, s, ("fixed", 0), True) for k in KS for s in SEEDS],
   182	        "T-dup": [_row("T-dup", "T", "CANON", E, U, k, 42, ("fixed", 0), True, dup=True) for k in KS],
   183	        "C4+45": [_row("C4+45", "C4", "CANON", E, U, k, 42, ("fixed", d), True)
   184	                  for k in KS for d in C4_ANGLES + (OFF_ORBIT,)],
   185	        "R": [_row("R", "R", "CANON", E, U, k, s, ("random", None), True) for k in KS for s in SEEDS],
   186	        "D-i": [_row("D-i", "D", "CANON", E, U, k, 42, ("fixed", 0), allow=True) for k in KS],
   187	        "D-ii": [_row("D-ii", "D", "P1", E, U, k, 42, ("fixed", 0), True, True) for k in KS],
   188	        "S": [_row("S", "S", "CANON", E, "seen", k, s, ("fixed", 0), True) for k in KS for s in SEEDS],
   189	        "P1-pin": _pin_rows("P1"),
   190	        "YAW-pin": _pin_rows("YAW"),
   191	        "TRAJ": [_row("TRAJ", "TRAJ", "CANON", step, U, k, 42, ("fixed", d), True)
   192	                 for step in range(CADENCE, ENDPOINT, CADENCE) for k in KS for d in (0,) + C4_ANGLES],
   193	    }
   194	    names = EXP25_BLOCKS + (EXP35_BLOCKS if exp35 else ())
   195	    blocks.update(_exp35_blocks() if exp35 else {})
   196	    cells = []
   197	    for priority, block in enumerate(names):
   198	        for row in blocks[block]:
   199	            cells.append({"cell": row.pop("cell"), "order": len(cells), "priority": priority, **row})
   200	    head = {"schema_version": SCHEMA_VERSION, "generator": f"{EXPREL}/depth_canon_make_cells.py",
   201	            "plan": "plan_depth_canon.md v9 §5" + (
   202	                "; exp_35 rows: plan_orbitrir_yaw_evidence.md r2 §1, §11" if exp35 else ""),
   203	            "blocks": list(names), "block_counts": {b: len(blocks[b]) for b in names}, "common_flags": COMMON_FLAGS}
   204	    head.update({"arm_cond_flags": ARM_COND_FLAGS} if exp35 else {})
   205	    return {**head, "img_w": IMG_W, "seeds": list(SEEDS), "dump_root": DUMP_ROOT, "farm_root": FARM_ROOT,
   206	            "splits": {s: {"split_json": v["split_json"], "expected_stream_count": v["expected_stream_count"]}
   207	                       for s, v in SPLITS.items()},
   208	            "arms": {a: ARMS[a] for a in EXP25_ARMS + (("BF",) if exp35 else ())}, "cells": cells}
   209	
