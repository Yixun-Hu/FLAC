     4	Written by the exp_25 Coder seat (Claude Opus, max effort) per plan_depth_canon.md v8 §2.2/§5/§6/§8.
     5	
     6	Pure helpers, no I/O. Per item (row) of two ``[N, T]`` arrays ``a`` (e.g. a rotated
     7	cell's scored waveforms) and ``b`` (the REFERENCE, e.g. its theta = 0 pair), with the
     8	denominators pinned in the plan:
     9	
    10	* ``rel_l2(a, b)   = ||a - b||_2 / max(||b||_2, REL_FLOOR)``
    11	* ``rel_linf(a, b) = max|a - b| / max(max|b|, REL_FLOOR)``
    12	
    13	computed in float64. :func:`paired_summary` reduces such a per-item vector to the
    14	registered statistics (median, ``np.percentile(..., 99)`` with numpy's default
    15	linear interpolation, max).
    16	"""
    17	import numpy as np
    18	
    19	REL_FLOOR = 1e-6
    20	
    21	
    22	def _pair(a, b):
    23	    """Both inputs as finite float64 ``[N, T]`` arrays of one shape, ``N, T >= 1``.
    24	    Accepts numpy arrays and CPU torch tensors (anything ``np.asarray`` reads)."""
    25	    a, b = np.asarray(a, dtype=np.float64), np.asarray(b, dtype=np.float64)
    26	    if a.ndim != 2 or a.shape != b.shape or 0 in a.shape:
    27	        raise ValueError(f"need two [N, T] arrays of one shape with N, T >= 1, got "
    28	                         f"{a.shape} and {b.shape}")
    29	    if not (np.isfinite(a).all() and np.isfinite(b).all()):
    30	        raise ValueError("inputs must be finite")
    31	    return a, b
    32	
    33	
    34	def rel_l2(a, b):
    35	    """Per-item relative L2 error of ``a`` against the reference ``b`` -> ``[N]`` float64."""
    36	    a, b = _pair(a, b)
    37	    return np.linalg.norm(a - b, axis=1) / np.maximum(np.linalg.norm(b, axis=1), REL_FLOOR)
    38	
    39	
    40	def rel_linf(a, b):
    41	    """Per-item relative L-infinity error of ``a`` against ``b`` -> ``[N]`` float64."""
    42	    a, b = _pair(a, b)
    43	    return np.abs(a - b).max(axis=1) / np.maximum(np.abs(b).max(axis=1), REL_FLOOR)
    44	
    45	
    46	def paired_summary(values):
    47	    """``{"n", "median", "p99", "max"}`` of a non-empty 1-D vector of finite,
    48	    non-negative per-item errors; ``p99 = np.percentile(values, 99)``."""
    49	    v = np.asarray(values, dtype=np.float64)
    50	    if v.ndim != 1 or v.size == 0 or not np.isfinite(v).all() or (v < 0).any():
    51	        raise ValueError(f"need a non-empty 1-D vector of finite non-negative values, got "
    52	                         f"shape {v.shape}")
    53	    return {"n": int(v.size), "median": float(np.median(v)),
    54	            "p99": float(np.percentile(v, 99)), "max": float(v.max())}

