   582	def build_report(registered, deviations, prov, stream, rep, arm=None):
   583	    """The published report, in main()'s layout: the probe ``rep`` with the per-item stream
   584	    identity merged into ``items``, its provenance and the stream's input hash (exp_35: an
   585	    ``arm`` key after the schema version for the B-F report)."""
   586	    rep = dict(rep, items=[dict(position=i, target_id=row.target_id, context_ids=row.context_ids, **t)
   587	                           for i, (row, t) in enumerate(zip(stream.rows, rep["items"]))])
   588	    return {"schema_version": SCHEMA_VERSION, **({"arm": arm} if arm else {}), "registered": registered,
   589	            "deviations": deviations + ([] if registered or deviations else ["--diagnostic given"]),
   590	            "provenance": prov, "stream_input_hash": stream.input_hash(), **rep}
