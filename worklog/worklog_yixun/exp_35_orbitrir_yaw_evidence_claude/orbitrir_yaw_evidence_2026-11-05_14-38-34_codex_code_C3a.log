   310	        raise ValueError(f"an ARE checkpoint (are_lambda={are_lambda}) is out of this probe's scope: "
   311	                         "it has no anchor add-back")
   312	    embedded = ckpt.get("model_config")
   313	    bf = arm == "BF"
   314	    protocol = ev.resolve_canonicalize_protocol(
   315	        not bf, file_model_config.get("training"),
   316	        embedded.get("training") if isinstance(embedded, dict) else None,
   317	        allow_canon_mismatch, cond_method="fa_invariant" if bf else "vanilla", file_model_cfg=file_model_config)
   318	    model = ev.create_model_from_config(model_config)
   319	    missing, unexpected = model.load_state_dict(state_dict, strict=False)
   320	    ev.check_load_integrity(missing, unexpected, False)
   321	    model_config["training"] = training_config
   322	    module = ev.create_training_wrapper_from_config(model_config, model)
   323	    module.eval().requires_grad_(False)
   324	    module.to(device)
   325	    info = {"weights_source": weights_source, "canonicalize_trained": protocol.trained,
   326	            "canonicalize_applied": protocol.applied, "canonicalize_mismatch": protocol.mismatch,
   327	            "img_w": protocol.img_w, "model_config_sha256_file": ev.model_config_sha256(file_model_config),
   328	            "model_config_sha256_embedded": ev.model_config_sha256(embedded)}
   329	    return module, info, ckpt_load
