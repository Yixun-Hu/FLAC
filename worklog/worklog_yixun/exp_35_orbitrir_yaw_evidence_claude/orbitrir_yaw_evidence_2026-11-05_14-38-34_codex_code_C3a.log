   136	    T.write_cell(tmp, ref_row, pin=REF_PIN, **(ref or {}))
   137	    T.write_cell(tmp, ctl_row, **(ctl or {}))
   138	    rp = _paths(tmp, ref_row["cell"])
   139	    receipt = json.load(open(os.path.join(str(tmp), rp.receipt)))
   140	    monkeypatch.setattr(C, "EXP25_PIN", REF_PIN)
   141	    monkeypatch.setattr(C, "CTL_REFERENCE", {**C.CTL_REFERENCE, k: {
   142	        "receipt_sha256": _sha(os.path.join(str(tmp), rp.receipt)),
   143	        "waveform_sha256": receipt["dump_evidence"]["manifest"]["sha256"],
   144	        "stream_sha256": _sha(os.path.join(str(tmp), rp.stream))}})
   145	    monkeypatch.setattr(C, "CTL_LOADED", (MANIFEST["arms"]["P1"]["ckpt"]["sha256"], T.CKPT_BYTES))
   146	    monkeypatch.setattr(C, "CTL_DUMP_SHAPE", [T.N, T.T])
