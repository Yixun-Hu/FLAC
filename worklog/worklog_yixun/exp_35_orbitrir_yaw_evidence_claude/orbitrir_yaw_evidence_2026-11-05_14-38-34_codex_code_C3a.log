  2012	    problems += [f"the A6 CSV is not the pinned one: {'; '.join(e2['reasons'][:1])}"] if e2["csv_sha256"] != A6_CSV_SHA256 else []
  2013	    problems += [f"the B-F probe: {x}" for x in control_why[:3]] if control is None and probe_present else []
  2014	    if problems:
  2015	        raise ValueError("RESULTS REFUSED (an integrity problem; --partial does not apply): " + "; ".join(problems))
  2016	    gaps = [f"{len(missing)} cell(s) not run ({', '.join(missing[:4])}{' ...' if len(missing) > 4 else ''})"] if missing else []
