  2004	    digests = sorted({e["receipt"]["campaign_digest"] for e in cells.values() if e["valid"]})
  2005	    problems = [f"stream registry: {x}" for x in registry_why] + [
  2006	        f"{n}: {x} (stream registry)" for n, e in cells.items() if e["valid"] and registry
  2007	        for x in registry_reasons(e["row"], e["stream"], registry)]
  2008	    problems += [f"{len(invalid)} cell(s) failed verification ({', '.join(invalid[:3])})"] if invalid else []
  2009	    problems += [f"the cells span {len(digests)} campaign digests"] if len(digests) > 1 else []
  2010	    problems += [f"CTL K{k} {st} (E1 must be equal): {'; '.join(why[:2])}" for k, (st, why) in ctl.items() if st != "equal"]
