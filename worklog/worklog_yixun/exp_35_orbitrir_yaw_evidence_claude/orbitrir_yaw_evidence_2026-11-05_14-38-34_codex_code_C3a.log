   567	def collect_items(eval_dl, n_items):
   568	    """The first ``n_items`` items in loader order: ``(reals [n, C, T], [md, ...])``."""
   569	    reals, mds = [], []
   570	    for batch_reals, batch_md in eval_dl:
   571	        for r, md in zip(batch_reals, batch_md):
   572	            if len(mds) < n_items:
   573	                reals.append(r)
   574	                mds.append(md)
   575	        if len(mds) == n_items:
   576	            break
   577	    if len(mds) < n_items:
   578	        raise ValueError(f"the loader holds only {len(mds)} items; --n-items is {n_items}")
   579	    return torch.stack(reals), mds
