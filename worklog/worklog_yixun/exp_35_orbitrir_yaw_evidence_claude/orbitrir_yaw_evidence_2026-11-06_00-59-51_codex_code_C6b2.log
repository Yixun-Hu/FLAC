   351	class Refused(ValueError):
   352	    """Fail-closed: ``reasons`` names EVERY input that is missing, duplicated, inconsistent or unverifiable."""
   353	
   354	    def __init__(self, reasons):
   355	        self.reasons = list(reasons)
   356	        super().__init__("REFUSED (nothing written): " + "; ".join(self.reasons[:10]) + (
   357	            f"; ... and {len(self.reasons) - 10} more" if len(self.reasons) > 10 else ""))
