   259	def _gate_inputs(ctx, registry, cache):
   260	    """``({path: (bytes, identity)}, reasons)``: every file E1 / E2 read -- the control and B-F T s42 cells verified
   261	    HERE first (the snapshots later consumed) and the exp_25 references E1 reads in the exp_35 base -- held for a re-read
   262	    once the gates are done (HIGH 2's rule, applied to the collector's gates)."""
   263	    held, why = {}, []
   264	    for k in KS:
   265	        for name in (f"exp35_P1_T_S40000_K{k}_s42", f"exp35_BF_T_S40000_K{k}_s42"):
   266	            entry, bad = verified(name, ctx, "exp35", registry, cache)
   267	            held.update(entry["snapshot"] if entry else {})
   268	            why += bad
   269	        ref = f"exp25_P1_T_S40000_K{k}_s42"
   270	        _, p, bad = _cell_files(ref, ctx, ctx["dump_root"])
   271	        snap, bad = _snapshot(ctx["base_dir"], {r: f"{ref} artifact" for r in (p.metrics, p.stream, p.receipt)}) \
   272	            if p else ({}, bad)
   273	        held.update({os.path.join(ctx["base_dir"], r): v for r, v in snap.items()})
   274	        why += [f"E1's exp_25 reference {ref} in the exp_35 base: {x}" for x in bad]
   275	    return held, why
