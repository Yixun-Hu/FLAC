   431	def offorbit(args: argparse.Namespace) -> None:
   432	    """``--mode offorbit``: exit 3 with every reason, and no output, when any input is missing, duplicated or
   433	    unverifiable; an error while WRITING is not a refusal and propagates."""
   434	    sources = offorbit_sources()
   435	    try:
   436	        points, summary, meta = offorbit_inputs(sources.context_from_args(args), args.source_45)
   437	    except (sources.Refused, ValueError, OSError, KeyError) as err:
   438	        reasons = err.reasons if isinstance(err, sources.Refused) else [repr(err)]
   439	        print(f"OFFORBIT FIGURE REFUSED (nothing written): {len(reasons)} reason(s)\n"
   440	              + "\n".join(f"  - {x}" for x in reasons))
   441	        raise SystemExit(3) from err
   442	    write_offorbit_outputs(points, summary, args.output_dir)
   443	    print(f"Wrote {len(points)} points (45 deg: {meta['source_45']}, E2 {meta['e2']['status']}, E1 {meta['e1']}) "
   444	          f"to {args.output_dir.resolve()}")
   445	
   446	
   447	def main() -> None:
   448	    args = parse_args()
   449	    if args.mode == "offorbit":
   450	        offorbit(args)
   451	        return
   452	    args.output_dir.mkdir(parents=True, exist_ok=True)
   453	    if args.mode in ("legacy", "all"):
   454	        raw_rows, summary_rows = collect(args.flac_root.resolve(), LEGACY_ANGLES)
   455	        write_csv(args.output_dir / "yaw_metrics_raw.csv", raw_rows)
   456	        write_csv(args.output_dir / "yaw_metrics_summary.csv", summary_rows)
   457	        plot_grid(
   458	            summary_rows,
   459	            ACOUSTIC_METRICS,
   460	            (2, 2),
   461	            args.output_dir / "yaw_acoustic_metrics",
   462	            LEGACY_ANGLES,
   463	        )
   464	        plot_grid(
   465	            summary_rows,
   466	            RETRIEVAL_METRICS,
   467	            (2, 3),
   468	            args.output_dir / "yaw_retrieval_metrics",
   469	            LEGACY_ANGLES,
   470	        )
   471	    if args.mode in ("c4", "all"):
   472	        c4_raw, c4_summary = collect(args.flac_root.resolve(), C4_ANGLES)
   473	        write_csv(args.output_dir / "yaw_c4_metrics_raw.csv", c4_raw)
   474	        write_csv(args.output_dir / "yaw_c4_metrics_summary.csv", c4_summary)
   475	        plot_grid(
   476	            c4_summary,
