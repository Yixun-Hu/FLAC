   395	def campaign_digests(cache):
   396	    """``({campaign: digest}, reasons)``: one campaign = one evaluated tree -- each campaign's verified cells carry ONE
   397	    campaign digest (the collector's rule, applied to exp_35 and to exp_25 separately)."""
