   307	        if not (isinstance(vals, list) and len(vals) == len(SEEDS) == st.get("n") and all(C._finite(v) for v in vals)):
   308	            why.append(f"exp_25 table {arm} K{k} {key}: values {vals!r:.80} are not {len(SEEDS)} finite numbers")
   309	            continue
   310	        if statistics.mean(vals) != st.get("mean") or statistics.stdev(vals) != st.get("sd"):
   311	            why.append(f"exp_25 table {arm} K{k} {key}: its mean / sd are not those of its values")
   312	        for s, v in zip(SEEDS, vals):
   313	            out[s][key] = v
   314	    return out, why
