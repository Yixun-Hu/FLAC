             "ref_deg": spec["ref_deg"], "pins": side(lambda e: e["evaluator_pin"]),
             "cross_pin": a["evaluator_pin"] != b["evaluator_pin"], "campaigns": side(lambda e: e["campaign"]),
             "attention_backend": side(lambda e: e["attention_backend"]), "input_hash": a["stream"]["input_hash"],
             "metrics_sha256": side(lambda e: e["sha256"]),
             "dump_sha256": side(lambda e: e["receipt"]["dump_evidence"]["manifest"]["sha256"]),
             "metrics": {x: {"cell": va[x], "ref": vb[x], "diff": va[x] - vb[x]} for x in S.KEYS},
             "relL2": distance_summary(l2), "relLinf": distance_summary(linf)}, []
 
 
 def p1_vs_angle(points):
     """FLAC's five-seed values per angle (the figure's points), their mean / sd (ddof 1), the (campaign, pin) they come
     from, and the differences of the means to 0 degrees."""
     out = {}
     for k in S.KS:
         out[str(k)] = {}
         for x in S.KEYS:
             ang = {}
             for a in S.ANGLES:
                 grp = [p for p in points if (p["method"], p["K"], p["angle_deg"]) == ("FLAC", k, a)]
                 vals = [p[x] for p in grp]
                 ang[str(a)] = {"n": len(vals), "values": vals, "mean": statistics.mean(vals),
                                "sd": statistics.stdev(vals), "provenance": [list(t) for t in sorted(
                                    {(p["campaign"], p["evaluator_pin"]) for p in grp})]}
             out[str(k)][x] = {"angles": ang, "diff_vs_0": {a: ang[a]["mean"] - ang["0"]["mean"] for a in ("45", "135", "225")}}
     return out
 
 
 def e5(ctx, source_45="a6"):
     """The E5 record, or :class:`yaw_offorbit_sources.Refused` naming every reason (nothing is written)."""
     cache, arrays, groups = {}, {}, {"bf_vs_45": [], "canon_vs_0": []}
     points, meta = S.collect_points(ctx, source_45, cache)
     registry, why = S.C.load_registry()
     reasons = [f"the stream registry: {x}" for x in why]
     for spec in registered_pairs() if registry is not None else ():
         rec, why = pair(spec, ctx, registry, cache, arrays)
         reasons += why
