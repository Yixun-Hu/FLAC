   183	def verified(name, ctx, campaign, registry, cache=None):
   184	    """``(entry, reasons)`` of ONE cell (entry None unless reasons == []); cached per name."""
   185	    if cache is not None and name in cache:
   186	        return cache[name]
   187	    result = _verify_snapshot(name, ctx, campaign, registry)
   188	    if cache is not None:
   189	        cache[name] = result
   190	    return result
