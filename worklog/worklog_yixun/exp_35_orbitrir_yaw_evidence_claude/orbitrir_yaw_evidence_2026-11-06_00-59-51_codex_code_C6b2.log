+def _verify_snapshot(name, ctx, campaign, registry):
+    """Codex C6b HIGH 2: ONE snapshot of the cell's metrics / stream / receipt / canon sidecar and the log its receipt
+    names; the collector's own offline verification (``verify_cell``, receipt mode, at the campaign's registered pin) of
+    EXACTLY the snapshot's receipt; every file re-read afterwards (bytes and device / inode) -- any movement refuses; then
+    only the snapshot's bytes are consumed: metrics / stream / canon hashing to the receipt's artifact digests, the stream
+    on the registry, an exp_25 log proving SDPA."""
+    exp35, m = campaign == "exp35", ctx["manifest"]
+    base, pin = (ctx["base_dir"], H35) if exp35 else (ctx["exp25_base_dir"], EXP25_PIN)
+    dump_root, pre = ctx["dump_root"] if exp35 else ctx["exp25_dump_root"], f"{name} does not verify at {pin[:12]}"
+    row, p, why = _cell_files(name, ctx, dump_root)
+    if why:
+        return None, [f"{pre}: {x}" for x in why]
+    kinds = {p.metrics: "metrics artifact", p.stream: "stream artifact", p.receipt: "receipt artifact",
+             **({p.canon: "canon artifact"} if row["canonicalize"] else {})}
+    snap, why = _snapshot(base, kinds)
+    rec = stream = receipt = None
+    if not why:
+        try:
+            rec, stream, receipt = (json.loads(snap[r][0]) for r in (p.metrics, p.stream, p.receipt))
+        except ValueError as err:
+            why = [f"an artifact is not JSON ({err})"]
+    log = receipt.get("log") if isinstance(receipt, dict) else None
+    if not why:
+        more, why = _snapshot(base, {log: "cell log"}) if isinstance(log, str) and log else ({}, ["no cell log named"])
+        snap.update(more)
+    if why:
+        return None, [f"{pre}: {x}" for x in why]
+    try:
+        why = C.verify_cell(p.stem, manifest=m, farm_root=ctx["farm_root"], dump_root=dump_root, pin=pin,
+                            canon_index=ctx["canon_index"], base_dir=base, dump_check="receipt", check_link=False,
+                            receipt_doc=receipt)
+    except (KeyError, OSError, ValueError) as err:
+        why = [f"the collector's verification raised {type(err).__name__}: {err}"]
+    after, gone = _snapshot(base, dict.fromkeys(snap, "file"))
+    why += gone + [f"{rel} changed during the verification (its bytes or its device / inode)" for rel in snap
+                   if rel in after and after[rel] != snap[rel]]
+    digests = {kind.split()[0]: hashlib.sha256(snap[rel][0]).hexdigest() for rel, kind in kinds.items()
+               if kind != "receipt artifact"}
+    why += [f"the snapshot's {k} bytes hash to {d}, not the receipt's artifact_sha256" for k, d in digests.items()
+            if d != ((receipt.get("artifact_sha256") if isinstance(receipt, dict) else None) or {}).get(k)]
+    if not why:
+        why = [f"{x} (stream registry)" for x in C.registry_reasons(row, stream, registry)] + (
+            [] if exp35 else exp25_backend_reasons(snap[log][0].decode(errors="replace")))
+    if why:
+        return None, [f"{pre}: {x}" for x in why]
+    return {"cell": name, "campaign": campaign, "row": row, "paths": p, "base_dir": base, "record": rec,
+            "stream": stream, "receipt": receipt, "evaluator_pin": rec.get("source_sha"),
+            "attention_backend": receipt.get("attention_backend") if exp35 else "sdpa",
+            "orbit_execution": rec.get("orbit_execution"), "path": os.path.abspath(os.path.join(base, p.metrics)),
+            "sha256": digests["metrics"], "snapshot": {os.path.join(base, r): v for r, v in snap.items()}}, []
+
+
+def _cell_files(name, ctx, dump_root):
+    """``(row, paths, reasons)``: the one registered row of ``name`` and every artifact path, as the collector derives
+    them (``expected_checkpoint`` + ``cell_paths``)."""
+    rows = [c for c in ctx["manifest"]["cells"] if c["cell"] == name]
+    if len(rows) != 1:
+        return None, None, [f"it names {len(rows)} registered cells, not one"]
+    try:
+        target, _ = C.expected_checkpoint(rows[0], ctx["manifest"], ctx["canon_index"])
+    except KeyError as err:
+        return None, None, [str(err)]
+    link = os.path.join(ctx["farm_root"], rows[0]["arm"], os.path.basename(target))
+    return rows[0], C.cell_paths(rows[0], link, dump_root), []
+
+
+def _gate_inputs(ctx, registry, cache):
+    """``({path: (bytes, identity)}, reasons)``: every file E1 / E2 read -- the control and B-F T s42 cells verified
+    HERE first (the snapshots later consumed) and the exp_25 references E1 reads in the exp_35 base -- held for a re-read
+    once the gates are done (HIGH 2's rule, applied to the collector's gates)."""
+    held, why = {}, []
+    for k in KS:
+        for name in (f"exp35_P1_T_S40000_K{k}_s42", f"exp35_BF_T_S40000_K{k}_s42"):
+            entry, bad = verified(name, ctx, "exp35", registry, cache)
+            held.update(entry["snapshot"] if entry else {})
+            why += bad
+        ref = f"exp25_P1_T_S40000_K{k}_s42"
+        _, p, bad = _cell_files(ref, ctx, ctx["dump_root"])
+        snap, bad = _snapshot(ctx["base_dir"], {r: f"{ref} artifact" for r in (p.metrics, p.stream, p.receipt)}) \
+            if p else ({}, bad)
+        held.update({os.path.join(ctx["base_dir"], r): v for r, v in snap.items()})
+        why += [f"E1's exp_25 reference {ref} in the exp_35 base: {x}" for x in bad]
+    return held, why
+
