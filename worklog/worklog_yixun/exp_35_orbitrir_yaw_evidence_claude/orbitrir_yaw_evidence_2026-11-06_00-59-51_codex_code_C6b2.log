   670	def select_cells(manifest, blocks=None, only=None, limit=None):
   671	    """The rows to run, in the manifest's (priority) order: ``blocks`` (e.g. the A1 switch =
   672	    every block but YAW-pin), ``only`` (cell names), ``limit`` (first N). Unknown or
   673	    duplicate names, an empty list and a non-positive limit are ``ValueError``."""
   674	    for label, names, universe in (("block", blocks, list(manifest["blocks"])),
   675	                                   ("cell", only, [c["cell"] for c in manifest["cells"]])):
   676	        if names is not None and (not names or len(set(names)) != len(names)
   677	                                  or any(n not in universe for n in names)):
   678	            raise ValueError(f"unknown, duplicate or empty {label} selection {names!r}")
   679	    if limit is not None and (type(limit) is not int or limit < 1):
   680	        raise ValueError(f"--limit must be a positive int, got {limit!r}")
   681	    rows = [c for c in manifest["cells"] if (blocks is None or c["block"] in blocks)
   682	            and (only is None or c["cell"] in only)
   683	            and (blocks is not None or only is not None or c["block"] not in EXPLICIT_BLOCKS)]
   684	    return rows[:limit] if limit else rows
