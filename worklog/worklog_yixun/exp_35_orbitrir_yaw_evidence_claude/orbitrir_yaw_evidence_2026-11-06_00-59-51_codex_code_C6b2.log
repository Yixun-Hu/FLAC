     out = [] if len(miss) == len(fb) == 1 and fb[0] == miss[0] + 1 else [
         f"the exp_25 log holds {len(miss)} {EXP25_LOG_PAIR[0]!r} and {len(fb)} SDPA fallback line(s), not one "
         "back-to-back pair"]
