   125	def p1_vs_angle(points):
   126	    """FLAC's five-seed values per angle (the figure's points), their mean / sd (ddof 1), the (campaign, pin) they come
   127	    from, and the differences of the means to 0 degrees."""
   128	    out = {}
   129	    for k in S.KS:
   130	        out[str(k)] = {}
   131	        for x in S.KEYS:
   132	            ang = {}
   133	            for a in S.ANGLES:
   134	                grp = [p for p in points if (p["method"], p["K"], p["angle_deg"]) == ("FLAC", k, a)]
   135	                vals = [p[x] for p in grp]
   136	                ang[str(a)] = {"n": len(vals), "values": vals, "mean": statistics.mean(vals),
   137	                               "sd": statistics.stdev(vals), "provenance": [list(t) for t in sorted(
   138	                                   {(p["campaign"], p["evaluator_pin"]) for p in grp})]}
   139	            out[str(k)][x] = {"angles": ang, "diff_vs_0": {a: ang[a]["mean"] - ang["0"]["mean"] for a in ("45", "135", "225")}}
   140	    return out
