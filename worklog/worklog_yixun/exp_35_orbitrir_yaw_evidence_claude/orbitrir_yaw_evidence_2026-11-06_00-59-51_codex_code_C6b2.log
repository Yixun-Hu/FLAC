    32	
    33	OUT = os.path.join(S.REPO, "worklog", "worklog_yixun", "exp_35_orbitrir_yaw_evidence_claude", "orbitrir_yaw_e5")
    34	SECTION = "E5 (descriptive, no verdict)"
    35	PAIRING = ("two cells pair only when their streams' input_hash are equal -- the same targets and context draws in the "
    36	           "same order (the collector's make_pairs rule) -- and item i pairs with item i; relL2_i = ||cell_i - ref_i||_2"
    37	           " / max(||ref_i||_2, 1e-6) and relLinf_i = max|cell_i - ref_i| / max(max|ref_i|, 1e-6) in float64 "
    38	           "(src/tools/depth_canon_stats.py); n / mean / median / p99 (numpy's linear percentile) / max over the items")
