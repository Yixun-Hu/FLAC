   300	def json_values(doc, arm, k):
   301	    """``({seed: {metric: value}}, reasons)`` from the pinned exp_25 table at full precision: per metric exactly five
   302	    finite values (seeds 42-46 in order, as the exp_25 collector built them) whose mean / sd are the table's."""
   303	    out, why = {s: {} for s in SEEDS}, []
   304	    for key in KEYS:
   305	        st = ((((doc.get("table") or {}).get(arm) or {}).get(str(k)) or {}).get("item") or {}).get(key)
