   442	def summarize(points):
   443	    """The summary rows: n, mean and the sample sd (ddof 1) per method x K x angle x metric over the five seeds, by
   444	    ``statistics`` (exact, as the collector's tables: theta = 0 FLAC / CANON equal the exp_25 table)."""
   445	    out = []
   446	    for m in METHODS:
   447	        for k in KS:
   448	            for a in ANGLES:
   449	                grp = [p for p in points if (p["method"], p["K"], p["angle_deg"]) == (m, k, a)]
   450	                if [p["seed"] for p in grp] != list(SEEDS):
   451	                    raise Refused([f"{m} K{k} {a} deg holds seeds {[p['seed'] for p in grp]}, not {list(SEEDS)}"])
   452	                for x in KEYS:
   453	                    vals = [p[x] for p in grp]
   454	                    out.append({"method": m, "K": k, "angle_deg": a, "metric": x, "n": len(vals),
   455	                                "mean": statistics.mean(vals), "std": statistics.stdev(vals)})
   456	    return out
