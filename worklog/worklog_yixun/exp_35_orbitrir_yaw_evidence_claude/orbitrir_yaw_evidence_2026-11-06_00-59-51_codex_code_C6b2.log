   222	def write_csv(path: Path, rows: list[dict]) -> None:
   223	    with path.open("w", newline="") as handle:
   224	        writer = csv.DictWriter(handle, fieldnames=list(rows[0]))
   225	        writer.writeheader()
   226	        writer.writerows(rows)
