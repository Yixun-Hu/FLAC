   229	def lookup(
   230	    summary_rows: list[dict],
   231	    method: str,
   232	    k: int,
   233	    metric: str,
   234	    angles: tuple[int, ...],
   235	) -> tuple[np.ndarray, np.ndarray]:
   236	    rows = [
   237	        row
   238	        for row in summary_rows
   239	        if row["method"] == method and row["K"] == k and row["metric"] == metric
   240	    ]
   241	    rows.sort(key=lambda row: row["angle_deg"])
   242	    if [row["angle_deg"] for row in rows] != list(angles):
   243	        raise RuntimeError(f"Incomplete summary for {method}, K={k}, {metric}")
   244	    return (
   245	        np.asarray([row["mean"] for row in rows]),
   246	        np.asarray([row["std"] for row in rows]),
   247	    )
