   481	        )
   482	    write_readme(args.output_dir / "README.md", args.mode in ("c4", "all"))
   483	    print(f"Wrote plots and CSVs to {args.output_dir.resolve()}")
   484	
   485	
   486	if __name__ == "__main__":
   487	    main()
