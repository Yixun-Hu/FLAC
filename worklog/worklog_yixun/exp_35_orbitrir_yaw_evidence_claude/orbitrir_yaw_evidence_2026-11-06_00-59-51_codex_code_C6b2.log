    34	def scaled(level, factor=1.0):
    35	    """[8, 1, 16] float32 waveforms: item i = level * (1 + factor * STEPS[i]) -> relL2 = relLinf = factor * STEPS[i]
    36	    against the flat ``level`` reference, exactly (powers of two)."""
    37	    return torch.tensor([[[level * (1 + factor * c)] * T.T] for c in STEPS], dtype=torch.float32)
    38	
    39	
    40	def toy_waves():
    41	    w = {}
    42	    for k, level in ((1, 1.0), (8, 0.5)):
    43	        w[f"exp35_BF_C4_S40000_K{k}_s42_th45"] = scaled(level, 0.0)
    44	        w[f"exp35_BF_OFF_S40000_K{k}_s42_th135"] = scaled(level, 1.0)
    45	        w[f"exp35_BF_OFF_S40000_K{k}_s42_th225"] = scaled(level, 2.0)
    46	        w[f"exp25_CANON_T_S40000_K{k}_s42"] = scaled(level, 0.0)
    47	        w[f"exp35_CANON_OFF_S40000_K{k}_s42_th135"] = scaled(level, 0.0)            # canonicalization: identical
    48	        w[f"exp35_CANON_OFF_S40000_K{k}_s42_th225"] = scaled(level, 1.0)
    49	    return w
    50	
    51	
    52	def e5_world(tmp, monkeypatch, **kw):
    53	    return F.world(tmp, monkeypatch, waves=toy_waves(), **kw)
