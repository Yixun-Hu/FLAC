   169	def _snapshot(base, kinds):
   170	    """``({rel: (bytes, (st_dev, st_ino))}, reasons)``: each file read ONCE through one descriptor, with the identity of
   171	    exactly what was read."""
   172	    snap, why = {}, []
   173	    for rel, kind in kinds.items():
   174	        try:
   175	            with open(os.path.join(base, rel), "rb") as f:
   176	                st = os.fstat(f.fileno())
   177	                snap[rel] = (f.read(), (st.st_dev, st.st_ino))
   178	        except (OSError, TypeError) as err:
   179	            why.append(f"missing or unreadable {kind} {rel} ({type(err).__name__})")
   180	    return snap, why
