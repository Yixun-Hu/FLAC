   193	def _verify_snapshot(name, ctx, campaign, registry):
   194	    """Codex C6b HIGH 2: ONE snapshot of the cell's metrics / stream / receipt / canon sidecar and the log its receipt
   195	    names; the collector's own offline verification (``verify_cell``, receipt mode, at the campaign's registered pin) of
   196	    EXACTLY the snapshot's receipt; every file re-read afterwards (bytes and device / inode) -- any movement refuses; then
   197	    only the snapshot's bytes are consumed: metrics / stream / canon hashing to the receipt's artifact digests, the stream
   198	    on the registry, an exp_25 log proving SDPA."""
   199	    exp35, m = campaign == "exp35", ctx["manifest"]
   200	    base, pin = (ctx["base_dir"], H35) if exp35 else (ctx["exp25_base_dir"], EXP25_PIN)
   201	    dump_root, pre = ctx["dump_root"] if exp35 else ctx["exp25_dump_root"], f"{name} does not verify at {pin[:12]}"
   202	    row, p, why = _cell_files(name, ctx, dump_root)
   203	    if why:
   204	        return None, [f"{pre}: {x}" for x in why]
   205	    kinds = {p.metrics: "metrics artifact", p.stream: "stream artifact", p.receipt: "receipt artifact",
   206	             **({p.canon: "canon artifact"} if row["canonicalize"] else {})}
   207	    snap, why = _snapshot(base, kinds)
   208	    rec = stream = receipt = None
   209	    if not why:
   210	        try:
   211	            rec, stream, receipt = (json.loads(snap[r][0]) for r in (p.metrics, p.stream, p.receipt))
   212	        except ValueError as err:
   213	            why = [f"an artifact is not JSON ({err})"]
   214	    log = receipt.get("log") if isinstance(receipt, dict) else None
   215	    if not why:
   216	        more, why = _snapshot(base, {log: "cell log"}) if isinstance(log, str) and log else ({}, ["no cell log named"])
   217	        snap.update(more)
   218	    if why:
   219	        return None, [f"{pre}: {x}" for x in why]
   220	    try:
   221	        why = C.verify_cell(p.stem, manifest=m, farm_root=ctx["farm_root"], dump_root=dump_root, pin=pin,
   222	                            canon_index=ctx["canon_index"], base_dir=base, dump_check="receipt", check_link=False,
   223	                            receipt_doc=receipt)
   224	    except (KeyError, OSError, ValueError) as err:
   225	        why = [f"the collector's verification raised {type(err).__name__}: {err}"]
   226	    after, gone = _snapshot(base, dict.fromkeys(snap, "file"))
   227	    why += gone + [f"{rel} changed during the verification (its bytes or its device / inode)" for rel in snap
   228	                   if rel in after and after[rel] != snap[rel]]
   229	    digests = {kind.split()[0]: hashlib.sha256(snap[rel][0]).hexdigest() for rel, kind in kinds.items()
   230	               if kind != "receipt artifact"}
   231	    why += [f"the snapshot's {k} bytes hash to {d}, not the receipt's artifact_sha256" for k, d in digests.items()
   232	            if d != ((receipt.get("artifact_sha256") if isinstance(receipt, dict) else None) or {}).get(k)]
   233	    if not why:
   234	        why = [f"{x} (stream registry)" for x in C.registry_reasons(row, stream, registry)] + (
   235	            [] if exp35 else exp25_backend_reasons(snap[log][0].decode(errors="replace")))
   236	    if why:
   237	        return None, [f"{pre}: {x}" for x in why]
   238	    return {"cell": name, "campaign": campaign, "row": row, "paths": p, "base_dir": base, "record": rec,
   239	            "stream": stream, "receipt": receipt, "evaluator_pin": rec.get("source_sha"),
   240	            "attention_backend": receipt.get("attention_backend") if exp35 else "sdpa",
   241	            "orbit_execution": rec.get("orbit_execution"), "path": os.path.abspath(os.path.join(base, p.metrics)),
   242	            "sha256": digests["metrics"], "snapshot": {os.path.join(base, r): v for r, v in snap.items()}}, []
   243	
