    66	def _pinned_bytes(what, path, sha256):
    67	    with open(path, "rb") as f:
    68	        raw = f.read()
    69	    if hashlib.sha256(raw).hexdigest() != sha256:
    70	        raise Refused([f"{what} {path} hashes to {hashlib.sha256(raw).hexdigest()}, not the pinned {sha256}"])
    71	    return raw
