    59	def waveforms(entry, ctx, arrays):
    60	    """``(array, reasons)``: a verified cell's scored dump -- its on-disk marker / manifest / sidecar == the dump evidence
    61	    of the cell's SNAPSHOT receipt (the collector validates that receipt, never a later read of the file), its bytes
    62	    hashing to that receipt's waveform sha256 -- parsed from exactly those bytes."""
    63	    name = entry["cell"]
    64	    if name in arrays:
    65	        return arrays[name], []
    66	    exp35 = entry["campaign"] == "exp35"
    67	    why = S.C.verify_cell(entry["paths"].stem, manifest=ctx["manifest"], farm_root=ctx["farm_root"],
    68	                          dump_root=ctx["dump_root"] if exp35 else ctx["exp25_dump_root"],
    69	                          pin=S.H35 if exp35 else S.EXP25_PIN, canon_index=ctx["canon_index"],
    70	                          base_dir=entry["base_dir"], dump_check="manifest", expect_dump=True, check_link=False,
    71	                          receipt_doc=entry["receipt"])
    72	    ev = (entry["receipt"].get("dump_evidence") or {}).get("manifest") or {}
    73	    path = os.path.join(entry["base_dir"], entry["paths"].dump_dir, "waveforms.npy")
    74	    try:
    75	        with open(path, "rb") as f:
    76	            raw = f.read()
    77	    except OSError as err:
    78	        return None, [f"{name}: {x}" for x in why + [f"the dump {path} is unreadable ({err})"]]
    79	    sha = hashlib.sha256(raw).hexdigest()
    80	    if sha != ev.get("sha256"):
    81	        why.append(f"waveforms.npy hashes to {sha}, not the receipt's waveform sha256 {ev.get('sha256')}")
    82	    arr = None if why else np.load(io.BytesIO(raw), allow_pickle=False)
    83	    if arr is not None and (arr.dtype != np.float32 or list(arr.shape) != ev.get("shape")
    84	                            or arr.shape[0] != entry["row"]["expected_stream_count"]):
    85	        why.append(f"the dump holds {arr.dtype} {list(arr.shape)}, not the receipt's float32 {ev.get('shape')}")
    86	    if why:
    87	        return None, [f"{name}: {x}" for x in why]
    88	    arrays[name] = arr
    89	    return arr, []
    90	
    91	
    92	def pair(spec, ctx, registry, cache, arrays):
    93	    """``(record, reasons)`` of one registered pair: both cells verified and the registered rows, input_hash-equal,
    94	    both dumps bound to their receipts; then the metric differences and the per-item distance summaries."""
    95	    a, why = S.verified(spec["cell"], ctx, spec["cell_campaign"], registry, cache)
    96	    b, more = S.verified(spec["ref"], ctx, spec["ref_campaign"], registry, cache)
    97	    why = why + more
    98	    if not (a and b):
    99	        return None, why
   100	    for e, deg in ((a, spec["deg"]), (b, spec["ref_deg"])):
   101	        r = e["row"]
   102	        if (r["arm"], r["K"], r["seed"], r["rotate_mode"], r["rotate_deg"]) != (spec["arm"], spec["K"], 42, "fixed", deg):
   103	            why.append(f"{e['cell']} is not the {spec['arm']} K{spec['K']} s42 {deg}-degree cell of this pair")
   104	    if not S.C._same_items(a, b):
   105	        why.append(f"{a['cell']} and {b['cell']} do not pair: stream input_hash {a['stream'].get('input_hash')} != "
   106	                   f"{b['stream'].get('input_hash')}")
   107	    if why:
   108	        return None, why
   109	    (wa, wa_why), (wb, wb_why) = waveforms(a, ctx, arrays), waveforms(b, ctx, arrays)
   110	    if wa_why or wb_why:
   111	        return None, wa_why + wb_why
   112	    l2, linf = S.C._paired(wa, wb)
   113	    side = lambda f: {"cell": f(a), "ref": f(b)}  # noqa: E731
   114	    va, vb = a["record"]["metrics"], b["record"]["metrics"]
   115	    return {"cell": a["cell"], "ref": b["cell"], "K": spec["K"], "seed": 42, "deg": spec["deg"],
   116	            "ref_deg": spec["ref_deg"], "pins": side(lambda e: e["evaluator_pin"]),
   117	            "cross_pin": a["evaluator_pin"] != b["evaluator_pin"], "campaigns": side(lambda e: e["campaign"]),
   118	            "attention_backend": side(lambda e: e["attention_backend"]), "input_hash": a["stream"]["input_hash"],
   119	            "metrics_sha256": side(lambda e: e["sha256"]),
   120	            "dump_sha256": side(lambda e: e["receipt"]["dump_evidence"]["manifest"]["sha256"]),
   121	            "metrics": {x: {"cell": va[x], "ref": vb[x], "diff": va[x] - vb[x]} for x in S.KEYS},
   122	            "relL2": distance_summary(l2), "relLinf": distance_summary(linf)}, []
