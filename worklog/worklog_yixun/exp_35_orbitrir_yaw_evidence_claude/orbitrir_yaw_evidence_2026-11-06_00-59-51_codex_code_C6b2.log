+def canon_index_from_bytes(raw, run_ns):
+    """The collector's ``load_canon_index`` rules (depth_canon_collect.py:552-570) applied to the bytes themselves: every
+    line ``<sha256>  <run_ns>/checkpoints/epoch=E-step=S.ckpt``, no step twice -- else Refused."""
+    pat, index = re.compile(re.escape(run_ns.rstrip("/")) + r"/checkpoints/epoch=\d+-step=(\d+)\.ckpt"), {}
+    try:
+        lines = raw.decode().splitlines()
+    except UnicodeDecodeError as err:
+        raise Refused([f"the CANON checkpoint manifest is not text ({err})"]) from err
+    for line in lines:
+        sha, sep, ckpt = line.partition("  ")
+        m = pat.fullmatch(ckpt) if sep and C.eval_FLAC._is_sha256_hex(sha) else None
+        if m is None or int(m.group(1)) in index:
+            raise Refused([f"the CANON checkpoint manifest line {line!r} is not one new checkpoint of {run_ns}"])
+        index[int(m.group(1))] = (ckpt, sha)
+    return index
