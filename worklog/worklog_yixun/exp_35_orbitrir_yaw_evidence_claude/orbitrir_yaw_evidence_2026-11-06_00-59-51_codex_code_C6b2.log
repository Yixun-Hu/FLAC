   245	def _cell_files(name, ctx, dump_root):
   246	    """``(row, paths, reasons)``: the one registered row of ``name`` and every artifact path, as the collector derives
   247	    them (``expected_checkpoint`` + ``cell_paths``)."""
   248	    rows = [c for c in ctx["manifest"]["cells"] if c["cell"] == name]
   249	    if len(rows) != 1:
   250	        return None, None, [f"it names {len(rows)} registered cells, not one"]
   251	    try:
   252	        target, _ = C.expected_checkpoint(rows[0], ctx["manifest"], ctx["canon_index"])
   253	    except KeyError as err:
   254	        return None, None, [str(err)]
   255	    link = os.path.join(ctx["farm_root"], rows[0]["arm"], os.path.basename(target))
   256	    return rows[0], C.cell_paths(rows[0], link, dump_root), []
