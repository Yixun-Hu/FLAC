   739	    if loaded.get("ckpt_sha256_loaded") != entry["sha256"]:
   740	        raise ValueError(f"{entry['cell']}: the evaluator loaded checkpoint bytes with sha256 "
   741	                         f"{loaded.get('ckpt_sha256_loaded')!r}, not the expected {entry['sha256']}")
   742	    if type(ckpt_bytes) is not int or ckpt_bytes <= 0 or loaded.get("ckpt_bytes_loaded") != ckpt_bytes:
   743	        raise ValueError(f"{entry['cell']}: the evaluator loaded {loaded.get('ckpt_bytes_loaded')!r} checkpoint "
   744	                         f"bytes, the driver measured {ckpt_bytes!r} bytes")
