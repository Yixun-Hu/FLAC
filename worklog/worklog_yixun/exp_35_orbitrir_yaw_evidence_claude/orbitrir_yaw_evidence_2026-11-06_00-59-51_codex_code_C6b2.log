   175	def collect(flac_root: Path, angles: tuple[int, ...]) -> tuple[list[dict], list[dict]]:
   176	    raw_rows: list[dict] = []
   177	    summary_rows: list[dict] = []
   178	    all_metrics = {**ACOUSTIC_METRICS, **RETRIEVAL_METRICS}
   179	
   180	    for method in METHODS:
   181	        for k in (1, 8):
   182	            for angle in angles:
   183	                paths = paths_for(flac_root, method, k, angle)
   184	                if len(paths) != len(SEEDS):
   185	                    raise RuntimeError(f"Expected five files for {method}, K={k}, {angle}°")
   186	                docs = [load_json(path) for path in paths]
   187	                observed_seeds = [int(doc.get("seed", seed)) for doc, seed in zip(docs, SEEDS)]
   188	                if observed_seeds != list(SEEDS):
   189	                    raise RuntimeError(
   190	                        f"Seed mismatch for {method}, K={k}, {angle}°: {observed_seeds}"
   191	                    )
   192	                for seed, path, doc in zip(SEEDS, paths, docs):
   193	                    observed_angle = float(doc.get("rotate_deg", 0.0))
   194	                    if observed_angle != angle:
   195	                        raise RuntimeError(f"Angle mismatch in {path}: {observed_angle}")
   196	                    row = {
   197	                        "method": method,
   198	                        "K": k,
   199	                        "angle_deg": angle,
   200	                        "seed": seed,
   201	                        "source_json": str(path),
   202	                    }
   203	                    row.update({metric: doc["metrics"][metric] for metric in all_metrics})
   204	                    raw_rows.append(row)
   205	
   206	                for metric in all_metrics:
   207	                    values = np.asarray([doc["metrics"][metric] for doc in docs], dtype=float)
   208	                    summary_rows.append(
   209	                        {
   210	                            "method": method,
   211	                            "K": k,
   212	                            "angle_deg": angle,
   213	                            "metric": metric,
   214	                            "n": values.size,
   215	                            "mean": values.mean(),
   216	                            "std": values.std(ddof=1),
   217	                        }
   218	                    )
   219	    return raw_rows, summary_rows
