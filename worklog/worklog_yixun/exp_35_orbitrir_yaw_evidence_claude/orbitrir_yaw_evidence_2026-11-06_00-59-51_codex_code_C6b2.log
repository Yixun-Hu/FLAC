   157	def exp25_backend_reasons(text):
   158	    """An exp_25 cell log proves SDPA: flash_attn failed to import as a MISSING module and transformer.py printed its
   159	    fallback, exactly once, back to back -- and it carries no exp_35 launcher sentinel (another campaign's log)."""
   160	    lines = text.splitlines()
   161	    miss, fb = ([i for i, ln in enumerate(lines) if ln == want] for want in EXP25_LOG_PAIR)
   162	    out = [] if len(miss) == len(fb) == 1 and fb[0] == miss[0] + 1 else [
   163	        f"the exp_25 log holds {len(miss)} {EXP25_LOG_PAIR[0]!r} and {len(fb)} SDPA fallback line(s), not one "
   164	        "back-to-back pair"]
   165	    return out + (["the log carries the exp_35 no-flash launcher sentinel: not an exp_25 cell log"]
   166	                  if any(ln.startswith(C.NO_FLASH["sentinel"]) for ln in lines) else [])
