    41	def registered_pairs():
    42	    """The eight E5 pairs at seed 42: B-F 135 / 225 vs B-F 45 and CANON 135 / 225 vs CANON 0, K1 and K8."""
    43	    out = []
    44	    for group, arm, ref, ref_deg, ref_campaign in (("bf_vs_45", "BF", "exp35_BF_C4_S40000_K{k}_s42_th45", 45, "exp35"),
    45	                                                   ("canon_vs_0", "CANON", "exp25_CANON_T_S40000_K{k}_s42", 0, "exp25")):
    46	        out += [{"group": group, "arm": arm, "K": k, "deg": deg, "ref_deg": ref_deg, "cell_campaign": "exp35",
    47	                 "cell": f"exp35_{arm}_OFF_S40000_K{k}_s42_th{deg}", "ref": ref.format(k=k), "ref_campaign": ref_campaign}
    48	                for k in S.KS for deg in (135, 225)]
    49	    return out
