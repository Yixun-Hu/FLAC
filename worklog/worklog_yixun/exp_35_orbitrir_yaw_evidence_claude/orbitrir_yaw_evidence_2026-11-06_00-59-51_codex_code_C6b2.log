   407	def collect_points(ctx, source_45="a6", cache=None):
   408	    """``(points, meta)``: the 120 registered points (raw-CSV rows in METHODS x K x angle x seed order) and their gates,
   409	    or :class:`Refused` naming every reason: a missing, duplicated or unverifiable point refuses the whole set."""
   410	    specs, cache = registered_sources(source_45), {} if cache is None else cache
   411	    state, reasons = gates(ctx, source_45, cache)
   412	    doc, registry, e2, tables, points = state["exp25"], state["registry"], state["e2"], {}, []
   413	    for arm in ("P1", "CANON") if doc is not None else ():
   414	        for k in KS:
   415	            tables[(arm, k)], why = json_values(doc, arm, k)
   416	            reasons += why
   417	    for key in sorted(specs, key=lambda x: (METHODS.index(x[0]), x[1], x[2], x[3])):
   418	        spec, point, why = specs[key], None, []
   419	        if spec["kind"] == "a6":
   420	            if e2["status"] == "PASS":
   421	                point, why = a6_point(key, spec, e2["rows45"], e2["csv"], e2["csv_sha256"])
   422	        elif registry is not None:
   423	            entry, why = verified(spec["cell"], ctx, spec["campaign"], registry, cache)
   424	            if entry and spec["kind"] == "cell":
   425	                point, why = cell_point(key, spec, entry)
   426	            elif entry and doc is not None:
   427	                point, why = json_point(key, spec, tables[(spec["arm"], key[1])], entry, ctx["exp25_json"], doc["pin"])
   428	        reasons += why
   429	        points += [point] if point is not None else []
   430	    digests, why = campaign_digests(cache)      # the CTL cells E1 compared are in the cache too (gates)
   431	    reasons = list(dict.fromkeys(reasons + why))  # one line per reason: a gate cell's failure is reported once
   432	    if not reasons and len(points) != len(specs):
   433	        reasons.append(f"{len(points)} points built for {len(specs)} registered ones")
   434	    if reasons:
   435	        raise Refused(reasons)
   436	    return points, {"source_45": source_45, "pin": H35, "exp25_pin": EXP25_PIN, "e1": state["e1"],
   437	                    "e2": {x: e2[x] for x in ("status", "rule", "csv", "csv_sha256")}, "campaign_digest": digests,
   438	                    "exp25_results": {"path": os.path.abspath(ctx["exp25_json"]), "sha256": C.EXP25_RESULTS_SHA256,
   439	                                      "pin": doc["pin"]}, "registry_sha256": C.EXP35_REGISTRY_SHA256}
