 def registered_pairs():
     """The eight E5 pairs at seed 42: B-F 135 / 225 vs B-F 45 and CANON 135 / 225 vs CANON 0, K1 and K8."""
     out = []
     for group, arm, ref, ref_deg, ref_campaign in (("bf_vs_45", "BF", "exp35_BF_C4_S40000_K{k}_s42_th45", 45, "exp35"),
