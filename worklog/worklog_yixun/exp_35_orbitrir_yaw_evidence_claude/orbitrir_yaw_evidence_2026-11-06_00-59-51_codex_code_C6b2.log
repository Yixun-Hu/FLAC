   145	                                          else _cell("exp35", f"exp35_BF_C4_S40000_K{k}_s42_th45", "BF-pin"))
   146	                else:
   147	                    out[(m, k, 45, s)] = _cell("exp35", f"exp35_{arm}_OFF_S40000_K{k}_s{s}_th45", "E2-FAIL")
   148	            out[("CANON", k, 45, s)] = (_cell("exp25", f"exp25_CANON_C4_S40000_K{k}_s42_th45", "C4+45") if s == 42
   149	                                        else _cell("exp35", f"exp35_CANON_OFF_S40000_K{k}_s{s}_th45", "CANON-45"))
   150	            for deg in (135, 225):
   151	                for m in METHODS:
   152	                    out[(m, k, deg, s)] = _cell("exp35", f"exp35_{ARMS[m]}_OFF_S40000_K{k}_s{s}_th{deg}",
   153	                                                f"OFF-{ARMS[m]}")
