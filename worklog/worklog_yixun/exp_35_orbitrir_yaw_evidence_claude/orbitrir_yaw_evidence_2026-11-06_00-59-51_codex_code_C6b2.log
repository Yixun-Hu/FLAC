    96	def pinned_canon_index(manifest, path=None):
    97	    """The CANON checkpoint index (default: the exp_25 launcher's manifest in the exp_25 folder) parsed from the very
    98	    bytes whose hash is the pinned one (Codex C6b HIGH 3); the file re-read afterwards must still be those bytes."""
    99	    path = path or C.find_canon_manifest()
   100	    raw = _pinned_bytes("the CANON checkpoint manifest", path, CANON_MANIFEST_SHA256)
   101	    index = canon_index_from_bytes(raw, manifest["arms"]["CANON"]["ckpt"]["run_ns"])
   102	    with open(path, "rb") as f:
   103	        if f.read() != raw:
   104	            raise Refused([f"the CANON checkpoint manifest {path} changed between its hash and its parse"])
   105	    return index
