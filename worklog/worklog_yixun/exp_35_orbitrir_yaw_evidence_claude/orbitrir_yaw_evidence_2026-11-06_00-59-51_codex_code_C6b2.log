    56	def hand(factor):
    57	    v = [factor * c for c in STEPS]
    58	    return {"n": 8, "mean": sum(v) / 8, "median": (v[3] + v[4]) / 2, "p99": v[6] + 0.93 * (v[7] - v[6]), "max": v[7]}
    59	
    60	
    61	def assert_summary(got, factor):
    62	    want = hand(factor)
    63	    assert set(got) == {"n", "mean", "median", "p99", "max"} and got["n"] == 8
    64	    assert all(abs(got[s] - want[s]) <= 1e-15 for s in ("mean", "median", "p99", "max")), (got, want)
    65	
