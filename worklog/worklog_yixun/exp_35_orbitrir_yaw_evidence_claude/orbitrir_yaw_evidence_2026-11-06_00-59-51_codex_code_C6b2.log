  1999	def resolve(res, entry):
  2000	    """A table entry ``{"ref": "a.b.c"}`` -> ``res["a"]["b"]["c"]``: a reused row lives once (§5 item 3)."""
  2001	    node = res
  2002	    for key in entry["ref"].split("."):
  2003	        node = node[key]
  2004	    return node
