   416	    output_dir.mkdir(parents=True, exist_ok=True)
   417	    write_csv(output_dir / f"{OFFORBIT_STEM}_raw.csv", points)
   418	    write_csv(output_dir / f"{OFFORBIT_STEM}_summary.csv", summary)
   419	    fig = offorbit_figure(summary)
