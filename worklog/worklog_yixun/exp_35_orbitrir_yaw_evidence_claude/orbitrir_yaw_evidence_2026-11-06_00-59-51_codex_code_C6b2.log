  2024	def external_exp25_cells(manifest, *, base_dir, canon_index, farm_root=None, dump_root=None):
  2025	    """The exp_25 cells of table (b), verified OFFLINE at the exp_25 pin against the exp-25 worktree (§5):
  2026	    ``({cell: its flat item-weighted metrics}, reasons)``."""
  2027	    out, reasons = {}, []
  2028	    for name in EXP25_EXTERNAL:
  2029	        _, _, docs, why = _verified_cell(name, manifest=manifest, pin=EXP25_PIN, base_dir=base_dir, farm_root=farm_root,
  2030	                                         dump_root=dump_root, canon_index=canon_index)
  2031	        reasons += why
  2032	        if docs:
  2033	            out[name] = docs["metrics"]["metrics"]
  2034	    return out, reasons
