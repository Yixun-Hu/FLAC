    52	def distance_summary(values):
    53	    """n, mean, median, p99, max of per-item distances: the registered ``paired_summary`` plus the mean."""
    54	    s = stats.paired_summary(values)
    55	    return {"n": s["n"], "mean": float(np.mean(np.asarray(values, dtype=np.float64))), "median": s["median"],
    56	            "p99": s["p99"], "max": s["max"]}
