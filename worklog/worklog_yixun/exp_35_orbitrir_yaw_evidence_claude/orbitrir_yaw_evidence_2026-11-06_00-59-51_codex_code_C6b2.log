   697	        target, sha = expected_checkpoint(row, manifest, canon_index)
   698	        link = os.path.join(farm_root, row["arm"], os.path.basename(target))
   699	        dump = bool(row["dump"]) and row["block"] not in no_dump_blocks
   700	        p = cell_paths(row, link, dump_root)
