  2007	def cell_artifacts(row, manifest, *, farm_root, dump_root, canon_index, base_dir):
  2008	    """EVERY artifact of one cell that exists -- record, stream / canon sidecar, receipt, dump -- with every partial or
  2009	    stale output beside them (``<path>.incomplete-<ts>``, ``<dump>.staging-*``): Codex C3a C7 for the E2-FAIL block."""
  2010	    target, _ = expected_checkpoint(row, manifest, canon_index)
  2011	    p, found = cell_paths(row, os.path.join(farm_root, row["arm"], os.path.basename(target)), dump_root), []
  2012	    for rel in (p.metrics, p.stream, p.canon, p.receipt, p.dump_dir):
  2013	        parent, name = os.path.split(os.path.join(base_dir, rel))
  2014	        try:
  2015	            entries = os.listdir(parent)
  2016	        except FileNotFoundError:                  # only a missing directory is absence (Codex C3b HIGH 1)
  2017	            continue
  2018	        except OSError as err:
  2019	            raise ValueError(f"RESULTS REFUSED: the artifacts of {row['cell']} cannot be listed ({parent}: {err})") from err
  2020	        found += [os.path.join(parent, e) for e in entries if e == name or e.startswith(name + ".")]
  2021	    return sorted(set(found))
