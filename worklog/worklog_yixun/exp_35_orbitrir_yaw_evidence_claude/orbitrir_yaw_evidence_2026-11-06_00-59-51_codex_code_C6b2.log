   730	                 "canon": _file_digest(at(entry["canon"]))}
   731	    if artifacts["metrics"] is None or artifacts["stream"] is None or (entry["canon"] and artifacts["canon"] is None):
   732	        raise ValueError(f"{entry['cell']}: nothing to bind -- the metrics / stream / canon files are not all there")
   733	    try:
