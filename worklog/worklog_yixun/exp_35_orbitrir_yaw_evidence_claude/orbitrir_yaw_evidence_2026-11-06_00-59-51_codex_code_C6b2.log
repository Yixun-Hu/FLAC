   127	def registered_sources(source_45="a6"):
   128	    """``{(method, K, angle, seed): source}`` -- §6's source of every one of the 120 points; ``source_45`` = "a6" (E2
   129	    PASS) or "one-pin" (§14 A1.4, after an E2 FAIL) for the 45-degree FLAC / OrbitRIR points."""
   130	    if source_45 not in SOURCES_45:
   131	        raise ValueError(f"the 45-degree source must be one of {SOURCES_45}, got {source_45!r}")
   132	    out = {}
   133	    for k in KS:
   134	        for s in SEEDS:
   135	            for m, block in (("FLAC", "P1-pin"), ("CANON", "T")):
   136	                out[(m, k, 0, s)] = {"kind": "json", "campaign": "exp25", "arm": ARMS[m],
   137	                                     "cell": f"exp25_{ARMS[m]}_T_S40000_K{k}_s{s}", "block": block}
   138	            out[("OrbitRIR", k, 0, s)] = _cell("exp35", f"exp35_BF_T_S40000_K{k}_s{s}", "BF-pin")
   139	            for m in ("FLAC", "OrbitRIR"):
   140	                arm = ARMS[m]
   141	                if source_45 == "a6":
   142	                    out[(m, k, 45, s)] = {"kind": "a6", "campaign": "exp10_A6", "label": C.A6_METHODS[m]}
   143	                elif s == 42:
