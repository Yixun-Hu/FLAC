    79	def canon_index_from_bytes(raw, run_ns):
    80	    """The collector's ``load_canon_index`` rules (depth_canon_collect.py:552-570) applied to the bytes themselves: every
    81	    line ``<sha256>  <run_ns>/checkpoints/epoch=E-step=S.ckpt``, no step twice -- else Refused."""
    82	    pat, index = re.compile(re.escape(run_ns.rstrip("/")) + r"/checkpoints/epoch=\d+-step=(\d+)\.ckpt"), {}
    83	    try:
    84	        lines = raw.decode().splitlines()
    85	    except UnicodeDecodeError as err:
    86	        raise Refused([f"the CANON checkpoint manifest is not text ({err})"]) from err
    87	    for line in lines:
    88	        sha, sep, ckpt = line.partition("  ")
    89	        m = pat.fullmatch(ckpt) if sep and C.eval_FLAC._is_sha256_hex(sha) else None
    90	        if m is None or int(m.group(1)) in index:
    91	            raise Refused([f"the CANON checkpoint manifest line {line!r} is not one new checkpoint of {run_ns}"])
    92	        index[int(m.group(1))] = (ckpt, sha)
    93	    return index
    94	
