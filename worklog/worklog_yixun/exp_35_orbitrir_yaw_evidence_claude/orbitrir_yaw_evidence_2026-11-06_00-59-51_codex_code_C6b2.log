   752	           "ckpt_target": entry["target"], "ckpt_sha256": entry["sha256"],
   753	           "ckpt_cache": ckpt_cache_path(entry["link"], entry["sha256"]), "ckpt_sha256_measured": ckpt_sha256,
   754	           "ckpt_sha256_loaded": loaded["ckpt_sha256_loaded"], "ckpt_bytes_loaded": loaded["ckpt_bytes_loaded"],
