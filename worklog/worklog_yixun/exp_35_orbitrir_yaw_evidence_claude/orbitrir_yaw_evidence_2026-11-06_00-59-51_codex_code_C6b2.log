 def pair(spec, ctx, registry, cache, arrays):
     """``(record, reasons)`` of one registered pair: both cells verified and the registered rows, input_hash-equal,
     both dumps bound to their receipts; then the metric differences and the per-item distance summaries."""
     a, why = S.verified(spec["cell"], ctx, spec["cell_campaign"], registry, cache)
     b, more = S.verified(spec["ref"], ctx, spec["ref_campaign"], registry, cache)
     why = why + more
     if not (a and b):
         return None, why
     for e, deg in ((a, spec["deg"]), (b, spec["ref_deg"])):
         r = e["row"]
         if (r["arm"], r["K"], r["seed"], r["rotate_mode"], r["rotate_deg"]) != (spec["arm"], spec["K"], 42, "fixed", deg):
             why.append(f"{e['cell']} is not the {spec['arm']} K{spec['K']} s42 {deg}-degree cell of this pair")
     if not S.C._same_items(a, b):
         why.append(f"{a['cell']} and {b['cell']} do not pair: stream input_hash {a['stream'].get('input_hash')} != "
                    f"{b['stream'].get('input_hash')}")
