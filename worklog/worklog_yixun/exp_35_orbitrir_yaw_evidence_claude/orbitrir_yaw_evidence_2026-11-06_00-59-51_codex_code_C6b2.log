   721	                         f"{entry['sha256']}")
   722	    if backend != (backend_fields() if is_exp35(row) else None):   # exp_35: the runner's backend claim
   723	        raise ValueError(f"{entry['cell']}: attention backend fields {backend!r} are not "
   724	                         f"{backend_fields() if is_exp35(row) else None!r} for this cell")
   725	    if not eval_FLAC._is_sha256_hex(campaign_digest) or {spawn_digest, post_digest} != {campaign_digest}:
   726	        raise ValueError(f"{entry['cell']}: tree digest moved (campaign {campaign_digest}, spawn {spawn_digest}, "
   727	                         f"post {post_digest})")
   728	    at = lambda p: os.path.join(base_dir, p) if p else None  # noqa: E731
