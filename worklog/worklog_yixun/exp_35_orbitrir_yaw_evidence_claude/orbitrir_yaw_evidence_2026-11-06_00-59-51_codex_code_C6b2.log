   702	                    "K": row["K"], "seed": row["seed"], "target": target, "sha256": sha,
   703	                    "nas_manifest": ck.get("nas_manifest"), "nas_manifest_key": ck.get("nas_manifest_key"),
   704	                    "link": link, "cache": ckpt_cache_path(link, sha), "metrics": p.metrics, "stream": p.stream,
   705	                    "canon": p.canon if row["canonicalize"] else None, "canon_probe": p.canon,
   706	                    "receipt": p.receipt, "dump": dump, "dump_root": dump_root, "dump_dir": p.dump_dir,
   707	                    "stem": p.stem, "expected_stream_count": row["expected_stream_count"],
   708	                    "argv": cell_argv(row, link, dump_root, dump), **({"no_flash": True} if is_exp35(row) else {})})
