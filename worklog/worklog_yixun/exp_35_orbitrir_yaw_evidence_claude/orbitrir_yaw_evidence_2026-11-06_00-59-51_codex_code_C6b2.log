   849	@pytest.mark.parametrize("case", list(GATE_RACES))
   850	def test_a_gate_input_that_moves_while_the_gates_read_it_is_refused(tmp_path, monkeypatch, case):
   851	    ctx = world(tmp_path, monkeypatch)
   852	    gate, name, kind, how = GATE_RACES[case]
   853	    path = os.path.join(str(tmp_path), getattr(P1._paths(tmp_path, name), kind))
   854	    real = getattr(C, gate)
   855	
   856	    def raced(*a, **kw):
   857	        out = real(*a, **kw)
   858	        if gate == "exp35_e2" or a[0] == int(name.split("_K")[1][0]):   # E2's one call / E1's call of this K
   859	            if how == "edit":                                           # other bytes, the same inode
   860	                with open(path, "a") as f:
   861	                    f.write(" ")
   862	            else:                                                       # the same bytes, a new inode
   863	                shutil.copyfile(path, path + ".swap")
   864	                os.replace(path + ".swap", path)
   865	        return out
   866	
   867	    monkeypatch.setattr(C, gate, raced)
   868	    with pytest.raises(S.Refused) as err:
   869	        S.collect_points(ctx)
   870	    assert any("while the collector's gates read it" in x for x in err.value.reasons), (case, err.value.reasons[:4])
     1	"""exp_35 round 6b: E5 (descriptive, no verdict) -- ``analysis/yaw_robustness/exp35_e5_offorbit_pairs.py``
     2	(plan_orbitrir_yaw_evidence.md r4 §4 E5, §14 A2): B-F at 135 / 225 vs B-F at 45 (s42, same pin), CANON at 135 / 225 vs
     3	the exp_25 CANON T cell at 0 (a cross-pin pair), P1 vs angle.
     4	
     5	The world is the off-orbit figure's fixture (real evaluator functions, N = 8 items x T = 16 samples) with toy scored
     6	dumps whose per-item distances are exact powers of two, so every summary is computed by hand.
     7	
     8	Written by the exp_35 Coder (Claude Opus 5.5, max effort) for round 6b.
     9	"""
    10	import io
    11	import json
