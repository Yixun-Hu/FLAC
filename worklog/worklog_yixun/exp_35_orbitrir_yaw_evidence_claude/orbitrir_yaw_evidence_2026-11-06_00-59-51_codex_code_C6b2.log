    71	        for g, a, ref in (("bf_vs_45", "BF", "exp35_BF_C4_S40000_K{k}_s42_th45"),
    72	                          ("canon_vs_0", "CANON", "exp25_CANON_T_S40000_K{k}_s42"))
    73	        for k in (1, 8) for d in (135, 225)]
    74	    real = {r["cell"]: r for r in F.REAL["cells"]}
    75	    for p in pairs:                                                     # rows of the committed manifest
    76	        for name, deg in ((p["cell"], p["deg"]), (p["ref"], p["ref_deg"])):
