   360	def gates(ctx, source_45, cache):
   361	    """``(state, reasons)``: the pinned exp_25 JSON and stream registry; E1 equal at both K (every FLAC series mixes the
   362	    exp_25 pin and this one); E2 recomputed by the collector, consistent with the 45-degree source (a6 <-> PASS,
   363	    one-pin <-> FAIL); with a6, no artifact of the E2-FAIL block (it runs only after an E2 FAIL, §14 A1.3). Every file
   364	    E1 / E2 read is held before (the gate cells verified into ``cache``) and re-read after: movement refuses."""
   365	    m, base, kw = ctx["manifest"], ctx["base_dir"], {"farm_root": ctx["farm_root"], "dump_root": ctx["dump_root"]}
   366	    doc, why = C.load_exp25_reference(ctx["exp25_json"])
   367	    reasons = [f"the exp_25 results: {x}" for x in why] + ([] if C.EXP25_PIN == EXP25_PIN else [
   368	        f"the collector's exp_25 pin {C.EXP25_PIN} is not the registered {EXP25_PIN}"])
   369	    registry, why = C.load_registry()
   370	    reasons += [f"the stream registry: {x}" for x in why]
   371	    held, why = _gate_inputs(ctx, registry, cache) if registry is not None else ({}, [])
   372	    reasons += why
   373	    e1 = {k: C.exp35_ctl_check(k, pin=H35, manifest=m, base_dir=base, **kw) for k in KS}
   374	    reasons += [f"E1 CTL K{k} {st} (it must be equal: each FLAC series mixes the exp_25 pin and this pin): "
   375	                + "; ".join(w[:2]) for k, (st, w) in e1.items() if st != "equal"]
   376	    e2 = C.exp35_e2(pin=H35, manifest=m, base_dir=base, csv_path=ctx["a6_csv"], **kw)
   377	    want = {"a6": "PASS", "one-pin": "FAIL"}[source_45]
   378	    if e2["status"] != want:
   379	        reasons.append(f"the 45-degree source {source_45!r} is registered for E2 {want}, E2 is {e2['status']}"
   380	                       + "".join(f"; {x}" for x in e2["reasons"][:2]))
   381	    after, gone = _snapshot("", dict.fromkeys(held, "gate input"))
   382	    reasons += gone + [f"{path} moved while the collector's gates read it (its bytes or its device / inode)"
   383	                       for path in held if path in after and after[path] != held[path]]
   384	    if source_45 == "a6":
   385	        try:
   386	            present = [r["cell"] for r in C.select_cells(m, ["E2-FAIL"]) if C.cell_artifacts(
   387	                r, m, canon_index=ctx["canon_index"], base_dir=base, **kw)]
   388	        except ValueError as err:
   389	            present = [str(err)]
   390	        reasons += [f"E2-FAIL cell artifacts exist ({', '.join(present[:3])}): that block runs only after an E2 FAIL"
   391	                    ] if present else []
   392	    return {"exp25": doc, "registry": registry, "e1": {str(k): st for k, (st, _) in e1.items()}, "e2": e2}, reasons
