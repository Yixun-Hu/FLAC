   143	def e5(ctx, source_45="a6"):
   144	    """The E5 record, or :class:`yaw_offorbit_sources.Refused` naming every reason (nothing is written)."""
   145	    cache, arrays, groups = {}, {}, {"bf_vs_45": [], "canon_vs_0": []}
   146	    points, meta = S.collect_points(ctx, source_45, cache)
   147	    registry, why = S.C.load_registry()
   148	    reasons = [f"the stream registry: {x}" for x in why]
   149	    for spec in registered_pairs() if registry is not None else ():
   150	        rec, why = pair(spec, ctx, registry, cache, arrays)
   151	        reasons += why
   152	        groups[spec["group"]] += [rec] if rec else []
   153	    digests, why = S.campaign_digests(cache)
   154	    if reasons + why:
   155	        raise S.Refused(reasons + why)
   156	    inputs = dict(meta, campaign_digest=digests)
   157	    disclosure = (f"CROSS-PIN pairs: each 0-degree CANON reference is the exp_25 T cell evaluated at {inputs['exp25_pin']}"
   158	                  " (exp_25; SDPA: its log shows flash_attn not installed), each rotated cell an exp_35 OFF-CANON cell "
   159	                  f"evaluated at {inputs['pin']} (SDPA through the committed no-flash launcher: receipt v2 and its log); "
   160	                  "the streams are input_hash-equal; the evidence that the two pins evaluate identically is E1 (the P1 "
   161	                  f"CTL cells, required exactly equal at K1 / K8: {inputs['e1']}), another arm -- no same-pin CANON "
   162	                  "0-degree cell exists.")
   163	    return {"schema_version": 1, "section": SECTION, "verdict": None,
   164	            "plan": "plan_orbitrir_yaw_evidence.md r4 §4 E5 + §14 A2: descriptive only -- no rule, no verdict",
   165	            "inputs": inputs, "pairing": PAIRING, **groups, "disclosure": disclosure, "p1_vs_angle": p1_vs_angle(points)}
   166	
   167	
   168	def _g(v):
   169	    return f"{v:.6g}"
   170	
   171	
   172	def render_md(res):
   173	    """The ONE section the Planner joins to the results file (the JSON keeps every number at full precision)."""
   174	    i, name, angles = res["inputs"], lambda x: S.C.SHORT.get(x, x), ("0", "45", "135", "225")  # noqa: E731
   175	    out = [f"## {SECTION}", "", f"{res['plan']}. Written by `analysis/yaw_robustness/exp35_e5_offorbit_pairs.py` from "
   176	           f"verified inputs; never hand-edited. exp_35 pin `{i['pin']}`; exp_25 pin `{i['exp25_pin']}`; E1 CTL {i['e1']};"
   177	           f" E2 {i['e2']['status']} (45-degree FLAC source `{i['source_45']}`); campaign digests {i['campaign_digest']}.",
   178	           "", f"Pairing: {res['pairing']}.", ""]
   179	    stat = ("mean", "median", "p99", "max")
   180	    for group, title in (("bf_vs_45", "B-F at 135° / 225° vs B-F at 45° (s42, same pin)"),
   181	                         ("canon_vs_0", "CANON at 135° / 225° vs CANON at 0° (s42) — CROSS-PIN")):
   182	        out += [f"### {title}", ""] + ([f"**Disclosure:** {res['disclosure']}", ""] if group == "canon_vs_0" else [])
   183	        out += ["| cell | reference | K | pin cell / ref | " + " | ".join(f"{d} {s}" for d in ("relL2", "relL∞")
   184	                                                                         for s in stat) + " |", "|" + "---|" * 12]
   185	        out += [f"| {p['cell']} | {p['ref']} | {p['K']} | `{p['pins']['cell'][:12]}` / `{p['pins']['ref'][:12]}` | "
   186	                + " | ".join(_g(p[d][s]) for d in ("relL2", "relLinf") for s in stat) + " |" for p in res[group]]
   187	        out += ["", "Item-weighted metric differences (cell − reference):", "",
   188	                "| cell | K | " + " | ".join(name(x) for x in S.KEYS) + " |", "|---|---|" + "---|" * len(S.KEYS)]
   189	        out += [f"| {p['cell']} | {p['K']} | " + " | ".join(_g(p["metrics"][x]["diff"]) for x in S.KEYS) + " |"
   190	                for p in res[group]] + [""]
   191	    out += ["### P1 (FLAC) vs angle — mean ± sd over seeds 42–46 (item-weighted); Δθ = mean(θ) − mean(0°)", "",
   192	            "| K | metric | " + " | ".join(f"{a}°" for a in angles) + " | " + " | ".join(f"Δ{a}°" for a in angles[1:])
   193	            + " |", "|---|---|" + "---|" * 7]
   194	    p1 = res["p1_vs_angle"]
   195	    out += [f"| {k} | {name(x)} | " + " | ".join(f"{_g(p1[k][x]['angles'][a]['mean'])} ± {_g(p1[k][x]['angles'][a]['sd'])}"
   196	                                                 for a in angles) + " | "
   197	            + " | ".join(_g(p1[k][x]["diff_vs_0"][a]) for a in angles[1:]) + " |" for k in ("1", "8") for x in S.KEYS]
   198	    src = {a: sorted({f"{c} @ {pin[:12]}" for k in p1 for x in p1[k] for c, pin in p1[k][x]["angles"][a]["provenance"]})
   199	           for a in angles}
   200	    return "\n".join(out + ["", "Sources (campaign @ evaluator pin): " + "; ".join(
   201	        f"{a}°: {', '.join(v)}" for a, v in src.items()) + "."]) + "\n"
   202	
   203	
   204	def main(argv=None):
   205	    ap = argparse.ArgumentParser(description="exp_35 E5 (descriptive, no verdict)")
   206	    S.add_input_args(ap)
   207	    ap.add_argument("--out", default=OUT, help="the output prefix: <out>.json and <out>.md")
   208	    args = ap.parse_args(argv)
   209	    try:
   210	        res = e5(S.context_from_args(args), args.source_45)
   211	    except (S.Refused, ValueError, OSError, KeyError) as err:
   212	        reasons = err.reasons if isinstance(err, S.Refused) else [repr(err)]
   213	        print(f"E5 REFUSED (nothing written): {len(reasons)} reason(s)\n" + "\n".join(f"  - {x}" for x in reasons))
   214	        return 3
   215	    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
   216	    with open(args.out + ".json", "w") as f:
   217	        json.dump(res, f, indent=1)
   218	    with open(args.out + ".md", "w") as f:
   219	        f.write(render_md(res))
   220	    print(f"wrote {args.out}.json and {args.out}.md (E5, descriptive, no verdict)")
   221	    return 0
   222	
   223	
   224	if __name__ == "__main__":
   225	    raise SystemExit(main())

