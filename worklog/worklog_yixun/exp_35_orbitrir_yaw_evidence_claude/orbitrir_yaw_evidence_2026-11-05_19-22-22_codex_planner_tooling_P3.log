   245	class Transaction:
   246	    """Declare verified sources, read-only git checks, the date and every change, then commit() once."""
   247	
   248	    def __init__(self, state_dir):
   249	        self._spent, self._day, self.sources, self._dst, self._git = False, None, [], {}, []
   250	        self.state_dir = os.path.realpath(os.fspath(state_dir))
   251	        if not os.path.isdir(self.state_dir):
   252	            raise Refused(f"records_txn: state_dir {self.state_dir} is not a directory (create it once: mkdir -p)")
   253	        _refuse_unfinished(self.state_dir)
   254	        self.now = now()
   255	        self.iso, self.hm = stamps(self.now)
   256	        self.txid = self.now.strftime("%Y%m%dT%H%M%S%z-") + secrets.token_hex(4)
   257	
   258	    @_spends
   259	    def expect_date(self, day):
   260	        """The mandatory date guard: `day` must be today in New York now, and again at commit (under the lock)."""
   261	        expect_date(day, self.now)
   262	        self._day = day
   263	
   264	    @_spends
   265	    def require_source(self, path, digest):
   266	        """The bytes of a source artifact, refused unless their full sha256 equals `digest`."""
   267	        want, data = _hex(digest), _read(path)[0]
   268	        if sha256(data) != want:
   269	            raise Refused(f"records_txn: source {path} has sha256 {sha256(data)}, the script expects {want}")
   270	        self.sources.append({"path": os.path.abspath(os.fspath(path)), "sha256": want})
   271	        return data
   272	
   273	    @_spends
   274	    def require_text(self, path, digest, must_contain=(), must_start=None):
   275	        """A verified UTF-8 source that starts with `must_start` and contains every string in `must_contain`."""
   276	        needles = None if isinstance(must_contain, (str, bytes)) else list(must_contain)
   277	        checks = (needles or []) + ([] if must_start is None else [must_start])
   278	        if needles is None or not all(isinstance(s, str) and s for s in checks):
   279	            raise Refused("records_txn: must_contain takes a list of non-empty str (and must_start a non-empty str)")
   280	        text = _decode(self.require_source(path, digest), path)
   281	        if must_start is not None and not text.startswith(must_start):
   282	            raise Refused(f"records_txn: {path} does not start with {must_start!r}")
   283	        for s in needles:
   284	            if s not in text:
   285	                raise Refused(f"records_txn: {path} does not contain {s!r}")
   286	        return text
   287	
   288	    @_spends
   289	    def require_git(self, repo, branch=None, head=None, upstream=None, clean_paths=()):
   290	        """Read-only git checks (HEAD sha, branch, upstream == HEAD, clean paths), run now and again under the
   291	        lock at commit, where any change since now refuses. Returns the observed state (it is also archived)."""
   292	        paths = None if isinstance(clean_paths, (str, bytes)) else [os.fspath(p) for p in clean_paths]
   293	        names = all(v is None or (isinstance(v, str) and v and not v.startswith("-")) for v in (branch, upstream))
   294	        sha = head is None or (isinstance(head, str) and _COMMIT.fullmatch(head))
   295	        if paths is None or not names or not sha or (branch, head, upstream) == (None, None, None) and not paths:
   296	            raise Refused("records_txn: require_git takes branch / upstream names, head as a full commit sha and "
   297	                          "clean_paths as a list of paths - at least one of them")
   298	        check = {"repo": os.path.realpath(os.fspath(repo)), "branch": branch, "head": head, "upstream": upstream,
   299	                 "clean_paths": paths}
   300	        seen = _git_state(check)
   301	        self._git.append((check, seen))
   302	        return dict(seen)
