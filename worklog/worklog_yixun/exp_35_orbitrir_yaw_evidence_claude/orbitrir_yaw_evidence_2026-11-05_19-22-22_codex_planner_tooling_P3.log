   211	def _remove_all(files, dirs):
   212	    """Remove our files, then our directories (innermost first), and fsync their parents; returns what is left."""
   213	    left = []
   214	    for remove, p in [(os.unlink, f) for f in files] + [(os.rmdir, d) for d in reversed(dirs)]:
   215	        try:
   216	            remove(p)
   217	        except FileNotFoundError:
   218	            pass
   219	        except OSError as e:
   220	            left.append(f"{p} ({e.strerror})")
   221	    for d in sorted({os.path.dirname(p) for p in [*files, *dirs]}):
   222	        try:
   223	            _fsync_dir(d)
   224	        except FileNotFoundError:
   225	            pass
   226	        except OSError as e:
   227	            left.append(f"fsync {d} ({e.strerror})")
   228	    return left
