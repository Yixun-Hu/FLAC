    88	def _on_first_temp(monkeypatch, action):
    89	    """Run `action` once, right after the commit created its first staged temp (i.e. during staging)."""
    90	    real_open, fired = os.open, []
    91	
    92	    def spy(path, flags, *args, **kwargs):
    93	        fd = real_open(path, flags, *args, **kwargs)
    94	        if os.fspath(path).endswith(".records_txn.tmp") and not fired:
    95	            fired.append(path)
    96	            action()
    97	        return fd
    98	    monkeypatch.setattr(rt.os, "open", spy)
