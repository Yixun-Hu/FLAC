   890	def test_the_install_protocol_order(env, monkeypatch):
   891	    state, docs = env
   892	    a, n = docs / "a.md", docs / "n.md"
   893	    a.write_bytes(b"a\n")
   894	    t = txn(state)
   895	    t.create(n, b"n\n")
   896	    t.append(a, "b\n")
   897	    trace, real = [], {name: getattr(os, name) for name in ("fsync", "link", "replace", "unlink")}
   898	
   899	    def fsync(fd):
   900	        trace.append(("fsync", os.readlink(f"/proc/self/fd/{fd}")))
   901	        return real["fsync"](fd)
   902	
   903	    def traced(name):
   904	        def call(src, *rest, **kwargs):
   905	            trace.append((name, os.fspath(rest[0] if rest else src)))   # link / replace: the destination
   906	            return real[name](src, *rest, **kwargs)
   907	        return call
   908	    monkeypatch.setattr(rt.os, "fsync", fsync)
   909	    for name in ("link", "replace", "unlink"):
   910	        monkeypatch.setattr(rt.os, name, traced(name))
   911	    done = t.commit()
   912	    monkeypatch.undo()
   913	    r = lambda p: str(pathlib.Path(p).resolve())                          # noqa: E731
   914	    at = trace.index
   915	    mark, sdir, ddir, docs_dir = r(state / rt.MANIFEST), r(state), r(state / rt.DONE), r(docs)
   916	    temp_syncs = [i for i, e in enumerate(trace) if e[0] == "fsync" and e[1].endswith(".records_txn.tmp")]
   917	    first_install, last_install = at(("link", r(n))), at(("replace", r(a)))
   918	    assert len(temp_syncs) == 2
   919	    assert at(("fsync", mark)) < at(("fsync", sdir)) < temp_syncs[0]          # the mark is durable first
   920	    assert temp_syncs[-1] < trace.index(("fsync", docs_dir), temp_syncs[-1]) < first_install
   921	    assert first_install < last_install < trace.index(("fsync", docs_dir), last_install)
   922	    archived, cleared = at(("link", r(done))), at(("unlink", mark))
   923	    assert trace.index(("fsync", docs_dir), last_install) < archived
   924	    assert archived < trace.index(("fsync", ddir), archived) < cleared        # done/ durable before the clear
   925	    assert cleared < trace.index(("fsync", sdir), cleared)                   # and the clear made durable
