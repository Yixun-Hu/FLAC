   327	    @_spends
   328	    def text(self, path, expect_sha256=None):
   329	        """The destination's in-memory text: read once, compare-and-swap checked at commit even if unchanged."""
   330	        return self._edit(path, expect_sha256)[1]["text"]
   331	
   332	    @_spends
   333	    def replace_once(self, path, old, new):
   334	        if not (isinstance(old, str) and old and isinstance(new, str)):
   335	            raise Refused("records_txn: replace_once takes a non-empty str anchor and a str replacement")
   336	        k, d = self._edit(path)
   337	        n = len(re.findall(f"(?={re.escape(old)})", d["text"]))   # every start position: overlaps count
   338	        if n != 1:
   339	            raise Refused(f"records_txn: anchor occurs {n} times in {k} (exactly 1 required): {old[:160]!r}")
   340	        d["text"] = d["text"].replace(old, new, 1)
   341	
   342	    @_spends
   343	    def append(self, path, text):
   344	        if not (isinstance(text, str) and text.endswith("\n")):
   345	            raise Refused("records_txn: append takes a str ending with a newline")
   346	        k, d = self._edit(path)
   347	        if not d["text"].endswith("\n"):
   348	            raise Refused(f"records_txn: {k} does not end with a newline; refusing to append")
   349	        d["text"] += text
