   367	    @_spends
   368	    def commit(self):
   369	        """Lock; re-check every destination, the date and git; mark; stage; look again; install; archive.
   370	        Returns the archived manifest's path (the audit record)."""
   371	        self._spent = True
   372	        if self._day is None:
   373	            raise Refused("records_txn: call expect_date('YYYY-MM-DD') before commit(); nothing written")
   374	        ops = [(k, d["old"], d["data"] if d["old"] is None else d["text"].encode("utf-8"), d.get("mode"))
   375	               for k, d in self._dst.items()]
   376	        ops = sorted((o for o in ops if o[1] is None or sha256(o[2]) != o[1]), key=lambda o: o[1] is not None)
   377	        if not ops:
   378	            raise Refused("records_txn: nothing to commit (no destination changes)")
