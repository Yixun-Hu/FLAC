   351	    @_spends
   352	    def create(self, path, data, parents=False):
   353	        data = data.encode("utf-8") if isinstance(data, str) else data
   354	        if not isinstance(data, bytes):
   355	            raise Refused("records_txn: create takes bytes or str")
