   101	def corrupt_staged_writes(monkeypatch, old, new):
   102	    """Writes to staged temps (only) get `old` replaced by `new`, as a failing disk might."""
   103	    real_write = os.write
   104	
   105	    def write(fd, data):
   106	        if os.readlink(f"/proc/self/fd/{fd}").endswith(".records_txn.tmp"):
   107	            return real_write(fd, bytes(data).replace(old, new))
   108	        return real_write(fd, data)
   109	    monkeypatch.setattr(rt.os, "write", write)
