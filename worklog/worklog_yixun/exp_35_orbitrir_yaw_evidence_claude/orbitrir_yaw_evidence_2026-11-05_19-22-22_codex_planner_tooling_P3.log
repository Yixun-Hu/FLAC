   231	def _spends(method):
   232	    """A spent transaction (committed, or any failure in a method) refuses every further call."""
   233	    @functools.wraps(method)
   234	    def wrapper(self, *args, **kwargs):
   235	        if self._spent:
   236	            raise Refused("records_txn: this transaction is spent (committed or refused); start a new one")
   237	        try:
   238	            return method(self, *args, **kwargs)
   239	        except BaseException:
   240	            self._spent = True
   241	            raise
   242	    return wrapper
