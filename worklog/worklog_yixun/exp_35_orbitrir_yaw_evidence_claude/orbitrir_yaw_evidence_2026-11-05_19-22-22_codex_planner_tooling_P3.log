    77	def _on_manifest_creation(monkeypatch, action):
    78	    """Run `action` when the commit creates its recovery manifest (before anything is staged)."""
    79	    real_open = os.open
    80	
    81	    def spy(path, flags, *args, **kwargs):
    82	        if os.fspath(path).endswith(rt.MANIFEST):
    83	            action()
    84	        return real_open(path, flags, *args, **kwargs)
    85	    monkeypatch.setattr(rt.os, "open", spy)
