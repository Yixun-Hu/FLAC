  1055	def test_require_git_checks_run_under_the_lock_at_commit(env, repo, monkeypatch):
  1056	    state, _ = env
  1057	    r, _ = repo
  1058	    real_git, phase, seen = rt._git, ["declare"], []
  1059	
  1060	    def probing_git(*args):
  1061	        fd = os.open(state / rt.LOCK, os.O_RDWR | os.O_CREAT)
  1062	        try:
  1063	            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
  1064	            seen.append((phase[0], "free"))
  1065	        except BlockingIOError:
  1066	            seen.append((phase[0], "held"))
  1067	        finally:
  1068	            os.close(fd)
  1069	        return real_git(*args)
  1070	    monkeypatch.setattr(rt, "_git", probing_git)
  1071	    t = txn(state)
  1072	    t.require_git(r, branch="main")
  1073	    t.append(r / "note.md", "more\n")
  1074	    phase[0] = "commit"
  1075	    t.commit()
  1076	    assert {s for p, s in seen if p == "commit"} == {"held"} and ("declare", "free") in seen
