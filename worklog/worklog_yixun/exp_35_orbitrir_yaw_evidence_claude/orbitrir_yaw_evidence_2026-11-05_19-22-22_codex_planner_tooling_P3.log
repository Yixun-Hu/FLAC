   122	def _git(repo, *args):
   123	    """stdout of a read-only git command (no optional locks, so `status` never rewrites the index; no fsmonitor)."""
   124	    cmd = ["git", "--no-optional-locks", "-c", "core.fsmonitor=false", "-C", repo, *args]
   125	    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0", GIT_LITERAL_PATHSPECS="1", GIT_TERMINAL_PROMPT="0", LC_ALL="C")
   126	    try:
   127	        r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, env=env, timeout=120)
   128	    except (OSError, subprocess.SubprocessError) as e:
   129	        raise Refused(f"records_txn: cannot run git ({e!r})") from e
   130	    if r.returncode != 0:
   131	        err = r.stderr.decode("utf-8", "replace").strip()[:300]
   132	        raise Refused(f"records_txn: {' '.join(cmd)} failed (rc {r.returncode}): {err}")
   133	    return r.stdout.decode("utf-8", "replace")
