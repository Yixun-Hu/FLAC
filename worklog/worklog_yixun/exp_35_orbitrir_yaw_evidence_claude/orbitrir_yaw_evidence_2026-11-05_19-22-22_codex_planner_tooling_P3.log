   136	def _git_state(check):
   137	    """What a require_git() check observes now; refuses on any mismatch with the script's expectations."""
   138	    repo = check["repo"]
   139	    seen = {"repo": repo, "head": _git(repo, "rev-parse", "--verify", "HEAD^{commit}").strip()}
   140	    if check["head"] is not None and seen["head"] != check["head"]:
   141	        raise Refused(f"records_txn: {repo} HEAD is {seen['head']}, the script expects {check['head']}")
   142	    if check["branch"] is not None:
   143	        seen["branch"] = _git(repo, "symbolic-ref", "--short", "HEAD").strip()
   144	        if seen["branch"] != check["branch"]:
   145	            raise Refused(f"records_txn: {repo} is on branch {seen['branch']!r}, the script expects "
   146	                          f"{check['branch']!r}")
   147	    if check["upstream"] is not None:
   148	        seen["upstream"] = _git(repo, "rev-parse", "--verify", check["upstream"] + "^{commit}").strip()
   149	        if seen["upstream"] != seen["head"]:
   150	            raise Refused(f"records_txn: {repo} {check['upstream']} is {seen['upstream']}, not HEAD {seen['head']}")
   151	    if check["clean_paths"]:
   152	        missing = [p for p in check["clean_paths"] if not os.path.lexists(os.path.join(repo, p))]
   153	        if missing:                                  # a mistyped path must not pass vacuously
   154	            raise Refused(f"records_txn: clean_paths that do not exist in {repo}: {missing}")
   155	        dirty = _git(repo, "status", "--porcelain=v1", "-z", "--untracked-files=all", "--ignored", "--",
   156	                     *check["clean_paths"])
   157	        if dirty:
   158	            raise Refused(f"records_txn: {repo} has uncommitted changes in the checked paths: "
   159	                          f"{dirty.replace(chr(0), '; ')[:300]}")
   160	        seen["clean_paths"] = check["clean_paths"]
   161	    return seen
