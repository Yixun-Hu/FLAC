    57	def _hex(digest):
    58	    if not (isinstance(digest, str) and _HEX64.fullmatch(digest.lower())):
    59	        raise Refused(f"records_txn: expected a full 64-hex sha256, got {digest!r}")
    60	    return digest.lower()
