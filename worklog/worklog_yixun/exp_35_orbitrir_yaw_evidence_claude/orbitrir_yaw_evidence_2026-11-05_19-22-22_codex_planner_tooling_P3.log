   403	    def _install(self, ops):
   404	        manifest, done_dir = os.path.join(self.state_dir, MANIFEST), os.path.join(self.state_dir, DONE)
   405	        temps = {k: os.path.join(os.path.dirname(k), f".{os.path.basename(k)}.{self.txid}.records_txn.tmp")
   406	                 for k, *_ in ops}
   407	        planned = []                                 # missing parents of new files, outermost first
   408	        for k, old, _, _ in ops:
   409	            chain, p = [], os.path.dirname(k)
   410	            while old is None and self._dst[k]["parents"] and not os.path.isdir(p):
   411	                chain, p = [p] + chain, os.path.dirname(p)
   412	            planned += [c for c in chain if c not in planned]
   413	        doc = {"format": "records_txn/2", "txid": self.txid, "started": self.iso, "date": self._day,
   414	               "pid": os.getpid(), "host": socket.gethostname(), "argv": sys.argv, "sources": self.sources,
   415	               "git": [seen for _, seen in self._git], "planned_dirs": planned,
   416	               "checked_unchanged": [{"path": k, "sha256": d["old"]} for k, d in self._dst.items()
   417	                                     if d["old"] is not None and k not in temps],
   418	               "ops": [{"op": "replace" if old else "create", "dst": k, "tmp": temps[k], "old_sha256": old,
   419	                        "new_sha256": sha256(data)} for k, old, data, _ in ops]}
   420	        made, staged, marked, attempted, confirmed = [], [], False, False, 0
   421	        try:
   422	            os.makedirs(done_dir, exist_ok=True)     # the archive's home exists before the mark (helper state only)
   423	            fd = _excl(manifest, 0o664)              # the recovery mark comes first: nothing can be orphaned
   424	            marked = True
   425	            _write_all(fd, json.dumps(doc, indent=1, sort_keys=True).encode("utf-8") + b"\n")
