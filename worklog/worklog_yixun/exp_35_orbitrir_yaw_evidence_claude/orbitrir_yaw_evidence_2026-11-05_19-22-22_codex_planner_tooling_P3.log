   357	        if k in self._dst or os.path.lexists(k):
   358	            raise Refused(f"records_txn: destination exists (or is already in this transaction): {k}")
   359	        if not parents and not os.path.isdir(os.path.dirname(k)):
   360	            raise Refused(f"records_txn: no directory {os.path.dirname(k)} (pass parents=True to create it)")
   361	        self._dst[k] = {"old": None, "data": data, "parents": bool(parents)}
   362	
   363	    @_spends
   364	    def copy_verified(self, src, dst, digest, parents=False):
   365	        self.create(dst, self.require_source(src, digest), parents)
