   304	    def _edit(self, path, expect=None):
   305	        k = _key(path)
   306	        d = self._dst.get(k)
   307	        if d is None:
   308	            data, st = _read(k, follow=False)
   309	            if st.st_nlink != 1:
   310	                raise Refused(f"records_txn: {k} has {st.st_nlink} hard links; replacing it would split them")
   311	            d = self._dst[k] = {"old": sha256(data), "mode": stat.S_IMODE(st.st_mode), "text": _decode(data, k)}
   312	        elif d["old"] is None:
   313	            raise Refused(f"records_txn: {k} is a new file of this transaction; build its bytes before create()")
   314	        if expect is not None and d["old"] != _hex(expect):
   315	            raise Refused(f"records_txn: {k} has sha256 {d['old']}, the script expects {_hex(expect)}")
