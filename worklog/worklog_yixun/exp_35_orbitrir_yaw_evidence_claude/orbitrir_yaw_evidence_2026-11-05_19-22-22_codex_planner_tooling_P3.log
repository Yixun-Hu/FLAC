   174	def describe_recovery(state_dir):
   175	    """A read-only report on an unfinished transaction and how to resolve it by hand."""
   176	    m = os.path.join(os.path.realpath(os.fspath(state_dir)), MANIFEST)
   177	    if not os.path.lexists(m):
   178	        return f"records_txn: no unfinished transaction in {state_dir}"
   179	    out, tags = [f"records_txn: an unfinished transaction left the recovery manifest {m}",
   180	                 "Nothing is rolled back or deleted automatically. Its planned installs, as they stand now:"], []
   181	    try:
   182	        doc = json.loads(_read(m, follow=False)[0])
   183	        for op in doc["ops"]:
   184	            dst, tmp = _file_state(op["dst"], op), _file_state(op["tmp"], op)
   185	            before = "old" if op["op"] == "replace" else "missing"
   186	            tags.append("installed" if dst == "new" else "CONFLICT" if dst != before else
   187	                        "pending" if tmp == "new" else "unstaged")
   188	            out.append(f"  [{tags[-1]}] {op['op']} {op['dst']}: destination {dst}; staged temp {op['tmp']} {tmp}")
   189	        out += [f"  planned directory {p}: {'exists' if os.path.isdir(p) else 'absent'}"
   190	                for p in doc.get("planned_dirs", [])]
   191	    except (Refused, OSError, ValueError, KeyError, TypeError) as e:
   192	        out.append(f"  the manifest is unreadable ({e!r}); inspect it by hand")
   193	        tags.append("CONFLICT")
   194	    if set(tags) <= {"pending", "unstaged"}:
   195	        out.append("Every destination still holds its old bytes (or is still absent): nothing was installed. To "
   196	                   "discard, remove the staged temps that exist and the planned directories that exist (if empty).")
   197	    out.append("To resolve by hand: finish each pending entry (replace: mv TEMP DST; create: ln TEMP DST && rm TEMP) "
   198	               "or discard it (rm TEMP); an unstaged entry has nothing to finish; remove any temp left beside an "
   199	               "installed entry; settle each conflict yourself; then "
   200	               f"move the manifest aside, e.g. mkdir -p {os.path.dirname(m)}/{DONE} && mv {m} "
   201	               f"{os.path.dirname(m)}/{DONE}/<txid>.resolved.json. Re-inspect with: python "
   202	               f"{os.path.abspath(__file__)} status {state_dir}")
   203	    return "\n".join(out)
   204	
   205	
   206	def _refuse_unfinished(state_dir):
   207	    if os.path.lexists(os.path.join(state_dir, MANIFEST)):
   208	        raise RecoveryNeeded(describe_recovery(state_dir))
