    36	def stamps(when):
    37	    """(ISO 8601 with its UTC offset, 'HH:MM EST' or 'HH:MM EDT'), both in America/New_York."""
    38	    if not isinstance(when, datetime.datetime) or when.utcoffset() is None:
    39	        raise Refused("records_txn: stamps() needs an aware datetime (a naive one has no time zone)")
    40	    when = when.astimezone(TZ)
    41	    return when.isoformat(timespec="seconds"), when.strftime("%H:%M %Z")
