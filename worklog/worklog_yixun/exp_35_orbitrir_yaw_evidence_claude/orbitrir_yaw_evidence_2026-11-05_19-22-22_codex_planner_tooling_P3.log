   380	        try:
   381	            lock = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o664)
   382	        except OSError as e:
   383	            raise Refused(f"records_txn: cannot open the lock {lock_path}: {e.strerror}; nothing written") from e
   384	        try:
   385	            try:
   386	                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
   387	            except BlockingIOError:
   388	                raise Refused(f"records_txn: another writer holds the lock {lock_path}; nothing written") from None
   389	            _refuse_unfinished(self.state_dir)
   390	            for k, d in self._dst.items():           # compare-and-swap: every destination is still what was read
   391	                if self._moved(k, d["old"]):
   392	                    what = "appeared since it was checked" if d["old"] is None else "changed since it was read"
   393	                    raise Refused(f"records_txn: {k} {what} (bytes, links or existence); nothing written")
