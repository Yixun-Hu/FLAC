   164	def _file_state(path, op):
   165	    if not os.path.lexists(path):
   166	        return "missing"
   167	    try:
   168	        digest = sha256(_read(path, follow=False)[0])
   169	    except (Refused, OSError):
   170	        return "unreadable"
   171	    return "new" if digest == op["new_sha256"] else "old" if digest == op["old_sha256"] else f"other ({digest[:12]})"
