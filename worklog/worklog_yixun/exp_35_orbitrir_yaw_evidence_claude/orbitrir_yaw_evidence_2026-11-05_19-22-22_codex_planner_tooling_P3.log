    69	def _read(path, follow=True):
    70	    """(bytes, stat) of a regular file; with follow=False a symlink is refused (O_NOFOLLOW closes the race)."""
    71	    if not follow and os.path.islink(path):
    72	        raise Refused(f"records_txn: destination is a symlink: {path}")
    73	    try:
    74	        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC | (0 if follow else os.O_NOFOLLOW))
    75	    except OSError as e:
    76	        raise Refused(f"records_txn: cannot open {path}: {e.strerror}") from e
    77	    try:
    78	        st, chunks = os.fstat(fd), []
    79	        if not stat.S_ISREG(st.st_mode):
    80	            raise Refused(f"records_txn: not a regular file: {path}")
    81	        while True:
    82	            chunk = os.read(fd, 1 << 20)
    83	            if not chunk:
    84	                return b"".join(chunks), st
    85	            chunks.append(chunk)
    86	    finally:
    87	        os.close(fd)
