   318	    @staticmethod
   319	    def _moved(k, old):
   320	        """Whether a destination is no longer what the plan was built on: a new file that now exists, or an edited
   321	        file whose bytes differ or that is no longer a regular file with exactly one link."""
   322	        if old is None:
   323	            return os.path.lexists(k)
   324	        data, st = _read(k, follow=False)
   325	        return sha256(data) != old or st.st_nlink != 1
