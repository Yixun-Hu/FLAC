    44	def expect_date(day, when=None):
    45	    """Refuse unless `when` (default: the clock) falls on `day` ('YYYY-MM-DD') in America/New_York."""
    46	    try:
    47	        valid = datetime.date.fromisoformat(day).isoformat() == day
    48	    except (TypeError, ValueError):
    49	        valid = False
    50	    if not valid:
    51	        raise Refused(f"records_txn: expect_date wants 'YYYY-MM-DD', got {day!r}")
    52	    local = stamps(now() if when is None else when)[0][:10]
    53	    if local != day:
    54	        raise Refused(f"records_txn: the clock's America/New_York date is {local}, the script expects {day}")
