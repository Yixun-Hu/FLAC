    90	def _write_all(fd, data, mode=None):
    91	    """Write every byte to fd (optionally setting its mode first) and fsync it; always closes fd."""
    92	    try:
    93	        if mode is not None:
    94	            os.fchmod(fd, mode)
    95	        view = memoryview(data)
    96	        while view:
    97	            view = view[os.write(fd, view):]
    98	        os.fsync(fd)
    99	    finally:
   100	        os.close(fd)
