    63	def _key(path):
    64	    """Canonical destination name: absolute, parent directories resolved, the final component kept as given."""
    65	    p = os.path.abspath(os.fspath(path))
    66	    return os.path.join(os.path.realpath(os.path.dirname(p)), os.path.basename(p))
