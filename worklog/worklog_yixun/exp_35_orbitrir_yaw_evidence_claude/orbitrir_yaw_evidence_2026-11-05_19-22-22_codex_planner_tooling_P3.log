   358	    assert rt.stamps(datetime(2026, 7, 4, 16, 0, tzinfo=timezone.utc)) == ("2026-07-04T12:00:00-04:00", "12:00 EDT")
   359	    with pytest.raises(rt.Refused, match="naive"):
   360	        rt.stamps(datetime(2026, 11, 5, 12, 0))
