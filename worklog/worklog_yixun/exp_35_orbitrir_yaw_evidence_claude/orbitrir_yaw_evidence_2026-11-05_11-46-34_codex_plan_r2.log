    89	
    90	def rot_token(rotate_deg):
    91	    """The decimal-safe rendering of a yaw offset, with no empty case.
    92	
    93	    ``rot_suffix`` renders 0 as the empty string so unrotated filenames stay
    94	    byte-identical to the legacy ones. An eval NAME cannot do that -- `rot` with
    95	    nothing after it is not a name -- so the R3 naming uses this instead:
    96	    ``0 -> '0'``, ``5.625 -> '5p625'``.
    97	    """
    98	    d = float(rotate_deg)
    99	    return str(int(d)) if d.is_integer() else repr(d).replace('.', 'p')
