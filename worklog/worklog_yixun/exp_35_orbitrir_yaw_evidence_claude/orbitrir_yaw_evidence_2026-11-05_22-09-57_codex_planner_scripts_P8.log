    15	[[ "$N" =~ ^[0-9]+$ ]] && [ "$N" -ge 1 ] && [ "$N" -le 33 ] || bad "N $N"
    16	[[ "$POLL" =~ ^[0-9]+$ ]] && [ "$POLL" -ge 10 ] && [ "$POLL" -le 600 ] || bad "poll $POLL"
    17	INODE="$(stat -c '%d:%i' -- "$LOG" 2>/dev/null)" || bad "log $LOG unreadable"
    18	same_process() {
    19	  local stat; stat="$(cat "/proc/$PID/stat" 2>/dev/null)" || return 1
    20	  [ "$(printf '%s' "${stat##*) }" | awk '{print $20}')" = "$START" ] || return 1     # field 22 = the 20th after "comm) "
