    26	        then (if .stop_latch != null then "LATCH" else "OK" end) + " " + ([.chunks[] | select(.state == "gates_verified")] | length | tostring)
    27	        else error("schema") end'
    28	event=""
    29	while :; do
    30	  if ! same_process; then event="the supervisor (pid $PID, start $START) is gone or no longer the launched process"; break; fi
    31	  if [ "$(stat -c '%d:%i' -- "$LOG" 2>/dev/null)" != "$INODE" ]; then event="the supervisor log $LOG was replaced or removed"; break; fi
