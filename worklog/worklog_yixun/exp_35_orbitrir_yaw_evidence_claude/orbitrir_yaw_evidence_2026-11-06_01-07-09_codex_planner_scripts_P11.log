    50	ASSETS=(outputs_loc/exp22/d1_context_manifest.json outputs_loc/exp22/g1_audit/geometry_audit_report.json)
    51	# every weights/ file a line opens (A7-C3, statically): the gates' / probe's --ckpt-path (exp20), the model config's
