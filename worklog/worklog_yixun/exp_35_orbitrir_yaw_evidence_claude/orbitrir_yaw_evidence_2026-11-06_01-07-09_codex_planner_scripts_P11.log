    59	RUN_RE='^r2_preflight_[0-9]{8}T[0-9]{6}$'
    60	FAIL=0
    61	
    62	say() { printf '%s\n' "$*"; }
    63	need() {  # <what> <command...>: a hard check
    64	  local what="$1"; shift
    65	  if "$@" >/dev/null 2>&1; then say "CHECK OK: $what"; else say "CHECK FAILED: $what"; FAIL=1; fi
    66	}
    67	sha() { sha256sum < "$1" 2>/dev/null | cut -c1-64; }
    68	eq() { [ "$1" = "$2" ]; }
    69	py() { env -i "${LAUNCH_ENV[@]}" CUDA_VISIBLE_DEVICES= "$PY" -B "$@"; }   # every helper in the launch environment
    70	uuid_of() { case "$1" in GPU0) say "$GPU0" ;; GPU1) say "$GPU1" ;; *) say "" ;; esac; }
    71	field() { awk -v k="$2" '{for (i = 1; i < NF; i++) if ($i == k) {print $(i + 1); exit}}' <<<"$1"; }
    72	ok_capture() { [[ "$1" == "CAPTURE OK "* ]]; }
    73	script_check() { need "EXPECT_SCRIPT_SHA256 is set and equals this script's sha256 (${SELF_SHA})" eq "${EXPECT_SCRIPT_SHA256:-unset}" "$SELF_SHA"; }
    74	
    75	common_checks() {   # <orch> <run>: the preconditions both modes check right before they act
    76	  local head e rel want out rc
    77	  head="$(git -C "$W" rev-parse HEAD 2>/dev/null)"
    78	  need "HEAD ${head} = PIN2 ${PIN2}" eq "$head" "$PIN2"
    79	  need "the tracked tree is clean" eq "$(git -C "$W" status --porcelain --untracked-files=no 2>&1)" ""
    80	  for e in "${PINS[@]}"; do IFS='|' read -r rel want <<<"$e"; need "pin ${rel} ${want:0:8}..." eq "$(sha "$W/$rel")" "$want"; done
    81	  need "outputs_loc -> ${OUTPUTS_TARGET}" eq "$(readlink -f "$W/outputs_loc")" "$OUTPUTS_TARGET"
    82	  need "weights/ is this worktree's own directory, not a link (PIN2 tracks files under it)" test -d "$W/weights" -a ! -L "$W/weights"
    83	  for rel in "${WEIGHT_ASSETS[@]}"; do
    84	    need "asset ${rel} is the main checkout's file (${WEIGHTS_TARGET}/${rel#weights/}: same device + inode)" \
    85	      test -f "$W/$rel" -a "$W/$rel" -ef "$WEIGHTS_TARGET/${rel#weights/}"
    86	  done
    87	  need "AcousticRooms -> ${ROOMS_TARGET}" eq "$(readlink -f "$W/AcousticRooms")" "$ROOMS_TARGET"
    88	  for rel in "${ASSETS[@]}"; do need "asset ${rel}" test -f "$W/$rel"; done
    89	  for rel in "${ASSET_DIRS[@]}"; do need "asset ${rel}/" test -d "$W/$rel"; done
    90	  need "the flac interpreter and pytest's own __main__.py" test -x "$PY" -a -f "$PYTEST_MAIN"
    91	  need "the DINOv3 HF cache T's tests need (${DINO_CACHE})" test -d "$DINO_CACHE"
    92	  need "the run's r2_gates_${2} and r2_probe_BF_${2} do not exist" test ! -e "$EX/r2_gates_$2" -a ! -e "$EX/r2_probe_BF_$2"
    93	  out="$(py "$SUP" active --except-orch "$1")"; rc=$?; say "$out"
    94	  need "no exp22 run is active or unresolved" test "$rc" = 0
    95	}
    96	
    97	card_now() {   # <card> <sealed index or empty>: one observation under the card rule
    98	  local out rc
    99	  out="$(py "$COMMON" observe --card "$1")"; rc=$?; say "observation: $out"
   100	  need "$1 is free under its rule now" test "$rc" = 0

