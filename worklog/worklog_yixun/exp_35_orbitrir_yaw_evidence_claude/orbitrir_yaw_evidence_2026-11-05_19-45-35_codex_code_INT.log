   529	[ -z "$ABORT" ] || { echo "ABORTED: ${ABORT} - abort"; [ -z "$DRIFT" ] || exit 4; exit 2; }
   530	[ "${#FAILED[@]}" -eq 0 ] && [ "$COMPLETE" -eq "$N_SEL" ] && { echo "CAMPAIGN SELECTION COMPLETE"; exit 0; }
   531	echo "CAMPAIGN SELECTION INCOMPLETE - re-run to resume"
   532	exit 1

