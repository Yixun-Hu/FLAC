  1256	def finalize_bf_probe(path, log_path, *, campaign_digest, base_dir=REPO):
  1257	    """r3 §12 B3, the NON-logged step after the probe process exited and its log closed: verify the probe's own
  1258	    JSON + sidecar and the log's backend evidence, then write ``provenance.launch`` (backend, overlay +
  1259	    launcher sha256, the campaign digest, the log path + sha256), the JSON (atomically) and a fresh sidecar.
  1260	    Idempotent (Codex C3d HIGH 3, a supervisor restart after the finalization): an already-finalized JSON is
  1261	    accepted UNCHANGED only when it is the finalizer's own bytes, sealed by its sidecar, and its launch record is
  1262	    exactly the one this call would write (the CURRENT log sha256). ``ValueError`` (nothing written) on any refusal."""
  1263	    import hashlib
  1264	    raw_json, rep, reasons = _read_probe(path)
  1265	    if reasons:
  1266	        raise ValueError("; ".join(reasons))
  1267	    prov = rep.get("provenance")
  1268	    if rep.get("arm") != "BF" or not isinstance(prov, dict):
  1269	        raise ValueError(f"{path}: not a B-F probe awaiting finalization (another arm, or no provenance)")
  1270	    if not eval_FLAC._is_sha256_hex(campaign_digest):
  1271	        raise ValueError(f"campaign digest {campaign_digest!r} is not a sha256 digest")
  1272	    with open(os.path.join(base_dir, log_path), "rb") as f:
  1273	        raw = f.read()
  1274	    bad = backend_log_reasons(raw.decode(errors="replace"), PROBE_CONTRACT_BF["target"])
  1275	    if bad:
  1276	        raise ValueError(f"the probe log {log_path} lacks the backend evidence: " + "; ".join(bad))
  1277	    launch = {"attention_backend": NO_FLASH["backend"], "overlay_sha256": NO_FLASH["overlay_sha256"],
  1278	              "launcher_sha256": NO_FLASH["launcher_sha256"], "campaign_digest": campaign_digest,
  1279	              "log_path": log_path, "log_sha256": hashlib.sha256(raw).hexdigest()}
  1280	    if "launch" in prov:
  1281	        if not (isinstance(prov["launch"], dict) and list(prov["launch"].items()) == list(launch.items())
  1282	                and raw_json == (json.dumps(rep, indent=1) + "\n").encode()):
  1283	            raise ValueError(f"{path}: already finalized with another launch record (log, its sha256, the campaign "
  1284	                             "digest, the overlay or the launcher) or in other bytes")
  1285	        return path
  1286	    prov["launch"] = launch
  1287	    text = json.dumps(rep, indent=1) + "\n"
  1288	    for target, body in ((path, text), (path + ".sha256",
  1289	                                        f"{hashlib.sha256(text.encode()).hexdigest()}  {os.path.basename(path)}\n")):
  1290	        tmp = f"{target}.tmp-{os.getpid()}"
  1291	        with open(tmp, "w") as f:
  1292	            f.write(body)
  1293	        os.replace(tmp, target)
  1294	    return path
