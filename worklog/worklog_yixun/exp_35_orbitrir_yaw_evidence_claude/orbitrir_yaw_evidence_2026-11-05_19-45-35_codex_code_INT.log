  1209	def _bf_launch_reasons(launch, campaign_digest, base_dir):
  1210	    import hashlib
  1211	    out = []
  1212	    if not isinstance(launch, dict) or list(launch) != ["attention_backend", "overlay_sha256", "launcher_sha256",
  1213	                                                        "campaign_digest", "log_path", "log_sha256"]:
  1214	        return [f"probe provenance.launch {launch!r:.120} is missing or malformed (finalization not run?)"]
  1215	    for key, want in (("attention_backend", NO_FLASH["backend"]), ("overlay_sha256", NO_FLASH["overlay_sha256"]),
