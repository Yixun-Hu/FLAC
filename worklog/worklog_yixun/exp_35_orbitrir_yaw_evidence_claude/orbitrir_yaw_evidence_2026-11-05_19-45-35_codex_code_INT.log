  2070	    mix = "; the P1 pin mix is justified by E1 (the CTL cells are exactly equal at d6ca307a and this pin)"
  2071	    return _pointed(pts, f"E2 FAIL: s42 = the one-pin SDPA cell {one}, s43-46 = the E2-FAIL cells (this pin)"
