  1895	def tier2_c4(cells, control):
  1896	    """§4 Tier 2-C4 -- OrbitRIR's invariance claim: each (K1, K8) x (90, 180, 270) pair at seed 42 against BF-pin T
  1897	    s42 with equal input_hash, p99(relL2) <= 3 x the matched B-F control p99 (d128 / d256 / d384) AND <= 1e-2,
  1898	    AND the pooled p99 of the six pairs' items <= 3 x the pooled control p99 (a control p99 of 0 demands a p99 of
  1899	    0, as registered for exp_25); alarm: any item > 0.1; T-dup exact (max 0, dump sha256 equal). The 45-degree and
  1900	    random-yaw distances are reported, outside the claim, with no verdict."""
  1901	    import numpy as np
  1902	    from src.tools import depth_canon_stats as stats
  1903	    if control is None:
  1904	        return {"pass": None, "claim": "NOT COMPUTABLE",
  1905	                "note": "no valid registered B-F composition control: Tier 2-C4 not computable"}
  1906	    idx, pairs, pooled, alarm = _bf_index(cells), [], [], {}
  1907	    for k in (1, 8):
  1908	        ref = idx.get(("BF-pin", "T", k, 42, 0))
  1909	        for deg in (90, 180, 270):
  1910	            e, key = idx.get(("BF-pin", "C4", k, 42, deg)), BF_CONTROL_KEYS[deg]
  1911	            p = {"cell": e["row"]["cell"] if e else None, "K": k, "deg": deg, "control_key": key,
  1912	                 "control_p99": control[key]}
  1913	            if not (e and ref and _same_items(e, ref) and e["dump"] and ref["dump"]):
  1914	                pairs.append(dict(p, computable=False, pass_matched=False, pass_cap=False))
  1915	                continue
  1916	            s2, sinf, l2 = _distance(e, ref)
  1917	            pooled.append(l2)
  1918	            if s2["max"] > TIER2_ALARM:
  1919	                alarm[p["cell"]] = [t[1] for t, v in zip(ref["stream"]["input_tuples"], l2) if v > TIER2_ALARM]
  1920	            pairs.append(dict(p, computable=True, relL2=s2, relLinf=sinf, pass_matched=s2["p99"] <= TIER2_FACTOR * control[key],
  1921	                              pass_cap=s2["p99"] <= TIER2_CAP))
  1922	    pool = stats.paired_summary(np.concatenate(pooled)) if len(pooled) == 6 else None
  1923	    pool_ok = bool(pool and pool["p99"] <= TIER2_FACTOR * control["pooled"])   # no pooled cap (Codex C3a HIGH 2)
  1924	    dup, descriptive = [], {"45": [], "R": []}
  1925	    for k in (1, 8):
  1926	        e, ref = idx.get(("BF-dup", "T", k, 42, 0)), idx.get(("BF-pin", "T", k, 42, 0))
  1927	        ok = bool(e and ref and _same_items(e, ref) and e["dump"] and ref["dump"])
  1928	        mx = float(_distance(e, ref)[2].max()) if ok else None
  1929	        same = bool(ok and e["receipt"]["dump_evidence"]["manifest"]["sha256"]
  1930	                    == ref["receipt"]["dump_evidence"]["manifest"]["sha256"])
  1931	        dup.append({"cell": e["row"]["cell"] if e else None, "K": k, "relL2_max": mx, "dump_sha_equal": same,
  1932	                    "pass": bool(ok and mx == 0 and same)})
  1933	        for kind, key, seed in [("45", ("BF-pin", "C4", k, 42, 45), 42)] + [("R", ("BF-pin", "R", k, s, None), s)
  1934	                                                                           for s in SEEDS]:
  1935	            e, ref = idx.get(key), idx.get(("BF-pin", "T", k, seed, 0))
  1936	            if e and ref and _same_items(e, ref) and e["dump"] and ref["dump"]:
  1937	                s2, sinf, _ = _distance(e, ref)
  1938	                descriptive[kind].append({"cell": e["row"]["cell"], "K": k, "seed": seed, "relL2": s2, "relLinf": sinf})
  1939	    verdict = len(pairs) == 6 and all(p["computable"] and p["pass_matched"] and p["pass_cap"] for p in pairs) and pool_ok
  1940	    return {"pass": verdict, "claim": "SUSPENDED" if alarm else "PASS" if verdict else "FAIL",   # Codex C3a HIGH 3
  1941	            "pairs": pairs, "pooled": {"relL2": pool, "control_p99": control["pooled"], "pass": pool_ok},
  1942	            "determinism": {"pass": all(d["pass"] for d in dup), "pairs": dup},
  1943	            "alarm": {"suspended": bool(alarm), "items": alarm,
  1944	                      "note": "the C4 invariance claim is suspended pending item triage" if alarm else "none"},
  1945	            "descriptive": descriptive,
  1946	            "rule": f"every C4 pair p99(relL2) <= {TIER2_FACTOR:g} x its matched B-F control p99 and <= {TIER2_CAP:g}, "
  1947	                    f"the pooled C4 p99 <= {TIER2_FACTOR:g} x the pooled control p99; alarm > {TIER2_ALARM:g}; "
  1948	                    "T-dup max relL2 == 0 and dump sha256 equal; 45-degree / random-yaw: descriptive"}
