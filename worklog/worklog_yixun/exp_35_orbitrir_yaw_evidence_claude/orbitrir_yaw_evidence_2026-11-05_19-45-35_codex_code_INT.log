  1302	def _paired(a, b, chunk=512):
  1303	    """Per-item relL2 / relLinf of ``a`` against the reference ``b``, chunked (memory-bounded)."""
  1304	    import numpy as np
  1305	    from src.tools import depth_canon_stats as stats
  1306	    l2, linf = [], []
  1307	    for start in range(0, b.shape[0], chunk):
  1308	        l2.append(stats.rel_l2(a[start:start + chunk], b[start:start + chunk]))
  1309	        linf.append(stats.rel_linf(a[start:start + chunk], b[start:start + chunk]))
  1310	    return np.concatenate(l2), np.concatenate(linf)
