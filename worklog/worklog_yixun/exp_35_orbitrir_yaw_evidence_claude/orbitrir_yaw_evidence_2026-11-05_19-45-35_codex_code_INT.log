   471	      [ -z "$LANE_WHY" ] || echo "  GPU ${lane}: ${LANE_WHY}"
   472	      LANE="$lane"; NEXT=$(( (NEXT + k + 1) % ${#LANES[@]} )); return 0
   473	    fi
   474	    if [ "${GPU_NOTE[$lane]:-}" != "${READY}#${POLLS}" ]; then   # once per waiting cell / poll
   475	      echo "  GPU ${lane}: ${LANE_WHY} - waiting (nothing is ever signalled)"
   476	      GPU_NOTE[$lane]="${READY}#${POLLS}"
   477	    fi
   478	  done
   479	  return 1
   480	}
   481	gpu_wait() {   # one counted poll of the GPU gate; sets ABORT when the budget is spent
   482	  POLLS=$((POLLS + 1))
   483	  if [ "$GPU_MAX_POLLS" -gt 0 ] && [ "$POLLS" -ge "$GPU_MAX_POLLS" ]; then
   484	    ABORT="GPU GATE: no usable lane (>= ${MIN_GPU_FREE_MIB} MiB free, unoccupied) after ${POLLS} poll(s)"; return
   485	  fi
   486	  sleep "$GPU_POLL_SECONDS"
   487	}
