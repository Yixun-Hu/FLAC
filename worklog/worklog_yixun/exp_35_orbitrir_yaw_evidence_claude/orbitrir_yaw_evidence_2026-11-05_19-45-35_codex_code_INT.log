   945	    def verify(self, chunk):
   946	        """The cell's receipt (located by the collector's own cell_paths) and ``--verify-cell`` under its digest."""
   947	        C = collector_module()
   948	        m = C.load_cells(self.cells)
   949	        row = next(r for r in m["cells"] if r["cell"] == chunk["cell"])
   950	        target, _ = C.expected_checkpoint(row, m, None)
   951	        p = C.cell_paths(row, os.path.join(m["farm_root"], row["arm"], os.path.basename(target)), m["dump_root"])
   952	        try:
   953	            with open(os.path.join(self.repo, p.receipt), "rb") as f:
   954	                raw = f.read()
   955	            digest = json.loads(raw)["campaign_digest"]
   956	        except (OSError, ValueError, KeyError, TypeError) as err:
   957	            return False, {"reasons": [f"the receipt {p.receipt}: {err}"]}
   958	        if not _hex(digest):
   959	            return False, {"reasons": [f"the receipt {p.receipt} carries no campaign digest"]}
   960	        rc, out = self._cli("--verify-cell", p.stem, "--pin", self.cfg["h35"], "--campaign-digest", digest)
   961	        if rc != 0:
   962	            return False, {"reasons": [out[-1500:]]}
   963	        return True, {"receipt_sha256": hashlib.sha256(raw).hexdigest(), "campaign_digest": digest}
