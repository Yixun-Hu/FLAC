  1139	    if out:
  1140	        return out
  1141	    rows = lambda p, st: [res[p][k]["cond"]["all"] if st == "cond" else res[p][k][st] for k in keys]  # noqa: E731
  1142	    pooled = {p: {st: {m: stats.paired_summary([v for r in rows(p, st) for v in r[m]]) for m in ("relL2", "relLinf")}
  1143	                  for st in P["stages"]} for p in protos}
