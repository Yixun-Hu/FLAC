  1228	def _read_probe(path):
  1229	    """``(raw bytes, report, reasons)``: the probe JSON and its sha256 sidecar (as write_report wrote them)."""
  1230	    import hashlib
  1231	    try:
  1232	        with open(path, "rb") as f:
  1233	            raw = f.read()
  1234	        with open(path + ".sha256") as f:
  1235	            side = f.read()
  1236	        rep = json.loads(raw)
  1237	    except (OSError, ValueError) as err:
  1238	        return None, None, [f"B-F probe {path} unreadable ({err})"]
  1239	    ok = side == f"{hashlib.sha256(raw).hexdigest()}  {os.path.basename(path)}\n" and isinstance(rep, dict)
  1240	    return raw, rep, [] if ok else [f"the B-F probe's sha256 sidecar does not match {path} (or it is no object)"]
