   601	    if is_exp35(row) != row["cell"].startswith("exp35_"):
   602	        return [f"{row['cell']!r}: the name and the block {row['block']!r} name different campaigns"]
   603	    try:
   604	        target, sha = expected_checkpoint(row, manifest, canon_index)
   605	    except KeyError as err:
   606	        return [str(err).strip("'\"")]
