    66	def planning_minutes(chunk):
    67	    if chunk["kind"] == "probe":
    68	        return PLAN_MIN["probe"]
    69	    m = re.match(r"exp35_(P1|BF)_\w+_K(\d)_s", chunk["cell"])
    70	    return PLAN_MIN[m[1]][int(m[2])]
