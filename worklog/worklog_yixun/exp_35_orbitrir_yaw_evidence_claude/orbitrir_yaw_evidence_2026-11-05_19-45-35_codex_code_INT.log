   451	  if [ -n "$occ" ]; then
   452	    [ "$ALLOW_SHARED_GPU" = 1 ] || { LANE_WHY="occupied by foreign compute process(es):${occ}"; return 1; }
   453	    LANE_WHY="shared with${occ} (ALLOW_SHARED_GPU=1)"
   454	  fi
   455	  if [ -n "$COTENANTS" ]; then   # exp_35 §12 B1.1: the foreign set EQUALS the approved identity tuple
   456	    out="$("$PY" "$IDENTITY" --check --approved "$COTENANTS" --approved-sha256 "$COTENANTS_SHA" --gpu-uuid "$want" \
   457	      --pids "$pids" 2>&1)" \
