   127	def _hex(v):
   128	    return isinstance(v, str) and HEX64.fullmatch(v) is not None
   129	
   130	
   131	def _num(v):
   132	    return isinstance(v, (int, float)) and not isinstance(v, bool) and v >= 0
   133	
   134	
   135	def _text(v):
   136	    return isinstance(v, str) and v != ""
