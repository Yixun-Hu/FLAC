   422	def backend_log_reasons(text, target=NO_FLASH["target"]):
   423	    """The log of a launcher run proves the SDPA backend: transformer.py printed the overlay's ImportError
   424	    and its fallback line exactly once, back to back; the launcher then printed ONE sentinel with the
   425	    backend, the pinned overlay + launcher sha256 and ``target``; no line reports a MISSING flash_attn
   426	    (an import that never met the overlay)."""
   427	    lines, nf, out = text.splitlines(), NO_FLASH, []
   428	    if any(nf["missing_line"] in ln for ln in lines):
   429	        out.append(f"the log reports {nf['missing_line']!r}: an import ran without the overlay")
   430	    ov = [i for i, ln in enumerate(lines) if ln == nf["overlay_line"]]
   431	    fb = [i for i, ln in enumerate(lines) if ln == nf["fallback_line"]]
   432	    if not (len(ov) == len(fb) == 1 and fb[0] == ov[0] + 1):
   433	        out.append(f"the log holds {len(ov)} overlay ImportError line(s) and {len(fb)} SDPA fallback line(s), "
   434	                   "not one back-to-back pair")
   435	    sent = [i for i, ln in enumerate(lines) if ln.startswith(nf["sentinel"] + " ")]
   436	    if len(sent) != 1:
   437	        return out + [f"the log holds {len(sent)} no-flash launcher sentinel line(s), not exactly one"]
   438	    got = dict(tok.partition("=")[::2] for tok in lines[sent[0]].split()[1:])
   439	    want = {"attention_backend": nf["backend"], "overlay_sha256": nf["overlay_sha256"],
   440	            "launcher_sha256": nf["launcher_sha256"], "target": target}
   441	    if got != want:
   442	        out.append(f"the launcher sentinel {got} != {want}")
   443	    if fb and sent[0] < fb[-1]:
   444	        out.append("the launcher sentinel precedes the SDPA fallback line")
   445	    return out
