   351	def read_reservation(dirpath, uuid):
   352	    """The reservation file of ``uuid`` parsed: None when absent; ``ValueError`` when unreadable or malformed."""
   353	    try:
   354	        with open(reservation_path(dirpath, uuid)) as f:
   355	            doc = json.load(f)
   356	    except FileNotFoundError:
   357	        return None
   358	    except (OSError, ValueError) as err:
   359	        raise ValueError(f"the reservation file of {uuid} is unreadable or malformed ({err})") from err
   360	    if not isinstance(doc, dict) or not isinstance(doc.get("holder"), str):
   361	        raise ValueError(f"the reservation file of {uuid} is not a reservation ({doc!r:.120})")
   362	    return doc
   363	
   364	
   365	def ours_reasons(doc, uuid, h35):
   366	    """[] iff ``doc`` is exactly THIS campaign's exp_35 reservation of ``uuid`` (Codex C3b HIGH 2)."""
   367	    ok = list(doc) == list(RES_KEYS) and doc["holder"] == "exp35" and doc["h35"] == h35 and doc["gpu_uuid"] == uuid \
   368	        and doc["branch"] == BRANCH and type(doc["epoch"]) is int and doc["epoch"] >= 1 and _num(doc["created"])
   369	    return [] if ok else [f"the exp_35 reservation of {uuid} is not this campaign's: {doc!r:.200}"]
   370	
   371	
   372	def held_by_other(dirpath, uuid):
   373	    """True when another holder -- or an unreadable / malformed file -- holds ``uuid``: never taken as free."""
   374	    try:
   375	        doc = read_reservation(dirpath, uuid)
   376	    except ValueError:
   377	        return True
   378	    return doc is not None and doc["holder"] != "exp35"
