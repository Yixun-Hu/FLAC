   219	    --gpu-uuid "$GPU1" --pids "$(apps | awk -F, -v u="$GPU1" '$2 == u {print $1}' | paste -sd, -)"
   220	  dry_run "$tuple" "$tsha"
   221	  [ "$FAIL" = 0 ] || { say "LAUNCH REFUSED: at least one CHECK failed (see above)"; return 1; }
   222	  suplog="$RUNX/exp35_supervisor_${TS}.log"
   223	  ( set -o noclobber; : > "$suplog" ) || { say "LAUNCH REFUSED: ${suplog} exists"; return 1; }
   224	  args_for "$tuple" "$tsha"
   225	  say "starting: cd ${RUN} && env -i ${LAUNCH_ENV[*]} setsid nohup ${PY} ${SUP} ${SUP_ARGS[*]} >> ${suplog} 2>&1 < /dev/null &"
   226	  ( cd "$RUN" && exec env -i "${LAUNCH_ENV[@]}" /usr/bin/setsid /usr/bin/nohup "$PY" "$SUP" "${SUP_ARGS[@]}" \
   227	      >> "$suplog" 2>&1 < /dev/null ) &
   228	  pid=$!
   229	  sleep 20
   230	  local found; found="$(procs_named exp35_supervisor.py)"
   231	  say "background pid ${pid}; exp35_supervisor.py processes now: ${found:-none}"
   232	  [ "$found" = "$pid" ] || { say "LAUNCH NOT CONFIRMED: the supervisor is not exactly pid ${pid} (inspect; never signalled here)"; cat "$suplog"; return 1; }
   233	  say "supervisor pid ${pid}: $(tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null)"
   234	  say "  cwd $(readlink /proc/$pid/cwd 2>/dev/null); start time $(awk '{print $22}' /proc/$pid/stat 2>/dev/null); sid $(ps -o sid= -p "$pid" 2>/dev/null)"
   235	  say "  environment: $(tr '\0' ' ' < /proc/$pid/environ 2>/dev/null)"
   236	  say "--- the supervisor log so far (${suplog}) ---"; cat "$suplog"; say "---"
   237	  if [ -d "/proc/$pid" ] && grep -q 'supervisor started (a new state)' "$suplog" && ! grep -q 'REFUSED\|STOP LATCH' "$suplog" \
   238	     && [ -f "$STATE" ]; then
   239	    say "LAUNCHED: supervisor pid ${pid}, log ${suplog}, state ${STATE}"; return 0
   240	  fi
   241	  say "LAUNCH NOT CONFIRMED: inspect ${suplog} (the supervisor is never signalled by this script)"; return 1
   242	}
