   404	def gpu_map(text):
   405	    """``{index: uuid}`` from ``nvidia-smi --query-gpu=index,uuid --format=csv,noheader``; ValueError when malformed."""
   406	    out = {}
   407	    for line in [ln for ln in text.splitlines() if ln.strip()]:
   408	        m = re.fullmatch(r"\s*(\d+),\s*(GPU-[0-9A-Za-z-]+)\s*", line)
   409	        if not m or int(m[1]) in out or m[2] in out.values():
   410	            raise ValueError(f"malformed or duplicate nvidia-smi index,uuid row {line!r}")
   411	        out[int(m[1])] = m[2]
   412	    if not out:
   413	        raise ValueError("nvidia-smi lists no GPU")
   414	    return out
   415	
   416	
   417	def compute_apps(text):
   418	    """``[(pid, uuid)]`` from ``nvidia-smi --query-compute-apps=pid,gpu_uuid --format=csv,noheader``."""
   419	    out = []
   420	    for line in [ln for ln in text.splitlines() if ln.strip()]:
   421	        m = re.fullmatch(r"\s*(\d+),\s*(GPU-[0-9A-Za-z-]+)\s*", line)
   422	        if not m:
   423	            raise ValueError(f"malformed nvidia-smi compute-app row {line!r}")
   424	        out.append((int(m[1]), m[2]))
   425	    return out
   426	
   427	
   428	def descendants(pid, proc="/proc"):
   429	    """``pid`` and every process below it (by the ppid of ``/proc/<p>/stat``): our runner's own subtree."""
   430	    parent = {}
   431	    for name in os.listdir(proc):
   432	        if name.isdigit():
   433	            try:
   434	                with open(os.path.join(proc, name, "stat")) as f:
   435	                    text = f.read()
   436	                parent[int(name)] = int(text[text.rindex(")") + 2:].split()[1])
   437	            except (OSError, ValueError, IndexError):
   438	                continue
   439	    out, todo = set(), [pid] if pid in parent else []
   440	    while todo:
   441	        p = todo.pop()
   442	        out.add(p)
   443	        todo += [c for c, pp in parent.items() if pp == p and c not in out]
   444	    return out
