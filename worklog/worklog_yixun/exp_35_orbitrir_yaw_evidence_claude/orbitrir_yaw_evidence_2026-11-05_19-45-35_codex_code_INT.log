  1844	def exp35_e2(*, pin, manifest, base_dir=REPO, csv_path=None, farm_root=None, dump_root=None):
  1845	    """§4 E2 (decides only the 45-degree source): ``exp35_BF_T_S40000_K{1,8}_s42`` vs the sha-pinned A6 CSV row
  1846	    (method ``FA B-F@40k``, angle 0, seed 42) -- PASS iff all 14 |differences| are within E2_TOLERANCE."""
  1847	    import csv
  1848	    import hashlib
  1849	    path = csv_path or A6_CSV
  1850	    res = {"status": "REFUSED", "pass": None, "csv": path, "csv_sha256": None, "rows": [], "rows45": [], "reasons": [],
  1851	           "rule": "|new - A6 CSV| <= " + ", ".join(f"{k} {v:g}" for k, v in E2_TOLERANCE.items()) + " (all 14)"}
  1852	    try:
  1853	        with open(path, "rb") as f:
  1854	            raw = f.read()
  1855	    except OSError as err:
  1856	        return dict(res, reasons=[f"the A6 CSV {path} is unreadable ({err})"])
  1857	    res["csv_sha256"] = hashlib.sha256(raw).hexdigest()
  1858	    if res["csv_sha256"] != A6_CSV_SHA256:
  1859	        return dict(res, reasons=[f"the A6 CSV hashes to {res['csv_sha256']}, not the pinned {A6_CSV_SHA256}"])
  1860	    table = list(csv.DictReader(raw.decode().splitlines()))
  1861	    for k in (1, 8):
  1862	        hits = [r for r in table if (r["method"], r["K"], r["angle_deg"], r["seed"]) == ("FA B-F@40k", str(k), "0", "42")]
  1863	        _, _, new, why = _verified_cell(f"exp35_BF_T_S40000_K{k}_s42", manifest=manifest, pin=pin, base_dir=base_dir,
  1864	                                        farm_root=farm_root, dump_root=dump_root)
  1865	        res["reasons"] += why + ([] if len(hits) == 1 else [f"the A6 CSV holds {len(hits)} FA B-F@40k K{k} theta 0 s42 rows"])
  1866	        if why or len(hits) != 1:
  1867	            continue
  1868	        for key, tol in E2_TOLERANCE.items():
  1869	            a, b = float(new["metrics"]["metrics"][key]), float(hits[0][key])
  1870	            res["rows"].append({"K": k, "metric": key, "new": a, "a6": b, "abs_diff": abs(a - b), "tolerance": tol,
  1871	                                "pass": abs(a - b) <= tol})
  1872	    if res["reasons"]:
