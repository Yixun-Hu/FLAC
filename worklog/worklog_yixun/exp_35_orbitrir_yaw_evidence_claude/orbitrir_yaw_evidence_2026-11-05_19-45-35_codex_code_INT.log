   556	def load_canon_index(path, run_ns):
   557	    """``{step: (path, sha256)}`` from the launcher's FULL checkpoint manifest (``sha256sum``
   558	    lines). Every line must be one checkpoint of the CANON run namespace; any other line,
   559	    a malformed digest or a duplicate step is a ``ValueError`` (fail-closed)."""
   560	    pat = re.compile(re.escape(run_ns.rstrip("/")) + r"/checkpoints/epoch=\d+-step=(\d+)\.ckpt")
   561	    index = {}
   562	    with open(path) as f:
   563	        for line in f.read().splitlines():
   564	            sha, sep, ckpt = line.partition("  ")
   565	            m = pat.fullmatch(ckpt) if sep and eval_FLAC._is_sha256_hex(sha) else None
   566	            if m is None:
   567	                raise ValueError(f"{path}: {line!r} is not a checkpoint of the CANON run {run_ns}")
   568	            if int(m.group(1)) in index:
   569	                raise ValueError(f"{path}: duplicate step {m.group(1)}")
   570	            index[int(m.group(1))] = (ckpt, sha)
   571	    return index
