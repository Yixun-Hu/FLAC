  1160	def probe_bf_reasons(rep, *, pin, campaign_digest, manifest, bf_receipts=None, base_dir=REPO):
  1161	    """The B-F composition control of THIS campaign: registered, no deviation, arm BF, the B-F@40k bytes
  1162	    (digest + the registered loaded length; ``bf_receipts``: those of the verified B-F cells, when given),
  1163	    the pin on a clean tree, the registered arguments and frame-average recipe, the campaign's configs and
  1164	    split, an EMA load WITHOUT canonicalization, the quarter-turn offsets, the stream census, numbers
  1165	    consistent with the results, and the launch provenance: the pinned overlay + launcher, the campaign
  1166	    digest, and the closed log (its sha256 re-checked) carrying the backend evidence for the probe target."""
