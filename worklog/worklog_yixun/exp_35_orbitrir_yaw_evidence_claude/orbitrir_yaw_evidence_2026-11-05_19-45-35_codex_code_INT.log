   576	    hits = sorted(glob.glob(os.path.join(expdir, "depth_canon_*_exp25_CANON_checkpoints.sha256")))
   577	    if len(hits) != 1:
   578	        raise FileNotFoundError(f"expected exactly one depth_canon_*_exp25_CANON_checkpoints.sha256 in "
   579	                                f"{expdir}, found {len(hits)}: pass --canon-ckpt-manifest")
   580	    return hits[0]
