   835	    def run(self):
--- runner refs ---
   120	flock -n 9 || die "another evaluation campaign holds ${LOCKDIR}/.depth_canon_eval.lock - abort"
   121	LOG="$LOGDIR/depth_canon_${TS}_eval_run.log"
   122	exec > >(tee -a "$LOG") 2>&1
   123	echo "=== exp_25 depth_canon eval campaign -- ${TS} -- HEAD $(git rev-parse HEAD) -- dry_run=${DRY_RUN} -- harness=${HARNESS_FLAG} ==="
   124	[ -x "$PY" ] || die "the flac interpreter ${PY} is missing - abort"
   125	for tool in jq flock findmnt sha256sum; do command -v "$tool" >/dev/null || die "${tool} is required - abort"; done
   126	[ -f "$CELLS" ] || die "the cells manifest ${CELLS} is missing - abort"
   127	
   128	# --- evaluator pin: HEAD + a committed evaluator / data / config / kit tree ---------- #
   129	[[ "$EXPECT_HEAD" =~ ^[0-9a-f]{40}$ ]] || die "EXPECT_HEAD must be the full 40-hex evaluator pin (got '${EXPECT_HEAD}') - abort"
   130	HEAD_SHA="$(git rev-parse HEAD)"
   131	[ "$HEAD_SHA" = "$EXPECT_HEAD" ] || die "HEAD PIN FAILED: HEAD ${HEAD_SHA} != EXPECT_HEAD ${EXPECT_HEAD} - abort"
   132	SEL_ARGS=(); [ -n "$BLOCKS" ] && SEL_ARGS+=(--blocks "$BLOCKS"); [ -n "$ONLY" ] && SEL_ARGS+=(--only "$ONLY")
   133	[ -n "$LIMIT" ] && SEL_ARGS+=(--limit "$LIMIT")
   134	N_NOFLASH="$("$PY" "$COLLECT" --count-no-flash --cells "$CELLS" "${SEL_ARGS[@]}" 2>/dev/null | tail -n 1)"
   135	[[ "$N_NOFLASH" =~ ^[0-9]+$ ]] || die "SELECTION REFUSED: the exp_35 cells of the selection cannot be counted (${N_NOFLASH}) - abort"
   136	# Codex C3a HIGH 1: the model configs of the relevant tree follow the selection -- an exp_25-only selection takes the
   137	# exp_25 arms' configs (the d6ca307a set), any exp_35 selection every arm's (ONE digest across its single-cell chunks)
   138	if [ "$N_NOFLASH" -gt 0 ]; then ARMS_JQ='.arms[].model_config'
   139	else ARMS_JQ='. as $m | [.cells[] | select(.cell | startswith("exp35_") | not) | .arm] | unique[] | $m.arms[.].model_config'; fi
   140	mapfile -t MODEL_CFGS < <(jq -r "$ARMS_JQ" "$CELLS")
   141	RELEVANT=(eval_FLAC.py src ':(exclude)src/tests' data/AR "${MODEL_CFGS[@]}" "$SELF" "$COLLECT" "$MAKE_CELLS"
   142	          "$EXPDIR/depth_canon_cells.json" "$EXPDIR/depth_canon_audit_gate.py")
   143	[ "$N_NOFLASH" -gt 0 ] && RELEVANT+=("$NO_FLASH_DIR" "$IDENTITY")   # exp_35 (Codex C2 HIGH 2): only then
   144	tree_dirty() { git status --porcelain --untracked-files=all -- "${RELEVANT[@]}"; }
   145	tree_digest() {   # sha256 of the sorted sha256sum lines of every tracked + untracked (unignored) relevant file
   146	  local lines
   147	  lines="$(git ls-files -z --cached --others --exclude-standard -- "${RELEVANT[@]}" | LC_ALL=C sort -zu \
   148	    | xargs -0r sha256sum --)" && [ -n "$lines" ] || return 1
   149	  printf '%s\n' "$lines" | sha256sum | awk '{print $1}'
   150	}
   151	DIRTY="$(tree_dirty)"
   152	[ -z "$DIRTY" ] || { echo "EVALUATOR TREE NOT COMMITTED at HEAD (every cell must run the pinned code):"; echo "$DIRTY"; exit 2; }
   153	CAMPAIGN_DIGEST="$(tree_digest)" || die "TREE DIGEST FAILED: cannot hash the relevant tree - abort"
   154	echo "evaluator pin OK: ${HEAD_SHA}; evaluator tree digest ${CAMPAIGN_DIGEST}"
   155	if [ "$N_NOFLASH" -gt 0 ]; then
   156	  for pin in "$NO_FLASH_OVERLAY $NO_FLASH_OVERLAY_SHA256" "$NO_FLASH_LAUNCHER $NO_FLASH_LAUNCHER_SHA256"; do
   157	    read -r path sha <<<"$pin"
