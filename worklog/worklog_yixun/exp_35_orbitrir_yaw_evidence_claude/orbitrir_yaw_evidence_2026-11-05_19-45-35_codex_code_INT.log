    84	def _pin_reasons(h35, *shas):
    85	    """Codex C3c BLOCKING 1: no state is created or loaded against a missing or malformed pin."""
    86	    ok = isinstance(h35, str) and re.fullmatch(r"[0-9a-f]{40}", h35) and all(_hex(v) for v in shas)
    87	    return [] if ok else [f"a missing or malformed pin among H35 {h35!r} and the sha256 values {shas!r}"]
