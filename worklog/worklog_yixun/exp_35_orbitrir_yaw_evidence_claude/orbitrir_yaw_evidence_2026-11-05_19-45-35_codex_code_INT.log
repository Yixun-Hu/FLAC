  1951	def tier3_bf(cells, exp25):
  1952	    """§4 Tier 3 for B-F (the registered rule, item-weighted, 28 checks with FD): pass_c4 = Delta_C4(BF) <= 0.1 x
  1953	    Delta_C4(P1-pin) -- the P1-pin value read at FULL precision from the hash-pinned exp_25 JSON (§11 N7) -- and
  1954	    pass_r = |Delta_R(BF)| <= sd(m_Z BF); the B-F estimators are depth_canon's own over the BF-pin cells only."""
  1955	    idx = {("BF", "R" if e["row"]["rotate_mode"] == "random" else "F", e["row"]["K"], e["row"]["seed"],
  1956	            e["row"]["step"], e["row"]["rotate_deg"]): e
  1957	           for e in cells.values() if e["valid"] and e["row"]["block"] == "BF-pin"}
  1958	    arms = {"BF": {k: {agg: {key: _arm_tier3(idx, "BF", k, agg, key) for key in TIER3_KEYS} for agg in AGGS}
  1959	                   for k in (1, 8)}}
  1960	    checks = []
  1961	    for k in (1, 8):
  1962	        for key in TIER3_KEYS:
  1963	            b, p1 = arms["BF"][k]["item"][key], exp25["tier3"]["arms"]["P1"][str(k)]["item"][key]["delta_c4"]
  1964	            known = None not in (b["delta_c4"], p1, b["delta_r"], b["sd_z"])
  1965	            checks.append({"K": k, "metric": key, "computable": known, "p1_delta_c4": p1,
  1966	                           "pass_c4": known and b["delta_c4"] <= TIER3_FRACTION * p1,
  1967	                           "pass_r": known and abs(b["delta_r"]) <= b["sd_z"]})
  1968	    verdict = None if not all(c["computable"] for c in checks) else all(c["pass_c4"] and c["pass_r"] for c in checks)
