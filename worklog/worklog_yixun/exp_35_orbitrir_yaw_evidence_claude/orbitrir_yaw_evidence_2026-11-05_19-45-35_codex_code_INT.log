   608	        return [f"{stem!r}: checkpoint {ckpt_name!r} is not this cell's {os.path.basename(target)!r}"]
   609	    link = os.path.join(farm_root, row["arm"], os.path.basename(target))
   610	    paths = cell_paths(row, link, dump_root)
   611	    at = lambda p: os.path.join(base_dir, p)  # noqa: E731 -- an absolute p stays absolute
   612	    docs, reasons = {}, []
   613	    if dump_check not in ("full", "manifest", "receipt"):
   614	        raise ValueError(f"dump_check must be 'full', 'manifest' or 'receipt', got {dump_check!r}")
