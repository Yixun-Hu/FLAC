   545	def expected_checkpoint(row, manifest, canon_index):
   546	    """``(target path, sha256)`` the cell must have been evaluated on."""
   547	    ck = manifest["arms"][row["arm"]]["ckpt"]
   548	    if ck["kind"] == "endpoint":
   549	        return ck["path"], ck["sha256"]
   550	    if not canon_index or row["step"] not in canon_index:
   551	        raise KeyError(f"no CANON checkpoint index entry for step {row['step']} (the launcher's "
   552	                       "depth_canon_*_exp25_CANON_checkpoints.sha256 is required for CANON cells)")
   553	    return canon_index[row["step"]]
