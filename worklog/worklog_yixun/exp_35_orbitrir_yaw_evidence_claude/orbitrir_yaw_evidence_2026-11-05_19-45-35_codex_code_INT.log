   597	    rows = [c for c in manifest["cells"] if c["metrics_suffix"] == suffix]
   598	    if len(rows) != 1 or not ckpt_name:
   599	        return [f"{stem!r} names no registered cell of the manifest ({len(rows)} suffix matches)"]
