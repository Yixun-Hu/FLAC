  1130	    if not (isinstance(res, dict) and list(res) == protos and isinstance(det, dict) and list(det) == protos
  1131	            and all(isinstance(res[p], dict) and list(res[p]) == keys and isinstance(res[p][k], dict)
  1132	                    for p in protos for k in keys)):
  1133	        return ["probe results / determinism are not protocols x quarter turns x stages"]
  1134	    ids = (res[protos[0]][keys[0]].get("cond") or {}).get("ids")
  1135	    if not (isinstance(ids, list) and ids and all(isinstance(i, str) for i in ids) and ids == sorted(set(ids))):
  1136	        return [f"probe conditioner ids {ids!r} are not a sorted, non-empty list of names"]
  1137	    out = [x for p in protos for k in keys for x in _bf_block_reasons(res[p][k], f"results.{p}.{k}", P, ids)]
