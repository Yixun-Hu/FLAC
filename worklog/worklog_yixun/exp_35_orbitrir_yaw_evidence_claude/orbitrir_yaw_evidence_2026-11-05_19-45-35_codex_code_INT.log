    92	        raise ValueError(_pin_reasons(h35, cells_sha256, supervisor_sha256, approved_sha256)[0])
    93	    return {"schema_version": STATE_SCHEMA, "campaign": "exp35", "h35": h35, "cells_sha256": cells_sha256,
    94	            "supervisor_sha256": supervisor_sha256, "approved_sha256": approved_sha256, "baseline": None,
    95	            "his_log_anchor": None, "lane": None, "reservation": None,
    96	            "chunks": [dict(c, state="planned") for c in chunk_plan()], "stop_latch": None, "events": []}
