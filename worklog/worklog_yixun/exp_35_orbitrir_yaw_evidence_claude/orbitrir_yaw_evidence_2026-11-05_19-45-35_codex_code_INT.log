  1149	              for pos, v in enumerate(d["relL2"]))
  1150	    _eq(out, "probe eps_cond (reported without a verdict)", rep.get("eps_cond"),
  1151	        {"value": top[0], "argmax": {"key": top[1], "id": top[2], "position": top[3]}})
