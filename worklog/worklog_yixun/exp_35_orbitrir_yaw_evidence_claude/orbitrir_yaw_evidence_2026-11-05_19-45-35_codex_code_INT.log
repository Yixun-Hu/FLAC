   381	def reservation_reasons(dirpath, held, uuids, h35):
   382	    """[] iff exactly the reservation the state holds (``{"uuid", "epoch"}`` or None) is ours on disk, every exp_35
   383	    file authenticated field by field; an unreadable or malformed file refuses."""
   384	    out, mine = [], {}
   385	    for u in uuids:
   386	        try:
   387	            doc = read_reservation(dirpath, u)
   388	        except ValueError as err:
   389	            out.append(str(err))
   390	            continue
   391	        if doc is not None and doc["holder"] == "exp35":
   392	            why = ours_reasons(doc, u, h35)
   393	            out += why
   394	            mine.update({} if why else {u: doc})
   395	    if out:
   396	        return out
   397	    if held is None:
   398	        return [f"exp_35 reservation file(s) {sorted(mine)} exist but the state holds none"] if mine else []
   399	    if set(mine) != {held["uuid"]}:
