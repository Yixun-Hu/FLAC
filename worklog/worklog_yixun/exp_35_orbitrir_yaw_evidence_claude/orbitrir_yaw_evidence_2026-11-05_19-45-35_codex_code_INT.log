   366	run_cell() {   # lane cell sha spawn-digest link cache no_flash argv... -- a background job: evaluate, receipt, verify
   367	  local lane="$1" cid="$2" sha="$3" spawn="$4" link="$5" cache="$6" noflash="$7"; shift 7
   368	  local clog="$LOGDIR/depth_canon_${TS}_eval_${cid}.log" rc=0 post measured nbytes out backend=()
