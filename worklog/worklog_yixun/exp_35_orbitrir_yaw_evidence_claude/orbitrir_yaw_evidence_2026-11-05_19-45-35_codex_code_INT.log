  2066	        whole = all(e and e["valid"] for e in rest)
  2067	        pts[k] = first + ([_point(e) for e in rest] if whole else [])
  2068	        notes += [] if whole else [f"K{k}: the E2-FAIL cells are incomplete, so the s42 one-pin point only (n 1)"]
