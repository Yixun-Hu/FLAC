  1168	    for key, want in (("schema_version", 1), ("arm", "BF"), ("deviations", [])):
  1169	        _eq(out, f"probe {key}", rep.get(key), want)
  1170	    if rep.get("registered") is not True:
  1171	        out.append(f"the B-F probe is not a registered control (registered: {rep.get('registered')!r})")
  1172	    prov = rep.get("provenance") if isinstance(rep.get("provenance"), dict) else {}
  1173	    if list(prov) != list(BF_PROVENANCE_KEYS):
  1174	        out.append(f"probe provenance keys {list(prov)} != {list(BF_PROVENANCE_KEYS)}")
  1175	    bf, ds = manifest["arms"]["BF"], next(c for c in manifest["cells"] if c["split"] == P["split"] and c["K"] == P["config_K"])
  1176	    digest = model_config_digest(next(c for c in manifest["cells"] if c["arm"] == "BF"))
  1177	    split_json, sha = manifest["splits"][P["split"]]["split_json"], bf["ckpt"]["sha256"]
  1178	    want = {"ckpt_sha256": sha, "ckpt_sha256_loaded": sha, "ckpt_bytes_loaded": P["ckpt_bytes"], "source_sha": pin,
  1179	            "dirty": "", "device": P["device"], "seed": P["seed"], "n_items": P["n_items"], "batch_size": P["batch_size"],
  1180	            "img_w": P["img_w"], "protocols": P["protocols"], "allow_canon_mismatch": False,
  1181	            "cond_method": P["cond_method"], "frame_avg_angles": P["frame_avg_angles"],
  1182	            "frame_avg_max_fwd_samples": P["frame_avg_max_fwd_samples"],
  1183	            "model_config_file_sha256": bf["model_config_sha256"], "dataset_config": ds["dataset_config"],
  1184	            "dataset_config_sha256": ds["dataset_config_sha256"], "split_json": split_json,
  1185	            "split_json_sha256": _file_digest(os.path.join(REPO, split_json)),
  1186	            "load": {"weights_source": "ema", "canonicalize_trained": None, "canonicalize_applied": False,
  1187	                     "canonicalize_mismatch": False, "img_w": None, "model_config_sha256_file": digest,
  1188	                     "model_config_sha256_embedded": digest}}
  1189	    for key, value in want.items():
  1190	        _eq(out, f"probe provenance.{key}", prov.get(key), value)
  1191	    if bf_receipts is not None:
  1192	        out += _probe_length_reasons(prov, sha, bf_receipts, label="B-F")
  1193	    if not isinstance(prov.get("model_config"), str) or os.path.realpath(os.path.join(REPO, prov["model_config"])) \
  1194	            != os.path.realpath(os.path.join(REPO, bf["model_config"])):
  1195	        out.append(f"probe provenance.model_config {prov.get('model_config')!r} is not {bf['model_config']}")
  1196	    _eq(out, "probe offsets (the quarter turns)", rep.get("offsets"), {f"d{d}": [d] * P["n_items"] for d in P["offsets"]})
  1197	    items = rep.get("items")
  1198	    if not (isinstance(items, list) and len(items) == P["n_items"] and all(
  1199	            isinstance(it, dict) and it.get("position") == i and isinstance(it.get("target_id"), str)
  1200	            and it["target_id"] and _context_ok(it.get("context_ids"), P["K"]) for i, it in enumerate(items))):
  1201	        out.append(f"probe items: not {P['n_items']} ordered positions with a target and K={P['K']} context ids")
