   850	    def _run(self):
   851	        c = self.cfg
   852	        try:
   853	            st = load_state(c["state"], h35=c["h35"], cells_sha256=c["cells_sha256"], supervisor_sha256=c["supervisor_sha256"],
   854	                            approved_sha256=c["approved_sha256"], his_log=c["his_log"], reservations=c["reservations"])
   855	            self.uuids = tuple(sorted(self.tables()[0].values()))
   856	            self.st = st or new_state(h35=c["h35"], cells_sha256=c["cells_sha256"], supervisor_sha256=c["supervisor_sha256"],
   857	                                      approved_sha256=c["approved_sha256"])
   858	        except ValueError as err:
   859	            print(f"SUPERVISOR REFUSED: {err}")
   860	            return 3
   861	        if self.st["stop_latch"]:
   862	            print(f"SUPERVISOR REFUSED: the stop latch is set ({self.st['stop_latch']}); only the Planner clears it")
   863	            return 3
   864	        self.event("supervisor started" + (" (a new state)" if st is None else " (resumed)"))
   865	        if not self.authentic("at the start (inconsistent)"):
   866	            return 3
   867	        self.reconcile()
   868	        for ch in self.st["chunks"]:
   869	            if self.st["stop_latch"] is not None:
   870	                break
   871	            if ch["state"] == "planned":
   872	                lane = self.ready(ch)
   873	                if lane is None:
   874	                    break
   875	                self.execute(ch, lane)
   876	        if self.st["stop_latch"] is not None or any(ch["state"] != "gates_verified" for ch in self.st["chunks"]):
   877	            return 3
   878	        why = release_reservation(self.st["reservation"], c["h35"]) if self.st["reservation"] else []
   879	        if why:                                             # authenticated right before the removal (Codex C3d HIGH 1)
   880	            self.latch("the reservation at the final release (nothing unlinked): " + "; ".join(why))
   881	            return 3
   882	        self.st.update(reservation=None, lane=None)
   883	        self.event("phase (i) complete; the reservation released")
   884	        return 0
