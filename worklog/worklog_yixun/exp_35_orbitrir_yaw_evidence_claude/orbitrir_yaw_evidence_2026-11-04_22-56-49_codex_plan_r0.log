   962	def load_control(path, *, ckpt_sha256, canon_receipts, pin, manifest):
   963	    """``(control_p99, reasons, eps)`` from the composition-control probe JSON: only a valid
   964	    registered artifact of this campaign (``probe_reasons``) with a matching sidecar is a
   965	    control; ``eps`` = ``{value, threshold, verdict PASS|FAIL}`` (a legitimate FAIL stays FAIL).
   966	    ``canon_receipts``: :func:`canon_endpoint_receipts` of the collected cells (rB-F3, required)."""
   967	    import hashlib
   968	    try:
   969	        with open(path, "rb") as f:
   970	            text = f.read()
   971	        with open(path + ".sha256") as f:
   972	            side = f.read()
   973	        rep = json.loads(text)
   974	    except (OSError, ValueError) as err:
   975	        return None, [f"control probe {path} unreadable ({err})"], None
   976	    reasons = []
   977	    if side != f"{hashlib.sha256(text).hexdigest()}  {os.path.basename(path)}\n":
   978	        reasons.append(f"control probe sha256 sidecar does not match {path}")
   979	    if not isinstance(rep, dict):
   980	        return None, reasons + ["control probe is not a JSON object"], None
   981	    reasons += probe_reasons(rep, ckpt_sha256=ckpt_sha256, canon_receipts=canon_receipts, pin=pin, manifest=manifest)
   982	    if reasons:
   983	        return None, reasons, None
   984	    eps = rep["eps_cond"]
   985	    return ({k: float(v) for k, v in rep["control_p99"][CONTROL_PROTOCOL].items()}, [],
   986	            {"value": eps["value"], "threshold": eps["threshold"], "verdict": "PASS" if eps["pass"] else "FAIL"})
