   883	def canon_endpoint_receipts(cells):
   884	    """rB-F3 F3-2: the receipts (``<stem>.cell.json``) of every VERIFIED CANON@``ckpt_step`` cell of
   885	    the selection -- each holds the digest + length of the checkpoint bytes its evaluator loaded."""
