  1005	def tier2(pairs, cells, control):
  1006	    """Tier 2 -- practical waveform invariance of CANON from the scored dumps (rotated vs its
  1007	    theta = 0 pair, identical input_hash). Verdict = every pair's matched rule (its offset's
  1008	    control p99) AND the pooled rule (all pairs' items vs the pooled control p99) AND the 1e-2
  1009	    cap; requiring both readings of "control p99" is the fail-closed resolution. The alarm and
  1010	    the T-dup determinism requirement are reported separately (plan v9 §1)."""
  1011	    import numpy as np
  1012	    from src.tools import depth_canon_stats as stats
  1013	    if control is None:
  1014	        return {"pass": None, "note": "no registered composition control: Tier 2 not computable"}
  1015	    out, pooled, alarm = [], [], {}
  1016	    for p in [p for p in pairs if p["arm"] == "CANON" and p["kind"] in ("C4", "45", "R")]:
  1017	        key = control_key(p["deg"])
  1018	        e, ref = cells[p["cell"]], cells.get(p["ref"]) if p["ref"] else None
  1019	        if not (p["input_hash_equal"] and e["dump"] and ref and ref["dump"]):
  1020	            out.append({**p, "control_key": key, "computable": False, "pass_matched": False,
  1021	                        "pass_cap": False})
  1022	            continue
  1023	        l2, linf = _paired(_waveforms(e), _waveforms(ref))
  1024	        s2, sinf = stats.paired_summary(l2), stats.paired_summary(linf)
  1025	        pooled.append(l2)
  1026	        if s2["max"] > TIER2_ALARM:
  1027	            targets = [t[1] for t in ref["stream"]["input_tuples"]]
  1028	            alarm[p["cell"]] = [targets[i] for i in np.flatnonzero(l2 > TIER2_ALARM)]
  1029	        out.append({**p, "control_key": key, "control_p99": control[key], "computable": True,
  1030	                    "relL2": s2, "relLinf": sinf,
  1031	                    "pass_matched": s2["p99"] <= TIER2_FACTOR * control[key], "pass_cap": s2["p99"] <= TIER2_CAP})
  1032	    pool = stats.paired_summary(np.concatenate(pooled)) if pooled else None
  1033	    pool_ok = bool(pool and pool["p99"] <= TIER2_FACTOR * control["pooled"] and pool["p99"] <= TIER2_CAP)
  1034	    dup = []
  1035	    for p in [p for p in pairs if p["arm"] == "CANON" and p["kind"] == "dup"]:
  1036	        e, ref = cells[p["cell"]], cells.get(p["ref"]) if p["ref"] else None
  1037	        ok = bool(p["input_hash_equal"] and e["dump"] and ref and ref["dump"])
  1038	        mx = float(_paired(_waveforms(e), _waveforms(ref))[0].max()) if ok else None
