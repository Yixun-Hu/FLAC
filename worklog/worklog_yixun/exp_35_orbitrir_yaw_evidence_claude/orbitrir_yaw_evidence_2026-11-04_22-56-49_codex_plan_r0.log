   749	        elif r["rotate_mode"] == "fixed" and r["rotate_deg"] and r["split"] == "unseen" \
   750	                and r["block"] in ("C4+45", "P1-pin", "YAW-pin", "TRAJ"):
   751	            kind = "TRAJ" if r["block"] == "TRAJ" else ("45" if r["rotate_deg"] == 45 else "C4")
