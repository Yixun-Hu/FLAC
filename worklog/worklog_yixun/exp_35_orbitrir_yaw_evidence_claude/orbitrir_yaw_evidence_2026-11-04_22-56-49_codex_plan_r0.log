   106	echo "=== exp_25 depth_canon eval campaign -- ${TS} -- HEAD $(git rev-parse HEAD) -- dry_run=${DRY_RUN} -- harness=${HARNESS_FLAG} ==="
   107	[ -x "$PY" ] || die "the flac interpreter ${PY} is missing - abort"
