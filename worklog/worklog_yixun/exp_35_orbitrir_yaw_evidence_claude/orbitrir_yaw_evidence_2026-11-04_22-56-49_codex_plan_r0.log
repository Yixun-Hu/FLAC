    23	class AudioResNet18(nn.Module):
    24	    def __init__(self, 
    25	                 in_channels: int,
    26	                 log_instead_of_log1p_in_logspace=True,
    27	                 log_eps=1.0e-8):
    28	        """
    29	        ResNet-18.
    30	        Takes in observations (binaural IR magnitude spectrograms) and produces an acoustic embedding
    31	        :param log_instead_of_log1p_in_logspace: compute log of magnitude spect. instead of log(1 + ...)
    32	        :param log_eps: epsilon to be used to compute log for numerical stability
    33	        """
    34	        super().__init__()
    35	
    36	        self._log_instead_of_log1p_in_logspace = log_instead_of_log1p_in_logspace
    37	        self._log_eps = log_eps
    38	
    39	        self._n_input = in_channels
    40	
    41	        self.cnn = models.resnet18(pretrained=False)
    42	        self.cnn.fc_backup = self.cnn.fc
    43	        self.cnn.fc = nn.Sequential()
    44	
    45	        self.cnn.conv1 = nn.Conv2d(self._n_input,
    46	                                   self.cnn.conv1.out_channels,
    47	                                   kernel_size=self.cnn.conv1.kernel_size,
    48	                                   stride=self.cnn.conv1.stride,
    49	                                   padding=self.cnn.conv1.padding,
    50	                                   bias=False)
    51	
    52	        nn.init.kaiming_normal_(
    53	            self.cnn.conv1.weight, mode="fan_out", nonlinearity="relu",
    54	        )
    55	
    56	    @property
    57	    def n_out_feats(self):
    58	        return 512
    59	
    60	    def forward(self, audio_spect):
    61	        cnn_input = []
    62	        if self._log_instead_of_log1p_in_logspace:
    63	            audio_spect_observations = torch.log(audio_spect + self._log_eps)
    64	        else:
    65	            audio_spect_observations = torch.log1p(audio_spect) 
    66	        cnn_input.append(audio_spect_observations)
    67	        cnn_input = torch.cat(cnn_input, dim=1)
    68	        return self.cnn(cnn_input)
