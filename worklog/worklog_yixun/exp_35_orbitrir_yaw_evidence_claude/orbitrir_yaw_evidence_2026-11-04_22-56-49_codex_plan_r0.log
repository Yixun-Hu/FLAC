   245	    k_patches = (k_patches * cos) + (rotate_half(k_patches) * sin)
   246	
   247	    q = torch.cat((q_prefix_tokens, q_patches), dim=-2)
   248	    k = torch.cat((k_prefix_tokens, k_patches), dim=-2)
   249	
   250	    return q, k
