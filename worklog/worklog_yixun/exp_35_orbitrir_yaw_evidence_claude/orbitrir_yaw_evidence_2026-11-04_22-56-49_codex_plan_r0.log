   242	farm_entry_ok() {   # <entry> <cache>: a regular file (never a symlink) on the cache file's inode
   243	  [ ! -L "$1" ] && [ -f "$1" ] && [ ! -L "$2" ] && [ -f "$2" ] \
   244	    && [ "$(stat -c '%d:%i:%s' -- "$1")" = "$(stat -c '%d:%i:%s' -- "$2")" ]
