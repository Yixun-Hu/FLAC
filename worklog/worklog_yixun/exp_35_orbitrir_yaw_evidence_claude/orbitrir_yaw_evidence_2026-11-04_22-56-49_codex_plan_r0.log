   849	def _probe_number_reasons(rep, P):
   850	    """eps_cond, control p99 and the verdict must be what the probe's own results imply."""
   851	    res, keys, out = rep.get("results"), list(P["offset_keys"]), []
   852	    if not (isinstance(res, dict) and list(res) == list(P["protocols"]) and all(
   853	            isinstance(res[p], dict) and list(res[p]) == keys and all(
   854	                isinstance(res[p][k], dict) and all(st in res[p][k] for st in P["stages"]) for k in keys)
   855	            for p in res)):
   856	        return ["probe results are not protocols x registered offsets x stages"]
   857	    vals = [(v, k, i, pos) for k in keys for i, d in res["fp32"][k]["cond"]["per_id"].items()
   858	            for pos, v in enumerate(d["relL2"])]
   859	    eps = rep.get("eps_cond")
   860	    if not (isinstance(eps, dict) and set(eps) == {"value", "threshold", "pass", "argmax"}):
   861	        return out + [f"probe eps_cond {eps!r:.120} is missing or malformed"]
   862	    if not (vals and all(_finite(v) for v, *_ in vals) and _finite(eps["value"]) and eps["value"] >= 0):
   863	        return out + ["probe eps_cond (or the fp32 conditioning relL2 it is the max of) is not finite"]
   864	    top = max(vals)
   865	    _eq(out, "probe eps_cond value (max fp32 conditioning relL2 of the results)", eps["value"], top[0])
   866	    _eq(out, "probe eps_cond argmax", eps["argmax"], {"key": top[1], "id": top[2], "position": top[3]})
   867	    _eq(out, "probe eps_cond threshold (registered)", eps["threshold"], P["eps_threshold"])
   868	    _eq(out, "probe eps_cond pass", eps["pass"], top[0] <= P["eps_threshold"])
   869	    v = rep.get("verdict")
   870	    if not (isinstance(v, dict) and set(v) == {"pass", "eps_cond", "tier1", "masks"}
   871	            and all(type(x) is bool for x in v.values()) and v["eps_cond"] is eps["pass"]
   872	            and v["pass"] is all(v[k] for k in ("eps_cond", "tier1", "masks"))):
   873	        out.append(f"probe verdict {v!r:.120} is inconsistent with eps_cond")
   874	    for p in P["protocols"]:
   875	        want = {k: res[p][k]["waveform"]["summary"]["relL2"]["p99"] for k in keys}
   876	        want["pooled"] = ((rep.get("pooled") or {}).get(p) or {}).get("waveform", {}).get("relL2", {}).get("p99")
   877	        _eq(out, f"probe control_p99[{p}] (the results' waveform relL2 p99)", (rep.get("control_p99") or {}).get(p), want)
   878	        out += [f"probe control p99 {p}/{k} = {x!r} is not a finite non-negative number" for k, x in want.items()
   879	                if not (_finite(x) and x >= 0)]
   880	    return out
