   220	def apply_rotary_pos_emb(
   221	    q: torch.Tensor, k: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor, **kwargs
   222	) -> tuple[torch.Tensor, torch.Tensor]:
   223	    """Applies Rotary Position Embedding to the query and key tensors, but only to the patch tokens,
   224	    ignoring the prefix tokens (cls token and register tokens).
   225	
   226	    Args:
   227	        q (`torch.Tensor`): The query tensor.
   228	        k (`torch.Tensor`): The key tensor.
   229	        cos (`torch.Tensor`): The cosine part of the rotary embedding.
   230	        sin (`torch.Tensor`): The sine part of the rotary embedding.
   231	
   232	    Returns:
   233	        `tuple(torch.Tensor)` comprising of the query and key tensors rotated using the Rotary Position Embedding.
   234	    """
   235	
   236	    num_tokens = q.shape[-2]
   237	    num_patches = sin.shape[-2]
   238	    num_prefix_tokens = num_tokens - num_patches  # cls token + register tokens
   239	
   240	    q_prefix_tokens, q_patches = q.split((num_prefix_tokens, num_patches), dim=-2)
   241	    k_prefix_tokens, k_patches = k.split((num_prefix_tokens, num_patches), dim=-2)
