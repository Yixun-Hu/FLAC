   504	def _orbit_average_loop(conditioner, md_inv, base, present, angles, img_w, device):
   505	    """Reference orbit accumulation: ONE conditioner forward per angle.
   506	
   507	    This is the pre-batching execution order, kept as the equivalence reference
   508	    for :func:`_orbit_average_batched` (tests and the exp_11 equivalence probe
   509	    compare against *this code*, not against a copy of it). It is not used on the
   510	    training path any more.
   511	
   512	    Returns ``{id: summed_tensor}`` over the whole orbit, angle 0 first.
   513	    """
   514	    accum = {i: base[i][0].clone() for i in present}
   515	    for g in angles[1:]:
   516	        part = conditioner(_rotated_variants(md_inv, g, img_w, present), device,
   517	                           only_ids=present)
   518	        for i in present:
   519	            accum[i] = accum[i] + part[i][0]
   520	    return accum
