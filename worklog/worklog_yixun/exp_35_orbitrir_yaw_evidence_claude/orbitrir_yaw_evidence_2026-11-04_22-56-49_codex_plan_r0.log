   591	def build_output_paths(
   592	    ckpt_path,
   593	    steps,
   594	    cfg_scale,
   595	    eval_name,
   596	    cond_method='vanilla',
   597	    rotate_deg=0.0,
   598	    n_angles=4,
   599	    rotate_mode='fixed',
   600	    rotate_seed=None,
   601	    are_lambda=None,
   602	    canonicalize=False,
   603	    canon_mismatch=False,
   604	):
   605	    """Construct the metrics-JSON and predictions-.pt output paths for one run.
   606	
   607	    Pure (no filesystem access): both paths sit in ``ckpt_path``'s directory,
   608	    named ``<ckpt>_<kind>_<steps>_<cfg>_<eval_name><method><rot>.<ext>``.
   609	
   610	    The vanilla + ``rotate_deg == 0`` name is byte-identical to the legacy
   611	    ``eval_FLAC`` output, so exp_01 / exp_02 artifacts reproduce exactly. A
   612	    non-vanilla ``cond_method`` inserts ``_<cond_method>_a<n_angles>`` and a
   613	    non-zero ``rotate_deg`` appends ``_rot<int(rotate_deg)>``. Both suffixes now
   614	    also land on the predictions name -- fixing the exp_02 bug where two
   615	    ``rotate_deg`` values sharing an ``eval_name`` overwrote one predictions file.
   616	
   617	    ``rotate_mode='random'`` (exp_14) replaces the angle suffix with
   618	    ``_rotrand<rotate_seed>``; the fixed-mode names are unchanged down to the byte.
   619	
   620	    exp_25: :func:`canon_suffix` goes after the method suffix and before the
   621	    rotation token; both default to False, which leaves every name unchanged.
   622	
   623	    Returns
   624	    -------
   625	    dict
   626	        ``{'metrics': <...>.json, 'predictions': <...>.pt}``.
   627	    """
   628	    ckpt_name = os.path.basename(ckpt_path).replace('.ckpt', '')
   629	    directory = os.path.dirname(ckpt_path)
   630	    method_suffix = '' if cond_method == 'vanilla' else f'_{cond_method}_a{n_angles}'
   631	    rot = rotation_suffix(rotate_mode, rotate_deg, rotate_seed)
   632	    canon = canon_suffix(canonicalize, canon_mismatch)
   633	    stem = f'{steps}_{cfg_scale}_{eval_name}{method_suffix}{canon}{rot}{are_suffix(are_lambda)}'
   634	    return {
   635	        'metrics': os.path.join(directory, f'{ckpt_name}_metrics_{stem}.json'),
   636	        'predictions': os.path.join(directory, f'{ckpt_name}_predictions_{stem}.pt'),
   637	    }
   638	
