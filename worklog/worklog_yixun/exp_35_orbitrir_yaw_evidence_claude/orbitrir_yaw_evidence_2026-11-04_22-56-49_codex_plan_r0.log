   175	def main(argv=None):
   176	    import argparse
   177	    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   178	    ap.add_argument("--write", action="store_true", help=f"write {os.path.relpath(OUT, REPO)}")
   179	    ap.add_argument("--check", action="store_true", help="exit 1 if the committed file drifted")
   180	    args = ap.parse_args(argv)
   181	    text = render(build_manifest())
   182	    if args.check:
   183	        with open(OUT) as f:
   184	            same = f.read() == text
   185	        print("cells manifest OK" if same else f"cells manifest DRIFTED from the generator: {OUT}")
   186	        return 0 if same else 1
   187	    if args.write:
   188	        with open(OUT, "w") as f:
   189	            f.write(text)
   190	        print(f"wrote {OUT}")
   191	        return 0
   192	    sys.stdout.write(text)
   193	    return 0
   194	
