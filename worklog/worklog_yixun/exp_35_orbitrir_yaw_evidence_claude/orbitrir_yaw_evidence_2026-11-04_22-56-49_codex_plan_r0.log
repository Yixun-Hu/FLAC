   124	def stage_rel(test, ref):
   125	    """Per-item ``{"relL2", "relLinf"}`` of ``test`` against the reference ``ref``."""
   126	    a, b = _rows(test), _rows(ref)
   127	    return {"relL2": stats.rel_l2(a, b), "relLinf": stats.rel_linf(a, b)}
