   495	def _rotated_variants(md_inv, deg, img_w, present):
   496	    """The rotated metadata for one orbit angle (depth and the ``*_vit`` poses
   497	    move together; every other field passes through)."""
   498	    return [
   499	        rotate_scene_metadata(m, math.radians(deg), img_w, pose_keys=tuple(present))
   500	        for m in md_inv
