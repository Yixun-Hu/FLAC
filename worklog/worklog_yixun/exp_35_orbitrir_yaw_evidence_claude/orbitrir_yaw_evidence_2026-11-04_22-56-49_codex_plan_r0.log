    89	def _row(block, sub, arm, step, split, k, seed, rot, canonicalize=False, allow=False, dup=False):
    90	    """One cell. ``rot`` = ``("fixed", deg)`` or ``("random", None)`` (rotate seed = eval seed)."""
    91	    import eval_FLAC
    92	    mode, deg = rot
    93	    tag = {"T-dup": "T", "C4+45": "C4", "D-i": "Di", "D-ii": "Dii"}.get(block, block)
    94	    if block in ("P1-pin", "YAW-pin"):
    95	        tag = sub
    96	    name = f"exp25_{arm}_{tag}_S{step}_K{k}_s{seed}"
    97	    if tag in ("C4", "TRAJ"):
    98	        name += f"_th{deg}"
    99	    name += "_dup" if dup else ""
   100	    trained = ARMS[arm]["trained_canon"]
   101	    in_play = trained or canonicalize or allow
   102	    mismatch = bool(in_play and trained != canonicalize)
   103	    config, config_sha = SPLITS[split]["configs"][k]
   104	    n = SPLITS[split]["expected_stream_count"]
   105	    rotate_seed = seed if mode == "random" else None
   106	    args = ["--model-config", ARMS[arm]["model_config"], "--dataset-config", config, *COMMON_FLAGS,
   107	            "--expected-stream-count", str(n), "--seed", str(seed), "--rotate-mode", mode]
   108	    args += ["--rotate-seed", str(seed)] if mode == "random" else ["--rotate-deg", str(deg)]
   109	    args += (["--canonicalize"] if canonicalize else []) + (["--allow-canon-mismatch"] if allow else [])
   110	    args += ["--eval-name", name]
   111	    metrics = eval_FLAC.build_output_paths(
   112	        "farm/x.ckpt", 1, 1.0, name, cond_method="vanilla", rotate_deg=float(deg or 0), n_angles=4,
   113	        rotate_mode=mode, rotate_seed=rotate_seed, are_lambda=None, canonicalize=canonicalize,
   114	        canon_mismatch=mismatch)["metrics"]
   115	    suffix = os.path.basename(metrics)[len("x_metrics_"):-len(".json")]
   116	    return {"cell": name, "block": block, "subblock": sub, "arm": arm, "step": step, "split": split,
   117	            "K": k, "seed": seed, "rotate_mode": mode, "rotate_deg": deg, "rotate_seed": rotate_seed,
   118	            "canonicalize": canonicalize, "allow_canon_mismatch": allow, "canon_in_play": in_play,
   119	            "canon_trained": trained if in_play else None, "canon_mismatch": mismatch,
   120	            "model_config": ARMS[arm]["model_config"],
   121	            "model_config_sha256": ARMS[arm]["model_config_sha256"], "dataset_config": config,
   122	            "dataset_config_sha256": config_sha, "expected_stream_count": n, "dump": True,
   123	            "metrics_suffix": suffix, "eval_args": args}
