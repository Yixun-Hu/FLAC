   178	# --- the farm: a real local directory (never a symlink out of the checkout) ---------- #
   179	farm_ok() {   # <dir>: absent (DRY_RUN) or a real directory under the repo / harness
   180	  [ ! -L "$1" ] || die "FARM GATE FAILED: ${1} is a symlink - abort"
   181	  [ -e "$1" ] || return 0
