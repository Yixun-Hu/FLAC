   649	# hashes. Codex code review N4 measured the fragility on the real unseen split:
   650	# rendering the same positions as float64 changed two six-decimal strings and
   651	# float16 changed 5,032 of them.
   652	CONTEXT_FINGERPRINT_SCHEMA = 1
