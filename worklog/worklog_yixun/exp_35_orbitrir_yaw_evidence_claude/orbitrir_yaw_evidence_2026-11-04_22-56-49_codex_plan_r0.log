   994	def _paired(a, b, chunk=512):
   995	    """Per-item relL2 / relLinf of ``a`` against the reference ``b``, chunked (memory-bounded)."""
   996	    import numpy as np
   997	    from src.tools import depth_canon_stats as stats
   998	    l2, linf = [], []
   999	    for start in range(0, b.shape[0], chunk):
  1000	        l2.append(stats.rel_l2(a[start:start + chunk], b[start:start + chunk]))
  1001	        linf.append(stats.rel_linf(a[start:start + chunk], b[start:start + chunk]))
  1002	    return np.concatenate(l2), np.concatenate(linf)
