    82	def canonical_pairs(metadata, offsets, img_w):
    83	    """``(A, {key: B}, tier1)`` for one batch of loader metadata dicts.
    84	
    85	    ``A[i] = canonicalize_scene_metadata(md_i)``; ``B[key][i]`` canonicalizes
    86	    ``rotate_scene_metadata(md_i, d_i)`` with ``d_i = offsets[key][i]`` (the reviewed
    87	    operators, nothing re-implemented). ``tier1[i]`` records ``dj_A``, the classes, the
    88	    canonical recovered-depth sha256 of A and, per key, whether B's equals it and
    89	    whether ``dj_B == (dj_A - d) mod W`` (the shift co-rotates). A ``StabilizedTieError``
    90	    propagates (fail-closed, as in training and eval)."""
    91	    from src.data import yaw_rotation as yr
    92	    n = len(metadata)
    93	    for key, ds in offsets.items():
    94	        if len(ds) != n:
    95	            raise ValueError(f"offsets[{key!r}] must hold one offset per item ({n}), got {len(ds)}")
    96	    a_list, b_lists, tier1 = [], {k: [] for k in offsets}, []
    97	    for i, md in enumerate(metadata):
    98	        a, dj_a, cls_a = yr.canonicalize_scene_metadata(md, img_w)
    99	        sha_a = yr.canonical_depth_sha256(a["depth"])
   100	        rec = {"dj_A": dj_a, "class_A": cls_a, "depth_sha_A": sha_a, "offsets": {}}
   101	        for key, ds in offsets.items():
   102	            d = int(ds[i])
   103	            b, dj_b, cls_b = yr.canonicalize_scene_metadata(
   104	                yr.rotate_scene_metadata(md, yr.offsets_to_radians([d], img_w)[0], img_w), img_w)
   105	            b_lists[key].append(b)
   106	            rec["offsets"][key] = {"d": d, "dj_B": dj_b, "class_B": cls_b,
   107	                                   "depth_sha_equal": yr.canonical_depth_sha256(b["depth"]) == sha_a,
   108	                                   "class_equal": cls_b == cls_a,
   109	                                   "dj_corotates": dj_b == (dj_a - d) % img_w}
   110	        a_list.append(a)
   111	        tier1.append(rec)
   112	    return a_list, b_lists, tier1
