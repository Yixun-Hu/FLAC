  1049	                    f"{TIER2_CAP:g}; alarm max > {TIER2_ALARM:g}; T-dup max relL2 == 0"}
  1050	
  1051	
  1052	# Tier 3 (plan v9 §1): Delta_C4 of CANON <= 10 % of P1-pin's on every metric, and |Delta_R| of
  1053	# CANON <= one eval-seed sd of its m_Z; item-weighted (the table's estimand), per-scene reported.
  1054	SEEDS = (42, 43, 44, 45, 46)
  1055	TIER3_FRACTION = 0.10
  1056	AGGS = ("item", "scene")   # flat `metrics` (item-weighted) / mean over the ten by_scene families
  1057	
  1058	
  1059	def _value(entry, key, agg):
  1060	    rec = entry["record"]
  1061	    if agg == "item":
  1062	        return float(rec["metrics"][key])
  1063	    return sum(float(rec["by_scene"][s][key]) for s in SCENE_KEYS) / len(SCENE_KEYS)
  1064	
  1065	
  1066	def _index(cells):
  1067	    """``(arm, kind F|R|S, K, seed, step, deg) -> entry`` over the valid table / rotation cells."""
  1068	    idx = {}
  1069	    for e in cells.values():
  1070	        r = e["row"]
  1071	        if e["valid"] and r["block"] not in ("D-i", "D-ii", "T-dup"):
  1072	            kind = "S" if r["split"] == "seen" else ("R" if r["rotate_mode"] == "random" else "F")
  1073	            idx[(r["arm"], kind, r["K"], r["seed"], r["step"], r["rotate_deg"])] = e
  1074	    return idx
  1075	
  1076	
  1077	def _same_items(a, b):
  1078	    return a is not None and b is not None and a["stream"]["input_hash"] == b["stream"]["input_hash"]
  1079	
  1080	
  1081	def _stats(values):
  1082	    import statistics as st
  1083	    return {"n": len(values), "mean": st.mean(values) if values else None,
  1084	            "sd": st.stdev(values) if len(values) > 1 else None, "values": values}
  1085	
  1086	
  1087	def _arm_tier3(idx, arm, k, agg, key):
  1088	    v = lambda e: _value(e, key, agg)  # noqa: E731
  1089	    z = {s: idx.get((arm, "F", k, s, 40000, 0)) for s in SEEDS}
  1090	    c4 = [idx.get((arm, "F", k, 42, 40000, d)) for d in (0, 90, 180, 270)]
  1091	    p45, rr = idx.get((arm, "F", k, 42, 40000, 45)), {s: idx.get((arm, "R", k, s, 40000, None)) for s in SEEDS}
  1092	    zs = _stats([v(e) for e in z.values() if e])
  1093	    ok_c4 = all(_same_items(e, c4[0]) for e in c4)
  1094	    d = [v(rr[s]) - v(z[s]) for s in SEEDS if _same_items(rr[s], z[s])]
  1095	    return {"n_z": zs["n"], "mean_z": zs["mean"], "sd_z": zs["sd"],
  1096	            "c4_values": [v(e) for e in c4] if ok_c4 else None,
  1097	            "delta_c4": (max(v(e) for e in c4) - min(v(e) for e in c4)) if ok_c4 else None,
  1098	            "probe45": v(p45) - v(c4[0]) if _same_items(p45, c4[0]) else None,
  1099	            "n_r_pairs": len(d), "delta_r": (sum(d) / len(d)) if len(d) == len(SEEDS) else None,
  1100	            "sd_r_pairs": _stats(d)["sd"]}
  1101	
  1102	
  1103	def tier3(cells):
  1104	    """Tier 3 per arm, K, aggregation and metric, plus the CANON-vs-P1 PASS checks
  1105	    (``pass`` None when an input is missing -- never a silent PASS)."""
  1106	    idx = _index(cells)
  1107	    arms = {a: {k: {agg: {key: _arm_tier3(idx, a, k, agg, key) for key in TIER3_KEYS} for agg in AGGS}
  1108	                for k in (1, 8)} for a in ("CANON", "P1", "YAW")}
  1109	    checks = []
  1110	    for k in (1, 8):
  1111	        for key in TIER3_KEYS:
  1112	            c, p = arms["CANON"][k]["item"][key], arms["P1"][k]["item"][key]
  1113	            known = None not in (c["delta_c4"], p["delta_c4"], c["delta_r"], c["sd_z"])
  1114	            checks.append({"K": k, "metric": key, "computable": known,
  1115	                           "pass_c4": known and c["delta_c4"] <= TIER3_FRACTION * p["delta_c4"],
  1116	                           "pass_r": known and abs(c["delta_r"]) <= c["sd_z"]})
  1117	    verdict = None if not all(c["computable"] for c in checks) else all(
  1118	        c["pass_c4"] and c["pass_r"] for c in checks)
  1119	    return {"arms": arms, "checks": checks, "pass": verdict,
  1120	            "rule": f"Delta_C4(CANON) <= {TIER3_FRACTION:g} x Delta_C4(P1-pin) and |Delta_R(CANON)| <= "
  1121	                    "sd(m_Z CANON), every metric, both K, item-weighted"}
  1122	
  1123	
  1124	def table_block(cells):
  1125	    """theta = 0 rows, mean +- sample sd over the five eval seeds: unseen (CANON T, P1-pin T,
  1126	    YAW-pin T) and ``seen`` (CANON S, YAW-pin S); item-weighted and per-scene."""
  1127	    idx = _index(cells)
  1128	    def block(kind, arm):
  1129	        return {k: {agg: {key: _stats([_value(e, key, agg) for e in
  1130	                                       (idx.get((arm, kind, k, s, 40000, 0)) for s in SEEDS) if e])
  1131	                          for key in TIER3_KEYS} for agg in AGGS} for k in (1, 8)}
  1132	    out = {arm: block("F", arm) for arm in ("CANON", "P1", "YAW")}
  1133	    out["seen"] = {arm: block("S", arm) for arm in ("CANON", "YAW")
  1134	                   if any(key[0] == arm and key[1] == "S" for key in idx)}
  1135	    return out

