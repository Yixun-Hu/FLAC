  1053	# CANON <= one eval-seed sd of its m_Z; item-weighted (the table's estimand), per-scene reported.
  1054	SEEDS = (42, 43, 44, 45, 46)
  1055	TIER3_FRACTION = 0.10
  1056	AGGS = ("item", "scene")   # flat `metrics` (item-weighted) / mean over the ten by_scene families
