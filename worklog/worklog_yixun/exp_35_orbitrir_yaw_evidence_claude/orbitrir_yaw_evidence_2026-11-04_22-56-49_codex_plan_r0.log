   432	def load_deviations(load):
   433	    """Checkpoint-level departures: EMA weights selected, CANON trained = applied, no mismatch,
   434	    the 512-column grid, file config == embedded config."""
   435	    out = []
   436	    if load.get("weights_source") != "ema":
