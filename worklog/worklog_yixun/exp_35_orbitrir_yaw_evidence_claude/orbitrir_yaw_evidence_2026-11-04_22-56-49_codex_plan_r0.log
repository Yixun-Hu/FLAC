   269	    --dump-root "$DUMP_ROOT" --base-dir "$REPO" --campaign-digest "$CAMPAIGN_DIGEST" "${extra[@]}" 2>&1 | grep -v -e pkg_resources -e declare_namespace | sed 's/^/    /'
