   225	def load_probe_module(model_config_path, ckpt_path, device, allow_canon_mismatch=False):
   226	    """``(module, info, ckpt_load)`` -- the checkpoint loaded the way ``evaluate_model`` loads it.
   227	
   228	    The helpers are eval_FLAC's own (``resolve_weights_source``,
   229	    ``resolve_are_from_checkpoint``, ``resolve_canonicalize_protocol`` with the
   230	    ``--canonicalize`` flag set, ``check_load_integrity``, the two factories, all looked
   231	    up on the ``eval_FLAC`` module). The prefix strip and the EMA re-keying are inline
   232	    statements in ``evaluate_model``, so they are repeated here verbatim; the tests pin
   233	    the state dict and both configs this hands the factories against the ones
   234	    ``evaluate_model`` hands them for the same checkpoint. ARE checkpoints are refused
   235	    (no add-back bank here); a non-canonical checkpoint needs ``allow_canon_mismatch``.
   236	
   237	    rB-F3 F3-1 (Codex rA3/rB3 HIGH): as ``evaluate_model`` (rB-F2 F2-6), the file is read ONCE
   238	    (``eval_FLAC.read_checkpoint_exact``), THAT buffer is deserialized
   239	    (``torch.load(io.BytesIO(buf), map_location="cpu")``) and ``ckpt_load`` =
   240	    ``{ckpt_sha256_loaded, ckpt_bytes_loaded}`` of exactly that buffer, validated type-strictly by
   241	    eval_FLAC's own ``_ckpt_load_provenance`` (a malformed value is a ``ValueError``)."""
   242	    import copy
   243	    import io
   244	    import json
   245	    import eval_FLAC as ev
   246	    with open(model_config_path) as f:
   247	        model_config = json.load(f)
   248	    file_model_config = copy.deepcopy(model_config)
   249	    training_config = model_config.get("training", None)
   250	    buf, ckpt_load = ev.read_checkpoint_exact(ckpt_path)
   251	    if ckpt_load is None:                                          # (_ckpt_load_provenance passes None)
   252	        raise ValueError("ckpt load provenance must be the digest + length of the bytes read, got None")
   253	    ckpt_load = ev._ckpt_load_provenance({}, ckpt_load)            # exactly the two keys, type-strict
   254	    ckpt = torch.load(io.BytesIO(buf), map_location="cpu")
   255	    del buf
   256	    state_dict = ckpt["state_dict"]
   257	    for key in list(state_dict.keys()):                            # verbatim (evaluate_model)
   258	        if key.startswith("diffusion."):
   259	            new_key = key.replace("diffusion.", "")
   260	            state_dict[new_key] = state_dict.pop(key)
   261	    weights_source = ev.resolve_weights_source(training_config, state_dict.keys())
   262	    if training_config.get("use_ema", False) and any(k.startswith("diffusion_ema.ema_model.")
   263	                                                     for k in state_dict.keys()):
   264	        print("Using EMA model")
   265	        for key in list(state_dict.keys()):
   266	            if key.startswith("diffusion_ema.ema_model."):
   267	                new_key = key.replace("diffusion_ema.ema_model.", "model.")
   268	                state_dict[new_key] = state_dict.pop(key)
   269	        training_config["use_ema"] = False
   270	    are_lambda, _, _ = ev.resolve_are_from_checkpoint(ckpt.get("model_config"), file_model_config, None)
   271	    if are_lambda is not None:
   272	        raise ValueError(f"an ARE checkpoint (are_lambda={are_lambda}) is out of this probe's scope: "
   273	                         "it has no anchor add-back")
   274	    embedded = ckpt.get("model_config")
   275	    protocol = ev.resolve_canonicalize_protocol(
   276	        True, file_model_config.get("training"),
   277	        embedded.get("training") if isinstance(embedded, dict) else None,
   278	        allow_canon_mismatch, cond_method="vanilla", file_model_cfg=file_model_config)
   279	    model = ev.create_model_from_config(model_config)
   280	    missing, unexpected = model.load_state_dict(state_dict, strict=False)
   281	    ev.check_load_integrity(missing, unexpected, False)
   282	    model_config["training"] = training_config
   283	    module = ev.create_training_wrapper_from_config(model_config, model)
   284	    module.eval().requires_grad_(False)
   285	    module.to(device)
   286	    info = {"weights_source": weights_source, "canonicalize_trained": protocol.trained,
   287	            "canonicalize_applied": protocol.applied, "canonicalize_mismatch": protocol.mismatch,
   288	            "img_w": protocol.img_w, "model_config_sha256_file": ev.model_config_sha256(file_model_config),
   289	            "model_config_sha256_embedded": ev.model_config_sha256(embedded)}
   290	    return module, info, ckpt_load
