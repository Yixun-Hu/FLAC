   138	def build_manifest():
   139	    E, U = ENDPOINT, "unseen"
   140	    blocks = {
   141	        "T": [_row("T", "T", "CANON", E, U, k, s, ("fixed", 0), True) for k in KS for s in SEEDS],
   142	        "T-dup": [_row("T-dup", "T", "CANON", E, U, k, 42, ("fixed", 0), True, dup=True) for k in KS],
   143	        "C4+45": [_row("C4+45", "C4", "CANON", E, U, k, 42, ("fixed", d), True)
   144	                  for k in KS for d in C4_ANGLES + (OFF_ORBIT,)],
   145	        "R": [_row("R", "R", "CANON", E, U, k, s, ("random", None), True) for k in KS for s in SEEDS],
   146	        "D-i": [_row("D-i", "D", "CANON", E, U, k, 42, ("fixed", 0), allow=True) for k in KS],
   147	        "D-ii": [_row("D-ii", "D", "P1", E, U, k, 42, ("fixed", 0), True, True) for k in KS],
   148	        "S": [_row("S", "S", "CANON", E, "seen", k, s, ("fixed", 0), True) for k in KS for s in SEEDS],
   149	        "P1-pin": _pin_rows("P1"),
   150	        "YAW-pin": _pin_rows("YAW"),
   151	        "TRAJ": [_row("TRAJ", "TRAJ", "CANON", step, U, k, 42, ("fixed", d), True)
   152	                 for step in range(CADENCE, ENDPOINT, CADENCE) for k in KS for d in (0,) + C4_ANGLES],
   153	    }
   154	    cells = []
   155	    for priority, block in enumerate(BLOCKS):
   156	        for row in blocks[block]:
   157	            cells.append({"cell": row.pop("cell"), "order": len(cells), "priority": priority, **row})
   158	    return {"schema_version": SCHEMA_VERSION, "generator": f"{EXPREL}/depth_canon_make_cells.py",
   159	            "plan": "plan_depth_canon.md v9 §5", "blocks": list(BLOCKS),
   160	            "block_counts": {b: len(blocks[b]) for b in BLOCKS}, "common_flags": COMMON_FLAGS,
   161	            "img_w": IMG_W, "seeds": list(SEEDS), "dump_root": DUMP_ROOT, "farm_root": FARM_ROOT,
   162	            "splits": {s: {"split_json": v["split_json"], "expected_stream_count": v["expected_stream_count"]}
   163	                       for s, v in SPLITS.items()},
   164	            "arms": ARMS, "cells": cells}
