   217	def lookup(
   218	    summary_rows: list[dict],
   219	    method: str,
   220	    k: int,
   221	    metric: str,
   222	    angles: tuple[int, ...],
   223	) -> tuple[np.ndarray, np.ndarray]:
   224	    rows = [
   225	        row
   226	        for row in summary_rows
   227	        if row["method"] == method and row["K"] == k and row["metric"] == metric
   228	    ]
   229	    rows.sort(key=lambda row: row["angle_deg"])
   230	    if [row["angle_deg"] for row in rows] != list(angles):
   231	        raise RuntimeError(f"Incomplete summary for {method}, K={k}, {metric}")
   232	    return (
   233	        np.asarray([row["mean"] for row in rows]),
   234	        np.asarray([row["std"] for row in rows]),
   235	    )
