   183	def rotate_half(x):
   184	    """Rotates half the hidden dims of the input."""
   185	    x1 = x[..., : x.shape[-1] // 2]
   186	    x2 = x[..., x.shape[-1] // 2 :]
   187	    return torch.cat((-x2, x1), dim=-1)
