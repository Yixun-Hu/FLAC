   118	tree_dirty() { git status --porcelain --untracked-files=all -- "${RELEVANT[@]}"; }
   119	tree_digest() {   # sha256 of the sorted sha256sum lines of every tracked + untracked (unignored) relevant file
   120	  local lines
   121	  lines="$(git ls-files -z --cached --others --exclude-standard -- "${RELEVANT[@]}" | LC_ALL=C sort -zu \
   122	    | xargs -0r sha256sum --)" && [ -n "$lines" ] || return 1
