   251	VERIFY_EXTRA=(); [ -n "$CANON_MANIFEST" ] && VERIFY_EXTRA=(--canon-ckpt-manifest "$CANON_MANIFEST")
   252	existing_artifacts() {   # every artifact of the current cell that exists (one path per line)
   253	  local p
   254	  for p in "$METRICS" "$STREAM" "$CANON_PROBE" "$RECEIPT" "$DUMP_DIR" "$DUMP_DIR".staging-*; do
   255	    case "$p" in *.staging-*.incomplete-*) continue ;; esac            # already parked
