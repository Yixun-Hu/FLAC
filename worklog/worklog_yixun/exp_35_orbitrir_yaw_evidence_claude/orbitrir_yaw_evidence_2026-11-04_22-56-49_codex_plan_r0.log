    59	def resolve_frame_avg_cap(max_fwd_samples=None) -> int:
    60	    """The frame-average forward cap this call must use.
    61	
    62	    ``None`` -> :data:`FRAME_AVG_MAX_FWD_SAMPLES` (64), i.e. exactly the
    63	    behaviour every recipe already in the record was run under. Anything else is
    64	    validated and returned as-is; the module global is never rebound, because the
    65	    cap is a per-arm property (exp_14's ``training.frame_avg_max_fwd_samples``)
    66	    and a process-wide assignment would (a) leak into whatever else the process
    67	    later conditions and (b) survive a mid-step crash as a cap nobody declared.
    68	
    69	    Validation is on the RAW value and fail-closed. ``bool`` is rejected before
    70	    ``int`` because ``isinstance(True, int)`` is True and ``max(1, 64 // True)``
    71	    would quietly become a 64-angle chunk plan; a float or a numeric string is
    72	    rejected rather than coerced, because ``int("32")`` succeeding on a typo is
    73	    how an arm gets trained under a cap its config never stated.
    74	    """
    75	    if max_fwd_samples is None:
    76	        return FRAME_AVG_MAX_FWD_SAMPLES
    77	    if isinstance(max_fwd_samples, bool) or not isinstance(max_fwd_samples, int):
    78	        raise ValueError(
    79	            f"max_fwd_samples must be an int (the frame-average per-forward sample "
    80	            f"cap), got {max_fwd_samples!r}"
    81	        )
    82	    if max_fwd_samples < 1:
    83	        raise ValueError(f"max_fwd_samples must be >= 1, got {max_fwd_samples}")
    84	    return int(max_fwd_samples)
