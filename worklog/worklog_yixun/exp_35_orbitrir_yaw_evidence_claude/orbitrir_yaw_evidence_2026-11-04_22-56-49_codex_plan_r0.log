  1270	def build_results(cells, *, control, control_reasons, eps, audit, audit_reasons, pin, blocks, partial,
  1271	                  audit_summary=None):
  1272	    """Every tier, table and disclosure; raises ``ValueError`` (the refusal) when a required
  1273	    cell, the registered control or the tie audit is missing/invalid, or a cell's tie counts
  1274	    contradict the validated audit -- unless ``partial``."""
  1275	    missing, invalid = completeness(cells)
  1276	    ties = tie_summary(cells, audit, audit_summary)       # BEFORE the refusal (Codex rB B1)
  1277	    problems = ([f"{len(missing)} required cell(s) missing"] if missing else []) + (
  1278	        [f"{len(invalid)} cell(s) failed verification"] if invalid else []) + (
  1279	        [f"composition control: {'; '.join(control_reasons)}"] if control is None else []) + (
  1280	        [f"tie audit: {'; '.join(audit_reasons)}"] if audit is None else []) + (
  1281	        [f"tie audit: {len(ties['mismatches'])} canonicalized cell(s) carry tie counts that differ from the "
  1282	         f"validated audit's split counts ({', '.join(ties['mismatches'][:3])})"] if ties["mismatches"] else [])
  1283	    overlap = split_overlap(audit_summary)
  1284	    problems += overlap["mismatch"]
  1285	    repl = context_replacement(cells)
  1286	    problems += [f"{k}: repeated context ids on different targets in different cells (the registered rule: "
  1287	                 "the same targets in every cell of a split and K)" for k, v in repl.items() if not v["consistent"]]
  1288	    digests = sorted({e["receipt"]["campaign_digest"] for e in cells.values() if e["valid"]})
  1289	    if len(digests) > 1:   # rB-F1 B3: one campaign = one evaluated tree
  1290	        problems.append(f"the cells span {len(digests)} campaign digests ({', '.join(d[:12] for d in digests)})")
  1291	    if problems and not partial:
  1292	        raise ValueError("RESULTS REFUSED (pass --partial for a labelled partial table): " + "; ".join(problems)
  1293	                         + "".join(f"\n  missing {n}" for n in missing)
  1294	                         + "".join(f"\n  invalid {n}: {cells[n]['reasons'][:3]}" for n in invalid))
  1295	    pairs = make_pairs(cells)
