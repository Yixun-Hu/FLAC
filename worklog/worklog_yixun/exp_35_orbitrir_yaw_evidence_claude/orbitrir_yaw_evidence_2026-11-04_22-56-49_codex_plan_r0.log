   190	def eager_attention_forward(
   191	    module: nn.Module,
   192	    query: torch.Tensor,
   193	    key: torch.Tensor,
   194	    value: torch.Tensor,
   195	    attention_mask: Optional[torch.Tensor],
   196	    scaling: float,
   197	    dropout: float = 0.0,
   198	    **kwargs,
   199	):
   200	    # Take the dot product between "query" and "key" to get the raw attention scores.
   201	    attn_weights = torch.matmul(query, key.transpose(-1, -2)) * scaling
   202	
   203	    # Normalize the attention scores to probabilities.
   204	    attn_weights = nn.functional.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query.dtype)
   205	
   206	    # This is actually dropping out entire tokens to attend to, which might
   207	    # seem a bit unusual, but is taken from the original Transformer paper.
   208	    attn_weights = nn.functional.dropout(attn_weights, p=dropout, training=module.training)
   209	
   210	    # Mask heads if we want to
   211	    if attention_mask is not None:
   212	        attn_weights = attn_weights * attention_mask
   213	
   214	    attn_output = torch.matmul(attn_weights, value)
   215	    attn_output = attn_output.transpose(1, 2).contiguous()
   216	
   217	    return attn_output, attn_weights
