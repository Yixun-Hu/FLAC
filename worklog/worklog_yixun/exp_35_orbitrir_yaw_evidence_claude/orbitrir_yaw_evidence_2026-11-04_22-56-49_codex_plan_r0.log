   154	# --- the dump root, verified ONCE: on the NAS share, created, write-probed ----------- #
   155	nas_identity_ok() {
   156	  local line
   157	  line="$(findmnt -n -T "$1" -o FSTYPE,SOURCE 2>/dev/null || true)"
   158	  grep -qE "^${NAS_FSTYPE}[[:space:]]+${NAS_SOURCE//./\\.}\$" <<<"$line" && return 0
   159	  echo "DUMP ROOT GATE FAILED: ${1} is on '$(tr '\n' ';' <<<"$line")', not '${NAS_FSTYPE} ${NAS_SOURCE}' - abort"
   160	  return 1
   161	}
