    70	class Conditioner(nn.Module):
    71	    def __init__(
    72	            self,
    73	            dim: int,
    74	            output_dim: int,
    75	            project_out: bool = False
    76	            ):
    77	        
    78	        super().__init__()
    79	
    80	        self.dim = dim
    81	        self.output_dim = output_dim
    82	        self.proj_out = nn.Linear(dim, output_dim) if (dim != output_dim or project_out) else nn.Identity()
    83	
    84	    def forward(self, x: tp.Any) -> tp.Any:
    85	        raise NotImplementedError()
