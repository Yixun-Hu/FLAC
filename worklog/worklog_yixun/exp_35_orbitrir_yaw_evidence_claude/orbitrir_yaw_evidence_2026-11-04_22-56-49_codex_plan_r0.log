   215	def compare_stages(test, ref):
   216	    """``{stage: comparison}`` of two :func:`run_stages` outputs (``ref`` = A)."""
   217	    out = {"cond": compare_cond(test["cond"], ref["cond"])}
   218	    out.update({s: stage_rel(test[s], ref[s]) for s in STAGES[1:]})
