   522	
   523	def _orbit_average_batched(conditioner, md_inv, base, present, angles, img_w, device,
   524	                           cap=None, cap_is_explicit=False):
   525	    """Same orbit sum as :func:`_orbit_average_loop`, executed as a few large forwards.
   526	
   527	    The rotated variants of consecutive angles are concatenated along the batch
   528	    dimension into chunks of at most ``cap`` samples (default
   529	    :data:`FRAME_AVG_MAX_FWD_SAMPLES`; whole angles per chunk, so a chunk is
   530	    ``k * B`` samples), each chunk is one conditioner call, and the stacked output
   531	    is split back per angle. Terms are accumulated in the INPUT ANGLE ORDER
   532	    starting from the angle-0 base, so the additions are never reassociated: the
   533	    averaging arithmetic is identical to the loop.
   534	
   535	    ``cap_is_explicit`` only selects which knob the over-cap error names — the
   536	    module constant, or the config key that overrode it. A caller that hands us a
   537	    cap it read from a config must not be told to edit a module global.
   538	
   539	    What is NOT identical is the augmentation schedule under train-mode DINOv3:
   540	    its random RoPE rescale is drawn once per forward, so a chunk's angles share
   541	    a draw (see :data:`FRAME_AVG_MAX_FWD_SAMPLES` for the disclosure). In eval
   542	    mode there is no such draw and the two paths agree numerically.
   543	
   544	    Only the ``present`` (ViT) ids are re-run; masks come from the base pass.
   545	    A batch larger than the cap is rejected rather than silently exceeding it,
   546	    because a chunk cannot be smaller than one angle.
   547	    """
   548	    accum = {i: base[i][0].clone() for i in present}
   549	    rest = angles[1:]
   550	    if not rest:
   551	        return accum
   552	    if cap is None:
   553	        cap = FRAME_AVG_MAX_FWD_SAMPLES
   554	    cap_name = ("training.frame_avg_max_fwd_samples" if cap_is_explicit
   555	                else "FRAME_AVG_MAX_FWD_SAMPLES")
   556	    batch = len(md_inv)
   557	    if batch > cap:
   558	        raise ValueError(
   559	            f"batch {batch} exceeds {cap_name} "
   560	            f"({cap}): a frame-average chunk is whole angles, so it "
   561	            "cannot be split below one angle -- lower the batch or raise the cap deliberately"
   562	        )
   563	    angles_per_chunk = max(1, cap // batch)
   564	    for start in range(0, len(rest), angles_per_chunk):
   565	        chunk = rest[start:start + angles_per_chunk]
   566	        stacked = []
   567	        for g in chunk:
   568	            stacked.extend(_rotated_variants(md_inv, g, img_w, present))
   569	        part = conditioner(stacked, device, only_ids=present)
   570	        for i in present:
   571	            out = part[i][0]
   572	            if out.shape[0] != len(chunk) * batch:
   573	                raise RuntimeError(
   574	                    f"{i}: batched orbit forward returned {out.shape[0]} rows for "
   575	                    f"{len(chunk)} angle(s) x {batch} sample(s)"
   576	                )
   577	            for k in range(len(chunk)):          # ascending angle order preserved
   578	                accum[i] = accum[i] + out[k * batch:(k + 1) * batch]
   579	    return accum
