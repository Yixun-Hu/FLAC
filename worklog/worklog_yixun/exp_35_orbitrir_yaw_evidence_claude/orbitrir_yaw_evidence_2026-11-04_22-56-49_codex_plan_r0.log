    87	class PretransformConditioner(Conditioner):
    88	    """
    89	    A conditioner that uses a pretransform's encoder for conditioning
    90	
    91	    Args:
    92	        pretransform: an instantiated pretransform to use for conditioning
    93	        output_dim: the dimension of the output embeddings
    94	    """
    95	    def __init__(self, pretransform: Pretransform, output_dim: int, save_pretransform: bool = False, sample_size: int = 10240, name: str = "PretransformConditioner"):
    96	        in_dim = pretransform.encoded_channels * (sample_size // pretransform.downsampling_ratio)
    97	        super().__init__(in_dim, output_dim)
    98	        self.name = name
    99	
   100	        if not save_pretransform:
   101	            self.__dict__["pretransform"] = pretransform
   102	        else:
   103	            self.pretransform = pretransform
   104	
   105	        self.pretransform.eval()
   106	        
   107	    def forward(self, audio: tp.Union[torch.Tensor, tp.List[torch.Tensor], tp.Tuple[torch.Tensor]], device: tp.Union[torch.device, str]) -> tp.Tuple[torch.Tensor, torch.Tensor]:
   108	        context = False 
   109	        
   110	        self.pretransform.to(device)
   111	        self.proj_out.to(device)
   112	
   113	        if isinstance(audio, list) or isinstance(audio, tuple):
   114	            audio = torch.stack(audio, dim=0)
   115	
   116	        if audio.dim() == 4: # Context audio [B, N, C, T]
   117	            context = True
   118	            B, N, C, T = audio.shape
   119	            audio = audio.view(-1, audio.shape[-2], audio.shape[-1]) # [B*N, C, T]
   120	
   121	        # Add batch dimension if needed
   122	        if audio.dim() == 2:
   123	            audio = audio.unsqueeze(0)
   124	            B, C, T = audio.shape
   125	
   126	        # Convert audio to pretransform input channels
   127	        audio = set_audio_channels(audio, self.pretransform.io_channels)
   128	
   129	        audio = audio.to(device)
   130	        
   131	        latents = self.pretransform.encode(audio)
   132	
   133	        if context:
   134	            latents = latents.view(B, N, -1)
   135	
   136	        latents = self.proj_out(latents)
   137	
   138	        return [latents, torch.ones(latents.shape[0], latents.shape[2]).to(latents.device)]
