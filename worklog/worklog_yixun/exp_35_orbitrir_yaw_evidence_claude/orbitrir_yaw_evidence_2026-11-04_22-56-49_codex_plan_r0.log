   279	    farm_entry_ok "$LINK" "$CACHED" \
   280	      || { echo "FARM GATE FAILED: ${LINK} exists and is not a hard link of the verified ${CACHED} - abort"; return 1; }
   281	  elif [ "$DRY_RUN" = 0 ]; then
   282	    mkdir -p "$(dirname "$LINK")" && ( farm_ok "$(dirname "$LINK")" ) && ln -- "$CACHED" "$LINK" \
