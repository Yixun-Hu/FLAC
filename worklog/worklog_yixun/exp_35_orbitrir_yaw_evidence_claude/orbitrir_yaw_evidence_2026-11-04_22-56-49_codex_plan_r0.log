   891	def _probe_length_reasons(prov, ckpt_sha256, receipts):
   892	    """rB-F3 F3-2 (Codex rA3/rB3 HIGH): the probe's ``ckpt_bytes_loaded`` == the one length every
   893	    verified CANON@40k cell receipt holds for the same checkpoint. No such receipt, receipts that
   894	    disagree or name other bytes -> the length is NOT verifiable (a reason, never a silent pass)."""
   895	    label, step = "probe provenance.ckpt_bytes_loaded", PROBE_CONTRACT["ckpt_step"]
   896	    if not receipts:
   897	        return [f"{label} is not verifiable: the selection holds no verified CANON@{step} cell receipt "
   898	                "(the length of the checkpoint bytes the campaign loaded)"]
   899	    out = [f"{label} is not verifiable: a verified CANON@{step} cell receipt's ckpt_sha256_loaded "
   900	           f"{r.get('ckpt_sha256_loaded')!r} is not the probe's checkpoint {ckpt_sha256}"
   901	           for r in receipts if r.get("ckpt_sha256_loaded") != ckpt_sha256]
   902	    sizes = [r.get("ckpt_bytes_loaded") for r in receipts]
   903	    bad = [n for n in sizes if type(n) is not int or n <= 0]
   904	    if bad:
   905	        return out + [f"{label} is not verifiable: a verified CANON@{step} cell receipt's ckpt_bytes_loaded "
   906	                      f"{bad[0]!r} is not a positive int"]
   907	    if len(set(sizes)) != 1:
   908	        return out + [f"{label} is not verifiable: the verified CANON@{step} cell receipts disagree on "
   909	                      f"ckpt_bytes_loaded ({sorted(set(sizes))})"]
   910	    _eq(out, f"{label} (vs the verified CANON@{step} cell receipts' ckpt_bytes_loaded)",
   911	        prov.get("ckpt_bytes_loaded"), sizes[0])
   912	    return out
