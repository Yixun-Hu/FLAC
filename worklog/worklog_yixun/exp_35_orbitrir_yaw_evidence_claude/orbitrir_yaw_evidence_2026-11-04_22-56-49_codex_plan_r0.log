   130	def compare_cond(test, ref):
   131	    """Conditioning dicts ``{id: [tensor, mask]}``: per-id relL2 / relLinf of the
   132	    tensors, the same over all ids concatenated per item (``"all"``, ids sorted), and
   133	    whether every mask is identical."""
   134	    if sorted(test) != sorted(ref):
   135	        raise ValueError(f"conditioner ids differ: {sorted(test)} vs {sorted(ref)}")
   136	    ids = sorted(ref)
   137	    out = {"ids": ids, "masks_equal": all(
   138	        (test[k][1] is None and ref[k][1] is None) or
   139	        (test[k][1] is not None and ref[k][1] is not None and torch.equal(test[k][1].cpu(), ref[k][1].cpu()))
   140	        for k in ids)}
   190	    velocities = []
