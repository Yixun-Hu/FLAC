   485	def test_the_install_protocol_fsyncs_before_it_renames_and_unmarks_last(env, monkeypatch):
   486	    state, docs = env
   487	    a, n = docs / "a.md", docs / "n.md"
   488	    a.write_bytes(b"a\n")
   489	    t = rt.Transaction(state)
   490	    t.create(n, b"n\n")
   491	    t.append(a, "b\n")
   492	    trace, real = [], {name: getattr(os, name) for name in ("fsync", "link", "replace", "unlink")}
   493	
   494	    def fsync(fd):
   495	        trace.append(("fsync", os.readlink(f"/proc/self/fd/{fd}")))
   496	        return real["fsync"](fd)
   497	
   498	    def traced(name):
   499	        def call(src, *rest, **kwargs):
   500	            trace.append((name, os.fspath(rest[0] if rest else src)))   # link / replace: the destination
   501	            return real[name](src, *rest, **kwargs)
   502	        return call
   503	    monkeypatch.setattr(rt.os, "fsync", fsync)
   504	    for name in ("link", "replace", "unlink"):
   505	        monkeypatch.setattr(rt.os, name, traced(name))
   506	    done = t.commit()
   507	    monkeypatch.undo()
   508	    r = lambda p: str(pathlib.Path(p).resolve())                          # noqa: E731
   509	    at = lambda event: trace.index(event)                                 # noqa: E731
   510	    tmp = [e for e in trace if e[0] == "fsync" and e[1].endswith(".records_txn.tmp")]
   511	    first_install, last_install = at(("link", r(n))), at(("replace", r(a)))
   512	    manifest_synced = at(("fsync", r(state / rt.MANIFEST)))
   513	    assert len(tmp) == 2 and all(trace.index(e) < manifest_synced for e in tmp)      # staged, then marked
   514	    assert ("fsync", r(docs)) in trace[:manifest_synced]                              # temps' entries durable
   515	    assert manifest_synced < trace.index(("fsync", r(state)), manifest_synced) < first_install
   516	    assert first_install < last_install < trace.index(("fsync", r(docs)), last_install)
   517	    assert trace.index(("fsync", r(docs)), last_install) < at(("unlink", r(state / rt.MANIFEST)))
   518	    assert at(("link", r(done))) < at(("unlink", r(state / rt.MANIFEST)))           # archived, then unmarked
