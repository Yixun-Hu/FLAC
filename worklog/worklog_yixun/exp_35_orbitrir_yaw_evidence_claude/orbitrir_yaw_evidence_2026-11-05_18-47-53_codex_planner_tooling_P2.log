   622	def test_failure_after_the_first_rename_keeps_the_manifest_and_blocks_the_next_transaction(env, monkeypatch):
   623	    state, docs = env
   624	    a, b, n = docs / "a.md", docs / "b.md", docs / "n.md"
   625	    a.write_bytes(b"a\n")
   626	    b.write_bytes(b"b\n")
   627	    t = rt.Transaction(state)
   628	    t.create(n, b"n\n")
   629	    t.append(a, "a2\n")
   630	    t.append(b, "b2\n")
   631	    real_replace, calls = os.replace, []
   632	
   633	    def second_fails(src, dst, *args, **kwargs):
   634	        calls.append(dst)
   635	        if len(calls) == 2:
   636	            raise OSError(errno.EIO, "injected failure of the 2nd rename")
   637	        return real_replace(src, dst, *args, **kwargs)
   638	    monkeypatch.setattr(rt.os, "replace", second_fails)
   639	    with pytest.raises(rt.RecoveryNeeded, match="recovery manifest is kept"):
   640	        t.commit()
   641	    monkeypatch.undo()
