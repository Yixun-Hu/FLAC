   454	def test_the_lock_refuses_a_concurrent_second_writer(env):
   455	    state, docs = env
   456	    a, b = docs / "a.md", docs / "b.md"
   457	    a.write_bytes(b"a\n")
   458	    b.write_bytes(b"b\n")
   459	    writer = subprocess.Popen(                   # a real first writer, paused inside its commit (holding the lock)
   460	        [sys.executable, "-B", "-c", f"import sys\nsys.path.insert(0, {str(HERE)!r})\nimport records_txn as rt\n"
   461	         f"t = rt.Transaction({str(state)!r})\nt.append({str(b)!r}, 'by the first writer\\n')\n"
   462	         "def pause():\n    print('held', flush=True)\n    sys.stdin.read()\n    return True\n"
   463	         "t.commit(verify=pause)\nprint('first writer committed', flush=True)\n"],
   464	        stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
   465	    try:
   466	        assert writer.stdout.readline().strip() == "held"
   467	        before = snapshot(docs)
   468	        t = rt.Transaction(state)
   469	        t.append(a, "by the second writer\n")
   470	        with pytest.raises(rt.Refused, match="holds the lock"):
   471	            t.commit()
   472	        assert snapshot(docs) == before
   473	        assert not (state / rt.MANIFEST).exists()
   474	    finally:
   475	        writer.stdin.close()
   476	        out = writer.stdout.read()
   477	        writer.wait(timeout=60)
   478	    assert "first writer committed" in out and b.read_bytes() == b"b\nby the first writer\n"
   479	    t = rt.Transaction(state)
   480	    t.append(a, "by the second writer\n")
   481	    t.commit()
   482	    assert a.read_bytes() == b"a\nby the second writer\n"
