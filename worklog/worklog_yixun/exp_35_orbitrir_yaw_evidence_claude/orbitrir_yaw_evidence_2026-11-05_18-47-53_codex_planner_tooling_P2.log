   433	def test_the_verify_hook_runs_under_the_lock(env):
   434	    state, docs = env
   435	    (docs / "a.md").write_bytes(b"a\n")
   436	    seen = []
   437	
   438	    def hook():
   439	        fd = os.open(state / rt.LOCK, os.O_RDWR)
   440	        try:
   441	            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
   442	            seen.append("free")
   443	        except BlockingIOError:
   444	            seen.append("held")
   445	        finally:
   446	            os.close(fd)
   447	        return True
   448	    t = rt.Transaction(state)
   449	    t.append(docs / "a.md", "b\n")
   450	    t.commit(verify=hook)
   451	    assert seen == ["held"] and (docs / "a.md").read_bytes() == b"a\nb\n"
