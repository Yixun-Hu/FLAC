   317	@pytest.mark.parametrize("when", ["during staging", "at the link itself"])
   318	def test_create_never_overwrites_a_destination_that_appears_late(env, monkeypatch, when):
   319	    state, docs = env
   320	    n = docs / "n.md"
   321	    t = rt.Transaction(state)
   322	    t.create(n, b"mine\n")
   323	    if when == "during staging":
   324	        _on_manifest_creation(monkeypatch, lambda: n.write_bytes(b"theirs\n"))
   325	    else:                                        # after every check: only link(2) itself can refuse it
   326	        real_link = os.link
   327	
   328	        def racing_link(src, dst, *args, **kwargs):
   329	            if os.fspath(dst) == str(n.resolve()):
   330	                n.write_bytes(b"theirs\n")
   331	            return real_link(src, dst, *args, **kwargs)
   332	        monkeypatch.setattr(rt.os, "link", racing_link)
   333	    with pytest.raises(rt.Refused, match="before any destination changed"):
   334	        t.commit()
   335	    monkeypatch.undo()
   336	    assert snapshot(docs) == {"n.md": b"theirs\n"}
   337	    assert not (state / rt.MANIFEST).exists()
