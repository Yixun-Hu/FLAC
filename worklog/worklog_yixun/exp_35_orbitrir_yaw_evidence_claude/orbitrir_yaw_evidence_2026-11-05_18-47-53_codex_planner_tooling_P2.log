   306	def _on_manifest_creation(monkeypatch, action):
   307	    """Run `action` at the moment the commit creates its recovery manifest (i.e. after every temp is staged)."""
   308	    real_open = os.open
   309	
   310	    def spy(path, flags, *args, **kwargs):
   311	        if os.fspath(path).endswith(rt.MANIFEST):
   312	            action()
   313	        return real_open(path, flags, *args, **kwargs)
   314	    monkeypatch.setattr(rt.os, "open", spy)
