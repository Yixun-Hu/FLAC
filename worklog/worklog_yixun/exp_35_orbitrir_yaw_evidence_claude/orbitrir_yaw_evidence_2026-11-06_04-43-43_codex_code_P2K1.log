   424	def gpu_map(text):
   425	    """``{index: uuid}`` from ``nvidia-smi --query-gpu=index,uuid``; ValueError when malformed, duplicate or empty."""
   426	    out = {}
   427	    for line in [ln for ln in text.splitlines() if ln.strip()]:
   428	        m = ROW.fullmatch(line)
   429	        if not m or int(m[1]) in out or m[2] in out.values():
   430	            raise ValueError(f"malformed or duplicate nvidia-smi index,uuid row {line!r}")
   431	        out[int(m[1])] = m[2]
