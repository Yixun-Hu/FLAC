  1150	def artifacts(cfg, raw, st, rec):
  1151	    """The transcript parsed exactly; the runner's own log = it, byte for byte; its plan JSON = the re-derived plan;
  1152	    its pre-flight log = the pinned three lines. Fills ``rec`` (paths + sha256, the planned set, the 68 argv)."""
  1153	    cells = snapshot(os.path.join(cfg.run, CELLS))
  1154	    _, m, rows = selection(cells.raw if cells else b"")
  1155	    if m is None:
  1156	        return ["the cells manifest is unreadable"]
  1157	    lanes = tuple(x["index"] for x in st["lanes"])
  1158	    why, info = parse_dry_run(raw.decode(errors="replace"), cfg=cfg, m=m, rows=rows, lanes=lanes)
  1159	    rec.update(ts=info["ts"], n_ids=len(info["ids"]), ids=info["ids"], ids_sha256=names_sha256(info["ids"]),
  1160	               argv_records=info["argv"], benign_lines=info["benign_lines"])
  1161	    want = {"internal_log": raw, "plan": expected_plan(m, rows, run=os.path.realpath(cfg.run), digest=cfg.digest),
  1162	            "preflight": PREFLIGHT.encode()}
  1163	    for key, name in (("internal_log", "eval_run.log"), ("plan", "eval_plan.json"),
  1164	                      ("preflight", "no_flash_preflight.log")):
  1165	        path = os.path.join(cfg.run, X25, f"depth_canon_{info['ts']}_{name}")
  1166	        s = snapshot(path) if info["ts"] else None
  1167	        rec[key] = {"path": path if info["ts"] else None, "sha256": s.sha256 if s else None}
  1168	        ok = s is not None and (_json(s.raw) if key == "plan" else s.raw) == want[key]
  1169	        why += [] if ok else [f"the runner's {key.replace('_', ' ')} {path if info['ts'] else '(no timestamp)'} is not "
  1170	                              "the exact expected bytes"]
  1171	    return why
