   663	def observe(world, cfg, lanes, held=()):
   664	    """ONE observation (§15 item 6; S6): the GPU map is exactly the registered index <-> uuid pair; per lane no compute
   665	    process and no reservation file of any holder -- with ``held``: exactly our record -- and on GPU 1 his s43 table
   666	    job terminally complete; no exp35 or unexplained file on another card; no supervisor, runner, wrapper or
   667	    run-worktree evaluator alive; the supervisor and runner locks unheld. Unreadable inputs raise Unreadable."""
   668	    t, map_raw, apps_raw = world.now(), world.nvsmi("map"), world.nvsmi("apps")
   669	    try:
   670	        m, apps = gpu_map(map_raw), compute_apps(apps_raw)
   671	    except ValueError as err:
   672	        raise Unreadable(f"the nvidia-smi tables: {err}") from err
   673	    mine, cards = {h["uuid"]: h for h in held}, {}
   674	    out = [] if m == CARDS else [f"the GPU map {m} is not the registered {CARDS}"]
   675	    out += [f"compute process {p} sits on an unknown uuid {u}" for p, u in apps if u not in CARDS.values()]
   676	    for i, uuid in CARDS.items():
   677	        pids = sorted(p for p, u in apps if u == uuid)
   678	        res = "held" if uuid in mine else reservation_status(cfg, uuid)
   679	        if i in lanes:
   680	            out += [f"GPU {i} ({uuid}) holds compute process(es) {pids}"] if pids else []
   681	            out += held_reasons(mine[uuid]) if uuid in mine else (
   682	                [] if res == "absent" else [f"GPU {i}: a reservation file exists ({res})"])
   683	            out += table_job_reasons(cfg) if i == 1 else []
   684	        elif res == "present (holder exp35)":
   685	            out.append(f"GPU {i}: an exp35 reservation exists ({res}): a phase-(i) leftover or another phase-(ii) record")
   686	        elif res != "absent" and not res.startswith("present (holder "):
   687	            out.append(f"GPU {i}: an unexplained reservation file ({res})")
   688	        cards[str(i)] = {"uuid": uuid, "pids": pids, "reservation": res}
   689	    locks = {k: lock_status(os.path.join(cfg.run, rel)) for k, rel in (("supervisor", SUP_LOCK), ("runner", RUNNER_LOCK))}
   690	    out += [f"the {k} lock is held" for k, v in locks.items() if v == "held"]
   691	    out += [f"pid {p}: {why}" for p, why in live_procs(cfg)]
   692	    return {"t": t, "iso": iso(t), "map": {str(k): v for k, v in m.items()}, "map_raw": map_raw, "apps_raw": apps_raw,
   693	            "apps_sha256": sha256_bytes(apps_raw.encode()), "cards": cards, "locks": locks, "reasons": out}
