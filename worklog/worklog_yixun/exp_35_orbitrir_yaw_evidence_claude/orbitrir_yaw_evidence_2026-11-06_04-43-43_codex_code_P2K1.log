   924	def _reserve(world, cfg, kit, lanes, report, report_sha256):
   925	    try:
   926	        why, runs = prior(cfg)
   927	        bad, ev = evidence(cfg, lanes=lanes, report=report, report_sha256=report_sha256, prior_runs=runs)
   928	        obs = [observe(world, cfg, lanes)]
   929	        why += bad + obs[0]["reasons"]
   930	        if not why:
   931	            world.sleep(cfg.gap_s)
   932	            obs.append(observe(world, cfg, lanes))
   933	            why += obs[1]["reasons"] + ([] if obs[1]["map"] == obs[0]["map"] else ["the GPU map changed between the "
   934	                                                                                 "two observations"])
   935	    except Unreadable as err:
   936	        why = [f"unreadable: {err}"]
   937	    if why:
   938	        return 1, "RESERVE REFUSED (nothing reserved): " + "; ".join(why)
   939	    run = time.strftime("%Y%m%dT%H%M%S", time.localtime(world.now()))
   940	    orch = os.path.join(cfg.run, X35, ORCH_PREFIX + run)
   941	    st = dict(zip(STATE_KEYS, (1, "exp35_phase_ii", run, kit, ev, ev["lanes"], [], "reserving", obs) + (None,) * 7 + ([],)))
   942	    event(st, world.now(), "reserving: the preconditions held at both observations; the O_EXCL records next")
   943	    os.mkdir(orch)
   944	    write_exclusive(state_path(orch), dumps(st))
   945	    held = []
   946	    try:
   947	        for i in lanes:
   948	            held.append(create_reservation(cfg, i, h35=cfg.h35, run=run, now=world.now()))
   949	        st["observations"].append(observe(world, cfg, lanes, held=held))
   950	        why = st["observations"][-1]["reasons"]
   951	    except FileExistsError:
   952	        why = ["another holder created a lane's reservation at the O_EXCL (a lost race; its file is untouched)"]
   953	    except Unreadable as err:
   954	        why = [f"unreadable: {err}"]
   955	    if not why:
   956	        st.update(phase="reserved", reservations=held)
   957	        event(st, world.now(), "reserved", records=[h["path"] for h in held])
   958	        write_json_atomic(state_path(orch), st)
   959	        return 0, f"RESERVED {orch}: " + "; ".join(f"GPU {h['index']} {h['path']} sha256 {h['sha256']} inode "
   960	                                                   f"{h['inode']}" for h in held) + "; state reserved"
   961	    kept = [dict(h, unreleased=r) for h in held for r in [release_reservation(h)] if r]
   962	    st.update(phase="reserve_failed" if kept else "reserve_refused", reservations=kept,
   963	              failure={"reasons": why, "time": iso(world.now())},
   964	              released={"by": "reserve", "records": [h["path"] for h in held if h["path"] not in
   965	                                                     [k["path"] for k in kept]], "time": iso(world.now())})
   966	    event(st, world.now(), st["phase"], reasons=why)
   967	    write_json_atomic(state_path(orch), st)
   968	    return 1, (f"RESERVE REFUSED after the acquisition ({st['phase']}; our own records released, "
   969	               f"{len(kept)} retained): " + "; ".join(why))
