   108	# --------------------------------------------------------------------------- #
   109	# every wrong manifest / CANON entry is refused (S6 "every wrong pin / hash / cell count / block / dump root /
   110	# CANON entry"); each reason is named even when the sha256 pin already refuses
   111	# --------------------------------------------------------------------------- #
   112	def _mutated(mutation):
   113	    m = json.loads(SB.real_cells())
   114	    sel = [r for r in m["cells"] if r["block"] in K.BLOCKS]
   115	    if mutation == "rows":
   116	        m["cells"].pop()
   117	    elif mutation == "block":
   118	        sel[0]["block"] = "OFF-PX"
   119	    elif mutation == "dump":
   120	        sel[5]["dump"] = False
   121	    elif mutation == "dump_root":
   122	        m["dump_root"] = "/tmp/elsewhere"
   123	    elif mutation == "farm":
   124	        m["farm_root"] = "outputs_FLAC/elsewhere"
   125	    elif mutation == "order":
   126	        sel[0]["order"], sel[1]["order"] = sel[1]["order"], sel[0]["order"]
   127	    elif mutation == "e2fail":
   128	        sel[-1]["block"] = "E2-FAIL"
   129	    elif mutation == "duplicate":
   130	        sel[1]["cell"] = sel[0]["cell"]
   131	    elif mutation == "arm":
   132	        sel[25]["arm"] = "P1"
   133	    elif mutation == "name":
   134	        sel[3]["cell"] += "_x"
   135	    return json.dumps(m, indent=1).encode()
