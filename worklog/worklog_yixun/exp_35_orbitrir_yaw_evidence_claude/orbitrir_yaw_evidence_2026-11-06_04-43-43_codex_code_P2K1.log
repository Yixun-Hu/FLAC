   266	def replace_sh_block(text, values):
   267	    """The shell script ``text`` with ONLY its registered-config block replaced (exactly the block's names)."""
   268	    i = text.index(BEGIN)
   269	    j = text.index(END, i)
   270	    first, body = text[i:text.index("\n", i)], text[text.index("\n", i) + 1:j]
   271	    names = sorted(ln.split("=", 1)[0] for ln in body.splitlines() if ln and not ln.startswith("#"))
   272	    assert sorted(values) == names, (sorted(values), names)
   273	    return text[:i] + first + "\n" + "".join(f"{k}={v}\n" for k, v in values.items()) + text[j:]
