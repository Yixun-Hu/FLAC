   543	def proc_identity(pid, proc):
   544	    """The identity of a LIVE process -- pid, start time, cwd, cmdline sha256, fd 1 / 2 -- read through ONE directory
   545	    fd of /proc/<pid> between two stat reads that must agree; ValueError when gone, unreadable or reused."""
   546	    pid = int(pid)
   547	    try:
   548	        fd = os.open(os.path.join(proc, str(pid)), os.O_RDONLY | os.O_DIRECTORY)
   549	    except OSError as err:
   550	        raise ValueError(f"process {pid}: its /proc identity is unreadable ({type(err).__name__}: {err})") from err
   551	    opener = lambda path, flags: os.open(path, flags, dir_fd=fd)  # noqa: E731
   552	    try:
   553	        with open("stat", opener=opener) as f:
   554	            first = _stat_identity(f.read())
   555	        with open("cmdline", "rb", opener=opener) as f:
   556	            cmdline = f.read()
   557	        links = [os.readlink(p, dir_fd=fd) for p in ("cwd", "fd/1", "fd/2")]
   558	        with open("stat", opener=opener) as f:
   559	            second = _stat_identity(f.read())
   560	    except (OSError, ValueError, IndexError) as err:
   561	        raise ValueError(f"process {pid}: its /proc identity is unreadable ({type(err).__name__}: {err})") from err
   562	    finally:
   563	        os.close(fd)
   564	    if not first == second == (pid, first[1]):
   565	        raise ValueError(f"process {pid}: its /proc entry changed during the sample ({first} -> {second}): PID reuse")
   566	    return {"pid": pid, "start_time": first[1], "cwd": links[0], "cmdline_sha256": sha256_bytes(cmdline),
   567	            "fd1": links[1], "fd2": links[2]}
