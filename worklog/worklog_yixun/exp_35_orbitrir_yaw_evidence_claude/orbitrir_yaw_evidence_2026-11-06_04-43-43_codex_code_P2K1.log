   570	def identity_status(ident, proc):
   571	    """'alive' (its pid runs with its recorded start time), 'gone', or 'reused' (the pid names another process) --
   572	    never by a pid alone; ValueError for an incomplete record, Unreadable for an unreadable live entry."""
   573	    if not (isinstance(ident, dict) and all(k in ident for k in ID_KEYS) and type(ident["pid"]) is int
   574	            and ident["pid"] > 0 and type(ident["start_time"]) is int):
   575	        raise ValueError(f"an incomplete identity {ident!r:.120} identifies no process")
   576	    path = os.path.join(proc, str(ident["pid"]))
   577	    if not os.path.lexists(path):
   578	        return "gone"
   579	    try:
   580	        live = proc_identity(ident["pid"], proc)
   581	    except ValueError as err:
   582	        if not os.path.lexists(path):
   583	            return "gone"
   584	        raise Unreadable(str(err)) from err
   585	    return "alive" if live["start_time"] == ident["start_time"] else "reused"
