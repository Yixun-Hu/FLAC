   296	def phase_i_chunks():
   297	    """exp35_supervisor.py chunk_plan() at H35 as (n, kind, cell, gate): the frozen 33-chunk order."""
   298	    t = lambda k, s, x="": ("cell", f"exp35_BF_T_S40000_K{k}_s{s}{x}", None)  # noqa: E731
   299	    out = [("cell", "exp35_P1_T_S40000_K1_s42", "E1"), ("cell", "exp35_P1_T_S40000_K8_s42", "E1"), t(1, 42),
   300	           ("cell", "exp35_BF_T_S40000_K8_s42", "E2"), ("probe", None, "PROBE")]
   301	    out += [t(k, s) for s in (43, 44, 45, 46) for k in (1, 8)]
   302	    out += [("cell", f"exp35_BF_R_S40000_K{k}_s{s}", None) for s in (42, 43, 44, 45, 46) for k in (1, 8)]
   303	    out += [t(k, 42, "_dup") for k in (1, 8)]
   304	    out += [("cell", f"exp35_BF_C4_S40000_K{k}_s42_th{d}", None) for d in (90, 180, 270, 45) for k in (1, 8)]
   305	    return tuple((i + 1, *c) for i, c in enumerate(out))
