   646	def release_reservation(held):
   647	    """Unlink ``held['path']`` only while it IS our record, through the inode just authenticated, then fsync the
   648	    directory; [] once removed, else the reasons -- and nothing is unlinked."""
   649	    why = held_reasons(held)
