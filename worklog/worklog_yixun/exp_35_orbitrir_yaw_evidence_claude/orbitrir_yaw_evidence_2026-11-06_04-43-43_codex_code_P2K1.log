   275	def tree_digest(repo, paths):
   276	    """The runner's tree_digest: the sha256 of the sorted ``sha256sum`` lines of every tracked + untracked (unignored)
   277	    file under ``paths``. A name the runner's sha256sum would escape (a backslash, a newline) is refused."""
   278	    out = git(repo, "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", *paths, raw=True)
   279	    names = sorted({n for n in out.split(b"\0") if n})
   280	    if not names or any(b"\\" in n or b"\n" in n for n in names):
   281	        raise ValueError(f"the relevant tree of {repo} is empty or holds a name the runner's sha256sum escapes")
   282	    lines = []
   283	    for n in names:
   284	        s = snapshot(os.path.join(repo, os.fsdecode(n)))
   285	        if s is None:
   286	            raise ValueError(f"the relevant file {os.fsdecode(n)} is not a readable regular file")
   287	        lines.append(f"{s.sha256}  {os.fsdecode(n)}")
   288	    return sha256_bytes(("\n".join(lines) + "\n").encode())
