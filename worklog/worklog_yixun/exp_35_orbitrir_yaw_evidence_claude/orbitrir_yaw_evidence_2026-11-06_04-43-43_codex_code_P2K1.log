   503	    """[(pid, why)]: every process that may belong to an exp_35 run -- a supervisor or a runner anywhere, a phase-(ii)
   504	    wrapper, an evaluator or probe in the run worktree (S6: no live phase-(i) identity; release: nothing of ours)."""
   505	    out = []
   506	    for pid, argv in _cmdlines(cfg.scan_proc):
   507	        base = [os.path.basename(a) for a in argv]
