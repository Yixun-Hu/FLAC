   358	def report_fields(raw):
   359	    """(fields, reasons) of the Planner's committed phase-(i) report: each line holding ``exp35-phase-ii`` must be one
   360	    unindented ``exp35-phase-ii <key> <value>`` field; the six REPORT_KEYS exactly once each, nothing else."""
   361	    try:
   362	        lines = raw.decode("utf-8").splitlines()
   363	    except UnicodeDecodeError as err:
   364	        return {}, [f"the report is not UTF-8 ({err})"]
   365	    fields, out = {}, []
   366	    for ln in lines:
   367	        if "exp35-phase-ii" not in ln:
   368	            continue
   369	        m = REPORT_LINE.fullmatch(ln)
   370	        if m is None or m[1] not in REPORT_KEYS or m[1] in fields:
   371	            out.append(f"a malformed, unknown or repeated report line {ln!r}")
   372	            continue
   373	        fields[m[1]] = m[2]
   374	    return fields, out + [f"the report carries no exp35-phase-ii {k} line" for k in REPORT_KEYS if k not in fields]
