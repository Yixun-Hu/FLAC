   291	def tree_dirty(repo, paths):
   292	    """The runner's tree_dirty: '' iff every file under ``paths`` is committed and clean (untracked files count)."""
   293	    return git(repo, "status", "--porcelain", "--untracked-files=all", "--", *paths)
