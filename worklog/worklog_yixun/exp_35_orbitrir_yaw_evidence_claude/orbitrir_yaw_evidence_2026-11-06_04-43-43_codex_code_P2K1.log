  1321	    lock, st = opened
  1322	    try:
  1323	        spec, d, now = launch_spec(cfg, st, orch, lock), st["dry_run"], world.now()
  1324	        r = spec["runner"]
  1325	        why = [] if (d["argv"], d["env"], d["cwd"]) == (r["argv"], dict(r["env"], DRY_RUN="1"), r["cwd"]) else [
  1326	            "the passed dry run is not this exact command"]
  1327	        why += [] if 0 <= now - d["ended"] <= cfg.dry_max_age_s else [
  1328	            f"the dry run ended {now - d['ended']:.0f} s ago: older than {cfg.dry_max_age_s} s, or in the future"]
