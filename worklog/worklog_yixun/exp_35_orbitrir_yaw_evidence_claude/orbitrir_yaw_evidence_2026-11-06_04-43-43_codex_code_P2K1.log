   906	def reserve(world, cfg, *, kit_commit, h35, lanes, report, report_sha256):
   907	    """§15 item 6 + S6: every precondition at TWO observations ``gap_s`` apart, then a fresh orchestration with its
   908	    state 'reserving' (O_EXCL), each lane's O_EXCL record (all or nothing), the observation again AFTER the
   909	    acquisition, then 'reserved'; else 'reserve_refused' (only our exact records released) or 'reserve_failed' (a
   910	    record no longer ours: retained). (rc, message)."""
   911	    why, kit = kit_evidence(cfg, kit_commit)
   912	    why += [] if h35 == cfg.h35 else [f"the given H35 {h35} is not the registered {cfg.h35}"]
   913	    if why:
   914	        return 1, "RESERVE REFUSED (nothing reserved): " + "; ".join(why)
   915	    lock = kit_lock(cfg)
   916	    if lock is None:
   917	        return 1, f"RESERVE REFUSED (nothing reserved): the kit lock {KIT_LOCK} is held (a kit mode or a run lives)"
   918	    try:
   919	        return _reserve(world, cfg, kit, lanes, report, report_sha256)
   920	    finally:
   921	        os.close(lock)
