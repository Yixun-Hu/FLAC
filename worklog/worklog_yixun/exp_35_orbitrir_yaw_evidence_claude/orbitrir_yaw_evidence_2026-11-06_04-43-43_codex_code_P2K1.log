   309	PHASE_I_KEYS = ("schema_version", "campaign", "h35", "cells_sha256", "supervisor_sha256", "approved_sha256", "baseline",
   310	                "his_log_anchor", "lane", "reservation", "chunks", "stop_latch", "events")
   311	GATES = {"E1": ("e1", "equal"), "E2": ("e2", "PASS")}
