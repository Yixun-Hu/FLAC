  1032	def parse_dry_run(text, *, cfg, m, rows, lanes):
  1033	    """S6 'exact dry-run parsing': (reasons, info). Every line must be the next expected one -- the pinned env's one
  1034	    warning line only between preamble lines -- and none may be a SKIP, quarantine, E2-FAIL or refusal line. info: the
  1035	    run's timestamp, the cell ids and the argv records in order, the warning count, the line count."""
  1036	    lines, e2 = text.splitlines(), {c["cell"] for c in m["cells"] if c["block"] == "E2-FAIL"}
  1037	    out = [f"the transcript holds {k}: {v[0][:160]!r}" for k, v in (
  1038	        ("a SKIP line", [ln for ln in lines if "| SKIP" in ln]),
  1039	        ("a quarantine line", [ln for ln in lines if "quarantine" in ln.lower()]),
  1040	        ("an E2-FAIL cell", [ln for ln in lines if "E2-FAIL" in ln or (ln.startswith(("CELL ", "DRYRUN "))
  1041	                                                                       and ln.split()[1:2] and ln.split()[1] in e2)]),
  1042	        ("a refusal", [ln for ln in lines if "abort" in ln or "REFUSED" in ln or "FAILED" in ln])) if v]
  1043	    want, k, ts, ids, argv, benign, broke = _expected_lines(cfg, m, rows, lanes), 0, set(), [], [], 0, False
  1044	    for i, ln in enumerate(lines, 1):
  1045	        if ln == BENIGN and k < 11:
  1046	            benign += 1
  1047	            continue
  1048	        if k == len(want):
  1049	            out, broke = out + [f"line {i} follows the summary: {ln[:160]!r}"], True
  1050	            break
  1051	        w = want[k]
  1052	        if w[0] == "re":
  1053	            hit = re.fullmatch(w[1], ln)
  1054	            ts.update([hit["ts"]] if hit is not None and "ts" in hit.re.groupindex else [])
  1055	        elif w[0] == "eq":
  1056	            hit = ln == w[1]
  1057	            ids += [w[1].split()[1]] if hit and ln.startswith("CELL ") else []
  1058	        else:
  1059	            pre = f"DRYRUN {w[1]} argv: "
  1060	            hit = ln.startswith(pre) and _json(ln[len(pre):]) == w[2]
  1061	            argv += [w[2]] if hit else []
  1062	        if not hit:
  1063	            want_text = f"DRYRUN {w[1]} argv {w[2]}" if w[0] == "argv" else w[1]
  1064	            out, broke = out + [f"line {i} {ln[:200]!r} is not the expected {want_text[:300]!r}"], True
  1065	            break
  1066	        k += 1
  1067	    out += [] if broke or k == len(want) else [f"the transcript ends after {k} of its {len(want)} expected lines"]
  1068	    out += [] if len(ts) == 1 else [f"the transcript names {len(ts)} run timestamps {sorted(ts)}"]
  1069	    out += [] if len(ids) == len(argv) == len(rows) else [f"{len(ids)} cell ids, {len(argv)} argv, not {len(rows)}"]
  1070	    return out, {"ts": min(ts) if len(ts) == 1 else None, "ids": ids, "argv": argv, "benign_lines": benign,

