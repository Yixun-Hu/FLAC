    88	# part 2: the sandbox world -- a fake clock + nvidia-smi answers, a fake /proc tree, sandbox paths
    89	# --------------------------------------------------------------------------- #
    90	MAP = f"0, {GPU0}\n1, {GPU1}\n"
    91	EVAL_DONE_S43 = "EVAL_DONE ACEattn s43 cells=40 2026-11-06T22:00:00-05:00\n"
    92	END_S43 = "2026-11-06T14:31:02-05:00 END training ACEattn s43 exit=0\n"
    93	HOLDER = r'''
    94	import fcntl, os, sys, time
    95	fd = os.open(sys.argv[1], os.O_RDWR | os.O_CREAT, 0o644)
    96	fcntl.flock(fd, fcntl.LOCK_EX)
    97	print("locked", flush=True)
    98	time.sleep(float(sys.argv[2]) if len(sys.argv) > 2 else 60)
    99	'''
   100	
   101	
   102	class FakeWorld:
   103	    """nvidia-smi answers from a dict (a callable answer may raise); a fake clock whose sleep advances it."""
   104	
   105	    def __init__(self, gpu_map=MAP, apps="", t=1_800_000_000.0):
   106	        self.answers = {"map": gpu_map, "apps": apps}
   107	        self.t, self.slept, self.queries = t, [], []
   108	
   109	    def now(self):
   110	        return self.t
   111	
   112	    def sleep(self, s):
   113	        self.slept.append(s)
   114	        self.t += max(0.0, s)
   115	
   116	    def nvsmi(self, query):
   117	        self.queries.append(query)
   118	        a = self.answers[query]
   119	        return a() if callable(a) else a
