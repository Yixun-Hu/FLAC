   122	def fake_proc(root, pid, argv, ppid=1, start=1000, cwd="/somewhere"):
   123	    """One /proc/<pid> entry: cmdline, stat (field 22 = ``start``), cwd and fd/1, fd/2 links."""
   124	    d = os.path.join(str(root), str(pid))
   125	    os.makedirs(os.path.join(d, "fd"))
   126	    with open(os.path.join(d, "cmdline"), "wb") as f:
   127	        f.write(b"".join(a.encode() + b"\0" for a in argv))
   128	    fields = ["S", str(ppid)] + ["0"] * 17 + [str(start)] + ["0"] * 10
   129	    with open(os.path.join(d, "stat"), "w") as f:
   130	        f.write(f"{pid} ({os.path.basename(argv[0])}) " + " ".join(fields) + "\n")
   131	    os.symlink(cwd, os.path.join(d, "cwd"))
   132	    os.symlink("/dev/null", os.path.join(d, "fd", "1"))
   133	    os.symlink("/dev/null", os.path.join(d, "fd", "2"))
   134	    return d
