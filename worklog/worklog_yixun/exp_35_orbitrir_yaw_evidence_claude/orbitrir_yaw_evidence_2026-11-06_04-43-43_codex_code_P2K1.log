    42	def block_values(path):
    43	    """The literal assignments of a kit file's registered-config block (the only part a sandbox replaces)."""
    44	    with open(path) as f:
    45	        text = f.read()
    46	    i = text.index(BEGIN)
    47	    body = text[text.index("\n", i) + 1:text.index(END, i)]
    48	    out = {}
    49	    for node in ast.parse(body).body:
    50	        names = node.targets[0].elts if isinstance(node.targets[0], ast.Tuple) else node.targets
    51	        vals = node.value.elts if isinstance(node.value, ast.Tuple) and len(names) > 1 else [node.value]
    52	        out.update({n.id: ast.literal_eval(v) for n, v in zip(names, vals)})
    53	    return out
