   881	        if exclude is not None and os.path.realpath(d) == os.path.realpath(exclude):
   882	            continue
   883	        if not isinstance(st, dict) or st["phase"] not in RESOLVED:
   884	            why.append(f"the orchestration {d} is unresolved ({st if not isinstance(st, dict) else st['phase']})")
   885	        if isinstance(st, dict) and st["launch"] is not None:
   886	            runs.append(st["run"])
