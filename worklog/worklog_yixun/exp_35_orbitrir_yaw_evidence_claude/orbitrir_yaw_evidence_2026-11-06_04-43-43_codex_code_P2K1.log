   316	    kit_dir, commit = make_kit(tmp_path, report, files=files)
   317	    for rel in (f"{X25}/.depth_canon_eval.lock",):
   318	        open(os.path.join(run, rel), "w").close()
   319	    rsha = hashlib.sha256(report.encode()).hexdigest()
   320	    return types.SimpleNamespace(cfg=cfg, run=run, head=head, digest=digest, state_sha=state_sha, kit_dir=kit_dir,
   321	                                 commit=commit, report=REPORT_REL, report_sha=rsha, tmp=str(tmp_path),
