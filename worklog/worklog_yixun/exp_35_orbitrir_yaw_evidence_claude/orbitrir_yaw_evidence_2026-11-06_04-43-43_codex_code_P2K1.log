   107	
   108	def snapshot(path):
   109	    """ONE no-follow read of the regular file ``path``: its bytes, their sha256, its (device, inode); None when it
   110	    is absent, a symlink, not a regular file or unreadable."""
   111	    try:
   112	        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
   113	    except (OSError, TypeError):
   114	        return None
   115	    try:
   116	        st, chunks = os.fstat(fd), []
   117	        if not stat.S_ISREG(st.st_mode):
   118	            return None
   119	        while True:
   120	            chunk = os.read(fd, 1 << 20)
   121	            if not chunk:
   122	                break
   123	            chunks.append(chunk)
   124	    except OSError:
   125	        return None
   126	    finally:
   127	        os.close(fd)
   128	    raw = b"".join(chunks)
   129	    return Snap(raw, sha256_bytes(raw), st.st_dev, st.st_ino)
   130	
   131	
   132	def fsync_dir(d):
   133	    fd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
   134	    try:
   135	        os.fsync(fd)
   136	    finally:
   137	        os.close(fd)
   138	
   139	
   140	def write_exclusive(path, raw):
   141	    """O_CREAT | O_EXCL (any existing name, a dangling link included, refuses), fully written, the file and its
   142	    directory fsynced: the Snap of exactly the bytes written."""
   143	    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
   144	    try:
   145	        view = memoryview(raw)
   146	        while view:
   147	            view = view[os.write(fd, view):]
   148	        os.fsync(fd)
   149	        st = os.fstat(fd)
   150	    finally:
   151	        os.close(fd)
   152	    fsync_dir(os.path.dirname(os.path.abspath(path)))
   153	    return Snap(raw, sha256_bytes(raw), st.st_dev, st.st_ino)
