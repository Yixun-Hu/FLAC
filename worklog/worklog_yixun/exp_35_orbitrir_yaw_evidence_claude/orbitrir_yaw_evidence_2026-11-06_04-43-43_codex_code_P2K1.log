   491	def _in_run(proc, pid, run):
   492	    try:
   493	        cwd = os.path.realpath(os.readlink(os.path.join(proc, str(pid), "cwd")))
   494	    except FileNotFoundError:
   495	        return False
   496	    except OSError as err:
   497	        raise Unreadable(f"the cwd of process {pid} is unreadable ({err})") from err
   498	    root = os.path.realpath(run)
   499	    return cwd == root or cwd.startswith(root + os.sep)
