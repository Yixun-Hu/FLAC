   245	def parse_lanes(text):
   246	    """The frozen lane list: one or two distinct registered GPU indices, comma-separated ('0', '0,1', '1,0')."""
   247	    if not isinstance(text, str) or not re.fullmatch(r"[0-9](,[0-9])?", text):
   248	        raise ValueError(f"the lane list {text!r} is not one or two comma-separated GPU indices")
   249	    lanes = tuple(int(x) for x in text.split(","))
   250	    if len(set(lanes)) != len(lanes) or any(i not in CARDS for i in lanes):
   251	        raise ValueError(f"the lane list {text!r} repeats a GPU or names an index outside {sorted(CARDS)}")
   252	    return lanes
