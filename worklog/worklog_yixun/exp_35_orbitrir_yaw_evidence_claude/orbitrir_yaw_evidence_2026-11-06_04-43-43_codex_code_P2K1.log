    64	def completed_state(**over):
    65	    """The real snapshot carried to a completed phase (i) exactly as the supervisor ends it: every chunk
    66	    gates_verified (the plain cell chunks shaped like the real chunk 13), the lane and the reservation None, the
    67	    final release event last. ``over`` replaces top-level keys (h35, campaign_digest of every chunk, ...)."""
    68	    doc = snapshot_state()
    69	    proto = copy.deepcopy(doc["chunks"][12])                                # a real plain gates_verified cell chunk
    70	    for c in doc["chunks"]:
    71	        if c["state"] != "gates_verified":
    72	            n, cell = c["n"], c["cell"]
    73	            c.clear()
    74	            c.update(copy.deepcopy(proto), n=n, cell=cell)
    75	    doc["lane"] = doc["reservation"] = None
    76	    t = doc["events"][-1]["t"] + 50000.0
    77	    doc["events"].append({"t": t, "time": "2026-11-06T11:20:00-05:00", "what": FINAL_EVENT})
    78	    digest = over.pop("campaign_digest", None)
    79	    if digest is not None:
    80	        for c in doc["chunks"]:
    81	            if "campaign_digest" in c:
    82	                c["campaign_digest"] = digest
    83	    doc.update(over)
    84	    return doc
