   472	def _cmdlines(proc):
   473	    """(pid, argv) of every process but this one; a vanished entry is skipped, an unreadable one is Unreadable."""
   474	    try:
   475	        names = os.listdir(proc)
   476	    except OSError as err:
   477	        raise Unreadable(f"{proc} is unreadable ({err})") from err
   478	    for n in names:
   479	        if not n.isdigit() or int(n) == os.getpid():
   480	            continue
   481	        try:
   482	            with open(os.path.join(proc, n, "cmdline"), "rb") as f:
   483	                raw = f.read()
   484	        except (FileNotFoundError, ProcessLookupError):
   485	            continue
   486	        except OSError as err:
   487	            raise Unreadable(f"{proc}/{n}/cmdline is unreadable ({err})") from err
   488	        yield int(n), [a.decode(errors="replace") for a in raw.split(b"\0") if a]
