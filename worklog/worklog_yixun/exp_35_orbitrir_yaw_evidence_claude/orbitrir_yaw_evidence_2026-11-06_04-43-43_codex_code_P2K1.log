   894	def kit_lock(cfg):
   895	    """The kit's single-instance lock (LOCK_EX | LOCK_NB): its fd, or None while another process holds it -- a kit
   896	    mode, our detached wrapper, or a runner / evaluator descendant that inherited it."""
   897	    fd = os.open(os.path.join(cfg.run, KIT_LOCK), os.O_RDWR | os.O_CREAT, 0o644)
   898	    try:
   899	        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
   900	    except BlockingIOError:
   901	        os.close(fd)
   902	        return None
   903	    return fd
