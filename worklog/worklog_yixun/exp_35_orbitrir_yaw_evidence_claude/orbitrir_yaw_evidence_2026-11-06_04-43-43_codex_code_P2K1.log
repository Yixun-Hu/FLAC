   314	def phase_i_reasons(doc, *, h35, digest, supervisor_sha256):
   315	    """§15 item 4: [] iff ``doc`` is the supervisor's state of a COMPLETE phase (i) -- schema v1 at H35, the 33 frozen
   316	    chunks gates_verified with rc 0 (or adopted at a restart), E1 equal, E2 PASS, the probe contract rc 0, ONE
   317	    campaign digest, no stop latch, no lane and no reservation, the final release event last."""
   318	    if not isinstance(doc, dict) or list(doc) != list(PHASE_I_KEYS):
   319	        return [f"the phase-(i) state's keys are not the supervisor's schema-v1 keys {list(PHASE_I_KEYS)}"]
   320	    out = [f"phase (i) {k} {doc[k]!r} != {v!r}" for k, v in (
   321	        ("schema_version", 1), ("campaign", "exp35"), ("h35", h35), ("cells_sha256", CELLS_SHA256),
   322	        ("supervisor_sha256", supervisor_sha256)) if doc[k] != v]
   323	    ch = doc["chunks"]
   324	    if not (isinstance(ch, list) and all(isinstance(c, dict) for c in ch)
   325	            and [tuple(c.get(k) for k in ("n", "kind", "cell", "gate")) for c in ch] == list(PHASE_I_CHUNKS)):
   326	        return out + ["the phase-(i) chunks are not the frozen 33-chunk order"]
   327	    for c in ch:
   328	        n, rc_key = c["n"], "probe_rc" if c["kind"] == "probe" else "runner_rc"
   329	        if c.get("state") != "gates_verified":
   330	            out.append(f"chunk {n} is {c.get('state')}, not gates_verified")
   331	            continue
   332	        rc, adopted = c.get(rc_key), c.get("adopted_at_restart") is True
   333	        if not ((type(rc) is int and rc == 0) or (adopted and rc is None)):
   334	            out.append(f"chunk {n}: {rc_key} {rc!r} (not 0, nor a chunk adopted at a restart)")
   335	        if c["gate"] in GATES:
   336	            key, want = GATES[c["gate"]]
   337	            r = c.get(key) if isinstance(c.get(key), dict) else {}
   338	            if not (r.get("rc") == 0 and r.get("verdict") == want):
   339	                out.append(f"chunk {n}: {c['gate']} is {r.get('verdict')!r} (rc {r.get('rc')!r}), not {want}")
   340	        if c["gate"] == "PROBE" and not (isinstance(c.get("probe_contract"), dict) and c["probe_contract"].get("rc") == 0):
   341	            out.append(f"chunk {n}: the probe contract is {c.get('probe_contract')!r:.80}, not rc 0")
   342	    digests = sorted({str(c.get("campaign_digest")) for c in ch if c["kind"] == "cell"})
