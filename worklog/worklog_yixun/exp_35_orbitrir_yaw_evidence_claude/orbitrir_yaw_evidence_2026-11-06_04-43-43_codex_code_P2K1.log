  1111	def dry_run(world, cfg, *, kit_commit, h35, orch):
  1112	    """§15 item 7: from 'reserved' only -- the recheck, the EXACT runner command under DRY_RUN=1, its transcript parsed
  1113	    exactly and its own artifacts checked; then 'dry_run_passed', or 'dry_run_failed' (retained). (rc, message)."""
  1114	    opened, why = open_mode(cfg, kit_commit, h35, orch, ("reserved",))
  1115	    if opened is None:
  1116	        return 1, "DRY RUN REFUSED (nothing changed): " + "; ".join(why)
  1117	    lock, st = opened
  1118	    try:
  1119	        argv, env, cwd = runner_command(cfg, tuple(x["index"] for x in st["lanes"]), dry=True)
  1120	        rec = {"argv": argv, "env": env, "cwd": cwd, "started": world.now()}
  1121	        try:
  1122	            why, rec["before"] = recheck(world, cfg, st, orch)
  1123	            if not why:
  1124	                p = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
  1125	                                     stderr=subprocess.STDOUT)
  1126	                raw = p.communicate()[0]                                         # no timeout: never killed
  1127	                path = os.path.join(orch, "dry_run_runner.log")
  1128	                rec.update(rc=p.returncode, ended=world.now(), outer_log={
  1129	                    "path": path, "sha256": write_exclusive(path, raw).sha256, "bytes": len(raw)})
  1130	                why = [f"the dry run exited rc {p.returncode}"] if p.returncode else []
  1131	                why += artifacts(cfg, raw, st, rec)
  1132	                more, rec["after"] = recheck(world, cfg, st, orch)
  1133	                why += more
  1134	        except Unreadable as err:
  1135	            why = [f"unreadable: {err}"]
  1136	        except OSError as err:                           # the runner could not be spawned, or its log written
  1137	            why = [f"the dry run could not be spawned or its outer log written ({err})"]
  1138	        st.update(phase="dry_run_failed" if why else "dry_run_passed", dry_run=dict(rec, reasons=why),
  1139	                  failure={"reasons": why, "time": iso(world.now())} if why else None)
  1140	        event(st, world.now(), st["phase"], reasons=why[:5])
  1141	        write_json_atomic(state_path(orch), st)
  1142	    finally:
  1143	        os.close(lock)
  1144	    if why:
  1145	        return 1, "DRY RUN FAILED (retained; release, then reserve anew): " + "; ".join(why)
  1146	    return 0, (f"DRY RUN PASSED: {rec['n_ids']} cells, {len(rec['argv_records'])} argv, the runner's log, plan and "
  1147	               "pre-flight exact")
