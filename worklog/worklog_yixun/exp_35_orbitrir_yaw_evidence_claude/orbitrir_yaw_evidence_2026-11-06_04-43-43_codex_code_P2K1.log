   181	def selection(raw):
   182	    """(reasons, manifest, rows): the cells manifest at its pin and its 68 phase-(ii) rows in manifest order."""
   183	    out = [] if sha256_bytes(raw) == CELLS_SHA256 else [
   184	        f"the cells manifest hashes to {sha256_bytes(raw)}, not the pin {CELLS_SHA256}"]
   185	    try:
   186	        m = json.loads(raw)
   187	        cells = m["cells"]
   188	        rows = [c for c in cells if c["block"] in BLOCKS]
   189	        e2 = [c["order"] for c in cells if c["block"] == "E2-FAIL"]
   190	        names = [c["cell"] for c in rows]
   191	    except (ValueError, KeyError, TypeError) as err:
   192	        return out + [f"the cells manifest is not the generator's schema ({err!r:.120})"], None, []
   193	    counts = dict(collections.Counter(c["block"] for c in rows))
   194	    out += [why for why, bad in (
   195	        (f"the cells manifest has {len(cells)} rows, not {N_ROWS}", len(cells) != N_ROWS),
   196	        (f"the manifest's dump root {m.get('dump_root')!r} is not {DUMP_ROOT}", m.get("dump_root") != DUMP_ROOT),
   197	        (f"the manifest's farm root {m.get('farm_root')!r} is not {FARM}", m.get("farm_root") != FARM),
   198	        (f"the selected blocks count {counts}, not {COUNTS}", counts != COUNTS),
   199	        (f"the selected rows' orders are not {ORDERS[0]}..{ORDERS[-1]}", [c.get("order") for c in rows] != list(ORDERS)),
   200	        (f"the E2-FAIL rows' orders are {e2}, not {E2_FAIL_ORDERS[0]}..{E2_FAIL_ORDERS[-1]}", e2 != list(E2_FAIL_ORDERS)),
   201	        ("the selected names are not distinct", len(set(names)) != len(names)),
   202	        (f"the selected names digest to {names_sha256(names)}, not {NAMES_SHA256}", names_sha256(names) != NAMES_SHA256))
   203	        if bad]
   204	    out += [f"{c['cell']}: dump is {c.get('dump')!r}, not True" for c in rows if c.get("dump") is not True]
   205	    out += [f"{c['cell']}: arm {c.get('arm')} is not the {c['block']} arm {BLOCK_ARM[c['block']]}" for c in rows
   206	            if c.get("arm") != BLOCK_ARM[c["block"]]]
   207	    return out, m, rows
