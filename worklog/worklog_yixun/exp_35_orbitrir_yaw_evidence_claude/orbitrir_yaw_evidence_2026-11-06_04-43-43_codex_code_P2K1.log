  1101	def recheck(world, cfg, st, orch):
  1102	    """Every precondition again, the evidence unchanged since the reservation, the held records ours: (reasons, obs)."""
  1103	    lanes = tuple(x["index"] for x in st["lanes"])
  1104	    why, runs = prior(cfg, exclude=orch)
  1105	    bad, ev = evidence(cfg, lanes=lanes, report=st["evidence"]["report"]["path"],
  1106	                       report_sha256=st["evidence"]["report"]["sha256"], prior_runs=runs)
  1107	    o = observe(world, cfg, lanes, held=st["reservations"])
  1108	    return why + bad + ([] if ev == st["evidence"] else ["the evidence changed since the reservation"]) + o["reasons"], o
