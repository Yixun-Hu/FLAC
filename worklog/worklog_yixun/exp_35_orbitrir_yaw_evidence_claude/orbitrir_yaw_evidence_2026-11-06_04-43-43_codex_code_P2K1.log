   395	class World:
   396	    """The real world: wall time, sleep and nvidia-smi (every failure is Unreadable)."""
   397	    QUERIES = {"map": "--query-gpu=index,uuid", "apps": "--query-compute-apps=pid,gpu_uuid"}
   398	
   399	    def __init__(self, nvidia_smi):
