  1078	def open_mode(cfg, kit_commit, h35, orch, phases):
  1079	    """dry-run / launch / release: the self-pin, the H35 argument, an orchestration of THIS run worktree, the kit lock,
  1080	    its state in ``phases`` and reserved with this very kit commit. ((lock fd, state), []) or (None, reasons)."""
  1081	    why = kit_evidence(cfg, kit_commit)[0] + (
  1082	        [] if h35 == cfg.h35 else [f"the given H35 {h35} is not the registered {cfg.h35}"])
  1083	    base = os.path.realpath(os.path.join(cfg.run, X35))
  1084	    why += [] if os.path.dirname(os.path.realpath(orch)) == base else [f"{orch} is not an orchestration of {base}"]
  1085	    lock = None if why else kit_lock(cfg)
  1086	    if lock is None:
  1087	        return None, why or [f"the kit lock {KIT_LOCK} is held (a kit mode, our wrapper or a runner child lives)"]
  1088	    try:
  1089	        st = load_state(orch)
  1090	        why = ([] if st["phase"] in phases else [f"the state is {st['phase']}, not {' or '.join(phases)}"]) + (
  1091	            [] if st["kit"]["commit"] == kit_commit else [
  1092	                f"the orchestration was reserved with the kit {st['kit']['commit']}"])
  1093	    except ValueError as err:
  1094	        why = [str(err)]
  1095	    if why:
  1096	        os.close(lock)
  1097	        return None, why
  1098	    return (lock, st), []
