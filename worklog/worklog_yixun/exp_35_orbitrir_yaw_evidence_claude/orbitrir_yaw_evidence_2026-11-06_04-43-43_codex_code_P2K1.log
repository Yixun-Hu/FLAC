   266	def git(repo, *args, raw=False):
   267	    """A read-only git query (no optional locks: a status never rewrites the index); ValueError when it fails."""
   268	    r = subprocess.run(["git", "--no-optional-locks", "-C", repo, *args], capture_output=True, timeout=600)
   269	    if r.returncode != 0:
   270	        raise ValueError(f"git {' '.join(args[:2])} in {repo} failed (rc {r.returncode}): "
   271	                         f"{r.stderr.decode(errors='replace').strip()[:200]}")
   272	    return r.stdout if raw else r.stdout.decode()
