   160	def write_json_atomic(path, doc):
   161	    """A temp file beside ``path``, fsync, rename over it, fsync the directory: the old or the new state, whole."""
   162	    d = os.path.dirname(os.path.abspath(path))
   163	    fd, tmp = tempfile.mkstemp(prefix=".exp35_phase_ii_state.", dir=d)
   164	    try:
   165	        with os.fdopen(fd, "wb") as f:
   166	            f.write(dumps(doc))
   167	            f.flush()
   168	            os.fsync(f.fileno())
   169	        os.replace(tmp, path)
   170	    except BaseException:
   171	        if os.path.exists(tmp):
   172	            os.unlink(tmp)
   173	        raise
   174	    fsync_dir(d)
