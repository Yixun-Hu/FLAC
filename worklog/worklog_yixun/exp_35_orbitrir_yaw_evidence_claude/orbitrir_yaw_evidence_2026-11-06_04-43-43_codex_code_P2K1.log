   448	def lock_status(path):
   449	    """'absent' | 'unheld' | 'held': opened O_RDONLY (never created), LOCK_SH | LOCK_NB, closed at once (no lock
   450	    outlives the probe); Unreadable on any other error."""
   451	    try:
   452	        fd = os.open(path, os.O_RDONLY)
   453	    except FileNotFoundError:
   454	        return "absent"
   455	    except OSError as err:
   456	        raise Unreadable(f"the lock {path} is unreadable ({err})") from err
   457	    try:
   458	        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
   459	        return "unheld"
   460	    except BlockingIOError:
   461	        return "held"
   462	    except OSError as err:
   463	        raise Unreadable(f"the lock {path} cannot be probed ({err})") from err
   464	    finally:
   465	        os.close(fd)
