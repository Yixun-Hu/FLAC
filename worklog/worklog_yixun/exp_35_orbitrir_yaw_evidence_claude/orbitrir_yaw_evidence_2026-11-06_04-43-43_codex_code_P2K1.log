   344	    out += [why for why, bad in (
   345	        (f"the stop latch is set: {doc['stop_latch']!r:.120}", doc["stop_latch"] is not None),
   346	        (f"the phase-(i) lane is still set: {doc['lane']!r}", doc["lane"] is not None),
   347	        (f"the phase-(i) reservation is still held: {doc['reservation']!r:.160}", doc["reservation"] is not None)) if bad]
   348	    ev = doc["events"]
   349	    last = ev[-1].get("what") if isinstance(ev, list) and ev and isinstance(ev[-1], dict) else None
