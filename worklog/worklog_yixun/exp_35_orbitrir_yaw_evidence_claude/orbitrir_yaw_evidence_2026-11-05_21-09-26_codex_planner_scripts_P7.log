     1	#!/usr/bin/env bash
     2	# exp_35 phase (i) watcher v2 (Planner; READ-ONLY: never signals, kills or writes anything; revised after Codex P6).
     3	# Exits -- one notification -- on: the supervisor gone or no longer the launched process (pid + start time + cwd + H35);
     4	# a stop latch in the state (.stop_latch != null) or an anchored "[<iso>] STOP LATCH" event line in its log; the log
     5	# replaced (device:inode changed); the state unreadable / malformed; or >= N gates_verified chunks.
     6	# Usage: bash exp35_phase_i_watch_v2.sh <pid> <start time> <H35> <supervisor log> <state json> <N> [poll s, 10..600]
     7	set -u
     8	PID="$1"; START="$2"; H35="$3"; LOG="$4"; STATE="$5"; N="$6"; POLL="${7:-60}"
     9	RUN=/home/yixunhu/codespace/exp-35-orbitrir-yaw
    10	bad() { echo "EVENT: WATCHER ARGUMENT ERROR: $*"; exit 2; }
    11	[[ "$PID" =~ ^[0-9]+$ ]] || bad "pid $PID"; [[ "$START" =~ ^[0-9]+$ ]] || bad "start time $START"
    12	[[ "$H35" =~ ^[0-9a-f]{40}$ ]] || bad "H35 $H35"; [[ "$N" =~ ^[0-9]+$ ]] && [ "$N" -ge 1 ] && [ "$N" -le 33 ] || bad "N $N"
    13	[[ "$POLL" =~ ^[0-9]+$ ]] && [ "$POLL" -ge 10 ] && [ "$POLL" -le 600 ] || bad "poll $POLL"
    14	INODE="$(stat -c '%d:%i' -- "$LOG" 2>/dev/null)" || bad "log $LOG unreadable"
    15	same_process() {
    16	  [ "$(awk '{print $22}' "/proc/$PID/stat" 2>/dev/null)" = "$START" ] || return 1
    17	  [ "$(readlink "/proc/$PID/cwd" 2>/dev/null)" = "$RUN" ] || return 1
    18	  tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null | grep -qx -- "$H35" || return 1
    19	}
    20	event=""
    21	while :; do
    22	  if ! same_process; then event="the supervisor (pid $PID, start $START) is gone or no longer the launched process"; break; fi
    23	  if [ "$(stat -c '%d:%i' -- "$LOG" 2>/dev/null)" != "$INODE" ]; then event="the supervisor log $LOG was replaced or removed"; break; fi
    24	  if grep -q -E '^\[[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}[-+][0-9:]{5}\] STOP LATCH' "$LOG" 2>/dev/null; then event="a STOP LATCH event in the log"; break; fi
    25	  out="$(jq -e -r '(if .stop_latch != null then "LATCH" else "OK" end) + " " + ([.chunks[] | select(.state == "gates_verified")] | length | tostring)' "$STATE" 2>&1)"
    26	  if [ $? -ne 0 ] || ! [[ "$out" =~ ^(LATCH|OK)\ [0-9]+$ ]]; then event="the state is unreadable or malformed: ${out:0:200}"; break; fi
    27	  read -r latch n <<<"$out"
    28	  if [ "$latch" = LATCH ]; then event="the state holds a stop latch"; break; fi
    29	  if [ "$n" -ge "$N" ]; then event="milestone: $n chunks gates_verified (>= $N)"; break; fi
    30	  sleep "$POLL"
    31	done
    32	echo "EVENT: $event"
    33	date -Is
    34	jq -c '{latch: .stop_latch, lane: .lane, states: [.chunks[] | .state]}' "$STATE" 2>&1 | cut -c1-900
    35	tail -n 6 "$LOG" 2>&1 | cut -c1-300

