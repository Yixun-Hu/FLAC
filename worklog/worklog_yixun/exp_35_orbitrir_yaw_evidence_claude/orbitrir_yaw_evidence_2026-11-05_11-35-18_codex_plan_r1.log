   448	def _sha256_file(path):
   449	    import hashlib
   450	    h = hashlib.sha256()
   451	    with open(path, "rb") as f:
   452	        for chunk in iter(lambda: f.read(1 << 20), b""):
   453	            h.update(chunk)
   454	    return h.hexdigest()
