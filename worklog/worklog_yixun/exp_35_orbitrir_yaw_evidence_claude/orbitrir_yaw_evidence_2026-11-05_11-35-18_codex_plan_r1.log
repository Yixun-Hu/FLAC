  1087	def _arm_tier3(idx, arm, k, agg, key):
  1088	    v = lambda e: _value(e, key, agg)  # noqa: E731
  1089	    z = {s: idx.get((arm, "F", k, s, 40000, 0)) for s in SEEDS}
  1090	    c4 = [idx.get((arm, "F", k, 42, 40000, d)) for d in (0, 90, 180, 270)]
  1091	    p45, rr = idx.get((arm, "F", k, 42, 40000, 45)), {s: idx.get((arm, "R", k, s, 40000, None)) for s in SEEDS}
  1092	    zs = _stats([v(e) for e in z.values() if e])
  1093	    ok_c4 = all(_same_items(e, c4[0]) for e in c4)
  1094	    d = [v(rr[s]) - v(z[s]) for s in SEEDS if _same_items(rr[s], z[s])]
  1095	    return {"n_z": zs["n"], "mean_z": zs["mean"], "sd_z": zs["sd"],
  1096	            "c4_values": [v(e) for e in c4] if ok_c4 else None,
  1097	            "delta_c4": (max(v(e) for e in c4) - min(v(e) for e in c4)) if ok_c4 else None,
  1098	            "probe45": v(p45) - v(c4[0]) if _same_items(p45, c4[0]) else None,
  1099	            "n_r_pairs": len(d), "delta_r": (sum(d) / len(d)) if len(d) == len(SEEDS) else None,
  1100	            "sd_r_pairs": _stats(d)["sd"]}
