  1103	def tier3(cells):
  1104	    """Tier 3 per arm, K, aggregation and metric, plus the CANON-vs-P1 PASS checks
  1105	    (``pass`` None when an input is missing -- never a silent PASS)."""
  1106	    idx = _index(cells)
  1107	    arms = {a: {k: {agg: {key: _arm_tier3(idx, a, k, agg, key) for key in TIER3_KEYS} for agg in AGGS}
  1108	                for k in (1, 8)} for a in ("CANON", "P1", "YAW")}
  1109	    checks = []
  1110	    for k in (1, 8):
  1111	        for key in TIER3_KEYS:
  1112	            c, p = arms["CANON"][k]["item"][key], arms["P1"][k]["item"][key]
  1113	            known = None not in (c["delta_c4"], p["delta_c4"], c["delta_r"], c["sd_z"])
  1114	            checks.append({"K": k, "metric": key, "computable": known,
  1115	                           "pass_c4": known and c["delta_c4"] <= TIER3_FRACTION * p["delta_c4"],
  1116	                           "pass_r": known and abs(c["delta_r"]) <= c["sd_z"]})
  1117	    verdict = None if not all(c["computable"] for c in checks) else all(
  1118	        c["pass_c4"] and c["pass_r"] for c in checks)
  1119	    return {"arms": arms, "checks": checks, "pass": verdict,
  1120	            "rule": f"Delta_C4(CANON) <= {TIER3_FRACTION:g} x Delta_C4(P1-pin) and |Delta_R(CANON)| <= "
  1121	                    "sd(m_Z CANON), every metric, both K, item-weighted"}
