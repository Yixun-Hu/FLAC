   788	def _tier1_pair(p, cells):
   789	    if not (p["valid"] and p["ref"]):
   790	        return {**p, "n": 0, "n_equal": 0, "canonical_depth_hash_equal": False, "pass": False}
   791	    pa, pb = cells[p["cell"]]["canon"]["positions"], cells[p["ref"]]["canon"]["positions"]
   792	    n_equal = sum(1 for x, y in zip(pa, pb) if x[1] == y[1] and x[4] == y[4])
   793	    digest = lambda pos: eval_FLAC.canonical_stream_hash([[x[1], x[4]] for x in pos])  # noqa: E731
   794	    same = digest(pa) == digest(pb)
   795	    return {**p, "n": len(pa), "n_equal": n_equal, "canonical_depth_hash_equal": same,
   796	            "pass": bool(p["input_hash_equal"] and same and n_equal == len(pa) == len(pb))}
