   481	def build_report(registered, deviations, prov, stream, rep):
   482	    """The published report, in main()'s layout: the probe ``rep`` with the per-item stream
   483	    identity merged into ``items``, its provenance and the stream's input hash."""
   484	    rep = dict(rep, items=[dict(position=i, target_id=row.target_id, context_ids=row.context_ids, **t)
   485	                           for i, (row, t) in enumerate(zip(stream.rows, rep["items"]))])
   486	    return {"schema_version": SCHEMA_VERSION, "registered": registered,
   487	            "deviations": deviations + ([] if registered or deviations else ["--diagnostic given"]),
   488	            "provenance": prov, "stream_input_hash": stream.input_hash(), **rep}
