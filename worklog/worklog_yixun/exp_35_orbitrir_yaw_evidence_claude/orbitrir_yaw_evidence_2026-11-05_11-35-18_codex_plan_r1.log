  1291	def source_sha():
  1292	    """Short-circuited ``git rev-parse HEAD`` for provenance; ``'unknown'`` if git
  1293	    is unavailable. Provenance must never be able to break an evaluation."""
  1294	    try:
  1295	        out = subprocess.check_output(
  1296	            ["git", "rev-parse", "HEAD"], cwd=os.path.dirname(os.path.abspath(__file__)),
  1297	            stderr=subprocess.DEVNULL, timeout=10,
  1298	        )
  1299	        return out.decode().strip() or "unknown"
  1300	    except Exception:
  1301	        return "unknown"
  1302	
