   768	def context_replacement(cells):
   769	    """The registered context-uniqueness rule (rB-F1 NIT a): AR_md draws the K references without
   770	    replacement unless the room has fewer than K other sources, and then WITH replacement (ids
   771	    repeat). Which targets repeat is a property of the split, not of the seed (520 / 6,337 unseen
   772	    K=8 targets in every one of exp_15's eleven streams), so every valid cell of a (split, K)
   773	    must repeat on exactly the same targets."""
   774	    by = {}
   775	    for name, e in cells.items():
   776	        if e["valid"]:
   777	            r = e["row"]
   778	            hit = tuple(sorted(t[1] for t in e["stream"]["input_tuples"] if len(set(t[2])) != len(t[2])))
   779	            by.setdefault(f"{r['split']}/K{r['K']}", {}).setdefault(hit, []).append(name)
   780	    return {key: {"cells": sum(len(v) for v in sets.values()),
   781	                  "targets_with_repeated_context": len(next(iter(sets))) if len(sets) == 1 else None,
   782	                  "consistent": len(sets) == 1} for key, sets in sorted(by.items())}
