   160	PROTOCOLS = {"fp32": {"cond_autocast": "off", "matmul_precision": "highest"},
   161	             "eval": {"cond_autocast": "bf16", "matmul_precision": "medium"}}
   162	
   163	
   164	@contextlib.contextmanager
   165	def matmul_precision(value):
   166	    old = torch.get_float32_matmul_precision()
   167	    torch.set_float32_matmul_precision(value)
   168	    try:
   169	        yield
   170	    finally:
   171	        torch.set_float32_matmul_precision(old)
