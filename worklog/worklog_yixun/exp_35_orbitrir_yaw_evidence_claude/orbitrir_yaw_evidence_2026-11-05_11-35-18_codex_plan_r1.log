   118	def _rows(t):
   119	    """``[B, ...]`` tensor -> float64 CPU ``[B, prod(rest)]`` numpy (bf16 included)."""
   120	    t = t.detach().to(device="cpu", dtype=torch.float64)
   121	    return t.reshape(t.shape[0], -1).numpy()
