  1059	def _value(entry, key, agg):
  1060	    rec = entry["record"]
  1061	    if agg == "item":
  1062	        return float(rec["metrics"][key])
  1063	    return sum(float(rec["by_scene"][s][key]) for s in SCENE_KEYS) / len(SCENE_KEYS)
