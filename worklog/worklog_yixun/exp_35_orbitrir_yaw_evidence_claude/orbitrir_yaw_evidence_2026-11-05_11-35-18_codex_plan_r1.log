  1486	                              pin=args.pin, canon_index=index, base_dir=args.base_dir,
  1487	                              dump_check=args.dump_check, expect_dump=not args.no_dump,
  1488	                              check_link=not args.no_link_check, expect_digest=args.campaign_digest)
  1489	        print(("VALID " if not reasons else "INVALID ") + args.verify_cell)
