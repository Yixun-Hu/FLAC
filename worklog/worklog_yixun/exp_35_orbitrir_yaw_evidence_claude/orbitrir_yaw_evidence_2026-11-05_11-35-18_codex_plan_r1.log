  1304	def orbit_provenance(cond_method, frame_avg_max_fwd_samples=None):
  1305	    """``(orbit_execution, frame_avg_fwd_cap)`` for a conditioning method.
  1306	
  1307	    A vanilla evaluation executes NO orbit, so labelling it ``batched`` would be
  1308	    false provenance and would make a vanilla row look protocol-compatible with a
  1309	    batched frame-averaged row.
  1310	
  1311	    The recorded cap is the one the run ACTUALLY applied. ``None`` -> the module
  1312	    default (64), which is what every historical row carries and what exp_14 pins
  1313	    as the common EVALUATION cap for both arms: each arm's TRAINING cap is a
  1314	    property of its checkpoint, and the comparison is between training policies,
  1315	    never between evaluation policies (plan §3.1)."""
  1316	    if cond_method == "fa_invariant":
  1317	        return ORBIT_EXECUTION, resolve_frame_avg_cap(frame_avg_max_fwd_samples)
  1318	    return "n/a", None
