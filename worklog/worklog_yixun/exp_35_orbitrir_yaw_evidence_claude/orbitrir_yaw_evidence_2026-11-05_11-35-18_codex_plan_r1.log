   126	def _pin_rows(arm):
   127	    """P1-pin / YAW-pin: T (theta 0) + R (random) + C4/45 (seed 42) [+ S for YAW]."""
   128	    block = f"{arm}-pin"
   129	    rows = [_row(block, "T", arm, ENDPOINT, "unseen", k, s, ("fixed", 0)) for k in KS for s in SEEDS]
   130	    rows += [_row(block, "R", arm, ENDPOINT, "unseen", k, s, ("random", None)) for k in KS for s in SEEDS]
   131	    rows += [_row(block, "C4", arm, ENDPOINT, "unseen", k, 42, ("fixed", d))
   132	             for k in KS for d in C4_ANGLES + (OFF_ORBIT,)]
   133	    if arm == "YAW":
   134	        rows += [_row(block, "S", arm, ENDPOINT, "seen", k, s, ("fixed", 0)) for k in KS for s in SEEDS]
   135	    return rows
   136	
   137	
   138	def build_manifest():
   139	    E, U = ENDPOINT, "unseen"
   140	    blocks = {
   141	        "T": [_row("T", "T", "CANON", E, U, k, s, ("fixed", 0), True) for k in KS for s in SEEDS],
   142	        "T-dup": [_row("T-dup", "T", "CANON", E, U, k, 42, ("fixed", 0), True, dup=True) for k in KS],
   143	        "C4+45": [_row("C4+45", "C4", "CANON", E, U, k, 42, ("fixed", d), True)
   144	                  for k in KS for d in C4_ANGLES + (OFF_ORBIT,)],
   145	        "R": [_row("R", "R", "CANON", E, U, k, s, ("random", None), True) for k in KS for s in SEEDS],
   146	        "D-i": [_row("D-i", "D", "CANON", E, U, k, 42, ("fixed", 0), allow=True) for k in KS],
   147	        "D-ii": [_row("D-ii", "D", "P1", E, U, k, 42, ("fixed", 0), True, True) for k in KS],
   148	        "S": [_row("S", "S", "CANON", E, "seen", k, s, ("fixed", 0), True) for k in KS for s in SEEDS],
   149	        "P1-pin": _pin_rows("P1"),
   150	        "YAW-pin": _pin_rows("YAW"),
   151	        "TRAJ": [_row("TRAJ", "TRAJ", "CANON", step, U, k, 42, ("fixed", d), True)
   152	                 for step in range(CADENCE, ENDPOINT, CADENCE) for k in KS for d in (0,) + C4_ANGLES],
   153	    }
   154	    cells = []
   155	    for priority, block in enumerate(BLOCKS):
   156	        for row in blocks[block]:
   157	            cells.append({"cell": row.pop("cell"), "order": len(cells), "priority": priority, **row})
   158	    return {"schema_version": SCHEMA_VERSION, "generator": f"{EXPREL}/depth_canon_make_cells.py",
   159	            "plan": "plan_depth_canon.md v9 §5", "blocks": list(BLOCKS),
   160	            "block_counts": {b: len(blocks[b]) for b in BLOCKS}, "common_flags": COMMON_FLAGS,
   161	            "img_w": IMG_W, "seeds": list(SEEDS), "dump_root": DUMP_ROOT, "farm_root": FARM_ROOT,
   162	            "splits": {s: {"split_json": v["split_json"], "expected_stream_count": v["expected_stream_count"]}
   163	                       for s, v in SPLITS.items()},
   164	            "arms": ARMS, "cells": cells}
   165	
   166	
   167	def render(manifest):
   168	    """Deterministic bytes: a pretty header, then one compact cell per line."""
   169	    head = {k: v for k, v in manifest.items() if k != "cells"}
   170	    return (json.dumps(head, indent=1)[:-2] + ',\n "cells": [\n'
   171	            + ",\n".join("  " + json.dumps(c, separators=(",", ":")) for c in manifest["cells"])
   172	            + "\n ]\n}\n")
   173	
   174	
   175	def main(argv=None):
   176	    import argparse
   177	    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   178	    ap.add_argument("--write", action="store_true", help=f"write {os.path.relpath(OUT, REPO)}")
   179	    ap.add_argument("--check", action="store_true", help="exit 1 if the committed file drifted")
   180	    args = ap.parse_args(argv)
   181	    text = render(build_manifest())
   182	    if args.check:
   183	        with open(OUT) as f:
   184	            same = f.read() == text
   185	        print("cells manifest OK" if same else f"cells manifest DRIFTED from the generator: {OUT}")
   186	        return 0 if same else 1
   187	    if args.write:
   188	        with open(OUT, "w") as f:
   189	            f.write(text)
   190	        print(f"wrote {OUT}")
   191	        return 0
   192	    sys.stdout.write(text)
   193	    return 0
   194	
   195	
   196	if __name__ == "__main__":
   197	    sys.exit(main())
