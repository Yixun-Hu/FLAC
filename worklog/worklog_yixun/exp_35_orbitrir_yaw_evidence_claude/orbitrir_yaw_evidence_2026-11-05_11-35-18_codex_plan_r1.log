   732	def make_pairs(cells):
   733	    """Every rotated cell with its theta = 0 partner of the same (arm, K, seed, step):
   734	    C4 (90/180/270) and 45 vs T [seed 42], R vs T [seed], T-dup vs T, TRAJ theta vs TRAJ 0.
   735	    ``input_hash_equal`` proves the pair saw identical items and context draws."""
   736	    refs = {}
   737	    for name, e in cells.items():
   738	        r = e["row"]
   739	        if e["valid"] and r["split"] == "unseen" and r["rotate_mode"] == "fixed" and r["rotate_deg"] == 0 \
   740	                and r["block"] in ("T", "P1-pin", "YAW-pin", "TRAJ") and r["subblock"] in ("T", "TRAJ"):
   741	            refs[_ref_key(r)] = name
   742	    pairs = []
   743	    for name, e in cells.items():
   744	        r = e["row"]
   745	        if r["block"] == "T-dup":
   746	            kind = "dup"
   747	        elif r["rotate_mode"] == "random" and r["block"] in ("R", "P1-pin", "YAW-pin"):
   748	            kind = "R"
   749	        elif r["rotate_mode"] == "fixed" and r["rotate_deg"] and r["split"] == "unseen" \
   750	                and r["block"] in ("C4+45", "P1-pin", "YAW-pin", "TRAJ"):
   751	            kind = "TRAJ" if r["block"] == "TRAJ" else ("45" if r["rotate_deg"] == 45 else "C4")
   752	        else:
   753	            continue
   754	        ref = refs.get(_ref_key(r))
   755	        same = bool(ref and e["valid"] and e["stream"]["input_hash"] == cells[ref]["stream"]["input_hash"])
   756	        pairs.append({"arm": r["arm"], "kind": kind, "K": r["K"], "seed": r["seed"], "step": r["step"],
   757	                      "deg": r["rotate_deg"] if r["rotate_mode"] == "fixed" else None, "cell": name,
   758	                      "ref": ref, "valid": e["valid"], "input_hash_equal": same})
   759	    return pairs
