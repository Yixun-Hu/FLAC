   466	def collect_items(eval_dl, n_items):
   467	    """The first ``n_items`` items in loader order: ``(reals [n, C, T], [md, ...])``."""
   468	    reals, mds = [], []
   469	    for batch_reals, batch_md in eval_dl:
   470	        for r, md in zip(batch_reals, batch_md):
   471	            if len(mds) < n_items:
   472	                reals.append(r)
   473	                mds.append(md)
   474	        if len(mds) == n_items:
   475	            break
   476	    if len(mds) < n_items:
   477	        raise ValueError(f"the loader holds only {len(mds)} items; --n-items is {n_items}")
   478	    return torch.stack(reals), mds
