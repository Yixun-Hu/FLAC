   308	run_cell() {   # lane cell sha spawn-digest link cache argv... -- a background job: evaluate, receipt, verify
   309	  local lane="$1" cid="$2" sha="$3" spawn="$4" link="$5" cache="$6"; shift 6
   310	  local clog="$LOGDIR/depth_canon_${TS}_eval_${cid}.log" rc=0 post measured nbytes
   311	  CUDA_VISIBLE_DEVICES="$lane" HF_HUB_OFFLINE=1 "$PY" "$EVAL_PROG" "$@" > "$clog" 2>&1 || rc=$?
   312	  if [ "$rc" -ne 0 ]; then echo "  !! FAILED ${cid}: the evaluator exited rc=${rc} (log ${clog})"; return 1; fi
   313	  post="$(tree_digest)" || post=""
   314	  if [ "$post" != "$CAMPAIGN_DIGEST" ] || [ -n "$(tree_dirty)" ]; then
   315	    echo "  !! FAILED ${cid}: the relevant tree changed while the cell ran (digest '${post}' != ${CAMPAIGN_DIGEST}); no receipt"
   316	    return 4
   317	  fi
   318	  measured="$(sha256sum -- "$link" | awk '{print $1}')"   # the file the evaluator opened, hashed again
   319	  nbytes="$(stat -c %s -- "$link")"                        # == the length eval_FLAC reports it loaded
   320	  if [ "$measured" != "$sha" ] || ! farm_entry_ok "$link" "$cache"; then
   321	    echo "  !! FAILED ${cid}: the evaluated checkpoint ${link} now hashes to '${measured}', not ${sha} (or left the cache inode); no receipt"
   322	    return 1
   323	  fi
   324	  "$PY" "$COLLECT" --write-receipt "$cid" --plan-json "$PLAN" --cells "$CELLS" --base-dir "$REPO" \
   325	    --lane "$lane" --log "$clog" --rc 0 --pin "$EXPECT_HEAD" --ckpt-sha "$measured" --ckpt-bytes "$nbytes" \
   326	    --farm-root "$FARM_ROOT" \
   327	    --spawn-digest "$spawn" --post-digest "$post" \
   328	    --dump-root "$DUMP_ROOT" "${VERIFY_EXTRA[@]}" --verify-after >> "$clog" 2>&1 \
   329	    || { echo "  !! FAILED ${cid}: post-run verification refused the cell (log ${clog})"; return 1; }
   330	  echo "  DONE ${cid} on GPU ${lane}: complete and verified"
   331	}
   332	declare -A LANE_PID=() PID_CELL=() PID_LANE=() GPU_NOTE=()
   333	N_SKIP=0; N_DONE=0; FAILED=(); ABORT=""; DRIFT=""; NEXT=0; POLLS=0; i=0; READY=""
   334	reap() {   # collect every finished job; never waits on a running one, never signals anything
   335	  local pid st running=" $(jobs -rp | tr '\n' ' ') "
   336	  for pid in "${!PID_CELL[@]}"; do
   337	    case "$running" in *" ${pid} "*) continue ;; esac
   338	    st=0; wait "$pid" || st=$?
   339	    if [ "$st" -eq 0 ]; then N_DONE=$((N_DONE + 1)); else FAILED+=("${PID_CELL[$pid]}"); fi
   340	    if [ "$st" -eq 4 ]; then DRIFT=1; ABORT="${ABORT:-PIN DRIFT: the relevant tree changed while ${PID_CELL[$pid]} ran}"; fi
   341	    unset "LANE_PID[${PID_LANE[$pid]}]" "PID_CELL[$pid]" "PID_LANE[$pid]"
   342	  done
   343	}
   344	RE_MAP='^([0-9]+),[[:space:]]*(GPU-[0-9A-Za-z-]+)$'
   345	RE_APP='^([0-9]+),[[:space:]]*(GPU-[0-9A-Za-z-]+),[[:space:]]*([^,]*),[[:space:]]*([0-9]+|\[N/A\])$'
   346	lane_state() {   # <gpu>: 0 usable | 1 not now (LANE_WHY) | 2 a query failed / is malformed (fail closed)
   347	  local lane="$1" out rc line want pid uuid occ="" free
   348	  local -A byidx=() byuuid=()
   349	  out="$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader 2>/dev/null)"; rc=$?
   350	  [ "$rc" -eq 0 ] && [ -n "$out" ] || { LANE_WHY="nvidia-smi --query-gpu=index,uuid failed (rc ${rc})"; return 2; }
   351	  while IFS= read -r line; do
   352	    [[ "$line" =~ $RE_MAP ]] || { LANE_WHY="malformed index,uuid row '${line}'"; return 2; }
   353	    [ -z "${byidx[${BASH_REMATCH[1]}]:-}" ] && [ -z "${byuuid[${BASH_REMATCH[2]}]:-}" ] \
   354	      || { LANE_WHY="duplicate index or uuid in the nvidia-smi map ('${line}')"; return 2; }
   355	    byidx[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}"; byuuid[${BASH_REMATCH[2]}]="${BASH_REMATCH[1]}"
   356	  done <<<"$out"
   357	  want="${byidx[$lane]:-}"
   358	  [ -n "$want" ] || { LANE_WHY="GPU ${lane} has no uuid in the nvidia-smi index map"; return 2; }
   359	  out="$(nvidia-smi --query-compute-apps=pid,gpu_uuid,process_name,used_memory --format=csv,noheader,nounits 2>/dev/null)"; rc=$?
   360	  [ "$rc" -eq 0 ] || { LANE_WHY="nvidia-smi --query-compute-apps failed (rc ${rc})"; return 2; }
   361	  while IFS= read -r line; do
   362	    [ -n "$line" ] || continue
   363	    [[ "$line" =~ $RE_APP ]] || { LANE_WHY="malformed compute-app row '${line}'"; return 2; }
   364	    pid="${BASH_REMATCH[1]}"; uuid="${BASH_REMATCH[2]}"
   365	    [ -n "${byuuid[$uuid]:-}" ] || { LANE_WHY="compute process ${pid} sits on an unknown uuid ${uuid}"; return 2; }
   366	    [ "$uuid" = "$want" ] && occ+=" pid ${pid} (${BASH_REMATCH[3]}, ${BASH_REMATCH[4]} MiB, cwd $(readlink "/proc/${pid}/cwd" 2>/dev/null || echo '?'))"
   367	  done <<<"$out"
   368	  out="$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits -i "$lane" 2>/dev/null)"; rc=$?
   369	  [ "$rc" -eq 0 ] && [[ "$out" =~ ^[[:space:]]*([0-9]+)[[:space:]]*$ ]] \
   370	    || { LANE_WHY="nvidia-smi memory.free of GPU ${lane} failed or is not one number (rc ${rc}: '${out//$'\n'/|}')"; return 2; }
   371	  free="${BASH_REMATCH[1]}"
   372	  [ "$free" -ge "$MIN_GPU_FREE_MIB" ] || { LANE_WHY="${free} MiB free < ${MIN_GPU_FREE_MIB} MiB"; return 1; }
   373	  LANE_WHY=""
   374	  if [ -n "$occ" ]; then
   375	    [ "$ALLOW_SHARED_GPU" = 1 ] || { LANE_WHY="occupied by foreign compute process(es):${occ}"; return 1; }
   376	    LANE_WHY="shared with${occ} (ALLOW_SHARED_GPU=1)"
   377	  fi
   378	  return 0
   379	}
   380	pick_lane() {   # LANE = the next idle lane (round-robin) lane_state accepts; a failed query aborts
   381	  local k lane st; LANE=""
   382	  for ((k = 0; k < ${#LANES[@]}; k++)); do
   383	    lane="${LANES[$(( (NEXT + k) % ${#LANES[@]} ))]}"
   384	    [ -z "${LANE_PID[$lane]:-}" ] || continue
   385	    lane_state "$lane"; st=$?
   386	    [ "$st" -eq 2 ] && { ABORT="GPU GATE FAILED: ${LANE_WHY}"; return 1; }
   387	    if [ "$st" -eq 0 ]; then
   388	      [ -z "$LANE_WHY" ] || echo "  GPU ${lane}: ${LANE_WHY}"
   389	      LANE="$lane"; NEXT=$(( (NEXT + k + 1) % ${#LANES[@]} )); return 0
   390	    fi
