   347	def run_probe(module, reals, metadata, img_w, seed, batch_size, latent_len, protocols=None):
   348	    """Per protocol and offset key: stagewise B-vs-A comparisons for every item, A run
   349	    twice for the determinism floor, the Tier-1 record, eps_cond and the control p99."""
   350	    protocols = PROTOCOLS if protocols is None else protocols
   351	    n = len(metadata)
   352	    if reals.shape[0] != n:
   353	        raise ValueError(f"{reals.shape[0]} reals for {n} metadata items")
   354	    offsets = draw_offsets(n, img_w, seed)
   355	    noise = noise_bank(n, (module.diffusion.io_channels, latent_len), seed)
   356	    acc = {p: {k: _new_acc() for k in OFFSET_KEYS} for p in protocols}
   357	    det = {p: _new_acc() for p in protocols}
   358	    items = []
   359	    for start in range(0, n, batch_size):
   360	        sl = slice(start, min(start + batch_size, n))
   361	        a_list, b_lists, tier1 = canonical_pairs(list(metadata[sl]), {k: v[sl] for k, v in offsets.items()},
   362	                                                 img_w)
   363	        items += tier1
   364	        for p, proto in protocols.items():
   365	            sa = run_stages(module, a_list, noise[sl], reals[sl], proto)
   366	            _append(det[p], compare_stages(run_stages(module, a_list, noise[sl], reals[sl], proto), sa))
   367	            for key in OFFSET_KEYS:
   368	                _append(acc[p][key], compare_stages(
   369	                    run_stages(module, b_lists[key], noise[sl], reals[sl], proto), sa))
   370	    results = {p: {k: _finish(acc[p][k]) for k in OFFSET_KEYS} for p in protocols}
   371	    pooled = {p: _pooled(results[p]) for p in protocols}
   372	    eps = _eps_cond(results)
   373	    control = {p: dict({k: results[p][k]["waveform"]["summary"]["relL2"]["p99"] for k in OFFSET_KEYS},
   374	                       pooled=pooled[p]["waveform"]["relL2"]["p99"]) for p in protocols}
   375	    pairs = [o for it in items for o in it["offsets"].values()]
   376	    t1 = {"n_pairs": len(pairs)} | {f: sum(o[f] for o in pairs)
   377	                                    for f in ("depth_sha_equal", "class_equal", "dj_corotates")}
   378	    verdict = {"eps_cond": bool(eps and eps["pass"]),
   379	               "tier1": all(t1[f] == t1["n_pairs"] for f in ("depth_sha_equal", "class_equal", "dj_corotates")),
   380	               "masks": all(results[p][k]["cond"]["masks_equal"] for p in protocols for k in OFFSET_KEYS)}
   381	    verdict = {"pass": all(verdict.values()), **verdict}
   382	    return {"offsets": offsets, "items": items, "tier1": t1, "results": results, "pooled": pooled,
   383	            "determinism": {p: _finish(det[p]) for p in protocols}, "eps_cond": eps,
   384	            "control_p99": control, "verdict": verdict}
