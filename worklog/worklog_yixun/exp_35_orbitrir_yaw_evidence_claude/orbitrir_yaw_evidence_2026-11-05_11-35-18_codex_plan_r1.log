   491	def write_report(report, out):
   492	    """``json.dumps(indent=1)`` + newline, then the ``sha256sum`` sidecar."""
   493	    import hashlib
   494	    import json
   495	    text = json.dumps(report, indent=1) + "\n"
   496	    with open(out, "w") as f:
   497	        f.write(text)
   498	    with open(out + ".sha256", "w") as f:
   499	        f.write(f"{hashlib.sha256(text.encode()).hexdigest()}  {os.path.basename(out)}\n")
