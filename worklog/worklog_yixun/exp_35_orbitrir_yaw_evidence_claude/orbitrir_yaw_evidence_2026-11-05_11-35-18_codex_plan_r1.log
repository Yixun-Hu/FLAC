   799	def tier1(pairs, cells):
   800	    """Tier 1 (structural, exact): every registered rotated CANON cell (C4, 45, R) and T-dup
   801	    holds the SAME canonical recovered-depth image as its theta = 0 pair, position by position
   802	    and as the one-line ``canonical_depth_hash`` (recomputed from the positions). TRAJ pairs
   803	    are reported descriptively (canonicalization does not depend on the checkpoint)."""
   804	    reg = [_tier1_pair(p, cells) for p in pairs if p["arm"] == "CANON" and p["kind"] in TIER1_KINDS]
   805	    traj = [_tier1_pair(p, cells) for p in pairs if p["arm"] == "CANON" and p["kind"] == "TRAJ"]
   806	    unseen = {eval_FLAC.canonical_stream_hash([[x[1], x[4]] for x in e["canon"]["positions"]])
   807	              for e in cells.values() if e["valid"] and e["canon"] and e["row"]["split"] == "unseen"}
   808	    return {"pass": bool(reg) and all(p["pass"] for p in reg), "n_pairs": len(reg), "pairs": reg,
   809	            "trajectory": {"n_pairs": len(traj), "n_pass": sum(p["pass"] for p in traj)},
   810	            "distinct_canonical_depth_hashes_unseen": len(unseen)}
