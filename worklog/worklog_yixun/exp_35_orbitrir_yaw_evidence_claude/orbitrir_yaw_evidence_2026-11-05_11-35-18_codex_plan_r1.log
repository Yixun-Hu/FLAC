    41	FIXED_OFFSETS = (64, 128, 256, 384)
    42	OFFSET_KEYS = tuple(f"d{d}" for d in FIXED_OFFSETS) + ("random",)
    43	RANDOM_OFFSET_SEED_SHIFT = 1  # the random offsets' generator is seeded with seed + 1
