   336	def _eps_cond(results):
   337	    """max fp32 conditioning relL2 over the registered offsets, conditioner ids and items."""
   338	    if "fp32" not in results:
   339	        return None
   340	    value, key, cid, pos = max((v, k, i, pos) for k in OFFSET_KEYS
   341	                               for i, d in results["fp32"][k]["cond"]["per_id"].items()
   342	                               for pos, v in enumerate(d["relL2"]))
   343	    return {"value": value, "threshold": EPS_COND_THRESHOLD, "pass": value <= EPS_COND_THRESHOLD,
   344	            "argmax": {"key": key, "id": cid, "position": pos}}
