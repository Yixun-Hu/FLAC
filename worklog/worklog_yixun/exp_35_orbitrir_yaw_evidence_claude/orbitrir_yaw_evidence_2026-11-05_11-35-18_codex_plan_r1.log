  1401	def main(argv=None):
  1402	    import argparse
  1403	    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
  1404	    ap.add_argument("--verify-cell", metavar="STEM", help="verify ONE cell; exit 0 valid / 1 invalid")
