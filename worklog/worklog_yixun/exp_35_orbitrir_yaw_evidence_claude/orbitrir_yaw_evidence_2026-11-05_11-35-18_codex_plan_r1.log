  1066	def _index(cells):
  1067	    """``(arm, kind F|R|S, K, seed, step, deg) -> entry`` over the valid table / rotation cells."""
  1068	    idx = {}
  1069	    for e in cells.values():
  1070	        r = e["row"]
  1071	        if e["valid"] and r["block"] not in ("D-i", "D-ii", "T-dup"):
  1072	            kind = "S" if r["split"] == "seen" else ("R" if r["rotate_mode"] == "random" else "F")
  1073	            idx[(r["arm"], kind, r["K"], r["seed"], r["step"], r["rotate_deg"])] = e
  1074	    return idx
