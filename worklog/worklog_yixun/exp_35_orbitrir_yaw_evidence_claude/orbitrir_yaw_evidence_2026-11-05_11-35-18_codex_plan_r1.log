  1278	def resolve_weights_source(training_config, state_dict_keys):
  1279	    """Which weights an evaluation will actually use: ``'ema'`` or ``'online'``.
  1280	
  1281	    ``evaluate_model`` swaps in EMA weights only when the config asks for them AND
  1282	    the checkpoint carries ``diffusion_ema.ema_model.*`` entries; otherwise it
  1283	    silently evaluates the online weights. A screen that merely *asserts* EMA in a
  1284	    sidecar can therefore be wrong, so the record states what actually happened
  1285	    (round-4 review B1)."""
  1286	    wants_ema = bool((training_config or {}).get("use_ema", False))
  1287	    has_ema = any(str(k).startswith("diffusion_ema.ema_model.") for k in state_dict_keys)
  1288	    return "ema" if (wants_ema and has_ema) else "online"
  1289	
