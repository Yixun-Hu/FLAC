  1140	    item-weighted (40k = the T / C4 cells). Descriptive, single seed; each step's Delta_C4 is
  1141	    set against 10 % of P1-pin's Delta_C4 @40k (the only P1 reference measured at this pin)."""
  1142	    idx, grid = _index(cells), []
  1143	    for step in range(2500, 40001, 2500):
  1144	        for k in (1, 8):
  1145	            ent = {d: idx.get(("CANON", "F", k, 42, step, d)) for d in (0, 90, 180, 270)}
  1240	             else {n: os.path.join(REPO, rel) for n, rel in _DEFAULT_SPLITS})
  1241	    items = {}
  1242	    for name in ("unseen", "seen"):
  1243	        with open(files[name]) as f:
  1244	            data = json.load(f)
  1245	        items[name] = {(room, rid, w) for room, ids in data.items() for rid, ws in ids.items() for w in ws}
  1246	    shared = len(items["unseen"] & items["seen"])
  1247	    u, sn = len(items["unseen"]), len(items["seen"])
  1248	    maps = len(set(summary["split_maps"]["unseen"]) & set(summary["split_maps"]["seen"])) if summary else None
  1249	    reg = dict(REGISTERED_OVERLAP)
  1250	    mismatch = ([f"overlap: {shared} shared items != the registered {reg['items']}"] if shared != reg["items"] else []) \
  1251	        + ([f"overlap: {maps} shared depth maps != the registered {reg['maps']}"]
  1252	           if maps is not None and maps != reg["maps"] else [])
  1253	    maps_txt = (f"{maps} depth maps (derived from the validated rung-3 tie audit)" if maps is not None
  1254	                else "an unknown number of depth maps (not derivable: no validated tie audit)")
  1255	    return {"unseen_items": u, "seen_items": sn, "shared_items": shared, "shared_maps": maps, "registered": reg,
  1256	            "mismatch": mismatch,
  1257	            "disclosure": (f"DISCLOSURE: the seen and unseen AR eval splits share {shared:,} exact item paths "
  1258	                           f"({100 * shared / u:.1f} % of unseen, {100 * shared / sn:.1f} % of seen) and {maps_txt}: "
  1259	                           "seen and unseen results are correlated and must not be presented as independent "
  1260	                           "estimates." + (f" MISMATCH with the registered overlap: {'; '.join(mismatch)}."
  1261	                                           if mismatch else ""))}
