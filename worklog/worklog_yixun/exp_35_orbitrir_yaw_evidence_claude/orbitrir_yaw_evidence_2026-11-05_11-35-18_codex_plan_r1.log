   915	def probe_reasons(rep, *, ckpt_sha256, canon_receipts, pin, manifest):
   916	    """The registered composition control of THIS campaign (Codex rB HIGH B5): registered, no
   917	    deviation, the CANON@40k checkpoint, the campaign pin on a clean tree, the registered
   918	    arguments, the campaign's configs + split, the EMA canonical load, the offsets the probe's
   919	    own draw gives, the stream census, and eps / control / verdict consistent with the results.
   920	    rB-F3 F3-2: the bytes the probe deserialized -- ``ckpt_sha256_loaded`` == the manifest sha,
   921	    ``ckpt_bytes_loaded`` == the length ``canon_receipts`` (:func:`canon_endpoint_receipts`) hold."""
   922	    P, out = PROBE_CONTRACT, []
   923	    _eq(out, "probe schema_version", rep.get("schema_version"), 1)
   924	    if rep.get("registered") is not True:
   925	        out.append(f"control probe is not a registered control (registered: {rep.get('registered')!r})")
   926	    _eq(out, "probe deviations", rep.get("deviations"), [])
   927	    prov = rep.get("provenance") if isinstance(rep.get("provenance"), dict) else {}
   928	    canon = manifest["arms"]["CANON"]
   929	    ds = next(c for c in manifest["cells"] if c["split"] == P["split"] and c["K"] == P["config_K"])
   930	    split_json = manifest["splits"][P["split"]]["split_json"]
   931	    digest = model_config_digest(next(c for c in manifest["cells"] if c["arm"] == "CANON"))
   932	    want = {"ckpt_sha256": ckpt_sha256, "ckpt_sha256_loaded": ckpt_sha256,
   933	            "source_sha": pin, "dirty": "", "device": P["device"], "seed": P["seed"],
   934	            "random_offset_seed": P["seed"] + 1, "n_items": P["n_items"], "batch_size": P["batch_size"],
   935	            "img_w": P["img_w"], "protocols": P["protocols"], "allow_canon_mismatch": False,
   936	            "model_config_file_sha256": canon["model_config_sha256"], "dataset_config": ds["dataset_config"],
   937	            "dataset_config_sha256": ds["dataset_config_sha256"], "split_json": split_json,
   938	            "split_json_sha256": _file_digest(os.path.join(REPO, split_json)),
   939	            "load": {"weights_source": "ema", "canonicalize_trained": True, "canonicalize_applied": True,
   940	                     "canonicalize_mismatch": False, "img_w": P["img_w"], "model_config_sha256_file": digest,
   941	                     "model_config_sha256_embedded": digest}}
   942	    for key, value in want.items():
   943	        _eq(out, f"probe provenance.{key}", prov.get(key), value)
   944	    out += _load_reasons("probe provenance", prov) + _probe_length_reasons(prov, ckpt_sha256, canon_receipts)
   945	    if not isinstance(prov.get("model_config"), str) or os.path.realpath(os.path.join(REPO, prov["model_config"])) \
   946	            != os.path.realpath(os.path.join(REPO, canon["model_config"])):
   947	        out.append(f"probe provenance.model_config {prov.get('model_config')!r} is not {canon['model_config']}")
   948	    _eq(out, "probe offsets (the probe's own draw)", rep.get("offsets"),
   949	        _probe_module().draw_offsets(P["n_items"], P["img_w"], P["seed"]))
   950	    items = rep.get("items")
   951	    if not (isinstance(items, list) and len(items) == P["n_items"] and all(
   952	            isinstance(it, dict) and it.get("position") == i and isinstance(it.get("target_id"), str)
   953	            and it["target_id"] and _context_ok(it.get("context_ids"), P["K"]) for i, it in enumerate(items))):
   954	        out.append(f"probe items: not {P['n_items']} ordered positions with a target and K={P['K']} context ids")
   955	    else:
   956	        _eq(out, "probe stream_input_hash (recomputed from the items)", rep.get("stream_input_hash"),
   957	            eval_FLAC.canonical_stream_hash([[it["position"], it["target_id"], it["context_ids"], P["img_w"]]
   958	                                             for it in items]))
   959	    return out + _probe_number_reasons(rep, P)
