   296	EPS_COND_THRESHOLD = 1e-5
   297	
   298	
   299	def _pair_lists():
   300	    return {"relL2": [], "relLinf": []}
   301	
   302	
   303	def _new_acc():
   304	    acc = {"cond": {"ids": None, "masks_equal": True, "per_id": {}, "all": _pair_lists()}}
   305	    acc.update({s: _pair_lists() for s in STAGES[1:]})
   306	    return acc
   307	
   308	
   309	def _append(acc, cmp):
   310	    c = cmp["cond"]
   311	    if acc["cond"]["ids"] not in (None, c["ids"]):
   312	        raise RuntimeError(f"conditioner ids changed between batches: {acc['cond']['ids']} -> {c['ids']}")
   313	    acc["cond"]["ids"] = c["ids"]
   314	    acc["cond"]["masks_equal"] = acc["cond"]["masks_equal"] and c["masks_equal"]
   315	    for target, src in [(acc["cond"]["per_id"].setdefault(i, _pair_lists()), c[i]) for i in c["ids"]] + \
   316	            [(acc["cond"]["all"], c["all"])] + [(acc[s], cmp[s]) for s in STAGES[1:]]:
   317	        for k in ("relL2", "relLinf"):
   318	            target[k].extend(float(v) for v in src[k])
   319	
   320	
   321	def _finish(acc):
   322	    for d in list(acc["cond"]["per_id"].values()) + [acc["cond"]["all"]] + [acc[s] for s in STAGES[1:]]:
   323	        d["summary"] = summarize({k: np.array(d[k]) for k in ("relL2", "relLinf")})
   324	    return acc
   325	
   326	
   327	def _pooled(results_p):
   328	    """Per stage, the summary over the five registered offsets' items together."""
   329	    out = {}
   330	    for s in STAGES:
   331	        rows = [results_p[k]["cond"]["all"] if s == "cond" else results_p[k][s] for k in OFFSET_KEYS]
   332	        out[s] = summarize({m: np.array([v for r in rows for v in r[m]]) for m in ("relL2", "relLinf")})
   333	    return out
   334	
   335	
   336	def _eps_cond(results):
   337	    """max fp32 conditioning relL2 over the registered offsets, conditioner ids and items."""
   338	    if "fp32" not in results:
   339	        return None
   340	    value, key, cid, pos = max((v, k, i, pos) for k in OFFSET_KEYS
   341	                               for i, d in results["fp32"][k]["cond"]["per_id"].items()
   342	                               for pos, v in enumerate(d["relL2"]))
   343	    return {"value": value, "threshold": EPS_COND_THRESHOLD, "pass": value <= EPS_COND_THRESHOLD,
   344	            "argmax": {"key": key, "id": cid, "position": pos}}
