  1321	def render_md(res):
  1322	    part = res["partial"]
  1323	    h = lambda t: f"## {'PARTIAL — ' if part else ''}{t}"  # noqa: E731
  1324	    keys = TIER3_KEYS
  1325	    head = "| row | K | " + " | ".join(SHORT.get(k, k) for k in keys) + " |"
  1380	    out += ["", h("Diagnostics D-i (CANON ckpt, no canonicalization) / D-ii (P1 ckpt + canonicalization)"), ""]
  1381	    out += [f"- {name}: `{d['cell']}` " + ", ".join(f"{SHORT.get(k, k)} {v:.4g}" for k, v in d["metrics"].items())
  1382	            for name, d in sorted(res["diagnostics"].items())]
  1383	    out += ["", h("TRAJ — Delta_C4 per checkpoint (seed 42, item-weighted, descriptive)"), "",
  1384	            "| step | K | " + " | ".join(SHORT.get(k, k) for k in keys) + " | <= 10 % of P1@40k (all) |",
  1385	            "|---|---|" + "---|" * (len(keys) + 1)]
  1386	    for g in res["traj"]["grid"]:
  1387	        d, w = g["delta_c4"] or {}, g["within_10pct_of_p1_40k"]
  1388	        out.append(f"| {g['step']} | {g['K']} | " + " | ".join(_num(d.get(k)) for k in keys)
  1389	                   + f" | {all(w.values()) if None not in w.values() else '—'} |")
  1390	    ties = res["ties"]
  1391	    out += ["", h("tie classes (per split: tie audit; per cell: records)"), "",
  1392	            f"per split (items): {ties['per_split']}; cells whose counts differ from their split: "
  1393	            f"{ties['mismatches'] or 'none'}; shared unseen/seen maps: {ties['shared_maps']}.", ""]
  1394	    return "\n".join(out) + "\n"
