   311	    if acc["cond"]["ids"] not in (None, c["ids"]):
   312	        raise RuntimeError(f"conditioner ids changed between batches: {acc['cond']['ids']} -> {c['ids']}")
   313	    acc["cond"]["ids"] = c["ids"]
   314	    acc["cond"]["masks_equal"] = acc["cond"]["masks_equal"] and c["masks_equal"]
