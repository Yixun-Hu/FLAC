   688	def collect_cells(manifest, selected, *, farm_root, dump_root, pin, canon_index, base_dir=REPO,
   689	                  check_link=True, no_dump_blocks=(), dump_check="full"):
   690	    """``{cell: entry}`` in selection order; an entry is ``valid`` only if ``verify_cell``
   691	    returned no reason, and only then carries the loaded record / stream / canon sidecar."""
   692	    out = {}
   693	    for row in selected:
   694	        e = {"row": row, "valid": False, "missing": False, "reasons": [], "record": None,
   695	             "stream": None, "canon": None, "receipt": None, "stem": None, "dump_dir": None,
   696	             "dump": bool(row["dump"]) and row["block"] not in no_dump_blocks}
   697	        out[row["cell"]] = e
   698	        try:
   699	            target, _ = expected_checkpoint(row, manifest, canon_index)
   700	        except KeyError as err:
   701	            e.update(missing=True, reasons=[str(err).strip("'\"")])
   702	            continue
   703	        p = cell_paths(row, os.path.join(farm_root, row["arm"], os.path.basename(target)), dump_root)
   704	        e.update(stem=p.stem, dump_dir=os.path.join(base_dir, p.dump_dir))
   705	        if not os.path.exists(os.path.join(base_dir, p.metrics)):
   706	            e.update(missing=True, reasons=[f"metrics JSON {p.metrics} absent"])
   707	            continue
   708	        e["reasons"] = verify_cell(p.stem, manifest=manifest, farm_root=farm_root, dump_root=dump_root,
   709	                                   pin=pin, canon_index=canon_index, base_dir=base_dir,
   710	                                   dump_check=dump_check, expect_dump=e["dump"], check_link=check_link)
   711	        if e["reasons"]:
   712	            continue
   713	        e["valid"] = True
   714	        for key, path in (("record", p.metrics), ("stream", p.stream), ("receipt", p.receipt)) + (
   715	                (("canon", p.canon),) if row["canonicalize"] else ()):
   716	            with open(os.path.join(base_dir, path)) as f:
   717	                e[key] = json.load(f)
   718	    return out
