  1124	def table_block(cells):
  1125	    """theta = 0 rows, mean +- sample sd over the five eval seeds: unseen (CANON T, P1-pin T,
  1126	    YAW-pin T) and ``seen`` (CANON S, YAW-pin S); item-weighted and per-scene."""
  1127	    idx = _index(cells)
  1128	    def block(kind, arm):
  1129	        return {k: {agg: {key: _stats([_value(e, key, agg) for e in
  1130	                                       (idx.get((arm, kind, k, s, 40000, 0)) for s in SEEDS) if e])
  1131	                          for key in TIER3_KEYS} for agg in AGGS} for k in (1, 8)}
  1132	    out = {arm: block("F", arm) for arm in ("CANON", "P1", "YAW")}
  1133	    out["seen"] = {arm: block("S", arm) for arm in ("CANON", "YAW")
  1134	                   if any(key[0] == arm and key[1] == "S" for key in idx)}
  1135	    return out
