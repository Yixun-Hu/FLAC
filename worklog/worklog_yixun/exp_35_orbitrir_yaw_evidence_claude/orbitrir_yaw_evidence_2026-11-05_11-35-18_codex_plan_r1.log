   406	def registered_deviations(args):
   407	    """Argument-level departures from :data:`REGISTERED` (checked before anything loads)."""
   408	    R, out = REGISTERED, []
   409	    for flag, key in (("--n-items", "n_items"), ("--batch-size", "batch_size"), ("--seed", "seed"),
   410	                      ("--device", "device")):
   411	        if getattr(args, key) != R[key]:
   412	            out.append(f"{flag} {getattr(args, key)!r} != the registered {R[key]!r}")
   413	    if args.allow_canon_mismatch:
   414	        out.append("--allow-canon-mismatch (the control must be the CANON checkpoint itself)")
   415	    absp = lambda p: os.path.realpath(p if os.path.isabs(p) else os.path.join(REPO, p))  # noqa: E731
   416	    for flag, path, key in (("--model-config", args.model_config, "model_config"),
   417	                            ("--dataset-config", args.dataset_config, "dataset_config")):
   418	        if absp(path) != absp(R[key]) or not os.path.isfile(absp(path)) \
   419	                or _sha256_file(absp(path)) != R[key + "_sha256"]:
   420	            out.append(f"{flag} {path} is not the registered {R[key]} (sha256 {R[key + '_sha256'][:12]})")
   421	    return out
