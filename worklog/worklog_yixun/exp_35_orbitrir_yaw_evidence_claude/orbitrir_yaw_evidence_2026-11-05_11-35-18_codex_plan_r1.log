   347	def run_probe(module, reals, metadata, img_w, seed, batch_size, latent_len, protocols=None):
   348	    """Per protocol and offset key: stagewise B-vs-A comparisons for every item, A run
   349	    twice for the determinism floor, the Tier-1 record, eps_cond and the control p99."""
   350	    protocols = PROTOCOLS if protocols is None else protocols
   351	    n = len(metadata)
   352	    if reals.shape[0] != n:
   353	        raise ValueError(f"{reals.shape[0]} reals for {n} metadata items")
