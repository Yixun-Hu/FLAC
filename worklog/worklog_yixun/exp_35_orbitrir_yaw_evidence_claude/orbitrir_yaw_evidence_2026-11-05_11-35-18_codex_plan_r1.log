   438	    if (load.get("canonicalize_trained"), load.get("canonicalize_applied"),
   439	            load.get("canonicalize_mismatch")) != (True, True, False):
   440	        out.append("the checkpoint is not a canonicalization-trained model evaluated with it (mismatch)")
   441	    if load.get("img_w") != 512:
