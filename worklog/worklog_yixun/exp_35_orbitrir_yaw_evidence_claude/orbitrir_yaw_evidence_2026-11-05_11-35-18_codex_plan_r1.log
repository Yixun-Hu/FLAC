   174	def run_stages(module, md_list, noise, reals, protocol):
   175	    """The four stages for one list of (already canonical) metadata dicts, mirroring
   176	    ``eval_FLAC.evaluate_model``'s loop: conditioner under the protocol's cond autocast,
   177	    ``get_conditioning_inputs``, ``sample_discrete_euler`` with 1 step / cfg 1.0 /
   178	    ``batch_cfg=True`` / the wrapper's ``dist_shift`` on the GIVEN noise (the DiT's one
   179	    output recorded as the velocity), decode, ``clamp(-1, 1)``, pad to ``reals``."""
   180	    import eval_FLAC as ev
   181	    from src.inference import sampling
   182	    enabled, dtype = ev.resolve_cond_autocast(protocol["cond_autocast"])
   183	    device = module.device
   184	    device_type = torch.device(device).type
   185	    model = module.diffusion.model
   186	    objective = (model.diffusion_objective if hasattr(model, "diffusion_objective")
   187	                 else getattr(model, "objective", "rectified_flow"))
   188	    if objective != "rectified_flow":
   189	        raise ValueError(f"the probe mirrors the rectified_flow 1-step path only, got {objective!r}")
   190	    velocities = []
   191	
   192	    def recording_model(x, t, **kw):
   193	        v = model(x, t, **kw)
   194	        velocities.append(v)
   195	        return v
   196	
   197	    with matmul_precision(protocol["matmul_precision"]), torch.no_grad():
   198	        ctx = (contextlib.nullcontext() if not enabled else torch.amp.autocast(device_type)
   199	               if dtype is None else torch.amp.autocast(device_type, dtype=dtype))
   200	        with ctx:
   201	            cond = module.diffusion.conditioner(md_list, device)
   202	        cond_inputs = module.diffusion.get_conditioning_inputs(cond)
   203	        latent = sampling.sample_discrete_euler(
   204	            recording_model, noise.to(device), 1, **cond_inputs, cfg_scale=1.0,
   205	            dist_shift=module.diffusion.dist_shift, batch_cfg=True, disable_tqdm=True)
   206	        if len(velocities) != 1:
   207	            raise RuntimeError(f"expected one DiT call for one Euler step, saw {len(velocities)}")
   208	        wav = latent if module.diffusion.pretransform is None else module.diffusion.pretransform.decode(latent)
   209	        wav = wav.clamp(-1.0, 1.0)
   210	        if wav.shape != reals.shape and wav.shape[-1] < reals.shape[-1]:
   211	            wav = torch.nn.functional.pad(wav, (0, reals.shape[-1] - wav.shape[-1]))
   212	    return {"cond": cond, "velocity": velocities[0], "latent": latent, "waveform": wav}
   213	
   214	
   215	def compare_stages(test, ref):
   216	    """``{stage: comparison}`` of two :func:`run_stages` outputs (``ref`` = A)."""
   217	    out = {"cond": compare_cond(test["cond"], ref["cond"])}
   218	    out.update({s: stage_rel(test[s], ref[s]) for s in STAGES[1:]})
   219	    return out
