  1266	             "YAW": "Yaw-Aug @40k (YAW-pin, re-measured at the exp_25 pin)"}
  1267	SHORT = {"RIR_to_GT_RIR_R@1": "R@1", "RIR_to_GT_RIR_R@5": "R@5", "RIR_to_GT_RIR_R@10": "R@10"}
