    49	def _check_int(name, v, lo):
    50	    if isinstance(v, bool) or not isinstance(v, int) or v < lo:
    51	        raise ValueError(f"{name} must be an int >= {lo}, got {v!r}")
    52	
    53	
    54	def draw_offsets(n_items, img_w, seed):
    55	    """``{key: [d_i per item]}``: the four fixed column offsets and one independent
    56	    uniform draw in ``[1, img_w - 1]`` per item from a generator seeded with
    57	    ``seed + RANDOM_OFFSET_SEED_SHIFT``."""
    58	    _check_int("n_items", n_items, 1)
    59	    _check_int("img_w", img_w, max(FIXED_OFFSETS) + 1)  # the registered offsets must not wrap
    60	    _check_int("seed", seed, 0)
    61	    out = {f"d{d}": [d] * n_items for d in FIXED_OFFSETS}
    62	    g = torch.Generator().manual_seed(seed + RANDOM_OFFSET_SEED_SHIFT)
    63	    out["random"] = [int(d) for d in torch.randint(1, img_w, (n_items,), generator=g)]
    64	    return out
    65	
    66	
    67	def item_noise(i, shape, seed):
    68	    """Item ``i``'s fixed noise: its own generator, seeded from ``(seed, i)`` through
    69	    numpy's SeedSequence, so it does not depend on how many items run."""
    70	    s = int(np.random.SeedSequence([int(seed), int(i)]).generate_state(1, dtype=np.uint64)[0])
    71	    return torch.randn(tuple(shape), generator=torch.Generator().manual_seed(s & (2 ** 63 - 1)))
    72	
    73	
    74	def noise_bank(n_items, shape, seed):
    75	    """``[n_items, *shape]`` float32: one seeded noise tensor per item, reused for A and B."""
    76	    return torch.stack([item_noise(i, shape, seed) for i in range(n_items)])
