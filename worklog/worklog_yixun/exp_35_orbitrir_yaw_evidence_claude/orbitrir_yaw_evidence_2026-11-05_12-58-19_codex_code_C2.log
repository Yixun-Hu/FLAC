   668	def select_cells(manifest, blocks=None, only=None, limit=None):
   669	    """The rows to run, in the manifest's (priority) order: ``blocks`` (e.g. the A1 switch =
   670	    every block but YAW-pin), ``only`` (cell names), ``limit`` (first N). Unknown or
   671	    duplicate names, an empty list and a non-positive limit are ``ValueError``."""
   672	    for label, names, universe in (("block", blocks, list(manifest["blocks"])),
   673	                                   ("cell", only, [c["cell"] for c in manifest["cells"]])):
   674	        if names is not None and (not names or len(set(names)) != len(names)
   675	                                  or any(n not in universe for n in names)):
   676	            raise ValueError(f"unknown, duplicate or empty {label} selection {names!r}")
   677	    if limit is not None and (type(limit) is not int or limit < 1):
   678	        raise ValueError(f"--limit must be a positive int, got {limit!r}")
   679	    rows = [c for c in manifest["cells"] if (blocks is None or c["block"] in blocks)
   680	            and (only is None or c["cell"] in only)]

