   663	        elif os.path.islink(cache) or not os.path.isfile(cache) or not os.path.samestat(os.stat(here), os.stat(cache)):
   664	            reasons.append(f"farm entry {link} is not a hard link of the verified cache file {cache}")
   665	    return reasons
