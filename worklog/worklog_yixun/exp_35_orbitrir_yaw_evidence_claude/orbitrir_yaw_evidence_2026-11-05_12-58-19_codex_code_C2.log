   529	def cell_paths(row, link, dump_root):
   530	    """Every path of one cell, derived exactly as eval_FLAC derives them from ``link`` (the arm's
   531	    ``cond_method`` names it: a B-F cell carries ``_fa_invariant_a4``)."""
   532	    P = arm_protocol(row["arm"])
   533	    m = eval_FLAC.build_output_paths(
   534	        link, 1, 1.0, row["cell"], cond_method=P["cond_method"], rotate_deg=float(row["rotate_deg"] or 0),
   535	        n_angles=4 if P["frame_avg_angles"] is None else len(P["frame_avg_angles"]), rotate_mode=row["rotate_mode"],
   536	        rotate_seed=row["rotate_seed"], are_lambda=None,
   537	        canonicalize=row["canonicalize"], canon_mismatch=row["canon_mismatch"])["metrics"]
   538	    return CellPaths(link, m, eval_FLAC.stream_sidecar_path(m), eval_FLAC.canon_sidecar_path(m),
   539	                     m[:-len(".json")] + ".cell.json", eval_FLAC.scored_waveform_dir(dump_root, m),
   540	                     os.path.basename(m)[:-len(".json")])
