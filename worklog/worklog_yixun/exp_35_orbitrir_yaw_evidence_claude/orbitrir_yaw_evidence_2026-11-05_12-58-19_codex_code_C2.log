   641	    if is_exp35(row) and isinstance(docs["receipt"], dict):   # exp_35 §3b: its log re-read at every verification
   642	        log = docs["receipt"].get("log")
   643	        reasons += backend_log_file_reasons(at(log) if isinstance(log, str) else None, backend_target)
   644	    if dump_check == "receipt":
   645	        pass                       # offline: the receipt's evidence stands for the dump (decision A7)
   646	    elif expect_dump:
   647	        reasons += dump_reasons(at(paths.dump_dir), row, stem=stem, stream=docs["stream"],
   648	                                expect=expect, pin=pin, mode=dump_check)
   649	        try:
