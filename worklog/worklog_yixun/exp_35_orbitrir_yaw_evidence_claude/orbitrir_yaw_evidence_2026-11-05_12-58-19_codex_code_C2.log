   709	def build_receipt(entry, row, *, base_dir, lane, log, rc, pin, ckpt_sha256, ckpt_bytes, campaign_digest,
   710	                  spawn_digest, post_digest, backend=None):
   711	    """The cell's receipt (``.cell.json``) as a dict: refuses a measured checkpoint digest that
   712	    is not the expected one and a tree digest at the spawn / after the run that is not the
   713	    campaign's; binds the committed artifacts' digests and, for a dump, its evidence (B6); and
   714	    (rB-F2 F2-6) the evaluator's digest of the bytes it deserialized, which must equal the
   715	    expected one, with the length the driver measured (``ckpt_bytes``)."""
   716	    if ckpt_sha256 != entry["sha256"]:
   717	        raise ValueError(f"{entry['cell']}: measured checkpoint sha256 {ckpt_sha256} != the expected "
   718	                         f"{entry['sha256']}")
   719	    if backend != (backend_fields() if is_exp35(row) else None):   # exp_35: the runner's backend claim
   720	        raise ValueError(f"{entry['cell']}: attention backend fields {backend!r} are not "
   721	                         f"{backend_fields() if is_exp35(row) else None!r} for this cell")
   722	    if not eval_FLAC._is_sha256_hex(campaign_digest) or {spawn_digest, post_digest} != {campaign_digest}:
   723	        raise ValueError(f"{entry['cell']}: tree digest moved (campaign {campaign_digest}, spawn {spawn_digest}, "
   724	                         f"post {post_digest})")
   725	    at = lambda p: os.path.join(base_dir, p) if p else None  # noqa: E731
   726	    artifacts = {"metrics": _file_digest(at(entry["metrics"])), "stream": _file_digest(at(entry["stream"])),
   727	                 "canon": _file_digest(at(entry["canon"]))}
   728	    if artifacts["metrics"] is None or artifacts["stream"] is None or (entry["canon"] and artifacts["canon"] is None):
   729	        raise ValueError(f"{entry['cell']}: nothing to bind -- the metrics / stream / canon files are not all there")
   730	    try:
   731	        with open(at(entry["metrics"])) as f:
   732	            met = json.load(f)
   733	        loaded = {k: met.get(k) for k in LOAD_KEYS} if isinstance(met, dict) else {}
   734	    except (OSError, ValueError) as err:
   735	        raise ValueError(f"{entry['cell']}: the metrics record is unreadable ({err})") from err
   736	    if loaded.get("ckpt_sha256_loaded") != entry["sha256"]:
   737	        raise ValueError(f"{entry['cell']}: the evaluator loaded checkpoint bytes with sha256 "
   738	                         f"{loaded.get('ckpt_sha256_loaded')!r}, not the expected {entry['sha256']}")
   739	    if type(ckpt_bytes) is not int or ckpt_bytes <= 0 or loaded.get("ckpt_bytes_loaded") != ckpt_bytes:
   740	        raise ValueError(f"{entry['cell']}: the evaluator loaded {loaded.get('ckpt_bytes_loaded')!r} checkpoint "
   741	                         f"bytes, the driver measured {ckpt_bytes!r} bytes")
   742	    try:
   743	        evidence = dump_evidence(at(entry["dump_dir"])) if entry["dump"] else None
   744	    except (OSError, ValueError) as err:
   745	        raise ValueError(f"{entry['cell']}: the dump cannot be bound ({err})") from err
   746	    return {"schema_version": RECEIPT_SCHEMA_VERSION_EXP35 if backend else RECEIPT_SCHEMA_VERSION,
   747	            "cell": entry["cell"], "stem": entry["stem"],
   748	           "block": row["block"], "arm": row["arm"], "step": row["step"], "ckpt_link": entry["link"],
