 def _sentinel(stdout):
     lines = [ln for ln in stdout.splitlines() if ln.startswith(SENTINEL + " ")]
     assert len(lines) == 1, stdout
     return dict(tok.split("=", 1) for tok in lines[0].split()[1:])
 
 
 def _pair_then_sentinel(stdout):
