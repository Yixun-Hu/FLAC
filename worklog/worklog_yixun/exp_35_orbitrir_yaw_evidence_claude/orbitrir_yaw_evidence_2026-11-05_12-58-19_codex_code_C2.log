    76	TS="$(date '+%Y-%m-%d_%H-%M-%S')"
    77	
    78	die() { echo "$*"; exit 2; }
    79	
    80	BLOCKS=""; ONLY=""; LIMIT=""; NO_DUMP=""; DUMP_ROOT=""; LANES_CSV="0,1"; CANON_MANIFEST=""
    81	while [ $# -gt 0 ]; do
    82	  case "$1" in
    83	    --blocks|--only|--limit|--no-dump-blocks|--dump-root|--lanes|--canon-ckpt-manifest)
    84	      [ $# -ge 2 ] || die "$1 needs a value - abort"
    85	      case "$1" in
    86	        --blocks) BLOCKS="$2" ;; --only) ONLY="$2" ;; --limit) LIMIT="$2" ;;
    87	        --no-dump-blocks) NO_DUMP="$2" ;; --dump-root) DUMP_ROOT="$2" ;;
    88	        --lanes) LANES_CSV="$2" ;; --canon-ckpt-manifest) CANON_MANIFEST="$2" ;;
    89	      esac
    90	      shift 2 ;;
    91	    *) die "unknown argument '$1' - abort" ;;
    92	  esac
    93	done
    94	case "$DRY_RUN" in 0|1) ;; *) die "DRY_RUN must be 0 or 1 (got '${DRY_RUN}') - abort" ;; esac
    95	ALLOW_SHARED_GPU="${ALLOW_SHARED_GPU:-0}"
    96	case "$ALLOW_SHARED_GPU" in 0|1) ;; *) die "ALLOW_SHARED_GPU must be 0 or 1 (got '${ALLOW_SHARED_GPU}') - abort" ;; esac
    97	[[ "$LANES_CSV" =~ ^[0-9]+(,[0-9]+)*$ ]] || die "--lanes must be a comma list of GPU indices (got '${LANES_CSV}') - abort"
    98	IFS=, read -r -a LANES <<<"$LANES_CSV"
    99	[ "$(printf '%s\n' "${LANES[@]}" | sort -u | wc -l)" -eq "${#LANES[@]}" ] || die "--lanes repeats a GPU - abort"
   100	[ -z "$LIMIT" ] || [[ "$LIMIT" =~ ^[1-9][0-9]*$ ]] || die "--limit must be a positive integer - abort"
   101	[[ "$GPU_POLL_SECONDS" =~ ^[0-9]+$ && "$GPU_MAX_POLLS" =~ ^[0-9]+$ ]] || die "GPU_POLL_SECONDS / GPU_MAX_POLLS must be integers - abort"
   102	
   103	# --- harness (tests only): stub evaluator + manifest, everything under one /tmp dir -- #
   104	HARNESS_FLAG=false; HREAL=""
   105	if [ -n "$HARNESS" ]; then
   106	  HREAL="$(readlink -f -- "$HARNESS" 2>/dev/null || true)"
   107	  case "$HREAL" in /tmp/?*) ;; *) die "DEPTH_CANON_EVAL_HARNESS must be a directory under /tmp (got '${HARNESS}') - abort" ;; esac
   108	  [ -d "$HREAL" ] && [ -f "$HREAL/.depth_canon_eval_harness" ] || die "DEPTH_CANON_EVAL_HARNESS '${HARNESS}' lacks its marker - abort"
   109	  in_harness() { case "$(readlink -f -- "$1" 2>/dev/null)" in "$HREAL"/?*) [ -f "$1" ] ;; *) return 1 ;; esac; }
   110	  EVAL_PROG="${DEPTH_CANON_EVAL_PY:-}"; CELLS="${DEPTH_CANON_CELLS:-}"
   111	  in_harness "$EVAL_PROG" && in_harness "$CELLS" || die "HARNESS: DEPTH_CANON_EVAL_PY and DEPTH_CANON_CELLS must be files in ${HREAL} - abort"
   112	  FARM_ROOT="$HREAL/farm"; LOGDIR="$HREAL/logs"; LOCKDIR="$HREAL"; HARNESS_FLAG=true
   113	  mkdir -p "$LOGDIR" || die "HARNESS: cannot create ${LOGDIR} - abort"
   114	fi
   115	
   116	# --- one campaign at a time; everything teed into a timestamped log ------------------ #
   117	exec 9>"$LOCKDIR/.depth_canon_eval.lock" || die "cannot open ${LOCKDIR}/.depth_canon_eval.lock - abort"
   118	flock -n 9 || die "another evaluation campaign holds ${LOCKDIR}/.depth_canon_eval.lock - abort"
   119	LOG="$LOGDIR/depth_canon_${TS}_eval_run.log"
   120	exec > >(tee -a "$LOG") 2>&1
   121	echo "=== exp_25 depth_canon eval campaign -- ${TS} -- HEAD $(git rev-parse HEAD) -- dry_run=${DRY_RUN} -- harness=${HARNESS_FLAG} ==="
   122	[ -x "$PY" ] || die "the flac interpreter ${PY} is missing - abort"
   123	for tool in jq flock findmnt sha256sum; do command -v "$tool" >/dev/null || die "${tool} is required - abort"; done
   124	[ -f "$CELLS" ] || die "the cells manifest ${CELLS} is missing - abort"
   125	
   126	# --- evaluator pin: HEAD + a committed evaluator / data / config / kit tree ---------- #
   127	[[ "$EXPECT_HEAD" =~ ^[0-9a-f]{40}$ ]] || die "EXPECT_HEAD must be the full 40-hex evaluator pin (got '${EXPECT_HEAD}') - abort"
   128	HEAD_SHA="$(git rev-parse HEAD)"
   129	[ "$HEAD_SHA" = "$EXPECT_HEAD" ] || die "HEAD PIN FAILED: HEAD ${HEAD_SHA} != EXPECT_HEAD ${EXPECT_HEAD} - abort"
   130	mapfile -t MODEL_CFGS < <(jq -r '.arms[].model_config' "$CELLS")
   131	RELEVANT=(eval_FLAC.py src ':(exclude)src/tests' data/AR "${MODEL_CFGS[@]}" "$SELF" "$COLLECT" "$MAKE_CELLS"
   132	          "$EXPDIR/depth_canon_cells.json" "$EXPDIR/depth_canon_audit_gate.py" "$NO_FLASH_DIR" "$IDENTITY")
   133	tree_dirty() { git status --porcelain --untracked-files=all -- "${RELEVANT[@]}"; }
   134	tree_digest() {   # sha256 of the sorted sha256sum lines of every tracked + untracked (unignored) relevant file
   135	  local lines
   136	  lines="$(git ls-files -z --cached --others --exclude-standard -- "${RELEVANT[@]}" | LC_ALL=C sort -zu \
   137	    | xargs -0r sha256sum --)" && [ -n "$lines" ] || return 1
   138	  printf '%s\n' "$lines" | sha256sum | awk '{print $1}'
   139	}
   140	DIRTY="$(tree_dirty)"
   141	[ -z "$DIRTY" ] || { echo "EVALUATOR TREE NOT COMMITTED at HEAD (every cell must run the pinned code):"; echo "$DIRTY"; exit 2; }
   142	CAMPAIGN_DIGEST="$(tree_digest)" || die "TREE DIGEST FAILED: cannot hash the relevant tree - abort"
   143	echo "evaluator pin OK: ${HEAD_SHA}; evaluator tree digest ${CAMPAIGN_DIGEST}"
   144	while read -r path sha; do
   145	  [ -f "$path" ] || die "CONFIG MISSING: ${path} - abort"
   146	  got="$(sha256sum "$path" | awk '{print $1}')"
   147	  [ "$got" = "$sha" ] || die "CONFIG PIN FAILED: ${path} is ${got}, the manifest pins ${sha} - abort"
   148	done < <(jq -r '[.cells[] | (.model_config + " " + .model_config_sha256),
   149	                 (.dataset_config + " " + .dataset_config_sha256)] | unique[]' "$CELLS")
   150	echo "configs OK: every model / dataset config matches its manifest pin"
   151	for pin in "$NO_FLASH_OVERLAY $NO_FLASH_OVERLAY_SHA256" "$NO_FLASH_LAUNCHER $NO_FLASH_LAUNCHER_SHA256"; do
   152	  read -r path sha <<<"$pin"
   153	  got="$(sha256sum -- "$path" 2>/dev/null | awk '{print $1}')"
   154	  [ "$got" = "$sha" ] || die "NO-FLASH PIN FAILED: ${path} hashes to '${got}', the runner pins ${sha} - abort"
   155	done
   156	echo "no-flash overlay + launcher OK: ${NO_FLASH_OVERLAY_SHA256:0:12} / ${NO_FLASH_LAUNCHER_SHA256:0:12} (exp_35 cells only)"
   157	if [ "$HARNESS_FLAG" = false ]; then
   158	  "$PY" "$MAKE_CELLS" --check || die "CELLS MANIFEST DRIFT: ${CELLS} is not the generator's output - abort"
   159	fi
   160	
   161	# --- the plan: selection, checkpoints, paths, argv (depth_canon_collect.py) --------- #
   162	PLAN="$LOGDIR/depth_canon_${TS}_eval_plan.json"
   163	PLAN_ARGS=(--plan "$PLAN" --cells "$CELLS" --farm-root "$FARM_ROOT" --no-dump-blocks "$NO_DUMP"
   164	           --campaign-digest "$CAMPAIGN_DIGEST")
   165	[ -n "$DUMP_ROOT" ] && PLAN_ARGS+=(--dump-root "$DUMP_ROOT")
   166	[ -n "$BLOCKS" ] && PLAN_ARGS+=(--blocks "$BLOCKS")
   167	[ -n "$ONLY" ] && PLAN_ARGS+=(--only "$ONLY")
   168	[ -n "$LIMIT" ] && PLAN_ARGS+=(--limit "$LIMIT")
   169	[ -n "$CANON_MANIFEST" ] && PLAN_ARGS+=(--canon-ckpt-manifest "$CANON_MANIFEST")
   170	"$PY" "$COLLECT" "${PLAN_ARGS[@]}" || die "PLAN REFUSED (see above) - abort"
   171	DUMP_ROOT="$(jq -r .dump_root "$PLAN")"
   172	mapfile -t CELL_IDS < <(jq -r '.cells[].cell' "$PLAN")
   173	echo "plan: ${#CELL_IDS[@]} cell(s); dump root ${DUMP_ROOT}; farm ${FARM_ROOT}; lanes ${LANES_CSV}"
   174	N_NOFLASH="$(jq '[.cells[] | select(.no_flash == true)] | length' "$PLAN")"
   175	if [ -n "$COTENANTS" ]; then   # exp_35 §12 B1.1: the approved identity tuple of a SHARED lane
   176	  [ "$ALLOW_SHARED_GPU" = 1 ] || die "EXP35_APPROVED_COTENANTS names the co-tenants of a shared card: it needs ALLOW_SHARED_GPU=1 - abort"
   177	  "$PY" "$IDENTITY" --validate "$COTENANTS" || die "CO-TENANT TUPLE REFUSED: ${COTENANTS} - abort"
   178	elif [ "$ALLOW_SHARED_GPU" = 1 ] && [ "$N_NOFLASH" -gt 0 ]; then
   179	  die "an exp_35 cell shares a card only with the approved identity tuple: set EXP35_APPROVED_COTENANTS - abort"
   180	fi
   181	if [ "$N_NOFLASH" -gt 0 ]; then   # exp_35 §11 B1: the launcher's own checks, on the CPU, before any spawn
   182	  PREFLIGHT_LOG="$LOGDIR/depth_canon_${TS}_no_flash_preflight.log"
   183	  { CUDA_VISIBLE_DEVICES= HF_HUB_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$REPO/$NO_FLASH_DIR" \
   184	      "$PY" "$NO_FLASH_LAUNCHER" --preflight > "$PREFLIGHT_LOG" 2>&1 \
   185	    && "$PY" "$COLLECT" --check-backend-log "$PREFLIGHT_LOG" --backend-target=--preflight 2>&1 \
   186	       | grep -v -e pkg_resources -e declare_namespace; [ "${PIPESTATUS[0]}" -eq 0 ]; } \
   187	    || die "NO-FLASH PRE-FLIGHT FAILED (log ${PREFLIGHT_LOG}) - abort"
   188	  echo "no-flash pre-flight OK: ${N_NOFLASH} exp_35 cell(s) spawn through ${NO_FLASH_LAUNCHER} (log ${PREFLIGHT_LOG})"
   189	fi
   190	
   191	# --- the dump root, verified ONCE: on the NAS share, created, write-probed ----------- #
   192	nas_identity_ok() {
   193	  local line
   194	  line="$(findmnt -n -T "$1" -o FSTYPE,SOURCE 2>/dev/null || true)"
   195	  grep -qE "^${NAS_FSTYPE}[[:space:]]+${NAS_SOURCE//./\\.}\$" <<<"$line" && return 0
   196	  echo "DUMP ROOT GATE FAILED: ${1} is on '$(tr '\n' ';' <<<"$line")', not '${NAS_FSTYPE} ${NAS_SOURCE}' - abort"
   197	  return 1
   198	}
   199	if [ "$(jq '[.cells[] | select(.dump)] | length' "$PLAN")" -gt 0 ]; then
   200	  [[ "$DUMP_ROOT" = /?* && "$DUMP_ROOT" != *.staging-* ]] || die "DUMP ROOT GATE FAILED: '${DUMP_ROOT}' must be absolute, no '.staging-' - abort"
   201	  [ ! -L "$DUMP_ROOT" ] || die "DUMP ROOT GATE FAILED: ${DUMP_ROOT} is a symlink - abort"
   202	  anc="$DUMP_ROOT"; while [ ! -e "$anc" ] && [ "$anc" != / ]; do anc="$(dirname "$anc")"; done
   203	  nas_identity_ok "$anc" || exit 2
   204	  if [ "$DRY_RUN" = 1 ]; then
   205	    echo "dump root OK under DRY_RUN: ${DUMP_ROOT} ($([ -d "$DUMP_ROOT" ] && echo exists || echo 'would be created'))"
   206	  else
   207	    mkdir -p "$DUMP_ROOT" && nas_identity_ok "$DUMP_ROOT" || die "DUMP ROOT GATE FAILED: cannot create ${DUMP_ROOT} - abort"
   208	    probe="$DUMP_ROOT/.depth_canon_eval_probe_$$"
   209	    { printf 'probe\n' > "$probe" && [ "$(cat "$probe")" = probe ] && rm -f "$probe" && [ ! -e "$probe" ]; } 2>/dev/null \
   210	      || { rm -f "$probe" 2>/dev/null; die "DUMP ROOT GATE FAILED: write probe in ${DUMP_ROOT} - abort"; }
   211	    echo "dump root OK: ${DUMP_ROOT} is ${NAS_FSTYPE} ${NAS_SOURCE}, write probe created + removed"
   212	  fi
   213	fi
   214	
   215	# --- the farm: a real local directory (never a symlink out of the checkout) ---------- #
   216	farm_ok() {   # <dir>: absent (DRY_RUN) or a real directory under the repo / harness
   217	  [ ! -L "$1" ] || die "FARM GATE FAILED: ${1} is a symlink - abort"
   218	  [ -e "$1" ] || return 0
   219	  case "$(readlink -f -- "$1")" in "$(readlink -f "$REPO")"/?*|"${HREAL:-/nonexistent}"/?*) ;;
   220	    *) die "FARM GATE FAILED: ${1} resolves outside this checkout - abort" ;; esac
   221	}
   222	farm_ok "$FARM_ROOT"
   223	
   224	# --- the checkpoint cache: a free-space gate on the local filesystem BEFORE any copy --- #
   225	CACHE_DIR="$FARM_ROOT/.ckpt_cache"; CACHE_MARGIN=$((2 * 1024 * 1024 * 1024))
   226	farm_ok "$CACHE_DIR"
   227	NEED=0; N_STAGE=0
   228	while IFS=$'\x1f' read -r target sha; do
   229	  [ -f "$CACHE_DIR/${sha}.ckpt" ] && continue
   230	  [ -f "$target" ] || die "CHECKPOINT MISSING: ${target} - abort"
   231	  NEED=$((NEED + $(stat -c %s -- "$target"))); N_STAGE=$((N_STAGE + 1))
   232	done < <(jq -r '[.cells[] | (.target + "\u001f" + .sha256)] | unique[]' "$PLAN")
   233	anc="$CACHE_DIR"; while [ ! -e "$anc" ]; do anc="$(dirname "$anc")"; done
   234	AVAIL="$(df -B1 --output=avail -- "$anc" 2>/dev/null | tail -n 1 | tr -d ' ')"
   235	[[ "$AVAIL" =~ ^[0-9]+$ ]] || die "CACHE SPACE GATE FAILED: df cannot report the free space of ${anc} - abort"
   236	echo "checkpoint cache space: ${N_STAGE} checkpoint(s) to stage = $((NEED)) B + ${CACHE_MARGIN} B margin = $((NEED + CACHE_MARGIN)) B needed; ${AVAIL} B available on ${anc}"
   237	[ "$AVAIL" -ge $((NEED + CACHE_MARGIN)) ] || die "CACHE SPACE GATE FAILED: $((NEED + CACHE_MARGIN)) B needed > ${AVAIL} B available - abort"
   238	
   239	# --- per cell: checkpoint, link, (predicate), (run) ----------------------------------- #
   240	declare -A SHA_DONE=() CKPT_SIZE=()
   241	cache_ok() {   # <cache> <sha>: the immutable-cache contract (regular, 0444, the source's size) + a full re-hash
   242	  local got mode size
   243	  { [ -f "$1" ] && [ ! -L "$1" ]; } || { CACHE_WHY="${1} is not a regular file"; return 1; }
   244	  mode="$(stat -c %a -- "$1")"; size="$(stat -c %s -- "$1")"
   245	  [ "$mode" = 444 ] || { CACHE_WHY="${1} has mode ${mode}, not the immutable 0444"; return 1; }
   246	  [ "$size" = "${CKPT_SIZE[$2]:-}" ] || { CACHE_WHY="${1} is ${size} bytes, the source is ${CKPT_SIZE[$2]:-unknown}"; return 1; }
   247	  got="$(sha256sum -- "$1" | awk '{print $1}')"
   248	  [ "$got" = "$2" ] || { CACHE_WHY="${1} hashes to ${got}, not ${2}"; return 1; }
   249	}
   250	stage_ckpt() {   # target sha nas-manifest nas-key cache: the verified immutable cache file (once per sha)
   251	  local target="$1" want="$2" nasm="$3" key="$4" cache="$5" got tmp
   252	  [ -f "$target" ] || { echo "CHECKPOINT MISSING: ${target} - abort"; return 1; }
   253	  if [ -n "$nasm" ]; then
   254	    grep -qxF "${want}  ${key}" "$nasm" 2>/dev/null || { echo "NAS MANIFEST CHECK FAILED: ${nasm} does not list '${want}  ${key}' - abort"; return 1; }
   255	  fi
   256	  [ -n "${SHA_DONE[$want]:-}" ] && return 0
   257	  CKPT_SIZE[$want]="$(stat -c %s -- "$target")"
   258	  if [ "$DRY_RUN" = 1 ]; then   # read-only: hash the source, stage nothing
   259	    got="$(sha256sum -- "$target" | awk '{print $1}')"
   260	    [ "$got" = "$want" ] || { echo "CHECKPOINT SHA MISMATCH: ${target} is ${got}, the manifest pins ${want} - abort"; return 1; }
   261	    echo "checkpoint OK (DRY_RUN, not staged): ${target} (${want})"
   262	  elif [ -e "$cache" ] || [ -L "$cache" ]; then   # rB-F2 F2-6 (a): the immutable-cache contract, then the bytes
   263	    cache_ok "$cache" "$want" || { echo "CACHE GATE FAILED: ${CACHE_WHY} - abort"; return 1; }
   264	    echo "checkpoint OK: cached ${cache} re-verified (0444, ${CKPT_SIZE[$want]} bytes, ${want})"
   265	  else
   266	    mkdir -p "$CACHE_DIR" && ( farm_ok "$CACHE_DIR" ) || { echo "CACHE GATE FAILED: cannot create ${CACHE_DIR} - abort"; return 1; }
   267	    tmp="$CACHE_DIR/.staging-${want}-$$"
   268	    cp --no-preserve=all -- "$target" "$tmp" || { rm -f -- "$tmp"; echo "CACHE GATE FAILED: cannot copy ${target} - abort"; return 1; }
   269	    got="$(sha256sum -- "$tmp" | awk '{print $1}')"
   270	    if [ "$got" != "$want" ]; then
   271	      rm -f -- "$tmp"; echo "CHECKPOINT SHA MISMATCH: the copy of ${target} is ${got}, the manifest pins ${want} - abort"; return 1
   272	    fi
   273	    { chmod 0444 -- "$tmp" && mv -n -T -- "$tmp" "$cache" && [ ! -e "$tmp" ]; } \
   274	      || { rm -f -- "$tmp"; echo "CACHE GATE FAILED: cannot publish ${cache} - abort"; return 1; }
   275	    echo "checkpoint OK: ${target} -> ${cache} (the local copy hashes to the pin ${want})"
   276	  fi
   277	  SHA_DONE[$want]=1
   278	}
   279	farm_entry_ok() {   # <entry> <cache>: a regular file (never a symlink) on the cache file's inode
   280	  [ ! -L "$1" ] && [ -f "$1" ] && [ ! -L "$2" ] && [ -f "$2" ] \
   281	    && [ "$(stat -c '%d:%i:%s' -- "$1")" = "$(stat -c '%d:%i:%s' -- "$2")" ]
   282	}
   283	cell_fields() {
   284	  jq -r --arg c "$1" '.cells[] | select(.cell == $c) | [.arm, .block, .target, .sha256,
   285	      (.nas_manifest // ""), (.nas_manifest_key // ""), .link, .metrics, .stream, (.canon // ""),
   286	      .canon_probe, .receipt, (.dump | tostring), .dump_dir, .stem, .cache, (.no_flash | tostring)]
   287	      | join("\u001f")' "$PLAN"
   288	}
   289	VERIFY_EXTRA=(); [ -n "$CANON_MANIFEST" ] && VERIFY_EXTRA=(--canon-ckpt-manifest "$CANON_MANIFEST")
   290	existing_artifacts() {   # every artifact of the current cell that exists (one path per line)
