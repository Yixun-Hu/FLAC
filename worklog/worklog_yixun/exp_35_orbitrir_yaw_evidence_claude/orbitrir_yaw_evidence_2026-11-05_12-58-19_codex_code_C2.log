   572	def find_canon_manifest(expdir=EXPDIR):
   573	    """The ONE launcher checkpoint manifest in the experiment folder, else ``FileNotFoundError``."""
   574	    hits = sorted(glob.glob(os.path.join(expdir, "depth_canon_*_exp25_CANON_checkpoints.sha256")))
   575	    if len(hits) != 1:
   576	        raise FileNotFoundError(f"expected exactly one depth_canon_*_exp25_CANON_checkpoints.sha256 in "
   577	                                f"{expdir}, found {len(hits)}: pass --canon-ckpt-manifest")
   578	    return hits[0]
