   543	def expected_checkpoint(row, manifest, canon_index):
   544	    """``(target path, sha256)`` the cell must have been evaluated on."""
   545	    ck = manifest["arms"][row["arm"]]["ckpt"]
   546	    if ck["kind"] == "endpoint":
   547	        return ck["path"], ck["sha256"]
   548	    if not canon_index or row["step"] not in canon_index:
   549	        raise KeyError(f"no CANON checkpoint index entry for step {row['step']} (the launcher's "
   550	                       "depth_canon_*_exp25_CANON_checkpoints.sha256 is required for CANON cells)")
   551	    return canon_index[row["step"]]
   552	
   553	
   554	def load_canon_index(path, run_ns):
   555	    """``{step: (path, sha256)}`` from the launcher's FULL checkpoint manifest (``sha256sum``
   556	    lines). Every line must be one checkpoint of the CANON run namespace; any other line,
   557	    a malformed digest or a duplicate step is a ``ValueError`` (fail-closed)."""
   558	    pat = re.compile(re.escape(run_ns.rstrip("/")) + r"/checkpoints/epoch=\d+-step=(\d+)\.ckpt")
   559	    index = {}
   560	    with open(path) as f:
   561	        for line in f.read().splitlines():
   562	            sha, sep, ckpt = line.partition("  ")
   563	            m = pat.fullmatch(ckpt) if sep and eval_FLAC._is_sha256_hex(sha) else None
   564	            if m is None:
   565	                raise ValueError(f"{path}: {line!r} is not a checkpoint of the CANON run {run_ns}")
   566	            if int(m.group(1)) in index:
   567	                raise ValueError(f"{path}: duplicate step {m.group(1)}")
   568	            index[int(m.group(1))] = (ckpt, sha)
   569	    return index
