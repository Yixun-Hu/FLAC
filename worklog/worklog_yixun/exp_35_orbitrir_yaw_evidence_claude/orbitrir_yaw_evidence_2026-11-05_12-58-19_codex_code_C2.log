   743	        evidence = dump_evidence(at(entry["dump_dir"])) if entry["dump"] else None
   744	    except (OSError, ValueError) as err:
   745	        raise ValueError(f"{entry['cell']}: the dump cannot be bound ({err})") from err
   746	    return {"schema_version": RECEIPT_SCHEMA_VERSION_EXP35 if backend else RECEIPT_SCHEMA_VERSION,
   747	            "cell": entry["cell"], "stem": entry["stem"],
   748	           "block": row["block"], "arm": row["arm"], "step": row["step"], "ckpt_link": entry["link"],
   749	           "ckpt_target": entry["target"], "ckpt_sha256": entry["sha256"],
   750	           "ckpt_cache": ckpt_cache_path(entry["link"], entry["sha256"]), "ckpt_sha256_measured": ckpt_sha256,
   751	           "ckpt_sha256_loaded": loaded["ckpt_sha256_loaded"], "ckpt_bytes_loaded": loaded["ckpt_bytes_loaded"],
   752	           "model_config": row["model_config"],
   753	           "model_config_sha256": row["model_config_sha256"], "dataset_config": row["dataset_config"],
   754	           "dataset_config_sha256": row["dataset_config_sha256"],
   755	           "expected_stream_count": row["expected_stream_count"], "dump": entry["dump"],
   756	           "dump_root": entry["dump_root"] if entry["dump"] else None, "argv": entry["argv"],
   757	           "expect_head": pin, "campaign_digest": campaign_digest, "spawn_digest": spawn_digest,
   758	           "post_digest": post_digest, "artifact_sha256": artifacts, "dump_evidence": evidence,
   759	           "lane": lane, "log": log, "rc": rc, **(backend or {})}
