   581	def verify_cell(stem, *, manifest, farm_root, dump_root, pin, canon_index=None, base_dir=REPO,
   582	                dump_check="full", expect_dump=True, check_link=True, expect_digest=None, receipt_doc=None,
   583	                backend_target=NO_FLASH["target"]):
   584	    """Named reasons the cell ``stem`` is not complete-and-verified ([] = the driver may skip
   585	    it, the generator may publish it). Checks the metrics record, stream and canon sidecars,
   586	    the driver's receipt (its committed-artifact digests and dump evidence), the dump
   587	    (``dump_check`` 'full' = ``is_complete`` once, 'manifest' = marker + manifest, both + the
   588	    receipt's evidence == the dump on disk; 'receipt' = OFFLINE, the receipt's evidence stands
   589	    for the dump, no NAS read), and -- ``check_link`` -- the farm entry's cache identity.
   590	    ``receipt_doc``: a draft receipt verified before it is written. Relative artifact paths
   591	    resolve against ``base_dir`` (the evaluator's cwd)."""
   592	    if not re.fullmatch(r"[0-9a-f]{40}", str(pin)):
   593	        return [f"pin {pin!r} is not a full 40-hex commit"]
   594	    ckpt_name, _, suffix = stem.partition("_metrics_")
   595	    rows = [c for c in manifest["cells"] if c["metrics_suffix"] == suffix]
   596	    if len(rows) != 1 or not ckpt_name:
   597	        return [f"{stem!r} names no registered cell of the manifest ({len(rows)} suffix matches)"]
   598	    row = rows[0]
   599	    if is_exp35(row) != row["cell"].startswith("exp35_"):
   600	        return [f"{row['cell']!r}: the name and the block {row['block']!r} name different campaigns"]
   601	    try:
   602	        target, sha = expected_checkpoint(row, manifest, canon_index)
   603	    except KeyError as err:
   604	        return [str(err).strip("'\"")]
   605	    if os.path.basename(target) != ckpt_name + ".ckpt":
   606	        return [f"{stem!r}: checkpoint {ckpt_name!r} is not this cell's {os.path.basename(target)!r}"]
   607	    link = os.path.join(farm_root, row["arm"], os.path.basename(target))
   608	    paths = cell_paths(row, link, dump_root)
   609	    at = lambda p: os.path.join(base_dir, p)  # noqa: E731 -- an absolute p stays absolute
   610	    docs, reasons = {}, []
   611	    if dump_check not in ("full", "manifest", "receipt"):
   612	        raise ValueError(f"dump_check must be 'full', 'manifest' or 'receipt', got {dump_check!r}")
   613	    if receipt_doc is not None:   # a draft receipt, verified BEFORE it is written (rB-F1 B6)
   614	        docs["receipt"] = receipt_doc
   615	    wanted = [("metrics", paths.metrics), ("stream", paths.stream)] + (
   616	        [("receipt", paths.receipt)] if receipt_doc is None else [])
   617	    for key, path in wanted + ([("canon", paths.canon)] if row["canonicalize"] else []):
   618	        try:
   619	            with open(at(path)) as f:
   620	                docs[key] = json.load(f)
   621	        except (OSError, ValueError) as err:
   622	            reasons.append(f"missing or unreadable {key} artifact {path} ({type(err).__name__})")
   623	    if reasons:
   624	        return reasons
   625	    if not row["canonicalize"] and os.path.lexists(at(paths.canon)):
   626	        reasons.append(f"unexpected canon sidecar {paths.canon} for a cell without canonicalization")
   627	    reasons += record_reasons(docs["metrics"], row, pin=pin, link=link)
   628	    reasons += stream_reasons(docs["stream"], row, docs["metrics"])
   629	    if row["canonicalize"]:
   630	        reasons += canon_reasons(docs["canon"], row, docs["stream"], docs["metrics"])
   631	    canon = paths.canon if row["canonicalize"] else None
   632	    expect = {"ckpt_path": link, "metrics_path": paths.metrics, "metrics_file": at(paths.metrics),
   633	              "stream_sidecar_path": paths.stream, "stream_file": at(paths.stream),
   634	              "canon_sidecar_path": canon, "canon_file": at(canon) if canon else None}
   635	    reasons += receipt_reasons(docs["receipt"], row, stem=stem, link=link, target=target,
   636	                               ckpt_sha256=sha, dump=expect_dump, dump_root=dump_root, pin=pin,
   637	                               expect_digest=expect_digest, expect=expect, stream=docs["stream"])
   638	    if isinstance(docs["metrics"], dict) and isinstance(docs["receipt"], dict):   # rB-F2 F2-6: loaded == receipt
   639	        for key in LOAD_KEYS:
   640	            _eq(reasons, f"metrics record {key} vs the receipt's", docs["metrics"].get(key), docs["receipt"].get(key))
   641	    if is_exp35(row) and isinstance(docs["receipt"], dict):   # exp_35 §3b: its log re-read at every verification
   642	        log = docs["receipt"].get("log")
   643	        reasons += backend_log_file_reasons(at(log) if isinstance(log, str) else None, backend_target)
   644	    if dump_check == "receipt":
   645	        pass                       # offline: the receipt's evidence stands for the dump (decision A7)
   646	    elif expect_dump:
   647	        reasons += dump_reasons(at(paths.dump_dir), row, stem=stem, stream=docs["stream"],
   648	                                expect=expect, pin=pin, mode=dump_check)
   649	        try:
   650	            if not isinstance(docs["receipt"], dict) or \
   651	                    dump_evidence(at(paths.dump_dir)) != docs["receipt"].get("dump_evidence"):
   652	                reasons.append("receipt dump_evidence != the dump on disk now")
   653	        except (OSError, ValueError):
   654	            pass                   # the dump itself is reported unreadable above
   655	    elif os.path.lexists(at(paths.dump_dir)) or staging_leftovers(at(paths.dump_dir)):
   656	        reasons.append(f"a dump exists at {paths.dump_dir} for a cell run without one")
   657	    if check_link:   # rB-F1 B4: a regular file on the verified cache file's inode, never a symlink
   658	        here, cache = at(link), at(ckpt_cache_path(link, sha))
   659	        if os.path.islink(here):
   660	            reasons.append(f"farm entry {link} is a symlink, not the hard link of the cache file {cache}")
   661	        elif not os.path.isfile(here):
   662	            reasons.append(f"farm entry {link} is absent or not a regular file")
   663	        elif os.path.islink(cache) or not os.path.isfile(cache) or not os.path.samestat(os.stat(here), os.stat(cache)):
   664	            reasons.append(f"farm entry {link} is not a hard link of the verified cache file {cache}")
   665	    return reasons
