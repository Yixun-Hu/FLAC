   631	    canon = paths.canon if row["canonicalize"] else None
   632	    expect = {"ckpt_path": link, "metrics_path": paths.metrics, "metrics_file": at(paths.metrics),
   633	              "stream_sidecar_path": paths.stream, "stream_file": at(paths.stream),
   634	              "canon_sidecar_path": canon, "canon_file": at(canon) if canon else None}
