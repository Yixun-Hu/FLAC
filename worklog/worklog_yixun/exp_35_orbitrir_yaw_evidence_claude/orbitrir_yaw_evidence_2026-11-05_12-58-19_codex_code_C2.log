   359	def dump_evidence(dump_dir):
   360	    """What a receipt binds of a fully verified dump (rB-F1 B6, decision A7): the manifest's exact
   361	    bytes (digest + content), the COMPLETE marker and the waveforms sidecar -- enough to
   362	    re-verify the publication offline, without the NAS."""
   363	    import hashlib
   364	    with open(os.path.join(dump_dir, "manifest.json"), "rb") as f:
   365	        raw = f.read()
   366	    with open(os.path.join(dump_dir, eval_FLAC.SCORED_DUMP_MARKER)) as f:
   367	        marker = f.read()
   368	    with open(os.path.join(dump_dir, "waveforms.sha256")) as f:
   369	        side = f.read()
   370	    return {"manifest_sha256": hashlib.sha256(raw).hexdigest(), "manifest": json.loads(raw), "marker": marker,
   371	            "waveforms_sidecar": side}
