   762	def write_receipt(entry, row, *, base_dir, receipt=None, **kw):
   763	    """Atomically write the cell's receipt (``receipt`` = an already-built, verified dict, or
   764	    built here from ``kw``) -- temp file + ``os.replace``."""
   765	    rec = receipt if receipt is not None else build_receipt(entry, row, base_dir=base_dir, **kw)
   766	    path = os.path.join(base_dir, entry["receipt"])
   767	    tmp = f"{path}.tmp-{os.getpid()}"
   768	    with open(tmp, "w") as f:
   769	        json.dump(rec, f, indent=2)
   770	    os.replace(tmp, path)
   771	    return path
