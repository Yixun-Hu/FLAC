    65	NO_FLASH_LAUNCHER="$NO_FLASH_DIR/exp35_no_flash_launch.py"; NO_FLASH_LAUNCHER_SHA256="bbd2847d3a50685420750d066195c8656a1509b4e905883886c0568d244043de"
    66	IDENTITY="worklog/worklog_yixun/exp_35_orbitrir_yaw_evidence_claude/exp35_gpu_identity.py"
