   374	def evidence_reasons(ev, row, *, stem, stream, expect, pin):
   375	    """The receipt's dump evidence, OFFLINE: self-consistent (the recorded manifest serializes,
   376	    as the evaluator writes it, to ``manifest_sha256``), the marker and sidecar the evaluator
   377	    writes for its waveform sha256, and the manifest bound to this cell and to the committed
   378	    metrics / stream / canon files."""
   379	    import hashlib
   380	    if not (isinstance(ev, dict) and set(ev) == {"manifest_sha256", "manifest", "marker", "waveforms_sidecar"}):
   381	        return [f"receipt dump_evidence {ev!r:.80} is missing or malformed"]
   382	    m, out = ev["manifest"], []
   383	    if not isinstance(m, dict) or hashlib.sha256(json.dumps(m, indent=2).encode()).hexdigest() != ev["manifest_sha256"]:
   384	        out.append("receipt dump_evidence.manifest_sha256 is not the digest of the recorded manifest")
   385	    out += manifest_reasons(m, ev["marker"], row, stem=stem, stream=stream, expect=expect, pin=pin,
   386	                            label="receipt dump_evidence manifest")
   387	    if ev["waveforms_sidecar"] != f"{m.get('sha256') if isinstance(m, dict) else None}  waveforms.npy\n":
   388	        out.append("receipt dump_evidence waveforms sidecar is not the sha256sum line of the waveform digest")
   389	    return out
