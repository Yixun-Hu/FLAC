   414	def backend_fields():
   415	    """The receipt-v2 backend fields of every exp_35 cell (the pinned overlay + launcher)."""
   416	    return {"attention_backend": NO_FLASH["backend"], "no_flash_overlay_sha256": NO_FLASH["overlay_sha256"],
