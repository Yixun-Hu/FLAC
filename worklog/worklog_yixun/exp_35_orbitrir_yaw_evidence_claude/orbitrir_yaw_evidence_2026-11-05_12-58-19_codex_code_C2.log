    71	NAS_FSTYPE="cifs"; NAS_SOURCE="//10.249.7.28/shared_data"
    72	MIN_GPU_FREE_MIB=10240
    73	GPU_POLL_SECONDS="${GPU_POLL_SECONDS:-600}"; GPU_MAX_POLLS="${GPU_MAX_POLLS:-0}"
    74	DRY_RUN="${DRY_RUN:-0}"; EXPECT_HEAD="${EXPECT_HEAD:-}"; HARNESS="${DEPTH_CANON_EVAL_HARNESS:-}"
