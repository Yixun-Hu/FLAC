   420	def backend_log_reasons(text, target=NO_FLASH["target"]):
   421	    """The log of a launcher run proves the SDPA backend: transformer.py printed the overlay's ImportError
   422	    and its fallback line exactly once, back to back; the launcher then printed ONE sentinel with the
   423	    backend, the pinned overlay + launcher sha256 and ``target``; no line reports a MISSING flash_attn
   424	    (an import that never met the overlay)."""
   425	    lines, nf, out = text.splitlines(), NO_FLASH, []
   426	    if any(nf["missing_line"] in ln for ln in lines):
   427	        out.append(f"the log reports {nf['missing_line']!r}: an import ran without the overlay")
   428	    ov = [i for i, ln in enumerate(lines) if ln == nf["overlay_line"]]
   429	    fb = [i for i, ln in enumerate(lines) if ln == nf["fallback_line"]]
   430	    if not (len(ov) == len(fb) == 1 and fb[0] == ov[0] + 1):
   431	        out.append(f"the log holds {len(ov)} overlay ImportError line(s) and {len(fb)} SDPA fallback line(s), "
   432	                   "not one back-to-back pair")
   433	    sent = [i for i, ln in enumerate(lines) if ln.startswith(nf["sentinel"] + " ")]
   434	    if len(sent) != 1:
   435	        return out + [f"the log holds {len(sent)} no-flash launcher sentinel line(s), not exactly one"]
   436	    got = dict(tok.partition("=")[::2] for tok in lines[sent[0]].split()[1:])
   437	    want = {"attention_backend": nf["backend"], "overlay_sha256": nf["overlay_sha256"],
   438	            "launcher_sha256": nf["launcher_sha256"], "target": target}
   439	    if got != want:
   440	        out.append(f"the launcher sentinel {got} != {want}")
   441	    if fb and sent[0] < fb[-1]:
   442	        out.append("the launcher sentinel precedes the SDPA fallback line")
   443	    return out
