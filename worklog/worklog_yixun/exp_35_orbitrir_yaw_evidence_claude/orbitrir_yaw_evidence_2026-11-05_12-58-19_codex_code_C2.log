   684	def plan_cells(manifest, selected, *, farm_root, dump_root, canon_index, no_dump_blocks):
   685	    """One driver entry per selected row: the checkpoint to verify (target + expected
   686	    sha256 + NAS manifest key), the farm link, every artifact path, whether it dumps
   687	    (``no_dump_blocks`` deselects a block's dumps, A3), and the exact evaluator argv."""
   688	    bad = [b for b in no_dump_blocks if b not in manifest["blocks"]]
   689	    if bad:
   690	        raise ValueError(f"unknown --no-dump-blocks {bad}")
   691	    out = []
   692	    for row in selected:
   693	        ck = manifest["arms"][row["arm"]]["ckpt"]
   694	        target, sha = expected_checkpoint(row, manifest, canon_index)
   695	        link = os.path.join(farm_root, row["arm"], os.path.basename(target))
   696	        dump = bool(row["dump"]) and row["block"] not in no_dump_blocks
   697	        p = cell_paths(row, link, dump_root)
   698	        out.append({"cell": row["cell"], "block": row["block"], "arm": row["arm"], "step": row["step"],
   699	                    "K": row["K"], "seed": row["seed"], "target": target, "sha256": sha,
   700	                    "nas_manifest": ck.get("nas_manifest"), "nas_manifest_key": ck.get("nas_manifest_key"),
   701	                    "link": link, "cache": ckpt_cache_path(link, sha), "metrics": p.metrics, "stream": p.stream,
   702	                    "canon": p.canon if row["canonicalize"] else None, "canon_probe": p.canon,
   703	                    "receipt": p.receipt, "dump": dump, "dump_root": dump_root, "dump_dir": p.dump_dir,
   704	                    "stem": p.stem, "expected_stream_count": row["expected_stream_count"],
   705	                    "argv": cell_argv(row, link, dump_root, dump), "no_flash": is_exp35(row)})
   706	    return out
