import sys, pathlib
src, dst, T = pathlib.Path(sys.argv[1]).read_text(), pathlib.Path(sys.argv[2]), sys.argv[3]
s = src
rep = [('RUNX="$RUN/$REL"; MAINX="$MAIN/$REL";', f'RUNX="$RUN/$REL"; MAINX="{T}/out";'),
       ('TUPLE_DIR="$RUNX" ', f'TUPLE_DIR="{T}/run" '), ('LADDER_DIR="$RUNX" ', f'LADDER_DIR="{T}/ladder" '),
