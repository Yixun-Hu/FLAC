   170	      1) need "rung 2: DRY RUN OK and the worktree unchanged" bash -c 'grep -q "^DRY RUN OK" "$1" && grep -q "IDENTICAL" "$1"' _ "$f" ;;
   171	      2) need "rung 3: runner rc 0 and the digest ${PIN_DIGEST:0:8}…" bash -c 'grep -q "runner rc 0" "$1" && grep -q "evaluator tree digest $2" "$1"' _ "$f" "$PIN_DIGEST" ;;
   172	      3) need "rung 4: a pytest summary with passes and no failure or error" bash -c 'l="$(grep -E "^[0-9]+ passed" "$1" | tail -n 1)"; [ -n "$l" ] && ! printf "%s" "$l" | grep -q -E "failed|error"' _ "$f"
   173	         rec "rung 4 summary" bash -c 'grep -E "^[0-9]+ passed" "$1" | tail -n 1' _ "$f" ;;
