   226	  rec "GPU map / memory" nvidia-smi --query-gpu=index,uuid,memory.used,memory.free,utilization.gpu --format=csv,noheader
   227	  rec "compute apps" nvidia-smi --query-compute-apps=pid,gpu_uuid,used_memory --format=csv,noheader
   228	  rec "his s43 ranks" ps -o pid,ppid,lstart,etime,cmd -p "$RANK0,$TRAINER"
   229	  local p; for p in "$RANK0" "$TRAINER"; do say "pid $p: cwd $(readlink /proc/$p/cwd) fd1 $(readlink /proc/$p/fd/1) fd2 $(readlink /proc/$p/fd/2)"; done
