   275	launch() {
   276	  local seal="${3:-}" ssha="${4:-}" tuple tsha copy csha clog clsha age suplog pid found
   277	  say "=== exp_35 phase (i) LAUNCH -- $(date -Is) -- H35 ${H35} -- seal ${seal} ${ssha} ==="
   278	  say "this script: ${SELF_SHA}  $0"
   279	  script_check
   280	  need "the seal is a regular file in the main checkout's exp_35 folder" bash -c '[ -f "$1" ] && [ ! -L "$1" ] && [ "$(dirname "$1")" = "$2" ]' _ "$seal" "$MAINX"
   281	  need "the seal's sha256 is the given value" eq "$(sha "$seal")" "$ssha"
   282	  [ "$FAIL" = 0 ] || { say "LAUNCH REFUSED: the seal"; return 1; }
   283	  cat "$seal"
   284	  sv() { awk -v k="$1" '$1 == k {$1 = ""; sub(/^ /, ""); print; exit}' "$seal"; }
   285	  need "the seal names this H35" eq "$(sv h35)" "$H35"
   286	  need "the seal names this script" eq "$(sv script_sha256)" "$SELF_SHA"
   287	  need "the seal names the pinned campaign digest" eq "$(sv campaign_digest)" "$PIN_DIGEST"
   288	  read -r tuple tsha <<<"$(sv tuple)"; read -r copy csha <<<"$(sv tuple_copy)"; read -r clog clsha <<<"$(sv capture_log)"
   289	  need "the tuple is the canonical run-worktree file" bash -c '[ "${1%/*}" = "$2" ] && [[ "${1##*/}" =~ ^exp35_approved_cotenants_$3\.json$ ]] && [ -f "$1" ] && [ ! -L "$1" ]' _ "$tuple" "$TUPLE_DIR" "$TS_RE"
   290	  need "the tuple still hashes to the sealed value" eq "$(sha "$tuple")" "$tsha"
   291	  need "the record copy is the main-checkout file of the same name, byte-identical" bash -c '[ "$1" = "$2/${3##*/}" ] && [ -f "$1" ] && [ ! -L "$1" ] && [ "$(sha256sum < "$1" | cut -c1-64)" = "$4" ] && [ "$4" = "$5" ]' _ "$copy" "$MAINX" "$tuple" "$csha" "$tsha"
   292	  need "the capture log is the canonical main-checkout file" bash -c '[ "${1%/*}" = "$2" ] && [[ "${1##*/}" =~ ^orbitrir_yaw_evidence_$3_phase_i_capture\.log$ ]] && [ -f "$1" ] && [ ! -L "$1" ]' _ "$clog" "$MAINX" "$TS_RE"
   293	  need "the capture log still hashes to the sealed value and shows CAPTURE CHECKS OK" bash -c '[ "$(sha256sum < "$1" | cut -c1-64)" = "$2" ] && grep -q "^CAPTURE CHECKS OK" "$1" && ! grep -q "^CHECK FAILED" "$1"' _ "$clog" "$clsha"
   294	  local sealed; sealed="$(sv sealed_at | awk '{print $1}')"
   295	  need "the seal's sealed_at is a decimal epoch (${sealed})" bash -c '[[ "$1" =~ ^[0-9]{10}$ ]]' _ "$sealed"
   296	  [[ "$sealed" =~ ^[0-9]{10}$ ]] || sealed=0
   297	  age=$(( $(date +%s) - sealed ))
   298	  need "the seal is current (${age} s old <= ${SEAL_MAX_AGE_S} s)" test "$age" -ge 0 -a "$age" -le "$SEAL_MAX_AGE_S"
   299	  local k name path want; for k in 1 2 3 4; do
   300	    read -r name want <<<"$(sv "ladder_$k")"
   301	    need "ladder rung $k: a canonical basename" bash -c '[[ "$1" =~ ^orbitrir_yaw_evidence_$2_LADDER_$3_[a-z0-9_]+_at_$4\.log$ ]]' _ "$name" "$TS_RE" "$k" "${H35:0:8}"
   302	    need "ladder rung $k transcript unchanged since the capture" eq "$(sha "$LADDER_DIR/$name")" "$want"; done
   303	  need "the tuple validates" "$PY" -B "$IDH" --validate "$tuple" --approved-sha256 "$tsha"
   304	  mutable_checks
   305	  common_checks
   306	  need "the live GPU 1 set equals the tuple" "$PY" -B "$IDH" --check --approved "$tuple" --approved-sha256 "$tsha" --gpu-uuid "$GPU1" --pids "$(gpu1_pids)"
   307	  dry_run "$tuple" "$tsha"
