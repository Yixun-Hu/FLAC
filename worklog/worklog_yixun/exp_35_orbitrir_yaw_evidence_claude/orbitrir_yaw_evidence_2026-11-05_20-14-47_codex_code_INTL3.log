    76	need() {  # <what> <command...>: a hard check
    77	  local what="$1"; shift
    78	  if "$@" >/dev/null 2>&1; then say "CHECK OK: $what"; else say "CHECK FAILED: $what"; FAIL=1; fi
    79	}
    80	sha() { sha256sum < "$1" 2>/dev/null | cut -c1-64; }
    81	eq() { [ "$1" = "$2" ]; }
    82	procs_named() {   # PIDs other than this script with an argv element whose basename is exactly $1 (no pgrep: no self-match)
    83	  local d pid a; local -a argv
    84	  for d in /proc/[0-9]*; do
    85	    pid=${d#/proc/}; [ "$pid" = "$$" ] && continue
    86	    { mapfile -d '' argv < "$d/cmdline"; } 2>/dev/null || continue
    87	    for a in "${argv[@]}"; do [ "${a##*/}" = "$1" ] && { say "$pid"; break; }; done
    88	  done
    89	  return 0
    90	}
    91	procs_glob() {    # the same, for a basename glob
    92	  local d pid a; local -a argv
    93	  for d in /proc/[0-9]*; do
    94	    pid=${d#/proc/}; [ "$pid" = "$$" ] && continue
    95	    { mapfile -d '' argv < "$d/cmdline"; } 2>/dev/null || continue
    96	    for a in "${argv[@]}"; do [[ "${a##*/}" == $1 ]] && { say "$pid"; break; }; done
    97	  done
    98	  return 0
    99	}
