   258	  [ "$FAIL" = 0 ] || { say "CAPTURE REFUSED: the record copy"; return 1; }
   259	  { printf 'h35 %s\nscript_sha256 %s\ntuple %s %s\ntuple_copy %s %s\ncampaign_digest %s\n' "$H35" "$SELF_SHA" \
