   261	    local e name path want; for e in "${PINS[@]}"; do IFS='|' read -r name path want <<<"$e"; printf 'pin_%s %s %s\n' "$name" "$path" "$want"; done
   262	    printf 'pip_freeze %s\nversions %s\nhis_step %s\n' "$PIN_PIP" "$PIN_VERSIONS" "$step"; } >> "$draft"
   263	  say "CAPTURE CHECKS OK (the seal is written after this log is closed)"
   264	  return 0
   265	}
