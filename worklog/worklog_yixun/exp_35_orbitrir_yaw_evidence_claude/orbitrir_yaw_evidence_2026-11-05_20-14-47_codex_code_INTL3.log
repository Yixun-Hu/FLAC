   159	ladder_checks() {   # <draft>: the four-rung ladder at H35 (untracked transcripts in the run worktree), content + sha256
   160	  local short="${H35:0:8}" k f n
   161	  local -a pat=("1_exp25_byte_guard" "2_supervisor_live_dry_run" "3_runner_dry_run_phase_i" "4_all_suites_in_worktree")
   162	  for k in 0 1 2 3; do
