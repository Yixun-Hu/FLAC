   267	seal_write() {   # <draft> <capture log>: the seal, a NEW file, only after a fully passing capture
   268	  local seal="$MAINX/orbitrir_yaw_evidence_${TS}_phase_i_capture_seal.txt"
   269	  ( set -o noclobber; { cat "$1"; printf 'capture_log %s %s\nsealed_at %s %s\n' "$2" "$(sha "$2")" "$(date +%s)" "$(date -Is)"; } > "$seal" ) \
   270	    || { say "SEAL REFUSED: ${seal} exists"; return 1; }
   271	  say "SEAL ${seal} sha256 $(sha "$seal")"
   272	  say "LAUNCH LINE: EXPECT_SCRIPT_SHA256=${SELF_SHA} bash $0 launch ${H35} ${seal} $(sha "$seal")"
   273	}
