   220	  need "the 116 exp_35 rows 500d6f5e…" grep -qx 'exp35_rows_sha256 500d6f5ed9c70700fdd4c778895fc84e01f7756fbac84ad2471a9346ab9252ea' "$cells_txt"
   221	  need "the exp_25-only render = d6ca307a's manifest (1073ef64…)" grep -qx "exp25_only_render_sha256 $(git -C "$RUN" show d6ca307a:"$X25"/depth_canon_cells.json | sha256sum | cut -c1-64)" "$cells_txt"
   222	  rm -f -- "$cells_txt"
