   164	    need "exactly one ladder rung $((k + 1)) transcript at ${short}" eq "$n" 1
   165	    f="$(ls "$LADDER_DIR"/orbitrir_yaw_evidence_*_LADDER_${pat[$k]}_at_${short}.log 2>/dev/null | head -n 1)"
   166	    say "ladder rung $((k + 1)): ${f##*/} sha256 $(sha "$f")"
