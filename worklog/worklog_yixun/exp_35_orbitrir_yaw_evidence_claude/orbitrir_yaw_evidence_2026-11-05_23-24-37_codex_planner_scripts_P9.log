    69	def fake_proc(root, pid, argv, ppid=1, start=1000, cwd="/somewhere"):
    70	    d = root / str(pid)
    71	    (d / "fd").mkdir(parents=True)
    72	    (d / "cmdline").write_bytes(b"".join(a.encode() + b"\0" for a in argv))
    73	    fields = ["S", str(ppid)] + ["0"] * 17 + [str(start)] + ["0"] * 10
    74	    (d / "stat").write_text(f"{pid} ({os.path.basename(argv[0])}) " + " ".join(fields) + "\n")
    75	    os.symlink(cwd, d / "cwd")
    76	    os.symlink("/dev/null", d / "fd" / "1")
    77	    os.symlink("/dev/null", d / "fd" / "2")
    78	    return d
