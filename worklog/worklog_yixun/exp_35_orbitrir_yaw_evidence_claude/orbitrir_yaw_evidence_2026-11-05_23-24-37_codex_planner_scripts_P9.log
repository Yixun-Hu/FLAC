    50	say() { printf '%s\n' "$*"; }
    51	need() {  # <what> <command...>: a hard check
    52	  local what="$1"; shift
    53	  if "$@" >/dev/null 2>&1; then say "CHECK OK: $what"; else say "CHECK FAILED: $what"; FAIL=1; fi
    54	}
    55	sha() { sha256sum < "$1" 2>/dev/null | cut -c1-64; }
    56	eq() { [ "$1" = "$2" ]; }
    57	py() { env -i "${LAUNCH_ENV[@]}" CUDA_VISIBLE_DEVICES= "$PY" -B "$@"; }   # every helper in the launch environment
    58	uuid_of() { case "$1" in GPU0) say "$GPU0" ;; GPU1) say "$GPU1" ;; *) say "" ;; esac; }
    59	field() { awk -v k="$2" '{for (i = 1; i < NF; i++) if ($i == k) {print $(i + 1); exit}}' <<<"$1"; }
    60	ok_capture() { [[ "$1" == "CAPTURE OK "* ]]; }
    61	script_check() { need "EXPECT_SCRIPT_SHA256 is set and equals this script's sha256 (${SELF_SHA})" eq "${EXPECT_SCRIPT_SHA256:-unset}" "$SELF_SHA"; }
    62	
    63	common_checks() {   # <orch> <run>: the preconditions both modes check right before they act
    64	  local head e rel want out rc
    65	  head="$(git -C "$W" rev-parse HEAD 2>/dev/null)"
    66	  need "HEAD ${head} = PIN2 ${PIN2}" eq "$head" "$PIN2"
    67	  need "the tracked tree is clean" eq "$(git -C "$W" status --porcelain --untracked-files=no 2>&1)" ""
    68	  for e in "${PINS[@]}"; do IFS='|' read -r rel want <<<"$e"; need "pin ${rel} ${want:0:8}..." eq "$(sha "$W/$rel")" "$want"; done
    69	  need "outputs_loc -> ${OUTPUTS_TARGET}" eq "$(readlink -f "$W/outputs_loc")" "$OUTPUTS_TARGET"
    70	  need "weights -> ${WEIGHTS_TARGET}" eq "$(readlink -f "$W/weights")" "$WEIGHTS_TARGET"
    71	  need "AcousticRooms -> ${ROOMS_TARGET}" eq "$(readlink -f "$W/AcousticRooms")" "$ROOMS_TARGET"
    72	  for rel in "${ASSETS[@]}"; do need "asset ${rel}" test -f "$W/$rel"; done
    73	  for rel in "${ASSET_DIRS[@]}"; do need "asset ${rel}/" test -d "$W/$rel"; done
    74	  need "the flac interpreter and pytest's own __main__.py" test -x "$PY" -a -f "$PYTEST_MAIN"
    75	  need "the DINOv3 HF cache T's tests need (${DINO_CACHE})" test -d "$DINO_CACHE"
    76	  need "the run's r2_gates_${2} and r2_probe_BF_${2} do not exist" test ! -e "$EX/r2_gates_$2" -a ! -e "$EX/r2_probe_BF_$2"
    77	  out="$(py "$SUP" active --except-orch "$1")"; rc=$?; say "$out"
    78	  need "no exp22 run is active or unresolved" test "$rc" = 0
    79	}
    80	
    81	card_now() {   # <card> <sealed index or empty>: one observation under the card rule
    82	  local out rc
    83	  out="$(py "$COMMON" observe --card "$1")"; rc=$?; say "observation: $out"
    84	  need "$1 is free under its rule now" test "$rc" = 0
    85	  [ -z "$2" ] || need "$1 is at the sealed index $2" eq "$(jq -r .index <<<"$out" 2>/dev/null)" "$2"
    86	}
    87	
    88	capture() {   # <card> <run> <orch> <draft>
    89	  local card="$1" run="$2" orch="$3" draft="$4" rec="$3/capture_polls.jsonl" chk rsha t e rel want
    90	  say "=== exp_22 R2-C pre-flight CAPTURE -- $(date -Is) -- host $(hostname) -- PIN2 ${PIN2} -- ${card} -- run ${run} ==="
    91	  say "this script: ${SELF_SHA}  $0"
    92	  script_check
    93	  common_checks "$orch" "$run"
    94	  card_now "$card" ""
    95	  [ "$FAIL" = 0 ] || { say "CAPTURE REFUSED before the polls: at least one CHECK failed (see above)"; return 1; }
    96	  say ""; say "### the sealed admission polls of ${card} (A7 r3 (b)) -> ${rec}"
    97	  py "$EVID" capture-polls --card "$card" --record "$rec"
    98	  need "every sealed poll on time and free" test "$?" = 0
    99	  rsha="$(sha "$rec")"
   100	  chk="$(py "$EVID" check-capture --card "$card" --record "$rec" --sha256 "$rsha" --fresh)"; say "$chk"
   101	  need "the capture record verifies (sha256 ${rsha})" ok_capture "$chk"
   102	  say ""; say "### the checks again, after the window"
   103	  common_checks "$orch" "$run"
   104	  card_now "$card" "$(field "$chk" index)"
   105	  [ "$FAIL" = 0 ] || { say "CAPTURE REFUSED: at least one CHECK failed (see above); no seal"; return 1; }
   106	  { printf 'pin2 %s\nscript_sha256 %s\nrun %s\ncard %s %s %s\n' "$PIN2" "$SELF_SHA" "$run" "$card" "$(uuid_of "$card")" \
   107	      "$(field "$chk" index)"
   108	    printf 'capture_record %s %s\nfirst_poll %s\nlast_poll %s\n' "$rec" "$rsha" "$(field "$chk" first)" "$(field "$chk" last)"
   109	    for t in "${TOOL_FILES[@]}"; do printf 'tool %s %s\n' "$t" "$(sha "$TOOLS/$t")"; done
   110	    for e in "${PINS[@]}"; do IFS='|' read -r rel want <<<"$e"; printf 'pin %s %s\n' "$rel" "$want"; done; } > "$draft"
   111	  say "CAPTURE CHECKS OK (the seal is written after this log is closed)"
   112	}
   113	
   114	seal_write() {   # <draft> <capture log> <orch>: the seal, a NEW file, only after a fully passing capture
   115	  local seal="$3/seal.txt"
   116	  ( set -o noclobber; { cat "$1"; printf 'capture_log %s %s\nsealed_at %s %s\n' "$2" "$(sha "$2")" "$(date +%s)" \
   117	      "$(date -Is)"; } > "$seal" ) 2>/dev/null || { say "SEAL REFUSED: ${seal} exists"; return 1; }
   118	  say "SEAL ${seal} sha256 $(sha "$seal")"
   119	  say "LAUNCH LINE (within 10 min of the last poll): EXPECT_SCRIPT_SHA256=${SELF_SHA} bash $0 launch ${PIN2} ${seal} $(sha "$seal")"
   120	}
   121	
   122	launch() {   # <seal> <seal sha256>
   123	  local seal="$1" ssha="$2" orch run card cuuid idx rec rsha clog clsha chk out rc pid suplog extra t want
   124	  orch="$(dirname "$seal")"; run="${orch##*_}"
   125	  say "=== exp_22 R2-C pre-flight LAUNCH -- $(date -Is) -- host $(hostname) -- PIN2 ${PIN2} -- seal ${seal} ${ssha} ==="
   126	  say "this script: ${SELF_SHA}  $0"
   127	  script_check
   128	  need "the seal is the regular file seal.txt of this run's orchestration directory" \
   129	    bash -c '[ -f "$1" ] && [ ! -L "$1" ] && [ "${1##*/}" = seal.txt ]' _ "$seal"
   130	  need "the seal hashes to the given sha256" eq "$(sha "$seal")" "$ssha"
   131	  [ "$FAIL" = 0 ] || { say "LAUNCH REFUSED: the seal"; return 1; }
   132	  cat "$seal"
   133	  sv() { awk -v k="$1" '$1 == k {$1 = ""; sub(/^ /, ""); print; exit}' "$seal"; }
   134	  need "the seal names PIN2" eq "$(sv pin2)" "$PIN2"
   135	  need "the seal names this script" eq "$(sv script_sha256)" "$SELF_SHA"
   136	  need "the seal names this run" eq "$(sv run)" "$run"
   137	  read -r card cuuid idx <<<"$(sv card)"
   138	  need "the sealed card ${card} is registered as ${cuuid}" bash -c '[ -n "$1" ] && [ "$1" = "$2" ]' _ "$(uuid_of "$card")" "$cuuid"
   139	  read -r rec rsha <<<"$(sv capture_record)"; read -r clog clsha <<<"$(sv capture_log)"
   140	  need "the capture record is this run's" eq "$rec" "$orch/capture_polls.jsonl"
   141	  need "the capture log is this run's, unchanged, with CAPTURE CHECKS OK and no CHECK FAILED" bash -c \
   142	    '[ "$1" = "$2/capture.log" ] && [ -f "$1" ] && [ ! -L "$1" ] && [ "$(sha256sum < "$1" | cut -c1-64)" = "$3" ] && grep -q "^CAPTURE CHECKS OK" "$1" && ! grep -q "^CHECK FAILED" "$1"' \
   143	    _ "$clog" "$orch" "$clsha"
   144	  need "the seal binds all ${#TOOL_FILES[@]} tools" eq "$(grep -c '^tool ' "$seal")" "${#TOOL_FILES[@]}"
   145	  while read -r _ t want; do need "tool ${t} unchanged since the capture" eq "$(sha "$TOOLS/$t")" "$want"; done < <(grep '^tool ' "$seal")
   146	  extra="$(ls -A "$orch" | grep -v -x -E 'capture\.log|capture_polls\.jsonl|seal\.txt|launch_[0-9]{8}T[0-9]{6}\.log')"
   147	  need "the orchestration directory holds only the capture and launch logs (no state yet)" eq "$extra" ""
   148	  chk="$(py "$EVID" check-capture --card "$card" --record "$rec" --sha256 "$rsha" --fresh)"; say "$chk"
   149	  need "the sealed capture verifies and is fresh (<= 10 min after its last poll)" ok_capture "$chk"
   150	  need "the capture's index is the sealed index" eq "$(field "$chk" index)" "$idx"
   151	  common_checks "$orch" "$run"
   152	  card_now "$card" "$idx"
   153	  [ "$FAIL" = 0 ] || { say "LAUNCH REFUSED: at least one CHECK failed (see above)"; return 1; }
   154	  exec {LFD}<>"$LOCK" || { say "LAUNCH REFUSED: the exp22 lock ${LOCK} cannot be opened"; return 1; }
   155	  flock -x -n "$LFD" || { say "LAUNCH REFUSED: another exp22 launcher or supervisor holds ${LOCK}"; return 1; }
   156	  say "the single-instance exp22 lock ${LOCK} is held (fd ${LFD})"
   157	  chk="$(py "$EVID" check-capture --card "$card" --record "$rec" --sha256 "$rsha" --fresh)"; say "$chk"
   158	  need "last look: the sealed capture is still fresh" ok_capture "$chk"
   159	  card_now "$card" "$idx"
   160	  out="$(py "$SUP" active --except-orch "$orch" --holding-lock)"; rc=$?; say "$out"
   161	  need "last look: no other exp22 run is active or unresolved" test "$rc" = 0
   162	  [ "$FAIL" = 0 ] || { say "LAUNCH REFUSED at the last look (nothing reserved)"; return 1; }
   163	  out="$(py "$SUP" reserve --orch "$orch" --pin2 "$PIN2" --card "$card" --index "$idx" --seal "$seal" --seal-sha256 "$ssha")"
   164	  rc=$?; say "$out"
   165	  [ "$rc" = 0 ] || { say "LAUNCH REFUSED: the reservation (see above)"; return 1; }
   166	  suplog="$orch/supervisor.log"
   167	  ( set -o noclobber; : > "$suplog" ) 2>/dev/null || { say "LAUNCH NOT STARTED: ${suplog} exists (the reservation and the state stay for the Planner)"; return 1; }
   168	  say "starting: cd ${W} && env -i ${LAUNCH_ENV[*]} /usr/bin/setsid /usr/bin/nohup ${PY} -B ${SUP} run --orch ${orch} --lock-fd ${LFD} >> ${suplog} 2>&1 < /dev/null &"
   169	  ( cd "$W" && exec env -i "${LAUNCH_ENV[@]}" /usr/bin/setsid /usr/bin/nohup "$PY" -B "$SUP" run --orch "$orch" \
   170	      --lock-fd "$LFD" >> "$suplog" 2>&1 < /dev/null ) &
   171	  pid=$!
   172	  out="$(py "$SUP" confirm --orch "$orch" --pid "$pid" --timeout "$CONFIRM_TIMEOUT_S")"; rc=$?; say "$out"
   173	  if [ "$rc" = 0 ]; then
   174	    say "LAUNCHED: supervisor pid ${pid}; log ${suplog}; state ${orch}/state.json; heartbeat ${orch}/heartbeat.json"; return 0
   175	  fi
   176	  say "LAUNCH NOT CONFIRMED: inspect ${suplog} and ${orch}/state.json (never signalled here; the reservation and the state stay for the Planner)"
   177	  return 1
   178	}
   179	
   180	SELF_SHA="$(sha "$0")"
   181	case "$MODE" in
   182	  capture) [ "$#" -eq 3 ] && [[ "${3:-}" =~ ^GPU[01]$ ]] || { say "usage: EXPECT_SCRIPT_SHA256=<sha> bash $0 capture <PIN2> <GPU0|GPU1>"; exit 2; } ;;
   183	  launch) [ "$#" -eq 4 ] || { say "usage: EXPECT_SCRIPT_SHA256=<sha> bash $0 launch <PIN2> <seal> <seal sha256>"; exit 2; } ;;
   184	  *) say "usage: EXPECT_SCRIPT_SHA256=<sha> bash $0 capture <PIN2> <GPU0|GPU1> | launch <PIN2> <seal> <seal sha256>"; exit 2 ;;
   185	esac
   186	[[ "$PIN2" =~ ^[0-9a-f]{40}$ ]] || { say "PIN2 must be a 40-hex commit"; exit 2; }
   187	if [ "$MODE" = capture ]; then
   188	  RUN="$(date +%Y%m%dT%H%M%S)"; ORCH="$EX/r2_preflight_$RUN"
   189	  mkdir "$ORCH" 2>/dev/null || { say "CAPTURE REFUSED: ${ORCH} exists or ${EX} is missing"; exit 1; }
   190	  OUT="$ORCH/capture.log"; DRAFT="$(mktemp)"
   191	  ( set -o noclobber; : > "$OUT" ) || exit 1
   192	  capture "$3" "$RUN" "$ORCH" "$DRAFT" 2>&1 | tee -a "$OUT"; rc=${PIPESTATUS[0]}
   193	  say "rc ${rc}; capture log ${OUT} sha256 $(sha "$OUT")"
