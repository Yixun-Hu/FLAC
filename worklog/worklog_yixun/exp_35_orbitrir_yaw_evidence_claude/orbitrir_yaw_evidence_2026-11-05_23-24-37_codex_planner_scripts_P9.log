   139	def _gate_reasons(c, latched):
   140	    """A chunk's gate result: well formed; passed when gates_verified; a failure only under the stop latch."""
   141	    g, n = c["gate"], c["n"]
   142	    if g is None or (c["state"] == "runner_verified" and not any(k in c for k in GATE_KEYS[g])):
   143	        return []
   144	    if not all(k in c for k in GATE_KEYS[g]):
   145	        return [f"chunk {n}: an incomplete {g} result"]
   146	    if g == "PROBE":
   147	        pc = c["probe_contract"]
   148	        if not (isinstance(pc, dict) and list(pc) == ["rc", "out"] and type(pc["rc"]) is int and isinstance(pc["out"], str)):
   149	            return [f"chunk {n}: a malformed probe contract result"]
   150	        passed = pc["rc"] == 0 and all(_hex(c[k]) for k in GATE_KEYS[g][1:])
   151	    else:
   152	        r, (names, other, good) = c[GATE_KEYS[g][0]], VERDICTS[g]
   153	        if not (isinstance(r, dict) and list(r) == ["rc", "verdict", "out"] and type(r["rc"]) is int
   154	                and isinstance(r["out"], str) and r["verdict"] == names.get(r["rc"], other)):
   155	            return [f"chunk {n}: a malformed {g} result {r!r:.120}"]
   156	        passed = r["rc"] in good
   157	    if not passed and (c["state"] == "gates_verified" or not latched):
   158	        return [f"chunk {n}: a failed {g} result in a {c['state']} chunk" + ("" if latched else " without the stop latch")]
   159	    return []
