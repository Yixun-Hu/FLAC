   226	def sandbox_repo(root, common=None, shells=None):
   227	    """``(W, pin2)``: the sandbox checkout under ``root``."""
   228	    w = os.path.join(str(root), "W")
   229	    for rel in PIN_PATHS:
   230	        os.makedirs(os.path.dirname(os.path.join(w, rel)) or w, exist_ok=True)
   231	        shutil.copy(os.path.join(REPO, rel), os.path.join(w, rel))
   232	    files = {"src/__init__.py": "", "src/models/__init__.py": "", "src/models/transformer.py": _fallback_block(),
   233	             "src/localization/__init__.py": "", "src/localization/meshgrid_fa_parity.py": STANDIN_PARITY,
   234	             "localize_meshgrid.py": STANDIN_TARGET}
   235	    ids = load("exp22_r2c_evidence").T_NODE_IDS
   236	    for path in sorted({i.split("::")[0] for i in ids}):
   237	        body, seen = STANDIN_TEST_HEAD, set()
   238	        for nid in ids:
   239	            p, name = nid.split("[")[0].split("::")
   240	            if p != path or name in seen:
   241	                continue
   242	            seen.add(name)
   243	            param = "[" in nid
   244	            body += (("@pytest.mark.parametrize('n', [4, 64])\n" if param else "")
   245	                     + f"def {name}({'n' if param else ''}):\n    _behave({name!r})\n\n\n")
   246	        files[path] = body
   247	    for rel, text in files.items():
   248	        os.makedirs(os.path.dirname(os.path.join(w, rel)) or w, exist_ok=True)
   249	        with open(os.path.join(w, rel), "w") as f:
   250	            f.write(text)
   251	    if common is not None:                       # tools only with a test config (never runnable production copies)
   252	        sandbox_tools(w, common=common, shells=shells)
   253	    os.makedirs(os.path.join(w, "outputs_loc", "exp22"))
   254	    _git(w, "init", "-q")
   255	    _git(w, "add", "-A", ".")
   256	    _git(w, "commit", "-q", "-m", "sandbox PIN2")
   257	    return w, _git(w, "rev-parse", "HEAD")
