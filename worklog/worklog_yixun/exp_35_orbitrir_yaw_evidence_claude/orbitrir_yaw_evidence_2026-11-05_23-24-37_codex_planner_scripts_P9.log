   306	def phases(monkeypatch):
   307	    seen, real = [], S.E.write_json_atomic
   308	
   309	    def spy(path, doc):
   310	        if path.endswith("state.json"):
   311	            seen.append((doc["phase"], (doc["current"] or {}).get("name"), (doc["current"] or {}).get("rc")))
   312	        return real(path, doc)
   313	    monkeypatch.setattr(S.E, "write_json_atomic", spy)
   314	    return seen
     1	#!/usr/bin/env bash
     2	# exp_22 R2-C: the Planner-run pre-flight launcher (plan_loc_meshgrid_r2_bf_yaw.md §9 A7 r2 (v)(2), r3 (b) (f) (h)),
     3	# after exp_35's reviewed exp35_phase_i_launch.sh (capture -> seal -> launch).
     4	#
     5	#   EXPECT_SCRIPT_SHA256=<reviewed sha> bash exp22_r2c_preflight.sh capture <PIN2> <GPU0|GPU1>
     6	#       The hard checks (HEAD = PIN2 on a clean tracked tree, the four PIN2 pins, the assets, the run's fresh
     7	#       directories, no exp22 run active, the card free under its rule), the launcher's OWN 31 sealed polls of the
     8	#       card 60 s apart (an O_EXCL capture record), the checks again; ONLY when every check passed, the seal
     9	#       (noclobber) binding PIN2, this script's sha256, the run, the card + index, the capture record and log, the
    10	#       tools (the line list among them) and the pins. Prints the launch line. Writes only into
    11	#       outputs_loc/exp22/r2_preflight_<RUN>/.
    12	#   EXPECT_SCRIPT_SHA256=<reviewed sha> bash exp22_r2c_preflight.sh launch <PIN2> <seal> <seal sha256>
    13	#       Within 10 min of the last sealed poll: the seal and all it binds verified, every check again, the
    14	#       single-instance exp22 lock taken, the card re-checked, then (exp22_r2c_supervisor.py reserve) the O_EXCL
    15	#       reservation, the re-check after it and the first durable state "reserved"; the supervisor DETACHED (setsid +
    16	#       nohup, an env -i environment, cwd = the worktree) with the lock fd inherited; its identity confirmed.
    17	#
    18	# The Planner runs it by hand; nothing here acts unattended. It never signals, kills or edits any process; nvidia-smi
    19	# queries only. Written by the exp_22 A7 Coder (Claude Opus 5.5, max effort).
    20	set -uo pipefail
    21	# --- BEGIN REGISTERED CONFIG (the sandbox tests replace this block, and only this block) ---
    22	PY=/home/yixunhu/miniconda3/envs/flac/bin/python
    23	PYTEST_MAIN=/home/yixunhu/miniconda3/envs/flac/lib/python3.10/site-packages/pytest/__main__.py
    24	OUTPUTS_TARGET=/home/yixunhu/codespace/FLAC/outputs_loc
    25	WEIGHTS_TARGET=/home/yixunhu/codespace/FLAC/weights
    26	ROOMS_TARGET=/media/diskstation/yixunhu/FLAC/AcousticRooms
    27	CONFIRM_TIMEOUT_S=60
    28	DINO_CACHE=/home/yixunhu/.cache/huggingface/hub/models--facebook--dinov3-vits16-pretrain-lvd1689m
    29	# --- END REGISTERED CONFIG ---
    30	MODE="${1:-}"; PIN2="${2:-}"
    31	TOOLS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; W="$(cd "$TOOLS/../../../.." && pwd)"
    32	COMMON="$TOOLS/exp22_r2c_common.py"; EVID="$TOOLS/exp22_r2c_evidence.py"; SUP="$TOOLS/exp22_r2c_supervisor.py"
    33	EX="$W/outputs_loc/exp22"; LOCK="$EX/r2_preflight.lock"
    34	GPU0=GPU-0a1aaa90-3043-0321-2b0c-c35b9036624e; GPU1=GPU-6ac2604a-e84e-0615-1221-ccbed7c268da
    35	PINS=("overlays/no_flash/flash_attn.py|0d0e52ca693e236a2e0a44cd61f61539fdf995cff5132d1f621181a0f3e7c023"
    36	      "overlays/no_flash/exp35_no_flash_launch.py|bbd2847d3a50685420750d066195c8656a1509b4e905883886c0568d244043de"
    37	      "src/tests/test_exp35_no_flash_launch.py|d61a3c02a7e1295a48b3edb60e8abccab508cadb6f4c11bdca9872234bd961dd"
    38	      "pyproject.toml|6422eae5482773db252372760825749f41ac061487be892e350fda997b619a74")
    39	TOOL_FILES=(exp22_r2c_common.py exp22_r2c_evidence.py exp22_r2c_supervisor.py exp22_free_card_detect.sh
    40	            exp22_r2c_preflight.sh exp22_r2c_preflight_lines.json)
    41	ASSETS=(outputs_loc/exp22/d1_context_manifest.json outputs_loc/exp22/g1_audit/geometry_audit_report.json
    42	        weights/exp20/YAW_40k.ckpt weights/exp20/BF_40k.ckpt weights/exp20/P1_40k.ckpt
    43	        weights/FLAC/FLAC_EMA.ckpt weights/AGREE/AGREE_fullAR.pt)       # the last two: T's tests skip without them
    44	ASSET_DIRS=(outputs_loc/exp22/i1_P1_CRN_br256_20260825_194053_merged AcousticRooms/metadata AcousticRooms/depth_map)
    45	LAUNCH_ENV=(HOME=/home/yixunhu USER=yixunhu LOGNAME=yixunhu LANG=en_US.UTF-8
    46	            PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin PYTHONDONTWRITEBYTECODE=1)
