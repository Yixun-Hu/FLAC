    76	def wait_terminal(orch, timeout=240):
    77	    deadline = time.time() + timeout
    78	    while time.time() < deadline:
    79	        try:
    80	            st = json.load(open(os.path.join(orch, "state.json")))
    81	            if st["phase"] in ("released", "stopped"):
    82	                return st
    83	        except (OSError, ValueError):
    84	            pass
    85	        time.sleep(0.2)
    86	    raise AssertionError("the detached supervisor did not finish")
