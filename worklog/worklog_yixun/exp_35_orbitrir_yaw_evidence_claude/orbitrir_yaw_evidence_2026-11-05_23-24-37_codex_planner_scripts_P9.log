   417	def compute_apps(text):
   418	    """``[(pid, uuid)]`` from ``nvidia-smi --query-compute-apps=pid,gpu_uuid --format=csv,noheader``."""
   419	    out = []
   420	    for line in [ln for ln in text.splitlines() if ln.strip()]:
   421	        m = re.fullmatch(r"\s*(\d+),\s*(GPU-[0-9A-Za-z-]+)\s*", line)
   422	        if not m:
   423	            raise ValueError(f"malformed nvidia-smi compute-app row {line!r}")
   424	        out.append((int(m[1]), m[2]))
   425	    return out
