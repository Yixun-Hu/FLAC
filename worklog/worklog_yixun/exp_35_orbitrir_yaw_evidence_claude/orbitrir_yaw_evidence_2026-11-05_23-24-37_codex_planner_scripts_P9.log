   274	def reserve_box(w, pin2, cfg, world):
   275	    orch = os.path.join(w, "outputs_loc", "exp22", f"r2_preflight_{RUN}")
   276	    os.mkdir(orch)
   277	    seal = os.path.join(orch, "seal.txt")
   278	    with open(seal, "w") as f:
   279	        f.write(f"pin2 {pin2}\nrun {RUN}\ncard GPU0 {GPU0} 0\n")
   280	    rc, msg = S.reserve(world, cfg, worktree=w, orch=orch, pin2=pin2, card="GPU0", index=0, seal=seal,
   281	                        seal_sha256=E.sha256_bytes(open(seal, "rb").read()))
   282	    assert rc == 0, msg
   283	    return orch
