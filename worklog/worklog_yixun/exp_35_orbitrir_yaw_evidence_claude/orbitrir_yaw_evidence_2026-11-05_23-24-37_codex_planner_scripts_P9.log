    53	def chunk_plan():
    54	    """§7's frozen order: CTL K1 (E1), CTL K8 (E1), BF T s42 K1, BF T s42 K8 (E2), the probe, then T s43-46, R,
    55	    dup, C4+45 -- one cell per chunk, K1 before K8 at each seed / angle. The E2-FAIL block is never in it (§14 A1)."""
    56	    T = lambda k, s, x="": ("cell", f"exp35_BF_T_S40000_K{k}_s{s}{x}", None)  # noqa: E731
    57	    out = [("cell", "exp35_P1_T_S40000_K1_s42", "E1"), ("cell", "exp35_P1_T_S40000_K8_s42", "E1"), T(1, 42),
    58	           ("cell", "exp35_BF_T_S40000_K8_s42", "E2"), ("probe", None, "PROBE")]
    59	    out += [T(k, s) for s in SEEDS[1:] for k in (1, 8)]
    60	    out += [("cell", f"exp35_BF_R_S40000_K{k}_s{s}", None) for s in SEEDS for k in (1, 8)]
    61	    out += [T(k, 42, "_dup") for k in (1, 8)]
    62	    out += [("cell", f"exp35_BF_C4_S40000_K{k}_s42_th{d}", None) for d in (90, 180, 270, 45) for k in (1, 8)]
    63	    return [{"n": i + 1, "kind": kind, "cell": cell, "gate": gate} for i, (kind, cell, gate) in enumerate(out)]
