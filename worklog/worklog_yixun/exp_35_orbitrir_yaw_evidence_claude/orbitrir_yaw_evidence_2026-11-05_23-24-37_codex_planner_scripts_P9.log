   162	def _chunk_reasons(c, latched):
   163	    """Codex C3b BLOCKING 1: each state carries exactly the evidence it claims."""
   164	    n, st, cell = c["n"], c["state"], c["kind"] == "cell"
   165	    keys, base, flight = set(c), set(CHUNK_BASE), set(CHUNK_BASE + CHUNK_FLIGHT)
   166	    if st == "planned":
   167	        return [] if keys == base else [f"chunk {n}: a planned chunk carries {sorted(keys - base)}"]
   168	    if not flight <= keys:
   169	        return [f"chunk {n} ({st}): missing {sorted(flight - keys)}"]
   170	    out = [] if (isinstance(c["lane"], str) and GPU_RE.fullmatch(c["lane"]) and type(c["shared"]) is bool
   171	                 and c["shared"] == (c["lane"] == GPU1_UUID) and _text(c["started"]) and _text(c["log"])) else [
   172	        f"chunk {n}: a malformed lane / shared / started / log"]
   173	    rc_key = "runner_rc" if cell else "probe_rc"
   174	    run, receipt = {"ended", rc_key}, {"receipt_sha256", "campaign_digest"} if cell else set()
   175	    extra = keys - flight
   176	    if st == "in_flight":                         # a crash mid-chunk (bare) or a recorded failure (under the latch)
   177	        if extra and (extra != run or not latched or type(c[rc_key]) is not int or not _text(c["ended"])):
   178	            return out + [f"chunk {n}: in flight with {sorted(extra)} (a recorded failure: exactly {sorted(run)}, an int "
   179	                          "rc and its end, under the stop latch)"]
   180	        return out
   181	    gate, adopt = set(GATE_KEYS[c["gate"]]), {"adopted_at_restart"} if cell else set()
   182	    final = {"final_guard"} if st == "gates_verified" else set()
   183	    need = run | receipt | (gate | final if st == "gates_verified" else set())
   184	    if not need <= extra or extra - run - receipt - gate - adopt - final:
   185	        return out + [f"chunk {n} ({st}): carries {sorted(extra)}, needs {sorted(need)}"]
   186	    adopted = c.get("adopted_at_restart") is True
   187	    if "adopted_at_restart" in c and not adopted:
   188	        out.append(f"chunk {n}: adopted_at_restart {c['adopted_at_restart']!r}")
   189	    if not ((type(c[rc_key]) is int and c[rc_key] == 0) or (adopted and c[rc_key] is None)):
   190	        out.append(f"chunk {n}: rc {c[rc_key]!r} in a {st} chunk")
   191	    if not (_text(c["ended"]) or (adopted and c["ended"] is None)):
   192	        out.append(f"chunk {n}: ended {c['ended']!r}")
   193	    if cell and not (_hex(c["receipt_sha256"]) and _hex(c["campaign_digest"])):
   194	        out.append(f"chunk {n}: the receipt / campaign digest are not sha256 values")
   195	    fg = c.get("final_guard")
   196	    if st == "gates_verified" and not (
   197	            isinstance(fg, dict) and list(fg) == ["status", "exit", "t", "time", "step", "anchor"] and fg["status"] == "OK"
   198	            and type(fg["exit"]) is int and fg["exit"] == 0 and _num(fg["t"]) and _text(fg["time"])
   199	            and type(fg["step"]) is int and fg["step"] >= 0 and fg["anchor"] is not None
   200	            and not guard_module().anchor_schema_reasons(fg["anchor"])):
   201	        out.append(f"chunk {n}: gates_verified without a passing final-guard record ({fg!r:.120})")
   202	    return out + _gate_reasons(c, latched)
