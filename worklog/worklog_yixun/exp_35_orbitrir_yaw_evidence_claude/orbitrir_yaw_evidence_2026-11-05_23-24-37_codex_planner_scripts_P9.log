   101	def block_names(text, shell):
   102	    """The names the registered-config block of ``text`` assigns."""
   103	    i, j = _block(text)
   104	    body = text[i:j]
   105	    if shell:
   106	        return sorted({ln.split("=", 1)[0] for ln in body.splitlines()[1:-1] if ln and not ln.startswith("#")})
   107	    return sorted({t.id for node in ast.parse(body).body for t in
   108	                   (node.targets[0].elts if isinstance(node.targets[0], ast.Tuple) else node.targets)})
