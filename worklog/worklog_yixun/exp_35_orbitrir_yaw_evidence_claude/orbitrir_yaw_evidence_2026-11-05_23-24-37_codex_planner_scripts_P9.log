   404	def gpu_map(text):
   405	    """``{index: uuid}`` from ``nvidia-smi --query-gpu=index,uuid --format=csv,noheader``; ValueError when malformed."""
   406	    out = {}
   407	    for line in [ln for ln in text.splitlines() if ln.strip()]:
   408	        m = re.fullmatch(r"\s*(\d+),\s*(GPU-[0-9A-Za-z-]+)\s*", line)
   409	        if not m or int(m[1]) in out or m[2] in out.values():
   410	            raise ValueError(f"malformed or duplicate nvidia-smi index,uuid row {line!r}")
   411	        out[int(m[1])] = m[2]
   412	    if not out:
   413	        raise ValueError("nvidia-smi lists no GPU")
   414	    return out
