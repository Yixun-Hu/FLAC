   111	def replace_block(text, values, shell):
   112	    """``text`` with ONLY its registered-config block replaced by ``values`` -- which must cover exactly its names."""
   113	    names = block_names(text, shell)
   114	    assert sorted(values) == names, (sorted(values), names)
   115	    i, j = _block(text)
   116	    first = text[i:text.index("\n", i)]
   117	    body = "".join(f"{k}={shlex.quote(str(v))}\n" if shell else f"{k} = {v!r}\n" for k, v in values.items())
   118	    return text[:i] + first + "\n" + body + END + text[j:]
