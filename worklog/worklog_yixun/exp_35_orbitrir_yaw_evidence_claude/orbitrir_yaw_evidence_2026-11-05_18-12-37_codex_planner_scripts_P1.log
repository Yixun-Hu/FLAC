    96	def raw_select(raw):
    97	    """The plan §2.1 Steps B-C rule on a raw scalar map.
    98	
    99	    Returns ``(j, tie_class, candidates, survivors)``; ``j`` and ``tie_class`` are
   100	    ``None`` when several candidates survive the rooted-image key (exactly periodic)."""
   101	    cands = raw_candidates(raw)
   102	    if len(cands) == 1:
   103	        n_max = int((raw[:, cands[0]] == raw.max()).sum())
   104	        return cands[0], ("same_column" if n_max > 1 else "none"), cands, list(cands)
   105	    survivors = raw_rooted_survivors(raw, cands)
   106	    if len(survivors) == 1:
   107	        return survivors[0], "cross_column_image", cands, survivors
   108	    return None, None, cands, survivors
