   170	        raise ValueError(f"conditioner ids differ: {sorted(test)} vs {sorted(ref)}")
   171	    ids = sorted(ref)
   172	    out = {"ids": ids, "masks_equal": all(
   173	        (test[k][1] is None and ref[k][1] is None) or
   174	        (test[k][1] is not None and ref[k][1] is not None and torch.equal(test[k][1].cpu(), ref[k][1].cpu()))
   175	        for k in ids)}
