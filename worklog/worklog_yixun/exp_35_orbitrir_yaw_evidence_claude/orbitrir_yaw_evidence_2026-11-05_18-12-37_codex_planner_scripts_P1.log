   233	def audit_map(key, entry, md_module, root_abs):
   234	    """One row of the audit. Never raises: a failure is recorded in ``row['error']``
   235	    (and the map then counts as NOT processed)."""
   236	    import torch
   237	    from src.data import yaw_rotation as yr
   238	    row = {"path": key, "sha256": None, "counts": dict(entry["counts"]), "img_w": None,
   239	           "j_star": None, "dj": None,
   240	           "tie_class": None, "survivor": False, "n_candidates": None, "candidates": None,
   241	           "survivors": None, "max_sep_deg": None, "raw_tie_class": None, "raw_survivor": None,
   242	           "raw_agree_set": None, "raw_agree_col": None, "error": None}
   243	    try:
   244	        with open(entry["path"], "rb") as f:
   245	            blob = f.read()
   246	        row["sha256"] = hashlib.sha256(blob).hexdigest()
   247	        raw = np.load(io.BytesIO(blob), allow_pickle=False)
   248	        _check_raw(raw)
   249	        check_registered_contract(raw=raw)
   250	        info = {"path": entry["rep"], "relpath": os.path.relpath(entry["rep"], root_abs),
   251	                "modalities": DEPTH_ONLY_MODALITIES}
   252	        cloud = md_module.get_custom_metadata(info, None)["depth"]      # AR_md's own cloud
   253	        check_registered_contract(cloud=cloud)
   254	        ref = md_module.convert_equirect_to_camera_coord(torch.from_numpy(raw), *raw.shape)
   255	        if not torch.equal(cloud, ref.permute(2, 0, 1)):
   256	            raise RuntimeError("the cloud AR_md built differs from the resolved file's content")
   257	        W = row["img_w"] = int(cloud.shape[2])
   258	        P = yr.column_profile(yr.recover_depth_proxy(cloud))
   259	        cands = [int(c) for c in torch.nonzero(P == P.max()).flatten().tolist()]
   260	        try:
   261	            _, dj, tie_class = yr.canonicalize_scene_metadata(_canon_md(cloud), W)
   262	            j_star = (W - dj) % W
   263	            if j_star not in cands:
   264	                raise RuntimeError(f"selected column {j_star} is not a candidate {cands}")
   265	            survivors = [j_star]
   266	            row.update(j_star=j_star, dj=dj, tie_class=tie_class)
   267	        except yr.StabilizedTieError as err:
   268	            survivors = list(err.candidates)
   269	            row["survivor"] = True
   270	        raw_j, raw_class, raw_cands, raw_survivors = raw_select(raw)
   271	        row.update(n_candidates=len(cands), candidates=cands, survivors=survivors,
   272	                   max_sep_deg=max_circular_sep_deg(cands, W), raw_tie_class=raw_class,
   273	                   raw_survivor=raw_j is None, raw_agree_set=raw_cands == cands,
   274	                   raw_agree_col=raw_survivors == survivors)
   275	    except Exception as err:  # noqa: BLE001 -- recorded, and the gate then refuses PASS
   276	        row["error"] = f"{type(err).__name__}: {err}"
   277	    return row
