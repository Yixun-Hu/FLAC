   178	    cat = lambda c: torch.cat([c[k][0].detach().double().cpu().reshape(c[k][0].shape[0], -1)  # noqa: E731
   179	                               for k in ids], dim=1)
   180	    out["all"] = stage_rel(cat(test), cat(ref))
