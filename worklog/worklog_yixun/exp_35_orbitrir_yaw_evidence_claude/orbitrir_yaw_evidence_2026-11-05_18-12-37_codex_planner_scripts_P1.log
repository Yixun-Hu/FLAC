   165	def compare_cond(test, ref):
   166	    """Conditioning dicts ``{id: [tensor, mask]}``: per-id relL2 / relLinf of the
   167	    tensors, the same over all ids concatenated per item (``"all"``, ids sorted), and
   168	    whether every mask is identical."""
