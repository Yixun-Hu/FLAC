   238	        cond_inputs = module.diffusion.get_conditioning_inputs(cond)
   239	        latent = sampling.sample_discrete_euler(
   240	            recording_model, noise.to(device), 1, **cond_inputs, cfg_scale=1.0,
   241	            dist_shift=module.diffusion.dist_shift, batch_cfg=True, disable_tqdm=True)
