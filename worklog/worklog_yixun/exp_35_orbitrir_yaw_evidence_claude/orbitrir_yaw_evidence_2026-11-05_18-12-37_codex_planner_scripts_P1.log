   225	    no pose (plan v6), so these only satisfy canonicalize_scene_metadata's contract."""
   226	    import torch
   227	    src = torch.tensor([1.0, 0.0, 0.0])
   228	    ctx = torch.tensor([[0.0, 1.0, 0.0]])
   229	    return {"depth": cloud, "source": src, "source_vit": src[None], "context_poses": ctx,
   230	            "context_poses_vit": ctx.clone()}
