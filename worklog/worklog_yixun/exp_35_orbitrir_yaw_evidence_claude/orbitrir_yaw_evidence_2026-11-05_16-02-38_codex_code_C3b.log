   134	def reservation_path(dirpath, uuid):
   135	    return os.path.join(dirpath, f"{uuid}.json")
   136	
   137	
   138	def create_reservation(dirpath, uuid, *, epoch, h35, now):
   139	    """§12 B1.4: O_CREAT | O_EXCL, never overwritten (``FileExistsError`` when the file exists)."""
   140	    path = reservation_path(dirpath, uuid)
   141	    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
   142	    with os.fdopen(fd, "w") as f:
   143	        json.dump({"holder": "exp35", "h35": h35, "gpu_uuid": uuid, "epoch": epoch, "created": now, "branch": BRANCH}, f)
   144	        f.flush()
   145	        os.fsync(f.fileno())
   146	    _fsync_dir(dirpath)
   147	    return path
   148	
   149	
   150	def remove_reservation(path):
   151	    os.unlink(path)
   152	    _fsync_dir(os.path.dirname(path))
