   106	def test_the_state_is_written_atomically(tmp_path, monkeypatch):
   107	    path, calls = str(tmp_path / "state.json"), []
   108	    real = os.fsync
   109	    monkeypatch.setattr(S.os, "fsync", lambda fd: (calls.append(os.fstat(fd).st_mode), real(fd)))
   110	    S.write_state(path, _state())
   111	    assert json.load(open(path)) == _state() and len(calls) == 2           # the temp file, then the directory
   112	    assert [p.name for p in tmp_path.iterdir()] == ["state.json"]
   113	    import stat
   114	    assert stat.S_ISREG(calls[0]) and stat.S_ISDIR(calls[1])
