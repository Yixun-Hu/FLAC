  2069	def tables(cells, external, e2, e2f):
  2070	    """§1 (a) theta = 0, (b) 45 degrees and random yaw, (c) the Tier 3 spread. A reused exp_25 row is a pointer
  2071	    into ``external_reference`` (§5 item 3); every computed mean names its source; the A6 CSV reaches (b) only as
  2072	    E2's PASS rows (§5 item 6); on an E2 FAIL the 45-degree FLAC / OrbitRIR points are the s42 one-pin cells (§4)."""
  2073	    idx, ks = _bf_index(cells), (1, 8)
  2074	    h35 = lambda sub, k, seeds, deg: [idx[("BF-pin", sub, k, s, deg)]["record"]["metrics"]  # noqa: E731
  2075	                                      for s in seeds if ("BF-pin", sub, k, s, deg) in idx]
  2076	    ext = lambda fmt, k, seeds: [external[fmt.format(k=k, s=s)] for s in seeds  # noqa: E731
  2077	                                 if fmt.format(k=k, s=s) in external]
  2078	    if e2["status"] == "PASS":
  2079	        b45 = {m: _seed_stats({k: [r for r in e2["rows45"] if (r["method"], r["K"]) == (label, str(k))] for k in ks},
  2080	                              f"A6 CSV '{label}' 45 deg s42-46 (E2 PASS)") for m, label in A6_METHODS.items()}
  2081	    elif e2["status"] == "FAIL":
  2082	        b45 = {m: _e2_fail_45(m, idx, external, e2f) for m in A6_METHODS}
  2083	    else:
  2084	        b45 = {m: {"source": f"pending: E2 {e2['status']}", "1": None, "8": None} for m in A6_METHODS}
  2085	    c45 = sorted((e for e in cells.values() if e["valid"] and e["row"]["block"] == "CANON-45"), key=lambda e: e["row"]["seed"])
  2086	    b45["CANON"] = _pointed({k: [_point(name=n, external=external) for n in [f"exp25_CANON_C4_S40000_K{k}_s42_th45"]
  2087	                                 if n in external] + [_point(e) for e in c45 if e["row"]["K"] == k] for k in ks},
  2088	                            "exp_25 C4+45 th45 s42 (external, d6ca307a) + exp_35 CANON-45 s43-46")
  2089	    b = {"45": b45, "R": {"FLAC": _seed_stats({k: ext("exp25_P1_R_S40000_K{k}_s{s}", k, SEEDS) for k in ks},
  2090	                                              "exp_25 P1-pin R s42-46 (external, d6ca307a)"),
  2091	                          "CANON": _seed_stats({k: ext("exp25_CANON_R_S40000_K{k}_s{s}", k, SEEDS) for k in ks},
  2092	                                               "exp_25 CANON R s42-46 (external, d6ca307a)"),
  2093	                          "OrbitRIR": _seed_stats({k: h35("R", k, SEEDS, None) for k in ks}, "exp_35 BF-pin R s42-46")}}
  2094	    a = {"FLAC": {"ref": "external_reference.exp25.table.P1"}, "CANON": {"ref": "external_reference.exp25.table.CANON"},
  2095	         "OrbitRIR": _seed_stats({k: h35("T", k, SEEDS, 0) for k in ks}, "exp_35 BF-pin T s42-46"),
  2096	         "historical_bf": BF_HISTORICAL_EXP35}
  2097	    c = dict({arm: {"ref": f"external_reference.exp25.tier3.{arm}"} for arm in ("CANON", "P1", "YAW")},
  2098	             BF={"ref": "tier3.BF.arms.BF"})
  2099	    return a, b, c
