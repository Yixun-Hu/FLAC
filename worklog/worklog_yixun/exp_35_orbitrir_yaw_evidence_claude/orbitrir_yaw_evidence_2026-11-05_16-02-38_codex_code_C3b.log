    35	def test_the_33_chunks_are_the_registered_phase_i_order():
    36	    ch = S.chunk_plan()
    37	    assert [c["n"] for c in ch] == list(range(1, 34))
    38	    assert [(c["kind"], c["cell"], c["gate"]) for c in ch[:5]] == [
    39	        ("cell", "exp35_P1_T_S40000_K1_s42", "E1"), ("cell", "exp35_P1_T_S40000_K8_s42", "E1"),
    40	        ("cell", "exp35_BF_T_S40000_K1_s42", None), ("cell", "exp35_BF_T_S40000_K8_s42", "E2"), ("probe", None, "PROBE")]
    41	    rest = [c["cell"] for c in ch[5:]]
    42	    assert rest == ([f"exp35_BF_T_S40000_K{k}_s{s}" for s in SEEDS[1:] for k in (1, 8)]            # T s43-46
    43	                    + [f"exp35_BF_R_S40000_K{k}_s{s}" for s in SEEDS for k in (1, 8)]              # R
    44	                    + [f"exp35_BF_T_S40000_K{k}_s42_dup" for k in (1, 8)]                          # dup
    45	                    + [f"exp35_BF_C4_S40000_K{k}_s42_th{d}" for d in (90, 180, 270, 45) for k in (1, 8)])   # C4+45
    46	    assert all(c["kind"] == "cell" and c["gate"] is None for c in ch[5:])
