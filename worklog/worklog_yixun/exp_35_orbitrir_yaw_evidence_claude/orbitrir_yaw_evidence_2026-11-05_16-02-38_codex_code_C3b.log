    90	def judge(epochs, baseline):
    91	    """(STOP reasons, the window summary): thresholds over the windows ending after ``baseline`` and the mean."""
    92	    reasons, summary = [], {}
    93	    for size, limit in ((500, W500), (100, W100)):
    94	        got = [w for w in windows(epochs, size) if baseline is not None and w[2] > baseline]
    95	        reasons += [f"the {size}-step window epoch {e} steps {a}-{a + size} ran {r:.3f} s/step > {limit}"
    96	                    for e, a, _, r in got if r > limit]
    97	        worst = max(got, key=lambda w: w[3], default=None)
    98	        summary[str(size)] = {"judged": len(got), "limit": limit, "worst": None if worst is None else {
    99	            "epoch": worst[0], "start": worst[1], "s_per_step": worst[3]}}
   100	    mean, n = mean_since(epochs, baseline) if baseline is not None else (None, 0)
   101	    reasons += [f"the mean since the baseline step {baseline} ran {mean:.3f} s/step over {n} steps > {MEAN}"] if (
   102	        mean is not None and mean > MEAN) else []
   103	    return reasons, summary, {"s_per_step": mean, "steps": n, "limit": MEAN}
   104	
   105	
   106	def read_log(path):
   107	    """``(stat, bytes, end)``: ONE fd, ``st_size`` bytes from offset 0, ``end`` = just past the last terminator."""
   108	    fd = os.open(path, os.O_RDONLY)
   109	    try:
   110	        st, chunks, off = os.fstat(fd), [], 0
   111	        while off < st.st_size:
   112	            b = os.pread(fd, st.st_size - off, off)
   113	            if not b:
   114	                break
   115	            chunks.append(b)
   116	            off += len(b)
   117	    finally:
   118	        os.close(fd)
   119	    raw = b"".join(chunks)
   120	    return st, raw, max(raw.rfind(b"\r"), raw.rfind(b"\n")) + 1
   121	
   122	
   123	def anchor_of(st, raw, end):
   124	    return {"inode": st.st_ino, "device": st.st_dev, "size": len(raw), "offset": end,
   125	            "tail_sha256": hashlib.sha256(raw[max(0, end - ANCHOR_BYTES):end]).hexdigest()}
   126	
   127	
   128	def anchor_reasons(st, raw, anchor):
   129	    """HARD STOP reasons of this read against the persisted ``anchor`` (None: the first observation)."""
   130	    if anchor is None:
   131	        return []
   132	    if (st.st_ino, st.st_dev) != (anchor["inode"], anchor["device"]):
   133	        return [f"the log's inode changed ({anchor['inode']} -> {st.st_ino}): rotated or replaced"]
   134	    if len(raw) < anchor["size"]:
   135	        return [f"the log shrank ({anchor['size']} -> {len(raw)} bytes)"]
   136	    off = anchor["offset"]
   137	    if hashlib.sha256(raw[max(0, off - ANCHOR_BYTES):off]).hexdigest() != anchor["tail_sha256"]:
   138	        return [f"the {ANCHOR_BYTES} bytes before the anchor offset {off} changed: a copy-truncate-and-regrow"]
   139	    return []
   140	
   141	
   142	def observe(path, *, baseline=None, anchor=None):
   143	    """One read-only observation of the log: status, exit code, reasons, the step, the windows, the new anchor."""
   144	    out = {"status": "REFUSED", "exit": EXIT_REFUSED, "reasons": [], "baseline": baseline,
   145	           "thresholds": {"w500": W500, "w100": W100, "mean": MEAN}}
   146	    try:
   147	        st, raw, end = read_log(path)
   148	    except OSError as err:
   149	        return dict(out, reasons=[f"the log {path} is unreadable ({err})"])
   150	    epochs, errors = parse(raw[:end].decode("utf-8", "replace"))
   151	    hard = anchor_reasons(st, raw, anchor) + errors + ([] if epochs else ["no training-bar line in the log"])
   152	    reasons, summary, mean = judge(epochs, baseline) if not hard else ([], {}, None)
   153	    e = max(epochs) if epochs else None
   154	    n = max(epochs[e]["steps"]) if e is not None else None
   155	    step = None if e is None else {"epoch": e, "n": n, "total": epochs[e]["total"], "global": e * epochs[e]["total"] + n}
   156	    status = "HARD_STOP" if hard else "STOP" if reasons else "OK"
   157	    return dict(out, status=status, exit={"HARD_STOP": EXIT_HARD, "STOP": EXIT_STOP, "OK": EXIT_OK}[status],
   158	                reasons=hard or reasons, step=step, finished=bool(step and step["global"] >= MAX_STEPS),
   159	                windows=summary, mean_since_baseline=mean, anchor=anchor_of(st, raw, end),
   160	                log={"path": path, "inode": st.st_ino, "size": len(raw), "mtime": st.st_mtime})
