 def _repo_root(p):
     p = os.path.abspath(p)
     while not os.path.exists(os.path.join(p, ".git")):
         parent = os.path.dirname(p)
         if parent == p:
             raise RuntimeError("repo root (.git) not found")
         p = parent
     return p
 
 
