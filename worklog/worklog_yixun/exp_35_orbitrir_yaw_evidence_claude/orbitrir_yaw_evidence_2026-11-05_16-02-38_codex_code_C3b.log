    79	
    80	def mean_since(epochs, baseline):
    81	    """``(mean s/step, steps)`` of the steps completed after global step ``baseline`` (within-epoch elapsed only)."""
    82	    t = steps = 0
    83	    for e, ep in epochs.items():
    84	        ns = [n for n in sorted(ep["steps"]) if e * ep["total"] + n >= baseline]
    85	        if len(ns) > 1:
    86	            t, steps = t + ep["steps"][ns[-1]] - ep["steps"][ns[0]], steps + ns[-1] - ns[0]
    87	    return (t / steps if steps else None), steps
