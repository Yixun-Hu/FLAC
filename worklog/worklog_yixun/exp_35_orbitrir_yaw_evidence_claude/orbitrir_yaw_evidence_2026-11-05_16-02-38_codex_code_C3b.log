    72	def write_state(path, doc):
    73	    """Atomic: a temp file in the same directory, fsync, rename over the state, fsync the directory (§13 NIT 1)."""
    74	    d = os.path.dirname(os.path.abspath(path))
    75	    fd, tmp = tempfile.mkstemp(prefix=".exp35_state.", dir=d)
    76	    try:
    77	        with os.fdopen(fd, "w") as f:
    78	            json.dump(doc, f, indent=1)
    79	            f.flush()
    80	            os.fsync(f.fileno())
    81	        os.replace(tmp, path)
    82	    except BaseException:
    83	        if os.path.exists(tmp):
    84	            os.unlink(tmp)
    85	        raise
    86	    dfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
    87	    try:
    88	        os.fsync(dfd)
    89	    finally:
    90	        os.close(dfd)
    91	
    92	
    93	def state_reasons(doc, *, h35, cells_sha256, supervisor_sha256):
    94	    if not isinstance(doc, dict) or list(doc) != list(STATE_KEYS):
    95	        return [f"the state's keys are not {list(STATE_KEYS)}"]
    96	    out = [f"{k}: {doc[k]!r} != {want!r}" for k, want in (("schema_version", STATE_SCHEMA), ("h35", h35),
    97	           ("cells_sha256", cells_sha256), ("supervisor_sha256", supervisor_sha256)) if doc[k] != want]
    98	    plan = [(c["n"], c["kind"], c["cell"], c["gate"]) for c in chunk_plan()]
    99	    if [(c.get("n"), c.get("kind"), c.get("cell"), c.get("gate")) for c in doc["chunks"]] != plan:
   100	        return out + ["the state's chunks are not the frozen 33-chunk order"]
   101	    states = [c.get("state") for c in doc["chunks"]]
   102	    out += [f"chunk {i + 1}: unknown state {s!r}" for i, s in enumerate(states) if s not in CHUNK_STATES]
   103	    done = 0
   104	    while done < len(states) and states[done] == "gates_verified":
   105	        done += 1
   106	    if not out and any(s != "planned" for s in states[done + 1:]):
   107	        out.append(f"chunk order violated: {states[:done + 3]}... (only the first unfinished chunk may be started)")
   108	    return out
