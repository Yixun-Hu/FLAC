   190	def test_a_copy_truncate_and_regrow_is_a_hard_stop(tmp_path):
   191	    """§13 NIT 1: same inode, the size grew again past the anchor -- but the bytes before the anchor changed."""
   192	    p, anchor = _anchored(tmp_path)
   193	    text = open(p).read()
   194	    with open(p, "r+") as f:                                  # rewrite in place: same inode, longer, other bytes
   195	        f.seek(0)
   196	        f.write(text.replace("loss=0.498", "loss=0.497") + "\r".join(epoch_lines(2, 4.23)[0][:20]) + "\r")
   197	    r = obs(p, baseline=T, anchor=anchor)
   198	    assert os.stat(p).st_ino == anchor["inode"] and os.path.getsize(p) > anchor["size"]
   199	    assert r["status"] == "HARD_STOP" and any("anchor" in x for x in r["reasons"])
