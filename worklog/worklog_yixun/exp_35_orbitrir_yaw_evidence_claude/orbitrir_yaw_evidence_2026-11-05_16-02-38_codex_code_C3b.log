   179	def _drop_one(node_path):
   180	    def edit(r):
   181	        node = r
   182	        for k in node_path:
   183	            node = node[k]
   184	        for m in ("relL2", "relLinf"):
   185	            node[m].pop()
   186	        _consistent(r)
   187	    return edit
