  2045	def _e2_fail_45(method, idx, external, e2f):
  2046	    """§14 A1.4, an E2 FAIL: s42 from the one-pin SDPA cell (P1: exp_25's C4+45 th45, external; B-F: BF-pin C4 th45)
  2047	    + s43-46 from the E2-FAIL block -- per K, n 5 if its four E2-FAIL cells verify, else the labelled s42 point (n 1)."""
  2048	    arm, pts, notes = {"FLAC": "P1", "OrbitRIR": "BF"}[method], {}, []
  2049	    for k in (1, 8):
  2050	        p1, bf = f"exp25_P1_C4_S40000_K{k}_s42_th45", ("BF-pin", "C4", k, 42, 45)
  2051	        first = ([_point(name=p1, external=external)] if p1 in external else []) if arm == "P1" else (
  2052	            [_point(idx[bf])] if bf in idx else [])
  2053	        rest = [e2f.get(f"exp35_{arm}_OFF_S40000_K{k}_s{s}_th45") for s in SEEDS[1:]]
  2054	        whole = all(e and e["valid"] for e in rest)
  2055	        pts[k] = first + ([_point(e) for e in rest] if whole else [])
  2056	        notes += [] if whole else [f"K{k}: the E2-FAIL cells are incomplete, so the s42 one-pin point only (n 1)"]
  2057	    one = "exp_25 P1-pin C4 th45 (external, d6ca307a)" if arm == "P1" else "BF-pin C4 th45 (this pin)"
  2058	    mix = "; the P1 pin mix is justified by E1 (the CTL cells are exactly equal at d6ca307a and this pin)"
  2059	    return _pointed(pts, f"E2 FAIL: s42 = the one-pin SDPA cell {one}, s43-46 = the E2-FAIL cells (this pin)"
  2060	                    + (mix if arm == "P1" else "") + "".join(f"; {x}" for x in notes))
  2061	
