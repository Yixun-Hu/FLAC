     1	#!/usr/bin/env python3
     2	"""exp_35 training guard (plan_orbitrir_yaw_evidence.md r2 §7 "Guard", r3 §12 B2, r4 §13 NIT 1): a READ-ONLY parser
     3	of Yixun's s43 training log. It reads that one file; it writes nothing and signals nothing.
     4	
     5	The log is PyTorch Lightning's tqdm bar, ``Epoch E:  P%|bar| n/T [elapsed<remaining, rate, postfix]``, refreshed
     6	with ``\\r`` (``\\n`` works too). For each step n of an epoch the FIRST line that shows it gives the time step n
     7	completed (a postfix refresh repeats the line; the epoch-end validation re-prints the last step with a later elapsed);
     8	the elapsed field restarts with each epoch, so the validation between epochs lies in no window (PL's bar reset after
     9	it, "Epoch E: 0/T [00:00<" under the old label once step T was seen, is skipped). Windows align to the
    10	epoch's step counter -- [0, 100], [100, 200], ... and [0, 500], ... -- and a window is complete once a step at or past
    11	its end was seen (an epoch's tail beyond its last full window is in none). Only the bytes up to the last line
    12	terminator are parsed (a line being written is not).
    13	
    14	  STOP (exit 1), judged over the completed windows that END after the baseline step (our first spawn; before a
    15	  baseline nothing is judged), thresholds exact and strict: any 500-step window > 9.712 s/step; any 100-step window
    16	  > 9.950 s/step; the mean s/step since the baseline (the within-epoch elapsed of the steps after it) > 8.521.
    17	  HARD STOP (exit 2): against the persisted anchor the log's inode changed or its size shrank, or the 4 KiB before
    18	  the anchor offset changed (a copy-truncate-and-regrow); a step went backwards within an epoch, an epoch number
    19	  went backwards, or the bar total changed (a restart or another run in the same file); no training-bar line.
    20	  REFUSED (exit 3): the log or the anchor file is unreadable, or the arguments are bad.   OK (exit 0): none of these.
    21	
    22	  --log PATH [--baseline-step N] [--anchor FILE]   prints the observation (JSON, with the NEW anchor) and exits 0-3
    23	
    24	Written by the exp_35 Coder (Claude Opus 5.5, max effort) per plan_orbitrir_yaw_evidence.md r2/r3/r4.
    25	"""
    26	import argparse
    27	import hashlib
    28	import json
    29	import os
    30	import re
    31	import sys
    32	
    33	W500, W100, MEAN = 9.712, 9.950, 8.521        # §7: s/step, strict >
    34	ANCHOR_BYTES = 4096                             # §13 NIT 1: the sha256 of the last 4 KiB parsed
    35	EXIT_OK, EXIT_STOP, EXIT_HARD, EXIT_REFUSED = 0, 1, 2, 3
    36	MAX_STEPS = 40000                               # the s43 training's max_steps
    37	LINE = re.compile(r"Epoch (\d+):\s+\d+%\|[^|\r\n]*\|\s*(\d+)/(\d+) \[(\d+(?::\d\d){1,2})<")
    38	
    39	
    40	def _seconds(text):
    41	    parts = [int(x) for x in text.split(":")]
    42	    return parts[0] * 60 + parts[1] if len(parts) == 2 else parts[0] * 3600 + parts[1] * 60 + parts[2]
    43	
    44	
    45	def parse(text):
    46	    """``({epoch: {"total": T, "steps": {n: elapsed s}}}, errors)`` -- the first sighting of each step; a repeat is
    47	    accepted only for the latest step (a refresh, the post-validation re-print)."""
    48	    epochs, errors, last = {}, [], None
    49	    for m in LINE.finditer(text):
    50	        e, n, total, el = int(m[1]), int(m[2]), int(m[3]), _seconds(m[4])
    51	        if last is not None and e < last:
    52	            return epochs, [f"epoch {e} after epoch {last}: a restart in the same log"]
    53	        first = epochs[min(epochs)]["total"] if epochs else total
    54	        if total != first:
    55	            return epochs, [f"epoch {e}: the bar total changed ({first} -> {total}): another run in the same log"]
    56	        ep = epochs.setdefault(e, {"total": total, "steps": {}})
    57	        top = max(ep["steps"]) if ep["steps"] else None
    58	        if (n, el, top) == (0, 0, total):
    59	            continue        # PL resets the bar under the OLD label after the validation (the real s43 log)
    60	        if top is not None and (n < top or (n > top and el < ep["steps"][top])):
    61	            return epochs, [f"epoch {e}: step {n} at {el} s after step {top} at {ep['steps'][top]} s: the bar went backwards"]
    62	        ep["steps"].setdefault(n, el)
    63	        last = e
    64	    return epochs, errors
    65	
    66	
    67	def windows(epochs, size):
    68	    """Completed ``size``-step windows ``(epoch, start, global end, s/step)``: from the last sample at or before the
    69	    start to the first sample at or after the end, within one epoch."""
    70	    out = []
    71	    for e, ep in sorted(epochs.items()):
    72	        ns, T = sorted(ep["steps"]), ep["total"]
    73	        for a in range(0, T - size + 1, size):
    74	            lo, hi = [n for n in ns if n <= a], [n for n in ns if n >= a + size]
    75	            if lo and hi:
    76	                out.append((e, a, e * T + a + size, (ep["steps"][hi[0]] - ep["steps"][lo[-1]]) / (hi[0] - lo[-1])))
    77	    return out
