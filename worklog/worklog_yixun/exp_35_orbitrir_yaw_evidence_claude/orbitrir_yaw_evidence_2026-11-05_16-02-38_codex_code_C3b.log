   179	
   180	def build_manifest(exp35=True):
   181	    """The 346-row manifest; ``exp35=False``: the exp_25 manifest exactly as committed at its pin."""
   182	    E, U = ENDPOINT, "unseen"
   183	    blocks = {
   184	        "T": [_row("T", "T", "CANON", E, U, k, s, ("fixed", 0), True) for k in KS for s in SEEDS],
   185	        "T-dup": [_row("T-dup", "T", "CANON", E, U, k, 42, ("fixed", 0), True, dup=True) for k in KS],
   186	        "C4+45": [_row("C4+45", "C4", "CANON", E, U, k, 42, ("fixed", d), True)
   187	                  for k in KS for d in C4_ANGLES + (OFF_ORBIT,)],
   188	        "R": [_row("R", "R", "CANON", E, U, k, s, ("random", None), True) for k in KS for s in SEEDS],
   189	        "D-i": [_row("D-i", "D", "CANON", E, U, k, 42, ("fixed", 0), allow=True) for k in KS],
   190	        "D-ii": [_row("D-ii", "D", "P1", E, U, k, 42, ("fixed", 0), True, True) for k in KS],
   191	        "S": [_row("S", "S", "CANON", E, "seen", k, s, ("fixed", 0), True) for k in KS for s in SEEDS],
   192	        "P1-pin": _pin_rows("P1"),
   193	        "YAW-pin": _pin_rows("YAW"),
   194	        "TRAJ": [_row("TRAJ", "TRAJ", "CANON", step, U, k, 42, ("fixed", d), True)
   195	                 for step in range(CADENCE, ENDPOINT, CADENCE) for k in KS for d in (0,) + C4_ANGLES],
   196	    }
   197	    names = EXP25_BLOCKS + (EXP35_BLOCKS if exp35 else ())
   198	    blocks.update(_exp35_blocks() if exp35 else {})
   199	    cells = []
   200	    for priority, block in enumerate(names):
   201	        for row in blocks[block]:
   202	            cells.append({"cell": row.pop("cell"), "order": len(cells), "priority": priority, **row})
   203	    head = {"schema_version": SCHEMA_VERSION, "generator": f"{EXPREL}/depth_canon_make_cells.py",
   204	            "plan": "plan_depth_canon.md v9 §5" + (
   205	                "; exp_35 rows: plan_orbitrir_yaw_evidence.md r2 §1, §11, §14 A1" if exp35 else ""),
   206	            "blocks": list(names), "block_counts": {b: len(blocks[b]) for b in names}, "common_flags": COMMON_FLAGS}
   207	    head.update({"arm_cond_flags": ARM_COND_FLAGS} if exp35 else {})
   208	    return {**head, "img_w": IMG_W, "seeds": list(SEEDS), "dump_root": DUMP_ROOT, "farm_root": FARM_ROOT,
   209	            "splits": {s: {"split_json": v["split_json"], "expected_stream_count": v["expected_stream_count"]}
   210	                       for s, v in SPLITS.items()},
   211	            "arms": {a: ARMS[a] for a in EXP25_ARMS + (("BF",) if exp35 else ())}, "cells": cells}
   212	
   213	
   214	def render(manifest):
   215	    """Deterministic bytes: a pretty header, then one compact cell per line."""
   216	    head = {k: v for k, v in manifest.items() if k != "cells"}
   217	    return (json.dumps(head, indent=1)[:-2] + ',\n "cells": [\n'
   218	            + ",\n".join("  " + json.dumps(c, separators=(",", ":")) for c in manifest["cells"])
   219	            + "\n ]\n}\n")
   220	
   221	
   222	def main(argv=None):
   223	    import argparse
   224	    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   225	    ap.add_argument("--write", action="store_true", help=f"write {os.path.relpath(OUT, REPO)}")
   226	    ap.add_argument("--check", action="store_true", help="exit 1 if the committed file drifted")
   227	    args = ap.parse_args(argv)
   228	    text = render(build_manifest())
   229	    if args.check:
   230	        with open(OUT) as f:
   231	            same = f.read() == text
   232	        print("cells manifest OK" if same else f"cells manifest DRIFTED from the generator: {OUT}")
   233	        return 0 if same else 1
   234	    if args.write:
   235	        with open(OUT, "w") as f:
   236	            f.write(text)
   237	        print(f"wrote {OUT}")
   238	        return 0
   239	    sys.stdout.write(text)
   240	    return 0
   241	
   242	
   243	if __name__ == "__main__":
   244	    sys.exit(main())

