  1055	def load_control(path, *, ckpt_sha256, canon_receipts, pin, manifest):
  1056	    """``(control_p99, reasons, eps)`` from the composition-control probe JSON: only a valid
  1057	    registered artifact of this campaign (``probe_reasons``) with a matching sidecar is a
  1058	    control; ``eps`` = ``{value, threshold, verdict PASS|FAIL}`` (a legitimate FAIL stays FAIL).
  1059	    ``canon_receipts``: :func:`canon_endpoint_receipts` of the collected cells (rB-F3, required)."""
  1060	    import hashlib
  1061	    try:
  1062	        with open(path, "rb") as f:
  1063	            text = f.read()
  1064	        with open(path + ".sha256") as f:
  1065	            side = f.read()
  1066	        rep = json.loads(text)
  1067	    except (OSError, ValueError) as err:
  1068	        return None, [f"control probe {path} unreadable ({err})"], None
  1069	    reasons = []
  1070	    if side != f"{hashlib.sha256(text).hexdigest()}  {os.path.basename(path)}\n":
  1071	        reasons.append(f"control probe sha256 sidecar does not match {path}")
  1072	    if not isinstance(rep, dict):
  1073	        return None, reasons + ["control probe is not a JSON object"], None
  1074	    reasons += probe_reasons(rep, ckpt_sha256=ckpt_sha256, canon_receipts=canon_receipts, pin=pin, manifest=manifest)
  1075	    if reasons:
  1076	        return None, reasons, None
  1077	    eps = rep["eps_cond"]
  1078	    return ({k: float(v) for k, v in rep["control_p99"][CONTROL_PROTOCOL].items()}, [],
  1079	            {"value": eps["value"], "threshold": eps["threshold"], "verdict": "PASS" if eps["pass"] else "FAIL"})
