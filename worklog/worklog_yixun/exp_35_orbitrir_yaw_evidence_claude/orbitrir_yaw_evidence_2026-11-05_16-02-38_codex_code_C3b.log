   156	# --------------------------------------------------------------------------- #
   157	# integrity: rotation, truncation, copy-truncate-and-regrow, restarts
   158	# --------------------------------------------------------------------------- #
   159	def _anchored(tmp_path, epochs=(4.23, 4.23)):
   160	    p = tmp_path / "train.log"
   161	    write_log(p, list(epochs))
   162	    return p, obs(p, baseline=T)["anchor"]
