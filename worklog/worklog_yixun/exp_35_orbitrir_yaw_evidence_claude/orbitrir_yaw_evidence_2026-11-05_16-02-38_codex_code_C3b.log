  2195	def render_exp35_md(res):
  2196	    """orbitrir_yaw_results.md: the provenance, E1 / E2, tables (a) / (b) / (c) with the Tier 3 verdict, Tier 2-C4.
  2197	    Pointers resolve into ``external_reference``; nothing is recomputed here."""
  2198	    res = json.loads(json.dumps(res))                              # the results file's own view (string K keys)
  2199	    part, keys, ks = res["partial"], TABLE_KEYS, ("1", "8")
  2200	    h = lambda t: f"## {'PARTIAL — ' if part else ''}{t}"  # noqa: E731
  2201	    name = lambda key: SHORT.get(key, key)  # noqa: E731
  2202	    head, sep = "| method (source) | K | " + " | ".join(name(k) for k in keys) + " |", "|---|---|" + "---|" * len(keys)
  2203	    x = res["external_reference"]
  2204	    out = [f"# exp_35 orbitrir_yaw_evidence — results{' (PARTIAL)' if part else ''}", "",
  2205	           f"Evaluator pin `{res['pin']}`; campaign digest `{res['campaign_digest']}`; blocks {', '.join(res['blocks'])}. "
  2206	           "Written by `depth_canon_collect.py --exp35`; never hand-edited.", "",
  2207	           f"external_reference: the exp_25 results `{x['exp25']['path']}` (sha256 `{x['exp25']['sha256']}`, pin "
  2208	           f"`{x['exp25']['pin']}`; its rows are quoted, never paired with this campaign's cells); "
  2209	           f"{len(x['exp25_cells']['metrics'])} exp_25 cells verified offline at `{x['exp25_cells']['pin']}` "
  2210	           f"({x['exp25_cells']['check']}); the stream registry `{x['registry_sha256']}`; the A6 CSV "
  2211	           f"`{x['a6_csv']['sha256']}` ({x['a6_csv']['read_by']}).", ""]
  2212	    out += [f"**PARTIAL:** {'; '.join(res['gaps'])}.", ""] if part else []
  2213	    out += [h("E1 — the control cells (exact; a hard stop)"), ""] + [f"- CTL K{k}: {v['status']}"
  2214	                                                                    for k, v in res["e1_ctl"].items()]
  2215	    e2 = res["e2"]
  2216	    out += ["", h("E2 — decides the 45-degree source only"), "", f"{e2['status']} — {e2['rule']}.", ""] + [
  2217	        f"- K{r['K']} {name(r['metric'])}: new {r['new']:.6g}, A6 {r['a6']:.6g}, |diff| {r['abs_diff']:.3g} <= "
  2218	        f"{r['tolerance']:g}: {r['pass']}" for r in e2["rows"]]
  2219	    a = res["table_a"]
  2220	    out += ["", h("(a) theta = 0, unseen, mean ± sd over seeds 42–46, item-weighted"), "", head, sep]
  2221	    for m in ("FLAC", "CANON", "OrbitRIR"):
  2222	        d = a[m]
  2223	        out += [f"| {m} ({d.get('ref') or d['source']}) | {k} | " + " | ".join(
  2224	            _mean_n(resolve(res, d)[k]["item"] if "ref" in d else d[k], key) for key in keys) + " |" for k in ks]
  2225	    bf = a["historical_bf"]
  2226	    out += [f"| {bf['label']} — B-F HISTORICAL, quoted, reference only | {k} | " + " | ".join(
  2227	        bf["rows"].get(k, {}).get("values", {}).get(name(key), "—") for key in keys) + " |" for k in ks]
  2228	    out += ["", f"B-F HISTORICAL: {bf['provenance']}."]
  2229	    for angle, title in (("45", "45 degrees"), ("R", "random yaw")):
  2230	        out += ["", h(f"(b) {title}, unseen, mean ± sd over seeds 42–46, item-weighted"), "", head, sep]
  2231	        out += [f"| {m} ({res['table_b'][angle][m]['source']}) | {k} | " + " | ".join(
  2232	            _mean_n(res["table_b"][angle][m][k], key) for key in keys) + " |" for m in ("FLAC", "CANON", "OrbitRIR")
  2233	            for k in ks]
  2234	        pooled = [(m, d) for m, d in res["table_b"][angle].items() if "points" in d]   # §14 A1.4: per-point provenance
  2235	        out += ["", "Pooled rows, per point (seed, campaign, pin, attention backend):"] + [
  2236	            f"- {m} K{k}: " + "; ".join(f"s{p['seed']} {p['campaign']} @{p['pin'][:12]} ({p['attention_backend']})"
  2237	                                        for p in d["points"][k]) for m, d in pooled for k in ks] if pooled else []
  2238	    t3 = res["tier3"]["BF"]
  2239	    fails = {r: [f"K{c['K']} {name(c['metric'])}" for c in t3["checks"] if c["computable"] and not c[r]]
  2240	             for r in ("pass_c4", "pass_r")}
  2241	    out += ["", h("(c) Tier 3 spread, item-weighted (CANON / P1-pin / YAW-pin quoted from the exp_25 JSON) and the "
  2242	                  "B-F verdict"), "", f"**Tier 3 B-F: {_verdict(t3['pass'])}** — {t3['rule']}. pass_c4 fails: "
  2243	            f"{', '.join(fails['pass_c4']) or 'none'}; pass_r fails: {', '.join(fails['pass_r']) or 'none'}.", "",
  2244	            "| arm (source) | K | metric | Delta_C4 | 45-deg probe | Delta_R | sd(m_Z) |", "|---|---|---|---|---|---|---|"]
  2245	    out += [f"| {arm} ({d['ref']}) | {k} | {name(key)} | " + " | ".join(
  2246	        _num(resolve(res, d)[k]["item"][key][f]) for f in ("delta_c4", "probe45", "delta_r", "sd_z")) + " |"
  2247	        for arm, d in res["table_c"].items() for k in ks for key in TIER3_KEYS]
  2248	    t2 = res["tier2_c4"]
  2249	    alarm = (t2.get("alarm") or {}).get("items") or {}
  2250	    out += ["", h("Tier 2-C4 — OrbitRIR's invariance claim (scored dumps vs the B-F composition control)"), "",
  2251	            f"**{t2['claim']}** (the registered p99 verdict: {_verdict(t2['pass'])})" + (
  2252	                " — the alarm suspends the claim pending item triage; items " + "; ".join(
  2253	                    f"{c}: {', '.join(v)}" for c, v in alarm.items()) if t2["claim"] == "SUSPENDED" else "")
  2254	            + f" — {t2.get('rule') or t2.get('note')}.", ""]
  2255	    if "pairs" in t2:
  2256	        out += ["| cell | control | control p99 | relL2 p99 | relL2 max | matched | cap |", "|---|---|---|---|---|---|---|"]
  2257	        out += [f"| {p['cell']} | {p['control_key']} | {_num(p['control_p99'])} | {_num((p.get('relL2') or {}).get('p99'))}"
  2258	                f" | {_num((p.get('relL2') or {}).get('max'))} | {p['pass_matched']} | {p['pass_cap']} |" for p in t2["pairs"]]
  2259	        out += ["", f"Pooled C4: {_verdict(t2['pooled']['pass'])} (p99 {_num((t2['pooled']['relL2'] or {}).get('p99'))}, "
  2260	                f"control {_num(t2['pooled']['control_p99'])}). T-dup determinism: {_verdict(t2['determinism']['pass'])} ("
  2261	                + "; ".join(f"{d['cell']}: max {_num(d['relL2_max'])}, dump sha256 equal {d['dump_sha_equal']}"
  2262	                            for d in t2["determinism"]["pairs"]) + f"). Alarm: {t2['alarm']['note']}. eps_cond (B-F, "
  2263	                f"fp32; reported, no verdict): {res['eps_cond_bf']}.", "",
  2264	                "Descriptive only (outside the claim, no verdict) — 45 degrees and random yaw vs theta = 0:"]
  2265	        out += [f"- {d['cell']}: relL2 p99 {_num(d['relL2']['p99'])}, max {_num(d['relL2']['max'])}; relLinf max "
  2266	                f"{_num(d['relLinf']['max'])}" for kind in ("45", "R") for d in t2["descriptive"][kind]]
  2267	    return "\n".join(out) + "\n"
