   182	def test_a_shrunk_log_is_a_hard_stop(tmp_path):
   183	    p, anchor = _anchored(tmp_path)
   184	    with open(p, "r+") as f:
   185	        f.truncate(anchor["size"] - 10)
   186	    r = obs(p, baseline=T, anchor=anchor)
   187	    assert r["status"] == "HARD_STOP" and any("shrank" in x for x in r["reasons"])
   188	
