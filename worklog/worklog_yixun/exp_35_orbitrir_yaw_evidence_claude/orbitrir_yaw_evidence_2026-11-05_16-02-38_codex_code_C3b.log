  2102	def build_exp35_results(cells, *, pin, blocks, exp25, registry, registry_why, ctl, e2, control, control_why,
  2103	                        probe_present, eps, external, external_why, exp25_base_dir, partial, e2f=None,
  2104	                        e2f_present=()):
  2105	    """§5's fail-closed list -- it refuses even with ``partial``; cells not run yet, a B-F probe not run yet and an
  2106	    E2 that did not PASS are the only gaps, labelled under ``partial``."""
  2107	    e2f, fail, present = e2f or {}, e2["status"] == "FAIL", list(e2f_present)   # present: ANY artifact (C3a C7)
  2108	    every = {**cells, **(e2f if fail else {})}     # §14 A1.4: after an E2 FAIL the block is part of the campaign
  2109	    missing, invalid = completeness(every)
  2110	    digests = sorted({e["receipt"]["campaign_digest"] for e in every.values() if e["valid"]})
  2111	    problems = [f"E2 {e2['status']} but {len(present)} E2-FAIL cell(s) exist ({', '.join(present[:3])}): that block "
  2112	                "runs only after an E2 FAIL (§14 A1)"] if present and not fail else []
  2113	    problems += [f"stream registry: {x}" for x in registry_why] + [
  2114	        f"{n}: {x} (stream registry)" for n, e in every.items() if e["valid"] and registry
  2115	        for x in registry_reasons(e["row"], e["stream"], registry)]
  2116	    problems += [f"{len(invalid)} cell(s) failed verification ({', '.join(invalid[:3])})"] if invalid else []
  2117	    problems += [f"the cells span {len(digests)} campaign digests"] if len(digests) > 1 else []
  2118	    problems += [f"CTL K{k} {st} (E1 must be equal): {'; '.join(why[:2])}" for k, (st, why) in ctl.items() if st != "equal"]
  2119	    problems += [f"external exp_25 cells: {x}" for x in external_why]
  2120	    problems += [f"the A6 CSV is not the pinned one: {'; '.join(e2['reasons'][:1])}"] if e2["csv_sha256"] != A6_CSV_SHA256 else []
  2121	    problems += [f"the B-F probe: {x}" for x in control_why[:3]] if control is None and probe_present else []
  2122	    if problems:
  2123	        raise ValueError("RESULTS REFUSED (an integrity problem; --partial does not apply): " + "; ".join(problems))
  2124	    gaps = [f"{len(missing)} cell(s) not run ({', '.join(missing[:4])}{' ...' if len(missing) > 4 else ''})"] if missing else []
  2125	    gaps += ["the B-F probe has not run: Tier 2-C4 is not computable"] if control is None else []
  2126	    gaps += [f"E2 {e2['status']}: the 45-degree FLAC / OrbitRIR points are pending"] if e2["status"] not in (
  2127	        "PASS", "FAIL") else []
  2128	    gaps += [f"E2 FAIL: {sum(n in missing for n in e2f)} E2-FAIL cell(s) not run, so those 45-degree points fall back "
  2129	             "to the s42 one-pin cell (n 1)"] if fail and any(n in missing for n in e2f) else []
  2130	    if gaps and not partial:
  2131	        raise ValueError("RESULTS REFUSED (pass --partial for a labelled partial table): " + "; ".join(gaps))
  2132	    a, b, c = tables(cells, external, e2, e2f)
  2133	    return {"schema_version": 1, "campaign": "exp35", "pin": pin, "blocks": list(blocks), "partial": bool(gaps),
  2134	            "gaps": gaps, "missing": missing, "campaign_digest": digests[0] if digests else None,
  2135	            "external_reference": {
  2136	                "exp25": {"path": os.path.relpath(os.path.join(EXPDIR, "depth_canon_results.json"), REPO),
  2137	                          "sha256": EXP25_RESULTS_SHA256, "pin": EXP25_PIN,
  2138	                          "table": {arm: exp25["table"][arm] for arm in ("P1", "CANON")},
  2139	                          "tier3": {arm: exp25["tier3"]["arms"][arm] for arm in ("CANON", "P1", "YAW")}},
  2140	                "exp25_cells": {"pin": EXP25_PIN, "base_dir": exp25_base_dir, "metrics": external,
  2141	                                "check": "verify_cell(pin=d6ca307a, dump_check='receipt', check_link=False)"},
  2142	                "registry_sha256": EXP35_REGISTRY_SHA256,
  2143	                "a6_csv": {"path": e2["csv"], "sha256": e2["csv_sha256"],
  2144	                           "read_by": "E2 only; its 45-degree rows enter table (b) on an E2 PASS"}},
  2145	            "e1_ctl": {str(k): {"status": st, "reasons": why} for k, (st, why) in ctl.items()}, "e2": e2,
  2146	            "tier2_c4": tier2_c4(cells, control), "eps_cond_bf": eps, "tier3": {"BF": tier3_bf(cells, exp25)},
  2147	            "table_a": a, "table_b": b, "table_c": c}
