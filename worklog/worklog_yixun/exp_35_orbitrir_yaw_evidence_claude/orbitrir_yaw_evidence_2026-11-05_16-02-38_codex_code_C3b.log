 def _flags(row):
     args, out, i = row["eval_args"], {}, 0
     while i < len(args):
         if i + 1 < len(args) and not args[i + 1].startswith("--"):
             out[args[i]], i = args[i + 1], i + 2
         else:
             out[args[i]], i = None, i + 1
     return out
 
 
