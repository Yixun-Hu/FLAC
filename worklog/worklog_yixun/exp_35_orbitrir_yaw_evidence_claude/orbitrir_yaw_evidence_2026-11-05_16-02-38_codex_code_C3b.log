   164	
   165	def test_an_unchanged_or_growing_log_keeps_its_anchor(tmp_path):
   166	    p, anchor = _anchored(tmp_path)
   167	    assert obs(p, baseline=T, anchor=anchor)["status"] == "OK"
   168	    with open(p, "a") as f:
   169	        f.write("\r".join(epoch_lines(2, 4.23)[0][:50]) + "\r")
   170	    r = obs(p, baseline=T, anchor=anchor)
   171	    assert r["status"] == "OK" and r["anchor"]["offset"] > anchor["offset"]
   172	
