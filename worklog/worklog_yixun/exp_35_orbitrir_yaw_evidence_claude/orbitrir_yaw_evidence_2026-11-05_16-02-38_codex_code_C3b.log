    65	def new_state(*, h35, cells_sha256, supervisor_sha256, approved_sha256):
    66	    return {"schema_version": STATE_SCHEMA, "campaign": "exp35", "h35": h35, "cells_sha256": cells_sha256,
    67	            "supervisor_sha256": supervisor_sha256, "approved_sha256": approved_sha256, "baseline": None,
    68	            "his_log_anchor": None, "lane": None, "reservation": None,
    69	            "chunks": [dict(c, state="planned") for c in chunk_plan()], "stop_latch": None, "events": []}
