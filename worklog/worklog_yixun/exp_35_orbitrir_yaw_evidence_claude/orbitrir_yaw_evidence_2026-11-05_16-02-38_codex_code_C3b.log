   174	def _forge_d128(r):
   175	    r["results"]["eval"]["d128"]["waveform"]["summary"]["relL2"]["p99"] = 0.5      # the summary AND the control,
   176	    r["control_p99"]["eval"]["d128"] = 0.5                                         # together
   177	
