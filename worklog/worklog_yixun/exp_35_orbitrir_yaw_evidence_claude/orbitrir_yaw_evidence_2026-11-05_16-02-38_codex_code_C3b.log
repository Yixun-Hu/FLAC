   174	def test_a_rotated_log_is_a_hard_stop(tmp_path):
   175	    p, anchor = _anchored(tmp_path)
   176	    os.rename(p, tmp_path / "train.log.1")
   177	    write_log(p, [4.23, 4.23])                                # same content, another inode
   178	    r = obs(p, baseline=T, anchor=anchor)
   179	    assert (r["status"], r["exit"]) == ("HARD_STOP", 2) and any("inode" in x for x in r["reasons"])
   180	
