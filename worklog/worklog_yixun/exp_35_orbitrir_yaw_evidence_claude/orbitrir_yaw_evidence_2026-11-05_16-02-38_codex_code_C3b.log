   155	def _ours(dirpath, uuid):
   156	    try:
   157	        with open(reservation_path(dirpath, uuid)) as f:
   158	            doc = json.load(f)
   159	    except FileNotFoundError:
   160	        return None
   161	    except (OSError, ValueError):
   162	        return {"holder": "?"}
   163	    return doc if isinstance(doc, dict) else {"holder": "?"}
