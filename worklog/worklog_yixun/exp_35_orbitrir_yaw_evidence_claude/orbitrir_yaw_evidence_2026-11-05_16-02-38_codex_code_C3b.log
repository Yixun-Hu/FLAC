   250	def test_the_bar_reset_under_the_old_label_after_a_completed_epoch_is_accepted(tmp_path):
   251	    """The real s43 log: after the validation PL resets the bar BEFORE the next epoch's label ("Epoch 0: 0/4550
   252	    [00:00<") -- accepted after the epoch's last step; the same line in the middle of an epoch is a restart."""
   253	    p = tmp_path / "train.log"
   254	    text = write_log(p, [4.23, 4.23])
   255	    assert "\r" + bar(0, 0, 0) + "\r" + bar(1, 0, 0) + "\r" in text and obs(p, baseline=T)["status"] == "OK"
   256	    write_log(p, [4.23], tail=bar(0, 0, 0) + "\r")            # 0/T again in epoch 0 -- after its last step: fine
   257	    assert obs(p)["status"] == "OK"
   258	    lines, _ = epoch_lines(0, 4.23)
   259	    p.write_text("\r".join(lines[:401] + [bar(0, 0, 0)] + lines[401:]) + "\r")   # mid-epoch: a restart
   260	    r = obs(p)
   261	    assert r["status"] == "HARD_STOP" and any("backwards" in x for x in r["reasons"])

