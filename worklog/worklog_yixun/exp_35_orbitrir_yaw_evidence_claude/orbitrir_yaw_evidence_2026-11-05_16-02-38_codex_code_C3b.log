   111	def load_state(path, *, h35, cells_sha256, supervisor_sha256):
   112	    """The state, None when absent; ``ValueError`` when corrupt or inconsistent (a refusal to run)."""
   113	    try:
   114	        with open(path) as f:
   115	            doc = json.load(f)
   116	    except FileNotFoundError:
   117	        return None
   118	    except (OSError, ValueError) as err:
   119	        raise ValueError(f"the supervisor state {path} is corrupt ({err})") from err
   120	    why = state_reasons(doc, h35=h35, cells_sha256=cells_sha256, supervisor_sha256=supervisor_sha256)
   121	    if why:
   122	        raise ValueError(f"the supervisor state {path} is inconsistent: " + "; ".join(why))
   123	    return doc
