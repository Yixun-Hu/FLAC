    66	def write_bf_probe(tmp, monkeypatch, mutate=None, registered=True, pin=PIN):
    67	    """The probe's own report + sidecar, as main(--arm BF) writes it (before finalization)."""
    68	    rep, stream = _toy_run()
    69	    monkeypatch.setattr(C, "PROBE_CONTRACT_BF", dict(C.PROBE_CONTRACT_BF, n_items=5, batch_size=3, K=2))
    70	    report = TP.probe.build_report(registered, [], _prov(pin), stream, copy.deepcopy(rep), arm="BF")
    71	    if mutate:
    72	        mutate(report)
    73	    path = os.path.join(str(tmp), "orbitrir_bf_cond_probe.json")
    74	    TP.probe.write_report(report, path)
