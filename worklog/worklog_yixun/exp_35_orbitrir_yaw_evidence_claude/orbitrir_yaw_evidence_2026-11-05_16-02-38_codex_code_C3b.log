    47	def planning_minutes(chunk):
    48	    if chunk["kind"] == "probe":
    49	        return PLAN_MIN["probe"]
    50	    m = re.match(r"exp35_(P1|BF)_\w+_K(\d)_s", chunk["cell"])
    51	    return PLAN_MIN[m[1]][int(m[2])]
