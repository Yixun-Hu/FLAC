  2270	def _csv(value):
  2310	    ap.add_argument("--partial", action="store_true", help="write a labelled PARTIAL table")
  2311	    ap.add_argument("--probe-json", default=os.path.join(EXPDIR, "depth_canon_cond_probe.json"))
  2312	    ap.add_argument("--tie-audit-json", default=os.path.join(EXPDIR, "depth_canon_tie_audit.json"))
  2313	    ap.add_argument("--out-md", default=os.path.join(EXPDIR, "depth_canon_results.md"))
  2314	    ap.add_argument("--out-json", default=os.path.join(EXPDIR, "depth_canon_results.json"))
  2315	    ap.add_argument("--verify-after", action="store_true",
