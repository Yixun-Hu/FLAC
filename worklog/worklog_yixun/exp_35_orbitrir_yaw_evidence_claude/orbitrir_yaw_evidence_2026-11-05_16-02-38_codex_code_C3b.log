   182	def gpu_map(text):
   183	    """``{index: uuid}`` from ``nvidia-smi --query-gpu=index,uuid --format=csv,noheader``; ValueError when malformed."""
   184	    out = {}
   185	    for line in [ln for ln in text.splitlines() if ln.strip()]:
   186	        m = re.fullmatch(r"\s*(\d+),\s*(GPU-[0-9A-Za-z-]+)\s*", line)
   187	        if not m or int(m[1]) in out or m[2] in out.values():
   188	            raise ValueError(f"malformed or duplicate nvidia-smi index,uuid row {line!r}")
   189	        out[int(m[1])] = m[2]
   190	    if not out:
   191	        raise ValueError("nvidia-smi lists no GPU")
   192	    return out
   193	
   194	
   195	def compute_apps(text):
   196	    """``[(pid, uuid)]`` from ``nvidia-smi --query-compute-apps=pid,gpu_uuid --format=csv,noheader``."""
   197	    out = []
   198	    for line in [ln for ln in text.splitlines() if ln.strip()]:
   199	        m = re.fullmatch(r"\s*(\d+),\s*(GPU-[0-9A-Za-z-]+)\s*", line)
   200	        if not m:
   201	            raise ValueError(f"malformed nvidia-smi compute-app row {line!r}")
   202	        out.append((int(m[1]), m[2]))
   203	    return out
   204	
   205	
   206	def descendants(pid, proc="/proc"):
   207	    """``pid`` and every process below it (by the ppid of ``/proc/<p>/stat``): our runner's own subtree."""
   208	    parent = {}
   209	    for name in os.listdir(proc):
   210	        if name.isdigit():
   211	            try:
   212	                with open(os.path.join(proc, name, "stat")) as f:
   213	                    text = f.read()
   214	                parent[int(name)] = int(text[text.rindex(")") + 2:].split()[1])
   215	            except (OSError, ValueError, IndexError):
   216	                continue
   217	    out, todo = set(), [pid] if pid in parent else []
   218	    while todo:
   219	        p = todo.pop()
   220	        out.add(p)
   221	        todo += [c for c, pp in parent.items() if pp == p and c not in out]
   222	    return out
