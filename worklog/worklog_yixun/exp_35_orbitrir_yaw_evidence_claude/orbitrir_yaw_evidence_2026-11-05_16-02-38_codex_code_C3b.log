   171	def reservation_reasons(dirpath, held, uuids):
   172	    """[] iff exactly the reservation the state holds (``{"uuid", "epoch"}`` or None) is ours on disk."""
   173	    mine = {u: d for u in uuids for d in [_ours(dirpath, u)] if d is not None and d.get("holder") == "exp35"}
   174	    if held is None:
   175	        return [f"exp_35 reservation file(s) {sorted(mine)} exist but the state holds none"] if mine else []
   176	    if set(mine) != {held["uuid"]}:
   177	        return [f"the state holds {held['uuid']} (epoch {held['epoch']}), the exp_35 files on disk are {sorted(mine)}"]
   178	    got = mine[held["uuid"]].get("epoch")
   179	    return [] if got == held["epoch"] else [f"the reservation of {held['uuid']} has epoch {got}, the state {held['epoch']}"]
