   103	@pytest.mark.parametrize("seconds, status", [(4856, "OK"), (4857, "STOP")])   # 500 x 9.712 = 4856 s exactly
   104	def test_the_500_step_window_threshold_is_strict(tmp_path, seconds, status):
   105	    p = tmp_path / "train.log"
   106	    write_log(p, [4.23, lambda n: 4.23 if not 500 < n <= 1000 else (seconds / 500)])
