   159	def _consistent(r):
   160	    """Recompute every summary, the pooled block, the control and the verdict from the (edited) item vectors with
   161	    the probe's own functions: a forgery that is internally consistent (Codex C3a BLOCKING 1)."""
   162	    import numpy as np
   163	    pr = TP.probe
   164	    for blocks in [r["results"][p] for p in r["results"]] + [{"det": r["determinism"][p]} for p in r["determinism"]]:
   165	        for blk in blocks.values():
   166	            for node in list(blk["cond"]["per_id"].values()) + [blk["cond"]["all"]] + [blk[s] for s in pr.STAGES[1:]]:
   167	                node["summary"] = pr.summarize({m: np.array(node[m]) for m in ("relL2", "relLinf")})
   168	    keys = list(r["results"]["eval"])
   169	    r["pooled"] = {p: pr._pooled(r["results"][p], keys) for p in r["results"]}
   170	    r["control_p99"] = {p: dict({k: r["results"][p][k]["waveform"]["summary"]["relL2"]["p99"] for k in keys},
   171	                                pooled=r["pooled"][p]["waveform"]["relL2"]["p99"]) for p in r["results"]}
   172	
