  2063	def _seed_stats(flat, source):
  2064	    """``{"source", "1", "8"}``: per K the TABLE_KEYS mean ± sd over flat metric dicts, one per seed."""
  2065	    return dict({str(k): {key: _stats([float(m[key]) for m in ms]) for key in TABLE_KEYS} for k, ms in flat.items()},
  2066	                source=source)
