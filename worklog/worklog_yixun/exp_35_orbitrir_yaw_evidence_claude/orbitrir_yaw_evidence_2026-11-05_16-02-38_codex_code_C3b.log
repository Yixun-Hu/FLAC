  1127	    pooled), eps_cond (reported, NO verdict) and the verdict must equal the recomputation -- and the verdict hold."""
  1128	    from src.tools import depth_canon_stats as stats
  1129	    res, det, keys, protos = rep.get("results"), rep.get("determinism"), list(P["offset_keys"]), list(P["protocols"])
  1130	    if not (isinstance(res, dict) and list(res) == protos and isinstance(det, dict) and list(det) == protos
  1131	            and all(isinstance(res[p], dict) and list(res[p]) == keys and isinstance(res[p][k], dict)
  1132	                    for p in protos for k in keys)):
  1133	        return ["probe results / determinism are not protocols x quarter turns x stages"]
  1134	    ids = (res[protos[0]][keys[0]].get("cond") or {}).get("ids")
  1135	    if not (isinstance(ids, list) and ids and all(isinstance(i, str) for i in ids) and ids == sorted(set(ids))):
  1136	        return [f"probe conditioner ids {ids!r} are not a sorted, non-empty list of names"]
  1137	    out = [x for p in protos for k in keys for x in _bf_block_reasons(res[p][k], f"results.{p}.{k}", P, ids)]
  1138	    out += [x for p in protos for x in _bf_block_reasons(det[p], f"determinism.{p}", P, ids)]
  1139	    if out:
  1140	        return out
  1141	    rows = lambda p, st: [res[p][k]["cond"]["all"] if st == "cond" else res[p][k][st] for k in keys]  # noqa: E731
  1142	    pooled = {p: {st: {m: stats.paired_summary([v for r in rows(p, st) for v in r[m]]) for m in ("relL2", "relLinf")}
  1143	                  for st in P["stages"]} for p in protos}
  1144	    _eq(out, "probe pooled (recomputed from the items)", rep.get("pooled"), pooled)
  1145	    _eq(out, "probe control_p99 (recomputed from the waveform relL2 items)", rep.get("control_p99"), {
  1146	        p: dict({k: stats.paired_summary(res[p][k]["waveform"]["relL2"])["p99"] for k in keys},
  1147	                pooled=pooled[p]["waveform"]["relL2"]["p99"]) for p in protos})
  1148	    top = max((v, k, i, pos) for k in keys for i, d in res["fp32"][k]["cond"]["per_id"].items()
  1149	              for pos, v in enumerate(d["relL2"]))
  1150	    _eq(out, "probe eps_cond (reported without a verdict)", rep.get("eps_cond"),
  1151	        {"value": top[0], "argmax": {"key": top[1], "id": top[2], "position": top[3]}})
  1152	    masks = all(b["cond"]["masks_equal"] for p in protos for b in [res[p][k] for k in keys] + [det[p]])
  1153	    exact = all(v == 0.0 for p in protos for st in P["stages"]
  1154	                for v in (det[p]["cond"]["all"] if st == "cond" else det[p][st])["relL2"])
  1155	    _eq(out, "probe verdict (masks equal AND the determinism floor exact)", rep.get("verdict"),
  1156	        {"pass": masks and exact, "masks": masks, "determinism": exact})
  1157	    return out + ([] if masks and exact else ["probe verdict FAILS: the B-F control is invalid (a hard stop)"])
