    53	
    54	def predictor_ok(report, *, now, chunk):
    55	    """§13 B1: a SHARED spawn only if s43's earliest end -- its last log write + (40,000 - step) x 3.5 s -- lies
    56	    after now + 2 x the chunk's planning duration + 30 min."""
    57	    step = (report.get("step") or {}).get("global")
    58	    if step is None or report.get("finished"):
    59	        return False, {"why": "no training step" if step is None else "the training has finished"}
    60	    earliest = report["log"]["mtime"] + (MAX_STEPS - step) * PREDICT_S_PER_STEP
    61	    need = now + 2 * planning_minutes(chunk) * 60 + PREDICT_MARGIN_S
    62	    return earliest > need, {"step": step, "earliest_end": earliest, "needed_after": need}
