   411	def _chunk_reasons(c, latched):
   412	    """Codex C3b BLOCKING 1: each state carries exactly the evidence it claims."""
   413	    n, st, cell = c["n"], c["state"], c["kind"] == "cell"
   414	    keys, base, flight = set(c), set(CHUNK_BASE), set(CHUNK_BASE + CHUNK_FLIGHT)
   415	    if st == "planned":
   416	        return [] if keys == base else [f"chunk {n}: a planned chunk carries {sorted(keys - base)}"]
   417	    if not flight <= keys:
   418	        return [f"chunk {n} ({st}): missing {sorted(flight - keys)}"]
   419	    out = [] if (isinstance(c["lane"], str) and GPU_RE.fullmatch(c["lane"]) and type(c["shared"]) is bool
   420	                 and c["shared"] == (c["lane"] == SUP_GPU1) and _text(c["started"]) and _text(c["log"])) else [
   421	        f"chunk {n}: a malformed lane / shared / started / log"]
   422	    rc_key = "runner_rc" if cell else "probe_rc"
   423	    run, receipt = {"ended", rc_key}, {"receipt_sha256", "campaign_digest"} if cell else set()
   424	    extra = keys - flight
   425	    if st == "in_flight":                         # a crash mid-chunk (bare) or a recorded failure (under the latch)
   426	        if extra and (extra != run or not latched or type(c[rc_key]) is not int or not _text(c["ended"])):
   427	            return out + [f"chunk {n}: in flight with {sorted(extra)} (a recorded failure: exactly {sorted(run)}, an int "
   428	                          "rc and its end, under the stop latch)"]
   429	        return out
   430	    gate, adopt = set(GATE_KEYS[c["gate"]]), {"adopted_at_restart"} if cell else set()
   431	    final = {"final_guard"} if st == "gates_verified" else set()
   432	    need = run | receipt | (gate | final if st == "gates_verified" else set())
   433	    if not need <= extra or extra - run - receipt - gate - adopt - final:
   434	        return out + [f"chunk {n} ({st}): carries {sorted(extra)}, needs {sorted(need)}"]
   435	    adopted = c.get("adopted_at_restart") is True
   436	    if "adopted_at_restart" in c and not adopted:
   437	        out.append(f"chunk {n}: adopted_at_restart {c['adopted_at_restart']!r}")
   438	    if not ((type(c[rc_key]) is int and c[rc_key] == 0) or (adopted and c[rc_key] is None)):
   439	        out.append(f"chunk {n}: rc {c[rc_key]!r} in a {st} chunk")
   440	    if not (_text(c["ended"]) or (adopted and c["ended"] is None)):
   441	        out.append(f"chunk {n}: ended {c['ended']!r}")
   442	    if cell and not (_hex(c["receipt_sha256"]) and _hex(c["campaign_digest"])):
   443	        out.append(f"chunk {n}: the receipt / campaign digest are not sha256 values")
   444	    fg = c.get("final_guard")
   445	    if st == "gates_verified" and not (
   446	            isinstance(fg, dict) and list(fg) == ["status", "exit", "t", "time", "step", "anchor"] and fg["status"] == "OK"
   447	            and type(fg["exit"]) is int and fg["exit"] == 0 and _num(fg["t"]) and _text(fg["time"])
   448	            and type(fg["step"]) is int and fg["step"] >= 0 and fg["anchor"] is not None
   449	            and not anchor_schema_reasons(fg["anchor"])):
   450	        out.append(f"chunk {n}: gates_verified without a passing final-guard record ({fg!r:.120})")
   451	    return out + _gate_reasons(c, latched)
