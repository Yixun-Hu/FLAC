   268	def git(repo, *args, raw=False):
   269	    """A read-only git query (no optional locks: a status never rewrites the index), waited for without a timeout (a
   270	    timeout would kill it); ValueError when it fails."""
   271	    r = subprocess.run(["git", "--no-optional-locks", "-C", repo, *args], capture_output=True)
   272	    if r.returncode != 0:
   273	        raise ValueError(f"git {' '.join(args[:2])} in {repo} failed (rc {r.returncode}): "
   274	                         f"{r.stderr.decode(errors='replace').strip()[:200]}")
   275	    return r.stdout if raw else r.stdout.decode()
