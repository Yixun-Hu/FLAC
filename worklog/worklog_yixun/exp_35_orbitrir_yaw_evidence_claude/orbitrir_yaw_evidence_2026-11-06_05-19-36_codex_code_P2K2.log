   388	def _gate_reasons(c, latched):
   389	    """A chunk's gate result: well formed; passed when gates_verified; a failure only under the stop latch."""
   390	    g, n = c["gate"], c["n"]
   391	    if g is None or (c["state"] == "runner_verified" and not any(k in c for k in GATE_KEYS[g])):
   392	        return []
   393	    if not all(k in c for k in GATE_KEYS[g]):
   394	        return [f"chunk {n}: an incomplete {g} result"]
   395	    if g == "PROBE":
   396	        pc = c["probe_contract"]
   397	        if not (isinstance(pc, dict) and list(pc) == ["rc", "out"] and type(pc["rc"]) is int and isinstance(pc["out"], str)):
   398	            return [f"chunk {n}: a malformed probe contract result"]
   399	        passed = pc["rc"] == 0 and all(_hex(c[k]) for k in GATE_KEYS[g][1:])
   400	    else:
   401	        r, (names, other, good) = c[GATE_KEYS[g][0]], VERDICTS[g]
   402	        if not (isinstance(r, dict) and list(r) == ["rc", "verdict", "out"] and type(r["rc"]) is int
   403	                and isinstance(r["out"], str) and r["verdict"] == names.get(r["rc"], other)):
   404	            return [f"chunk {n}: a malformed {g} result {r!r:.120}"]
   405	        passed = r["rc"] in good
   406	    if not passed and (c["state"] == "gates_verified" or not latched):
   407	        return [f"chunk {n}: a failed {g} result in a {c['state']} chunk" + ("" if latched else " without the stop latch")]
   408	    return []
