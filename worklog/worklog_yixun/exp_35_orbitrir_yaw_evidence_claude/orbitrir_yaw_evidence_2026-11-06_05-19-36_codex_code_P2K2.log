  1244	def open_mode(cfg, kit_commit, h35, orch, phases):
  1245	    """dry-run / launch / release: the self-pin, the H35 argument, an orchestration of THIS run worktree, the kit lock,
  1246	    its state in ``phases`` and reserved with this very kit commit. ((lock fd, state), []) or (None, reasons)."""
  1247	    why = kit_evidence(cfg, kit_commit)[0] + (
  1248	        [] if h35 == cfg.h35 else [f"the given H35 {h35} is not the registered {cfg.h35}"])
  1249	    base = os.path.realpath(os.path.join(cfg.run, X35))
  1250	    why += [] if os.path.dirname(os.path.realpath(orch)) == base else [f"{orch} is not an orchestration of {base}"]
  1251	    lock = None if why else kit_lock(cfg)
  1252	    if lock is None:
  1253	        return None, why or [f"the kit lock {KIT_LOCK} is held (a kit mode, our wrapper or a runner child lives)"]
  1254	    try:
  1255	        st = load_state(orch)
  1256	        why = ([] if st["phase"] in phases else [f"the state is {st['phase']}, not {' or '.join(phases)}"]) + (
  1257	            [] if st["kit"]["commit"] == kit_commit else [
  1258	                f"the orchestration was reserved with the kit {st['kit']['commit']}"])
  1259	    except ValueError as err:
  1260	        why = [str(err)]
  1261	    if why:
  1262	        os.close(lock)
  1263	        return None, why
  1264	    return (lock, st), []
