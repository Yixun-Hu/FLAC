   632	def _cmdlines(proc):
   633	    """(pid, argv) of every process but this one; a vanished entry is skipped, an unreadable one is Unreadable."""
   634	    try:
   635	        names = os.listdir(proc)
   636	    except OSError as err:
   637	        raise Unreadable(f"{proc} is unreadable ({err})") from err
   638	    for n in names:
   639	        if not n.isdigit() or int(n) == os.getpid():
   640	            continue
   641	        try:
   642	            with open(os.path.join(proc, n, "cmdline"), "rb") as f:
   643	                raw = f.read()
   644	        except (FileNotFoundError, ProcessLookupError):
   645	            continue
   646	        except OSError as err:
   647	            raise Unreadable(f"{proc}/{n}/cmdline is unreadable ({err})") from err
   648	        yield int(n), [a.decode(errors="replace") for a in raw.split(b"\0") if a]
