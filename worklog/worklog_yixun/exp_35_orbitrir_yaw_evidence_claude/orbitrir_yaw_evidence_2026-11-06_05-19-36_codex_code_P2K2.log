   608	def lock_status(path):
   609	    """'absent' | 'unheld' | 'held': opened O_RDONLY (never created), LOCK_SH | LOCK_NB, closed at once (no lock
   610	    outlives the probe); Unreadable on any other error."""
   611	    try:
