  1072	def reserve(world, cfg, *, kit_commit, h35, lanes, report, report_sha256):
  1073	    """§15 item 6 + S6: every precondition at TWO observations ``gap_s`` apart, then a fresh orchestration with its
  1074	    state 'reserving' (O_EXCL), each lane's O_EXCL record (all or nothing), the observation again AFTER the
  1075	    acquisition, then 'reserved'; else 'reserve_refused' (only our exact records released) or 'reserve_failed' (a
  1076	    record no longer ours: retained). (rc, message)."""
  1077	    why, kit = kit_evidence(cfg, kit_commit)
  1078	    why += [] if h35 == cfg.h35 else [f"the given H35 {h35} is not the registered {cfg.h35}"]
  1079	    if why:
  1080	        return 1, "RESERVE REFUSED (nothing reserved): " + "; ".join(why)
  1081	    lock = kit_lock(cfg)
  1082	    if lock is None:
  1083	        return 1, f"RESERVE REFUSED (nothing reserved): the kit lock {KIT_LOCK} is held (a kit mode or a run lives)"
  1084	    try:
  1085	        return _reserve(world, cfg, kit, lanes, report, report_sha256)
  1086	    finally:
  1087	        os.close(lock)
