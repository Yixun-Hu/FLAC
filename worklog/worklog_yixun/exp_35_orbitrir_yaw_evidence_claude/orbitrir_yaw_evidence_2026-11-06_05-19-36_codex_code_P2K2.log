  1090	def _reserve(world, cfg, kit, lanes, report, report_sha256):
  1091	    try:
  1092	        why, runs = prior(cfg)
  1093	        bad, ev = evidence(cfg, lanes=lanes, report=report, report_sha256=report_sha256, prior_runs=runs)
  1094	        obs = [observe(world, cfg, lanes)]
  1095	        why += bad + obs[0]["reasons"]
  1096	        if not why:
  1097	            world.sleep(cfg.gap_s)
  1098	            obs.append(observe(world, cfg, lanes))
  1099	            why += obs[1]["reasons"] + ([] if obs[1]["map"] == obs[0]["map"] else ["the GPU map changed between the "
  1100	                                                                                 "two observations"])
  1101	    except Unreadable as err:
  1102	        why = [f"unreadable: {err}"]
  1103	    if why:
  1104	        return 1, "RESERVE REFUSED (nothing reserved): " + "; ".join(why)
  1105	    run = time.strftime("%Y%m%dT%H%M%S", time.localtime(world.now()))
  1106	    orch = os.path.join(cfg.run, X35, ORCH_PREFIX + run)
  1107	    st = dict(zip(STATE_KEYS, (1, "exp35_phase_ii", run, kit, ev, ev["lanes"], [], "reserving", obs) + (None,) * 7 + ([],)))
  1108	    event(st, world.now(), "reserving: the preconditions held at both observations; the O_EXCL records next")
  1109	    os.mkdir(orch)
  1110	    write_exclusive(state_path(orch), dumps(st))
  1111	    held = []
  1112	    try:
  1113	        for i in lanes:
  1114	            held.append(create_reservation(cfg, i, h35=cfg.h35, run=run, now=world.now()))
  1115	        st["observations"].append(observe(world, cfg, lanes, held=held))
  1116	        why = st["observations"][-1]["reasons"]
  1117	    except FileExistsError:
  1118	        why = ["another holder created a lane's reservation at the O_EXCL (a lost race; its file is untouched)"]
  1119	    except Unreadable as err:
  1120	        why = [f"unreadable: {err}"]
  1121	    if not why:
  1122	        st.update(phase="reserved", reservations=held)
  1123	        event(st, world.now(), "reserved", records=[h["path"] for h in held])
  1124	        write_json_atomic(state_path(orch), st)
  1125	        return 0, f"RESERVED {orch}: " + "; ".join(f"GPU {h['index']} {h['path']} sha256 {h['sha256']} inode "
  1126	                                                   f"{h['inode']}" for h in held) + "; state reserved"
  1127	    kept = [dict(h, unreleased=r) for h in held for r in [release_reservation(h)] if r]
  1128	    st.update(phase="reserve_failed" if kept else "reserve_refused", reservations=kept,
  1129	              failure={"reasons": why, "time": iso(world.now())},
  1130	              released={"by": "reserve", "records": [h["path"] for h in held if h["path"] not in
  1131	                                                     [k["path"] for k in kept]], "time": iso(world.now())})
  1132	    event(st, world.now(), st["phase"], reasons=why)
  1133	    write_json_atomic(state_path(orch), st)
  1134	    return 1, (f"RESERVE REFUSED after the acquisition ({st['phase']}; our own records released, "
  1135	               f"{len(kept)} retained): " + "; ".join(why))
