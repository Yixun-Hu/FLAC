   336	        (f"the stop latch is set: {doc['stop_latch']!r:.120}", doc["stop_latch"] is not None),
   337	        (f"the phase-(i) lane is still set: {doc['lane']!r}", doc["lane"] is not None),
   338	        (f"the phase-(i) reservation is still held: {doc['reservation']!r:.160}", doc["reservation"] is not None)) if bad]
   339	    ev = doc["events"]
   340	    last = ev[-1].get("what") if isinstance(ev, list) and ev and isinstance(ev[-1], dict) else None
