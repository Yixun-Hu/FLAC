   705	    fd of /proc/<pid> between two stat reads that must agree; ValueError when gone, unreadable or reused."""
   706	    pid = int(pid)
   707	    try:
   708	        fd = os.open(os.path.join(proc, str(pid)), os.O_RDONLY | os.O_DIRECTORY)
   709	    except OSError as err:
   710	        raise ValueError(f"process {pid}: its /proc identity is unreadable ({type(err).__name__}: {err})") from err
   711	    opener = lambda path, flags: os.open(path, flags, dir_fd=fd)  # noqa: E731
   712	    try:
   713	        with open("stat", opener=opener) as f:
   714	            first = _stat_identity(f.read())
   715	        with open("cmdline", "rb", opener=opener) as f:
   716	            cmdline = f.read()
   717	        links = [os.readlink(p, dir_fd=fd) for p in ("cwd", "fd/1", "fd/2")]
   718	        with open("stat", opener=opener) as f:
   719	            second = _stat_identity(f.read())
   720	    except (OSError, ValueError, IndexError) as err:
   721	        raise ValueError(f"process {pid}: its /proc identity is unreadable ({type(err).__name__}: {err})") from err
   722	    finally:
   723	        os.close(fd)
   724	    if not first == second == (pid, first[1]):
   725	        raise ValueError(f"process {pid}: its /proc entry changed during the sample ({first} -> {second}): PID reuse")
   726	    return {"pid": pid, "start_time": first[1], "cwd": links[0], "cmdline_sha256": sha256_bytes(cmdline),
   727	            "fd1": links[1], "fd2": links[2]}
