  1267	def recheck(world, cfg, st, orch):
  1268	    """Every precondition again, the evidence unchanged since the reservation, the held records ours: (reasons, obs)."""
  1269	    lanes = tuple(x["index"] for x in st["lanes"])
  1270	    why, runs = prior(cfg, exclude=orch)
  1271	    bad, ev = evidence(cfg, lanes=lanes, report=st["evidence"]["report"]["path"],
  1272	                       report_sha256=st["evidence"]["report"]["sha256"], prior_runs=runs)
  1273	    o = observe(world, cfg, lanes, held=st["reservations"])
  1274	    return why + bad + ([] if ev == st["evidence"] else ["the evidence changed since the reservation"]) + o["reasons"], o
  1275	
