  1277	def dry_run(world, cfg, *, kit_commit, h35, orch):
  1278	    """§15 item 7: from 'reserved' only -- the recheck, 'dry_run_pending' (durable, crash-terminal: never retried or
  1279	    released by the kit), the EXACT runner command under DRY_RUN=1, its transcript parsed exactly and its own
  1280	    artifacts checked; then 'dry_run_passed', or 'dry_run_failed' (retained). (rc, message)."""
  1281	    opened, why = open_mode(cfg, kit_commit, h35, orch, ("reserved",))
  1282	    if opened is None:
  1283	        return 1, "DRY RUN REFUSED (nothing changed): " + "; ".join(why)
  1284	    lock, st = opened
  1285	    try:
  1286	        argv, env, cwd = runner_command(cfg, tuple(x["index"] for x in st["lanes"]), dry=True)
  1287	        rec = {"argv": argv, "env": env, "cwd": cwd, "started": world.now()}
  1288	        try:
  1289	            why, rec["before"] = recheck(world, cfg, st, orch)
  1290	            if not why:                                  # Codex P2K-1 HIGH 1: durable BEFORE the spawn, crash-terminal
  1291	                st.update(phase="dry_run_pending", dry_run=dict(rec))
  1292	                event(st, world.now(), "dry_run_pending: the dry-run runner is spawned next")
  1293	                write_json_atomic(state_path(orch), st)
  1294	                p = dry_spawn(argv, cwd=cwd, env=env)
  1295	                raw = p.communicate()[0]                                         # no timeout: never killed
  1296	                path = os.path.join(orch, "dry_run_runner.log")
  1297	                rec.update(rc=p.returncode, ended=world.now(), outer_log={
  1298	                    "path": path, "sha256": write_exclusive(path, raw).sha256, "bytes": len(raw)})
  1299	                why = [f"the dry run exited rc {p.returncode}"] if p.returncode else []
  1300	                why += artifacts(cfg, raw, st, rec)
  1301	                more, rec["after"] = recheck(world, cfg, st, orch)
  1302	                why += more
  1303	        except Unreadable as err:
  1304	            why = [f"unreadable: {err}"]
  1305	        except OSError as err:                           # the runner could not be spawned, or its log written
  1306	            why = [f"the dry run could not be spawned or its outer log written ({err})"]
  1307	        st.update(phase="dry_run_failed" if why else "dry_run_passed", dry_run=dict(rec, reasons=why),
  1308	                  failure={"reasons": why, "time": iso(world.now())} if why else None)
  1309	        event(st, world.now(), st["phase"], reasons=why[:5])
  1310	        write_json_atomic(state_path(orch), st)
  1311	    finally:
  1312	        os.close(lock)
  1313	    if why:
  1314	        return 1, "DRY RUN FAILED (retained; release, then reserve anew): " + "; ".join(why)
  1315	    return 0, (f"DRY RUN PASSED: {rec['n_ids']} cells, {len(rec['argv_records'])} argv, the runner's log, plan and "
  1316	               "pre-flight exact")
