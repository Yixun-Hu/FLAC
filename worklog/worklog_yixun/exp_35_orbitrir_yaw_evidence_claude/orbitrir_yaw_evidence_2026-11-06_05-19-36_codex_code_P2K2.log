   142	def write_exclusive(path, raw):
   143	    """O_CREAT | O_EXCL (any existing name, a dangling link included, refuses), fully written, the file and its
   144	    directory fsynced: the Snap of exactly the bytes written."""
   145	    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
   146	    try:
   147	        view = memoryview(raw)
   148	        while view:
   149	            view = view[os.write(fd, view):]
   150	        os.fsync(fd)
   151	        st = os.fstat(fd)
   152	    finally:
   153	        os.close(fd)
   154	    fsync_dir(os.path.dirname(os.path.abspath(path)))
   155	    return Snap(raw, sha256_bytes(raw), st.st_dev, st.st_ino)
