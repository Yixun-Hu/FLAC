   110	def snapshot(path):
   111	    """ONE no-follow read of the regular file ``path``: its bytes, their sha256, its (device, inode); None when it
   112	    is absent, a symlink, not a regular file or unreadable."""
   113	    try:
   114	        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
   115	    except (OSError, TypeError):
   116	        return None
   117	    try:
   118	        st, chunks = os.fstat(fd), []
   119	        if not stat.S_ISREG(st.st_mode):
   120	            return None
   121	        while True:
   122	            chunk = os.read(fd, 1 << 20)
   123	            if not chunk:
   124	                break
   125	            chunks.append(chunk)
   126	    except OSError:
   127	        return None
   128	    finally:
   129	        os.close(fd)
   130	    raw = b"".join(chunks)
   131	    return Snap(raw, sha256_bytes(raw), st.st_dev, st.st_ino)
