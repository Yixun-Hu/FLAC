   316	def phase_i_reasons(doc, *, h35, digest, supervisor_sha256, reservations):
   317	    """§15 item 4: [] iff ``doc`` is the supervisor's state of a COMPLETE phase (i). First the H35 supervisor's own
   318	    complete schema (``supervisor_state_reasons``, with the registered approved-tuple pin and his log path); then the
   319	    terminal conditions: the 33 frozen chunks gates_verified, E2 PASS, exactly the campaign digest, no stop latch, no
   320	    lane and no reservation, the final release event last."""
   321	    out = [f"the H35 supervisor's schema: {x}" for x in supervisor_state_reasons(
   322	        doc, h35=h35, cells_sha256=CELLS_SHA256, supervisor_sha256=supervisor_sha256, approved_sha256=APPROVED_SHA256,
   323	        his_log=HIS_LOG, reservations=reservations)]
