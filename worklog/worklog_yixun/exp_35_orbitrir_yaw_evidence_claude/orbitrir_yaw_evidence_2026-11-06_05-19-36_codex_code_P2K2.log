   359	def anchor_schema_reasons(anchor):
   360	    """[] iff ``anchor`` is None or exactly what ``anchor_of`` writes (Codex C3b NIT 1)."""
   361	    if anchor is None:
   362	        return []
   363	    ok = isinstance(anchor, dict) and list(anchor) == list(ANCHOR_KEYS) and all(
   364	        type(anchor[k]) is int and anchor[k] >= 0 for k in ANCHOR_KEYS[:4]) and anchor["offset"] <= anchor["size"] \
   365	        and isinstance(anchor["tail_sha256"], str) and re.fullmatch(r"[0-9a-f]{64}", anchor["tail_sha256"]) is not None
   366	    return [] if ok else [f"the persisted anchor is malformed: {anchor!r:.200}"]
