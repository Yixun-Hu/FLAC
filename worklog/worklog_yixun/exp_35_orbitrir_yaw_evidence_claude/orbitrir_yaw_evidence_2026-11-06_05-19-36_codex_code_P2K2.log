  1042	def prior(cfg, exclude=None):
  1043	    """(reasons, run ids): every OTHER orchestration must be resolved; those that reached launch_pending are the
  1044	    prior runs the report must name (S5: no relaunch without a review and a report)."""
  1045	    why, runs = [], []
  1046	    for d, st in orchestrations(cfg):
  1047	        if exclude is not None and os.path.realpath(d) == os.path.realpath(exclude):
  1048	            continue
  1049	        if not isinstance(st, dict) or st["phase"] not in RESOLVED:
  1050	            why.append(f"the orchestration {d} is unresolved ({st if not isinstance(st, dict) else st['phase']})")
  1051	        if isinstance(st, dict) and st["launch"] is not None:
  1052	            runs.append(st["run"])
  1053	    return why, runs
