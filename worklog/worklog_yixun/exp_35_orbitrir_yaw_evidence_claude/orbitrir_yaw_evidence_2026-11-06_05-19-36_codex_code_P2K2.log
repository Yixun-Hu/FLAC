  1198	def parse_dry_run(text, *, cfg, m, rows, lanes):
  1199	    """S6 'exact dry-run parsing': (reasons, info). Every line must be the next expected one -- the pinned env's one
  1200	    warning line only between preamble lines -- and none may be a SKIP, quarantine, E2-FAIL or refusal line. info: the
  1201	    run's timestamp, the cell ids and the argv records in order, the warning count, the line count."""
  1202	    lines, e2 = text.splitlines(), {c["cell"] for c in m["cells"] if c["block"] == "E2-FAIL"}
  1203	    out = [f"the transcript holds {k}: {v[0][:160]!r}" for k, v in (
  1204	        ("a SKIP line", [ln for ln in lines if "| SKIP" in ln]),
  1205	        ("a quarantine line", [ln for ln in lines if "quarantine" in ln.lower()]),
  1206	        ("an E2-FAIL cell", [ln for ln in lines if "E2-FAIL" in ln or (ln.startswith(("CELL ", "DRYRUN "))
  1207	                                                                       and ln.split()[1:2] and ln.split()[1] in e2)]),
  1208	        ("a refusal", [ln for ln in lines if "abort" in ln or "REFUSED" in ln or "FAILED" in ln])) if v]
  1209	    want, k, ts, ids, argv, benign, broke = _expected_lines(cfg, m, rows, lanes), 0, set(), [], [], 0, False
  1210	    for i, ln in enumerate(lines, 1):
  1211	        if ln == BENIGN and k < 11:
  1212	            benign += 1
  1213	            continue
  1214	        if k == len(want):
  1215	            out, broke = out + [f"line {i} follows the summary: {ln[:160]!r}"], True
  1216	            break
  1217	        w = want[k]
  1218	        if w[0] == "re":
  1219	            hit = re.fullmatch(w[1], ln)
  1220	            ts.update([hit["ts"]] if hit is not None and "ts" in hit.re.groupindex else [])
  1221	        elif w[0] == "eq":
  1222	            hit = ln == w[1]
  1223	            ids += [w[1].split()[1]] if hit and ln.startswith("CELL ") else []
  1224	        else:
  1225	            pre = f"DRYRUN {w[1]} argv: "
  1226	            hit = ln.startswith(pre) and _json(ln[len(pre):]) == w[2]
  1227	            argv += [w[2]] if hit else []
  1228	        if not hit:
  1229	            want_text = f"DRYRUN {w[1]} argv {w[2]}" if w[0] == "argv" else w[1]
  1230	            out, broke = out + [f"line {i} {ln[:200]!r} is not the expected {want_text[:300]!r}"], True
  1231	            break
  1232	        k += 1
  1233	    out += [] if broke or k == len(want) else [f"the transcript ends after {k} of its {len(want)} expected lines"]
  1234	    out += [] if len(ts) == 1 else [f"the transcript names {len(ts)} run timestamps {sorted(ts)}"]
  1235	    out += [] if len(ids) == len(argv) == len(rows) else [f"{len(ids)} cell ids, {len(argv)} argv, not {len(rows)}"]
  1236	    return out, {"ts": min(ts) if len(ts) == 1 else None, "ids": ids, "argv": argv, "benign_lines": benign,
  1237	                 "lines": len(lines)}
