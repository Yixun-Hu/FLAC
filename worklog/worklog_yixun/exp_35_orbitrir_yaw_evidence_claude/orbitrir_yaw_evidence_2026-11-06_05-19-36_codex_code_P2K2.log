   483	def supervisor_state_reasons(doc, *, h35, cells_sha256, supervisor_sha256, approved_sha256, his_log, reservations):
   484	    if not isinstance(doc, dict) or list(doc) != list(PHASE_I_KEYS):
   485	        return [f"the state's keys are not {list(PHASE_I_KEYS)}"]
   486	    out = [f"{k}: {doc[k]!r} != {want!r}" for k, want in (
   487	        ("schema_version", 1), ("campaign", "exp35"), ("h35", h35), ("cells_sha256", cells_sha256),
   488	        ("supervisor_sha256", supervisor_sha256), ("approved_sha256", approved_sha256)) if doc[k] != want]
   489	    plan = list(PHASE_I_CHUNKS)
   490	    if not isinstance(doc["chunks"], list) or not all(isinstance(c, dict) for c in doc["chunks"]) or [
   491	            (c.get("n"), c.get("kind"), c.get("cell"), c.get("gate")) for c in doc["chunks"]] != plan:
   492	        return out + ["the state's chunks are not the frozen 33-chunk order"]
   493	    states = [c.get("state") for c in doc["chunks"]]
   494	    out += [f"chunk {i + 1}: unknown state {s!r}" for i, s in enumerate(states) if s not in CHUNK_STATES]
   495	    if out:
   496	        return out
   497	    done = 0
   498	    while done < len(states) and states[done] == "gates_verified":
   499	        done += 1
   500	    if any(s != "planned" for s in states[done + 1:]):
   501	        out.append(f"chunk order violated: {states[:done + 3]}... (only the first unfinished chunk may be started)")
   502	    latched = doc["stop_latch"] is not None
   503	    out += [x for c in doc["chunks"] for x in _chunk_reasons(c, latched)] + _top_reasons(doc, his_log, reservations)
   504	    digests = {c["campaign_digest"] for c in doc["chunks"] if "campaign_digest" in c}
   505	    out += [f"the chunks carry {len(digests)} campaign digests"] if len(digests) > 1 else []
   506	    started = any(s != "planned" for s in states)
   507	    if started != (doc["baseline"] is not None):
   508	        out.append("a baseline exactly when a chunk has started")
   509	    if started and done < len(states) and doc["reservation"] is None:
   510	        out.append("a started, unfinished campaign holds no reservation")
   511	    return out
