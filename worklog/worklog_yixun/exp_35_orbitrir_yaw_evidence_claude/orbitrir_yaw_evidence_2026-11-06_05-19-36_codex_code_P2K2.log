  1173	        r"configs OK: every model / dataset config of the selection matches its manifest pin",
  1174	        rf"BACKEND OK {x}/depth_canon_(?P<ts>{TS_RE})_no_flash_preflight\.log",
  1175	        rf"no-flash pre-flight OK: {n} exp_35 cell\(s\) spawn through overlays/no_flash/exp35_no_flash_launch\.py "
  1176	        rf"\(log {x}/depth_canon_(?P<ts>{TS_RE})_no_flash_preflight\.log\)",
  1177	        rf"dump root OK under DRY_RUN: {e(DUMP_ROOT)} \(exists\)",
