   278	def tree_digest(repo, paths):
   279	    """The runner's tree_digest: the sha256 of the sorted ``sha256sum`` lines of every tracked + untracked (unignored)
   280	    file under ``paths``. A name the runner's sha256sum would escape (a backslash, a newline) is refused."""
   281	    out = git(repo, "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", *paths, raw=True)
   282	    names = sorted({n for n in out.split(b"\0") if n})
   283	    if not names or any(b"\\" in n or b"\n" in n for n in names):
   284	        raise ValueError(f"the relevant tree of {repo} is empty or holds a name the runner's sha256sum escapes")
   285	    lines = []
   286	    for n in names:
   287	        s = snapshot(os.path.join(repo, os.fsdecode(n)))
   288	        if s is None:
   289	            raise ValueError(f"the relevant file {os.fsdecode(n)} is not a readable regular file")
   290	        lines.append(f"{s.sha256}  {os.fsdecode(n)}")
   291	    return sha256_bytes(("\n".join(lines) + "\n").encode())
