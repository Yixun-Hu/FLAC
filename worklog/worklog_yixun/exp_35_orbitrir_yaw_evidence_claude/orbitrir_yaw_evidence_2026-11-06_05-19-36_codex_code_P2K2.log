  1060	def kit_lock(cfg):
  1061	    """The kit's single-instance lock (LOCK_EX | LOCK_NB): its fd, or None while another process holds it -- a kit
  1062	    mode, our detached wrapper, or a runner / evaluator descendant that inherited it."""
  1063	    fd = os.open(os.path.join(cfg.run, KIT_LOCK), os.O_RDWR | os.O_CREAT, 0o644)
  1064	    try:
  1065	        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
  1066	    except BlockingIOError:
  1067	        os.close(fd)
  1068	        return None
  1069	    return fd
