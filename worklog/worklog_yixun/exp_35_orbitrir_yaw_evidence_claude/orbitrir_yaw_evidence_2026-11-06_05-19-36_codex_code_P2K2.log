   730	def identity_status(ident, proc):
   731	    """'alive' (its pid runs with its recorded start time), 'gone', or 'reused' (the pid names another process) --
   732	    never by a pid alone; ValueError for an incomplete record, Unreadable for an unreadable live entry."""
   733	    if not (isinstance(ident, dict) and all(k in ident for k in ID_KEYS) and type(ident["pid"]) is int
   734	            and ident["pid"] > 0 and type(ident["start_time"]) is int):
   735	        raise ValueError(f"an incomplete identity {ident!r:.120} identifies no process")
   736	    path = os.path.join(proc, str(ident["pid"]))
   737	    if not os.path.lexists(path):
   738	        return "gone"
   739	    try:
   740	        live = proc_identity(ident["pid"], proc)
   741	    except ValueError as err:
   742	        if not os.path.lexists(path):
   743	            return "gone"
   744	        raise Unreadable(str(err)) from err
   745	    return "alive" if live["start_time"] == ident["start_time"] else "reused"
