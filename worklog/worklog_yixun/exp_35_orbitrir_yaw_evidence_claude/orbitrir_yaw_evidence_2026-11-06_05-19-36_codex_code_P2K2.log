   454	def _top_reasons(doc, his_log, reservations):
   455	    """baseline (on THE configured log), the guard anchor, lane + reservation (in THE configured directory), the latch,
   456	    the events -- exact (Codex C3b BLOCKING 1, C3c BLOCKING 1)."""
   457	    b, lane, res, latch = doc["baseline"], doc["lane"], doc["reservation"], doc["stop_latch"]
   458	    out = [] if b is None or (isinstance(b, dict) and list(b) == ["time", "step", "log"] and _num(b["time"])
   459	                              and type(b["step"]) is int and b["step"] >= 0 and isinstance(b["log"], dict)
   460	                              and list(b["log"]) == ["path", "inode", "size"] and b["log"]["path"] == his_log
   461	                              and type(b["log"]["inode"]) is int and b["log"]["inode"] >= 0
   462	                              and type(b["log"]["size"]) is int and b["log"]["size"] >= 0) else [
   463	        f"a malformed baseline, or one on another log than {his_log}: {b!r:.160}"]
   464	    out += anchor_schema_reasons(doc["his_log_anchor"])
   465	    if (lane is None) != (res is None):
   466	        out.append("the lane and the reservation must be set together")
   467	    elif lane is not None and not (
   468	            isinstance(lane, dict) and list(lane) == ["uuid", "shared"] and isinstance(lane["uuid"], str)
   469	            and GPU_RE.fullmatch(lane["uuid"]) and type(lane["shared"]) is bool and lane["shared"] == (lane["uuid"] == SUP_GPU1)
   470	            and isinstance(res, dict) and list(res) == ["uuid", "epoch", "path", "sha256"] and res["uuid"] == lane["uuid"]
   471	            and type(res["epoch"]) is int and res["epoch"] >= 1 and res["path"] == os.path.join(reservations, res["uuid"] + ".json")
   472	            and _hex(res["sha256"])):
   473	        out.append(f"the lane {lane!r} and the reservation {res!r} do not agree")
   474	    if latch is not None and not (isinstance(latch, dict) and list(latch) == ["reason", "time"]
   475	                                  and _text(latch["reason"]) and _text(latch["time"])):
   476	        out.append(f"a malformed stop latch {latch!r:.120}")
   477	    if not (isinstance(doc["events"], list) and all(isinstance(e, dict) and _num(e.get("t")) and _text(e.get("time"))
   478	                                                    and _text(e.get("what")) for e in doc["events"])):
   479	        out.append("malformed events")
   480	    return out
