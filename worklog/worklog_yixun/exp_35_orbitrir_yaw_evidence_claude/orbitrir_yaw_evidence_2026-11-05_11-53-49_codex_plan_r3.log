   163	
   164	def training(action, arm, seed, run, *args):
   165	    path = Path(run) / 'exp30_training.json'
   166	    binding = training_binding(arm, seed, run)
   167	    if path.exists():
   168	        ledger = read_json(path)
   169	        require(ledger['binding'] == binding, 'training manifest arm/seed/config/recipe/code mismatch')
   170	    else:
   171	        require(not snapshots(run), 'untracked checkpoints: explicit provenance verification required')
   172	        ledger = {'binding': binding, 'attempts': []}
   173	    attempts = ledger['attempts']
   174	    last = attempts[-1] if attempts else None
   175	    if action == 'inspect':
   176	        if last and last['state'] == 'RUNNING':
   177	            last.update(state='FAILED', exit_status='interrupted/unknown', ended=pair.now(),
   178	                        checkpoints=capture(last, run))
   179	            atomic_json(path, ledger)
   180	        print(last['state'] if last else 'NEW')
   181	    elif action == 'begin':
   182	        require(not last or last['state'] == 'FAILED', 'attempt is already active/successful')
   183	        if last:
   184	            require(f'{arm}:{seed}' in os.environ.get('EXP30_RETRY_FAILED', '').split(','),
   185	                    f'FAILED persists; set EXP30_RETRY_FAILED={arm}:{seed} to retry')
   186	        attempts.append({'state': 'RUNNING', 'started': pair.now(), 'retry': bool(last),
   187	                         'exit_status': None, 'before': snapshots(run), 'checkpoints': [],
   188	                         'resume': identity(args[0]) if args and args[0] else None})
   189	        atomic_json(path, ledger)
   190	    elif action == 'finish':
   191	        require(last and last['state'] == 'RUNNING', 'no running training attempt')
   192	        last.update(state='FAILED', exit_status=int(args[0]), ended=pair.now())
   193	        atomic_json(path, ledger)
   194	        last['checkpoints'] = capture(last, run)
   195	        atomic_json(path, ledger)
   196	        require(last['exit_status'] == 0, f"trainer exit={last['exit_status']}")
   197	        candidates = select_checkpoints(last['checkpoints'], arm, seed, final=True)
   198	        require(bool(candidates), 'no newly written valid final checkpoint')
