    26	def training_binding(arm, seed, run):
    27	    require(arm == 'ACEattn' and int(seed) in (42, 43, 44), 'invalid training job')
    28	    ace.local_checkpoint(Path(run) / 'binding.ckpt', seed)
    29	    return {
    30	        'arm': arm, 'ace_mode': 'attention', 'seed': int(seed), 'run': str(Path(run).resolve()),
    31	        **ace.code_provenance(),
    32	        'config': identity(ace.config_path()),
    33	        'dataset': identity('src/configs/dataset_configs/AR/train/acousticroom_train.json'),
    34	        'val_dataset': identity('src/configs/dataset_configs/AR/eval/acousticroom_seeneval.json'),
    35	        'pretransform': identity('weights/FLAC/VAE.safetensors'),
    36	        'recipe': {'entrypoint': 'train.py', 'max_steps': 40000, 'batch_size': 32,
    37	                   'accum_batches': 1, 'num_workers': 6, 'num_gpus': 2, 'gpus': [0, 1],
    38	                   'strategy': 'ddp_find_unused_parameters_true', 'sync_batchnorm': True,
    39	                   'precision': 'bf16-mixed', 'logger': 'none', 'checkpoint_every': 2500,
    40	                   'name': 'FLAC_exp30', 'experiment_name': f'exp30_ACEattn_s{seed}'},
    41	        'code': {p: pair.digest(p) for p in ('train.py', 'src/models/conditioners.py',
    42	                 'src/training/diffusion.py', 'src/training/ace.py', 'src/training/ace_diagnostics.py')},
    43	    }
