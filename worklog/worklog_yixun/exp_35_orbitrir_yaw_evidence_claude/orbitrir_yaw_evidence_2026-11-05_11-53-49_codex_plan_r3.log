    46	def checkpoint_shapes():
    47	    # Attention adds only gates; state_dict has both shared-conditioner aliases.
    48	    schema = read_json(ace.PAIR / 'checkpoint_shapes.json')
    49	    require(schema['baseline_sha256'] == pair.BASELINE_SHA, 'untrusted M shape inventory')
    50	    shapes = dict(schema['M'])
    51	    aliases = 0
    52	    for cond in read_json(ace.config_path())['model']['conditioning']['configs']:
    53	        vit = cond['config'].get('ViT', {})
    54	        if not vit.get('ace'):
    55	            continue
    56	        require(vit.get('ace_mode') == 'attention', 'expected attention config')
    57	        aliases += 1
    58	        prefix = f"diffusion.conditioner.conditioners.{cond['id']}.vit"
    59	        for layer in range(12):
    60	            shapes[f'{prefix}.ace.gammas.{layer}'] = []
    61	    require(aliases == 2, 'expected two shared ViT aliases')
    62	    return shapes, schema['resume']['M'], []
    63	
    64	
    65	def checkpoint(path, arm, seed, *, final=False, resume=False):
    66	    import torch
    67	    torch.set_num_threads(1)
    68	    data = torch.load(path, map_location='cpu', weights_only=False, mmap=True)
    69	    step = data['global_step']
    70	    require(type(step) is int and 0 < step <= 40000, 'invalid global_step')
    71	    require(not final or step == 40000, 'not a final checkpoint')
    72	    require(data.get('model_config') == read_json(ace.config_path()), 'ACE checkpoint config mismatch')
    73	    for metadata in (data, data.get('hyper_parameters', {}), data.get('provenance', {})):
    74	        for key, expected in (('seed', int(seed)), ('train_seed', int(seed)), ('arm', arm)):
    75	            require(key not in metadata or metadata[key] == expected, f'embedded {key} mismatch')
    76	
    77	    def tensor(value, shape, fp32=False):
    78	        require(isinstance(value, torch.Tensor) and list(value.shape) == list(shape)
    79	                and bool(torch.isfinite(value).all()), 'invalid/nonfinite checkpoint tensor')
    80	        require(not fp32 or value.dtype == torch.float32, 'ACE state must be FP32')
    81	
    82	    shapes, base_resume, branch_shapes = checkpoint_shapes()
    83	    state = data['state_dict']
    84	    require(not any('.ace.branches.' in k for k in state), 'attention checkpoint contains branches')
    85	    require(state.keys() == shapes.keys(), 'incomplete/wrong ACE model state')
    86	    for key, shape in shapes.items():
    87	        tensor(state[key], shape, fp32='.ace.gammas.' in key)
    88	    aliases = [[v for k, v in sorted(state.items()) if k.endswith(f'.ace.gammas.{i}')] for i in range(12)]
    89	    require(all(len(v) == 2 and torch.equal(v[0], v[1]) for v in aliases), 'shared gate aliases disagree')
    90	    dual = data['ace']
    91	    cfg = data['model_config']['training']['ace']
    92	    require(dual['version'] == 1 and dual['algorithm'] == 'equality'
    93	            and dual['dual_steps'] == step and dual['dual_lr_ratio'] == cfg['dual_lr_ratio'],
    94	            'incomplete/incompatible ACE dual transaction')
    95	    tensor(dual['lambda'], [12], fp32=True)
    96	    optimizer = dual['dual_optimizer']
    97	    require(len(optimizer['param_groups']) == 1, 'invalid dual optimizer groups')
    98	    group = optimizer['param_groups'][0]
    99	    require(len(group['params']) == 1 and set(optimizer['state']) == set(group['params']),
   100	            'missing dual optimizer state')
   101	    require(tuple(group['betas']) == tuple(cfg['dual_betas']) and group['eps'] == cfg['dual_eps']
   102	            and group['weight_decay'] == 0, 'invalid dual optimizer recipe')
   103	    slot = optimizer['state'][group['params'][0]]
   104	    tensor(slot['step'], [], fp32=True)
   105	    require(float(slot['step']) == step, 'dual optimizer step mismatch')
   106	    for name in ('exp_avg', 'exp_avg_sq'):
   107	        tensor(slot[name], [12], fp32=True)
   108	    if resume:
   109	        require(type(data.get('epoch')) is int and data['epoch'] >= 0, 'missing epoch')
   110	        optimizers = data['optimizer_states']
   111	        require(len(optimizers) == 1, 'missing primal optimizer')
   112	        primal = optimizers[0]
   113	        groups = primal['param_groups']
   114	        require(len(groups) == 2 and groups[1].get('ace_gamma') is True
   115	                and groups[1]['weight_decay'] == 0 and len(groups[1]['params']) == 12
   116	                and len(groups[0]['params']) == len(base_resume['param_groups'][0]),
   117	                'incomplete primal optimizer groups')
   118	        params = [p for g in groups for p in g['params']]
   119	        require(len(params) == len(set(params)) and set(primal['state']) <= set(params),
   120	                'invalid primal optimizer mapping')
   121	        expected = Counter(tuple(s) for s in base_resume['slots'].values())
   122	        expected.update(branch_shapes + [()] * 12)
   123	        actual = Counter()
   124	        for index, slot in primal['state'].items():
   125	            tensor(slot['step'], [])
   126	            require(0 < float(slot['step']) <= step, 'invalid primal optimizer step')
   127	            shape = slot['exp_avg'].shape
   128	            tensor(slot['exp_avg'], shape)
   129	            tensor(slot['exp_avg_sq'], shape)
   130	            if index in groups[1]['params']:
   131	                require(float(slot['step']) == step, 'gamma optimizer step mismatch')
   132	                tensor(slot['exp_avg'], [], fp32=True)
   133	                tensor(slot['exp_avg_sq'], [], fp32=True)
   134	            actual[tuple(shape)] += 1
   135	        require(actual == expected and set(groups[1]['params']) <= set(primal['state']),
   136	                'incomplete primal optimizer slots')
   137	        schedulers = data['lr_schedulers']
   138	        require(len(schedulers) == 1 and schedulers[0]['last_epoch'] == step
   139	                and len(schedulers[0]['base_lrs']) == 2, 'missing/inconsistent scheduler')
   140	        completed = data['loops']['fit_loop']['epoch_loop.automatic_optimization.optim_progress'][
   141	            'optimizer']['step']['total']['completed']
   142	        require(completed == step, 'missing/inconsistent training loop')
   143	        diagnostics = data['ace_diagnostics']
   144	        require(diagnostics['source'] == 'validation' and diagnostics['batch'] is not None,
   145	                'missing fixed seen-eval diagnostic batch')
   146	        require(step < 2500 or diagnostics['prepared'] is not None, 'missing prepared diagnostics')
   147	    return step
   148	
   149	
   150	def select_checkpoints(artifacts, arm, seed, *, final):
   151	    valid = []
   152	    for artifact in artifacts:
   153	        try:
   154	            require(identity(artifact['path']) == artifact, 'checkpoint identity changed')
   155	            step = checkpoint(artifact['path'], arm, seed, final=final, resume=not final)
   156	            # A failed final cannot certify success or provide another 40k update.
   157	            if final or step < 40000:
   158	                valid.append((step, artifact))
   159	        except Exception as exc:
   160	            print(f"REJECT checkpoint {artifact['path']}: {exc}", file=sys.stderr)
   161	    return sorted(valid, key=lambda item: (item[0], item[1]['path']))
