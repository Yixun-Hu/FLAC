   334	def release_reservation(held, h35):
   335	    """Codex C3d HIGH 1: unlink the held file only while it IS the held record, through the inode just authenticated;
   336	    [] once removed, else the reasons -- and nothing is unlinked."""
   337	    out, ident = _held(held, h35)
   338	    if out:
   339	        return out
   340	    try:
   341	        st = os.lstat(held["path"])
   342	        if (st.st_dev, st.st_ino) != ident:
   343	            return [f"{held['path']} was replaced while it was authenticated"]
   344	        os.unlink(held["path"])
   345	    except OSError as err:
   346	        return [f"{held['path']} could not be removed ({err})"]
   347	    _fsync_dir(os.path.dirname(held["path"]))
   348	    return []
