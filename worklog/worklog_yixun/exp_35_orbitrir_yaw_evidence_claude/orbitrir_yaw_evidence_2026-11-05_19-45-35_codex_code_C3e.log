    29	def _stat_identity(text):
    30	    """``(pid, start time)`` from a ``/proc/<pid>/stat`` line: field 1 and field 22 (fields 3.. follow the
    31	    comm, which may hold spaces and parentheses -- hence the LAST ')')."""
