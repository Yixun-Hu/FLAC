   509	class Supervisor:
   510	    """``world``: now / sleep / nvsmi / spawn; ``gates``: verify / e1 / e2 / finalize (the collector's checks)."""
   511	
   512	    def __init__(self, cfg, world, gates):
   513	        self.cfg, self.w, self.g, self.G, self.I = cfg, world, gates, guard_module(), identity_module()
   514	        self.st = self.last = self.note = None
   515	        self.uuids = ()
   516	
   517	    def save(self):
   518	        write_state(self.cfg["state"], self.st)
   519	
   520	    def event(self, what, **kw):
   521	        t = self.w.now()
   522	        self.st["events"].append(dict({"t": t, "time": _iso(t), "what": what}, **kw))
   523	        self.save()
   524	        print(f"[{_iso(t)}] {what} {json.dumps(kw) if kw else ''}", flush=True)
   525	
   526	    def wait_note(self, what, **kw):
   527	        if what != self.note:                       # one event per new reason of waiting
   528	            self.note = what
   529	            self.event(what, **kw)
   530	
   531	    def latch(self, reason):
   532	        if self.st["stop_latch"] is None:
   533	            self.st["stop_latch"] = {"reason": reason, "time": _iso(self.w.now())}
   534	        self.event("STOP LATCH", reason=reason)
   535	
   536	    def observe(self):
   537	        """The guard over his log; its anchor persisted at every observation (§13 NIT 1); None once latched."""
   538	        r = self.G.observe(self.cfg["his_log"], baseline=(self.st["baseline"] or {}).get("step"),
   539	                           anchor=self.st["his_log_anchor"])
   540	        if r["exit"] in (0, 1):
   541	            self.st["his_log_anchor"] = r["anchor"]
   542	            self.save()
   543	        if r["exit"] != 0:
   544	            self.latch(f"the training guard: {r['status']}: {'; '.join(r['reasons'][:3])}")
   545	            return None
   546	        self.last = r
   547	        return r
   548	
   549	    def tables(self):
   550	        m = gpu_map(self.w.nvsmi("map"))
   551	        if len(m) != 2 or GPU1_UUID not in m.values():
   552	            raise ValueError(f"the GPU map {m} is not this box's two cards with {GPU1_UUID}")
   553	        return m, compute_apps(self.w.nvsmi("apps"))
   554	
   555	    def listed_identity(self, pid, uuid):
   556	        """Codex C3d HIGH 2, tri-state for a PID listed on ``uuid``: ``("ok", identity)``; ``("gone", None)`` when its
   557	        identity cannot be read AND the re-queried compute table no longer lists it (it exited between the two
   558	        observations); ``("unreadable", why)`` when it is still listed, or the table cannot be re-read: never approved."""
   559	        try:
   560	            return "ok", self.I.proc_identity(pid, self.cfg["proc"])
   561	        except ValueError as err:
   562	            why = str(err)
   563	        try:
   564	            listed = (pid, uuid) in self.tables()[1]
   565	        except ValueError as err:
   566	            return "unreadable", f"{why}; the compute table could not be re-queried ({err})"
   567	        return ("unreadable", why) if listed else ("gone", None)
   568	
   569	    def trainer_alive(self, approved):
   570	        """True: the approved processes all still run with their frozen identity; False: one is gone or changed; None
   571	        (latched): one is still listed on GPU 1 but its identity cannot be read (Codex C3d HIGH 2)."""
   572	        for p in approved["processes"]:
   573	            got, live = self.listed_identity(p["pid"], GPU1_UUID)
   574	            if got == "unreadable":
   575	                self.latch(f"the approved process {p['pid']} is listed on GPU 1 but its identity is unreadable: {live}")
   576	                return None
   577	            if got == "gone" or any(live[k] != p[k] for k in self.I.FIELDS):
   578	                return False
   579	        return True
   580	
   581	    def authentic(self, where):
   582	        """Codex C3c HIGH 1 / C3d HIGH 1: exactly the held reservation record (or none) is ours on disk -- else the latch."""
   583	        why = reservation_reasons(self.cfg["reservations"], self.st["reservation"], self.uuids, self.cfg["h35"])
   584	        if why:
   585	            self.latch(f"the reservation {where}: " + "; ".join(why))
   586	        return not why
   587	
   588	    def ready(self, chunk):
   589	        """Wait until a lane may take ``chunk``: ``(uuid, index, shared)``, or None after a latch. The held reservation
   590	        is authenticated before every decision (Codex C3d HIGH 1)."""
   591	        while True:
   592	            if self.observe() is None or not self.authentic(f"before chunk {chunk['n']}'s lane decision"):
   593	                return None
   594	            try:
   595	                m, apps = self.tables()
   596	                approved = self.I.load_tuple(self.cfg["approved"], self.cfg["approved_sha256"])
   597	            except ValueError as err:
   598	                self.latch(f"the GPU / identity tables: {err}")
   599	                return None
   600	            idx, lane = {u: i for i, u in m.items()}, self.st["lane"]
   601	            if lane is not None and not lane["shared"]:                 # after the hand-over: GPU 0, never shared
   602	                foreign = sorted(p for p, u in apps if u == lane["uuid"])
   603	                if foreign:
   604	                    self.latch(f"a foreign process on GPU 0 ({lane['uuid']}) before chunk {chunk['n']}: pids {foreign}")
   605	                    return None
   606	                return lane["uuid"], idx[lane["uuid"]], False
   607	            why = self.I.check_reasons([p for p, u in apps if u == GPU1_UUID], GPU1_UUID, approved, self.cfg["proc"])
   608	            alive = self.trainer_alive(approved)
   609	            if alive is None:
   610	                return None
   611	            if not why:
   612	                ok, d = predictor_ok(self.last, now=self.w.now(), chunk=chunk)
   613	                if ok:
   614	                    self.note = None
   615	                    return GPU1_UUID, idx[GPU1_UUID], True
   616	                self.wait_note("predictor: no shared spawn (s43 could end before this chunk does)", chunk=chunk["n"], **d)
   617	            elif alive:
   618	                self.wait_note("no shared spawn: GPU 1 holds more than the approved trainer", why=why[:2])
   619	            else:
   620	                self.wait_note("no shared spawn: the approved trainer is gone; hand-over to GPU 0", why=why[:2])
   621	            if not alive and self.handover(m, apps):
   622	                continue
   623	            if self.st["stop_latch"] is not None:
   624	                return None
   625	            self.w.sleep(WAIT_POLL_S)
   626	
   627	    def handover(self, m, apps):
   628	        """§12 B1.4: GPU 0 free on two checks 60 s apart -> its O_EXCL reservation -> the state (epoch + 1) -> the
   629	        GPU 1 file removed. The held record is authenticated before and after the gap, right before the commit and
   630	        right before the removal; a mismatch latches and unlinks nothing (Codex C3d HIGH 1). False: not now, or latched."""
   631	        uuid0 = next(u for u in m.values() if u != GPU1_UUID)
   632	        for check in ("1st", "2nd"):
   633	            if not self.authentic(f"at the hand-over's {check} check"):
   634	                return False
   635	            busy = sorted(p for p, u in apps if u == uuid0)
   636	            if busy:
   637	                self.wait_note("hand-over waits: GPU 0 busy", pids=busy)
   638	                return False
   639	            self.event(f"GPU 0 free ({check} check)")
   640	            if check == "1st":
   641	                self.w.sleep(HANDOVER_GAP_S)
   642	                try:
   643	                    apps = self.tables()[1]
   644	                except ValueError as err:
   645	                    self.latch(f"the GPU tables during the hand-over: {err}")
   646	                    return False
   647	        old = self.st["reservation"]
   648	        epoch = (old["epoch"] if old else 0) + 1
   649	        try:
   650	            path, sha = create_reservation(self.cfg["reservations"], uuid0, epoch=epoch, h35=self.cfg["h35"],
   651	                                           now=self.w.now())
   652	        except FileExistsError:
   653	            self.wait_note("hand-over waits: GPU 0 is reserved by another holder")
   654	            return False
   655	        new = {"uuid": uuid0, "epoch": epoch, "path": path, "sha256": sha}
   656	        why = [x for r in (old, new) if r for x in held_reasons(r, self.cfg["h35"])]
   657	        if why:
   658	            self.latch("the reservations right before the hand-over's commit (nothing unlinked): " + "; ".join(why))
   659	            return False
   660	        self.st.update(lane={"uuid": uuid0, "shared": False}, reservation=new)
   661	        self.save()
   662	        why = release_reservation(old, self.cfg["h35"]) if old else []
   663	        if why:
   664	            self.latch("the GPU 1 reservation right before its removal at the hand-over (nothing unlinked): "
   665	                       + "; ".join(why))
   666	            return False
   667	        self.event("hand-over to GPU 0", epoch=epoch)
   668	        return True
   669	
   670	    def execute(self, c, lane):
   671	        uuid, index, shared = lane
   672	        if self.st["reservation"] is None:
   673	            try:
   674	                path, sha = create_reservation(self.cfg["reservations"], uuid, epoch=1, h35=self.cfg["h35"],
   675	                                               now=self.w.now())
   676	            except FileExistsError:
   677	                self.latch(f"{uuid} is reserved by another holder at our first spawn")
   678	                return
   679	            self.st.update(reservation={"uuid": uuid, "epoch": 1, "path": path, "sha256": sha},
   680	                           lane={"uuid": uuid, "shared": shared})
   681	        ts = time.strftime("%Y-%m-%d_%H-%M-%S", time.localtime(self.w.now()))
   682	        if c["kind"] == "probe":
   683	            (argv, env), log = probe_command(index), os.path.join(self.cfg["logdir"], f"orbitrir_bf_cond_probe_{ts}.log")
   684	        else:
   685	            (argv, env), log = runner_command(self.cfg, c, index, shared), os.path.join(
   686	                self.cfg["logdir"], f"exp35_supervisor_{ts}_chunk{c['n']:02d}_{c['cell']}.log")
   687	        if not self.authentic(f"before chunk {c['n']}"):          # re-authenticated before every spawn (C3c HIGH 1)
   688	            return
   689	        first = self.st["baseline"] is None
   690	        if first:                                                       # §11 B2: our first spawn
   691	            r = self.last
   692	            self.st["baseline"] = {"time": self.w.now(), "step": r["step"]["global"], "log": {
   693	                "path": self.cfg["his_log"], "inode": r["log"]["inode"], "size": r["log"]["size"]}}
   694	        c.update(state="in_flight", lane=uuid, shared=shared, started=_iso(self.w.now()), log=log)
   695	        self.save()
   696	        why = reservation_reasons(self.cfg["reservations"], self.st["reservation"], self.uuids, self.cfg["h35"])
   697	        if why:                                  # ... and as the LAST step before it (Codex C3d HIGH 1): not spawned
   698	            for k in CHUNK_FLIGHT:
   699	                del c[k]
   700	            c["state"] = "planned"
   701	            self.st["baseline"] = None if first else self.st["baseline"]
   702	            self.latch(f"the reservation after chunk {c['n']}'s in-flight save (chunk {c['n']} NOT spawned): "
   703	                       + "; ".join(why))
   704	            return
   705	        rc = self.watch(self.w.spawn(argv, env, log), c, uuid, shared)
   706	        c.update({"ended": _iso(self.w.now()), "probe_rc" if c["kind"] == "probe" else "runner_rc": rc})
   707	        self.save()
   708	        if rc != 0:
   709	            self.latch(f"chunk {c['n']} ({c['cell'] or 'the probe'}) exited rc {rc}")
   710	            return
   711	        self.verified(c)
