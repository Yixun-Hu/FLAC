   501	    assert st["chunks"][4]["state"] == "gates_verified" and {k: st["chunks"][4][k] for k in keys} == {k: c5[k] for k in keys}
   502	    assert {p: open(p, "rb").read() for p in probe} == probe                     # the finalized probe untouched
   503	    assert len(w.spawned) == N_CHUNKS - 5 and not any("--arm" in r["argv"] for r in w.spawned)   # never re-run
