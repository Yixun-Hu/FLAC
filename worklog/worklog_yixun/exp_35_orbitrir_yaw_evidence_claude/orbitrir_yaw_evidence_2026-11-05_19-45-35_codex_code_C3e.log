   313	def _held(held, h35):
   314	    """``(reasons, (device, inode))`` of the file at ``held["path"]`` against the held record: the sha256 of its bytes,
   315	    then field by field this campaign's reservation of ``held["uuid"]`` at ``held["epoch"]``."""
   316	    try:
   317	        with open(held["path"], "rb") as f:
   318	            raw, st = f.read(), os.fstat(f.fileno())
   319	        doc = json.loads(raw)
   320	    except (OSError, ValueError) as err:
   321	        return [f"the held reservation {held['path']} is gone, unreadable or malformed ({err})"], None
   322	    out = [] if hashlib.sha256(raw).hexdigest() == held.get("sha256") else [f"{held['path']} is not the held record"]
   323	    out += ours_reasons(doc, held["uuid"], h35) if isinstance(doc, dict) else [f"{held['path']} is no reservation"]
   324	    if not out and doc["epoch"] != held["epoch"]:
   325	        out.append(f"{held['path']} has epoch {doc['epoch']}, the held record {held['epoch']}")
   326	    return out, (st.st_dev, st.st_ino)
   327	
