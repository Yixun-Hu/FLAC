   495	    probe = {p: open(p, "rb").read() for p in (cfg["probe_json"], cfg["probe_json"] + ".sha256")}
   496	    g2 = FakeGates()
   497	    g2.probe_json = cfg["probe_json"]
   498	    assert sup(w, g2, cfg).run() == 0
   499	    st = state(cfg)
