   120	HEX64, GPU_RE = re.compile(r"[0-9a-f]{64}"), re.compile(r"GPU-[0-9A-Za-z-]+")
   121	CHUNK_BASE, CHUNK_FLIGHT = ("n", "kind", "cell", "gate", "state"), ("lane", "shared", "started", "log")
   122	GATE_KEYS = {"E1": ("e1",), "E2": ("e2",), "PROBE": ("probe_contract", "probe_json_sha256", "sidecar_sha256", "log_sha256"),
   123	             None: ()}
   124	VERDICTS = {"E1": ({0: "equal", 1: "mismatch"}, "refused", (0,)), "E2": ({0: "PASS", 1: "FAIL"}, "REFUSED", (0, 1))}
