    94	        raise ValueError(f"the approved tuple {path} hashes to {got}, the launch entry pins {sha256}")
    95	    try:
    96	        doc = json.loads(raw)
    97	    except ValueError as err:
    98	        raise ValueError(f"the approved tuple {path} is unreadable ({err})") from err
