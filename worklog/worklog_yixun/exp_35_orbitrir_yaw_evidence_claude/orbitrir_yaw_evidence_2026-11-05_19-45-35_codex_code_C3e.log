   428	def descendants(pid, proc="/proc"):
   429	    """``pid`` and every process below it (by the ppid of ``/proc/<p>/stat``): our runner's own subtree."""
   430	    parent = {}
   431	    for name in os.listdir(proc):
   432	        if name.isdigit():
   433	            try:
   434	                with open(os.path.join(proc, name, "stat")) as f:
   435	                    text = f.read()
   436	                parent[int(name)] = int(text[text.rindex(")") + 2:].split()[1])
   437	            except (OSError, ValueError, IndexError):
   438	                continue
   439	    out, todo = set(), [pid] if pid in parent else []
   440	    while todo:
   441	        p = todo.pop()
   442	        out.add(p)
   443	        todo += [c for c, pp in parent.items() if pp == p and c not in out]
   444	    return out
