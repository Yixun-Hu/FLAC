   502	def probe_command(index):
   503	    """§12 B3: chunk 5 -- the launcher directly on the probe with the frozen argv, the overlay ONLY on PYTHONPATH."""
   504	    env = _env(CUDA_VISIBLE_DEVICES=str(index), HF_HUB_OFFLINE="1", PYTHONDONTWRITEBYTECODE="1",
   505	               PYTHONPATH=os.path.join(REPO, NO_FLASH_DIR))
   506	    return [PY, LAUNCHER, PROBE, "--arm", "BF", "--ckpt-path", BF_FARM_LINK], env
