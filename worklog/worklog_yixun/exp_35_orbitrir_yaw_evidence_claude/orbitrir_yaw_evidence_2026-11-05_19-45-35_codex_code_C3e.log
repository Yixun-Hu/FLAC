   351	def read_reservation(dirpath, uuid):
   352	    """The reservation file of ``uuid`` parsed: None when absent; ``ValueError`` when unreadable or malformed."""
   353	    try:
   354	        with open(reservation_path(dirpath, uuid)) as f:
   355	            doc = json.load(f)
   356	    except FileNotFoundError:
   357	        return None
   358	    except (OSError, ValueError) as err:
   359	        raise ValueError(f"the reservation file of {uuid} is unreadable or malformed ({err})") from err
   360	    if not isinstance(doc, dict) or not isinstance(doc.get("holder"), str):
   361	        raise ValueError(f"the reservation file of {uuid} is not a reservation ({doc!r:.120})")
   362	    return doc
