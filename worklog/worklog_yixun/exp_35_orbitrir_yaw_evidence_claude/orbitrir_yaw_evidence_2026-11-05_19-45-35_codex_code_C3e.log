   477	def _iso(t):
   478	    return datetime.datetime.fromtimestamp(t).astimezone().isoformat(timespec="seconds")
   479	
   480	
   481	def _sha_file(path):
   482	    try:
   483	        with open(path, "rb") as f:
   484	            return hashlib.sha256(f.read()).hexdigest()
   485	    except OSError:
   486	        return None
