   443	def test_the_trainer_exiting_between_two_observations_while_a_cell_runs_is_no_stop(tmp_path):
   444	    """Listed at a poll, its /proc entry already gone, absent from the re-queried table: it exited -- no latch, the
   445	    hand-over follows. A regression guard: green before and after the fix."""
   446	    w, g, cfg = make(tmp_path)
   447	    w.behaviour = lambda argv: (3, 0)
   448	    real, gone = w.nvsmi, {}
   449	
   450	    def leave(world):
   451	        world.apps.remove((TR0, G0))
   452	        shutil.rmtree(world.procdir / str(TR0))
   453	        shutil.rmtree(world.procdir / str(TR1))                                 # rank 1 still listed ...
   454	        gone["apps"] = 0
   455	
   456	    def nvsmi(query):
   457	        if query == "apps" and "apps" in gone:
   458	            gone["apps"] += 1
   459	            if gone["apps"] == 2 and (TR1, G1) in w.apps:                       # ... until the re-query
   460	                w.apps.remove((TR1, G1))
   461	        return real(query)
