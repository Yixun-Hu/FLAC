   573	    g.probe_json = cfg["probe_json"]
   574	    assert sup(w, g, cfg).run() == 0 and len(g.held) == 32 and all(g.held)
   575	    os.close(_hold(cfg["state"] + ".lock"))                                     # free again after the run
