   197	def _consistent(r):
   198	    """Recompute every summary, the pooled block, the control and the verdict from the (edited) item vectors with
   199	    the probe's own functions: a forgery that is internally consistent (Codex C3a BLOCKING 1)."""
   200	    import numpy as np
   201	    pr = TP.probe
   202	    for blocks in [r["results"][p] for p in r["results"]] + [{"det": r["determinism"][p]} for p in r["determinism"]]:
   203	        for blk in blocks.values():
   204	            for node in list(blk["cond"]["per_id"].values()) + [blk["cond"]["all"]] + [blk[s] for s in pr.STAGES[1:]]:
   205	                node["summary"] = pr.summarize({m: np.array(node[m]) for m in ("relL2", "relLinf")})
   206	    keys = list(r["results"]["eval"])
   207	    r["pooled"] = {p: pr._pooled(r["results"][p], keys) for p in r["results"]}
   208	    r["control_p99"] = {p: dict({k: r["results"][p][k]["waveform"]["summary"]["relL2"]["p99"] for k in keys},
