   468	# --------------------------------------------------------------------------- #
   469	# Codex C3d HIGH 3: a restart after the probe's finalization, before chunk 5's final guard
   470	# --------------------------------------------------------------------------- #
   471	def _die_before_the_probe_final_guard(tmp_path, monkeypatch):
   472	    """Runs until the probe's finalization + ledger are persisted, then the supervisor dies before chunk 5's final
   473	    guard; returns the world, the config and chunk 5 as persisted."""
   474	    w, g, cfg = make(tmp_path)
   475	    real = S.Supervisor.observe
   476	
   477	    def observe(self):
   478	        c5 = self.st["chunks"][4]
   479	        if c5["state"] == "runner_verified" and "probe_contract" in c5:
   480	            raise KeyboardInterrupt("the supervisor dies before chunk 5's final guard")
   481	        return real(self)
   482	    monkeypatch.setattr(S.Supervisor, "observe", observe)
   483	    with pytest.raises(KeyboardInterrupt):
   484	        sup(w, g, cfg).run()
   485	    monkeypatch.setattr(S.Supervisor, "observe", real)
   486	    c5 = state(cfg)["chunks"][4]
   487	    assert c5["state"] == "runner_verified" and c5["probe_contract"]["rc"] == 0 and "final_guard" not in c5
   488	    assert ("finalize", os.path.relpath(c5["log"], S.REPO), "d" * 64) in g.calls and len(w.spawned) == 5
   489	    w.spawned.clear()
   490	    return w, cfg, c5
