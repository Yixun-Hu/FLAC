   365	def ours_reasons(doc, uuid, h35):
   366	    """[] iff ``doc`` is exactly THIS campaign's exp_35 reservation of ``uuid`` (Codex C3b HIGH 2)."""
   367	    ok = list(doc) == list(RES_KEYS) and doc["holder"] == "exp35" and doc["h35"] == h35 and doc["gpu_uuid"] == uuid \
   368	        and doc["branch"] == BRANCH and type(doc["epoch"]) is int and doc["epoch"] >= 1 and _num(doc["created"])
   369	    return [] if ok else [f"the exp_35 reservation of {uuid} is not this campaign's: {doc!r:.200}"]
