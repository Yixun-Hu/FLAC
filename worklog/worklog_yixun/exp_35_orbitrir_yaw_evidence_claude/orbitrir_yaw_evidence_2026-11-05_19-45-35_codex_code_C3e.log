   493	def runner_command(cfg, chunk, index, shared):
   494	    """The runner on ONE cell; GPU_MAX_POLLS=1 so it never waits silently; the tuple only on the shared GPU 1."""
   495	    env = _env(EXPECT_HEAD=cfg["h35"], GPU_MAX_POLLS="1", GPU_POLL_SECONDS="0")
   496	    if shared:
   497	        env.update(ALLOW_SHARED_GPU="1", EXP35_APPROVED_COTENANTS=cfg["approved"],
   498	                   EXP35_APPROVED_COTENANTS_SHA256=cfg["approved_sha256"])
   499	    return ["bash", RUNNER, "--lanes", str(index), "--only", chunk["cell"]], env
