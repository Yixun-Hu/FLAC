   534	@pytest.mark.parametrize("with_state", [False, True])
   535	def test_a_second_supervisor_is_refused_while_one_holds_the_lock(tmp_path, capsys, with_state):
   536	    w, g, cfg = make(tmp_path)
   537	    if with_state:
   538	        S.write_state(cfg["state"], S.new_state(h35=cfg["h35"], cells_sha256=cfg["cells_sha256"],
   539	                                                supervisor_sha256=cfg["supervisor_sha256"],
   540	                                                approved_sha256=cfg["approved_sha256"]))
   541	    before = open(cfg["state"], "rb").read() if with_state else None
   542	    fd = _hold(cfg["state"] + ".lock")                                          # the running supervisor
   543	    try:
   544	        assert sup(w, g, cfg).run() == 3
   545	        assert f"SUPERVISOR REFUSED: another supervisor holds {cfg['state']}.lock" in capsys.readouterr().out
   546	        assert (open(cfg["state"], "rb").read() if os.path.exists(cfg["state"]) else None) == before   # untouched
   547	        assert w.spawned == [] and list(w.res.iterdir()) == [] and g.calls == []
   548	    finally:
   549	        os.close(fd)
   550	    assert sup(w, g, cfg).run() == 0                                            # once it is gone
