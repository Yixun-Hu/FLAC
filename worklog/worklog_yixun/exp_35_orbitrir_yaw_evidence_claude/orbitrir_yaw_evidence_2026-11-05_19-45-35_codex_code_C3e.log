   105	def check_reasons(observed_pids, gpu_uuid, approved, proc="/proc"):
   106	    """[] iff the foreign compute processes observed on ``gpu_uuid`` are EXACTLY the approved tuple's,
   107	    each with its identity unchanged (a reused PID has another start time / cmdline / cwd / log)."""
   108	    out = [] if gpu_uuid == approved["gpu_uuid"] else [
   109	        f"the lane is {gpu_uuid}, the approved tuple names {approved['gpu_uuid']}"]
   110	    want, got = sorted(p["pid"] for p in approved["processes"]), sorted(set(observed_pids))
   111	    if got != want or len(got) != len(observed_pids):
   112	        out.append(f"the foreign compute processes on {gpu_uuid} are {sorted(observed_pids)}, the approved tuple "
   113	                   f"{want} (an extra, missing or replaced process)")
   114	    for p in approved["processes"]:
   115	        try:
   116	            live = proc_identity(p["pid"], proc)
   117	        except ValueError as err:
   118	            out.append(str(err))
   119	            continue
