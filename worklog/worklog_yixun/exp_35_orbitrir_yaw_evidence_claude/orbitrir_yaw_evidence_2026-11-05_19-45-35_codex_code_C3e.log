    84	def load_tuple(path, sha256=None):
    85	    """The approved tuple at ``path``; ``ValueError`` when it is unreadable or malformed, or (Codex C2
    86	    BLOCKING 1) when the bytes read -- ONCE, then parsed -- do not hash to the launch entry's ``sha256``."""
