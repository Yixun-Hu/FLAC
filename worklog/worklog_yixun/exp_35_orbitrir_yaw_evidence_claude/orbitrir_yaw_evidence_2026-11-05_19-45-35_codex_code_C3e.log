   713	    def watch(self, proc, c, uuid, shared):
   714	        """Poll the running chunk, NEVER signalling it: the guard and the lane's process set every <= 5 min."""
   715	        try:
   716	            approved = {p["pid"]: p for p in self.I.load_tuple(self.cfg["approved"], self.cfg["approved_sha256"])[
   717	                "processes"]} if shared else {}
   718	        except ValueError as err:                      # still never signalled: watch it to its end, then stop
   719	            self.latch(f"the approved tuple while chunk {c['n']} ran: {err}")
   720	            approved = {}
   721	        while proc.poll() is None:
   722	            self.w.sleep(GUARD_POLL_S)
   723	            if self.st["stop_latch"] is not None:
   724	                continue
   725	            self.observe()
   726	            try:
   727	                apps = self.tables()[1]
   728	            except ValueError as err:
   729	                self.latch(f"the GPU tables while chunk {c['n']} ran: {err}")
   730	                continue
   731	            if not self.authentic(f"while chunk {c['n']} ran"):            # ... and at every poll (C3c HIGH 1)
   732	                continue
   733	            ours = descendants(proc.pid, self.cfg["proc"])
   734	            bad = [x for x in (self.foreign(p, uuid, approved) for p, u in apps if u == uuid and p not in ours) if x]
   735	            if bad and self.st["stop_latch"] is None:     # every foreign process vs the COMPLETE identity (C3c HIGH 3)
   736	                self.latch(f"a new process, or a process with another or an unreadable identity, on "
   737	                           f"{'GPU 1' if shared else 'GPU 0'} ({uuid}) while chunk {c['n']} ran: pids {bad}")
   738	        return proc.returncode
   739	
   740	    def foreign(self, p, uuid, approved):
   741	        """Why ``p`` -- listed on our lane, not ours -- is not an approved process with its complete identity, or None:
   742	        not approved, another identity, or still listed with an unreadable one (Codex C3d HIGH 2; gone: None)."""
   743	        if p not in approved:
   744	            return f"{p} (not approved)"
   745	        got, live = self.listed_identity(p, uuid)
   746	        if got == "unreadable":
   747	            return f"{p} (listed, its identity unreadable: {live})"
   748	        return f"{p} (another identity)" if got == "ok" and any(live[k] != approved[p][k] for k in self.I.FIELDS) else None
   749	
   750	    def probe_ledger_reasons(self, c, j, rel, digest):
   751	        """Codex C3c HIGH 4: the three files hashed, the sidecar sealing the JSON, the JSON's launch record naming THIS
   752	        log, its sha256 and the campaign digest."""
   753	        out = [f"{k} absent" for k in ("probe_json_sha256", "sidecar_sha256", "log_sha256") if not _hex(c[k])]
   754	        if out:
   755	            return out
   756	        try:
   757	            with open(j + ".sha256") as f:
   758	                side = f.read()
   759	            with open(j) as f:
   760	                launch = json.load(f)["provenance"]["launch"]
   761	        except (OSError, ValueError, KeyError, TypeError) as err:
   762	            return [f"the finalized probe JSON is unreadable ({err})"]
   763	        if side != f"{c['probe_json_sha256']}  {os.path.basename(j)}\n":
   764	            out.append("the sidecar does not seal the probe JSON")
   765	        if not (isinstance(launch, dict) and launch.get("log_path") == rel and launch.get("log_sha256") == c["log_sha256"]
   766	                and launch.get("campaign_digest") == digest):
   767	            out.append("the probe's launch record does not name this log, its sha256 and the campaign digest")
   768	        return out
   769	
   770	    def campaign_digest(self):
   771	        return next((c["campaign_digest"] for c in self.st["chunks"] if c.get("campaign_digest")), None)
   772	
   773	    def verified(self, c, adopted=False):
   774	        """-> runner_verified (a cell: its receipt verified under the campaign's ONE digest), then its gates."""
   775	        if c["kind"] == "cell":
   776	            ok, info = self.g.verify(c)
   777	            digest = self.campaign_digest()
   778	            if not ok or (digest is not None and info["campaign_digest"] != digest):
   779	                self.latch(f"chunk {c['n']} {c['cell']}: verification refused: {info}")
   780	                return
   781	            c.update(receipt_sha256=info["receipt_sha256"], campaign_digest=info["campaign_digest"])
   782	        c.update(state="runner_verified", **({"adopted_at_restart": True} if adopted else {}))
   783	        self.save()
   784	        if self.st["stop_latch"] is None:
   785	            self.gates(c)
   786	
   787	    def gates(self, c):
   788	        """E1 after chunks 1-2 (a mismatch: a hard stop), E2 after chunk 4 (the 45-degree source only), the probe's
   789	        finalization + PROBE_CONTRACT_BF after chunk 5 (§13 NIT 2 ledger), and the final guard on every chunk."""
   790	        if c["gate"] == "E1":
   791	            k = 1 if "_K1_" in c["cell"] else 8
   792	            rc, out = self.g.e1(k)
   793	            c["e1"] = {"rc": rc, "verdict": {0: "equal", 1: "mismatch"}.get(rc, "refused"), "out": out[-2000:]}
   794	            bad = rc != 0 and f"E1 K{k} {c['e1']['verdict']}: the control cell is not the exp_25 cell (a hard stop)"
   795	        elif c["gate"] == "E2":
   796	            rc, out = self.g.e2()
   797	            c["e2"] = {"rc": rc, "verdict": {0: "PASS", 1: "FAIL"}.get(rc, "REFUSED"), "out": out[-2000:]}
   798	            bad = rc not in (0, 1) and "E2 refused"
   799	        elif c["gate"] == "PROBE":
   800	            rel, digest = os.path.relpath(c["log"], REPO), self.campaign_digest()
   801	            prior = {k: c[k] for k in GATE_KEYS["PROBE"][1:] if k in c}    # a restart after the finalization (C3d HIGH 3)
   802	            rc, out = self.g.finalize(rel, digest)                         # idempotent only on the identical record
   803	            j = self.cfg.get("probe_json") or os.path.join(HERE, "orbitrir_bf_cond_probe.json")
   804	            c.update(probe_contract={"rc": rc, "out": out[-2000:]}, probe_json_sha256=_sha_file(j),
   805	                     sidecar_sha256=_sha_file(j + ".sha256"), log_sha256=_sha_file(c["log"]))
   806	            why = self.probe_ledger_reasons(c, j, rel, digest) if rc == 0 else []
   807	            why += [f"{k} changed since the ledger recorded it" for k, v in prior.items() if c[k] != v]
   808	            bad = (rc != 0 and "the B-F probe: finalization / PROBE_CONTRACT_BF refused") or (
   809	                why and "the B-F probe's ledger: " + "; ".join(why))
   810	        else:
   811	            bad = False
   812	        self.save()
   813	        if bad:
   814	            self.latch(bad)
   815	            return
   816	        g = self.observe()                            # the final guard, kept as this chunk's evidence (C3c BLOCKING 1)
   817	        if g is not None:
   818	            c.update(final_guard={"status": g["status"], "exit": g["exit"], "t": self.w.now(), "time": _iso(self.w.now()),
   819	                                  "step": g["step"]["global"], "anchor": g["anchor"]}, state="gates_verified")
   820	            self.save()
   821	
   822	    def reconcile(self):
   823	        """§12 B2: in flight -> its receipt must verify (then its gates), else the latch; runner_verified -> its gates."""
   824	        for c in self.st["chunks"]:
   825	            if c["state"] == "in_flight":
   826	                if c["kind"] == "cell" and self.g.verify(c)[0]:
   827	                    self.event("reconcile: the in-flight chunk's receipt verifies; its gates re-run", chunk=c["n"])
   828	                    c.update(ended=None, runner_rc=None)               # unknown: the supervisor was not there
   829	                    return self.verified(c, adopted=True)
   830	                return self.latch(f"chunk {c['n']} was in flight when the supervisor stopped and has no verified receipt")
   831	            if c["state"] == "runner_verified":
   832	                self.event("reconcile: re-running the gates", chunk=c["n"])
   833	                return self.gates(c)
   834	
   835	    def run(self):
   836	        """0: phase (i) complete; 3: refused or stopped (the latch names why). ONE supervisor at a time (Planner P1): an
   837	        exclusive lock next to the state, taken before the state is read and held until the run ends."""
   838	        lock = self.cfg["state"] + ".lock"
   839	        fd = os.open(lock, os.O_RDWR | os.O_CREAT, 0o644)
   840	        try:
   841	            try:
   842	                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
   843	            except BlockingIOError:
   844	                print(f"SUPERVISOR REFUSED: another supervisor holds {lock}")
   845	                return 3
   846	            return self._run()
   847	        finally:
   848	            os.close(fd)
   849	
   850	    def _run(self):
   851	        c = self.cfg
   852	        try:
   853	            st = load_state(c["state"], h35=c["h35"], cells_sha256=c["cells_sha256"], supervisor_sha256=c["supervisor_sha256"],
