   525	# --------------------------------------------------------------------------- #
   526	# Planner P1: one supervisor at a time -- an exclusive lock next to the state, taken before the state is read
   527	# --------------------------------------------------------------------------- #
   528	def _hold(path):
   529	    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
   530	    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
   531	    return fd
   532	
