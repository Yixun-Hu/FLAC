    99	def write_state(path, doc):
   100	    """Atomic: a temp file in the same directory, fsync, rename over the state, fsync the directory (§13 NIT 1)."""
   101	    d = os.path.dirname(os.path.abspath(path))
   102	    fd, tmp = tempfile.mkstemp(prefix=".exp35_state.", dir=d)
   103	    try:
   104	        with os.fdopen(fd, "w") as f:
   105	            json.dump(doc, f, indent=1)
   106	            f.flush()
   107	            os.fsync(f.fileno())
   108	        os.replace(tmp, path)
   109	    except BaseException:
   110	        if os.path.exists(tmp):
   111	            os.unlink(tmp)
   112	        raise
   113	    dfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
   114	    try:
   115	        os.fsync(dfd)
   116	    finally:
   117	        os.close(dfd)
