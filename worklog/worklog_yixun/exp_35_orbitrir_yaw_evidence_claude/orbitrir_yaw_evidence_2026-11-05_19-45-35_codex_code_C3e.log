   295	def create_reservation(dirpath, uuid, *, epoch, h35, now):
   296	    """§12 B1.4: O_CREAT | O_EXCL, never overwritten (``FileExistsError`` when the file exists). Returns the path and the
   297	    sha256 of the exact bytes written -- the held record the state keeps (Codex C3d HIGH 1)."""
   298	    path = reservation_path(dirpath, uuid)
   299	    raw = json.dumps({"holder": "exp35", "h35": h35, "gpu_uuid": uuid, "epoch": epoch, "created": now,
   300	                      "branch": BRANCH}).encode()
   301	    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
   302	    with os.fdopen(fd, "wb") as f:
   303	        f.write(raw)
   304	        f.flush()
   305	        os.fsync(f.fileno())
   306	    _fsync_dir(dirpath)
   307	    return path, hashlib.sha256(raw).hexdigest()
