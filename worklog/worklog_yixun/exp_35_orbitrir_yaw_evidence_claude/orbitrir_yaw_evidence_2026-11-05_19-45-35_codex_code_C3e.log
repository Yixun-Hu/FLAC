   461	def _module(name):
   462	    if name not in _MODULES:
   463	        spec = importlib.util.spec_from_file_location(name, os.path.join(HERE, name + ".py"))
   464	        _MODULES[name] = importlib.util.module_from_spec(spec)
   465	        spec.loader.exec_module(_MODULES[name])
   466	    return _MODULES[name]
   467	
