   205	def _top_reasons(doc, his_log, reservations):
   206	    """baseline (on THE configured log), the guard anchor, lane + reservation (in THE configured directory), the latch,
   207	    the events -- exact (Codex C3b BLOCKING 1, C3c BLOCKING 1)."""
   208	    b, lane, res, latch = doc["baseline"], doc["lane"], doc["reservation"], doc["stop_latch"]
   209	    out = [] if b is None or (isinstance(b, dict) and list(b) == ["time", "step", "log"] and _num(b["time"])
   210	                              and type(b["step"]) is int and b["step"] >= 0 and isinstance(b["log"], dict)
   211	                              and list(b["log"]) == ["path", "inode", "size"] and b["log"]["path"] == his_log
   212	                              and type(b["log"]["inode"]) is int and b["log"]["inode"] >= 0
   213	                              and type(b["log"]["size"]) is int and b["log"]["size"] >= 0) else [
   214	        f"a malformed baseline, or one on another log than {his_log}: {b!r:.160}"]
   215	    out += guard_module().anchor_schema_reasons(doc["his_log_anchor"])
   216	    if (lane is None) != (res is None):
   217	        out.append("the lane and the reservation must be set together")
   218	    elif lane is not None and not (
   219	            isinstance(lane, dict) and list(lane) == ["uuid", "shared"] and isinstance(lane["uuid"], str)
   220	            and GPU_RE.fullmatch(lane["uuid"]) and type(lane["shared"]) is bool and lane["shared"] == (lane["uuid"] == GPU1_UUID)
   221	            and isinstance(res, dict) and list(res) == ["uuid", "epoch", "path", "sha256"] and res["uuid"] == lane["uuid"]
   222	            and type(res["epoch"]) is int and res["epoch"] >= 1 and res["path"] == reservation_path(reservations, res["uuid"])
   223	            and _hex(res["sha256"])):
   224	        out.append(f"the lane {lane!r} and the reservation {res!r} do not agree")
   225	    if latch is not None and not (isinstance(latch, dict) and list(latch) == ["reason", "time"]
   226	                                  and _text(latch["reason"]) and _text(latch["time"])):
   227	        out.append(f"a malformed stop latch {latch!r:.120}")
   228	    if not (isinstance(doc["events"], list) and all(isinstance(e, dict) and _num(e.get("t")) and _text(e.get("time"))
   229	                                                    and _text(e.get("what")) for e in doc["events"])):
   230	        out.append("malformed events")
   231	    return out
