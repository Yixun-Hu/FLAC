   234	def state_reasons(doc, *, h35, cells_sha256, supervisor_sha256, approved_sha256, his_log, reservations):
   235	    if not isinstance(doc, dict) or list(doc) != list(STATE_KEYS):
   236	        return [f"the state's keys are not {list(STATE_KEYS)}"]
   237	    out = [f"{k}: {doc[k]!r} != {want!r}" for k, want in (
   238	        ("schema_version", STATE_SCHEMA), ("campaign", "exp35"), ("h35", h35), ("cells_sha256", cells_sha256),
   239	        ("supervisor_sha256", supervisor_sha256), ("approved_sha256", approved_sha256)) if doc[k] != want]
   240	    plan = [(c["n"], c["kind"], c["cell"], c["gate"]) for c in chunk_plan()]
   241	    if not isinstance(doc["chunks"], list) or not all(isinstance(c, dict) for c in doc["chunks"]) or [
   242	            (c.get("n"), c.get("kind"), c.get("cell"), c.get("gate")) for c in doc["chunks"]] != plan:
   243	        return out + ["the state's chunks are not the frozen 33-chunk order"]
   244	    states = [c.get("state") for c in doc["chunks"]]
   245	    out += [f"chunk {i + 1}: unknown state {s!r}" for i, s in enumerate(states) if s not in CHUNK_STATES]
   246	    if out:
   247	        return out
   248	    done = 0
   249	    while done < len(states) and states[done] == "gates_verified":
   250	        done += 1
   251	    if any(s != "planned" for s in states[done + 1:]):
   252	        out.append(f"chunk order violated: {states[:done + 3]}... (only the first unfinished chunk may be started)")
   253	    latched = doc["stop_latch"] is not None
   254	    out += [x for c in doc["chunks"] for x in _chunk_reasons(c, latched)] + _top_reasons(doc, his_log, reservations)
   255	    digests = {c["campaign_digest"] for c in doc["chunks"] if "campaign_digest" in c}
   256	    out += [f"the chunks carry {len(digests)} campaign digests"] if len(digests) > 1 else []
   257	    started = any(s != "planned" for s in states)
   258	    if started != (doc["baseline"] is not None):
   259	        out.append("a baseline exactly when a chunk has started")
   260	    if started and done < len(states) and doc["reservation"] is None:
   261	        out.append("a started, unfinished campaign holds no reservation")
   262	    return out
