   553	class ProbeTheLock(FakeGates):
   554	    def __init__(self, lock):
   555	        super().__init__()
   556	        self.lock, self.held = lock, []
   557	
   558	    def verify(self, chunk):
   559	        fd = os.open(self.lock, os.O_RDONLY)
   560	        try:
   561	            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
   562	            self.held.append(False)
   563	        except BlockingIOError:
   564	            self.held.append(True)
   565	        finally:
   566	            os.close(fd)
   567	        return super().verify(chunk)
   568	
   569	
   570	def test_the_lock_is_held_for_the_whole_run_and_released_at_its_end(tmp_path):
