    35	def proc_identity(pid, proc="/proc"):
    36	    """The identity of a LIVE process from ``proc``; ``ValueError`` when it is gone or unreadable, or when
    37	    its entry changed during the sample (Codex C2 HIGH 1): every field is read through ONE directory fd of
    38	    ``/proc/<pid>`` (bound to that process, dead or alive), between two stat reads that must agree."""
    39	    pid = int(pid)
    40	    try:
    41	        fd = os.open(os.path.join(proc, str(pid)), os.O_RDONLY | os.O_DIRECTORY)
    42	    except OSError as err:
    43	        raise ValueError(f"process {pid}: its /proc identity is unreadable ({type(err).__name__}: {err})") from err
    44	    opener = lambda path, flags: os.open(path, flags, dir_fd=fd)  # noqa: E731
    45	    try:
    46	        with open("stat", opener=opener) as f:
    47	            first = _stat_identity(f.read())
    48	        with open("cmdline", "rb", opener=opener) as f:
    49	            cmdline = f.read()
    50	        links = [os.readlink(p, dir_fd=fd) for p in ("cwd", "fd/1", "fd/2")]
    51	        with open("stat", opener=opener) as f:
    52	            second = _stat_identity(f.read())
    53	    except (OSError, ValueError, IndexError) as err:
    54	        raise ValueError(f"process {pid}: its /proc identity is unreadable ({type(err).__name__}: {err})") from err
    55	    finally:
    56	        os.close(fd)
    57	    if not first == second == (pid, first[1]):
    58	        raise ValueError(f"process {pid}: its /proc entry changed during the sample ((pid, start time) {first} -> "
    59	                         f"{second}): PID reuse, no identity")
    60	    return {"pid": pid, "start_time": first[1], "cwd": links[0],
    61	            "cmdline_sha256": hashlib.sha256(cmdline).hexdigest(), "fd1": links[1], "fd2": links[2]}
