   265	def load_state(path, *, h35, cells_sha256, supervisor_sha256, approved_sha256, his_log, reservations):
   266	    """The state, None when absent; ``ValueError`` when a pin is malformed or the state corrupt / inconsistent."""
   267	    if _pin_reasons(h35, cells_sha256, supervisor_sha256, approved_sha256):
   268	        raise ValueError(_pin_reasons(h35, cells_sha256, supervisor_sha256, approved_sha256)[0])
   269	    try:
   270	        with open(path) as f:
   271	            doc = json.load(f)
   272	    except FileNotFoundError:
   273	        return None
   274	    except (OSError, ValueError) as err:
   275	        raise ValueError(f"the supervisor state {path} is corrupt ({err})") from err
   276	    why = state_reasons(doc, h35=h35, cells_sha256=cells_sha256, supervisor_sha256=supervisor_sha256,
   277	                        approved_sha256=approved_sha256, his_log=his_log, reservations=reservations)
   278	    if why:
   279	        raise ValueError(f"the supervisor state {path} is inconsistent: " + "; ".join(why))
   280	    return doc
