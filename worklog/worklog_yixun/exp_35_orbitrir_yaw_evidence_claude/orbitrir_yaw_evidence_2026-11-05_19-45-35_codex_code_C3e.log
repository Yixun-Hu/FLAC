   372	def held_by_other(dirpath, uuid):
   373	    """True when another holder -- or an unreadable / malformed file -- holds ``uuid``: never taken as free."""
   374	    try:
   375	        doc = read_reservation(dirpath, uuid)
   376	    except ValueError:
   377	        return True
   378	    return doc is not None and doc["holder"] != "exp35"
