  1238	def test_require_git_checks_run_under_the_lock_at_commit(env, repo, monkeypatch):
  1239	    state, _ = env
  1240	    r, _ = repo
  1241	    real_git, phase, seen = rt._git, ["declare"], []
  1242	
  1243	    def probing_git(*args):
  1244	        fd = os.open(state / rt.LOCK, os.O_RDWR | os.O_CREAT)
  1245	        try:
  1246	            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
  1247	            seen.append((phase[0], "free"))
  1248	        except BlockingIOError:
  1249	            seen.append((phase[0], "held"))
  1250	        finally:
  1251	            os.close(fd)
  1252	        return real_git(*args)
  1253	    monkeypatch.setattr(rt, "_git", probing_git)
  1254	    t = txn(state)
  1255	    t.require_git(r, branch="main")
  1256	    t.append(r / "note.md", "more\n")
  1257	    phase[0] = "commit"
  1258	    t.commit()
  1259	    assert {s for p, s in seen if p == "commit"} == {"held"} and ("declare", "free") in seen
