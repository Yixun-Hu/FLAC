+@pytest.mark.parametrize("target", ["the mark", "a staged temp", "a planned directory"])
+@pytest.mark.parametrize("error", [OSError(errno.EIO, "injected after the real creation"),
+                                   AsyncInterrupt("injected after the real creation")], ids=["OSError", "async"])
+def test_a_creation_that_happens_and_then_raises_is_never_deleted_and_keeps_the_mark(env, monkeypatch, target, error):
+    state, docs = env
+    a, sub = docs / "a.md", docs / "sub"
+    a.write_bytes(b"a\n")
+    t = txn(state)
+    t.create(sub / "n.md", b"n\n", parents=True)
+    t.append(a, "a2\n")
+    m = state / rt.MANIFEST
+    if target == "a planned directory":
+        real_mkdir = os.mkdir
+
+        def mkdir_then_raise(path, *args, **kwargs):
+            real_mkdir(path, *args, **kwargs)
+            if os.fspath(path) == str(sub.resolve()):
+                raise error
+        monkeypatch.setattr(rt.os, "mkdir", mkdir_then_raise)
+    else:
+        suffix, real_open, fired = rt.MANIFEST if target == "the mark" else ".records_txn.tmp", os.open, []
+
+        def open_then_raise(path, flags, *args, **kwargs):  # fires once, on the creating open only
+            fd = real_open(path, flags, *args, **kwargs)
+            if os.fspath(path).endswith(suffix) and flags & os.O_CREAT and not fired:
+                fired.append(path)
+                os.close(fd)
+                raise error
+            return fd
+        monkeypatch.setattr(rt.os, "open", open_then_raise)
+    with pytest.raises(rt.RecoveryNeeded, match="may not be ours"):
+        t.commit()
+    monkeypatch.undo()
+    assert m.exists() and a.read_bytes() == b"a\n" and not (sub / "n.md").exists()
+    if target == "a staged temp":
+        left = temps(docs)
+        assert len(left) == 1 and str(left[0].resolve()) in {o["tmp"] for o in manifest(state)["ops"]}
+    if target == "a planned directory":
+        assert sub.is_dir() and str(sub.resolve()) in manifest(state)["planned_dirs"]
+    with pytest.raises(rt.RecoveryNeeded):
+        rt.Transaction(state)
