+def test_require_git_returns_an_independent_copy(env, repo):
+    state, _ = env
+    r, _ = repo
+    t = txn(state)
+    seen = t.require_git(r, clean_paths=["note.md"])
+    seen["clean_paths"][0] = "other.md"                  # tampering with the returned copy ...
+    seen["clean_paths"].append("x.md")
+    seen["head"] = "0" * 40
+    (r / "note.md").write_bytes(b"dirty\n")              # ... must not change what is re-checked under the lock
