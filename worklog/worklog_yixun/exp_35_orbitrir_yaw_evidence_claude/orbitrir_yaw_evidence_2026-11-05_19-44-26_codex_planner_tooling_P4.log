  1018	def test_the_install_protocol_order(env, monkeypatch):
  1019	    state, docs = env
  1020	    a, n = docs / "a.md", docs / "n.md"
  1021	    a.write_bytes(b"a\n")
  1022	    t = txn(state)
  1023	    t.create(n, b"n\n")
  1024	    t.append(a, "b\n")
  1025	    trace, real = [], {name: getattr(os, name) for name in ("fsync", "link", "replace", "unlink")}
  1026	
  1027	    def fsync(fd):
  1028	        trace.append(("fsync", os.readlink(f"/proc/self/fd/{fd}")))
  1029	        return real["fsync"](fd)
  1030	
  1031	    def traced(name):
  1032	        def call(src, *rest, **kwargs):
  1033	            trace.append((name, os.fspath(rest[0] if rest else src)))   # link / replace: the destination
  1034	            return real[name](src, *rest, **kwargs)
  1035	        return call
  1036	    monkeypatch.setattr(rt.os, "fsync", fsync)
  1037	    for name in ("link", "replace", "unlink"):
  1038	        monkeypatch.setattr(rt.os, name, traced(name))
  1039	    done = t.commit()
  1040	    monkeypatch.undo()
  1041	    r = lambda p: str(pathlib.Path(p).resolve())                          # noqa: E731
  1042	    at = trace.index
  1043	    mark, sdir, ddir, docs_dir = r(state / rt.MANIFEST), r(state), r(state / rt.DONE), r(docs)
  1044	    temp_syncs = [i for i, e in enumerate(trace) if e[0] == "fsync" and e[1].endswith(".records_txn.tmp")]
  1045	    first_install, last_install = at(("link", r(n))), at(("replace", r(a)))
  1046	    assert len(temp_syncs) == 2
  1047	    assert at(("fsync", mark)) < at(("fsync", sdir)) < temp_syncs[0]          # the mark is durable first
  1048	    assert temp_syncs[-1] < trace.index(("fsync", docs_dir), temp_syncs[-1]) < first_install
  1049	    assert first_install < last_install < trace.index(("fsync", docs_dir), last_install)
  1050	    archived, cleared = at(("link", r(done))), at(("unlink", mark))
  1051	    assert trace.index(("fsync", docs_dir), last_install) < archived
  1052	    assert archived < trace.index(("fsync", ddir), archived) < cleared        # done/ durable before the clear
  1053	    assert cleared < trace.index(("fsync", sdir), cleared)                   # and the clear made durable
  1054	
