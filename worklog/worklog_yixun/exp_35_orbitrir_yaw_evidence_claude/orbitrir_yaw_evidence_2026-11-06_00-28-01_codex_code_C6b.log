   526	                        path.parent.mkdir(parents=True, exist_ok=True)
   527	                        path.write_text(json.dumps({"seed": seed, "rotate_deg": float(angle), "metrics": {
   528	                            key: round(base + 0.1 * j, 4) for j, key in enumerate(keys)}}))
