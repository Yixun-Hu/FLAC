   505	def test_every_existing_definition_is_byte_identical_to_h35():
   506	    old, new = h35_text(), open(PLOT).read()
   507	    segments = {ast.get_source_segment(new, n) for n in ast.parse(new).body}
   508	    kept = [n for n in ast.parse(old).body if not isinstance(n, ast.If)
   509	            and not (isinstance(n, ast.FunctionDef) and n.name in ("parse_args", "main"))]
   510	    assert len(kept) >= 24 and [ast.get_source_segment(old, n)[:60] for n in kept
   511	                                if ast.get_source_segment(old, n) not in segments] == []
   512	    new_main = ast.get_source_segment(new, next(n for n in ast.parse(new).body if getattr(n, "name", "") == "main"))
   513	    old_main = next(n for n in ast.parse(old).body if getattr(n, "name", "") == "main")
   514	    assert all(ast.get_source_segment(old, st) in new_main for st in old_main.body)   # the old body, verbatim
