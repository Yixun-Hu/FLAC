     1	#!/usr/bin/env python3
     2	"""exp_35 commit-size bookkeeping (the "< 200 changed CODE lines per commit" rule of CLAUDE.md /
     3	the Coder brief): for one commit, the added + removed lines that are code -- not blank, not a
     4	comment-only line, not inside a module / class / function docstring -- split into code (outside
     5	src/tests/), tests (src/tests/) and data (*.json, *.md, *.log, *.sha256, *.csv). Read-only (git show).
     6	
     7	Usage: exp35_count_code_lines.py <commit> [<commit> ...]   (one table row per commit)
     8	
     9	Written by the exp_35 Coder (Claude Opus 5.5, max effort).
    10	"""
    11	import ast
    12	import re
    13	import subprocess
    14	import sys
    15	
    16	DATA = (".json", ".md", ".log", ".sha256", ".csv", ".txt")
    17	
    18	
    19	def _git(*args):
    20	    return subprocess.run(["git", *args], capture_output=True, text=True, check=False).stdout
    21	
    22	
    23	def code_lines(path, text):
    24	    """1-based numbers of the code lines of ``text`` (the file ``path`` at one revision)."""
    25	    lines = text.splitlines()
    26	    skip = set()
    27	    if path.endswith(".py"):
    28	        try:
    29	            tree = ast.parse(text)
    30	        except SyntaxError:
    31	            tree = None
    32	        for node in ast.walk(tree) if tree else ():
    33	            body = getattr(node, "body", None)
    34	            if isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)) and body \
    35	                    and isinstance(body[0], ast.Expr) and isinstance(getattr(body[0], "value", None), ast.Constant) \
    36	                    and isinstance(body[0].value.value, str):
    37	                skip.update(range(body[0].lineno, body[0].end_lineno + 1))
    38	    return {i for i, ln in enumerate(lines, 1) if ln.strip() and not ln.strip().startswith("#") and i not in skip}
    39	
    40	
    41	def changed(commit, path):
    42	    """``(added code lines, removed code lines)`` of ``path`` in ``commit`` (vs its first parent)."""
    43	    old = _git("show", f"{commit}^:{path}") if _git("cat-file", "-t", f"{commit}^:{path}").strip() else ""
    44	    new = _git("show", f"{commit}:{path}") if _git("cat-file", "-t", f"{commit}:{path}").strip() else ""
    45	    old_code, new_code = code_lines(path, old), code_lines(path, new)
    46	    added = removed = 0
    47	    for hunk in re.finditer(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", _git(
    48	            "diff", "-U0", f"{commit}^", commit, "--", path), re.M):
    49	        o, oc, n, nc = int(hunk[1]), int(hunk[2] or 1), int(hunk[3]), int(hunk[4] or 1)
    50	        removed += sum(1 for i in range(o, o + oc) if i in old_code)
    51	        added += sum(1 for i in range(n, n + nc) if i in new_code)
    52	    return added, removed
    53	
    54	
    55	def main(argv):
    56	    print("| commit | code +/- | tests +/- | data +/- | files |")
    57	    print("|---|---|---|---|---|")
    58	    for commit in argv:
    59	        tot = {"code": [0, 0], "tests": [0, 0], "data": [0, 0]}
    60	        files = [f for f in _git("diff", "--name-only", f"{commit}^", commit).splitlines() if f]
    61	        for f in files:
    62	            kind = "data" if f.endswith(DATA) else "tests" if f.startswith("src/tests/") else "code"
    63	            a, r = changed(commit, f)
    64	            tot[kind][0] += a
    65	            tot[kind][1] += r
    66	        cells = " | ".join(f"+{v[0]} / -{v[1]} (= {v[0] + v[1]})" for v in tot.values())
    67	        print(f"| `{_git('rev-parse', '--short=8', commit).strip()}` | {cells} | {len(files)} |")
    68	    return 0
    69	
    70	
    71	if __name__ == "__main__":
    72	    sys.exit(main(sys.argv[1:]))
