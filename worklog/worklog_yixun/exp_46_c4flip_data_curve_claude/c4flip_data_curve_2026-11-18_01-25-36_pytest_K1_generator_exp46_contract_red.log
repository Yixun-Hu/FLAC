    def test_every_pre_exp25_row_renders_byte_identically(tmp_path, monkeypatch):
        base_mod = _generator_at(BASE_COMMIT)
        base = _render_lines(base_mod, tmp_path / "base.md", monkeypatch)
        cur = _render_lines(G, tmp_path / "cur.md", monkeypatch)
        exp25 = [ln for ln in cur if any(ln.startswith(f"| {label} |") for label in G.EXP25_LABELS.values())]
        assert len(exp25) == 6                                               # the additive rows, nothing else
        # exp_14 round P appended its own additive block after exp_25's: the twelve data-curve rows
        data_curve = [ln for ln in cur if ln.startswith("| data-curve ")]
        assert len(data_curve) == 12
        # exp_40 appended its own additive block (the two C16 theta=0 rows, contract exp40)
        exp40 = [ln for ln in cur if ln.startswith(f"| {G.EXP40_LABEL} |")]
        assert len(exp40) == 2
        # exp_38 appended its own additive block of twelve preregistered rows (pending until its cells land)
        data_eff = [ln for ln in cur if any(ln.startswith(f"| {label} |") for label in G.EXP38_LABELS.values())]
        assert len(data_eff) == 12
        # exp_45 appended its own additive block of six preregistered RF rows (pending until its cells land)
        exp45 = [ln for ln in cur if any(ln.startswith(f"| {label} |") for label in G.EXP45_LABELS.values())]
        assert len(exp45) == 6
        # exp_46 appended its own additive block of eight preregistered C4F rows (exp_46 declared edit E5): pending here,
        # so zero exp_46 disclosure blocks; the published case is asserted below
