+def canonicalize_scene_metadata(md: Dict[str, object], img_w: int) -> Dict[str, object]:
+    """
+    Rotate a sample into a canonical yaw frame where the target source azimuth is 0.
+
+    This is the single-frame "canonicalization" baseline for yaw symmetry: instead of
+    averaging over a frame of rotations, it picks one gauge by rotating the whole scene
+    so the target source lies at azimuth 0 (straight ahead) in the panorama. Because the
+    rotation is applied jointly to the depth panorama and all pose vectors via
+    :func:`rotate_scene_metadata`, the physical geometry is preserved.
+
+    Parameters
+    ----------
+    md : Dict[str, object]
+        One per-sample metadata dict. Must contain ``source`` (a length-3 tensor giving
+        the target source position in the panorama camera frame) and ``depth``.
+    img_w : int
+        Panorama width in pixels (number of azimuth columns).
+
+    Returns
+    -------
+    Dict[str, object]
+        A metadata dict rotated so the target source is at azimuth 0. The original dict
+        is not mutated.
+    """
+    source = md["source"]
+    assert isinstance(source, torch.Tensor)
+    azimuth = math.atan2(float(source[1]), float(source[0]))
+    return rotate_scene_metadata(md, -azimuth, img_w)
+
+
+def frame_averaged_conditioning(
+    conditioner: Callable,
+    metadata: List[Dict[str, object]],
+    device: object,
+    angles_deg: List[float],
+    autocast_device_type: Optional[str] = None,
+) -> Dict[str, list]:
+    """
+    Average a conditioner's outputs over a finite yaw frame (frame averaging).
+
+    Implements the frame-averaging operator of Puny et al. (ICLR 2022) restricted to a
+    finite frame of azimuthal rotations: the scene metadata is rotated by each angle,
+    the conditioner is run on each rotated copy, and the resulting conditioning tensors
+    are averaged. Because the mono RIR is invariant to whole-scene yaw rotation, this
+    yields conditioning that is (approximately) invariant to absolute yaw while reusing
+    the existing conditioner backbone unchanged. Used at both train and eval time so the
+    diffusion model consistently consumes frame-averaged conditioning.
+
+    Parameters
+    ----------
+    conditioner : Callable
+        A conditioner callable ``conditioner(metadata, device) -> {id: [tensor, mask]}``
+        (e.g. ``diffusion.conditioner``).
+    metadata : list of dict
+        Per-sample metadata dicts for the batch.
+    device : torch.device or str
+        Device passed through to the conditioner.
+    angles_deg : list of float
+        Yaw angles in degrees defining the frame to average over.
+    autocast_device_type : str, optional
+        If given (e.g. ``"cuda"``), each conditioner call is wrapped in
+        ``torch.amp.autocast`` with this device type. If None (default), no autocast is
+        applied (matching the training path, which manages precision externally).
+
+    Returns
+    -------
+    dict
+        Averaged conditioning dict ``{id: [tensor, mask]}`` ready for
+        ``get_conditioning_inputs``. Masks are taken from the first frame element.
+    """
+    img_w = int(metadata[0]["depth"].shape[-1])
+    accumulated: Optional[Dict[str, list]] = None
+    for angle in angles_deg:
+        variant = [rotate_scene_metadata(md, math.radians(angle), img_w) for md in metadata]
+        if autocast_device_type is not None:
+            with torch.amp.autocast(autocast_device_type):
+                cond = conditioner(variant, device)
+        else:
+            cond = conditioner(variant, device)
+        if accumulated is None:
+            accumulated = {key: [value[0].clone(), value[1]] for key, value in cond.items()}
+        else:
+            for key in accumulated:
+                accumulated[key][0] = accumulated[key][0] + cond[key][0]
+
+    assert accumulated is not None, "angles_deg must be non-empty"
+    num = len(angles_deg)
+    if num > 1:
+        for key in accumulated:
+            accumulated[key][0] = accumulated[key][0] / num
+    return accumulated
+
+
