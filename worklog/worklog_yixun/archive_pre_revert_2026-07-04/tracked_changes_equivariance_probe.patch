+def compute_conditioning(diffusion, metadata, device, cond_method, frame_avg_angles):
+    """
+    Compute conditioning tensors, optionally made yaw-symmetry-aware.
+
+    This is the only part of the eval pipeline that changes between the vanilla model
+    and the symmetry-aware variants: the RIR sampling, decoding and metrics are left
+    untouched. Under a scene yaw rotation the mono RIR is invariant, so we enforce that
+    on the conditioning either by canonicalization (a single gauge) or by frame
+    averaging (averaging the conditioner outputs over a frame of rotations, i.e. the
+    Reynolds operator restricted to a finite frame).
+
+    Parameters
+    ----------
+    diffusion : ConditionedDiffusionModelWrapper
+        The FLAC diffusion wrapper exposing ``conditioner`` and ``get_conditioning_inputs``.
+    metadata : list of dict
+        Per-sample metadata dicts for the batch.
+    device : torch.device or str
+        Device on which to run the conditioner.
+    cond_method : str
+        One of ``"vanilla"`` (standard), ``"canon"`` (rotate each sample so its target
+        source azimuth is 0), or ``"frame_avg"`` (average conditioner outputs over the
+        yaw frame given by ``frame_avg_angles``).
+    frame_avg_angles : list of float
+        Yaw angles in degrees defining the frame; only used when ``cond_method`` is
+        ``"frame_avg"``.
+
+    Returns
+    -------
+    dict
+        Conditioning dict ``{id: [tensor, mask]}`` ready for ``get_conditioning_inputs``.
+
+    Raises
+    ------
+    ValueError
+        If ``cond_method`` is not one of the supported values.
+    """
+    device_type = torch.device(device).type
+
+    if cond_method == "vanilla":
+        with torch.amp.autocast(device_type):
+            return diffusion.conditioner(metadata, device)
+
+    if cond_method == "canon":
+        img_w = int(metadata[0]["depth"].shape[-1])
+        variant = [canonicalize_scene_metadata(md, img_w) for md in metadata]
+        with torch.amp.autocast(device_type):
+            return diffusion.conditioner(variant, device)
+
+    if cond_method == "frame_avg":
+        return frame_averaged_conditioning(diffusion.conditioner, metadata, device, frame_avg_angles, autocast_device_type=device_type)
+
+    raise ValueError(f"Unknown cond_method: {cond_method}")
+
+
