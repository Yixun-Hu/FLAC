     4	A cell is used only if ``exp38_eval.validate_cell`` admits it (one transaction: metrics schema +
     5	protocol + checkpoint + stream + receipt + dump cross-links); a run's block is published only when
     6	all 10 cells (K 8 and 1, seeds 42-46) are admitted, else it renders PENDING. Reference rows (dc_van,
     7	P1 / YAW / B-F at 100 %) come from ``ref_cells/`` after its sha manifest is checked. The JSON and the
     8	Markdown are written as one pair (temp files -> fsync -> rename, the Markdown carries the JSON's
     9	sha256) under the exp_38 collector lock.
    10	
    11	    python exp38_collect.py [--bridge] [--partial]
    12	
    13	Written by the exp_38 Coder (Claude Opus 5.5).
    14	"""
    15	import argparse
    16	import fcntl
    17	import glob
    18	import hashlib
    19	import json
    20	import os
    21	import statistics
    22	import sys
    23	
    24	HERE = os.path.dirname(os.path.realpath(__file__))
    25	sys.path.insert(0, HERE)
    26	import exp38_eval as ev  # noqa: E402
    27	import exp38_registry as reg  # noqa: E402
    28	
    29	OUT_JSON = f"{reg.EXP_DIR}/data_efficiency_results.json"
    30	OUT_MD = f"{reg.EXP_DIR}/data_efficiency_results.md"
    31	LOCK = f"{reg.EXP_DIR}/.collect.lock"
    32	SHOW = ("EDT", "C50", "T60", "FD", "RIR_to_GT_RIR_R@1")
    33	MODELS = {"p1": "FLAC (P1)", "yaw": "Yaw-Aug FLAC (YAW)", "bf": "OrbitRIR (B-F)",
    34	          "p1_bridge": "FLAC (P1) platform bridge (exp_38)"}
    35	FRAC_LABEL = {"025": "25 %", "050": "50 %", "075": "75 %", "100": "100 %"}
    36	
    37	
    38	def mean_sd(values):
    39	    return statistics.mean(values), (statistics.stdev(values) if len(values) > 1 else 0.0)
    40	
    41	
    42	def aggregate(records):
    43	    """records: {seed: metrics dict} for one (run, K) -> {metric: (mean, sd, n)}."""
    44	    if sorted(records) != list(ev.SEEDS):
    45	        raise ValueError(f"seeds {sorted(records)} != {list(ev.SEEDS)}")
    46	    return {k: (*mean_sd([records[s][k] for s in ev.SEEDS]), len(records)) for k in ev.METRIC_KEYS}
    47	
    48	
    49	def reference_rows():
    50	    ev.check_refs()
    51	    base = os.path.join(reg.REPO, reg.EXP_DIR, "ref_cells", "anchors")
    52	    rows = {}
    53	    for (model, frac, pattern) in [("p1", t, f"dc_van/dc_van_f{t}_K{{K}}_s{{s}}.json") for t in ("025", "050", "075")] + \
    54	            [("p1", "100", "P1/P1_K{K}_s{s}.json"), ("yaw", "100", "YAW/YAW_K{K}_s{s}.json"),
    55	             ("bf", "100", "BF/BF_K{K}_s{s}.json")]:
    56	        for K in (8, 1):
    57	            recs = {s: json.load(open(os.path.join(base, pattern.format(K=K, s=s))))["metrics"] for s in ev.SEEDS}
    58	            rows[(model, frac, K)] = {"stats": aggregate(recs), "source": "reference (ref_cells/anchors)"}
    59	    return rows
    60	
    61	
    62	def run_block(run, validate=None):
    63	    """(rows for the run's two K, problems). validate(cell) -> problems (default ev.validate_cell)."""
    64	    validate = validate or ev.validate_cell
    65	    arm, tag, _ = reg.parse_run_id(run)
    66	    cells = ev.run_cells(run)
    67	    problems = [x for c in cells for x in validate(c)]
    68	    rd = os.path.join(reg.PLATFORMS["a6000"]["save_root"], run)
    69	    if glob.glob(os.path.join(rd, "RESUMED_AT_*")) or os.path.isdir(os.path.join(rd, ".exp38_lock")):
    70	        problems.append(f"{run}: run dir carries a resume / live-lock marker (never primary)")
    71	    if problems:
    72	        return {}, problems
    73	    shas = {json.load(open(ev._abs(c["metrics"])))["source_sha"] for c in cells}
    74	    if len(shas) != 1:
    75	        return {}, [f"{run}: cells evaluated at {len(shas)} different pins"]
    76	    pin = next(iter(shas))
    77	    model = "p1_bridge" if arm == "p1" else arm
    78	    rows = {}
    79	    for K in (8, 1):
    80	        recs = {c["seed"]: json.load(open(ev._abs(c["metrics"])))["metrics"] for c in cells if c["K"] == K}
    81	        rows[(model, tag, K)] = {"stats": aggregate(recs), "source": f"exp_38 {run} (eval pin {pin[:12]})"}
    82	    return rows, []
    83	
    84	
    85	def render(rows, pending):
    86	    out = ["# exp_38 data_efficiency — results (generated by exp38_collect.py; never hand-edited)", "",
    87	           "Full unseen split (6,337 items / 17 rooms), split-level item-weighted, mean ± sample SD over eval "
    88	           "seeds 42–46, 40k-step EMA endpoints, one training seed (42) per cell. EDT ms, C50 dB, T60 %, FD, R@1 %.", ""]
    89	    for K in (8, 1):
    90	        out += [f"## K = {K}" + (" (headline)" if K == 8 else ""), "",
    91	                "| model | data | " + " | ".join(SHOW) + " | source |", "|---|---|" + "---|" * len(SHOW) + "---|"]
    92	        for model in ("p1", "yaw", "bf", "p1_bridge"):
    93	            for frac in ("025", "050", "075", "100"):
    94	                key = (model, frac, K)
    95	                if key in rows:
    96	                    st = rows[key]["stats"]
    97	                    cells = [f"{st[m][0]:.3f} ± {st[m][1]:.3f}" for m in SHOW]
    98	                    out.append(f"| {MODELS[model]} | {FRAC_LABEL[frac]} | " + " | ".join(cells) + f" | {rows[key]['source']} |")
    99	                elif model in ("yaw", "bf") and frac != "100":
   100	                    out.append(f"| {MODELS[model]} | {FRAC_LABEL[frac]} | " + " | ".join(["PENDING"] * len(SHOW)) + " | — |")
   101	        out.append("")
   102	    if pending:
   103	        out += ["## Pending / not admitted", ""] + [f"- {p}" for p in pending] + [""]
   104	    return "\n".join(out) + "\n"
   105	
   106	
   107	def publish(rows, pending, repo=None):
   108	    repo = repo or reg.REPO
   109	    payload = {"rows": [{"model": k[0], "fraction": k[1], "K": k[2], "source": v["source"],
   110	                         "stats": {m: {"mean": s[0], "sd": s[1], "n": s[2]} for m, s in v["stats"].items()}}
   111	                        for k, v in sorted(rows.items())], "pending": pending}
   112	    jtext = json.dumps(payload, indent=1, sort_keys=True).encode()
   113	    mtext = (render(rows, pending) + f"\nresults JSON sha256: `{hashlib.sha256(jtext).hexdigest()}`\n").encode()
   114	    lock = open(os.path.join(repo, LOCK), "a")
   115	    fcntl.flock(lock, fcntl.LOCK_EX)
   116	    try:
   117	        for rel, text in ((OUT_JSON, jtext), (OUT_MD, mtext)):
   118	            tmp = os.path.join(repo, rel + ".tmp")
   119	            with open(tmp, "wb") as fh:
   120	                fh.write(text)
   121	                fh.flush()
   122	                os.fsync(fh.fileno())
   123	        for rel in (OUT_JSON, OUT_MD):
   124	            os.replace(os.path.join(repo, rel + ".tmp"), os.path.join(repo, rel))
   125	    finally:
   126	        fcntl.flock(lock, fcntl.LOCK_UN)
   127	        lock.close()
   128	    return hashlib.sha256(jtext).hexdigest()
   129	
   130	
   131	def main(argv=None):
   132	    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   133	    p.add_argument("--bridge", action="store_true")
   134	    a = p.parse_args(argv)
   135	    os.chdir(reg.REPO)
   136	    rows = reference_rows()
   137	    pending = []
   138	    for run in reg.required_runs() + (["de_p1_f025"] if a.bridge else []):
