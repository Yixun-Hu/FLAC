   483	def write_ckpt_manifest(path, run):
   484	    _, tag, _ = parse_run_id(run)
   485	    check_run_dir(path, run, MAX_STEPS, allow_submission_marker=True)
   486	    lines = [f"{sha256_file(os.path.join(path, ckpt_name(s, tag)))}  {ckpt_name(s, tag)}"
   487	             for s in cadence_steps()]
   488	    out = os.path.join(path, "CHECKPOINTS.sha256")
   489	    if os.path.exists(out):
   490	        raise GateError(f"{out} already exists")
   491	    with open(out + ".tmp", "w") as fh:
   492	        fh.write("\n".join(lines) + "\n")
   493	    os.replace(out + ".tmp", out)
   494	    return out
