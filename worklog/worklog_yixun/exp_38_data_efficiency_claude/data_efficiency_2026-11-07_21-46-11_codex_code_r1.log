   225	    if len(vits) != 2 or not all(c["config"].get("gradient_checkpointing") is True for c in vits):
   226	        raise GateError(f"{rel}: both ViT conditioners must have gradient_checkpointing true")
   227	    if not all(c["config"]["ViT"]["img_w"] == 512 for c in vits) or tr.get("use_ema") is not True:
   228	        raise GateError(f"{rel}: img_w 512 and use_ema true required")
   229	    if tr.get("cond_method", "vanilla") != ARMS[arm]["cond_method"]:
   230	        raise GateError(f"{rel}: cond_method {tr.get('cond_method')!r} != {ARMS[arm]['cond_method']}")
   231	    if arm == "yaw" and tr.get("yaw_aug") != {"enabled": True, "img_w": 512, "seed": 42}:
   232	        raise GateError(f"{rel}: training.yaw_aug is not the registered block")
   233	    if arm != "yaw" and "yaw_aug" in tr:
   234	        raise GateError(f"{rel}: unexpected yaw_aug")
   235	    if arm == "bf":
   236	        if tr.get("frame_avg_angles") != [0.0, 90.0, 180.0, 270.0]:
   237	            raise GateError(f"{rel}: frame_avg_angles must be the C4 orbit")
   238	        if tr.get("frame_avg_max_fwd_samples") != chunk_plan(arm, rung)["frame_avg_max_fwd_samples"]:
   239	            raise GateError(f"{rel}: chunk cap != per-rank micro-batch")
   240	    opt = tr.get("optimizer_configs", {}).get("diffusion", {})
   241	    if opt.get("optimizer") != {"type": "AdamW", "config": {"lr": 5e-05, "betas": [0.9, 0.999], "weight_decay": 0.001}} \
   242	            or opt.get("scheduler") != {"type": "InverseLR", "config": {"inv_gamma": 1000000, "power": 0.5, "warmup": 0.99}}:
