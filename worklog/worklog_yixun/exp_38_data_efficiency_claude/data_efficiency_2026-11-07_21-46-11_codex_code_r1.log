   117	class FakeScheduler:
   118	    def __init__(self, squeue="", sacct="", sbatch="4242;cluster", fail=None):
   119	        self.out = {"squeue": squeue, "sacct": sacct, "sbatch": sbatch}
   120	        self.fail = fail or set()
   121	        self.calls = []
   122	
   123	    def __call__(self, argv, capture_output=True, text=True):
   124	        self.calls.append(argv)
   125	        tool = os.path.basename(argv[0])
   126	        return types.SimpleNamespace(returncode=1 if tool in self.fail else 0, stdout=self.out.get(tool, ""),
   127	                                     stderr="boom" if tool in self.fail else "")
