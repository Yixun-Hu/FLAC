   675	def wait_start_gate(log_path, run, backend, ngpu, pid, timeout_s, poll_s=10.0):
   676	    """Poll the log until the first optimizer step (or the pid exits / timeout), then gate it."""
   677	    deadline = time.time() + timeout_s
   678	    while True:
   679	        text = open(log_path, errors="replace").read() if os.path.exists(log_path) else ""
   680	        if first_step_index(log_lines(text)) is not None:
   681	            return log_gate(text, run, "start", backend, ngpu)
   682	        alive = pid is None or os.path.exists(f"/proc/{pid}")
   683	        if not alive:
   684	            return ["the training process exited before its first step"]
   685	        if time.time() > deadline:
   686	            return [f"no first step within {timeout_s} s"]
   687	        time.sleep(poll_s)
