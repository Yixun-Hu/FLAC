   156	def verify(artifact, dataset_root="AcousticRooms", repo=None):
   157	    """Re-check a committed audit against the CURRENT tree: sidecar, PASS, the complete bound map
   158	    and the root fingerprint (one listing per room, seconds). Returns a list of problems."""
   159	    os.chdir(repo or reg.REPO)
   160	    try:
   161	        text = open(artifact, "rb").read()
   162	        side = open(artifact + ".sha256").read().split()[0]
   163	    except OSError as err:
   164	        return [f"artifact unreadable: {err}"]
   165	    if hashlib.sha256(text).hexdigest() != side:
   166	        return ["artifact does not match its .sha256"]
   167	    res = json.loads(text)
   168	    p = [] if res.get("verdict") == "PASS" and not res.get("problems") else [f"verdict {res.get('verdict')}"]
   169	    if res.get("bound") != bound_map(dataset_root):
   170	        cur = bound_map(dataset_root)
   171	        p.append(f"bound map differs: {sorted(k for k in set(cur) | set(res.get('bound', {})) if cur.get(k) != res.get('bound', {}).get(k))}")
   172	    if res.get("root_fingerprint") != root_fingerprint(dataset_root):
   173	        p.append("the AcousticRooms room listings changed since the audit")
   174	    return p
   175	
   176	
   177	def run_audit(dataset_root="AcousticRooms", repo="."):
   178	    problems, out = [], {"schema": 1, "fractions": {}}
   179	    os.chdir(repo)
   180	    for (path, name), want in EXP14_FN_SHA256.items():
   181	        got = fn_source_sha256(open(path).read(), name)
   182	        if got != want:
   183	            problems.append(f"{path}::{name} source {got} != exp_14's {want}")
   184	    if reg.sha256_file(AR_MD) != AR_MD_EXP14_SHA256:
   185	        problems.append("AR_md.py is not exp_14's launch blob")
   186	    base = subprocess.run(["git", "show", f"2b42468c:{AR_MD}"], capture_output=True)
   187	    old = subprocess.run(["git", "show", f"7bbd8aa:{AR_MD}"], capture_output=True)
   188	    base_ok = (base.returncode == 0 and old.returncode == 0
   189	               and hashlib.sha256(base.stdout).hexdigest() == AR_MD_BASE_SHA256
   190	               == hashlib.sha256(old.stdout).hexdigest())
   191	    if not base_ok:
   192	        problems.append("the exp_38 base AR_md.py is not byte-identical to exp_14's base (7bbd8aa)")
   193	    out["base_ar_md_equals_exp14_base"] = base_ok
   194	    if reg.sha256_file(TRAIN_JSON) != TRAIN_JSON_SHA256:
   195	        problems.append("train.json is not the split exp_14 subsampled")
   196	    manifest = json.load(open(MANIFEST))
   197	    listings = {}
   198	    for tag, frac_key in (("025", "0.25"), ("050", "0.5"), ("075", "0.75")):
   199	        f = reg.FRACS[tag]
   200	        try:
   201	            reg.check_subset(tag)
   202	        except reg.GateError as err:
   203	            problems.append(str(err))
   204	        summary, per_room, probs = audit_split(f["split"], True, dataset_root, listings)
   205	        problems += probs
   206	        want = manifest["fractions"][frac_key]
   207	        if per_room != {r: v["context_histogram"] for r, v in want["per_room"].items()}:
   208	            problems.append(f"{tag}: per-room context histograms differ from exp_14's manifest")
   209	        total = {b: sum(h[b] for h in per_room.values()) for b in ("0", "1-7", ">=8")}
   210	        if total != want["context_histogram"] or summary["n_targets"] != want["final"] != f["n_items"]:
   211	            problems.append(f"{tag}: totals {total} / {summary['n_targets']} != manifest")
   212	        summary["context_histogram"] = total
   213	        out["fractions"][tag] = summary
   214	    summary, per_room, probs = audit_split(TRAIN_JSON, False, dataset_root, listings)
   215	    problems += probs
   216	    total = {b: sum(h[b] for h in per_room.values()) for b in ("0", "1-7", ">=8")}
   217	    if total != manifest["full_split_context_histogram"]:
   218	        problems.append(f"100 %: in-split histogram {total} != manifest {manifest['full_split_context_histogram']}")
   219	    summary["context_histogram_in_split"] = total
   220	    out["full_split"] = summary
   221	    out["bound"] = bound_map(dataset_root)
   222	    out["root_fingerprint"] = root_fingerprint(dataset_root, listings)
   223	    out["problems"] = problems
   224	    out["verdict"] = "PASS" if not problems else "FAIL"
   225	    return out
   226	
   227	
   228	def main(argv=None):
   229	    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   230	    g = p.add_mutually_exclusive_group(required=True)
   231	    g.add_argument("--out")
   232	    g.add_argument("--verify", metavar="ARTIFACT")
   233	    p.add_argument("--dataset-root", default="AcousticRooms")
   234	    a = p.parse_args(argv)
   235	    if a.verify:
   236	        problems = verify(os.path.realpath(a.verify), a.dataset_root)
   237	        print("SUBSET AUDIT VERIFY " + ("PASS" if not problems else "FAIL: " + " | ".join(problems)))
   238	        return 0 if not problems else 1
   239	    if os.path.exists(a.out):
   240	        print(f"refusing to overwrite {a.out}", file=sys.stderr)
   241	        return 2
   242	    res = run_audit(a.dataset_root, repo=reg.REPO)
   243	    text = json.dumps(res, indent=1, sort_keys=True) + "\n"
   244	    with open(a.out, "w") as fh:
   245	        fh.write(text)
   246	    with open(a.out + ".sha256", "w") as fh:
   247	        fh.write(f"{hashlib.sha256(text.encode()).hexdigest()}  {os.path.basename(a.out)}\n")
   248	    print(f"SUBSET AUDIT {res['verdict']}: {a.out}" + ("" if not res["problems"] else f" ({len(res['problems'])} problems)"))
   249	    return 0 if res["verdict"] == "PASS" else 1
   250	
   251	
   252	if __name__ == "__main__":
   253	    sys.exit(main())
     1	#!/usr/bin/env python3
     2	"""exp_38 — the registered seed-42 initial-state digest of an arm (plan r2 §10 B3).
     3	
     4	Builds the training wrapper on the CPU in train.py's exact order (float32 matmul precision,
     5	``pl.seed_everything(42, workers=True)`` -> dataloader construction -> ``create_model_from_config``
     6	-> VAE ``load_state_dict`` -> ``create_training_wrapper_from_config``) and prints the
     7	``src.training.run_evidence.state_dict_digest`` of the wrapper plus the Sobol and RNG digests.
     8	The in-process evidence of every training rank must report the same state digest (the start
     9	gate); YAW, B-F and P1 share it because their ``.model`` sections are canonically identical.
    10	
    11	    python exp38_init_digest.py --run de_bf_f025 [--json out.json]
    12	
    13	Written by the exp_38 Coder (Claude Opus 5.5).
    14	"""
    15	import argparse
    16	import json
    17	import os
    18	import sys
    19	
    20	HERE = os.path.dirname(os.path.realpath(__file__))
    21	sys.path.insert(0, HERE)
    22	import exp38_registry as reg  # noqa: E402
    23	
    24	
    25	def init_digest(run, repo=None):
    26	    repo = repo or reg.REPO
    27	    sys.path.insert(0, repo)
    28	    os.chdir(repo)
    29	    import pytorch_lightning as pl
    30	    import torch
    31	    from src.data.dataset import create_dataloader_from_config
    32	    from src.models import create_model_from_config
    33	    from src.models.utils import load_ckpt_state_dict
    34	    from src.training import create_training_wrapper_from_config
    35	    from src.training import run_evidence as rev
    36	
    37	    arm, tag, rung = reg.parse_run_id(run)
    38	    torch.set_float32_matmul_precision("medium")
    39	    pl.seed_everything(reg.SEED, workers=True)
    40	    model_config = json.load(open(reg.model_config_rel(arm, rung)))
    41	    dataset_config = json.load(open(reg.FRACS[tag]["dataset_config"]))
    42	    create_dataloader_from_config(dataset_config, batch_size=reg.RUNGS[rung]["micro"], num_workers=6,
    43	                                  sample_rate=model_config["sample_rate"], sample_size=model_config["sample_size"],
    44	                                  audio_channels=model_config.get("audio_channels", 1))
    45	    model = create_model_from_config(model_config)
    46	    model.pretransform.load_state_dict(load_ckpt_state_dict(reg.VAE_PATH))
    47	    wrapper = create_training_wrapper_from_config(model_config, model)
    48	    sd = wrapper.state_dict()
    49	    return {"run": run, "state_dict_sha256": rev.state_dict_digest(sd), "n_state_tensors": len(sd),
    50	            "sobol": rev.sobol_state(wrapper.rng), "rng_after_build": rev.rng_digests()}
    51	
    52	
    53	def main(argv=None):
    54	    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    55	    p.add_argument("--run", required=True)
    56	    p.add_argument("--json")
    57	    a = p.parse_args(argv)
    58	    out = init_digest(a.run)
    59	    text = json.dumps(out, indent=1, sort_keys=True)
    60	    print(text)
    61	    if a.json:
    62	        if os.path.exists(a.json):
    63	            print(f"refusing to overwrite {a.json}", file=sys.stderr)
    64	            return 2
    65	        with open(a.json, "w") as fh:
    66	            fh.write(text + "\n")
    67	    return 0
    68	
    69	
    70	if __name__ == "__main__":
    71	    sys.exit(main())

