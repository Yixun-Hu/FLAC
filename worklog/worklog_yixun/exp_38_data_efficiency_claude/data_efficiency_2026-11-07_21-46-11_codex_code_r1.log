   182	        os.path.join(reg.PLATFORMS["a6000"]["save_root"], cell["run"])
   183	    name = os.path.basename(cell["ckpt_link"])
   184	    for line in open(os.path.join(rd, "CHECKPOINTS.sha256")).read().strip().split("\n"):
   185	        digest, n = line.split("  ", 1)
   186	        if n == name:
   187	            return digest
   188	    raise EvalError(f"{name} not in {rd}/CHECKPOINTS.sha256")
