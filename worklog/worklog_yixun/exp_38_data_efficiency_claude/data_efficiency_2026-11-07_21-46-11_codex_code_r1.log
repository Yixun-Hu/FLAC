     1	#!/usr/bin/env python3
     2	"""exp_38 neuronic submitter — one monolithic job per run, exactly-once (plan r2 §10 B7).
     3	
     4	Run on the neuronic login node from the exp-38 checkout (HEAD pushed, tracked tree clean):
     5	
     6	    exp38_submit_neuronic.py submit    --run de_yaw_f025 --mode SMOKE --time 01:00:00 [--dry-run]
     7	    exp38_submit_neuronic.py submit    --run de_yaw_f025 --mode FULL  --time 3-00:00:00 [--dry-run]
     8	    exp38_submit_neuronic.py reconcile --run de_yaw_f025 --mode FULL      # after an interrupted submit
     9	    exp38_submit_neuronic.py abandon   --run de_yaw_f025 --mode FULL      # only once the job is proven gone
    10	
    11	Ownership protocol: the run dir's ``.exp38_submitted/`` marker is created atomically (``mkdir``) with
    12	``intent.json`` = {token, state "submitting", ...} BEFORE ``sbatch``; the job name carries the token
    13	(``exp38-<run>-<mode>-<token8>``, also ``--comment exp38:<token>``); the job id is recorded after
    14	``sbatch`` (state "submitted"). A second submission for the same run dir is refused by the marker.
    15	``reconcile`` finds an interrupted submission's job by its token-bearing name (squeue + sacct; any
    16	query failure is fatal). ``abandon`` renames the run dir to ``<run>.abandoned_<ts>`` only when the
    17	token's job is terminal or provably never existed. SMOKE and FULL use distinct run dirs.
    18	
    19	Written by the exp_38 Coder (Claude Opus 5.5).
    20	"""
    21	import argparse
    22	import json
    23	import os
    24	import subprocess
    25	import sys
    26	import time
    27	import uuid
    28	
    29	HERE = os.path.dirname(os.path.realpath(__file__))
    30	sys.path.insert(0, HERE)
    31	import exp38_registry as reg  # noqa: E402
    32	
    33	TERMINAL = {"COMPLETED", "FAILED", "CANCELLED", "TIMEOUT", "OUT_OF_MEMORY", "NODE_FAIL", "PREEMPTED",
    34	            "BOOT_FAIL", "DEADLINE", "REVOKED"}
    35	LIVE = {"PENDING", "RUNNING", "CONFIGURING", "COMPLETING", "SUSPENDED", "REQUEUED", "RESIZING", "STOPPED",
    36	        "SIGNALING", "STAGE_OUT", "REQUEUE_HOLD", "REQUEUE_FED", "SPECIAL_EXIT"}
    37	SUBLOG = f"{reg.EXP_DIR}/exp38_neuronic_submissions.log"
    38	FLASH_VERSION_DEFAULT = reg.FLASH_VERSION
    39	
    40	
    41	class SubmitError(RuntimeError):
    42	    pass
    43	
    44	
    45	def resources(run):
    46	    _, _, rung = reg.parse_run_id(run)
    47	    n = reg.RUNGS[rung]["ngpu"]
    48	    return {"ngpu": n, "cpus": 8 + 7 * n, "mem": "64G" if n == 2 else "108G"}
    49	
    50	
    51	def run_dir(run, mode, token=None, save_root=None):
    52	    root = save_root or reg.PLATFORMS["neuronic"]["save_root"]
    53	    if mode == "FULL":
    54	        return os.path.join(root, run)
    55	    if token is None:
    56	        raise SubmitError("a SMOKE run dir needs its token")
    57	    return os.path.join(root, f"{run}_smoke_{token[:8]}")
    58	
    59	
    60	def job_name(run, mode, token):
    61	    return f"exp38-{run}-{mode.lower()}-{token[:8]}"
    62	
    63	
    64	def sbatch_argv(run, mode, token, head, time_limit, backend, flash_version, sd, allow_nonmatched):
    65	    r = resources(run)
    66	    exports = {"RUN": run, "MODE": mode, "EXPECT_SHA": head, "EXP38_TOKEN": token, "ATTN_BACKEND": backend,
    67	               "EXPECT_FLASH_VERSION": flash_version or "", "ALLOW_NONMATCHED_RUNG": "1" if allow_nonmatched else "0",
    68	               "SAVE_DIR": sd}
    69	    return ["sbatch", "--parsable", f"--job-name={job_name(run, mode, token)}", f"--comment=exp38:{token}",
    70	            f"--gres=gpu:l40:{r['ngpu']}", f"--cpus-per-task={r['cpus']}", f"--mem={r['mem']}",
    71	            f"--time={time_limit}", f"--chdir={reg.REPO}",
    72	            f"--output={reg.REPO}/{reg.EXP_DIR}/slurm_train_%x_%j.out",
    73	            "--export=ALL," + ",".join(f"{k}={v}" for k, v in exports.items()),
    74	            f"{reg.REPO}/{reg.EXP_DIR}/exp38_train.sbatch"]
    75	
    76	
    77	def _write_intent(path, rec):
    78	    tmp = path + ".tmp"
    79	    with open(tmp, "w") as fh:
    80	        json.dump(rec, fh, indent=1, sort_keys=True)
    81	        fh.flush()
    82	        os.fsync(fh.fileno())
    83	    os.replace(tmp, path)
    84	
    85	
    86	def _git(*args):
    87	    return subprocess.run(["git", "-C", reg.REPO, *args], capture_output=True, text=True, check=True).stdout.strip()
    88	
    89	
    90	def preflight(run, mode, allow_nonmatched, dry):
    91	    head = _git("rev-parse", "HEAD")
    92	    if _git("status", "--porcelain", "--untracked-files=no"):
    93	        raise SubmitError("tracked tree is not clean")
    94	    if not dry:
    95	        subprocess.run(["git", "-C", reg.REPO, "fetch", "-q", "origin", "exp-38-data-efficiency"], check=True)
    96	        if subprocess.run(["git", "-C", reg.REPO, "merge-base", "--is-ancestor", head, "FETCH_HEAD"]).returncode:
    97	            raise SubmitError(f"HEAD {head} is not pushed to origin/exp-38-data-efficiency")
    98	    reg.describe_run(run, "neuronic", allow_nonmatched=allow_nonmatched)
    99	    reg.check_e0_receipt("neuronic")
   100	    if mode == "FULL":
   101	        reg.check_smoke_receipt(run, "neuronic")
   102	    return head
   103	
   104	
   105	def _dry_preflight(run, allow_nonmatched):
   106	    """DRY_RUN: the recipe checks only (receipts are produced at campaign time)."""
   107	    reg.describe_run(run, "neuronic", allow_nonmatched=allow_nonmatched)
   108	    return _git("rev-parse", "HEAD")
   109	
   110	
   111	def submit(run, mode, time_limit, backend, flash_version, allow_nonmatched, dry, save_root=None, runner=subprocess.run):
   112	    if mode not in ("SMOKE", "FULL"):
   113	        raise SubmitError("mode must be SMOKE or FULL")
   114	    import re
   115	    if not re.fullmatch(r"(\d+-)?\d{1,3}:\d{2}:\d{2}", time_limit or ""):
   116	        raise SubmitError(f"--time {time_limit!r} is not a Slurm time (e.g. 24:00:00 or 3-00:00:00)")
   117	    head = preflight(run, mode, allow_nonmatched, dry) if not dry else _dry_preflight(run, allow_nonmatched)
   118	    token = uuid.uuid4().hex
   119	    sd = run_dir(run, mode, token, save_root)
   120	    argv = sbatch_argv(run, mode, token, head, time_limit, backend, flash_version, sd, allow_nonmatched)
   121	    if dry:
   122	        return {"dry_run": True, "run_dir": sd, "argv": argv}
   123	    reg.check_run_dir(sd, run, 0)
   124	    os.makedirs(sd, exist_ok=True)
   125	    marker = os.path.join(sd, ".exp38_submitted")
   126	    try:
   127	        os.mkdir(marker)
   128	    except FileExistsError:
   129	        raise SubmitError(f"{marker} exists: {run} {mode} was already submitted (reconcile / abandon)")
   130	    intent = {"token": token, "run": run, "mode": mode, "head": head, "time": time_limit, "backend": backend,
   131	              "job_name": job_name(run, mode, token), "state": "submitting", "ts": time.strftime("%Y-%m-%dT%H:%M:%S")}
   132	    _write_intent(os.path.join(marker, "intent.json"), intent)
   133	    out = runner(argv, capture_output=True, text=True)
   134	    if out.returncode != 0:
   135	        raise SubmitError(f"sbatch failed ({out.stderr.strip()}); the intent stays 'submitting' -> run reconcile")
   136	    jid = out.stdout.strip().split(";")[0]
   137	    if not jid.isdigit():
   138	        raise SubmitError(f"sbatch returned {out.stdout!r}; run reconcile")
   139	    intent.update(state="submitted", job_id=jid)
   140	    _write_intent(os.path.join(marker, "intent.json"), intent)
   141	    with open(os.path.join(reg.REPO, SUBLOG), "a") as fh:
   142	        fh.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {run} {mode} job {jid} token {token} head {head}: {' '.join(argv)}\n")
   143	    return {"run_dir": sd, "job_id": jid, "token": token}
