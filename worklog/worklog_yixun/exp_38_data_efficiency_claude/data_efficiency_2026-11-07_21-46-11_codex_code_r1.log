   370	def cmd_run(gpu, names, shared=False):
   371	    cells = {c["name"]: c for c in all_cells(bridge=True)}
   372	    unknown = [n for n in names if n not in cells]
   373	    if unknown:
   374	        raise EvalError(f"unknown cells {unknown}")
   375	    if os.path.realpath(reg.REPO) != reg.CAMPAIGN_ROOT["a6000"]:
   376	        raise EvalError(f"evaluation runs only from the campaign tree {reg.CAMPAIGN_ROOT['a6000']}")
   377	    head = subprocess.run(["git", "-C", reg.REPO, "rev-parse", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
   378	    if subprocess.run(["git", "-C", reg.REPO, "status", "--porcelain", "--untracked-files=no"],
   379	                      capture_output=True, text=True, check=True).stdout.strip():
   380	        raise EvalError("tracked tree is not clean")
   381	    os.environ["PYTHONNOUSERSITE"] = "1"
   382	    os.environ.pop("ENABLE_TORCH_COMPILE", None)
   383	    shadows = reg.check_untracked("a6000")
   384	    if shadows:
   385	        raise EvalError("campaign tree: " + "; ".join(shadows))
   386	    reg.env_receipt("a6000")
   387	    closure = reg.closure_digest()["closure_sha256"]
   388	    lockfile = os.path.join(LOCKDIR, f".exp38_card{gpu}.lock")
   389	    lock = open(lockfile, "a")
   390	    try:
   391	        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
   392	    except OSError:
   393	        lock.close()
   394	        raise EvalError(f"another exp_38 training / evaluation holds card {gpu} ({lockfile})")
   395	    try:
   396	        for n in names:
   397	            foreign = gpu_foreign(gpu)
   398	            if foreign and not shared:
   399	                raise EvalError(f"GPU {gpu} is not idle (pids {foreign})")
   400	            if cells[n]["dump"]:
   401	                st = os.statvfs(DUMP_ROOT)
   402	                if st.f_bavail * st.f_frsize < 260e6 * 1.5:
   403	                    raise EvalError("dump root has < 390 MB free")
   404	            print(f"{n}: {run_one(cells[n], gpu, closure, head)}", flush=True)
   405	    finally:
   406	        fcntl.flock(lock, fcntl.LOCK_UN)
   407	        lock.close()
