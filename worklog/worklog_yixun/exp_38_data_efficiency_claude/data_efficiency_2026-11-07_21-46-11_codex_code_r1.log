    77	class RunEvidenceCallback(pl.Callback):
    78	    def __init__(self, path):
    79	        super().__init__()
    80	        self.path = path
    81	        self._rec = None
    82	        self._restore = []
    83	        self._done = False
    84	
    85	    # ---------------------------------------------------------------- wrappers
    86	    def _install(self, pl_module):
    87	        rec = self._rec
    88	        rec.update({"flash_calls": 0, "sdpa_calls": 0, "checkpoint_calls": [], "conditioner_calls": []})
    89	        if _T.flash_attn_func is not None:
    90	            orig = _T.flash_attn_func
    91	
    92	            @functools.wraps(orig)
    93	            def flash(*a, **k):
    94	                rec["flash_calls"] += 1
    95	                return orig(*a, **k)
    96	            _T.flash_attn_func = flash
    97	            self._restore.append(lambda: setattr(_T, "flash_attn_func", orig))
    98	        real_f = _T.F
    99	        _T.F = _CountingF(real_f, rec)
   100	        self._restore.append(lambda: setattr(_T, "F", real_f))
   101	        orig_ckpt = torch.utils.checkpoint.checkpoint
   102	
   103	        @functools.wraps(orig_ckpt)
   104	        def ckpt(function, *a, **k):
   105	            rec["checkpoint_calls"].append({"use_reentrant": k.get("use_reentrant", "UNSET")})
   106	            return orig_ckpt(function, *a, **k)
   107	        torch.utils.checkpoint.checkpoint = ckpt
   108	        self._restore.append(lambda: setattr(torch.utils.checkpoint, "checkpoint", orig_ckpt))
   109	        cond = getattr(getattr(pl_module, "diffusion", None), "conditioner", None)
   110	        if cond is not None:
   111	            cls_forward = cond.forward
   112	
   113	            def cforward(batch_metadata, device, only_ids=None):
   114	                rec["conditioner_calls"].append([len(batch_metadata), None if only_ids is None else list(only_ids)])
   115	                return cls_forward(batch_metadata, device, only_ids=only_ids)
   116	            cond.forward = cforward
   117	            self._restore.append(lambda: vars(cond).pop("forward", None))
   118	
   119	    def _uninstall(self):
   120	        while self._restore:
   121	            self._restore.pop()()
   122	
   123	    # ---------------------------------------------------------------- hooks
   124	    def on_fit_start(self, trainer, pl_module):
   125	        mods = list(pl_module.modules())
   126	        bn = torch.nn.modules.batchnorm._BatchNorm
   127	        self._rec = {
   128	            "rank": int(trainer.global_rank), "local_rank": int(getattr(trainer, "local_rank", 0)),
   129	            "world_size": int(trainer.world_size), "num_nodes": int(getattr(trainer, "num_nodes", 1)),
   130	            "precision": str(getattr(trainer, "precision", "")),
   131	            "accumulate_grad_batches": getattr(trainer, "accumulate_grad_batches", None),
   132	            "max_steps": getattr(trainer, "max_steps", None),
   133	            "gradient_clip_val": getattr(trainer, "gradient_clip_val", None),
   134	            "strategy": type(getattr(trainer, "strategy", None)).__name__,
   135	            "global_step_at_fit_start": int(trainer.global_step),
   136	            "state_dict_sha256": state_dict_digest(pl_module.state_dict()),
   137	            "n_state_tensors": len(pl_module.state_dict()),
   138	            "sobol": sobol_state(getattr(pl_module, "rng", None)),
   139	            "rng_at_fit_start": rng_digests(),
   140	            "syncbn_modules": sum(isinstance(m, torch.nn.SyncBatchNorm) for m in mods),
   141	            "batchnorm_nonsync_modules": sum(isinstance(m, bn) and not isinstance(m, torch.nn.SyncBatchNorm) for m in mods),
   142	            # src.models.conditioners._make_vit_ckpt_forward: functools.wraps copies __name__, the
   143	            # code object keeps its own name
   144	            "vit_ckpt_wrapped_layers": sum(getattr(getattr(vars(m).get("forward"), "__code__", None), "co_name", "")
   145	                                           == "ckpt_forward" for m in mods),
   146	            "flash_attn_func_set": _T.flash_attn_func is not None,
   147	        }
   148	        self._install(pl_module)
   149	
   150	    def on_train_batch_end(self, trainer, pl_module, outputs, batch, batch_idx):
   151	        if self._done or self._rec is None or trainer.global_step < 1:
   152	            return
   153	        self._uninstall()
   154	        rec = self._rec
   155	        reals = batch[0] if isinstance(batch, (list, tuple)) and batch else None
   156	        rec["micro_batch"] = int(reals.shape[0]) if torch.is_tensor(reals) else None
   157	        rec["global_step_recorded"] = int(trainer.global_step)
   158	        out = f"{self.path}.rank{rec['rank']}.json"
   159	        os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
   160	        tmp = out + ".tmp"
   161	        with open(tmp, "w") as fh:
   162	            json.dump(rec, fh, indent=1, sort_keys=True)
   163	            fh.flush()
   164	            os.fsync(fh.fileno())
   165	        os.replace(tmp, out)
   166	        print(f"EXP38 RUN EVIDENCE rank {rec['rank']} written: {out}", flush=True)
   167	        self._done = True
   168	
   169	    def teardown(self, trainer, pl_module, stage):
   170	        self._uninstall()
