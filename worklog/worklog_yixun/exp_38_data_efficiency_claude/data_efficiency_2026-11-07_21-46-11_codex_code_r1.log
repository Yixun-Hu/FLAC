   156	def scheduler_state(name, runner=subprocess.run):
   157	    """(job ids, states) of every job with this exact name; any query failure is fatal."""
   158	    q = runner(["squeue", "-h", "-u", os.environ.get("USER", ""), "-n", name, "-o", "%i|%T"], capture_output=True, text=True)
   159	    a = runner(["sacct", "-n", "-X", "-P", "-u", os.environ.get("USER", ""), "--name", name, "-S", "now-30days",
   160	                "-o", "JobID,JobName%-80,State%-40"], capture_output=True, text=True)
   161	    if q.returncode or a.returncode:
   162	        raise SubmitError(f"scheduler query failed (squeue rc {q.returncode}, sacct rc {a.returncode})")
   163	    jobs = {}
   164	    for line in q.stdout.strip().split("\n"):
   165	        if line.strip():
   166	            jid, st = line.strip().split("|")
   167	            jobs[jid] = st.strip()
   168	    for line in a.stdout.strip().split("\n"):
   169	        if line.strip():
   170	            jid, jname, st = line.strip().split("|")
   171	            if jname.strip() == name:
   172	                jobs.setdefault(jid, st.strip().split()[0])
   173	    for jid, st in jobs.items():
   174	        if st not in TERMINAL and st not in LIVE:
   175	            raise SubmitError(f"job {jid}: unrecognised state {st!r}")
   176	    return jobs
   177	
   178	
   179	def reconcile(run, mode, save_root=None, runner=subprocess.run):
   180	    sd, intent = find_intent(run, mode, save_root)
   181	    jobs = scheduler_state(intent["job_name"], runner)
   182	    if intent.get("state") == "submitting" and len(jobs) == 1:
   183	        intent.update(state="submitted", job_id=next(iter(jobs)), reconciled=True)
   184	        _write_intent(os.path.join(sd, ".exp38_submitted", "intent.json"), intent)
   185	    return {"run_dir": sd, "intent": intent, "jobs": jobs}
   186	
   187	
   188	def abandon(run, mode, save_root=None, runner=subprocess.run):
   189	    sd, intent = find_intent(run, mode, save_root)
   190	    jobs = scheduler_state(intent["job_name"], runner)
   191	    live = {j: s for j, s in jobs.items() if s not in TERMINAL}
   192	    if live:
   193	        raise SubmitError(f"job(s) {live} of this intent are not terminal: scancel them first")
   194	    if intent.get("state") == "submitted" and intent.get("job_id") not in jobs:
   195	        raise SubmitError(f"recorded job {intent.get('job_id')} is not visible to the scheduler: refuse to guess")
   196	    dest = f"{sd}.abandoned_{time.strftime('%Y%m%dT%H%M%S')}"
   197	    os.rename(sd, dest)
   198	    return {"abandoned": sd, "moved_to": dest, "jobs": jobs}
   199	
   200	
   201	def main(argv=None):
   202	    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   203	    sub = p.add_subparsers(dest="cmd", required=True)
   204	    for name in ("submit", "reconcile", "abandon"):
   205	        s = sub.add_parser(name)
   206	        s.add_argument("--run", required=True)
   207	        s.add_argument("--mode", required=True, choices=("SMOKE", "FULL"))
   208	        if name == "submit":
   209	            s.add_argument("--time", required=True)
   210	            s.add_argument("--backend", default="flash", choices=("flash", "sdpa"))
   211	            s.add_argument("--flash-version", default=FLASH_VERSION_DEFAULT)
   212	            s.add_argument("--allow-nonmatched-rung", action="store_true")
   213	            s.add_argument("--dry-run", action="store_true")
   214	    a = p.parse_args(argv)
   215	    try:
   216	        if a.cmd == "submit":
   217	            out = submit(a.run, a.mode, a.time, a.backend, a.flash_version if a.backend == "flash" else "",
   218	                         a.allow_nonmatched_rung, a.dry_run)
   219	        elif a.cmd == "reconcile":
   220	            out = reconcile(a.run, a.mode)
   221	        else:
   222	            out = abandon(a.run, a.mode)
   223	        print(json.dumps(out, indent=1))
   224	    except (SubmitError, reg.GateError, subprocess.CalledProcessError, OSError, ValueError) as err:
   225	        print(f"EXP38 SUBMIT REFUSED: {err}", file=sys.stderr)
   226	        return 2
   227	    return 0
   228	
   229	
   230	if __name__ == "__main__":
   231	    sys.exit(main())

