   870	def env_receipt(platform, write=False, repo=None):
   871	    """Write once (``write=True``) or check: the campaign environment must not drift between runs."""
   872	    path = _abs(env_receipt_rel(platform), repo)
   873	    now = env_snapshot()
   874	    if platform == "a6000" and now.get("flash_attn") != FLASH_VERSION:
   875	        raise GateError(f"flash-attn {now.get('flash_attn')} != pinned {FLASH_VERSION}")
   876	    if write:
   877	        if os.path.exists(path):
   878	            raise GateError(f"{path} exists (the environment receipt is written once)")
   879	        with open(path, "w") as fh:
   880	            json.dump(now, fh, indent=1, sort_keys=True)
   881	            fh.write("\n")
   882	        return {"env_receipt": path, "sha256": sha256_file(path), "written": True}
   883	    try:
   884	        pinned = json.load(open(path))
   885	    except OSError:
   886	        raise GateError(f"no environment receipt {path}: write it at campaign start (E0)")
   887	    if pinned != now:
   888	        diff = {k: (pinned.get(k), now.get(k)) for k in set(pinned) | set(now) if pinned.get(k) != now.get(k)}
   889	        raise GateError(f"environment drift vs the campaign receipt: {diff}")
   890	    return {"env_receipt": path, "sha256": sha256_file(path)}
