    39	
    40	class _Captured(Exception):
    41	    pass
    42	
    43	
    44	def _ar_md_pool(path, allowed=None):
    45	    """The candidate list AR_md hands to np.random.choice for this target."""
    46	    seen = {}
    47	    real = np.random.choice
    48	
    49	    def spy(pool, *a, **k):
    50	        seen["pool"] = [os.path.basename(p) for p in pool]
    51	        raise _Captured
    52	    np.random.choice = spy
    53	    try:
    54	        ar_md.get_ir_and_location_for_other_sources(path, 8, "unused", allowed_basenames=allowed)
    55	    except _Captured:
    56	        pass
    57	    finally:
    58	        np.random.choice = real
    59	    return seen["pool"]
    60	
