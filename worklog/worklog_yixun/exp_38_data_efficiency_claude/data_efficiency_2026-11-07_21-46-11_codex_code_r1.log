    31	def state_dict_digest(sd):
    32	    """sha256 over (key, dtype, shape, raw bytes) in sorted-key order."""
    33	    h = hashlib.sha256()
    34	    for key in sorted(sd):
    35	        v = sd[key]
    36	        h.update(key.encode())
    37	        if torch.is_tensor(v):
    38	            h.update(f"|{v.dtype}|{tuple(v.shape)}|".encode())
    39	            h.update(_tensor_bytes(v))
    40	        else:
    41	            h.update(f"|{type(v).__name__}|{v!r}|".encode())
    42	    return h.hexdigest()
