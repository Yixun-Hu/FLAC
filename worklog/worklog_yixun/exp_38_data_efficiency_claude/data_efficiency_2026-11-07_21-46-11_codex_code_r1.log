   147	def bound_map(dataset_root):
   148	    files = [AR_MD, DATASET_PY, MANIFEST, TRAIN_JSON, os.path.relpath(os.path.realpath(__file__), reg.REPO)]
   149	    for t in reg.FRACS:
   150	        files += [reg.FRACS[t]["split"], reg.FRACS[t]["dataset_config"]]
   151	    out = {rel: reg.sha256_file(rel) for rel in sorted(set(files))}
   152	    out["realpath(" + dataset_root + ")"] = os.path.realpath(dataset_root)
   153	    return out
