   369	
   370	def fresh_inventory(arm, rung, repo=None):
   371	    """(state_dict {key: (shape, dtype)}, optimizer-group param shapes, wrapper) of a freshly built
   372	    CPU wrapper of the arm config -- the reference the checkpoint inventory must equal."""
   373	    key = (arm, rung, repo or REPO)
   374	    if key not in _FRESH:
   375	        os.environ.setdefault("HF_HUB_OFFLINE", "1")
   376	        if (repo or REPO) not in sys.path:
   377	            sys.path.insert(0, repo or REPO)
   378	        from src.models import create_model_from_config
   379	        from src.training import create_training_wrapper_from_config
   380	        cfg = json.load(open(_abs(model_config_rel(arm, rung), repo)))
   381	        wrapper = create_training_wrapper_from_config(cfg, create_model_from_config(cfg))
   382	        inv = {k: (tuple(v.shape), str(v.dtype)) for k, v in wrapper.state_dict().items()}
   383	        opt = wrapper.configure_optimizers()
   384	        opt = opt[0][0] if isinstance(opt, tuple) else (opt["optimizer"] if isinstance(opt, dict) else opt)
   385	        opt = opt[0] if isinstance(opt, (list, tuple)) else opt
   386	        shapes = [tuple(p.shape) for p in opt.param_groups[0]["params"]]
   387	        _FRESH[key] = (inv, shapes, wrapper)
   388	    return _FRESH[key]
