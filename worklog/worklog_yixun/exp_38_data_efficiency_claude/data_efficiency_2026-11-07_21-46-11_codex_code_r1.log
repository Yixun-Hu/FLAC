   153	def strict_equal(a, b, path="$"):
   154	    """Recursive, type-strict equality; returns the first differing path or None."""
   155	    if type(a) is not type(b):
   156	        return f"{path}: {type(a).__name__} != {type(b).__name__}"
   157	    if isinstance(a, dict):
   158	        if set(a) != set(b):
   159	            return f"{path}: keys {sorted(set(a) ^ set(b))}"
   160	        for k in sorted(a):
   161	            d = strict_equal(a[k], b[k], f"{path}.{k}")
   162	            if d:
   163	                return d
   164	        return None
   165	    if isinstance(a, list):
   166	        if len(a) != len(b):
   167	            return f"{path}: length {len(a)} != {len(b)}"
   168	        for i, (x, y) in enumerate(zip(a, b)):
   169	            d = strict_equal(x, y, f"{path}[{i}]")
   170	            if d:
   171	                return d
   172	        return None
   173	    return None if a == b else f"{path}: {a!r} != {b!r}"
