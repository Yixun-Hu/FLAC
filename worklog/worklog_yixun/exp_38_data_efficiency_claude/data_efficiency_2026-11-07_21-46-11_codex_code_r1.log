   937	def write_smoke_receipt(out, run, platform, evidence_dir, rc, n_ckpt, log_gate_line, evidence_gate_line,
   938	                        verdict, head, repo=None):
   939	    """The SMOKE_DDP receipt FULL validates (plan r2 §10 B6 schema)."""
   940	    import subprocess
   941	    if os.path.exists(out):
   942	        raise GateError(f"{out} exists")
   943	    full = build_train_argv(run, platform)
   944	    proj = [a for i, a in enumerate(full)
   945	            if not (a.startswith("/") or (i and full[i - 1] in ("--max-steps", "--checkpoint-every", "--name",
   946	                                                                  "--experiment-name", "--save-dir", "--evidence-json")))]
   947	    ev = {}
   948	    for path in sorted(glob.glob(os.path.join(evidence_dir, "run_evidence.json.rank*.json"))):
   949	        ev[os.path.basename(path)] = json.load(open(path))
   950	    arm, tag, rung = parse_run_id(run)
   951	    gpus = subprocess.run(["nvidia-smi", "--query-gpu=index,uuid,name", "--format=csv,noheader"],
   952	                          capture_output=True, text=True).stdout.strip().split("\n")
   953	    rec = {"mode": "SMOKE_DDP", "run": run, "platform": platform, "head": head,
   954	           "closure_sha256": closure_digest(repo)["closure_sha256"],
   955	           "env_receipt_sha256": sha256_file(_abs(env_receipt_rel(platform), repo)),
   956	           "argv_projection": proj, "model_config_sha256": sha256_file(_abs(model_config_rel(arm, rung), repo)),
   957	           "dataset_config_sha256": FRACS[tag]["dataset_config_sha256"], "split_sha256": FRACS[tag]["split_sha256"],
   958	           "rc": int(rc), "checkpoints_written": int(n_ckpt), "log_gate": log_gate_line,
   959	           "evidence_gate": evidence_gate_line, "evidence": ev, "gpus": gpus, "verdict": verdict}
   960	    if verdict == "PASS" and (rec["rc"] or rec["checkpoints_written"] or log_gate_line != "LOG GATE PASS"
   961	                              or evidence_gate_line != "EVIDENCE GATE PASS" or len(ev) != RUNGS[rung]["ngpu"]):
   962	        raise GateError("a PASS smoke receipt needs rc 0, no checkpoint, both gates PASS and every rank's evidence")
   963	    text = json.dumps(rec, indent=1, sort_keys=True).encode()
   964	    with open(out, "wb") as fh:
   965	        fh.write(text)
   966	    with open(out + ".sha256", "w") as fh:
   967	        fh.write(f"{hashlib.sha256(text).hexdigest()}  {os.path.basename(out)}\n")
   968	    return {"smoke_receipt": out, "verdict": verdict}
