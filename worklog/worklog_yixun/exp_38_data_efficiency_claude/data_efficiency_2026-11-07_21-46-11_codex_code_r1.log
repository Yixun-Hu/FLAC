   135	def root_fingerprint(dataset_root, listings=None):
   136	    """sha256 over every room directory's sorted listing (the 243 rooms of train.json)."""
   137	    tr = json.load(open(TRAIN_JSON))
   138	    h = hashlib.sha256()
   139	    for scene in sorted(tr):
   140	        for room in sorted(tr[scene]):
   141	            d = os.path.join(dataset_root, FOLDER, scene, room)
   142	            lst = listings[d][0] if listings and d in listings else sorted(os.listdir(d))
   143	            h.update(f"{scene}/{room}\0{chr(0).join(lst)}\n".encode())
   144	    return h.hexdigest()
