   176	def expected_ckpt_sha(cell, offline=False):
   177	    """The admitted final checkpoint's sha: from the NAS run dir's CHECKPOINTS.sha256, or (offline,
   178	    e.g. the table generator on another host) from the copy ``prepare`` placed beside the farm link."""
   179	    if cell["e0"]:
   180	        return E0[cell["e0"]]["sha"]
   181	    rd = os.path.dirname(_abs(cell["ckpt_link"])) if offline else \
   182	        os.path.join(reg.PLATFORMS["a6000"]["save_root"], cell["run"])
   183	    name = os.path.basename(cell["ckpt_link"])
   184	    for line in open(os.path.join(rd, "CHECKPOINTS.sha256")).read().strip().split("\n"):
   185	        digest, n = line.split("  ", 1)
   186	        if n == name:
   187	            return digest
   188	    raise EvalError(f"{name} not in {rd}/CHECKPOINTS.sha256")
