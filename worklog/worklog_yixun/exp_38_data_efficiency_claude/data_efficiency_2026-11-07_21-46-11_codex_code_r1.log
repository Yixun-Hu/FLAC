    42	def test_state_dict_digest_is_order_free_dtype_and_value_sensitive():
    43	    a = {"x": torch.zeros(3), "y": torch.ones(2, dtype=torch.bfloat16), "s": torch.tensor(5)}
    44	    b = {"s": torch.tensor(5), "y": torch.ones(2, dtype=torch.bfloat16), "x": torch.zeros(3)}
    45	    assert rev.state_dict_digest(a) == rev.state_dict_digest(b)
    46	    assert rev.state_dict_digest(a) != rev.state_dict_digest({**a, "x": torch.zeros(3, dtype=torch.float64)})
    47	    assert rev.state_dict_digest(a) != rev.state_dict_digest({**a, "s": torch.tensor(6)})
