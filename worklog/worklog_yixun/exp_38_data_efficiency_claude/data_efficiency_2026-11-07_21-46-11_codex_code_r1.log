    63	class _CountingF:
    64	    """Stands in for ``torch.nn.functional`` inside src.models.transformer only: counts
    65	    ``scaled_dot_product_attention`` and forwards every attribute unchanged."""
    66	    def __init__(self, real, counter):
    67	        self._real, self._counter = real, counter
    68	
    69	    def scaled_dot_product_attention(self, *a, **k):
    70	        self._counter["sdpa_calls"] += 1
    71	        return self._real.scaled_dot_product_attention(*a, **k)
    72	
    73	    def __getattr__(self, name):
    74	        return getattr(self._real, name)
