   502	def build_train_argv(run, platform, save_root=None, resume_step=0, allow_nonmatched=False):
   503	    """argv for train.py (the caller prefixes ``python`` or ``torchrun …``). Monolithic 0 -> 40,000;
   504	    ``resume_step`` > 0 only for a crash restart (the run is then non-primary, plan §6)."""
   505	    arm, tag, rung = parse_run_id(run)
   506	    r = check_rung(platform, rung, allow_nonmatched)
   507	    leg_start, leg_end = resume_step, MAX_STEPS
   508	    check_leg(leg_start, leg_end)
   509	    sd = save_dir(platform, run, save_root)
   510	    argv = ["train.py",
   511	            "--model-config", model_config_rel(arm, rung),
   512	            "--dataset-config", FRACS[tag]["dataset_config"],
   513	            "--pretransform-ckpt-path", VAE_PATH,
   514	            "--max-steps", str(leg_end),
   515	            "--batch-size", str(r["micro"]), "--accum-batches", "1", "--num-workers", "6",
   516	            "--seed", str(SEED), "--num-gpus", str(r["ngpu"]), "--num-nodes", "1",
   517	            "--strategy", "ddp_find_unused_parameters_true", "--sync-batchnorm", "true",
   518	            "--precision", "bf16-mixed", "--val-every", "-1", "--gradient-clip-val", "0.0",
   519	            "--logger", "none", "--checkpoint-every", str(CADENCE),
   520	            "--name", run, "--experiment-name", run, "--save-dir", sd,
   521	            "--evidence-json", os.path.join(sd, "evidence", "run_evidence.json")]
   522	    if leg_start:
   523	        argv += ["--ckpt-path", os.path.join(sd, ckpt_name(leg_start, tag))]
   524	    if r["ngpu"] * r["micro"] != EFF_BATCH or any("exp14_" in a for a in argv):
   525	        raise GateError("argv invariant broken")
   526	    return argv
