   244	    if (tr.get("timestep_sampler"), tr.get("cfg_dropout_prob")) != ("log_snr", 0.1):
   245	        raise GateError(f"{rel}: timestep_sampler / cfg_dropout_prob off-recipe")
   246	    for key in ("canonicalize", "are_lambda", "are_anchor"):
   247	        if key in tr:
   248	            raise GateError(f"{rel}: unexpected training.{key}")
   249	    return cfg
