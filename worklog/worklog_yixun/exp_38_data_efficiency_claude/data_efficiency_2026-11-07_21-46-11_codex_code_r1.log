   270	def prepare(run):
   271	    arm, tag, rung = reg.parse_run_id(run)
   272	    rd = os.path.join(reg.PLATFORMS["a6000"]["save_root"], run)
   273	    name = reg.ckpt_name(reg.MAX_STEPS, tag)
   274	    want = expected_ckpt_sha(run_cells(run)[0])
   275	    audit = reg.audit_ckpt(os.path.join(rd, name), run, reg.MAX_STEPS, run_dir=rd)
   276	    if audit["sha256"] != want:
   277	        raise EvalError(f"{name} sha {audit['sha256']} != CHECKPOINTS.sha256 {want}")
   278	    _link(f"{FARM}/{run}/{name}", os.path.join(rd, name))
   279	    copy = _abs(f"{FARM}/{run}/CHECKPOINTS.sha256")          # offline evidence for the table generator
   280	    src = open(os.path.join(rd, "CHECKPOINTS.sha256")).read()
   281	    if os.path.exists(copy) and open(copy).read() != src:
   282	        raise EvalError(f"{copy} differs from the NAS manifest")
   283	    open(copy, "w").write(src)
   284	    return {"run": run, "admitted": audit}
