    29	def _tree(tmp_path, rooms):
    30	    """rooms: {(scene, room): [(src, rec), ...]} -> dataset root path."""
    31	    root = tmp_path / "AcousticRooms"
    32	    for (scene, room), pairs in rooms.items():
    33	        d = root / audit.FOLDER / scene / room
    34	        d.mkdir(parents=True)
    35	        for s, r in pairs:
    36	            (d / f"S00{s}_R00{r}_hybrid_IR.wav").write_bytes(b"")   # real AR naming: S000 ... S0011
    37	    return str(root)
