   362	# optimizer state entries of a 40k checkpoint of this architecture (dc_van_f025, YAW / B-F 100 %:
   363	# 449 of the 753 group parameters receive gradients; the rest never get Adam state)
   364	N_OPT_STATE = 449
   365	MODEL_CHECKPOINT_KEY = ("ModelCheckpoint{'monitor': None, 'mode': 'min', 'every_n_train_steps': 2500, "
   366	                        "'every_n_epochs': 0, 'train_time_interval': None}")
   367	_FRESH = {}
