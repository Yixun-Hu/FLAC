   805	def check_untracked(platform, repo=None):
   806	    """Refuse import shadows and unexpected links in the campaign tree (Codex plan r2 HIGH 7)."""
   807	    import subprocess
   808	    repo = repo or REPO
   809	    p = []
   810	    untracked = subprocess.run(["git", "-C", repo, "ls-files", "-z", "--others", "--exclude-standard"],
   811	                               capture_output=True, check=True).stdout.decode().split("\0")
   812	    allow = SYMLINK_ALLOWLIST.get(platform)
   813	    names = set(allow if allow is not None else SYMLINK_ALLOWLIST["a6000"])   # neuronic: names only
   814	    for rel in filter(None, untracked):
   815	        if rel.startswith(("worklog/", "outputs_FLAC/")) and not rel.endswith(".py"):
   816	            continue
   817	        if rel in names:
   818	            continue
   819	        p.append(f"unexpected untracked entry {rel}")
   820	    if allow is not None:
   821	        for rel, target in allow.items():
   822	            path = os.path.join(repo, rel)
   823	            if not os.path.islink(path) or os.readlink(path) != target:
   824	                p.append(f"{rel} is not the symlink -> {target}")
   825	    for top in ("", "src", "src/models", "src/training", "src/data", "overlays"):
   826	        d = os.path.join(repo, top)
   827	        for name in (os.listdir(d) if os.path.isdir(d) else []):
   828	            if name in SHADOW_NAMES:
   829	                p.append(f"import shadow {os.path.join(top, name)}")
   830	    for k in ("ENABLE_TORCH_COMPILE", "PYTHONSTARTUP", "PYTHONINSPECT"):
   831	        if os.environ.get(k):
   832	            p.append(f"environment variable {k} is set")
   833	    if os.environ.get("PYTHONNOUSERSITE") != "1":
   834	        p.append("PYTHONNOUSERSITE=1 is required")
   835	    return p
