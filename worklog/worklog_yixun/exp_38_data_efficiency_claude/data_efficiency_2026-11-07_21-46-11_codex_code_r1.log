   781	def closure_files(repo=None):
   782	    import subprocess
   783	    repo = repo or REPO
   784	    out = subprocess.run(["git", "-C", repo, "ls-files", "-z", "--", *CLOSURE_ROOTS, EXP_DIR, *EXTERNAL_CONFIGS],
   785	                         capture_output=True, check=True).stdout.decode().split("\0")
   786	    files = []
   787	    for rel in out:
   788	        if not rel or rel.startswith("src/tests/"):
   789	            continue
   790	        if rel.startswith(EXP_DIR + "/") and not os.path.basename(rel).startswith(CLOSURE_EXP_PREFIXES):
   791	            continue
   792	        files.append(rel)
   793	    return sorted(set(files))
