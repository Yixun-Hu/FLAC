    38	def _env(**kw):
    39	    env = {k: v for k, v in os.environ.items() if not k.startswith(("EXP38_", "MODE", "RUN", "RESUME"))}
    40	    env["PATH"] = os.path.join(ENV_PREFIX, "bin") + os.pathsep + env.get("PATH", "")
    41	    env.update({k: str(v) for k, v in kw.items()})
    42	    return env
