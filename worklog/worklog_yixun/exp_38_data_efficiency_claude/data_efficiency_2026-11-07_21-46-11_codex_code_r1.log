   145	def _finite_tree(x):
   146	    if isinstance(x, dict):
   147	        return all(_finite_tree(v) for v in x.values())
   148	    if isinstance(x, (int, float)) and not isinstance(x, bool):
   149	        return math.isfinite(x)
   150	    return True
