    64	class _Wrapper(torch.nn.Module):
    65	    """Stands in for DiffusionCondTrainingWrapper: .diffusion.conditioner, .rng, a BN, a ViT layer."""
    66	    def __init__(self, sync=False):
    67	        super().__init__()
    68	        self.diffusion = torch.nn.Module()
    69	        self.diffusion.conditioner = _Cond()
    70	        self.bn = torch.nn.SyncBatchNorm(4) if sync else torch.nn.BatchNorm1d(4)
    71	        self.layer = torch.nn.Linear(2, 2)
    72	        from src.models.conditioners import _make_vit_ckpt_forward
    73	        self.layer.forward = _make_vit_ckpt_forward(self.layer, self.layer.forward)
    74	        self.rng = torch.quasirandom.SobolEngine(1, scramble=True)
