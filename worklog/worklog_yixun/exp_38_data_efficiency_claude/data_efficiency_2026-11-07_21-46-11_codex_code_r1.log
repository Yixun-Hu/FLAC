   106	def test_worker_seeding_depends_only_on_seed_rank_and_worker(monkeypatch):
   107	    import random
   108	    import numpy as np
   109	    from lightning_fabric.utilities.seed import pl_worker_init_function
   110	
   111	    def draw(rank, worker):
   112	        # inside a DataLoader worker torch.initial_seed() is the loader's base seed + worker id;
   113	        # emulate a fixed base seed so only (rank, worker) vary
   114	        torch.manual_seed(10_000 + worker)
   115	        pl_worker_init_function(worker, rank=rank)
   116	        return random.random(), float(np.random.rand()), float(torch.rand(1))
   117	    assert draw(1, 3) == draw(1, 3)
   118	    assert draw(1, 3) != draw(0, 3) and draw(1, 3) != draw(1, 2)
