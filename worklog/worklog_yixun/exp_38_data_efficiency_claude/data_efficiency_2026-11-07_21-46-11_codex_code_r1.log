   195	def validate_cell(cell, source_sha=None, offline=False):
   196	    """Problems (empty = admitted) of one finished cell (plan r2 §9.4). ``offline``: no NAS read --
   197	    the checkpoint sha and the dump manifest come from the copies kept beside the cell."""
   198	    p = []
   199	    try:
   200	        rec = json.load(open(_abs(cell["metrics"])))
