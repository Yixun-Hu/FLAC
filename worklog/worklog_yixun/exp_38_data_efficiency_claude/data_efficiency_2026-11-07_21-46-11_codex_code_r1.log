    26	def _tensor_bytes(t):
    27	    t = t.detach().to("cpu").contiguous().reshape(-1)
    28	    return t.view(torch.uint8).numpy().tobytes() if t.numel() else b""
    29	
    30	
    31	def state_dict_digest(sd):
    32	    """sha256 over (key, dtype, shape, raw bytes) in sorted-key order."""
    33	    h = hashlib.sha256()
    34	    for key in sorted(sd):
    35	        v = sd[key]
    36	        h.update(key.encode())
    37	        if torch.is_tensor(v):
    38	            h.update(f"|{v.dtype}|{tuple(v.shape)}|".encode())
    39	            h.update(_tensor_bytes(v))
    40	        else:
    41	            h.update(f"|{type(v).__name__}|{v!r}|".encode())
    42	    return h.hexdigest()
    43	
    44	
    45	def rng_digests():
    46	    out = {"python": hashlib.sha256(repr(random.getstate()).encode()).hexdigest()}
    47	    st = np.random.get_state()
    48	    out["numpy"] = hashlib.sha256(st[1].tobytes() + repr(st[2:]).encode()).hexdigest()
    49	    out["torch_cpu"] = hashlib.sha256(torch.get_rng_state().numpy().tobytes()).hexdigest()
    50	    if torch.cuda.is_available() and torch.cuda.is_initialized():
    51	        out["torch_cuda"] = hashlib.sha256(torch.cuda.get_rng_state().numpy().tobytes()).hexdigest()
    52	    return out
    53	
    54	
    55	def sobol_state(engine):
    56	    if not isinstance(engine, torch.quasirandom.SobolEngine):
    57	        return None
    58	    h = hashlib.sha256(_tensor_bytes(engine.quasi) + _tensor_bytes(engine.shift) + _tensor_bytes(engine.sobolstate))
    59	    return {"dimension": engine.dimension, "num_generated": int(engine.num_generated),
    60	            "scramble": bool(engine.scramble), "state_sha256": h.hexdigest()}
