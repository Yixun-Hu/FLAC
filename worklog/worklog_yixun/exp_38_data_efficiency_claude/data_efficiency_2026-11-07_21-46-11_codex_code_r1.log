    65	def test_loop_and_cap_equal_batch_are_bit_identical_in_training_mode(monkeypatch):
    66	    from src.models.conditioners import create_multi_conditioner_from_conditioning_config
    67	    os.environ.setdefault("HF_HUB_OFFLINE", "1")
    68	    cfg = json.load(open(CFG))
    69	    assert cfg["training"]["frame_avg_max_fwd_samples"] == 32
    70	    # Two independent builds under the same seed (NOT deepcopy: the ViT checkpoint wrapper is an
    71	    # instance-level closure over its own layer, which deepcopy would share between the copies).
    72	    torch.manual_seed(0)
    73	    cond_a = create_multi_conditioner_from_conditioning_config(cfg["model"]["conditioning"])
    74	    torch.manual_seed(0)
    75	    cond_b = create_multi_conditioner_from_conditioning_config(cfg["model"]["conditioning"])
    76	    sa, sb = cond_a.state_dict(), cond_b.state_dict()
    77	    assert sa.keys() == sb.keys() and all(torch.equal(sa[k], sb[k]) for k in sa)
    78	    assert not set(map(id, cond_a.parameters())) & set(map(id, cond_b.parameters()))
