    23	def _load(name):
    24	    sys.path.insert(0, EXP)
    25	    spec = importlib.util.spec_from_file_location(name, os.path.join(EXP, f"{name}.py"))
    26	    mod = importlib.util.module_from_spec(spec)
    27	    spec.loader.exec_module(mod)
    28	    return mod
