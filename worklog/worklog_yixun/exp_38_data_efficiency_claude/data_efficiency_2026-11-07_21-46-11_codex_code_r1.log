   142	    sha = publish(rows, pending)
   143	    print(f"published {OUT_MD} / {OUT_JSON} (json sha256 {sha[:12]}), {len(pending)} pending item(s)")
   144	    return 0
   145	
   146	
   147	if __name__ == "__main__":
   148	    sys.exit(main())

