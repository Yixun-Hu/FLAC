   704	def snapshot_tools(run, dest, repo=None):
   705	    """Copy the files the start / end audits read into ``dest`` (refuses an existing dest) and
   706	    write ``SNAPSHOT.sha256``; the audits then run ``python <dest>/<registry> --repo <dest> …``."""
   707	    import shutil
   708	    if os.path.exists(dest):
   709	        raise GateError(f"snapshot dir {dest} exists")
   710	    lines = []
   711	    for rel in snapshot_files(run, repo):
   712	        src = _abs(rel, repo)
   713	        out = os.path.join(dest, rel)
   714	        os.makedirs(os.path.dirname(out), exist_ok=True)
   715	        shutil.copyfile(src, out)
   716	        lines.append(f"{sha256_file(out)}  {rel}")
   717	    os.makedirs(os.path.join(dest, ".git"), exist_ok=True)      # repo marker for _repo_root
   718	    with open(os.path.join(dest, "SNAPSHOT.sha256"), "w") as fh:
   719	        fh.write("\n".join(lines) + "\n")
   720	    return {"snapshot": dest, "files": len(lines)}
