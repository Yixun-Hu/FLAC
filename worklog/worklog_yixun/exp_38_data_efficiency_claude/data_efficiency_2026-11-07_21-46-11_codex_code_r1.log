    51	def build_trainer_kwargs(args, strategy, callbacks, logger, checkpoint_dir, val_args):
    52	    """Assemble the pl.Trainer keyword arguments (side-effect free; unit-testable).
    53	
    54	    Reproduces the kwargs that were previously inlined into pl.Trainer(...) exactly;
    55	    the only behavioral change is that max_steps is now sourced from args.max_steps
    56	    (default 1000000 via defaults.ini) instead of a hard-coded literal, so a training
    57	    budget can be set without editing code. strategy / callbacks / logger /
    58	    checkpoint_dir / val_args are the values main() derives and passes straight through.
    59	
    60	    sync_batchnorm (default off -> key ABSENT, so the kwargs are byte-identical to the
    61	    pre-change dict and PL's own default False applies) forwards to
    62	    Trainer(sync_batchnorm=True) only when enabled. It is a multi-GPU-only feature, so
    63	    enabling it with num_gpus < 2 is a fail-closed ValueError (Yixun mandate) rather than
    64	    a silently-ignored no-op. The guard lives here so both construct_trainer/main() and
    65	    any direct caller hit it; val_args may NOT smuggle the key past the guard.
    66	    """
    67	    if "sync_batchnorm" in val_args:
    68	        raise ValueError("sync_batchnorm must come from args (guarded), not val_args")
    69	    sync_batchnorm = _as_bool(getattr(args, "sync_batchnorm", False))
    70	    if sync_batchnorm and args.num_gpus < 2:
    71	        raise ValueError(
    72	            "sync_batchnorm=True requires multi-GPU training (num_gpus >= 2); got "
    73	            f"num_gpus={args.num_gpus}. SyncBatchNorm synchronises BatchNorm statistics "
    74	            "across ranks and is a no-op / unsupported on a single device -- set "
    75	            "--num-gpus >= 2 or drop --sync-batchnorm."
    76	        )
    77	    kwargs = {
    78	        "devices": args.num_gpus,
    79	        "accelerator": "gpu",
    80	        "num_nodes": args.num_nodes,
    81	        "strategy": strategy,
    82	        "precision": args.precision,
    83	        "accumulate_grad_batches": args.accum_batches,
    84	        "callbacks": callbacks,
    85	        "logger": logger,
    86	        "log_every_n_steps": 100,
    87	        "max_steps": args.max_steps, # HAA finetune recipe: --max-steps 1000
    88	        "default_root_dir": checkpoint_dir,
    89	        "gradient_clip_val": args.gradient_clip_val,
    90	        "reload_dataloaders_every_n_epochs": 0,
    91	        "num_sanity_val_steps": 0, # If you need to debug validation, change this line
    92	        **val_args,
    93	    }
    94	    if sync_batchnorm:
    95	        kwargs["sync_batchnorm"] = True  # multi-GPU only; guarded above (fail-closed)
    96	    return kwargs
    97	
    98	def construct_trainer(args, strategy, callbacks, logger, checkpoint_dir, val_args):
    99	    """Construct the pl.Trainer from the assembled kwargs (the tested Trainer boundary)."""
   100	    return pl.Trainer(**build_trainer_kwargs(args, strategy, callbacks, logger, checkpoint_dir, val_args))
