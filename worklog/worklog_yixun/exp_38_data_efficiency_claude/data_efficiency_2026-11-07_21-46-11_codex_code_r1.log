   603	_FOUND = re.compile(r"Found (\d+) files in (\d+) subfolders")
   604	_MEMBER = re.compile(r"Initializing distributed: GLOBAL_RANK: (\d+), MEMBER: (\d+)/(\d+)")
   605	_STEP = re.compile(r"Epoch \d+:\s+\d+%\|[^|]*\|\s*([1-9]\d*)/\d+")
