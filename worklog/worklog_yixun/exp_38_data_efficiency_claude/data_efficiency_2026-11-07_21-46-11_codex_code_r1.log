   146	def find_intent(run, mode, save_root=None):
   147	    root = save_root or reg.PLATFORMS["neuronic"]["save_root"]
   148	    cands = [os.path.join(root, run)] if mode == "FULL" else \
   149	        [os.path.join(root, d) for d in sorted(os.listdir(root)) if d.startswith(f"{run}_smoke_")]
   150	    found = [c for c in cands if os.path.isfile(os.path.join(c, ".exp38_submitted", "intent.json"))]
   151	    if len(found) != 1:
   152	        raise SubmitError(f"expected one {run} {mode} intent, found {found}")
   153	    return found[0], json.load(open(os.path.join(found[0], ".exp38_submitted", "intent.json")))
