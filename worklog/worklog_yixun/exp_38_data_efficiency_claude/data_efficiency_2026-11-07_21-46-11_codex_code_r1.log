    21	
    22	
    23	def _hf_cached():
    24	    try:
    25	        from huggingface_hub.constants import HF_HUB_CACHE
    26	    except Exception:
    27	        return False
    28	    return os.path.isdir(os.path.join(HF_HUB_CACHE, "models--facebook--dinov3-vits16-pretrain-lvd1689m"))
    29	
    30	
    31	pytestmark = pytest.mark.skipif(not _hf_cached(), reason="DINOv3 snapshot not cached")
    32	
    33	
    34	def _metadata(batch, n_ctx, gen):
    35	    out = []
    36	    for _ in range(batch):
    37	        depth = torch.rand(3, 256, 512, generator=gen) * 4.0 - 2.0
    38	        src = torch.rand(3, generator=gen) * 2.0 - 1.0
    39	        ctx = torch.rand(n_ctx, 3, generator=gen) * 2.0 - 1.0
    40	        out.append({"depth": depth, "source": src, "source_vit": src.unsqueeze(0), "context_poses": ctx,
    41	                    "context_poses_vit": ctx, "context_audio": torch.randn(n_ctx, 1, 9600, generator=gen) * 0.01})
    42	    return out
    43	
    44	
    45	def _run(cond, md, orbit, batch):
    46	    from src.data import yaw_rotation as yr
    47	    torch.manual_seed(1234)
    48	    md_inv = [yr.cylindrical_pose_features(m) for m in md]
    49	    base = cond(md_inv, "cpu")
    50	    present = [i for i in ("source_vit", "context_poses_vit") if i in base]
    51	    angles = (0.0, 90.0, 180.0, 270.0)
    52	    if orbit == "loop":
    53	        acc = yr._orbit_average_loop(cond, md_inv, base, present, angles, 512, "cpu")
    54	    else:
    55	        acc = yr._orbit_average_batched(cond, md_inv, base, present, angles, 512, "cpu",
    56	                                        cap=batch, cap_is_explicit=True)
    57	    for i in present:
    58	        base[i][0] = acc[i] / float(len(angles))
    59	    rng_fwd = torch.get_rng_state().clone()
    60	    loss = sum((v[0].float() ** 2).mean() for v in base.values())
    61	    loss.backward()
    62	    return base, loss.detach(), rng_fwd, torch.get_rng_state().clone()
