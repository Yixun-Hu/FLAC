   731	# ---------------------------------------------------------------- in-process evidence gate
   732	def evidence_gate(evidence_dir, run, ngpu, backend, max_steps=MAX_STEPS):
   733	    """Problems (empty = PASS) of the per-rank first-step evidence (plan r2 §10 B3)."""
   734	    arm, _, rung = parse_run_id(run)
   735	    micro = RUNGS[rung]["micro"] if ngpu > 1 else 32
   736	    p, recs = [], []
   737	    for r in range(ngpu):
   738	        path = os.path.join(evidence_dir, f"run_evidence.json.rank{r}.json")
   739	        try:
   740	            recs.append(json.load(open(path)))
   741	        except (OSError, ValueError) as err:
   742	            p.append(f"rank {r} evidence unreadable: {err}")
   743	    if p:
   744	        return p
   745	    for r, e in enumerate(recs):
   746	        want = {"rank": r, "world_size": ngpu, "num_nodes": 1, "precision": "bf16-mixed",
   747	                "accumulate_grad_batches": 1, "max_steps": max_steps, "gradient_clip_val": 0.0,
   748	                "global_step_at_fit_start": 0, "global_step_recorded": 1, "micro_batch": micro,
   749	                "state_dict_sha256": INIT_STATE_SHA256, "vit_ckpt_wrapped_layers": 12,
   750	                "flash_attn_func_set": backend == "flash"}
   751	        for k, v in want.items():
   752	            if e.get(k) != v:
   753	                p.append(f"rank {r}: {k} {e.get(k)!r} != {v!r}")
   754	        sob = e.get("sobol") or {}
   755	        if (sob.get("state_sha256"), sob.get("num_generated")) != (INIT_SOBOL_SHA256, 0):
   756	            p.append(f"rank {r}: Sobol state off the registered initial state")
   757	        if ngpu > 1 and (e.get("syncbn_modules", 0) < 1 or e.get("batchnorm_nonsync_modules") != 0):
   758	            p.append(f"rank {r}: SyncBN not active ({e.get('syncbn_modules')} sync / {e.get('batchnorm_nonsync_modules')} plain)")
   759	        ck = e.get("checkpoint_calls") or []
   760	        if not ck or any(c.get("use_reentrant") is not False for c in ck):
   761	            p.append(f"rank {r}: checkpoint calls {len(ck)}, not all use_reentrant=False")
   762	        if backend == "flash" and not (e.get("flash_calls", 0) > 0 and e.get("sdpa_calls") == 0):
   763	            p.append(f"rank {r}: flash {e.get('flash_calls')} / sdpa {e.get('sdpa_calls')} calls in the DiT")
   764	        if backend == "sdpa" and not (e.get("flash_calls") == 0 and e.get("sdpa_calls", 0) > 0):
   765	            p.append(f"rank {r}: flash {e.get('flash_calls')} / sdpa {e.get('sdpa_calls')} calls in the DiT")
   766	        want_calls = [[micro, None]]
   767	        if ARMS[arm]["cond_method"] == "fa_invariant":
   768	            want_calls += [[micro, ["source_vit", "context_poses_vit"]]] * 3
   769	        if e.get("conditioner_calls") != want_calls:
   770	            p.append(f"rank {r}: conditioner calls {e.get('conditioner_calls')} != {want_calls}")
   771	    if len({e.get("rng_at_fit_start", {}).get("torch_cpu") for e in recs}) != 1:
   772	        p.append("ranks disagree on the torch CPU RNG state at fit start")
   773	    return p
