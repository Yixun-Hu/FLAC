   412	    refs = check_refs()
   413	    verdicts, problems = {}, []
   414	    for cell in e0_cells():
   415	        probs = validate_cell(cell, head)
   416	        ref, rel = e0_reference(cell)
   417	        rec = json.load(open(_abs(cell["metrics"]))) if not probs else {}
   418	        diff = strict_equal(rec.get("metrics"), ref.get("metrics")) if not probs else "cell not admitted"
   419	        if not diff and E0[cell["e0"]]["by_scene"]:
   420	            diff = strict_equal(rec.get("by_scene"), ref.get("by_scene"))
   421	        verdicts[cell["name"]] = {"reference": rel, "equal": diff is None, "difference": diff, "problems": probs}
   422	        if probs or diff:
   423	            problems.append(cell["name"])
   424	    rec = {"verdict": "PASS" if not problems else "FAIL", "failed": problems, "cells": verdicts, "head": head,
   425	           "closure_sha256": reg.closure_digest()["closure_sha256"],
   426	           "evaluator_files": {f: reg.sha256_file(_abs(f)) for f in EVALUATOR_FILES},
   427	           "env_receipt": reg.env_receipt("a6000"), "checkpoints": {g: E0[g]["sha"] for g in E0},
   428	           "reference_manifest_sha256": reg.sha256_file(_abs(REF_MANIFEST)), "references": refs,
   429	           "input_hash": {f"K{k}_s{s}": v for (k, s), v in INPUT_HASH.items()}}
   430	    out = _abs(f"{EXP}/data_efficiency_e0_receipt.json")
   431	    if os.path.exists(out):
   432	        raise EvalError(f"{out} exists (archive it to re-run E0)")
   433	    text = json.dumps(rec, indent=1, sort_keys=True).encode()
   434	    with open(out + ".tmp", "wb") as fh:
   435	        fh.write(text)
   436	        fh.flush()
   437	        os.fsync(fh.fileno())
   438	    with open(out + ".sha256", "w") as fh:
   439	        fh.write(f"{hashlib.sha256(text).hexdigest()}  {os.path.basename(out)}\n")
   440	    os.replace(out + ".tmp", out)
   441	    return rec
