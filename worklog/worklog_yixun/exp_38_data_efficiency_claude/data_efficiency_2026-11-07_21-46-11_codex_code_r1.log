   111	def submit(run, mode, time_limit, backend, flash_version, allow_nonmatched, dry, save_root=None, runner=subprocess.run):
   112	    if mode not in ("SMOKE", "FULL"):
   113	        raise SubmitError("mode must be SMOKE or FULL")
   114	    import re
   115	    if not re.fullmatch(r"(\d+-)?\d{1,3}:\d{2}:\d{2}", time_limit or ""):
   116	        raise SubmitError(f"--time {time_limit!r} is not a Slurm time (e.g. 24:00:00 or 3-00:00:00)")
   117	    head = preflight(run, mode, allow_nonmatched, dry) if not dry else _dry_preflight(run, allow_nonmatched)
   118	    token = uuid.uuid4().hex
   119	    sd = run_dir(run, mode, token, save_root)
   120	    argv = sbatch_argv(run, mode, token, head, time_limit, backend, flash_version, sd, allow_nonmatched)
   121	    if dry:
   122	        return {"dry_run": True, "run_dir": sd, "argv": argv}
   123	    reg.check_run_dir(sd, run, 0)
   124	    os.makedirs(sd, exist_ok=True)
   125	    marker = os.path.join(sd, ".exp38_submitted")
   126	    try:
   127	        os.mkdir(marker)
   128	    except FileExistsError:
   129	        raise SubmitError(f"{marker} exists: {run} {mode} was already submitted (reconcile / abandon)")
   130	    intent = {"token": token, "run": run, "mode": mode, "head": head, "time": time_limit, "backend": backend,
   131	              "job_name": job_name(run, mode, token), "state": "submitting", "ts": time.strftime("%Y-%m-%dT%H:%M:%S")}
   132	    _write_intent(os.path.join(marker, "intent.json"), intent)
   133	    out = runner(argv, capture_output=True, text=True)
   134	    if out.returncode != 0:
   135	        raise SubmitError(f"sbatch failed ({out.stderr.strip()}); the intent stays 'submitting' -> run reconcile")
   136	    jid = out.stdout.strip().split(";")[0]
   137	    if not jid.isdigit():
   138	        raise SubmitError(f"sbatch returned {out.stdout!r}; run reconcile")
   139	    intent.update(state="submitted", job_id=jid)
   140	    _write_intent(os.path.join(marker, "intent.json"), intent)
   141	    with open(os.path.join(reg.REPO, SUBLOG), "a") as fh:
   142	        fh.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {run} {mode} job {jid} token {token} head {head}: {' '.join(argv)}\n")
   143	    return {"run_dir": sd, "job_id": jid, "token": token}
