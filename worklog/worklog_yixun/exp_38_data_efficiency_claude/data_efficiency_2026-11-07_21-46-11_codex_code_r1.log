   259	def _link(path, target):
   260	    os.makedirs(os.path.dirname(_abs(path)), exist_ok=True)
   261	    if os.path.islink(_abs(path)):
   262	        if os.readlink(_abs(path)) != target:
   263	            raise EvalError(f"{path} already links to {os.readlink(_abs(path))}")
   264	        return
   265	    if os.path.exists(_abs(path)):
   266	        raise EvalError(f"{path} exists and is not our link")
   267	    os.symlink(target, _abs(path))
