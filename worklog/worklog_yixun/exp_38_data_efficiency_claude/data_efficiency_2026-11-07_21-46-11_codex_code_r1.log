   634	def log_gate(text, run, phase, backend, ngpu, n_items=None, max_steps=MAX_STEPS, min_losses=1):
   635	    """Return a list of problems (empty = PASS) for the start or end phase of a training log."""
   636	    arm, tag, _ = parse_run_id(run)
   637	    n_items = FRACS[tag]["n_items"] if n_items is None else n_items
   638	    lines = log_lines(text)
   639	    problems = []
   640	    step_i = first_step_index(lines)
   641	    if step_i is None:
   642	        problems.append("no optimizer-step progress line yet")
   643	    found = [m.groups() for m in map(_FOUND.search, lines) if m]
   644	    if len(found) < ngpu or any(g != (str(n_items), str(N_ROOMS)) for g in found):
   645	        problems.append(f"dataset lines {found} != {ngpu} x ({n_items}, {N_ROOMS})")
   646	    if ngpu > 1:
   647	        members = {m.groups() for m in map(_MEMBER.search, lines) if m}
   648	        want = {(str(r), str(r + 1), str(ngpu)) for r in range(ngpu)}
   649	        if members != want:
   650	            problems.append(f"DDP members {sorted(members)} != {sorted(want)}")
   651	    elif any(_MEMBER.search(line) for line in lines):
   652	        problems.append("a single-rank run initialised distributed")
   653	    banner = ARMS[arm]["banner"]
   654	    if banner:
   655	        idx = [i for i, line in enumerate(lines) if line.strip() == banner]
   656	        if not idx or (step_i is not None and idx[0] > step_i):
   657	            problems.append(f"banner {banner!r} missing or after the first step")
   658	    elif any(YAW_BANNER.split(" img_w")[0] in line for line in lines):
   659	        problems.append("a non-YAW run printed the yaw_aug banner")
   660	    missing = [line for line in lines if FLASH_MISSING in line]
   661	    if backend == "flash" and missing:
   662	        problems.append("ATTN_BACKEND=flash but the log says flash_attn is not installed")
   663	    if backend == "sdpa" and len(missing) < ngpu:
   664	        problems.append(f"ATTN_BACKEND=sdpa but only {len(missing)} '{FLASH_MISSING}' lines for {ngpu} ranks")
   665	    good, bad = parse_losses(text)
   666	    if bad:
   667	        problems.append(f"non-finite / unparseable train/loss values {bad[:3]}")
   668	    if len(good) < (min_losses if phase == "end" else 1):
   669	        problems.append(f"only {len(good)} finite train/loss values (need {min_losses if phase == 'end' else 1})")
   670	    if phase == "end" and FIT_END.format(n=max_steps) not in text:
   671	        problems.append(f"Lightning's max_steps={max_steps} termination marker missing")
   672	    return problems
