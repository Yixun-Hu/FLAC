    87	def audit_split(split_rel, restrict, dataset_root, listings=None):
    88	    """Return (summary, per_room_hist, problems) for one split."""
    89	    from src.data.dataset import get_audio_filenames
    90	    split = json.load(open(split_rel))
    91	    files = get_audio_filenames(paths=dataset_root, json_file_path=split_rel, folder_name=FOLDER)
    92	    listings = {} if listings is None else listings
    93	    per_room, problems = {}, []
    94	    n_removed = n_outside_split = n_empty = 0
    95	    order = []
    96	    pools = hashlib.sha256()
    97	    for scene, rooms in split.items():
    98	        for room, names in rooms.items():
    99	            d = os.path.join(dataset_root, FOLDER, scene, room)
   100	            if d not in listings:
   101	                lst = sorted(os.listdir(d))
   102	                listings[d] = (lst, room_index(lst))
   103	            lst, idx = listings[d]
   104	            allowed = {os.path.basename(f) for f in names}
   105	            hist = {"0": 0, "1-7": 0, ">=8": 0}
   106	            for name in names:
   107	                order.append(os.path.join(dataset_root, FOLDER, scene, room, name))
   108	                if name not in idx[0]:
   109	                    problems.append(f"{scene}/{room}/{name} listed by the split but absent on disk")
   110	                    continue
   111	                pool = candidate_pool(lst, name, idx)
   112	                kept = [c for c in pool if c in allowed] if restrict else pool
   113	                pools.update(f"{scene}/{room}/{name}:{','.join(kept)}\n".encode())
   114	                n_removed += len(pool) - len(kept)
   115	                n_outside_split += sum(1 for c in pool if c not in allowed)
   116	                if restrict and not kept:
   117	                    n_empty += 1
   118	                hist[bucket(len([c for c in pool if c in allowed]))] += 1
   119	            per_room[room] = hist
   120	    if files != order:
   121	        problems.append("get_audio_filenames order != the split's scene/room/file order")
   122	    summary = {"split": split_rel, "split_sha256": reg.sha256_file(split_rel), "restricted": restrict,
   123	               "n_targets": len(files), "rooms": len(per_room),
   124	               "ordered_targets_sha256": hashlib.sha256("\n".join(files).encode()).hexdigest(),
   125	               "pools_sha256": pools.hexdigest(),
   126	               "empty_restricted_pools": n_empty, "candidates_removed_by_restriction": n_removed,
   127	               "on_disk_candidates_outside_split": n_outside_split}
   128	    if restrict and n_empty:
   129	        problems.append(f"{split_rel}: {n_empty} targets with an empty restricted pool")
   130	    if restrict and n_removed != n_outside_split:
   131	        problems.append(f"{split_rel}: restriction removed {n_removed} != {n_outside_split} out-of-split candidates")
   132	    return summary, per_room, problems
   133	
