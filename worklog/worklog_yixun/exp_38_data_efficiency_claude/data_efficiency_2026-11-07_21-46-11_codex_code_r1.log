   391	def audit_ckpt(path, run, step, repo=None, run_dir=None, inventory=True):
   392	    """One read of the bytes: sha256 + full training-state admission (plan r2 §10 B2)."""
   393	    import io
   394	    import torch
   395	    arm, tag, rung = parse_run_id(run)
   396	    if os.path.basename(path) != ckpt_name(step, tag):
   397	        raise GateError(f"{path} is not named {ckpt_name(step, tag)}")
   398	    with open(path, "rb") as fh:
   399	        data = fh.read()
   400	    digest = hashlib.sha256(data).hexdigest()
   401	    ck = torch.load(io.BytesIO(data), map_location="cpu", weights_only=False)
   402	    want = json.load(open(_abs(model_config_rel(arm, rung), repo)))
   403	    p = []
   404	    if ck.get("global_step") != step:
   405	        p.append(f"global_step {ck.get('global_step')} != {step}")
   406	    if ck.get("epoch") != epoch_of_step(step, tag):
   407	        p.append(f"epoch {ck.get('epoch')} != {epoch_of_step(step, tag)}")
   408	    if canonical(ck.get("model_config")) != canonical(want):
   409	        p.append("embedded model_config != the arm config")
   410	    sd = ck.get("state_dict", {})
   411	    bad = [k for k, v in sd.items() if torch.is_tensor(v) and v.is_floating_point() and not bool(torch.isfinite(v).all())]
   412	    if bad:
   413	        p.append(f"non-finite tensors {bad[:3]}")
   414	    ema = {k[len("diffusion_ema.ema_model."):]: v for k, v in sd.items() if k.startswith("diffusion_ema.ema_model.")}
   415	    onl = {k[len("diffusion.model."):]: v for k, v in sd.items() if k.startswith("diffusion.model.")}
   416	    if not ema or set(ema) != set(onl):
   417	        p.append(f"EMA suffix set ({len(ema)}) != online diffusion.model suffix set ({len(onl)})")
   418	    elif any(ema[k].shape != onl[k].shape or ema[k].dtype != onl[k].dtype for k in ema):
   419	        p.append("EMA / online tensors differ in shape or dtype")
   420	    est, ein = sd.get("diffusion_ema.step"), sd.get("diffusion_ema.initted")
   421	    if est is None or ein is None or int(est.reshape(-1)[0]) != step or float(ein.reshape(-1)[0]) != 1.0:
   422	        p.append(f"EMA step / initted {est} / {ein} (want {step} / 1)")
   423	    if inventory:
   424	        inv, shapes, wrapper = fresh_inventory(arm, rung, repo)
   425	        got = {k: (tuple(v.shape), str(v.dtype)) for k, v in sd.items() if torch.is_tensor(v)}
   426	        if got != inv:
   427	            p.append(f"state_dict inventory != a fresh wrapper's (missing {sorted(set(inv) - set(got))[:3]}, "
   428	                     f"extra {sorted(set(got) - set(inv))[:3]})")
   429	        else:
   430	            try:
   431	                wrapper.load_state_dict(sd, strict=True)
   432	            except Exception as err:                      # noqa: BLE001 -- any load failure is a refusal
   433	                p.append(f"strict load failed: {err}")
   434	    opts = ck.get("optimizer_states") or []
   435	    sch = (ck.get("lr_schedulers") or [{}])[0]
   436	    if len(opts) != 1 or len(opts[0].get("param_groups", [])) != 1:
   437	        p.append("expected one optimizer with one param group")
   438	    else:
   439	        g, st = opts[0]["param_groups"][0], opts[0].get("state", {})
   440	        if (tuple(g.get("betas", ())), g.get("eps"), g.get("weight_decay"), g.get("initial_lr")) != ((0.9, 0.999), 1e-08, 0.001, 5e-05):
   441	            p.append(f"AdamW group {g.get('betas')}/{g.get('eps')}/{g.get('weight_decay')}/{g.get('initial_lr')} off-recipe")
   442	        if g.get("lr") != (sch.get("_last_lr") or [None])[0]:
   443	            p.append("optimizer lr != scheduler _last_lr")
   444	        if len(st) != N_OPT_STATE:
   445	            p.append(f"optimizer state for {len(st)} parameters != {N_OPT_STATE}")
   446	        if inventory:
   447	            if g.get("params") != list(range(len(shapes))):
   448	                p.append(f"param group lists {len(g.get('params', []))} params != the fresh wrapper's {len(shapes)}")
   449	            else:
   450	                for i, s_ in st.items():
   451	                    ok = (tuple(s_.get("exp_avg", torch.empty(0)).shape) == shapes[i] ==
   452	                          tuple(s_.get("exp_avg_sq", torch.empty(0)).shape))
   453	                    fin = all(bool(torch.isfinite(s_[k]).all()) for k in ("exp_avg", "exp_avg_sq") if k in s_)
   454	                    if not ok or not fin or float(s_.get("step", -1)) != float(step):
   455	                        p.append(f"optimizer state {i} shape / finiteness / step off")
   456	                        break
   457	    if (sch.get("inv_gamma"), sch.get("power"), sch.get("warmup"), sch.get("final_lr"), sch.get("base_lrs"),
   458	            sch.get("last_epoch"), sch.get("_step_count")) != (1000000, 0.5, 0.99, 0.0, [5e-05], step, step + 1):
   459	        p.append(f"scheduler {[sch.get(k) for k in ('inv_gamma', 'power', 'warmup', 'final_lr', 'base_lrs', 'last_epoch', '_step_count')]} off-recipe")
   460	    elif abs((sch.get("_last_lr") or [0])[0] - inverse_lr(step)) > 1e-12:
   461	        p.append(f"scheduler _last_lr {(sch.get('_last_lr') or [0])[0]} != InverseLR({step}) {inverse_lr(step)}")
   462	    try:
   463	        fl = ck["loops"]["fit_loop"]
   464	        done = fl["epoch_loop.automatic_optimization.optim_progress"]["optimizer"]["step"]["total"]["completed"]
   465	        bp = fl["epoch_loop.batch_progress"]["total"]
   466	        ep = fl["epoch_progress"]["total"]
   467	    except (KeyError, TypeError):
   468	        done, bp, ep = None, {}, {}
   469	    if done != step or bp.get("ready") != step or bp.get("processed") != step:
   470	        p.append(f"fit-loop progress {done} / {bp} != step {step}")
   471	    if ep.get("processed") != epoch_of_step(step, tag) and ep.get("processed") != epoch_of_step(step, tag) + 1:
   472	        p.append(f"epoch progress {ep} inconsistent with epoch {epoch_of_step(step, tag)}")
   473	    cbs = ck.get("callbacks") or {}
   474	    if list(cbs) != [MODEL_CHECKPOINT_KEY]:
   475	        p.append(f"callback state keys {list(cbs)} != [{MODEL_CHECKPOINT_KEY}]")
   476	    elif run_dir is not None and os.path.realpath(cbs[MODEL_CHECKPOINT_KEY].get("dirpath", "")) != os.path.realpath(run_dir):
   477	        p.append(f"ModelCheckpoint dirpath {cbs[MODEL_CHECKPOINT_KEY].get('dirpath')} != {run_dir}")
   478	    if p:
   479	        raise GateError(f"{path}: " + "; ".join(p))
   480	    return {"ckpt": path, "sha256": digest, "bytes": len(data), "global_step": step}
