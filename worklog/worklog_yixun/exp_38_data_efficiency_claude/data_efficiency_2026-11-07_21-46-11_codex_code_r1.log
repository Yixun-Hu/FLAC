   211	            "per_scene_schema": 1, "scene_count": 10,
   212	            "frame_avg_angles": [0.0, 90.0, 180.0, 270.0] if cell["cond"] == "fa_invariant" else None,
   213	            "frame_avg_fwd_cap": 64 if cell["cond"] == "fa_invariant" else None,
   214	            "orbit_execution": "batched" if cell["cond"] == "fa_invariant" else "n/a"}
   215	    for k, v in want.items():
   216	        if rec.get(k) != v:
   217	            p.append(f"{k} {rec.get(k)!r} != {v!r}")
   218	    if source_sha and rec.get("source_sha") != source_sha:
   219	        p.append(f"source_sha {rec.get('source_sha')} != {source_sha}")
   220	    if tuple(sorted(rec.get("by_scene", {}))) != SCENES or not _finite_tree(rec.get("by_scene", {})):
   221	        p.append("by_scene scene set / finiteness")
   222	    try:
   223	        if rec.get("ckpt_sha256_loaded") != expected_ckpt_sha(cell, offline):
   224	            p.append("ckpt_sha256_loaded != the admitted checkpoint")
   225	    except (OSError, EvalError) as err:
   226	        p.append(str(err))
   227	    if stream.get("stream_count") != 6337 or stream.get("input_hash") != INPUT_HASH[(cell["K"], cell["seed"])]:
   228	        p.append(f"stream count / input_hash {stream.get('input_hash')} != pinned")
   229	    links = {"metrics_sha256": reg.sha256_file(_abs(cell["metrics"])), "stream_sha256": reg.sha256_file(_abs(cell["stream"]))}
   230	    for k, v in links.items():
   231	        if receipt.get(k) != v:
   232	            p.append(f"receipt {k} != the file")
   233	    if receipt.get("rc") != 0 or receipt.get("sentinel") != SENTINEL or receipt.get("argv") != eval_argv(cell):
   234	        p.append("receipt rc / sentinel / argv")
   235	    for k, v in (("model_config_sha256", reg.sha256_file(_abs(cell["config"]))),
   236	                 ("dataset_config_sha256", EVAL_CONFIG_SHA256[cell["K"]]), ("unseen_split_sha256", UNSEEN_SPLIT[1])):
   237	        if receipt.get(k) != v:
   238	            p.append(f"receipt {k} != pinned")
   239	    if cell["dump"]:
   240	        d = cell["dump_dir"]
   241	        try:
   242	            mpath = dump_manifest_copy(cell) if offline else os.path.join(d, "manifest.json")
   243	            man = json.load(open(mpath))
   244	            complete = True if offline else os.path.exists(os.path.join(d, "COMPLETE"))
   245	            ok = (complete and man.get("n") == 6337 and man.get("dtype") == "float32"
   246	                  and man.get("metrics_sha256") == links["metrics_sha256"]
   247	                  and man.get("stream_sidecar_sha256") == links["stream_sha256"]
   248	                  and man.get("input_hash") == stream.get("input_hash")
   249	                  and receipt.get("dump_manifest_sha256") == reg.sha256_file(mpath)
   250	                  and reg.sha256_file(dump_manifest_copy(cell)) == receipt.get("dump_manifest_sha256"))
   251	            if not ok:
   252	                p.append("dump manifest cross-links")
   253	        except (OSError, ValueError) as err:
   254	            p.append(f"dump unreadable: {err}")
   255	    return [f"{cell['name']}: {x}" for x in p]
   330	    if cell["dump"] and os.path.exists(cell["dump_dir"]):
