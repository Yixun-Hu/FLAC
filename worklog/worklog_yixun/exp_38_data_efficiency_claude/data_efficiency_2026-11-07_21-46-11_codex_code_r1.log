   112	    jtext = json.dumps(payload, indent=1, sort_keys=True).encode()
   113	    mtext = (render(rows, pending) + f"\nresults JSON sha256: `{hashlib.sha256(jtext).hexdigest()}`\n").encode()
   114	    lock = open(os.path.join(repo, LOCK), "a")
   115	    fcntl.flock(lock, fcntl.LOCK_EX)
   116	    try:
   117	        for rel, text in ((OUT_JSON, jtext), (OUT_MD, mtext)):
   118	            tmp = os.path.join(repo, rel + ".tmp")
   119	            with open(tmp, "wb") as fh:
   120	                fh.write(text)
   121	                fh.flush()
   122	                os.fsync(fh.fileno())
   123	        for rel in (OUT_JSON, OUT_MD):
   124	            os.replace(os.path.join(repo, rel + ".tmp"), os.path.join(repo, rel))
   125	    finally:
   126	        fcntl.flock(lock, fcntl.LOCK_UN)
   127	        lock.close()
   128	    return hashlib.sha256(jtext).hexdigest()
