    64	    root = _tree(tmp_path, {("Toy", "Toy_idx_0"): pairs})
    65	    d = os.path.join(root, audit.FOLDER, "Toy", "Toy_idx_0")
    66	    listing = sorted(os.listdir(d))
    67	    for s, r in pairs:
    68	        name = f"S00{s}_R00{r}_hybrid_IR.wav"
    69	        assert audit.candidate_pool(listing, name) == _ar_md_pool(os.path.join(d, name))
