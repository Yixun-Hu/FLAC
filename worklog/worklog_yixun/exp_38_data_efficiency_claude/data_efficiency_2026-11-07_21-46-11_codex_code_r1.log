    77	def _trainer(rank=0, world=2, step=0):
    78	    return types.SimpleNamespace(global_rank=rank, local_rank=rank, world_size=world, num_nodes=1,
    79	                                 global_step=step, precision="bf16-mixed", accumulate_grad_batches=1,
    80	                                 max_steps=40000, gradient_clip_val=0.0,
    81	                                 strategy=types.SimpleNamespace(__class__=type("DDPStrategy", (), {})))
