   125	  kill_ours() { [ -n "$PGID" ] && [ "$PGID" = "$TPID" ] && kill -TERM -- "-${PGID}" 2>/dev/null; }
   126	  local STEPS=40000; [ "$MODE" = SMOKE ] && STEPS=30
   127	  if [ "$MODE" = FULL ]; then
   128	    "${REG[@]}" log-gate "$LOG" --run "$RUN" --phase start --backend "$ATTN_BACKEND" --ngpu "$NGPU" --wait 5400 --pid "$TPID" | tee -a "$REC"
   129	    if [ "${PIPESTATUS[0]}" -ne 0 ]; then kill_ours; wait "$TPID" 2>/dev/null; exit 4; fi
   130	    local w=0 r
   131	    for r in $(seq 0 $((NGPU - 1))); do
   132	      until [ -f "$SD/evidence/run_evidence.json.rank${r}.json" ]; do
   133	        sleep 10; w=$((w + 10))
   134	        if [ "$w" -ge 1800 ] || [ ! -e "/proc/${TPID}" ]; then echo "no run evidence from rank ${r}" | tee -a "$REC"; kill_ours; wait "$TPID" 2>/dev/null; exit 4; fi
   135	      done
   136	    done
   137	    "${REG[@]}" evidence-gate "$SD/evidence" --run "$RUN" --ngpu "$NGPU" --backend "$ATTN_BACKEND" | tee -a "$REC"
   138	    if [ "${PIPESTATUS[0]}" -ne 0 ]; then kill_ours; wait "$TPID" 2>/dev/null; exit 4; fi
   139	  fi
   140	  wait "$TPID"; local rc=$?
   141	  echo "torchrun rc=${rc} at $(date -Iseconds)" | tee -a "$REC"
   142	  mv "$SD/.exp38_lock" "$SD/.exp38_lock.released_${TS}" 2>/dev/null
   143	  if [ "$MODE" = SMOKE ]; then
   144	    local NCK; NCK="$(find "$SD" -name '*.ckpt' | wc -l)"
   145	    local GATE; GATE="$("${REG[@]}" log-gate "$LOG" --run "$RUN" --phase end --backend "$ATTN_BACKEND" --ngpu "$NGPU" --max-steps 30 --min-losses 1)"
   146	    local EVG; EVG="$("${REG[@]}" evidence-gate "$SD/evidence" --run "$RUN" --ngpu "$NGPU" --backend "$ATTN_BACKEND" --max-steps 30)"
   147	    local VERDICT=PASS
   148	    [ "$rc" -eq 0 ] && [ "$NCK" -eq 0 ] && [ "$GATE" = "LOG GATE PASS" ] && [ "$EVG" = "EVIDENCE GATE PASS" ] || VERDICT=FAIL
   149	    "${REG[@]}" smoke-receipt "$REPO/$EXP/data_efficiency_smoke_${RUN}_${TS}.json" --run "$RUN" --platform neuronic \
   150	      --evidence "$SD/evidence" --rc "$rc" --checkpoints "$NCK" --log-gate "$GATE" --evidence-gate "$EVG" \
   151	      --verdict "$VERDICT" --head "$HEAD" | tee -a "$REC"
   152	    echo "SMOKE VERDICT ${VERDICT}; rate: $(tr '\r' '\n' < "$LOG" | grep -oE '[0-9.]+(it/s|s/it)' | tail -1)" | tee -a "$REC"
   153	    [ "$VERDICT" = PASS ] && exit 0 || exit 5
   154	  fi
   155	  [ "$rc" -eq 0 ] || exit "$rc"
   156	  local erc=0
   157	  "${REG[@]}" log-gate "$LOG" --run "$RUN" --phase end --backend "$ATTN_BACKEND" --ngpu "$NGPU" >> "$REC" || erc=5
   158	  "${REG[@]}" run-dir-check "$SD" --run "$RUN" --leg-start 40000 --allow-submission-marker >> "$REC" || erc=5
   159	  local ECK; ECK="$(ls "$SD"/epoch=*-step=40000.ckpt 2>/dev/null)"
   160	  [ -n "$ECK" ] && "${REG[@]}" audit-ckpt "$ECK" --run "$RUN" --step 40000 --run-dir "$SD" >> "$REC" || erc=5
   161	  [ "$erc" -eq 0 ] && "${REG[@]}" ckpt-manifest "$SD" --run "$RUN" >> "$REC" || erc=5
   162	  cp "$REC" "$SD/" 2>/dev/null
   163	  [ "$erc" -eq 0 ] || { echo "EXP38 ${RUN} END AUDIT FAILED"; exit 5; }
   164	  echo "EXP38 ${RUN} COMPLETE (${ECK})"
   165	  exit 0
   166	}
