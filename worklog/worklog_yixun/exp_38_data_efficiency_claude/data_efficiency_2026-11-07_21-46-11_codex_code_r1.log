   796	def closure_digest(repo=None):
   797	    repo = repo or REPO
   798	    h = hashlib.sha256()
   799	    files = closure_files(repo)
   800	    for rel in files:
   801	        h.update(f"{rel}\0{sha256_file(os.path.join(repo, rel))}\n".encode())
   802	    return {"closure_sha256": h.hexdigest(), "n_files": len(files)}
