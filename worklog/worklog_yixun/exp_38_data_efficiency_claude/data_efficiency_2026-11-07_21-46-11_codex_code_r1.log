   107	            n_grads += 1
   108	    assert n_grads > 100
     1	"""exp_38 B4b — what the DistributedSampler does at the two rungs and under the two launchers
     2	(plan_data_efficiency.md r2 §7, §10 B4b; Codex plan r2 HIGH 5).
     3	
     4	* PL 2.1 injects ``DistributedSampler(dataset, shuffle=True, seed=PL_GLOBAL_SEED, num_replicas=W,
     5	  rank=r)`` via ``_get_distributed_sampler``; the rank/world it gets come from the cluster
     6	  environment: ``LightningEnvironment`` (PL's subprocess DDP launcher, this box) or
     7	  ``TorchElasticEnvironment`` (torchrun, neuronic). Same (W, r) -> same sampler, same worker seeds.
     8	* Per epoch both rungs consume the same unique permutation prefix and drop the same unique suffix
     9	  (1 / 1 / 31 items at 25 / 50 / 75 %); padding differs (W2: 1 / 1 / 1; W8: 7 / 7 / 1) but the
    10	  padded entries lie in the dropped tails; rank lists are strided, so a global step is the
    11	  rank-interleaving of perm[64t : 64t+64].
    12	In-process only (a real two-process trace needs a CPU DDP harness; disclosed in the plan).
    13	"""
    14	import math
    15	import os
    16	
    17	import pytest
    18	import torch
    19	from torch.utils.data import DataLoader, Dataset
    20	
    21	FRACTIONS = {"025": 73473, "050": 145665, "075": 218463}
    22	
    23	
    24	class _Toy(Dataset):
    25	    def __init__(self, n):
    26	        self.n = n
    27	
    28	    def __len__(self):
    29	        return self.n
    30	
    31	    def __getitem__(self, i):
    32	        return i
    33	
    34	
    35	def _sampler(n, world, rank, seed=42, epoch=0):
    36	    from pytorch_lightning.trainer.connectors.data_connector import _get_distributed_sampler
    37	    dl = DataLoader(_Toy(n), batch_size=64 // world, shuffle=True, drop_last=True)
    38	    os.environ["PL_GLOBAL_SEED"] = str(seed)
    39	    s = _get_distributed_sampler(dl, shuffle=True, overfit_batches=0, num_replicas=world, rank=rank)
    40	    s.set_epoch(epoch)
    41	    return s
    42	
    43	
    44	def _consumed(n, world, epoch=0):
    45	    micro = 64 // world
    46	    per_rank = [list(_sampler(n, world, r, epoch=epoch)) for r in range(world)]
    47	    steps = len(per_rank[0]) // micro
    48	    used = [[per_rank[r][t * micro:(t + 1) * micro] for r in range(world)] for t in range(steps)]
    49	    return steps, used, per_rank
    50	
    51	
    52	@pytest.mark.parametrize("tag", sorted(FRACTIONS))
    53	def test_padding_and_unique_drops_per_fraction(tag):
    54	    n = FRACTIONS[tag]
    55	    expect_pad = {"025": (1, 7), "050": (1, 7), "075": (1, 1)}[tag]
    56	    expect_drop = {"025": 1, "050": 1, "075": 31}[tag]
    57	    for world, pad in zip((2, 8), expect_pad):
    58	        assert math.ceil(n / world) * world - n == pad
    59	        micro = 64 // world
    60	        steps = (math.ceil(n / world)) // micro
    61	        assert steps == {"025": 1148, "050": 2276, "075": 3413}[tag]
    62	        assert n - steps * micro * world == expect_drop
    63	
    64	
    65	def test_both_rungs_consume_the_same_unique_prefix_and_global_batches():
    66	    n = 6421                                                      # small n, same arithmetic shape
    67	    steps2, used2, _ = _consumed(n, 2)
    68	    steps8, used8, _ = _consumed(n, 8)
    69	    assert steps2 == steps8
    70	    g = torch.Generator()
    71	    g.manual_seed(42)
    72	    perm = torch.randperm(n, generator=g).tolist()
    73	    for t in range(steps2):
    74	        # rank-interleaving of the step's ranks == perm[64t : 64t+64] for both rungs
    75	        inter2 = [used2[t][r][j] for j in range(32) for r in range(2)]
    76	        inter8 = [used8[t][r][j] for j in range(8) for r in range(8)]
    77	        assert inter2 == perm[64 * t:64 * t + 64] == inter8
    78	        assert sorted(sum(used2[t], [])) == sorted(sum(used8[t], []))
    79	
