   620	def parse_losses(text):
   621	    """Every ``train/loss=<value>`` the progress bar printed: (finite floats, non-finite tokens)."""
   622	    import math
   623	    good, bad = [], []
   624	    for tok in _LOSS.findall(text):
   625	        try:
   626	            v = float(tok)
   627	        except ValueError:
   628	            bad.append(tok)
   629	            continue
   630	        (good if math.isfinite(v) else bad).append(v if math.isfinite(v) else tok)
   631	    return good, bad
