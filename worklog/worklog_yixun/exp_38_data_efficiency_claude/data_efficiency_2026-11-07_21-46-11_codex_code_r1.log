    62	def run_block(run, validate=None):
    63	    """(rows for the run's two K, problems). validate(cell) -> problems (default ev.validate_cell)."""
    64	    validate = validate or ev.validate_cell
    65	    arm, tag, _ = reg.parse_run_id(run)
    66	    cells = ev.run_cells(run)
    67	    problems = [x for c in cells for x in validate(c)]
    68	    rd = os.path.join(reg.PLATFORMS["a6000"]["save_root"], run)
    69	    if glob.glob(os.path.join(rd, "RESUMED_AT_*")) or os.path.isdir(os.path.join(rd, ".exp38_lock")):
    70	        problems.append(f"{run}: run dir carries a resume / live-lock marker (never primary)")
    71	    if problems:
    72	        return {}, problems
    73	    shas = {json.load(open(ev._abs(c["metrics"])))["source_sha"] for c in cells}
    74	    if len(shas) != 1:
    75	        return {}, [f"{run}: cells evaluated at {len(shas)} different pins"]
    76	    pin = next(iter(shas))
    77	    model = "p1_bridge" if arm == "p1" else arm
    78	    rows = {}
    79	    for K in (8, 1):
    80	        recs = {c["seed"]: json.load(open(ev._abs(c["metrics"])))["metrics"] for c in cells if c["K"] == K}
    81	        rows[(model, tag, K)] = {"stats": aggregate(recs), "source": f"exp_38 {run} (eval pin {pin[:12]})"}
    82	    return rows, []
