   444	def main(argv=None):
   445	    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   446	    sub = p.add_subparsers(dest="cmd", required=True)
   447	    s = sub.add_parser("plan"); s.add_argument("--bridge", action="store_true")
   448	    s = sub.add_parser("env-receipt"); g = s.add_mutually_exclusive_group(required=True)
   449	    g.add_argument("--write", action="store_true"); g.add_argument("--check", action="store_true")
   450	    s = sub.add_parser("prepare"); s.add_argument("run")
   451	    sub.add_parser("prepare-e0")
   452	    s = sub.add_parser("run"); s.add_argument("--gpu", type=int, required=True, choices=(0, 1))
   453	    s.add_argument("--cells", nargs="+", required=True); s.add_argument("--shared", action="store_true")
   454	    sub.add_parser("e0")
   455	    s = sub.add_parser("validate"); s.add_argument("names", nargs="+")
   456	    a = p.parse_args(argv)
   457	    os.chdir(reg.REPO)
   458	    try:
   459	        if a.cmd == "plan":
   460	            for c in all_cells(a.bridge):
   461	                print(json.dumps({"name": c["name"], "argv": ["python", NO_FLASH, "eval_FLAC.py"] + eval_argv(c),
   462	                                  "metrics": c["metrics"], "dump": c["dump_dir"]}))
   463	        elif a.cmd == "env-receipt":
   464	            print(json.dumps(reg.env_receipt("a6000", write=a.write)))
   465	        elif a.cmd == "prepare":
   466	            print(json.dumps(prepare(a.run)))
   467	        elif a.cmd == "prepare-e0":
   468	            print(json.dumps(prepare_e0()))
   469	        elif a.cmd == "run":
   470	            cmd_run(a.gpu, a.cells, a.shared)
   471	        elif a.cmd == "e0":
   472	            rec = cmd_e0()
   473	            print(f"E0 {rec['verdict']}" + (f": {rec['failed']}" if rec["failed"] else ""))
   474	            return 0 if rec["verdict"] == "PASS" else 1
   475	        elif a.cmd == "validate":
   476	            cells = {c["name"]: c for c in all_cells(bridge=True)}
   477	            probs = [x for n in a.names for x in validate_cell(cells[n])]
   478	            print("\n".join(probs) or "VALID")
   479	            return 0 if not probs else 1
   480	    except (EvalError, reg.GateError, OSError, KeyError, ValueError) as err:
   481	        print(f"EXP38 EVAL REFUSED: {err}", file=sys.stderr)
   482	        return 2
   483	    return 0
   484	
