   357	def inverse_lr(step, base=5e-5, inv_gamma=1e6, power=0.5, warmup=0.99):
   358	    """src/training/utils.py::InverseLR closed form (final_lr 0) at a completed step."""
   359	    return base * (1 - warmup ** (step + 1)) * (1 + step / inv_gamma) ** (-power)
