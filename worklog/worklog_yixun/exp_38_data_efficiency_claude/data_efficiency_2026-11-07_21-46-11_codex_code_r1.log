   335	def check_run_dir(path, run, leg_start, allow_submission_marker=False):
   336	    """Fresh (leg_start 0): no checkpoint and nothing foreign. Resume: exactly the cadence set
   337	    <= leg_start. ``.exp38_lock`` (a live or crashed run) always refuses a new start;
   338	    ``.exp38_submitted`` is allowed only to the job its submission created."""
   339	    _, tag, _ = parse_run_id(run)
   340	    present = sorted(os.path.basename(p) for p in glob.glob(os.path.join(path, "*.ckpt")))
   341	    want = sorted(ckpt_name(s, tag) for s in cadence_steps(leg_start)) if leg_start else []
   342	    if present != want:
   343	        raise GateError(f"{path}: checkpoints {present} != expected {want} for a start at step {leg_start}")
   344	    if os.path.isdir(path):
   345	        names = os.listdir(path)
   346	        stray = sorted(n for n in names if not _own_entry(n))
   347	        if stray:
   348	            raise GateError(f"{path}: foreign entries {stray}")
   349	        if ".exp38_lock" in names:
   350	            raise GateError(f"{path}: run lock .exp38_lock present (a run is live or crashed; archive first)")
   351	        if ".exp38_submitted" in names and not allow_submission_marker:
   352	            raise GateError(f"{path}: .exp38_submitted present (already submitted; archive the run dir first)")
   353	    return {"run_dir": path, "state": "fresh" if not leg_start else f"resume@{leg_start}",
   354	            "checkpoints": present}
