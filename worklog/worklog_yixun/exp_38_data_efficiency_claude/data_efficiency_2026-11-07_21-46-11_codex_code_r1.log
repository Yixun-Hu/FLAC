    81	    assert len(pool) == 9 and not any(c.startswith(("S010_", "S0010_")) for c in pool)
    82	    for name in ("S001_R001_hybrid_IR.wav", "S010_R001_hybrid_IR.wav"):
    83	        assert audit.candidate_pool(listing, name) == _ar_md_pool(os.path.join(d, name))
