   355	    if os.path.exists(_abs(cell["stream"])):
   356	        receipt["stream_sha256"] = reg.sha256_file(_abs(cell["stream"]))
   357	    if cell["dump"] and os.path.exists(os.path.join(cell["dump_dir"], "manifest.json")):
   358	        import shutil
