    99	def _neutralize_for_steps(wrapper, monkeypatch):
   100	    """Stub everything the step methods touch *after* conditioning, so a dispatch
   101	    test never depends on the DiT maths, the sampler, the metric callback, a
   102	    Lightning Trainer or the logger. Instance-level stubs live on the fresh
   103	    per-test wrapper (no leakage); the module-global sampler goes through
   104	    monkeypatch (auto-undone)."""
   105	    # DiT forward (training_step + validation_step) -> zeros shaped like input.
   106	    wrapper.diffusion.forward = lambda x, t, **kw: torch.zeros_like(x)
   107	    # training_step: logging + optimizer-lr readout.
   108	    wrapper.log_dict = lambda *a, **k: None
   109	    wrapper.trainer = types.SimpleNamespace(
   110	        optimizers=[types.SimpleNamespace(param_groups=[{"lr": 5e-6}])]
   111	    )
   112	    # test_step: attrs normally set by set_test_config (which builds a heavy
   113	    # AcousticMetricsCallback) + a no-op sampler and metric sink.
   114	    wrapper.samples = 64
   115	    wrapper.steps = 1
   116	    wrapper.cfg_scale = 1.0
   117	    wrapper.store_predictions = False
   118	    wrapper.preds = []
   119	    wrapper.metric_callback = types.SimpleNamespace(update_metrics=lambda *a, **k: None)
   120	    monkeypatch.setattr(tdiff, "sample_discrete_euler", lambda model, x, *a, **k: x)
