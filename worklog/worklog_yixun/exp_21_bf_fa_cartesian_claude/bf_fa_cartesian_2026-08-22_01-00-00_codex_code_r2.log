   595	def _flat(obj, prefix=()):
   596	    """Every leaf of a parsed JSON document, keyed by its full path. A dict
   597	    comparison says only WHETHER two configs differ; the experiment's claim is
   598	    about exactly WHICH leaves differ."""
   599	    if isinstance(obj, dict):
   600	        out = {}
   601	        for k, v in obj.items():
   602	            out.update(_flat(v, prefix + (k,)))
   603	        return out
   604	    if isinstance(obj, list):
   605	        out = {}
   606	        for i, v in enumerate(obj):
   607	            out.update(_flat(v, prefix + (i,)))
   608	        return out
   609	    return {prefix: obj}
