    72	class _CountingViT(nn.Module):
    73	    """GeometryConditioner stand-in: records the batch size of every forward.
    74	
    75	    The chunk plan is READ OFF THIS LIST, so the tests observe the partition the
    76	    production code actually executed rather than recomputing ``cap // batch``.
    77	    """
    78	
    79	    def __init__(self, out_dim: int = 4):
    80	        super().__init__()
    81	        self.name = "GeometryConditioner"
    82	        self.out_dim = out_dim
    83	        self.batch_sizes = []
    84	
    85	    def forward(self, coord_list, device=DEV):
    86	        self.batch_sizes.append(len(coord_list))
    87	        coords = [c["coord"] for c in coord_list]
    88	        depths = [c["depth"] for c in coord_list]
    89	        coord = torch.stack(coords, dim=0)
    90	        if coord.ndim == 2:
    91	            coord = coord.unsqueeze(1)
    92	        depth = torch.stack(depths, dim=0)                     # [B, 3, H, W]
    93	        B, N, _ = coord.shape
    94	        pooled = depth.mean(dim=(2, 3))                        # [B, 3]
    95	        feat = torch.tanh(coord + pooled[:, None, :])          # [B, N, 3]
    96	        out = feat.sum(-1, keepdim=True).expand(B, N, self.out_dim).contiguous()
    97	        return [out, torch.ones(B, 1, device=device)]
    98	
