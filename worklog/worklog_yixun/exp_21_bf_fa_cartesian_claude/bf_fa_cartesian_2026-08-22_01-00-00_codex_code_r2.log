    83	class _CountingDist(nn.Module):
    84	    """dist_embedder stand-in; records the batch size of every forward."""
    85	
    86	    def __init__(self, out_dim: int = 4, seed: int = 0):
    87	        super().__init__()
    88	        self.name = "DistEmbedderConditioner"
    89	        self.batch_sizes = []
    90	        g = torch.Generator().manual_seed(seed)
    91	        self.register_buffer("w", torch.randn(3, out_dim, generator=g))
    92	
    93	    def forward(self, x_list, device=DEV):
    94	        self.batch_sizes.append(len(x_list))
    95	        x = torch.stack(x_list, dim=0).to(device)
    96	        if x.dim() == 2:
    97	            x = x.unsqueeze(1)
    98	        out = torch.tanh(x @ self.w + 0.3)
    99	        return [out.contiguous(), torch.ones(out.shape[0], out.shape[1], device=device)]
   100	
