   146	        "source_vit": torch.randn(1, 3, generator=g),
   147	        "context_poses": torch.randn(2, 3, generator=g),
   148	        "context_poses_vit": torch.randn(2, 3, generator=g),
   149	        "depth": _depth(),
   150	    }
