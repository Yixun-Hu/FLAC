   257	class _Spy:
   258	    """Records the RAW call — so the assertions are on the call SHAPE and not
   259	    merely on its effect — and delegates to the real conditioner so the
   260	    surrounding step code still receives valid conditioning."""
   261	
   262	    def __init__(self):
   263	        self.calls = []
   264	
   265	    def __call__(self, conditioner, metadata, device, *args, **kwargs):
   266	        self.calls.append(((conditioner, metadata, device) + args, dict(kwargs)))
   267	        return conditioner(metadata, device)
   268	
   269	    @property
   270	    def n(self):
   271	        return len(self.calls)
