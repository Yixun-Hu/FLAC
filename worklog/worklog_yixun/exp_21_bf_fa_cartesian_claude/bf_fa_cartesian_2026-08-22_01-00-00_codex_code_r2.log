   102	class _CountingGeom(nn.Module):
   103	    """GeometryConditioner stand-in (name matched so ``MultiConditioner`` feeds it
   104	    ``{'coord', 'depth'}``); records the batch size of every forward."""
   105	
   106	    def __init__(self, out_dim: int = 4, seed: int = 0):
   107	        super().__init__()
   108	        self.name = "GeometryConditioner"
   109	        self.batch_sizes = []
   110	        g = torch.Generator().manual_seed(seed)
   111	        self.register_buffer("proj", torch.randn(3, out_dim, generator=g))
   112	
   113	    def forward(self, coord_list, device=DEV):
   114	        self.batch_sizes.append(len(coord_list))
   115	        coord = torch.stack([c["coord"] for c in coord_list], dim=0).to(device)
   116	        if coord.ndim == 2:
   117	            coord = coord.unsqueeze(1)
   118	        depth = torch.stack([c["depth"] for c in coord_list], dim=0).to(device)
   119	        stat = depth.mean(dim=(2, 3))                       # [B, 3]
   120	        h = (coord + stat[:, None, :]) @ self.proj
   121	        return [torch.tanh(h).contiguous(), torch.ones(h.shape[0], 1, device=device)]
