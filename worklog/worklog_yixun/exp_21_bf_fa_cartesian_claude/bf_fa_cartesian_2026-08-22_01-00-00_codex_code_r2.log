   100	class _CountingPose(nn.Module):
   101	    """dist_embedder stand-in (runs exactly once per invariant_conditioning)."""
   102	
   103	    def __init__(self, out_dim: int = 4):
   104	        super().__init__()
   105	        self.name = "DistEmbedderConditioner"
   106	        self.out_dim = out_dim
   107	        self.batch_sizes = []
   108	
   109	    def forward(self, x_list, device=DEV):
   110	        self.batch_sizes.append(len(x_list))
   111	        x = torch.stack(x_list, dim=0)
   112	        if x.dim() == 2:
   113	            x = x.unsqueeze(1)
   114	        B, N, _ = x.shape
   115	        out = torch.tanh(x.sum(-1, keepdim=True)).expand(B, N, self.out_dim).contiguous()
   116	        return [out, torch.ones(B, N, device=device)]
