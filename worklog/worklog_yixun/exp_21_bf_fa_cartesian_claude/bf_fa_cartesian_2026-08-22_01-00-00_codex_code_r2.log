   131	def _depth(H: int = 2, W: int = 16) -> torch.Tensor:
   132	    """A small non-axisymmetric panorama: W is a multiple of 4 so every C4 angle
   133	    is an exact column roll, and the content varies with azimuth so a rotation is
   134	    observable at all."""
   135	    j = torch.arange(W, dtype=torch.float32)
   136	    theta = (j + 0.5) * 2.0 * math.pi / W - math.pi
   137	    d = (3.0 + torch.sin(theta)).view(1, W).expand(H, W)
   138	    return torch.stack([d * torch.cos(theta), d * torch.sin(theta),
   139	                        torch.linspace(-1.0, 1.0, H).view(H, 1).expand(H, W)], dim=0).contiguous()
   140	
