   305	class DistEmbedderConditioner(Conditioner):
   306	    def __init__(self, 
   307	                 output_dim: int,
   308	                 project_out: bool = False,
   309	                 max_val: float = 5.0,
   310	                 funcs=[torch.sin, torch.cos], 
   311	                 num_freqs=20, 
   312	                 max_freq=10, 
   313	                 ch_dim=1, 
   314	                 include_in=True, 
   315	                 name: str = "DistEmbedderConditioner", 
   316	                 dist_embedder_proj: tp.Optional[torch.nn.Module] = None):
   317	        
   318	        in_dim = (len(funcs) * num_freqs + (1 if include_in else 0)) * 3
   319	        super().__init__(in_dim, output_dim, project_out=False)
   320	        self.funcs = funcs
   321	        self.num_functions = list(range(len(funcs)))
   322	        self.freqs = torch.nn.Parameter(2.0**torch.from_numpy(np.linspace(start=0.0,stop=max_freq, num=num_freqs).astype(np.single)), requires_grad=False)
   323	        self.ch_dim = ch_dim
   324	        self.include_in = include_in
   325	        self.max_val = max_val
   326	        self.name = name
   327	        self.dist_embedder_proj = dist_embedder_proj
   328	
   329	    def forward(self, x_input, device: tp.Union[torch.device, str] = "cuda") -> tp.Tuple[torch.Tensor, torch.Tensor]:
   330	        x_input = torch.stack(x_input, dim=0).to(device)
   331	
   332	        if x_input.dim() == 2:
   333	            x_input = x_input.unsqueeze(1)
   334	
   335	        outs = []
   336	        for i in range(x_input.shape[1]):
   337	            x = (x_input[:, i:(i+1)]) / self.max_val 
   338	            if self.include_in:
   339	                out_list = [x]
   340	            else:
   341	                out_list = []
   342	            for func in self.funcs:
   343	                for freq in self.freqs:
   344	                    out_list.append(func(x*freq))
   345	            out = torch.cat(out_list, dim=self.ch_dim).view(x_input.shape[0], -1)
   346	            out = self.dist_embedder_proj(out)
   347	            outs.append(out)
   348	        out = torch.stack(outs, dim=1)
   349	
   350	        return [out, torch.ones(out.shape[0], 1).to(out.device)]
