   703	def render_row(label, proto, K, files, repo_root=None, validator_path=None, contract="table"):
   704	    """``(markdown_line, blocked)`` for one row, gating exp_11 and exp_14 evidence."""
   705	    # exp_14 FIRST and exclusively: its cells sit inside outputs_FLAC/exp11_<ARM>/,
   706	    # so the exp_11 branch below would otherwise claim them and block every one on
   707	    # an eval name its validator was never written to parse.
   708	    if contract == "exp14z" or is_exp14_row([os.path.basename(f) for f in files]):
   709	        ok, problems = validate_exp14_cell(files, repo_root=repo_root,
   710	                                           expected_arm=exp14_arm_of(label),
   711	                                           expected_k=K)
   712	        if not ok:
   713	            detail = problems[0] if problems else "unspecified"
   714	            return (f"| {label} | {proto} | {K} | {len(files)} | "
   715	                    f"**BLOCKED — row validation failed:** {detail} | | | | | |"), True
   716	    elif is_exp11_row(files) or any("exp11_" in os.path.basename(f) for f in files):
   717	        ok, problems = validate_exp11_cell(files, repo_root=repo_root,
   718	                                           validator_path=validator_path, contract=contract)
   719	        if not ok:
   720	            detail = problems[0] if problems else "unspecified"
   721	            return (f"| {label} | {proto} | {K} | {len(files)} | "
   722	                    f"**BLOCKED — row validation failed:** {detail} | | | | | |"), True
   723	    if contract == "exp15":
   724	        ok, problems = validate_exp15_cell(files, repo_root=repo_root, expected_k=K)
   725	        if not ok:
   726	            detail = problems[0] if problems else "unspecified"
   727	            return (f"| {label} | {proto} | {K} | {len(files)} | "
   728	                    f"**BLOCKED — row validation failed:** {detail} | | | | | |"), True
   729	        r, n = agg_files_exp15(files)
   730	    else:
   731	        r, n = agg_files(files)
   732	    if r is None or n < MIN_SEEDS:
   733	        return (f"| {label} | {proto} | {K} | {n} | "
   734	                f"*pending ({n}/{MIN_SEEDS} seeds on disk)* | | | | | |"), False
   735	    cells = " | ".join(f"{m:.3f} ± {s:.3f}" if k != "C50" else f"{m:.4f} ± {s:.4f}"
   736	                       for k, (m, s) in r.items())
   737	    return f"| {label} | {proto} | {K} | {n} | {cells} |", False
   738	
