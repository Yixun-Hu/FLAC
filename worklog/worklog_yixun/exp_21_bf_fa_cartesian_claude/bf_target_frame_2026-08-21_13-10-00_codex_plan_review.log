   336	    def compute_metrics(self, stage: str) -> Dict[str, Any]:
   337	        metrics= {}
   338	
   339	        if self.eval_T60:
   340	            t60s, invalid = self.RT60[stage].compute()
   341	            metrics["T60"] = t60s
   342	            metrics["Invalid T60"] = invalid
   343	            self.RT60[stage].reset()
   344	
   345	        if self.eval_C50:
   346	            c50s = self.C50[stage].compute()
   347	            metrics["C50"] = c50s
   348	            self.C50[stage].reset()
   349	
   350	        if self.eval_EDT:
   351	            mean_edt = self.EDT[stage].compute()
   352	            metrics['EDT'] = mean_edt
   353	            self.EDT[stage].reset()
   354	
   355	        if self.eval_l1_distance:
   356	            L1_STFT = self.l1_stft[stage].compute()
   357	            metrics['L1_STFT'] = L1_STFT
   358	            self.l1_stft[stage].reset()
   359	
   360	        if self.eval_l1_distance_multires:
   361	            L1_STFT_multires = self.l1_stft_multires[stage].compute()
   362	            metrics['L1_STFT_MultiRes'] = L1_STFT_multires
   363	            self.l1_stft_multires[stage].reset()
   364	
   365	        if self.eval_FD:
   366	            fd = self.FD[stage].compute()
   367	            metrics['FD'] = fd
   368	            self.FD[stage].reset()
   369	        
   370	        if self.eval_retrieval:
   371	            retrieval_metrics = self.retrieval[stage].compute()
   372	            metrics.update(retrieval_metrics)
   373	            self.retrieval[stage].reset()
   374	        
   375	        if self.eval_env:
   376	            env = self.Env[stage].compute()
   377	            metrics['Env'] = env
   378	            self.Env[stage].reset()
   379	
   380	        if self.eval_by_scene and stage in self.scene_metrics:
   381	            scene_results = {}
   382	
   383	            for scene_name, scene_metrics in self.scene_metrics[stage].items():
   384	                scene_results[scene_name] = {}
   385	
   386	                if self.eval_T60 and "RT60" in scene_metrics:
   387	                    t60s, invalid = scene_metrics["RT60"].compute()
   388	                    scene_results[scene_name]["T60"] = t60s
   389	                    scene_results[scene_name]["Invalid T60"] = invalid
   390	                    scene_metrics["RT60"].reset()
   391	                    
   392	                if self.eval_C50 and "C50" in scene_metrics:
   393	                    c50s = scene_metrics["C50"].compute()
   394	                    scene_results[scene_name]["C50"] = c50s
   395	                    scene_metrics["C50"].reset()
   396	
   397	                if self.eval_EDT and "EDT" in scene_metrics:
   398	                    mean_edt = scene_metrics["EDT"].compute()
   399	                    scene_results[scene_name]['EDT'] = mean_edt
   400	                    scene_metrics["EDT"].reset()
   401	                
   402	                if self.eval_l1_distance and "l1_stft" in scene_metrics:
   403	                    l1_stft = scene_metrics["l1_stft"].compute()
   404	                    scene_results[scene_name]['L1_STFT'] = l1_stft
   405	                    scene_metrics["l1_stft"].reset()
   406	
   407	                if self.eval_l1_distance_multires and "l1_stft_multires" in scene_metrics:
   408	                    l1_stft_multires = scene_metrics["l1_stft_multires"].compute()
   409	                    scene_results[scene_name]['L1_STFT_MultiRes'] = l1_stft_multires
   410	                    scene_metrics["l1_stft_multires"].reset()
   411	
   412	                if self.eval_FD and "FD" in scene_metrics:
   413	                    fd = scene_metrics["FD"].compute()
   414	                    scene_metrics["FD"].reset()
   415	                    scene_results[scene_name]['FD'] = fd.item() if isinstance(fd, torch.Tensor) else fd
   416	                
   417	                if self.eval_retrieval and "Retrieval" in scene_metrics:
   418	                    retrieval_metrics = scene_metrics["Retrieval"].compute()
   419	                    scene_metrics["Retrieval"].reset()
   420	                    scene_results[scene_name].update(retrieval_metrics)
   421	                
   422	                if self.eval_env and "Env" in scene_metrics:
   423	                    env = scene_metrics["Env"].compute()
   424	                    scene_results[scene_name]['Env'] = env
   425	                    scene_metrics["Env"].reset()
   426	
   427	            metrics["by_scene"] = scene_results
   428	
   429	        return metrics
