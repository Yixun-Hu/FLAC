   107	def draw_yaw_offsets(n: int, img_w: int, generator: torch.Generator) -> torch.Tensor:
   108	    """
   109	    Draw ``n`` independent panorama-column yaw offsets ``d ~ Uniform{0..img_w-1}``.
   110	
   111	    The unit of a *drawn* rotation is one panorama column, never a degree: an
   112	    integer column shift is applied by :func:`rotate_scene_metadata` with no
   113	    interpolation, so the offset that is recorded is exactly the offset that is
   114	    applied (``dj == d``; pinned by test). Angles come from
   115	    :func:`offsets_to_radians`.
   116	
   117	    The draw is taken from the CALLER'S generator and from nothing else. Two
   118	    properties follow, and both are load-bearing for exp_14's design:
   119	
   120	    * **Global-RNG isolation.** The evaluation's own sampling noise is drawn from
   121	      the global RNG seeded by ``pl.seed_everything(eval_seed)``. If the yaw draw
   122	      advanced that stream, a rotated cell and its paired unrotated cell would
   123	      sample different diffusion noise and the seed-paired contrast would be void.
   124	    * **Chunk independence.** Consecutive calls consume one contiguous stream, so
   125	      any batch partition of the same item order yields the same per-item
   126	      assignment; the batch size is pinned anyway, but the assignment does not
   127	      depend on that pin holding.
   128	
   129	    Parameters
   130	    ----------
   131	    n : int
   132	        Number of offsets (e.g. the current batch size). ``0`` is legal — a tail
   133	        batch of zero items consumes no randomness.
   134	    img_w : int
   135	        Panorama width in columns (the support is ``{0, ..., img_w-1}``).
   136	    generator : torch.Generator
   137	        A dedicated CPU generator, seeded with the rotation seed. Required: a
   138	        ``None`` here would silently fall back to the global RNG.
   139	
   140	    Returns
   141	    -------
   142	    torch.Tensor
   143	        ``int64`` tensor of shape ``[n]`` with values in ``[0, img_w)``.
   144	    """
   145	    if generator is None:
   146	        raise ValueError(
   147	            "draw_yaw_offsets requires a dedicated torch.Generator: passing None "
   148	            "would draw from the GLOBAL RNG and perturb the evaluation's own "
   149	            "sampling noise (see the docstring)."
   150	        )
   151	    n = int(n)
   152	    img_w = int(img_w)
   153	    if n < 0:
   154	        raise ValueError(f"n must be >= 0, got {n}")
   155	    if img_w <= 0:
   156	        raise ValueError(f"img_w must be > 0, got {img_w}")
   157	    return torch.randint(0, img_w, (n,), generator=generator, dtype=torch.long)
   158	
   159	
   160	def offsets_to_radians(offsets: Sequence, img_w: int) -> List[float]:
   161	    """
   162	    Convert panorama-column offsets to yaw angles in radians: ``d * 2*pi / img_w``.
   163	
   164	    Exact by construction on the column grid — :func:`rotate_scene_metadata`
   165	    re-quantises the angle back to ``round(alpha * img_w / 2pi) % img_w`` and
   166	    recovers the same ``d`` for every offset in the support (pinned by test), so
   167	    the recorded offset and the applied rotation can never disagree.
   168	
   169	    Parameters
   170	    ----------
   171	    offsets : Sequence
   172	        Column offsets: a ``torch.Tensor``, list, or any iterable of integers.
   173	    img_w : int
   174	        Panorama width in columns.
   175	
   176	    Returns
   177	    -------
   178	    List[float]
   179	        One angle in radians per offset, in the input order.
   180	    """
   181	    img_w = int(img_w)
   182	    if img_w <= 0:
   183	        raise ValueError(f"img_w must be > 0, got {img_w}")
   184	    if isinstance(offsets, torch.Tensor):
   185	        offsets = offsets.tolist()
   186	    return [float(int(d)) * 2.0 * math.pi / float(img_w) for d in offsets]
   187	
