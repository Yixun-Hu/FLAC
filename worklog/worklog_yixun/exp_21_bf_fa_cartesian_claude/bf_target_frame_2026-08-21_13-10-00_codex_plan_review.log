   389	def invariant_conditioning(
   390	    conditioner,
   391	    metadata: "list",
   392	    device,
   393	    angles: Tuple[float, ...] = DEFAULT_FRAME_ANGLES,
   394	    vit_ids: Tuple[str, ...] = ("source_vit", "context_poses_vit"),
   395	    max_fwd_samples: "int | None" = None,
   396	) -> Dict[str, object]:
   397	    """
   398	    Compute Route-1 yaw-symmetrized FLAC conditioning.
   399	
   400	    Two sub-paths are symmetrized independently (see the exp_03 plan §2b REVISED):
   401	
   402	    1. **Pose path** (``source`` / ``context_poses`` dist-embedders): the absolute
   403	       ``(x, y, z)`` poses are replaced by intrinsically yaw-invariant cylindrical
   404	       features ``(r, z, dphi)`` via :func:`cylindrical_pose_features`. These are
   405	       exactly invariant at *any* yaw angle.
   406	    2. **ViT path** (``vit_ids``, e.g. the DINOv3 depth-panorama conditioners): a
   407	       **frame average** ``(1/|G|) sum_g f(g . x)`` over ``angles``. The depth
   408	       map and the ``*_vit`` pose keys are rotated *together* by each frame angle;
   409	       averaging their conditioner outputs makes the result exactly invariant on
   410	       the panorama-aligned yaw subgroup G.
   411	
   412	    All remaining conditioners (e.g. the ``context_audio`` RIR encoder, which is
   413	    already yaw-invariant and may carry BatchNorm running stats) are run **exactly
   414	    once** — only the ``vit_ids`` conditioners see the rotated frames. Those are
   415	    executed in BATCHED chunks of at most ``max_fwd_samples`` samples (default
   416	    :data:`FRAME_AVG_MAX_FWD_SAMPLES`) rather than one forward per angle (the
   417	    orbit passes are latency-bound; see the constant). That partition IS the
   418	    method under announcement 06 -- it decides how many angles share one
   419	    train-mode RoPE draw -- so exp_14 declares it per arm rather than inheriting
   420	    a module constant. The averaging arithmetic, the accumulation
   421	    order and the returned structure are unchanged; train-mode DINOv3's random
   422	    RoPE rescale becomes chunk-shared, a disclosed recipe change applied
   423	    identically to every arm. The caller's
   424	    ``metadata`` is never mutated (its ``source`` / ``depth`` stay raw for the
   425	    downstream metric callback).
   426	
   427	    Parameters
   428	    ----------
   429	    conditioner : MultiConditioner
   430	        The FLAC conditioner. Must accept ``conditioner(batch, device)`` and the
   431	        optional ``only_ids=`` keyword (to re-run a subset of conditioners).
   432	    metadata : list of dict
   433	        Per-sample metadata dicts. ``depth`` (shape ``[3, H, W]``), the pose keys
   434	        and any conditioner inputs are read but not modified.
   435	    device : torch.device or str
   436	        Device passed through to ``conditioner``.
   437	    angles : Tuple[float, ...], optional
   438	        Frame-average angles in **degrees**; ``angles[0]`` must be ``0.0`` (the
   439	        identity / base pass). Defaults to :data:`DEFAULT_FRAME_ANGLES`.
   440	    vit_ids : Tuple[str, ...], optional
   441	        Conditioning ids whose outputs are frame-averaged (the ViT depth path).
   442	    max_fwd_samples : int or None, optional
   443	        Largest number of samples in ONE frame-averaging forward, i.e. the thing
   444	        that decides how many angles share a chunk (and therefore share a
   445	        train-mode RoPE draw — announcement 06). ``None`` (the default) means
   446	        :data:`FRAME_AVG_MAX_FWD_SAMPLES`, exactly today's behaviour. exp_14
   447	        passes the arm's ``training.frame_avg_max_fwd_samples`` here so the chunk
   448	        plan is a declared, checkpoint-embedded property of the arm rather than
   449	        an ambient constant.
   450	
   451	    Returns
   452	    -------
   453	    Dict[str, object]
   454	        The conditioner output dict ``{id: [tensor, mask]}``; the ``vit_ids``
   455	        tensors are replaced by their frame average, all masks come from the base
   456	        (angle-0) pass, and all other entries are the single base-pass outputs.
   457	
   458	    Raises
   459	    ------
   460	    ValueError
   461	        If ``angles`` is empty, ``angles[0] != 0.0``, or ``max_fwd_samples`` is
   462	        not a positive integer.
   463	    """
   464	    if len(angles) == 0:
   465	        raise ValueError("angles must be non-empty")
   466	    if angles[0] != 0.0:
   467	        raise ValueError(f"angles[0] must be 0.0 (the identity pass), got {angles[0]}")
   468	    # Validated HERE, before the short-circuit returns below: an invalid cap must
   469	    # abort even on an orbit that happens to need no chunking, or a typo'd arm
   470	    # could train for days without the treatment ever being read.
   471	    cap = resolve_frame_avg_cap(max_fwd_samples)
   472	
   473	    # 1. cylindrical (yaw-invariant) pose features; never mutates the caller's md.
   474	    md_inv = [cylindrical_pose_features(md) for md in metadata]
   475	
   476	    # 2. single full pass -> all conditioning entries (non-ViT ids run once here).
   477	    base = conditioner(md_inv, device)
   478	
   479	    present = [i for i in vit_ids if i in base]
   480	    if not present or len(angles) == 1 or "depth" not in metadata[0]:
   481	        return base
   482	
   483	    # 3. frame-average ONLY the ViT conditioners over the rotation subgroup.
   484	    img_w = int(metadata[0]["depth"].shape[-1])
   485	    accum = _orbit_average_batched(conditioner, md_inv, base, present, angles, img_w, device,
   486	                                   cap=cap, cap_is_explicit=max_fwd_samples is not None)
   487	
   488	    for i in present:
   489	        base[i][0] = accum[i] / float(len(angles))
   490	
   491	    return base
   492	
   493	
   494	def _rotated_variants(md_inv, deg, img_w, present):
   495	    """The rotated metadata for one orbit angle (depth and the ``*_vit`` poses
   496	    move together; every other field passes through)."""
   497	    return [
   498	        rotate_scene_metadata(m, math.radians(deg), img_w, pose_keys=tuple(present))
   499	        for m in md_inv
   500	    ]
   501	
   502	
   503	def _orbit_average_loop(conditioner, md_inv, base, present, angles, img_w, device):
   504	    """Reference orbit accumulation: ONE conditioner forward per angle.
   505	
   506	    This is the pre-batching execution order, kept as the equivalence reference
   507	    for :func:`_orbit_average_batched` (tests and the exp_11 equivalence probe
   508	    compare against *this code*, not against a copy of it). It is not used on the
   509	    training path any more.
   510	
   511	    Returns ``{id: summed_tensor}`` over the whole orbit, angle 0 first.
   512	    """
   513	    accum = {i: base[i][0].clone() for i in present}
   514	    for g in angles[1:]:
   515	        part = conditioner(_rotated_variants(md_inv, g, img_w, present), device,
   516	                           only_ids=present)
   517	        for i in present:
   518	            accum[i] = accum[i] + part[i][0]
   519	    return accum
   520	
   521	
   522	def _orbit_average_batched(conditioner, md_inv, base, present, angles, img_w, device,
   523	                           cap=None, cap_is_explicit=False):
   524	    """Same orbit sum as :func:`_orbit_average_loop`, executed as a few large forwards.
   525	
   526	    The rotated variants of consecutive angles are concatenated along the batch
   527	    dimension into chunks of at most ``cap`` samples (default
   528	    :data:`FRAME_AVG_MAX_FWD_SAMPLES`; whole angles per chunk, so a chunk is
   529	    ``k * B`` samples), each chunk is one conditioner call, and the stacked output
   530	    is split back per angle. Terms are accumulated in the INPUT ANGLE ORDER
   531	    starting from the angle-0 base, so the additions are never reassociated: the
   532	    averaging arithmetic is identical to the loop.
   533	
   534	    ``cap_is_explicit`` only selects which knob the over-cap error names — the
   535	    module constant, or the config key that overrode it. A caller that hands us a
   536	    cap it read from a config must not be told to edit a module global.
   537	
   538	    What is NOT identical is the augmentation schedule under train-mode DINOv3:
   539	    its random RoPE rescale is drawn once per forward, so a chunk's angles share
   540	    a draw (see :data:`FRAME_AVG_MAX_FWD_SAMPLES` for the disclosure). In eval
   541	    mode there is no such draw and the two paths agree numerically.
   542	
   543	    Only the ``present`` (ViT) ids are re-run; masks come from the base pass.
   544	    A batch larger than the cap is rejected rather than silently exceeding it,
   545	    because a chunk cannot be smaller than one angle.
   546	    """
   547	    accum = {i: base[i][0].clone() for i in present}
   548	    rest = angles[1:]
   549	    if not rest:
   550	        return accum
   551	    if cap is None:
   552	        cap = FRAME_AVG_MAX_FWD_SAMPLES
   553	    cap_name = ("training.frame_avg_max_fwd_samples" if cap_is_explicit
   554	                else "FRAME_AVG_MAX_FWD_SAMPLES")
   555	    batch = len(md_inv)
   556	    if batch > cap:
   557	        raise ValueError(
   558	            f"batch {batch} exceeds {cap_name} "
   559	            f"({cap}): a frame-average chunk is whole angles, so it "
   560	            "cannot be split below one angle -- lower the batch or raise the cap deliberately"
   561	        )
   562	    angles_per_chunk = max(1, cap // batch)
   563	    for start in range(0, len(rest), angles_per_chunk):
   564	        chunk = rest[start:start + angles_per_chunk]
   565	        stacked = []
   566	        for g in chunk:
   567	            stacked.extend(_rotated_variants(md_inv, g, img_w, present))
   568	        part = conditioner(stacked, device, only_ids=present)
   569	        for i in present:
   570	            out = part[i][0]
   571	            if out.shape[0] != len(chunk) * batch:
   572	                raise RuntimeError(
   573	                    f"{i}: batched orbit forward returned {out.shape[0]} rows for "
   574	                    f"{len(chunk)} angle(s) x {batch} sample(s)"
   575	                )
   576	            for k in range(len(chunk)):          # ascending angle order preserved
   577	                accum[i] = accum[i] + out[k * batch:(k + 1) * batch]
   578	    return accum
   579	
