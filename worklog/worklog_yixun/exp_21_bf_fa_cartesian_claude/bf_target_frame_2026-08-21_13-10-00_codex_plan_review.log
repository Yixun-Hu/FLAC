   656	def protocol_label(base, exp11, evidence_ready):
   657	    """The row's protocol string. exp_11 rows always disclose 'batched'; the
   658	    historical 'legacy-loop' migration waits for the deferred regeneration."""
   659	    if "fa" not in base:
   660	        return base
   661	    if exp11:
   662	        return base if "batched" in base else f"{base} (batched)"
   663	    if not evidence_ready:
   664	        return base
   665	    return base if "legacy-loop" in base else f"{base} (legacy-loop)"
