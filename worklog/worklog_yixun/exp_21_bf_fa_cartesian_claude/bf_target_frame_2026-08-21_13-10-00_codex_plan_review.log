   834	def split_per_scene_metrics(metrics_dict):
   835	    """``(flat_metrics, by_scene_or_None)``.
   836	
   837	    ``AcousticMetricsCallback.compute_metrics`` returns the per-scene map nested
   838	    INSIDE the metrics dict under ``by_scene``. The record keeps ``metrics`` flat
   839	    and numeric -- every existing consumer reads ``record["metrics"][key]`` as a
   840	    number, and the exp_11 row validator pins that key set exactly -- so the map
   841	    is lifted out here and recorded beside it instead.
   842	    """
   843	    if "by_scene" not in metrics_dict:
   844	        return dict(metrics_dict), None
   845	    flat = {k: v for k, v in metrics_dict.items() if k != "by_scene"}
   846	    return flat, metrics_dict["by_scene"]
   847	
   848	
   849	def resolve_metrics_payload(computed, record_per_scene=False):
   850	    """``(metrics_dict, by_scene)`` — what the record will carry.
   851	
   852	    FROZEN UNLESS ASKED (round-3 closure A1/B1). The callback emits ``by_scene``
   853	    on its own for some configurations — HAA turns per-scene metrics on
   854	    independently of this flag (``metric_callback.py``) — so lifting the block
   855	    unconditionally rewrote records that never asked for it: the legacy NESTED
   856	    ``metrics["by_scene"]`` disappeared and three top-level keys appeared. That
   857	    is exactly the re-keying of historical rows the byte-compat contract exists
   858	    to prevent, and it was invisible to the snapshot matrix, whose payloads carry
   859	    no per-scene block at all.
   860	
   861	    Without the flag the callback result is passed through untouched. With it,
   862	    the block is lifted — and a callback that produced none is an error, because
   863	    the run asked for the estimand and did not measure it.
   864	    """
   865	    if not record_per_scene:
   866	        return computed, None
   867	    metrics_dict, by_scene = split_per_scene_metrics(computed)
   868	    if by_scene is None:
   869	        raise RuntimeError(
   870	            "--record-per-scene was requested but the metric callback returned no "
   871	            "per-scene block; the per-scene estimand was not measured."
   872	        )
   873	    return metrics_dict, by_scene
   874	
   875	
   876	def _per_scene_provenance(record, by_scene):
   877	    """Add the per-scene block -- ONLY when the run actually recorded one.
   878	
   879	    Fixed-mode legacy records stay byte-identical (review B4, still binding), so
   880	    nothing is added, removed or reordered unless ``--record-per-scene`` asked
   881	    for it. An EMPTY map is refused rather than recorded: a run that asked for
   882	    per-scene results and produced none did not measure the estimand, and
   883	    recording ``{}`` would publish that silence as a fact.
   884	    """
   885	    if by_scene is None:
   886	        return record
   887	    if not isinstance(by_scene, dict) or not by_scene:
   888	        raise ValueError(
   889	            f"per-scene recording produced {by_scene!r}: a run that asked for "
   890	            "per-scene results and produced none did not measure the per-scene "
   891	            "estimand, so there is nothing to record."
   892	        )
   893	    record["by_scene"] = by_scene
   894	    record["per_scene_schema"] = PER_SCENE_SCHEMA
   895	    record["scene_count"] = len(by_scene)
   896	    return record
