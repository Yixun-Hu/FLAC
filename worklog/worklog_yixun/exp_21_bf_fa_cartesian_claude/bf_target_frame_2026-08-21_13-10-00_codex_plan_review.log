    43	            f"{enabled!r}"
    44	        )
    45	
    46	    if not enabled:
    47	        return {}
    48	
    49	    if training_config.get("cond_method", "vanilla") == "fa_invariant":
    50	        raise ValueError(
    51	            "training.yaw_aug.enabled=true with cond_method='fa_invariant' is an "
    52	            "untested combination and out of scope for exp_15: frame averaging "
    53	            "already symmetrises over the yaw subgroup."
    54	        )
    55	
    56	    for key in ("img_w", "seed"):
