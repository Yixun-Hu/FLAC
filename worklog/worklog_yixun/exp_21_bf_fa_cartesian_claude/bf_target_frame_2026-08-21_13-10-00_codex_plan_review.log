   746	def agg_files(files):
   747	    """Aggregate one cell's per-seed JSONs. RAISES on a payload it cannot print.
   748	
   749	    Round-3 review B5: a missing key raised KeyError deep inside a regeneration,
   750	    and a non-finite value propagated into a published mean as `nan`. Both are
   751	    now one named ValueError, which render_row turns into a BLOCKED row.
   752	    """
   753	    if not files:
   754	        return None, 0
   755	    vals = {k: [] for k, _ in KEYS}
   756	    for f in files:
   757	        d = json.load(open(f))
   758	        d = d.get("metrics") if isinstance(d, dict) else None
   759	        if not isinstance(d, dict):
   760	            raise ValueError(f"{os.path.basename(f)}: no metrics object to aggregate")
