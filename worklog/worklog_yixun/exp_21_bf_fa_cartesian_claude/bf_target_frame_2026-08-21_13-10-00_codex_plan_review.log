   268	    def forward(self, coord, device: tp.Union[torch.device, str] = "cuda") -> tp.Tuple[torch.Tensor, torch.Tensor]:
   269	        self.vit.to(device)
   270	        self.proj_out.to(device)
   271	
   272	        depth_coords, coords = [], []
   273	        for c in coord:
   274	            coords.append(c['coord'].float().to(device))
   275	            depth_coords.append(c['depth'].float().to(device))
