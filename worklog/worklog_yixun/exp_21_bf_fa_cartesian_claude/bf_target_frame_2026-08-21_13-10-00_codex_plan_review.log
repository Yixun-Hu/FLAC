    58	def convert_equirect_to_camera_coord(depth_map, img_h, img_w): # 3D point cloud per pixel
    59	    phi, theta = torch.meshgrid(torch.arange(img_h), torch.arange(img_w), indexing='ij')
    60	    theta_map = (theta + 0.5) * 2.0 * np.pi / img_w - np.pi
    61	    phi_map = (phi + 0.5) * np.pi / img_h - np.pi / 2
    62	    sin_theta = torch.sin(theta_map)
    63	    cos_theta = torch.cos(theta_map)
    64	    sin_phi = torch.sin(phi_map)
    65	    cos_phi = torch.cos(phi_map)
    66	    return torch.stack([depth_map * cos_phi * cos_theta, depth_map * cos_phi * sin_theta, -depth_map * sin_phi], dim=-1)
