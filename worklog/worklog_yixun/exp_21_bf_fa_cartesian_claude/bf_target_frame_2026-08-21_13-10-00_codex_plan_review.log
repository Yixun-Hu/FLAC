    23	        return {}
    24	
    25	    block = training_config["yaw_aug"]
    26	    if not isinstance(block, dict):
    27	        raise ValueError(
    28	            f"training.yaw_aug must be an object with keys {list(YAW_AUG_KEYS)}, "
    29	            f"got {type(block).__name__}"
