    89	
    90	def record(k=8, seed=42, **over):
    91	    """The metrics record ``build_metrics_record`` writes for a registered cell.
    92	
    93	    Key order and field names follow eval_FLAC.build_metrics_record; the values
    94	    are the plan §5 template's."""
    95	    rec = {
    96	        "metrics": dict(METRICS),
    97	        "ckpt_path": CKPT,
    98	        "rotate_deg": 0.0,
    99	        "cond_method": "fa_cartesian",
   100	        "frame_avg_angles": [0.0, 90.0, 180.0, 270.0],
   101	        "cond_autocast": "bf16",
   102	        "orbit_execution": "batched",
   103	        "frame_avg_fwd_cap": 64,
   104	        "source_sha": PIN,
   105	        "batch_size": 64,
   106	        "n_samples": 6337,
   107	        "dataset_config": DATASET[k],
   108	        "seed": seed,
   109	        "cfg_scale": 1.0,
   110	        "steps": 1,
   111	        "eval_name": f"exp21_BFC_S40000_K{k}_s{seed}",
   112	        "weights_source": "ema",
   113	        "device": "cuda",
   114	        # --record-per-scene is part of the registered command (plan §5), so the
   115	        # per-scene payload is part of the registered record.
   116	        "by_scene": by_scene(),
   117	        "per_scene_schema": 1,
   118	        "scene_count": 10,
   119	    }
   120	    rec.update(over)
   121	    return rec
   122	
   123	
   124	def write_cell(dirpath, k=8, seed=42, **over):
   125	    """One per-seed JSON at the path the row glob expects."""
   126	    os.makedirs(dirpath, exist_ok=True)
   127	    rec = record(k, seed, **over)
   128	    name = (f"epoch=19-step=40000_metrics_1_1.0_"
   129	            f"exp21_BFC_S40000_K{k}_s{seed}_fa_cartesian_a4.json")
   130	    path = os.path.join(dirpath, name)
   131	    with open(path, "w") as fh:
   132	        json.dump(rec, fh)
   133	    return path
   134	
   135	
   136	def full_cell(tmp_path, k=8, **over):
   137	    d = tmp_path / f"K{k}"
   138	    return [write_cell(str(d), k=k, seed=s, **over) for s in (42, 43, 44, 45, 46)]
