   431	def sample_target_id(md):
   432	    """Identity of the target item at one stream position: ``'<idx>|<relpath>'``.
   433	
   434	    ``SampleDataset.__getitem__`` silently substitutes a *random other item* when
   435	    a file fails to load or is silent (``return self[random.randrange(len(self))]``),
   436	    and the substituted sample carries its OWN ``idx``/``relpath``. Recording both
   437	    is therefore what makes the stream auditable: a hash over offsets alone would
   438	    prove the RNG sequence and nothing about which item received which offset.
   439	
   440	    Falls back to the absolute ``path`` when ``relpath`` is absent (it is only set
   441	    when the file sits under a configured root). An item with neither is a
   442	    hard error: an unidentifiable position makes the whole audit worthless.
   443	    """
   444	    idx = md.get('idx', None)
   445	    rel = md.get('relpath', None) or md.get('path', None)
   446	    if rel is None:
   447	        raise ValueError(
   448	            "cannot record stream identity: metadata carries neither 'relpath' nor "
   449	            "'path'. The assignment audit (plan §3.3) requires a per-item identity."
   450	        )
   451	    return f'{idx}|{rel}'
   452	
   453	
   454	def sample_context_ids(md):
   455	    """Ordered fingerprint of the reference sources this sample actually drew.
   456	
   457	    ``AR_md.get_custom_metadata`` picks the K context sources with
   458	    ``np.random.choice`` per sample and does NOT expose their paths, so the
   459	    strongest identity that reaches ``eval_FLAC`` is each source's 3D position
   460	    (``context_poses``, listener-relative, one row per reference in draw order).
   461	    Distinct sources sit metres apart, so a fixed 6-decimal rendering identifies
   462	    the draw exactly while being byte-stable across machines.
   463	
   464	    Read BEFORE any rotation: ``rotate_scene_metadata`` rewrites ``context_poses``,
   465	    and a fingerprint taken afterwards would encode the rotation instead of the
   466	    item (and could never match its unrotated pair).
   467	
   468	    The rendering is FAIL-CLOSED on its own assumptions (review N4). A six-decimal
   469	    string is only a stable identity while the tensor is exactly what the AR loader
   470	    produces --- ``torch.vstack`` of float32 ``[K, 3]`` positions --- and the
   471	    measured sensitivity is not academic: on the real unseen split, rendering the
   472	    same positions as float64 changes two strings and float16 changes 5,032. A
   473	    silently different dtype would therefore produce hashes that mismatch across
   474	    machines for no scientific reason, so it raises instead.
   475	    """
   476	    poses = md.get('context_poses', None)
   477	    if poses is None:
   478	        return []
   479	    if not isinstance(poses, torch.Tensor):
   480	        raise ValueError(
   481	            f"context_poses must be a torch.Tensor to be fingerprinted, got "
   482	            f"{type(poses).__name__}."
   483	        )
   484	    if poses.dtype != torch.float32:
   485	        raise ValueError(
   486	            f"context_poses must be float32 to be fingerprinted, got {poses.dtype}: "
   487	            "the six-decimal rendering is not dtype-stable (review N4), so a "
   488	            "different dtype would silently produce non-comparable hashes."
   489	        )
   490	    if poses.dim() != 2 or poses.shape[0] < 1 or poses.shape[1] != 3:
   491	        raise ValueError(
   492	            f"context_poses must have shape [K, 3] with K >= 1 to be fingerprinted, "
   493	            f"got {tuple(poses.shape)}."
   494	        )
   495	    if not bool(torch.isfinite(poses).all()):
   496	        raise ValueError(
   497	            "context_poses must be finite to be fingerprinted: a NaN or Inf position "
   498	            "renders to a string that cannot identify a reference source."
   499	        )
   500	    out = []
   501	    for row in poses:
   502	        vals = []
   503	        for v in row:
   504	            val = float(v)
   505	            if val == 0.0:
   506	                val = 0.0  # normalise -0.0, whose rendering would differ
   507	            vals.append(f'{val:.{CONTEXT_ID_PRECISION}f}')
   508	        out.append(','.join(vals))
   509	    return out
