   507	# --------------------------------------------------------------------------- #
   508	# 3b. the CONDITIONING DISPATCH itself — which function the eval loop calls
   509	# --------------------------------------------------------------------------- #
   510	# The tests above drive evaluate_model with an EMPTY dataloader, so they never
   511	# execute the loop body: deleting the fa_cartesian dispatch branch would leave
   512	# every one of them green while the arm silently evaluated as VANILLA — a
   513	# single-pass conditioning reported under a record that claims a C4 orbit, which
   514	# is the announcement-05 failure in its worst form (plausible numbers, wrong
   515	# arm). That is the exact coverage defect the r2 review caught on the training
   516	# side, so the branch gets its own pin: one real batch through the loop, with
   517	# only the sampler stubbed.
   518	def _one_batch_loader(n=2):
   519	    """A dataloader of exactly one batch: (reals, metadata) with real depth
   520	    panoramas and poses, since the loop's metric stage reads md['depth'],
   521	    md['source'] and md['scene']."""
   522	    return [(torch.zeros(n, 1, 64), _batch(n))]
   523	
   524	
   525	def _spy_conditioning(monkeypatch):
   526	    """Replace both frame-average entry points with recording spies (at the
   527	    eval_FLAC namespace, which is where the dispatch resolves them)."""
   528	    calls = []
   529	
   530	    def make(name):
   531	        def spy(*args, **kwargs):
   532	            calls.append({"fn": name, "args": args, "kwargs": kwargs})
   533	            return {"stub": [torch.zeros(len(args[1]), 1), None]}
   534	        return spy
   535	
   536	    monkeypatch.setattr(eval_FLAC, "fa_cartesian_conditioning", make("fa_cartesian"))
   537	    monkeypatch.setattr(eval_FLAC, "invariant_conditioning", make("fa_invariant"))
   538	    monkeypatch.setattr(
