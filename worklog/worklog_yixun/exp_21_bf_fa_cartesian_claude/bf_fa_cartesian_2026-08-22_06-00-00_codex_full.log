   663	def _orbit_average_loop(conditioner, md_inv, base, present, angles, img_w, device):
   664	    """Reference orbit accumulation: ONE conditioner forward per angle.
   665	
   666	    This is the pre-batching execution order, kept as the equivalence reference
   667	    for :func:`_orbit_average_batched` (tests and the exp_11 equivalence probe
   668	    compare against *this code*, not against a copy of it). It is not used on the
   669	    training path any more.
   670	
   671	    Returns ``{id: summed_tensor}`` over the whole orbit, angle 0 first.
   672	    """
   673	    accum = {i: base[i][0].clone() for i in present}
   674	    for g in angles[1:]:
   675	        part = conditioner(_rotated_variants(md_inv, g, img_w, present), device,
   676	                           only_ids=present)
   677	        for i in present:
   678	            accum[i] = accum[i] + part[i][0]
   679	    return accum
