   352	        super().__init__()
   353	        self.drop_prob = drop_prob
   354	
   355	    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
   356	        return drop_path(hidden_states, self.drop_prob, self.training)
   357	
   358	    def extra_repr(self) -> str:
   359	        return f"p={self.drop_prob}"
