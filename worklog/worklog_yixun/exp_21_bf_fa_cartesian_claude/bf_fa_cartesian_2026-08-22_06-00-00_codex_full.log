   662	def test_bfc_differs_from_bf_in_exactly_two_training_leaves():
   663	    """The single-mechanism claim, pinned programmatically. ``cond_method`` is the
   664	    mechanism; the cap is decision D5 (a declared knob that postdates B-F's
   665	    training, chosen for draw-schedule parity, not a method change). Anything
   666	    else — an optimizer constant, a metric flag, a ViT setting — would make the
   667	    comparison a multi-factor one that no readout can untangle."""
   668	    flat_bf, flat_bfc = _flat(_bf()), _flat(_bfc())
   669	    added = set(flat_bfc) - set(flat_bf)
   670	    removed = set(flat_bf) - set(flat_bfc)
   671	    changed = {k for k in set(flat_bf) & set(flat_bfc) if flat_bf[k] != flat_bfc[k]}
   672	
   673	    assert removed == set(), f"BFC drops {sorted(removed)}"
   674	    assert added == {("training", CAP_KEY)}, f"BFC adds {sorted(added)}"
   675	    assert changed == {("training", "cond_method")}, f"BFC changes {sorted(changed)}"
