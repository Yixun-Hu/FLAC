   639	    if shas and without_sha:
   640	        problems.append(f"{len(without_sha)} of {len(records)} records carry no "
   641	                        f"{V.CKPT_SHA_FIELD} while the others do ({sorted(without_sha)}): a "
   642	                        "partially proven checkpoint identity is not a proven one")
   643	    if len(shas) > 1:
   644	        problems.append(f"the cell spans MORE THAN ONE {V.CKPT_SHA_FIELD} {sorted(shas)}: "
   645	                        "the same path can name different bytes")
   646	    # the evidence must be the DECLARED row's, not merely self-consistent
   647	    if expected_k is not None and ks and ks != {int(expected_k)}:
   648	        problems.append(f"the row declares K={int(expected_k)} but its evidence is "
   649	                        f"K {sorted(ks)}: a renamed payload is not a re-measurement")
   650	    # exactly one record per registered seed: "no seed missing" also holds for six
   651	    # files with a duplicate, which agg_files would then average as six
   652	    if sorted(seeds) != list(V.SEEDS):
   653	        counts = {s: seeds.count(s) for s in sorted(set(seeds))}
   654	        dupes = sorted(s for s, n in counts.items() if n > 1)
   655	        problems.append(f"the cell must be exactly {len(V.SEEDS)} records, one per seed "
   656	                        f"{list(V.SEEDS)}; got {len(seeds)} with seeds {sorted(seeds)}"
   657	                        + (f" (duplicated: {dupes})" if dupes else ""))
