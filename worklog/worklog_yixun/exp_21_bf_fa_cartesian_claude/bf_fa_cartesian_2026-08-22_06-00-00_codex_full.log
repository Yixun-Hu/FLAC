   812	def check_q9_round(q9_cells):
   813	    """The Q9 estimand is a WITHIN-PIN delta, so the round is one transaction.
   814	
   815	    Per-cell validation proves each arm x K block internally; it cannot see that
   816	    the four blocks belong together. Without this, one arm could publish without
   817	    its comparator, or the arms could be measured at different evaluator pins and
   818	    still validate individually — and the frame-averaging delta would then be
   819	    confounded with whatever moved between those pins, which is the one thing the
   820	    same-pin design exists to exclude."""
   821	    present = {key: files for key, files in q9_cells.items() if files}
   822	    if not present:
   823	        return []                                   # nothing landed yet: not an update
   824	    problems = []
   825	    if len(present) != Q9_REQUIRED_CELLS:
   826	        missing = [f"{lbl} (K={k})" for (lbl, k), f in sorted(q9_cells.items()) if not f]
   827	        problems.append(f"the Q9 round publishes as ONE transaction: {len(present)}/"
   828	                        f"{Q9_REQUIRED_CELLS} cells have evidence, missing "
   829	                        + (", ".join(missing) or "<unregistered cells>"))
   830	    shas = {}
   831	    for key, files in sorted(present.items()):
   832	        for f in files:
   833	            try:
   834	                sha = json.load(open(f)).get("source_sha")
   835	            except Exception as exc:
   836	                problems.append(f"{os.path.basename(f)}: unreadable while checking the Q9 pin ({exc})")
   837	                continue
   838	            shas.setdefault(str(sha), []).append(f"{key[0]} K={key[1]}")
   839	    if len(shas) > 1:
   840	        detail = "; ".join(f"{sha[:12]}: {sorted(set(cells))}" for sha, cells in sorted(shas.items()))
   841	        problems.append("the Q9 round spans MORE THAN ONE evaluator pin, so the VANL-vs-C4L "
   842	                        f"delta is not a within-pin comparison — {detail}")
   843	    return problems
