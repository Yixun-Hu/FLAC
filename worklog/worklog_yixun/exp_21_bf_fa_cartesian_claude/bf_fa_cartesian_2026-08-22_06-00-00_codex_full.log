   732	
   733	def check_exp14_round(exp14_cells, exp14_status):
   734	    """Which exp_14 arms may publish, and why the others may not.
   735	
   736	    Returns ``(withheld_labels, problems)``.
   737	
   738	    Two rules, deliberately at different scopes (round-3 review B4):
   739	
   740	    * **Per ARM, a two-K transaction.** An arm publishes when BOTH its K rows
   741	      carry a full five-seed block AND BOTH VALIDATED, and not before — a lone K
   742	      would invite a K=8-only comparison against rows that carry both. It does
   743	      NOT wait for the other arms: §5.7 sequences the regeneration on VANL's own
   744	      block completing, so a campaign-wide gate would withhold exactly the row
   745	      that triggered it.
   746	
   747	      ``exp14_status`` maps ``(label, K) -> bool`` and is REQUIRED: readiness
   748	      used to be declared from file counts alone, never seeing the validation
   749	      already computed while rendering, so five valid K=1 files beside five K=8
   750	      files carrying one NaN published a numeric K=1 row next to a BLOCKED K=8
   751	      one — the transaction violated in exactly the direction it exists to
   752	      prevent (round-3 closure A4/B2).
   753	    * **Across ARMS, one campaign pin.** exp_14 is a one-pin campaign and its
   754	      whole point is that VANL-vs-Cn carries no cross-pin difference. If the
   755	      published arms disagree on ``source_sha``, none of them publishes.
   756	    """
   757	    present = {key: files for key, files in exp14_cells.items() if files}
   758	    if not present:
   759	        return set(), []                           # nothing landed yet: not an update
   760	    problems, ready, shas = [], set(), {}
   761	    arms = {exp14_arm_of(label) for label, _k in exp14_cells}
   762	    for arm in sorted(arms):
   763	        rows = {k: exp14_cells.get((label, k))
   764	                for (label, k) in exp14_cells if exp14_arm_of(label) == arm}
   765	        if not any(rows.values()):
   766	            continue                               # this arm has not started
   767	        short = {k: (0 if f is None else len(f)) for k, f in rows.items()
   768	                 if f is None or len(f) < MIN_SEEDS}
   769	        if short:
   770	            problems.append(f"{arm}: publishes only as a complete two-K pair; "
   771	                            + ", ".join(f"K={k} has {n}/{MIN_SEEDS} seeds"
   772	                                        for k, n in sorted(short.items())))
   773	            continue
   774	        # counting files is not validating them: a five-file block can still be
   775	        # refused (a NaN, a wrong checkpoint digest, a missing stream audit), and
   776	        # its partner must not publish beside it.
