  1092	        if not line.startswith("|") or set(line) <= set("|- "):
  1093	            continue
  1094	        cells = [c.strip() for c in line.strip("|").split("|")]
  1095	        if len(cells) < 5 or cells[0] == "Model":
  1096	            continue
  1097	        try:
  1098	            k, n = int(cells[2]), int(cells[3])
  1099	        except ValueError:
  1100	            continue                      # header / footnote lines
  1101	        rows[(cells[0], k)] = {"n": n, "numeric": bool(_NUMERIC_CELL.match(cells[4]))}
  1102	    return rows
