   548	        pre-change call" are different guarantees, and every arm already in the
   549	        record — including the cluster's in-flight exp_12C run — was trained
   550	        through the four-argument form. Only an arm that DECLARES a cap gets a
   551	        different call shape.
   552	        """
   553	        if self.cond_method == "fa_invariant":
   554	            if self.frame_avg_max_fwd_samples is None:
   555	                return invariant_conditioning(
   556	                    self.diffusion.conditioner, metadata, self.device, self.frame_avg_angles
   557	                )
   558	            return invariant_conditioning(
