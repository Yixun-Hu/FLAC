   827	def _rotation_provenance(record, rotate_mode, rotate_seed, input_hash,
   828	                         assignment_hash, stream_count, img_w):
   829	    """Add exp_14's random-rotation provenance to a record -- IN RANDOM MODE ONLY.
   830	
   831	    Fixed-mode records must stay byte-identical to every row already committed
   832	    (review B4), so nothing is added, removed or reordered there. In random mode
   833	    the keys are APPENDED (a collector reads both generations with one schema) and
   834	    ``rotate_deg`` is overwritten in place with ``None``: no single angle describes
   835	    the run, and recording 0.0 would make a randomly-rotated cell indistinguishable
   836	    from an unrotated one.
