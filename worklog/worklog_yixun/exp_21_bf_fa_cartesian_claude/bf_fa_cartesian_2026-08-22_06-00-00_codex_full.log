   275	def resolve_are_from_checkpoint(embedded_model_config, file_model_config,
   276	                                are_lambda=None):
   277	    """``(lambda_or_None, source, anchor_block_or_None)`` — BOUND TO THE CHECKPOINT.
   278	
   279	    Round-1 defect (r1 code review, finding 2): ``evaluate_model`` read the
   280	    checkpoint and the ``--model-config`` JSON as two independent objects and then
   281	    took lambda AND the calibrated constants from the JSON alone. A checkpoint
   282	    trained against one anchor could therefore be evaluated against another — it
   283	    would load cleanly, the numbers would look plausible, and the metrics row
   284	    would record the *file's* provenance rather than the artifact's. Announcement
   285	    05's whole point is that this class of mismatch is invisible after the fact.
   286	
   287	    The rule, applied only when ARE is in play so that every non-ARE evaluation
   288	    stays byte-identical to the rows already committed:
   289	
   290	    1. The checkpoint MUST carry an embedded ``model_config``. Without it there is
   291	       no way to prove which anchor trained these weights, and an assumed one is
   292	       exactly what this function exists to forbid.
   293	    2. The embedded config and the ``--model-config`` file must agree
   294	       TYPE-STRICTLY (``1`` is not ``1.0``, which is precisely the distinction the
   295	       factory enforces).
   296	    3. The anchor block is then taken from the EMBEDDED config — the artifact is
   297	       the authority, the file is only checked against it.
   298	    4. ``--are-lambda`` may override the **dose** (AR3's ``{0, 0.5, 1}`` sweep) and
   299	       nothing else. It can never change *which* anchor is added back.
   300	
   301	    An arm is "in play" if either side declares ARE, so a checkpoint trained with
   302	    ARE cannot be quietly evaluated through a non-ARE config (which would silently
   303	    skip the add-back and report the residual as if it were an RIR).
   304	    """
   305	    embedded_declares = isinstance(embedded_model_config, dict) and _are_declared(
   306	        embedded_model_config)
   307	    file_declares = _are_declared(file_model_config)
   308	
   309	    if not (embedded_declares or file_declares or are_lambda is not None):
   310	        return None, None, None
   311	
   312	    if not isinstance(embedded_model_config, dict):
   313	        raise ValueError(
   314	            "ARE evaluation requires the checkpoint's embedded 'model_config', and this "
   315	            "checkpoint carries none. Without it the anchor this arm was TRAINED "
   316	            "against cannot be proven, and evaluating against an assumed one would "
   317	            "produce plausible, unfalsifiable numbers (announcement 05). Re-export the "
   318	            "checkpoint from a run whose train.py embedded its config.")
   319	
   320	    diff = _load_exp16_readback().type_strict_diff(
   321	        embedded_model_config, file_model_config,
   322	        label_a="the checkpoint", label_b="--model-config")
   323	    if diff is not None:
   324	        raise ValueError(
   325	            "the checkpoint's embedded model_config does not match --model-config "
   326	            f"(type-strict); first difference: {diff}. Refusing to evaluate: the "
   327	            "add-back anchor would not be the anchor this checkpoint was trained "
   328	            "against, and the metrics row would record the file's provenance rather "
   329	            "than the artifact's.")
   330	
   331	    embedded_training = embedded_model_config.get("training") or {}
