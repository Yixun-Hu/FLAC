   513	def check_exp15_round(rendered):
   514	    """``[problem, ...]`` — the exp_15 YAWAUG pair publishes whole or not at all.
   515	
   516	    ADDITIVE and exp_15-only: no other contract reaches this. A row is publishable
   517	    when it rendered a numeric line (not pending, not BLOCKED) for BOTH K.
   518	    """
   519	    rows = [r for r in rendered if r.get("contract") == "exp15"]
   520	    if not rows:
   521	        return []
   522	    problems = []
   523	    ks = sorted({r["K"] for r in rows})
   524	    if ks != [1, 8]:
   525	        problems.append(f"expected K=1 and K=8 rows, found {ks}")
   526	    for r in rows:
   527	        line = r.get("line", "")
   528	        if "BLOCKED" in line:
   529	            problems.append(f"K={r['K']} is BLOCKED")
   530	        elif "*pending" in line:
   531	            problems.append(f"K={r['K']} is pending ({r.get('n')}/{MIN_SEEDS} seeds)")
   532	    # ...and if either K is unpublishable, NEITHER publishes.
   533	    if problems:
   534	        problems.append("both K rows publish together or neither does")
   535	    return problems
