   421	# 2b. the batch-vs-cap PRE-FLIGHT (r3 review nit 3)
   422	# --------------------------------------------------------------------------- #
   423	# The orbit executor already refuses batch > cap, but it does so at the FIRST
   424	# chunk and — whenever a cap was supplied, which every registered evaluation does
   425	# — its message names ``training.frame_avg_max_fwd_samples``: a training-config
   426	# key this entry point never reads. An operator following it edits the arm's JSON
   427	# and the eval fails again. Round 4 moves the check to argument validation, where
   428	# it names the two CLI flags that actually decide the outcome, and where it costs
   429	# no model, dataloader or GPU work. The refusal is METHOD-GATED on
   430	# FRAME_AVERAGED_COND_METHODS, so vanilla — which never chunks anything — is
   431	# untouched, and it applies to fa_invariant as well as fa_cartesian (the review
   432	# sanctioned exactly that widening: fa_invariant carries the same wrong knob name
   433	# today).
   434	@pytest.mark.parametrize("cond_method", ["fa_cartesian", "fa_invariant"])
   435	def test_an_over_cap_batch_is_refused_before_any_work(tmp_path, monkeypatch, cond_method):
   436	    """batch 64 with cap 32 is unsatisfiable — a chunk is whole angles — so it
   437	    must abort in argument validation, naming BOTH operator knobs. Every path
   438	    argument points at a nonexistent file and model construction trips a loud
   439	    sentinel, so a late failure would surface as FileNotFoundError or the
   440	    sentinel instead."""
   441	    monkeypatch.setattr(
   442	        eval_FLAC, "create_model_from_config",
   443	        lambda *a, **k: pytest.fail("evaluate_model reached model construction"),
   444	    )
   445	    with pytest.raises(ValueError) as excinfo:
   446	        eval_FLAC.evaluate_model(
   447	            str(tmp_path / "missing_model.json"), str(tmp_path / "missing_ds.json"),
   448	            str(tmp_path / "missing.ckpt"), steps=1, cfg_scale=1.0, device="cpu",
   449	            cond_method=cond_method, frame_avg_max_fwd_samples=32, batch_size=64,
   450	        )
   451	    msg = str(excinfo.value)
   452	    assert "--frame-avg-max-fwd-samples" in msg     # the knob this entry point reads
   453	    assert "--batch-size" in msg                    # ...and the other half of the pair
   454	    assert "training.frame_avg_max_fwd_samples" not in msg   # NOT the training key
   455	    assert "64" in msg and "32" in msg              # the two numbers, not just a rule
