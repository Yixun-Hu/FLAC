   928	    # so the exp_11 branch below would otherwise claim them and block every one on
   929	    # an eval name its validator was never written to parse.
   930	    if contract == "exp14z" or is_exp14_row([os.path.basename(f) for f in files]):
   931	        ok, problems = validate_exp14_cell(files, repo_root=repo_root,
   932	                                           expected_arm=exp14_arm_of(label),
   933	                                           expected_k=K)
   934	        if not ok:
   935	            detail = problems[0] if problems else "unspecified"
   936	            return (f"| {label} | {proto} | {K} | {len(files)} | "
   937	                    f"**BLOCKED — row validation failed:** {detail} | | | | | |"), True
   938	    elif is_exp11_row(files) or any("exp11_" in os.path.basename(f) for f in files):
   939	        ok, problems = validate_exp11_cell(files, repo_root=repo_root,
   940	                                           validator_path=validator_path, contract=contract)
   941	        if not ok:
   942	            detail = problems[0] if problems else "unspecified"
   943	            return (f"| {label} | {proto} | {K} | {len(files)} | "
   944	                    f"**BLOCKED — row validation failed:** {detail} | | | | | |"), True
   945	    if contract == "exp15":
   946	        ok, problems = validate_exp15_cell(files, repo_root=repo_root, expected_k=K)
   947	        if not ok:
   948	            detail = problems[0] if problems else "unspecified"
   949	            return (f"| {label} | {proto} | {K} | {len(files)} | "
   950	                    f"**BLOCKED — row validation failed:** {detail} | | | | | |"), True
   951	        r, n = agg_files_exp15(files)
   952	    else:
   953	        # exp_21 publishes the FLAT split-level metrics every comparator row uses
   954	        # (plan §5), so it takes the ordinary aggregation - but only after its own
