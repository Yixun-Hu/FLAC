   609	def build_stream_record(plan, stream):
   610	    """The ``.stream.json`` payload: the assignment audit WITH its preimages.
   611	
   612	    A digest alone is unfalsifiable evidence --- it can declare two cells matched,
   613	    but when they do not match it cannot say where or why, and it cannot be
   614	    recomputed by anyone who does not already trust the writer (review B2). This
   615	    payload therefore carries the full ordered canonical tuples and the
   616	    per-position offsets, from which both hashes are recomputable, plus the
   617	    schema versions needed to read them under the right contract.
   618	
   619	    ``rotate_seed`` is null in fixed mode (nothing was drawn) and ``rotate_deg``
   620	    is null in random mode (no single angle describes the run) --- the same
   621	    asymmetry the metrics record uses, so the two never disagree.
   622	    """
   623	    return {
   624	        "schema_version": STREAM_SCHEMA_VERSION,
   625	        "fingerprint_schema": CONTEXT_FINGERPRINT_SCHEMA,
   626	        "rotate_mode": plan.mode,
   627	        "rotate_seed": plan.rotate_seed,
   628	        "rotate_deg": plan.rotate_deg,
   629	        "img_w": stream.img_w,
   630	        "stream_count": len(stream),
   631	        "input_tuples": stream.input_tuples(),
   632	        "offsets": stream.offsets,
   633	        "assignment_tuples": stream.assignment_tuples(),
   634	        "input_hash": stream.input_hash(),
   635	        "assignment_hash": stream.assignment_hash(),
   636	    }
