   639	def verify_stream_positions(stream):
   640	    """Substitution guard, positionally: stream position ``i`` must be dataset item ``i``.
   641	
   642	    Evaluation runs with ``shuffle=False`` over a sequential sampler, so this
   643	    holds by construction --- unless ``SampleDataset.__getitem__`` substituted a
   644	    random other item after a load or silence failure, which is exactly the event
   645	    the assignment audit exists to catch. A hash can only reveal that by
   646	    comparison against another cell; this catches it in the cell that suffered it.
   647	
   648	    Raises ``RuntimeError`` naming the FIRST offending position. An item without
   649	    an ``idx`` cannot be checked and is not silently accepted.
   650	    """
   651	    for row in stream.rows:
   652	        if row.dataset_idx is None:
   653	            raise RuntimeError(
   654	                f"rotation stream position {row.position} has no dataset 'idx', so it "
   655	                "cannot be checked against its position. Refusing to report metrics."
   656	            )
   657	        if row.dataset_idx != row.position:
   658	            raise RuntimeError(
   659	                f"rotation stream position {row.position} carries dataset idx "
   660	                f"{row.dataset_idx} (target {row.target_id!r}): the dataset served a "
   661	                "different item than the sequential sampler asked for -- "
   662	                "SampleDataset substitutes a random item on a load/silence failure. "
   663	                "Refusing to report metrics."
   664	            )
   665	
