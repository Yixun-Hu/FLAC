   137	
   138	def _finite(value):
   139	    """A measured number, not a NaN, an Inf, a bool or a numeric string."""
   140	    return (isinstance(value, (int, float)) and not isinstance(value, bool)
   141	            and math.isfinite(float(value)))
   142	
   143	
   144	def parse_ckpt_step(ckpt_path):
   145	    """The optimizer step a checkpoint path names; ``ValueError`` if it does not.
   146	
   147	    Exactly one ``step=<n>`` token, on a ``.ckpt``: two tokens are ambiguous and
   148	    none is unprovable, and both are more likely to be a path built by hand than
   149	    one PL wrote.
   150	    """
   151	    if not isinstance(ckpt_path, str) or not ckpt_path.endswith(".ckpt"):
   152	        raise ValueError(f"ckpt_path {ckpt_path!r} is not a .ckpt path")
   153	    steps = CKPT_STEP_RE.findall(os.path.basename(ckpt_path))
   154	    if len(steps) != 1:
   155	        raise ValueError(
   156	            f"ckpt_path {ckpt_path!r} names {len(steps)} 'step=<n>' tokens; a registered "
   157	            "cell evaluates one PL checkpoint, whose basename carries exactly one")
   158	    return int(steps[0])
   159	
   160	
   161	def per_scene_reasons(record):
   162	    """``[reason, ...]`` for the per-scene payload ``--record-per-scene`` writes.
   163	
   164	    The flat metrics remain the table estimand; this block is the registered
   165	    AUXILIARY estimand (the paper-style per-scene mean), and a row published
   166	    without it silently drops a deliverable the registered command produced.
   167	    """
   168	    reasons = []
   169	    by_scene = record.get("by_scene")
   170	    if not isinstance(by_scene, dict) or not by_scene:
   171	        return [f"by_scene is {by_scene!r}: the registered command passes "
   172	                "--record-per-scene, so the per-scene payload is part of the record "
   173	                "(plan §3g requires the ten room families)"]
   174	    if record.get("per_scene_schema") != PER_SCENE_SCHEMA:
   175	        reasons.append(f"per_scene_schema is {record.get('per_scene_schema', '<absent>')!r}, "
   176	                       f"not {PER_SCENE_SCHEMA}: a payload written under another schema "
   177	                       "does not mean what this gate reads")
   178	    if record.get("scene_count") != len(by_scene):
   179	        reasons.append(f"scene_count {record.get('scene_count', '<absent>')!r} != the "
   180	                       f"{len(by_scene)} scene(s) actually recorded")
   181	    got = tuple(sorted(by_scene))
   182	    if got != EXPECTED_SCENE_KEYS:
   183	        missing = [k for k in EXPECTED_SCENE_KEYS if k not in by_scene]
   184	        extra = [k for k in got if k not in EXPECTED_SCENE_KEYS]
   185	        reasons.append(
   186	            "by_scene is not the registered AR room-family grouping"
   187	            + (f"; missing {missing}" if missing else "")
   188	            + (f"; unexpected {extra}" if extra else "")
   189	            + " -- two different groupings of the same size are the same number of "
   190	              "scenes and a DIFFERENT estimand")
   191	    # Every family's payload must itself be usable evidence: the per-seed
   192	    # observation is the mean OVER these ten values, so one NaN or one missing
   193	    # T60 does not degrade the estimate, it destroys it.
   194	    for scene in sorted(set(EXPECTED_SCENE_KEYS) & set(by_scene)):
   195	        payload = by_scene[scene]
   196	        if not isinstance(payload, dict):
   197	            reasons.append(f"by_scene[{scene!r}] is {payload!r}, not a metric map")
   198	            continue
   199	        for metric in REQUIRED_SCENE_METRICS:
   200	            if metric not in payload:
   201	                reasons.append(f"by_scene[{scene!r}] does not report {metric}")
   202	            elif not _finite(payload[metric]):
   203	                reasons.append(f"by_scene[{scene!r}].{metric} = {payload[metric]!r} is not "
   204	                               "a finite number")
   205	        for metric in OPTIONAL_SCENE_METRICS:
   206	            if metric in payload and not _finite(payload[metric]):
   207	                reasons.append(f"by_scene[{scene!r}].{metric} = {payload[metric]!r} is not "
   208	                               "a finite number")
   209	    return reasons
