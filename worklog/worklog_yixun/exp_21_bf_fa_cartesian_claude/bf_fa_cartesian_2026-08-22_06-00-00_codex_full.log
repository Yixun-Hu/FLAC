   527	class RotationStream:
   528	    """Accumulates the §3.3 assignment record: what was evaluated, in what order,
   529	    with which rotation.
   530	
   531	    Two digests are derived from it, and they answer different questions:
   532	
   533	    * ``input_hash`` -- ``(i, target_id, context_ids, img_w)``: *which* items and
   534	      reference draws the cell saw. Independent of the rotation, so it is the
   535	      pairing key between a Z (unrotated) cell and its R (rotated) partner, and
   536	      the cross-arm equality check.
   537	    * ``assignment_hash`` -- ``(i, target_id, d_i)``: which item received which
   538	      offset. Equal across arms iff they were rotated identically.
   539	    """
   540	
   541	    def __init__(self):
   542	        self.rows = []
   543	
   544	    def __len__(self):
   545	        return len(self.rows)
   546	
   547	    def record(self, md, offset, img_w):
   548	        """Append one position. ``md`` must be the PRE-rotation metadata."""
   549	        img_w = int(img_w)
   550	        if self.rows and img_w != self.rows[0].img_w:
   551	            raise ValueError(
   552	                f"img_w changed mid-stream: {self.rows[0].img_w} -> {img_w}. The "
   553	                "column grid defines the offsets, so it cannot vary within a run."
   554	            )
   555	        idx = md.get('idx', None)
   556	        row = StreamRow(
   557	            position=len(self.rows),
   558	            target_id=sample_target_id(md),
   559	            context_ids=sample_context_ids(md),
   560	            img_w=img_w,
   561	            offset=None if offset is None else int(offset),
   562	            dataset_idx=None if idx is None else int(idx),
   563	        )
   564	        self.rows.append(row)
   565	        return row
   566	
   567	    @property
   568	    def img_w(self):
   569	        return self.rows[0].img_w if self.rows else None
   570	
   571	    @property
   572	    def target_ids(self):
   573	        """Per-position target identities, for comparison against a split manifest."""
   574	        return [r.target_id for r in self.rows]
   575	
   576	    @property
   577	    def offsets(self):
   578	        return [r.offset for r in self.rows]
   579	
   580	    def input_tuples(self):
   581	        return [[r.position, r.target_id, r.context_ids, r.img_w] for r in self.rows]
   582	
   583	    def assignment_tuples(self):
   584	        return [[r.position, r.target_id, r.offset] for r in self.rows]
   585	
   586	    def input_hash(self):
   587	        return canonical_stream_hash(self.input_tuples())
   588	
   589	    def assignment_hash(self):
   590	        return canonical_stream_hash(self.assignment_tuples())
