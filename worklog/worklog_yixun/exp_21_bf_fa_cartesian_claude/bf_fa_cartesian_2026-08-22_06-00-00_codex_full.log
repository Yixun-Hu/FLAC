   978	def agg_files(files):
   979	    """Aggregate one cell's per-seed JSONs. RAISES on a payload it cannot print.
   980	
   981	    Round-3 review B5: a missing key raised KeyError deep inside a regeneration,
   982	    and a non-finite value propagated into a published mean as `nan`. Both are
   983	    now one named ValueError, which render_row turns into a BLOCKED row.
   984	    """
   985	    if not files:
   986	        return None, 0
   987	    vals = {k: [] for k, _ in KEYS}
   988	    for f in files:
   989	        d = json.load(open(f))
   990	        d = d.get("metrics") if isinstance(d, dict) else None
   991	        if not isinstance(d, dict):
   992	            raise ValueError(f"{os.path.basename(f)}: no metrics object to aggregate")
   993	        for k, kk in KEYS:
   994	            if kk not in d:
   995	                raise ValueError(f"{os.path.basename(f)}: does not report {kk}")
   996	            if not _finite_number(d[kk]):
   997	                raise ValueError(f"{os.path.basename(f)}: {kk} = {d[kk]!r} is not a "
   998	                                 "finite number")
   999	            vals[k].append(d[kk])
  1000	    n = len(files)
  1001	    return {k: (st.mean(v), st.stdev(v) if n > 1 else 0.0) for k, v in vals.items()}, n
