   966	                f"*pending ({n}/{MIN_SEEDS} seeds on disk)* | | | | | |"), False
   967	    cells = " | ".join(f"{m:.3f} ± {s:.3f}" if k != "C50" else f"{m:.4f} ± {s:.4f}"
   968	                       for k, (m, s) in r.items())
