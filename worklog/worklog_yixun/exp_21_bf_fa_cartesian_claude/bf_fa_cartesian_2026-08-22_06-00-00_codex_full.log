   827	def _rotation_provenance(record, rotate_mode, rotate_seed, input_hash,
   828	                         assignment_hash, stream_count, img_w):
   829	    """Add exp_14's random-rotation provenance to a record -- IN RANDOM MODE ONLY.
   830	
   831	    Fixed-mode records must stay byte-identical to every row already committed
   832	    (review B4), so nothing is added, removed or reordered there. In random mode
   833	    the keys are APPENDED (a collector reads both generations with one schema) and
   834	    ``rotate_deg`` is overwritten in place with ``None``: no single angle describes
   835	    the run, and recording 0.0 would make a randomly-rotated cell indistinguishable
   836	    from an unrotated one.
   837	    """
   838	    if rotate_mode not in ROTATE_MODES:
   839	        raise ValueError(
   840	            f"Unknown rotate_mode: {rotate_mode!r}; valid options: {list(ROTATE_MODES)}."
   841	        )
   842	    if rotate_mode != 'random':
   843	        return record
   844	    record["rotate_deg"] = None
   845	    record["rotate_mode"] = rotate_mode
   846	    record["rotate_seed"] = rotate_seed
   847	    record["input_hash"] = input_hash
   848	    record["assignment_hash"] = assignment_hash
   849	    record["stream_count"] = stream_count
   850	    record["img_w"] = img_w
   851	    return record
   852	
   853	
   854	# Version of the per-scene payload below (exp_14 round-3 fix R3F1). Bumped when
   855	# the meaning of a field changes, so a collector never reads an old block under a
   856	# new contract.
   857	PER_SCENE_SCHEMA = 1
   858	
   859	
   860	def split_per_scene_metrics(metrics_dict):
   861	    """``(flat_metrics, by_scene_or_None)``.
   862	
   863	    ``AcousticMetricsCallback.compute_metrics`` returns the per-scene map nested
   864	    INSIDE the metrics dict under ``by_scene``. The record keeps ``metrics`` flat
   865	    and numeric -- every existing consumer reads ``record["metrics"][key]`` as a
   866	    number, and the exp_11 row validator pins that key set exactly -- so the map
   867	    is lifted out here and recorded beside it instead.
   868	    """
   869	    if "by_scene" not in metrics_dict:
   870	        return dict(metrics_dict), None

