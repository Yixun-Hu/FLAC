   665	def check_exp21_round(exp21_cells, exp21_status):
   666	    """``[problem, ...]`` - the exp_21 BFC pair publishes whole, at one pin, or not
   667	    at all.
   668	
   669	    ``exp21_status`` maps ``(label, K) -> bool`` and carries the validation that
   670	    was ALREADY computed while rendering: readiness derived from file counts
   671	    alone once published a numeric K=1 row beside a BLOCKED K=8 one (exp_14
   672	    round-3 closure A4/B2).
   673	
   674	    No evidence at all is NOT a failed transaction - it is a registered row that
   675	    has not landed yet, which the generator renders as pending. Same carve-out as
   676	    ``check_q9_round`` and ``check_exp14_round``, and it is what keeps another
   677	    machine's regeneration silent until exp_21 actually measures something.
   678	    """
   679	    present = {key: files for key, files in exp21_cells.items() if files}
   680	    if not present:
   681	        return []
   682	    problems, shas = [], {}
   683	    for label in sorted({lbl for lbl, _k in exp21_cells}):
   684	        for k in (1, 8):
   685	            files = exp21_cells.get((label, k))
   686	            if not files:
   687	                problems.append(f"{label}: K={k} has no evidence - the exp_21 row publishes "
   688	                                "only as a complete K=1 + K=8 pair")
   689	            elif len(files) < MIN_SEEDS:
   690	                problems.append(f"{label}: K={k} has {len(files)}/{MIN_SEEDS} seeds")
   691	            elif not exp21_status.get((label, k), False):
   692	                problems.append(f"{label}: K={k} did not validate - both K must be VALID, "
   693	                                "not merely present, or the pair publishes a number beside "
   694	                                "a refusal")
   695	    # ...and ONE evaluator pin across both K: per-cell validation proves each K
   696	    # internally, but cannot see that the two blocks were measured at different
   697	    # commits, which is precisely what the paired K=1/K=8 reading would inherit.
   698	    ckpts = {}
   699	    for (label, k), files in sorted(present.items()):
   700	        for path in files:
   701	            try:
   702	                with open(path) as fh:
   703	                    record = json.load(fh)
   704	            except Exception as exc:               # noqa: BLE001
   705	                problems.append(f"{os.path.basename(path)}: unreadable while checking the "
   706	                                f"exp_21 pin ({exc})")
   707	                continue
   708	            shas.setdefault(str(record.get("source_sha")), []).append(f"{label} K={k}")
   709	            ckpts.setdefault(os.path.normpath(str(record.get("ckpt_path"))),
   710	                             []).append(f"{label} K={k}")
   711	    # ONE checkpoint across BOTH K (r4 review BLOCKING 3). K=1 and K=8 evaluate
   712	    # the same weights and differ only in context size; per-cell validation
   713	    # proves each block internally and cannot see that they came from different
   714	    # runs, which would make the paired K reading a comparison of two models.
   715	    if len(ckpts) > 1:
   716	        detail = "; ".join(f"{os.path.basename(c)}: {sorted(set(cells))}"
   717	                           for c, cells in sorted(ckpts.items()))
   718	        problems.append("the exp_21 K=1 and K=8 rows were produced from MORE THAN ONE "
   719	                        f"checkpoint - {detail}")
   720	    if len(shas) > 1:
   721	        detail = "; ".join(f"{sha[:12]}: {sorted(set(cells))}"
   722	                           for sha, cells in sorted(shas.items()))
   723	        problems.append("the exp_21 K=1 and K=8 rows span MORE THAN ONE evaluator pin, so "
   724	                        f"the paired reading is not a within-pin comparison - {detail}")
   725	    return problems
