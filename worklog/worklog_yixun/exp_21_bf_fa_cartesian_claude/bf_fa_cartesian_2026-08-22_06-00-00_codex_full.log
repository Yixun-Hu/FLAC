  1085	def evaluate_model(
  1086	    model_config_path,
  1087	    dataset_config_path,
  1088	    ckpt_path,
  1089	    steps,
  1090	    cfg_scale,
  1091	    batch_size=64,
  1092	    num_workers=6,
  1093	    eval_name='FLAC_eval', 
  1094	    device='cuda' if torch.cuda.is_available() else 'cpu',
  1095	    seed=42,
  1096	    store_predictions=False,
  1097	    rotate_deg=0.0,
  1098	    cond_method='vanilla',
  1099	    frame_avg_angles=None,
  1100	    frame_avg_max_fwd_samples=None,
  1101	    cond_autocast='default',
  1102	    allow_partial_load=False,
  1103	    rotate_mode='fixed',
  1104	    rotate_seed=None,
  1105	    expected_stream_count=None,
  1106	    record_stream=False,
  1107	    record_per_scene=False,
  1108	    are_lambda=None,
  1109	):
  1110	    # Fail fast on an unknown cond_method (the CLI is guarded by argparse
  1111	    # choices, but programmatic callers would otherwise silently run vanilla
  1112	    # while filenames/meta record the unknown method).
  1113	    if cond_method not in COND_METHODS:
  1114	        raise ValueError(
  1115	            f"Unknown cond_method: {cond_method!r}; valid options: "
  1116	            + ", ".join(repr(m) for m in COND_METHODS) + "."
  1117	        )
  1118	
  1119	    # The EVALUATION chunk plan, validated before any file/model work for the same
  1120	    # reason as the rotation protocol below: a misconfigured cap must never reach a
  1121	    # GPU. It is a separate, explicitly pinned quantity from the cap a checkpoint
  1122	    # was TRAINED under (exp_14 plan §3.1) -- both arms are evaluated at one common
  1123	    # cap, and the value is recorded in the metrics row.
  1124	    try:
  1125	        frame_avg_max_fwd_samples = resolve_frame_avg_cap(frame_avg_max_fwd_samples)
  1126	    except ValueError as err:                      # name the operator-facing knob
  1127	        raise ValueError(
  1128	            f"--frame-avg-max-fwd-samples (frame_avg_max_fwd_samples): {err}"
  1129	        ) from err
  1130	
  1131	    # ...and the same plan's OTHER half: the batch must fit inside one chunk.
  1132	    # The orbit executor already refuses batch > cap, but at the first chunk and
  1133	    # -- whenever a cap was supplied, which every registered evaluation does --
  1134	    # under the name `training.frame_avg_max_fwd_samples`: a TRAINING-config key
  1135	    # this entry point never reads, so the message sends the operator to a knob
  1136	    # that cannot fix the run (r3 review nit 3). Checked here it costs no file,
  1137	    # model, dataloader or GPU work, and it names the two CLI flags that decide
  1138	    # the outcome. Method-gated: vanilla runs no orbit, so its cap is inert and
  1139	    # must not be able to refuse a run.
  1140	    if (cond_method in FRAME_AVERAGED_COND_METHODS
  1141	            and batch_size is not None and batch_size > frame_avg_max_fwd_samples):
  1142	        raise ValueError(
  1143	            f"--batch-size {batch_size} exceeds --frame-avg-max-fwd-samples "
  1144	            f"{frame_avg_max_fwd_samples} under --cond-method {cond_method}: a "
  1145	            "frame-average chunk is whole angles, so it cannot be split below one "
  1146	            f"angle. Lower --batch-size to at most {frame_avg_max_fwd_samples}, or "
  1147	            "raise --frame-avg-max-fwd-samples deliberately and record the new chunk "
  1148	            "plan (announcement 06). NOTE this is the EVALUATION cap, separate from "
  1149	            "the arm's training cap."
  1150	        )
  1151	
  1152	    # Resolve (and validate) the rotation protocol before any file/model work:
  1153	    # a misconfigured rotation must never reach a GPU (see resolve_rotation_plan).
  1154	    rotation_plan = resolve_rotation_plan(rotate_mode, rotate_deg, rotate_seed, seed)
  1155	
  1156	    # An expectation that cannot be checked must not be quietly accepted: a plain
  1157	    # fixed-mode run accumulates no stream, so there is nothing to count.
  1158	    accumulate_stream = rotation_plan.is_random or bool(record_stream)
  1159	    if expected_stream_count is not None and not accumulate_stream:
  1160	        raise ValueError(
  1180	    # Resolve the C4 frame-average angles (only used by the frame-averaged
  1181	    # methods, FRAME_AVERAGED_COND_METHODS; ignored under vanilla).
  1182	    if frame_avg_angles is None:
  1183	        frame_avg_angles = DEFAULT_FRAME_ANGLES
  1184	    frame_avg_angles = tuple(float(a) for a in frame_avg_angles)
  1185	
  1186	    # Load configurations
  1187	    with open(model_config_path) as f:
  1188	        model_config = json.load(f)
  1189	
  1190	    # The comparison against the checkpoint's embedded config must be against the
  1191	    # file AS WRITTEN: `training_config` is mutated below (use_ema is flipped once
  1192	    # EMA weights are folded in), and comparing a mutated object would let a real
  1193	    # mismatch slip through as "expected".
  1194	    file_model_config = copy.deepcopy(model_config)
  1195	
  1196	    training_config = model_config.get('training', None)
  1197	    
  1198	    # Load ckpt
  1199	    ckpt = torch.load(ckpt_path, map_location='cpu')
  1200	    state_dict = ckpt['state_dict']
  1201	    for key in list(state_dict.keys()):
  1202	        if key.startswith('diffusion.'):
  1203	            new_key = key.replace('diffusion.', '')
  1204	            state_dict[new_key] = state_dict.pop(key)
  1205	    
  1206	    # Use EMA weights if available (the resolved source is recorded, not assumed)
  1207	    weights_source = resolve_weights_source(training_config, state_dict.keys())
  1208	    if training_config.get("use_ema", False) and any(k.startswith('diffusion_ema.ema_model.') for k in state_dict.keys()):
  1209	        print('Using EMA model')
  1210	        for key in list(state_dict.keys()):
  1211	            if key.startswith('diffusion_ema.ema_model.'):
  1212	                new_key = key.replace('diffusion_ema.ema_model.', 'model.')
  1213	                state_dict[new_key] = state_dict.pop(key)
  1214	        training_config['use_ema'] = False
  1215	
  1216	    # exp_16 (ARE), r1 review finding 2: bind the add-back to the ARTIFACT before
  1217	    # any model is built. A checkpoint trained against one anchor must never be
  1218	    # evaluated against another, and this is the last point at which that can be
  1219	    # refused for free.
  1220	    are_lambda, are_lambda_source, are_anchor_cfg = resolve_are_from_checkpoint(
  1221	        ckpt.get('model_config'), file_model_config, are_lambda)
