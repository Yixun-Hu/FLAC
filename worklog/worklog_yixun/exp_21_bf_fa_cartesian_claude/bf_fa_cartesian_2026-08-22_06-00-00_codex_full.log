    85	# point it engages on its own, for every cell that carries it. Named here, once,
    86	# so the driver and the table cannot disagree about the spelling.
    87	CKPT_SHA_FIELD = "ckpt_sha256"
    88	CKPT_SHA_RE = re.compile(r"^[0-9a-f]{64}$")
    89	
    90	# --- the per-scene (auxiliary) estimand (r4 review BLOCKING 2) -----------------
    91	# The ten AR room families are DERIVED, never typed: `data/AR/unseen_eval.json`
    92	# is a dict keyed by room family, and `AR_md.py:23` sets `md['scene']` to exactly
    93	# that key -- which is what `--record-per-scene` groups on. So the registered
    94	# split file IS the canonical grouping, it travels with the repo, and it agrees
    95	# with the list exp_15 read back from a real committed exp_14 artifact (pinned by
    96	# test). Deriving it fail-closed at import is deliberate: a table gate that
    97	# cannot state the grouping must refuse the row, not guess it.
    98	SPLIT_REL_PATH = os.path.join("data", "AR", "unseen_eval.json")
    99	PER_SCENE_SCHEMA = 1                 # eval_FLAC.PER_SCENE_SCHEMA
   100	# Per family, the ACOUSTIC family is what the per-scene mean is taken over (plan
   101	# §5); FD and retrieval stay split-level. exp_15's ratified list additionally
   102	# names "Invalid T60", which is checked HERE when present but not required, since
   103	# requiring it would be exp_21 inventing a contract for itself.
   104	REQUIRED_SCENE_METRICS = ("T60", "C50", "EDT")
   105	OPTIONAL_SCENE_METRICS = ("Invalid T60",)
   106	
   107	
   108	def _repo_root(start=None):
   109	    """Marker-walk to the repo root; survives worklog relocations."""
   110	    path = os.path.abspath(start or os.path.dirname(os.path.abspath(__file__)))
   111	    while not os.path.isdir(os.path.join(path, ".git")):
   112	        parent = os.path.dirname(path)
   113	        if parent == path:
   114	            raise RuntimeError("repo root (.git) not found from " + str(start))
   115	        path = parent
   116	    return path
   117	
   118	
   119	def _derive_scene_keys():
   120	    path = os.path.join(_repo_root(), SPLIT_REL_PATH)
   121	    try:
   122	        with open(path) as handle:
   123	            payload = json.load(handle)
   124	    except (OSError, ValueError) as exc:
   125	        raise RuntimeError(
   126	            f"cannot derive the AR room families from {path} ({exc}): the exp_21 table "
   127	            "gate states the per-scene grouping from the registered split itself and "
   128	            "refuses to fall back on a hand-written list") from exc
   129	    if not isinstance(payload, dict) or not payload:
   130	        raise RuntimeError(f"{path} is not a non-empty scene->items map")
   131	    return tuple(sorted(payload))
   132	
   133	
   134	EXPECTED_SCENE_KEYS = _derive_scene_keys()
   135	EXPECTED_SCENES = len(EXPECTED_SCENE_KEYS)
