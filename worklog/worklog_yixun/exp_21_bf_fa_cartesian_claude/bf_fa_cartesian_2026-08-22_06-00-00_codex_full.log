   549	
   550	def _load_exp21_validator(path=None):
   551	    """exp_21's own validator, imported by path (same shape as exp_11/14/15)."""
   552	    import importlib.util
   553	    target = os.path.abspath(path or EXP21_VALIDATOR)
   554	    spec = importlib.util.spec_from_file_location("exp21_validate_cell", target)
   555	    if spec is None or spec.loader is None:
   556	        raise ImportError(f"cannot load the exp_21 validator from {target}")
   557	    module = importlib.util.module_from_spec(spec)
   558	    spec.loader.exec_module(module)
   559	    return module
