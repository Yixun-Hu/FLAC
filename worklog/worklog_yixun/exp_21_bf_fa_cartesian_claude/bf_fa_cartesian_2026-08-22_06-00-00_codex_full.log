   494	def fa_cartesian_conditioning(
   495	    conditioner,
   496	    metadata: "list",
   497	    device,
   498	    angles: Tuple[float, ...] = DEFAULT_FRAME_ANGLES,
   499	    max_fwd_samples: "int | None" = None,
   500	) -> Dict[str, object]:
   501	    """
   502	    Full-C4 **Cartesian** frame averaging of every pose/geometry conditioner (exp_21).
   503	
   504	    :func:`invariant_conditioning` symmetrizes its two sub-paths by different
   505	    mechanisms — intrinsically yaw-invariant cylindrical features ``(r, z, dphi)``
   506	    for the pose path, a frame average for the ViT path. This method applies ONE
   507	    mechanism to both. The poses stay raw Cartesian ``(x, y, z)``, i.e. inside the
   508	    dist-embedder's training domain, and the whole orbit is averaged::
   509	
   510	        out[id] = (1/|G|) sum_g f_id(g . x)      for id in POSE_KEYS
   511	
   512	    over the panorama-aligned yaw subgroup ``G`` given by ``angles``. Every frame
   513	    rotates the depth panorama and ALL FOUR pose keys jointly (one
   514	    :func:`rotate_scene_metadata` call with ``pose_keys=POSE_KEYS``), so a frame
   515	    is a rigid rotation of the whole scene rather than of one branch of it.
   516	
   517	    The invariance class is therefore exact on ``G`` and on nothing else: an
   518	    off-subgroup angle is a genuine NEGATIVE CONTROL here, where the cylindrical
   519	    pose path was invariant at any angle. No scene-intrinsic reference azimuth is
   520	    computed, so the ``+-pi`` discontinuity and the meters/radians mixing of the
   521	    cylindrical triplets are both out of the picture.
   522	
   523	    ``context_audio`` — and any other id the conditioner produces — comes from
   524	    the single base pass. It is yaw-invariant already and may carry BatchNorm
   525	    running statistics, so re-running it per frame would step those statistics
   526	    ``|G|`` times per training step. The ViT branch is structurally the one
   527	    :func:`invariant_conditioning` runs (``GeometryConditioner`` reads only its
   528	    own ``*_vit`` pose and ``depth``, neither of which the cylindrical step
   529	    touched, and the extra dist-embedder orbit calls consume no RNG), which is
   530	    pinned numerically by ``src/tests/test_fa_cartesian.py``.
   531	
   532	    Two contracts are FAIL-CLOSED, and both are deliberately STRICTER than
   533	    :func:`invariant_conditioning`, which short-circuits to the base pass when the
   534	    orbit ids or ``depth`` are absent:
   535	
   536	    * every id in :data:`POSE_KEYS` must be present in the conditioner's output.
   537	      Averaging whichever subset happened to exist would ship an arm whose
   538	      treatment differs from the declared one, invisibly.
   539	    * every sample must carry ``depth``, and all samples must agree on the
   540	      panorama width. The orbit rotates depth and poses together, so a missing
   541	      panorama would average four differently-posed views of ONE unrotated map —
   542	      a silently degraded orbit, not a skipped one. This is checked BEFORE the
   543	      base pass so that a mixed-width batch is reported by this contract rather
   544	      than by whatever the conditioner's own batching happens to do with it first.
   545	
   546	    Execution and arithmetic are the audited orbit machinery, unchanged:
   547	    :func:`_orbit_average_batched` with ``present = POSE_KEYS`` (angle-0 base
   548	    first, ascending angle order, chunks of whole angles capped by
   549	    ``max_fwd_samples`` — announcement 06's declared chunk plan). Masks come from
   550	    the base pass for every id, and the caller's ``metadata`` is never mutated: it
   551	    is handed to the conditioner as-is and stays raw for the downstream metric
   552	    callback.
   553	
   554	    Parameters
   555	    ----------
   556	    conditioner : MultiConditioner
   557	        The FLAC conditioner. Must accept ``conditioner(batch, device)`` and the
   558	        optional ``only_ids=`` keyword (to re-run a subset of conditioners).
   559	    metadata : list of dict
   560	        Per-sample metadata dicts. ``depth`` (shape ``[3, H, W]``), the pose keys
   561	        and any conditioner inputs are read but not modified.
   562	    device : torch.device or str
   563	        Device passed through to ``conditioner``.
   564	    angles : Tuple[float, ...], optional
   565	        Frame-average angles in **degrees**; ``angles[0]`` must be ``0.0`` (the
   566	        identity / base pass). Defaults to :data:`DEFAULT_FRAME_ANGLES`.
   567	    max_fwd_samples : int or None, optional
   568	        Largest number of samples in ONE frame-averaging forward, i.e. the thing
   569	        that decides how many angles share a chunk (and therefore share a
   570	        train-mode RoPE draw — announcement 06). ``None`` means
   571	        :data:`FRAME_AVG_MAX_FWD_SAMPLES`. The arm passes its
   572	        ``training.frame_avg_max_fwd_samples`` here.
   573	
   574	    Returns
   575	    -------
   576	    Dict[str, object]
   577	        The conditioner output dict ``{id: [tensor, mask]}``; the
   578	        :data:`POSE_KEYS` tensors are replaced by their frame average, all masks
   579	        come from the base (angle-0) pass, and every other entry is the single
   580	        base-pass output.
   581	
   582	    Raises
   583	    ------
   584	    ValueError
   585	        If ``angles`` is empty, ``angles[0] != 0.0``, ``max_fwd_samples`` is not a
   586	        positive integer, ``metadata`` is empty, a sample has no ``depth``, the
   587	        samples disagree on the panorama width, or the conditioner output is
   588	        missing any of :data:`POSE_KEYS`.
   589	    """
   590	    if len(angles) == 0:
   591	        raise ValueError("angles must be non-empty")
   592	    if angles[0] != 0.0:
   593	        raise ValueError(f"angles[0] must be 0.0 (the identity pass), got {angles[0]}")
   594	    # Validated HERE, before the short-circuit return below: an invalid cap must
   595	    # abort even on an orbit that happens to need no chunking, or a typo'd arm
   596	    # could train for days without the treatment ever being read.
   597	    cap = resolve_frame_avg_cap(max_fwd_samples)
   598	
   599	    # 1. depth contract (fail-closed) + the single column-shift rule of the orbit.
   600	    if len(metadata) == 0:
   601	        raise ValueError("fa_cartesian_conditioning: metadata is empty")
   602	    img_w = None
   603	    for k, md in enumerate(metadata):
   604	        if "depth" not in md:
   605	            raise ValueError(
   606	                f"fa_cartesian_conditioning requires 'depth' in EVERY sample's "
   607	                f"metadata; sample {k} has {sorted(md)}. The orbit rotates the "
   608	                "panorama and the poses together, so a missing panorama would "
   609	                "average four differently-posed views of one unrotated map -- a "
   610	                "silently degraded orbit, not a no-op"
   611	            )
   612	        depth = md["depth"]
   613	        assert isinstance(depth, torch.Tensor)
   614	        width = int(depth.shape[-1])
   615	        if img_w is None:
   616	            img_w = width
   617	        elif width != img_w:
   618	            raise ValueError(
   619	                f"fa_cartesian_conditioning: sample {k} has panorama width "
   620	                f"{width} but sample 0 has {img_w}. One orbit is ONE column-shift "
   621	                "rule, so a mixed-width batch would rotate different samples by "
   622	                "different effective angles"
   623	            )
   624	
   625	    # 2. single full pass on the RAW Cartesian metadata -> all conditioning
   626	    #    entries (context_audio and any other id run exactly once, here).
   627	    base = conditioner(metadata, device)
   628	
   629	    present = list(POSE_KEYS)
   630	    missing = [i for i in present if i not in base]
   631	    if missing:
   632	        raise ValueError(
   633	            f"fa_cartesian_conditioning: the conditioner produced {sorted(base)}, "
   634	            f"missing {missing} of POSE_KEYS {list(POSE_KEYS)}. This method's "
   635	            "contract is that ALL FOUR pose/geometry conditioners are frame-"
   636	            "averaged; averaging whichever subset happened to be present would "
   637	            "ship an arm whose treatment nobody declared"
   638	        )
   639	
   640	    if len(angles) == 1:
   641	        return base
   642	
   643	    # 3. frame-average every pose/geometry conditioner over the rotation subgroup.
   644	    accum = _orbit_average_batched(conditioner, metadata, base, present, angles, img_w,
   645	                                   device, cap=cap,
   646	                                   cap_is_explicit=max_fwd_samples is not None)
   647	
   648	    for i in present:
   649	        base[i][0] = accum[i] / float(len(angles))
   650	
   651	    return base
   652	
   653	
   654	def _rotated_variants(md_inv, deg, img_w, present):
   655	    """The rotated metadata for one orbit angle (depth and the ``*_vit`` poses
   656	    move together; every other field passes through)."""
   657	    return [
   658	        rotate_scene_metadata(m, math.radians(deg), img_w, pose_keys=tuple(present))
   659	        for m in md_inv
   660	    ]
   661	
   662	
   663	def _orbit_average_loop(conditioner, md_inv, base, present, angles, img_w, device):
   664	    """Reference orbit accumulation: ONE conditioner forward per angle.
   665	
   666	    This is the pre-batching execution order, kept as the equivalence reference
   667	    for :func:`_orbit_average_batched` (tests and the exp_11 equivalence probe
   668	    compare against *this code*, not against a copy of it). It is not used on the
   669	    training path any more.
   670	
   671	    Returns ``{id: summed_tensor}`` over the whole orbit, angle 0 first.
   672	    """
   673	    accum = {i: base[i][0].clone() for i in present}
   674	    for g in angles[1:]:
   675	        part = conditioner(_rotated_variants(md_inv, g, img_w, present), device,
   676	                           only_ids=present)
   677	        for i in present:
   678	            accum[i] = accum[i] + part[i][0]
   679	    return accum
   680	
