   680	def test_eval_batch_64_needs_cap_64_and_cap_32_is_refused():
   681	    """NO-CHANGE PIN. The plan declares TRAINING and EVAL chunk plans separately:
   682	    training runs cap 32 at micro-batch 32 (one angle per chunk), evaluation runs
   683	    batch 64 and therefore REQUIRES cap >= 64 — a chunk is whole angles and cannot
   684	    be split below one. Pinned against the function the eval path calls, so the
   685	    §5 template's ``--frame-avg-max-fwd-samples 64`` is a checked requirement
   686	    rather than a convention: at cap 32 the registered command would abort on the
   687	    first batch, hours into a queued cell."""
   688	    md = _batch(64)
   689	    cond = _build_cond()
   690	    out = yr.fa_cartesian_conditioning(cond, md, "cpu", C4, max_fwd_samples=64)
   691	    # batch 64, cap 64 -> one angle per chunk: the base pass plus three chunks.
   692	    assert cond.conditioners["source"].batch_sizes == [64, 64, 64, 64]
   693	    for key in POSE_KEYS:
   694	        assert out[key][0].shape[0] == 64
   695	        assert torch.isfinite(out[key][0]).all()
   696	
   697	    with pytest.raises(ValueError, match="exceeds"):
   698	        yr.fa_cartesian_conditioning(_build_cond(), md, "cpu", C4, max_fwd_samples=32)
