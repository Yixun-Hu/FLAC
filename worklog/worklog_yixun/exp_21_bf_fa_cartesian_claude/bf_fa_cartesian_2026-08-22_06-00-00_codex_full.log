   838	    if rotate_mode not in ROTATE_MODES:
   839	        raise ValueError(
   840	            f"Unknown rotate_mode: {rotate_mode!r}; valid options: {list(ROTATE_MODES)}."
   841	        )
   842	    if rotate_mode != 'random':
   843	        return record
   844	    record["rotate_deg"] = None
   845	    record["rotate_mode"] = rotate_mode
   846	    record["rotate_seed"] = rotate_seed
   847	    record["input_hash"] = input_hash
   848	    record["assignment_hash"] = assignment_hash
   849	    record["stream_count"] = stream_count
   850	    record["img_w"] = img_w
   851	    return record
