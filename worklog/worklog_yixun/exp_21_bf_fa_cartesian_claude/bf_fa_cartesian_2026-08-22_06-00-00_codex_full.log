   634	# 6. the arm config is FLAC_AR_BF.json plus exactly two declared deltas
   635	# --------------------------------------------------------------------------- #
   636	def _flat(obj, prefix=()):
   637	    """Every leaf of a parsed JSON document, keyed by its full path. A dict
   638	    comparison says only WHETHER two configs differ; the experiment's claim is
   639	    about exactly WHICH leaves differ."""
   640	    if isinstance(obj, dict):
   641	        out = {}
   642	        for k, v in obj.items():
   643	            out.update(_flat(v, prefix + (k,)))
   644	        return out
   645	    if isinstance(obj, list):
   646	        out = {}
   647	        for i, v in enumerate(obj):
   648	            out.update(_flat(v, prefix + (i,)))
   649	        return out
   650	    return {prefix: obj}
   651	
