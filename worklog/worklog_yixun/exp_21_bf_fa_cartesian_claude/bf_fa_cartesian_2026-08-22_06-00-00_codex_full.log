    43	    if _EXP16_READBACK is None:
    44	        import importlib.util
    45	        path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
    46	                            "worklog", "worklog_yixun", "exp_16_are_port_claude",
    47	                            "readback.py")
