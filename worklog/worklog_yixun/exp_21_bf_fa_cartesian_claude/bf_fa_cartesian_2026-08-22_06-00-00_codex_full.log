   211	
   212	def ckpt_reasons(record):
   213	    """``[reason, ...]`` for the checkpoint this record names.
   214	
   215	    Identity ACROSS the cell (one path, one digest) is a cross-record property
   216	    and lives with the caller; this is the per-record half: the right step, and a
   217	    well-formed digest if the driver recorded one.
   218	    """
   219	    reasons = []
   220	    try:
   221	        step = parse_ckpt_step(record.get("ckpt_path"))
   222	    except ValueError as exc:
   223	        return [str(exc)]
   224	    if step != STEP:
   225	        reasons.append(f"ckpt_path {record.get('ckpt_path')!r} is at step {step}; this row "
   226	                       f"publishes the step-{STEP} checkpoint only (a substring test would "
   227	                       f"have accepted it: {STEP} is a prefix of {step} for step=400000)")
   228	    sha = record.get(CKPT_SHA_FIELD)
   229	    if sha is not None and not (isinstance(sha, str) and CKPT_SHA_RE.match(sha)):
   230	        reasons.append(f"{CKPT_SHA_FIELD} {sha!r} is not a 64-hex digest")
   231	    return reasons
   232	
   233	EVAL_NAME_TEMPLATE = "exp21_BFC_S{step}_K{k}_s{seed}"
   234	EVAL_NAME_RE = re.compile(r"^exp21_BFC_S(?P<step>\d+)_K(?P<k>\d+)_s(?P<seed>\d+)$")
   235	
   236	Cell = namedtuple("Cell", "step k seed")
   237	
   238	
   239	def eval_name(k, seed):
   240	    """The ``--eval-name`` of one registered cell.
   241	
   242	    ``build_output_paths`` does not add K or the seed itself (eval_FLAC.py:373),
   243	    so the eval name is the ONLY thing separating the ten registered cells'
   244	    artifacts from each other -- and from the invariance grid's, which appends
   245	    ``_rot<deg>``."""
   246	    return EVAL_NAME_TEMPLATE.format(step=STEP, k=int(k), seed=int(seed))
   247	
   248	
   249	def parse_eval_name(name):
   250	    """``Cell`` for a registered table cell; ``ValueError`` for anything else.
   251	
   252	    Deliberately strict about the three registered facts. The §5 invariance grid
   253	    writes ``..._s42_rot45`` cells of the SAME checkpoint and an optional
   254	    band-context screen writes ``S37500``: both are legitimate artifacts of this
   255	    experiment and neither is a model row, so they must fail to parse rather than
   256	    be silently averaged into one.
   257	    """
   258	    match = EVAL_NAME_RE.match(str(name or ""))
   259	    if match is None:
   260	        raise ValueError(
   261	            f"eval_name {name!r} is not a registered exp_21 table cell "
   262	            f"(expected {EVAL_NAME_TEMPLATE.format(step=STEP, k='<K>', seed='<seed>')})"
   263	        )
   264	    step, k, seed = (int(match.group("step")), int(match.group("k")),
   265	                     int(match.group("seed")))
   266	    if step != STEP:
   267	        raise ValueError(f"eval_name {name!r} is at step {step}; this row publishes "
   268	                         f"the step-{STEP} checkpoint only")
   269	    if k not in KS:
   270	        raise ValueError(f"eval_name {name!r} has K={k}; the registered context sizes "
   271	                         f"are {list(KS)}")
   272	    if seed not in SEEDS:
   273	        raise ValueError(f"eval_name {name!r} has seed {seed}, which is not one of the "
   274	                         f"registered eval seeds {list(SEEDS)}")
   275	    return Cell(step, k, seed)
   276	
   277	
   278	def same_dataset_config(recorded, expected_relative):
   279	    """Is ``recorded`` the registered split for this K?
   280	
   281	    An identity, not a spelling: operators paste absolute paths, and the record
   282	    stores the path exactly as given. An absolute path INTO a checkout ends with
   283	    the registered relative path, so it is the same file. The two AR unseen
   284	    configs cannot be confused this way -- ``..._unseeneval_1.json`` does not end
   285	    with ``..._unseeneval.json`` and vice versa -- so a K=1 split can never be
   286	    accepted for a K=8 row.
   287	    """
   288	    if not isinstance(recorded, str):
   289	        return False
   290	    got = os.path.normpath(recorded).replace(os.sep, "/")
   291	    want = os.path.normpath(expected_relative).replace(os.sep, "/")
   292	    return got == want or got.endswith("/" + want)
   293	
   294	
   295	def validate_metrics_record(record, cell):
   296	    """``[reason, ...]`` naming every way this record is not ``cell``'s registered
   297	    measurement. Empty means it is.
   298	
   299	    One reason per deviation, each naming the FIELD and the value found: a row
   300	    that renders BLOCKED is only useful if it says which knob to fix.
   301	    """
   302	    if not isinstance(record, dict):
   303	        return ["the metrics record is missing or is not an object"]
   304	    reasons = []
   305	
   306	    def eq(field, want):
   307	        got = record.get(field, "<absent>")
   308	        if got != want:
   309	            reasons.append(f"{field} is {got!r}, the registered protocol is {want!r}")
   310	
   311	    eq("cond_method", COND_METHOD)
   312	    eq("frame_avg_angles", FRAME_AVG_ANGLES)
   313	    eq("frame_avg_fwd_cap", FRAME_AVG_FWD_CAP)
   314	    eq("orbit_execution", ORBIT_EXECUTION)
   315	    eq("cond_autocast", COND_AUTOCAST)
   316	    eq("batch_size", BATCH_SIZE)
   317	    eq("n_samples", EXPECTED_COUNT)
   318	    eq("cfg_scale", CFG_SCALE)
   319	    eq("steps", STEPS)
   320	    eq("weights_source", WEIGHTS_SOURCE)
   321	
   322	    # The rotation protocol needs both halves: in RANDOM mode eval_FLAC nulls
   323	    # rotate_deg and appends rotate_mode, so checking the angle alone would let a
   324	    # randomly-rotated cell through on `None != 45.0`.
   325	    if record.get("rotate_deg") != ROTATE_DEG:
   326	        reasons.append(f"rotate_deg is {record.get('rotate_deg', '<absent>')!r}, the "
   327	                       f"registered cell is the UNROTATED one ({ROTATE_DEG})")
   328	    if "rotate_mode" in record:
   329	        reasons.append(f"rotate_mode {record['rotate_mode']!r} is recorded: the "
   330	                       "registered cell runs in fixed mode, whose record carries no "
   331	                       "rotation provenance block")
   332	
   333	    want_ds = DATASET_CONFIG[int(cell.k)]
   334	    if not same_dataset_config(record.get("dataset_config"), want_ds):
   335	        reasons.append(f"dataset_config is {record.get('dataset_config', '<absent>')!r}, "
   336	                       f"the registered K={cell.k} split is {want_ds!r}")
   337	
   338	    reasons += ckpt_reasons(record)
   339	    reasons += per_scene_reasons(record)
   340	
   341	    if record.get("seed") != cell.seed:
   342	        reasons.append(f"seed is {record.get('seed', '<absent>')!r} but the eval name says "
   343	                       f"{cell.seed}: the file was renamed, or the run was seeded "
   344	                       "differently than it claims")
   345	
   346	    want_name = eval_name(cell.k, cell.seed)
   347	    if record.get("eval_name") != want_name:
   348	        reasons.append(f"eval_name is {record.get('eval_name', '<absent>')!r}, not "
   349	                       f"{want_name!r}")
   350	
   351	    sha = record.get("source_sha")
   352	    if not (isinstance(sha, str) and re.fullmatch(r"[0-9a-f]{40}", sha)):
   353	        reasons.append(f"source_sha {sha!r} is not a 40-hex evaluator pin (eval_FLAC "
   354	                       "records 'unknown' when git is unavailable; a row whose "
   355	                       "provenance is unknown is not a measured one)")
   356	    return reasons
   520	    if not rows:
   521	        return []
   522	    problems = []
   523	    ks = sorted({r["K"] for r in rows})
   524	    if ks != [1, 8]:
   525	        problems.append(f"expected K=1 and K=8 rows, found {ks}")
   526	    for r in rows:
   527	        line = r.get("line", "")
   528	        if "BLOCKED" in line:
   529	            problems.append(f"K={r['K']} is BLOCKED")
   530	        elif "*pending" in line:
   531	            problems.append(f"K={r['K']} is pending ({r.get('n')}/{MIN_SEEDS} seeds)")
   532	    # ...and if either K is unpublishable, NEITHER publishes.
   533	    if problems:
   534	        problems.append("both K rows publish together or neither does")
   535	    return problems
   536	
   537	
   538	# --- the exp_21 BFC contract (plan §3g) --------------------------------------
   539	# ADDITIVE and exp_21-only: no existing row reaches any of this. The shape is
   540	# exp_15's - a per-experiment validator module imported by path, a thin cell
   541	# gate here, and a round gate that makes the two K rows one transaction - because
   542	# the eval driver that will produce these cells has to agree with the table about
   543	# what a registered cell is, and one imported file is how the other campaigns
   544	# guarantee that.
   545	EXP21_VALIDATOR = os.path.join(
   546	    os.path.dirname(os.path.abspath(__file__)), "exp_21_bf_fa_cartesian_claude",
   547	    "exp21_validate_cell.py")
   548	
   549	
   550	def _load_exp21_validator(path=None):
   551	    """exp_21's own validator, imported by path (same shape as exp_11/14/15)."""
   552	    import importlib.util
   553	    target = os.path.abspath(path or EXP21_VALIDATOR)
   554	    spec = importlib.util.spec_from_file_location("exp21_validate_cell", target)
   555	    if spec is None or spec.loader is None:
   556	        raise ImportError(f"cannot load the exp_21 validator from {target}")
   557	    module = importlib.util.module_from_spec(spec)
   558	    spec.loader.exec_module(module)
   559	    return module
   560	
   561	
   562	def _exp21_metric_reasons(record):
   563	    """The payload this TABLE will print: present, numeric, finite.
   564	
   565	    Checked HERE, beside KEYS, and BEFORE ``agg_files`` runs: a cell can satisfy
   566	    every provenance rule and still carry a NaN, and ``agg_files`` answers that
   567	    with a raise, which would abort the whole regeneration instead of rendering
   568	    one row BLOCKED (mirrors ``_exp14_cell_reasons``' tail).
   569	    """
   570	    metrics = record.get("metrics") if isinstance(record, dict) else None
   571	    if not isinstance(metrics, dict):
   572	        return ["metrics block is missing or is not an object"]
   573	    reasons = []
   574	    for _label, key in KEYS:
   575	        if key not in metrics:
   576	            reasons.append(f"metrics does not report {key}, which this table prints")
   577	        elif not _finite_number(metrics[key]):
   578	            reasons.append(f"metrics[{key!r}] = {metrics[key]!r} is not a finite number")
   579	    return reasons
   580	
   581	
   582	def validate_exp21_cell(files, repo_root=None, expected_k=None):
   583	    """``(ok, problems)`` for one exp_21 row: five registered seeds, one pin.
   584	
   585	    ``expected_k`` comes from the ROW CONTRACT and binding it is the point (the
   586	    exp_14 round-3 review B2 lesson): a homogeneous five-seed K=1 payload
   587	    renamed to match the K=8 glob would otherwise validate under the K=8 label,
   588	    and the table would publish one context size's numbers beside another's name.
   589	
   590	    Empty is not a failure - the generator already renders an empty cell as
   591	    pending, and both BFC rows are registered in advance.
   592	    """
   593	    if not files:
   594	        return True, []
   595	    try:
   596	        V = _load_exp21_validator()
   597	    except Exception as exc:                       # the gate must not fail open
   598	        return False, [f"cannot load the exp_21 validator ({exc})"]
   599	    records, problems = {}, []
   600	    for path in sorted(set(files)):
   601	        try:
   602	            with open(path) as fh:
   603	                records[path] = json.load(fh)
   604	        except (ValueError, OSError) as exc:
   605	            problems.append(f"{os.path.basename(path)}: unreadable ({exc})")
   606	    if problems:
   607	        return False, problems
   608	    seeds, ks, pins = [], set(), set()
   609	    ckpts, shas, without_sha = set(), set(), []
   610	    for path, record in sorted(records.items()):
   611	        base = os.path.basename(path)
   612	        try:
   613	            cell = V.parse_eval_name(str((record or {}).get("eval_name") or ""))
   614	        except ValueError as exc:
   615	            problems.append(f"{base}: {exc}")
   616	            continue
   617	        seeds.append(int(cell.seed))
   618	        ks.add(int(cell.k))
   619	        pins.add(str((record or {}).get("source_sha")))
   620	        ckpts.add(os.path.normpath(str((record or {}).get("ckpt_path"))))
   621	        sha = (record or {}).get(V.CKPT_SHA_FIELD)
   622	        if sha is None:
   623	            without_sha.append(base)
   624	        else:
   625	            shas.add(str(sha))
   626	        problems += [f"{base}: {r}" for r in V.validate_metrics_record(record, cell)]
   627	        problems += [f"{base}: {r}" for r in _exp21_metric_reasons(record)]
   628	    # CHECKPOINT IDENTITY (r4 review BLOCKING 3). Every per-record rule can pass
   629	    # while the five seeds sample five DIFFERENT 40k checkpoints -- two runs of
   630	    # the same arm, or a re-run after a crash -- which is not one measurement
   631	    # with five samplings, it is five measurements wearing one label.
   632	    if len(ckpts) > 1:
   633	        problems.append(f"the cell spans MORE THAN ONE checkpoint {sorted(ckpts)}: the five "
   634	                        "seeds of a row are five samplings of ONE checkpoint")
   635	    # ...and the digest, once the eval driver records one. Path identity is the
   636	    # floor: a path proves which file was NAMED, a digest proves which bytes were
   637	    # LOADED. Partial presence is refused outright -- the record without a digest
   638	    # is exactly where a substituted checkpoint would hide.
   639	    if shas and without_sha:
   640	        problems.append(f"{len(without_sha)} of {len(records)} records carry no "
   730	    return str(label).split(" ", 1)[0]
