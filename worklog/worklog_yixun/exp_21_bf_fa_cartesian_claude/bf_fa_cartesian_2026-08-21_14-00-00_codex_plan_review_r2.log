    35	            f"training.yaw_aug has unknown key(s) {sorted(unknown)}; "
    36	            f"allowed keys are {list(YAW_AUG_KEYS)}"
    37	        )
    38	
    39	    enabled = block.get("enabled", None)
    40	    if not isinstance(enabled, bool):
    41	        raise ValueError(
    42	            "training.yaw_aug.enabled must be a literal boolean (true/false), got "
    43	            f"{enabled!r}"
