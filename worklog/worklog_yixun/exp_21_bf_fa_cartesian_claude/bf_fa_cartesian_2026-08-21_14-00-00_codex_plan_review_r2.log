   227	def validate_exp11_cell(files, repo_root=None, validator_path=None, contract="table"):
   228	    """Gate an exp_11 table cell (round-4 review B5).
   229	
   230	    The validator used to be advisory: this script globbed raw JSONs and averaged
   231	    whatever it found, so an unprovable row could become a published number. Now
   232	    a cell must pass the TABLE contract — five conf rows, one checkpoint/config/
   233	    evaluator identity, the batched orbit, EMA, the full split — or the row is
   234	    rendered blocked instead of numeric. An EMPTY cell is not a failure: the
   235	    generator already renders those as pending.
   236	    """
   237	    if not files:
   238	        return True, []
   239	    try:
   240	        # NOTE: ``repo_root`` redirects where EVIDENCE is resolved; it does not
   241	        # decide which validator runs. main() passes an explicit validator_path
   242	        # for its root; everyone else gets this checkout's validator.
   243	        V = _load_validator(validator_path)
   244	        if repo_root:                              # tests resolve the canonical arm
   245	            V.REPO = repo_root                     # roots inside their fixture tree
   246	            V.OUTPUT_ROOT_BASE = repo_root         # (outputs live under the main tree
   247	                                                   #  in production; unchanged there)
   248	    except Exception as exc:                       # the gate must not fail open
   249	        return False, [f"cannot load the exp_11 validator ({exc})"]
   250	    try:
   251	        first, probs = V.validate_row(files[0])
   252	        if not first:
   253	            return False, probs
   254	        # The contract is a property of the ROW, not a constant: q9 rows live in
   255	        # their own registered cell and are inadmissible under `table`, so a
   256	        # hard-coded "table" renders every populated q9 row BLOCKED.
   257	        rows, problems = V.validate_cell(files, arm=first["arm"], step=first["step"],
   258	                                         k=first["K"], contract=contract,
   259	                                         verify_hashes=True)   # item 3: never trust the sidecar
