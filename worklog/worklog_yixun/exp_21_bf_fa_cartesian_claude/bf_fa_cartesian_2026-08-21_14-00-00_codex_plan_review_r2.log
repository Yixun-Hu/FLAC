   208	def _load_validator(validator_path=None):
   209	    """Import the validator module from an explicit path.
   210	
   211	    It puts its own repo root on sys.path to reach ``src.*``; make sure that
   212	    root is importable from here too, because a generator run from a pinned
   213	    worktree (or any foreign cwd) has no ``src`` on its path at all — the
   214	    failure mode is an unloadable validator, which fails the gate CLOSED and
   215	    would render every real row BLOCKED for the wrong reason."""
   216	    import importlib.util
   217	    path = os.path.abspath(validator_path or EXP11_VALIDATOR)
   218	    root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(path))))
   219	    if root not in sys.path:
   220	        sys.path.insert(0, root)
   221	    spec = importlib.util.spec_from_file_location("exp11_validate_rows", path)
   222	    mod = importlib.util.module_from_spec(spec)
   223	    spec.loader.exec_module(mod)
   224	    return mod
