     9	def _parse_yaw_aug_config(training_config):
    10	    """Validate ``training.yaw_aug`` and return the wrapper kwargs it implies.
    11	
    12	    exp_15's training-side random-yaw augmentation (plan §§3.1, 6.2). Every
    13	    failure mode here is fail-closed: a malformed block must stop the launch, not
    14	    quietly train the wrong arm — the whole experiment is one treatment against
    15	    one historical control, so a silently-off (or silently-on) augmentation is
    16	    unrecoverable after the fact.
    17	
    18	    Returns ``{}`` unless the block is present *and* enabled, so the disabled
    19	    path's construction call stays literally the pre-change call (plan §3.3-4:
    20	    the control was trained through that call).
    21	    """
    22	    if "yaw_aug" not in training_config:
    23	        return {}
    24	
    25	    block = training_config["yaw_aug"]
    26	    if not isinstance(block, dict):
    27	        raise ValueError(
    28	            f"training.yaw_aug must be an object with keys {list(YAW_AUG_KEYS)}, "
    29	            f"got {type(block).__name__}"
    30	        )
    31	
    32	    unknown = [k for k in block if k not in YAW_AUG_KEYS]
    33	    if unknown:
