     8	def get_custom_metadata(info, audio): 
     9	    md = {}
    10	    full_audio_path = info["path"]
    11	    rel_path = info["relpath"]
    12	    common_suffix = os.path.commonpath([full_audio_path[::-1], rel_path[::-1]])[::-1]
    13	    dataset_folder = full_audio_path[: -len(common_suffix)]
    14	    metadata_path = os.path.join(dataset_folder, 'metadata')
    15	
    16	    # Get Config Info
    17	    modalities = info['modalities'] 
    18	    acoustic_context_config = modalities.get('acoustic_context', None)
    19	    depth_config = modalities.get('depth', None)
    20	    pose_config = modalities.get('poses', None)
    21	
    22	    # Get Instance Information
    23	    scene_name = rel_path.split("/")[-3]
    24	    scene_id = rel_path.split("/")[-2]
    25	    filename = rel_path.split("/")[-1].split(".")[0]
    26	    receiver_idx, source_idx = int(filename.split("_")[1][1:]), int(filename.split("_")[0][1:])
    27	    md['scene'] = scene_name
    28	
    29	    # Load Positions
    30	    if pose_config.get('load', False):
    31	        source_pos, listener_pos = get_receiver_source_location(rel_path, metadata_path)
    32	        proj_source_pos = get_3d_point_camera_coord(listener_pos, source_pos)
    33	        proj_source_pos = torch.Tensor(proj_source_pos).float()
    34	        proj_listener_pos = torch.Tensor([0., 0., 0.])
    35	        source_listener_pos = torch.cat([proj_source_pos.unsqueeze(0), proj_listener_pos.unsqueeze(0)], dim=0) # [2, 3]
    36	        md['source'] = proj_source_pos 
    37	        md['source_vit'] = proj_source_pos.unsqueeze(0) # [1, 3]
    38	
    39	    # Load Acoustic Context
    40	    if acoustic_context_config.get('load', False):
    41	        max_len_cond = acoustic_context_config.get('max_len', 9600)
    42	        all_ref_irs, all_ref_src_pos = get_ir_and_location_for_other_sources(full_audio_path, num_ref_sources=acoustic_context_config.get('max_context', 8), metadata_path=metadata_path, max_len=max_len_cond)
    43	        md['context_poses'] = all_ref_src_pos # [N, 3]  
    44	        md['context_poses_vit'] = all_ref_src_pos
    45	        md['context_audio'] = all_ref_irs # [N, max_len_cond]
    46	
    47	    # Load Depth
    48	    if depth_config.get('load', False):
    49	        pano_depth_path = dataset_folder + 'depth_map'
    50	        pano_depth = np.load(os.path.join(pano_depth_path, scene_name, scene_id, f"{receiver_idx}.npy"))
    51	        depth_coord = convert_equirect_to_camera_coord(torch.from_numpy(pano_depth), 256, 512) # [H, W, 3]
    52	        md['depth'] = depth_coord.permute(2, 0, 1) # [3, H, W]
    53	    
    54	    return md
