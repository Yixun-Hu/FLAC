   182	def is_exp14_row(patterns):
   183	    """Does this row's evidence come from the exp_14 yaw campaign's Z block?"""
   184	    return any("exp14_" in p for p in patterns)
   185	
   186	
   187	def is_exp11_row(patterns):
   188	    """Does this row's evidence come from the exp_11 orbit sweep?
   189	
   190	    exp_14's cells live under ``outputs_FLAC/exp11_<ARM>/`` — the ARM's run
   191	    directory, which exp_11 created — so the substring alone would claim them and
   192	    send them to a validator that only understands exp_11 eval names. Excluding
   193	    them here changes nothing for any exp_11 row (none names an exp14 artifact)
   194	    and keeps exp_11's gate exactly as it was.
   195	    """
   196	    return any("exp11_" in p for p in patterns) and not is_exp14_row(patterns)
   197	
   198	
   199	def is_batched_orbit_row(patterns):
   200	    """Was this row produced by the BATCHED orbit implementation?
   201	
   202	    True for exp_11 and for exp_14, which evaluates through the same code path.
   203	    The legacy-loop label migration must not claim either of them.
   204	    """
   205	    return is_exp11_row(patterns) or is_exp14_row(patterns)
