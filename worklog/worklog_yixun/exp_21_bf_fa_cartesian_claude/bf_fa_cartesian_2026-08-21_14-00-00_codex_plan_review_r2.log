   165	def repo_paths(repo_root=None):
   166	    """Resolve every path this generator touches against ONE explicit root.
   167	
   168	    Measurement now runs from pinned worktrees, so the cwd is routinely NOT the
   169	    main checkout. Globbing evidence relative to an ambient cwd would silently
   170	    find nothing (rendering published rows as *pending*) or, worse, find a
   171	    worktree's stale copy. Everything — evidence, validator, output — hangs off
   172	    this one root, which defaults to the main tree this file lives in."""
   173	    root = os.path.realpath(repo_root or REPO)
   174	    return {
   175	        "root": root,
   176	        "out": os.path.join(root, "worklog", "worklog_yixun", "model_comparison.md"),
   177	        "validator": os.path.join(root, "worklog", "worklog_yixun",
   178	                                  "exp_11_fa_orbit_claude", "exp11_validate_rows.py"),
   179	    }
   180	
