     1	#!/usr/bin/env bash
     2	# ============================================================================
     3	# bf_scratch_launch.sh - exp_07: B-F FROM-SCRATCH training, 2-GPU DDP + SyncBN.
     4	#
     5	# Yixun mandate (2026-07-16): 2x A6000 DDP with SyncBatchNorm so the effective
     6	# BN batch = 64 = paper (deliberate deviation from the release CODE, which got
     7	# BN-64 via micro-64 on one H100 without SyncBN - we match the paper's BN
     8	# statistics, not the release's code path). Global eff batch 64 fixed; the
     9	# micro/accum rung comes from the M1 probe: MB x 2 GPUs x ACC = 64.
    10	# LAUNCH-GATED: only run after Yixun's explicit go on the probed rung.
    11	#
    12	# Otherwise mirrors the B-V phase-1 manifest exactly: FLAC_AR_BF.json (byte-copy
    13	# of release config + cond_method fa_invariant + frame_avg_angles [0,90,180,270];
    14	# init-identity vs B-V sha256-asserted), seed 42, --max-steps 67500, EMA on
    15	# (config), ckpt every 2500, bf16-mixed (ini default, no flag), workers 6/rank,
    16	# HF_HUB_OFFLINE=1. Strategy passed EXPLICITLY (defaults.ini strategy="auto" is
    17	# forwarded verbatim by train.py:159-170; the num_gpus>1 fallback never fires).
    18	#
    19	# wandb: default ON per Yixun (LOGGER=wandb) - project FLAC_exp07_BF, run
    20	# exp07_BF, account yh4742@princeton.edu; key self-extracted past ~/.bashrc's
    21	# interactive guard; fail-closed identity gate. Ckpts nest under
    22	# outputs_FLAC/exp07_BF/<project>/<run>/checkpoints/ (train.py:129).
    23	# ============================================================================
    24	set -uo pipefail
    25	cd "$(git -C "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" rev-parse --show-toplevel)" || exit 3
    26	
    27	EXPDIR="worklog/worklog_yixun/exp_07_fa_scratch_claude"
    28	LOGGER="${LOGGER:-wandb}"
    29	MB="${MB:-32}"    # micro-batch per GPU (M1 winning rung)
    30	ACC="${ACC:-1}"   # accumulation      (M1 winning rung)
    31	TS="$(date '+%Y-%m-%d_%H-%M-%S')"
    32	LOG="${EXPDIR}/fa_scratch_${TS}_BF_train.log"
    33	
    34	# invariant (review findings): accumulation never feeds BN statistics, so the
    35	# BN=64 mandate leaves exactly ONE legal rung - pin it literally (string
    36	# equality; arithmetic like MB*2*ACC==64 is bypassable via bash int overflow):
    37	[ "$MB" = "32" ] && [ "$ACC" = "1" ] || { echo "only the BN-compliant rung MB=32 ACC=1 is allowed (got MB='${MB}' ACC='${ACC}') - abort"; exit 2; }
    38	
    39	exec > >(tee -a "$LOG") 2>&1
    40	echo "=== B-F FROM-SCRATCH DDP+SyncBN - ${TS} - $(git rev-parse --short HEAD 2>/dev/null) - ${MB}x2x${ACC} eff64 seed42 -> 67500 - logger=${LOGGER} ==="
    41	
    42	# --- per-GPU FREE-VRAM gate (Yixun co-tenancy policy + co-tenant GO 2026-07-18;
    43	# mirrors the reviewed m1_ddp_fit_probe.sh gate). Threshold: M1-measured
    44	# checkpointed rank 15,712 MiB + DDP/SyncBN allowance ~1,000 + safety ~5,200
    45	# = 21,900 MiB per GPU (override via MIN_FREE_MB). Fail-CLOSED on query errors.
    46	MIN_FREE_MB="${MIN_FREE_MB:-21900}"
    47	for G in 0 1; do
    48	  FREE="$(nvidia-smi -i "$G" --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | tr -dc '0-9')"
    49	  rc_q=$?
    50	  [ "$rc_q" -eq 0 ] && [ -n "$FREE" ] || { echo "nvidia-smi free-mem query failed on GPU ${G} (rc=${rc_q}) - refusing to launch blind"; exit 2; }
    51	  [ "$FREE" -ge "$MIN_FREE_MB" ] || { echo "GPU ${G} free ${FREE} MiB < required ${MIN_FREE_MB} MiB - refusing to launch"; exit 2; }
    52	done
    53	echo "--- co-tenancy disclosure: compute apps at launch ---"
    54	nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name,used_memory --format=csv,noheader 2>/dev/null || true
    55	nvidia-smi --query-gpu=index,memory.used,memory.free --format=csv,noheader 2>/dev/null || true
    56	
    57	# --- fail-closed wandb identity gate (only when wandb is requested) ---
    58	if [ "$LOGGER" = "wandb" ]; then
    59	  # ~/.bashrc's interactive guard blocks non-interactive sourcing, so
    60	  # extract the newest exported key directly (verified 2026-07-16 ->
    61	  # yh4742@princeton.edu; the gate below re-verifies at every launch)
    62	  eval "$(grep -E '^[[:space:]]*export[[:space:]]+WANDB_API_KEY=' ~/.bashrc 2>/dev/null | tail -1)"
    63	  python - <<'PY'
    64	import sys
    65	try:
    66	    import wandb
    67	    email = wandb.Api().viewer.email
    68	except Exception as e:
    69	    print("wandb identity check FAILED:", e); sys.exit(1)
    70	print("wandb identity:", email)
    71	sys.exit(0 if email == "yh4742@princeton.edu" else 2)
    72	PY
    73	  gate=$?
    74	  if [ "$gate" -ne 0 ]; then echo "wandb identity != yh4742@princeton.edu (exit ${gate}) - set the right WANDB_API_KEY or use LOGGER=none - abort"; exit 2; fi
    75	fi
    76	
    77	# --- pre-launch gate: DINOv3 pin + arm init-identity (fail-closed, as B-V) ---
    78	# offline so the gate's own model construction cannot contact the Hub and
    79	# mutate the cache it just validated
    80	HF_HUB_OFFLINE=1 python "${EXPDIR}/assert_arm_configs.py" || { echo "GATE FAILED - abort"; exit 1; }
    81	
    82	echo "--- env manifest ---"
    83	python -c "import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda)"
    84	nvidia-smi --query-gpu=index,memory.total,memory.used --format=csv,noheader
    85	pip freeze 2>/dev/null | sha256sum | awk '{print "pip-freeze sha256:", $1}'
    86	echo "sync_batchnorm: true (fail-closed in train.py below num_gpus 2) | strategy: ddp_find_unused_parameters_true | rung: ${MB}x2x${ACC}"
    87	
    88	HF_HUB_OFFLINE=1 CUDA_VISIBLE_DEVICES=0,1 python train.py \
    89	  --model-config "${EXPDIR}/FLAC_AR_BF.json" \
    90	  --dataset-config src/configs/dataset_configs/AR/train/acousticroom_train.json \
    91	  --pretransform-ckpt-path weights/FLAC/VAE.safetensors \
    92	  --max-steps 67500 --batch-size "$MB" --accum-batches "$ACC" --num-workers 6 --seed 42 \
    93	  --num-gpus 2 --strategy ddp_find_unused_parameters_true --sync-batchnorm true \
    94	  --logger "$LOGGER" --checkpoint-every 2500 \
    95	  --name FLAC_exp07_BF --experiment-name exp07_BF \
    96	  --save-dir outputs_FLAC/exp07_BF
    97	rc=$?
    98	echo "=== B-F DDP+SyncBN exited rc=${rc} at $(date '+%Y-%m-%d %H:%M:%S') ==="
    99	exit $rc
