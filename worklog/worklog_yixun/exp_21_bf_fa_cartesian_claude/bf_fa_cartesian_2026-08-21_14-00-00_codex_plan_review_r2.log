   168	        audios = self.stft(audios)  # [B*N, C, F, T]
   169	
   170	        audios = torch.sqrt(
   171	            torch.clamp((audios.real**2) + (audios.imag**2), min=1e-8)
   172	        )
   173	
   174	        encoded = self.net(audios) # [batch, 512]
   175	        encoded = encoded.view(B, N, -1)
   176	        out = self.proj_out(encoded)  # [B, N, D]
   177	
   178	        return [out, torch.ones(encoded.shape[0], 1).to(device)]
   179	    
   180	def _make_vit_ckpt_forward(layer: nn.Module, orig_forward):
   181	    """Instance-level forward wrapper applying non-reentrant activation
   182	    checkpointing to one ViT encoder layer. Checkpoints ONLY when the layer is in
   183	    training mode AND grad is enabled; eval/no_grad calls pass through unchanged
   184	    (zero overhead). ``torch.utils.checkpoint.checkpoint`` is resolved by
   185	    attribute at call time so its invocation is observable (and shimmable) in
   186	    tests. ``use_reentrant=False`` is REQUIRED for DDP find_unused_parameters
   187	    compatibility; the non-reentrant path also supports the kwargs DINOv3 layers
   188	    receive (attention_mask, position_embeddings)."""
   189	    @functools.wraps(orig_forward)
   190	    def ckpt_forward(*args, **kwargs):
   191	        if layer.training and torch.is_grad_enabled():
   192	            return torch.utils.checkpoint.checkpoint(
   193	                orig_forward, *args, use_reentrant=False, **kwargs
   194	            )
   195	        return orig_forward(*args, **kwargs)
   196	    return ckpt_forward
   197	
   198	
   199	def _checkpoint_vit_layers(vit: nn.Module) -> int:
   200	    """Wrap every encoder layer of ``vit`` (its ``.layer`` nn.ModuleList) with
   201	    explicit non-reentrant activation checkpointing; returns the number of
   202	    checkpointed layers.
   203	
   204	    Codex review of the pinned transformers==4.57.0 rejected relying on HF's
   205	    ``gradient_checkpointing_enable()`` here: DINOv3 delegates checkpointing to
   206	    the ``GradientCheckpointingLayer.__call__`` base-class hook
   207	    (transformers/modeling_layers.py), whose enable-time ``functools.partial``
   208	    binds ``torch.utils.checkpoint.checkpoint`` opaquely and gates only on
   209	    ``.training`` — invisible to instrumentation and easy to mistake for a no-op
   210	    (``modeling_dinov3_vit.py`` itself never references
   211	    ``_gradient_checkpointing_func``). Checkpointing each layer's forward at OUR
   212	    call site keeps the semantics pinned, additionally gates on
   213	    ``torch.is_grad_enabled()``, and is directly testable.
   214	
   215	    Instance-level forward replacement only: registers no modules/params/buffers,
   216	    so the state_dict stays byte-identical. Idempotent across the two
   217	    ViTCoordinates conditioners that share one backbone (already-wrapped layers
   218	    are skipped — never double-checkpointed). Fail-closed: a backbone without a
   219	    non-empty ``nn.ModuleList`` at ``.layer`` (e.g. the in-repo
   220	    SimpleViT/CylindricalViT) raises ValueError rather than silently ignoring
   221	    the request."""
   222	    layers = getattr(vit, "layer", None)
   223	    if not isinstance(layers, nn.ModuleList) or len(layers) == 0:
   224	        raise ValueError(
   225	            "gradient_checkpointing=True was requested for GeometryConditioner, "
   226	            f"but the wrapped ViT backbone ({type(vit).__name__}) has no non-empty "
   227	            "nn.ModuleList at .layer to checkpoint (expected an HF DINOv3-style "
   228	            "encoder). Remove the flag or use a compatible backbone."
   229	        )
   230	    for layer in layers:
   231	        if getattr(layer, "_flac_ckpt_wrapped", False):
   232	            continue
   233	        layer.forward = _make_vit_ckpt_forward(layer, layer.forward)
   234	        layer._flac_ckpt_wrapped = True
   235	    return len(layers)
