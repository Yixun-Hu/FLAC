   111	
   112	
   113	def same_dataset_config(recorded, expected_relative):
   114	    """Is ``recorded`` the registered split for this K?
   115	
   116	    An identity, not a spelling: operators paste absolute paths, and the record
   117	    stores the path exactly as given. An absolute path INTO a checkout ends with
   118	    the registered relative path, so it is the same file. The two AR unseen
   119	    configs cannot be confused this way -- ``..._unseeneval_1.json`` does not end
   120	    with ``..._unseeneval.json`` and vice versa -- so a K=1 split can never be
   121	    accepted for a K=8 row.
   122	    """
   123	    if not isinstance(recorded, str):
   124	        return False
   125	    got = os.path.normpath(recorded).replace(os.sep, "/")
   126	    want = os.path.normpath(expected_relative).replace(os.sep, "/")
   127	    return got == want or got.endswith("/" + want)
   128	
   129	
   130	def validate_metrics_record(record, cell):
   131	    """``[reason, ...]`` naming every way this record is not ``cell``'s registered
   132	    measurement. Empty means it is.
   133	
   134	    One reason per deviation, each naming the FIELD and the value found: a row
   135	    that renders BLOCKED is only useful if it says which knob to fix.
   136	    """
   137	    if not isinstance(record, dict):
   138	        return ["the metrics record is missing or is not an object"]
   139	    reasons = []
   140	
   141	    def eq(field, want):
   142	        got = record.get(field, "<absent>")
   143	        if got != want:
   144	            reasons.append(f"{field} is {got!r}, the registered protocol is {want!r}")
   145	
   146	    eq("cond_method", COND_METHOD)
   147	    eq("frame_avg_angles", FRAME_AVG_ANGLES)
   148	    eq("frame_avg_fwd_cap", FRAME_AVG_FWD_CAP)
   149	    eq("orbit_execution", ORBIT_EXECUTION)
   150	    eq("cond_autocast", COND_AUTOCAST)
   151	    eq("batch_size", BATCH_SIZE)
   152	    eq("n_samples", EXPECTED_COUNT)
   153	    eq("cfg_scale", CFG_SCALE)
   154	    eq("steps", STEPS)
   155	    eq("weights_source", WEIGHTS_SOURCE)
   156	
   157	    # The rotation protocol needs both halves: in RANDOM mode eval_FLAC nulls
   158	    # rotate_deg and appends rotate_mode, so checking the angle alone would let a
   159	    # randomly-rotated cell through on `None != 45.0`.
   160	    if record.get("rotate_deg") != ROTATE_DEG:
   161	        reasons.append(f"rotate_deg is {record.get('rotate_deg', '<absent>')!r}, the "
   162	                       f"registered cell is the UNROTATED one ({ROTATE_DEG})")
   163	    if "rotate_mode" in record:
   164	        reasons.append(f"rotate_mode {record['rotate_mode']!r} is recorded: the "
   165	                       "registered cell runs in fixed mode, whose record carries no "
   166	                       "rotation provenance block")
   167	
   168	    want_ds = DATASET_CONFIG[int(cell.k)]
   169	    if not same_dataset_config(record.get("dataset_config"), want_ds):
   170	        reasons.append(f"dataset_config is {record.get('dataset_config', '<absent>')!r}, "
   171	                       f"the registered K={cell.k} split is {want_ds!r}")
   172	
   173	    ckpt = record.get("ckpt_path")
   174	    if not isinstance(ckpt, str) or CKPT_STEP_TOKEN not in ckpt:
   175	        reasons.append(f"ckpt_path {ckpt!r} is not the {CKPT_STEP_TOKEN} checkpoint this "
   176	                       "row publishes")
   177	
   178	    if record.get("seed") != cell.seed:
   179	        reasons.append(f"seed is {record.get('seed', '<absent>')!r} but the eval name says "
   180	                       f"{cell.seed}: the file was renamed, or the run was seeded "
   181	                       "differently than it claims")
   182	
   183	    want_name = eval_name(cell.k, cell.seed)
   184	    if record.get("eval_name") != want_name:
   185	        reasons.append(f"eval_name is {record.get('eval_name', '<absent>')!r}, not "
   186	                       f"{want_name!r}")
   187	
   188	    sha = record.get("source_sha")
