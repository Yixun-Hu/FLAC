    74	def eval_name(k, seed):
    75	    """The ``--eval-name`` of one registered cell.
    76	
    77	    ``build_output_paths`` does not add K or the seed itself (eval_FLAC.py:373),
    78	    so the eval name is the ONLY thing separating the ten registered cells'
    79	    artifacts from each other -- and from the invariance grid's, which appends
    80	    ``_rot<deg>``."""
