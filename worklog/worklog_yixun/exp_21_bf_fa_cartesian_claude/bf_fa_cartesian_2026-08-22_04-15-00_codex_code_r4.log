   941	def agg_files(files):
   942	    """Aggregate one cell's per-seed JSONs. RAISES on a payload it cannot print.
   943	
   944	    Round-3 review B5: a missing key raised KeyError deep inside a regeneration,
   945	    and a non-finite value propagated into a published mean as `nan`. Both are
   946	    now one named ValueError, which render_row turns into a BLOCKED row.
   947	    """
   948	    if not files:
   949	        return None, 0
   950	    vals = {k: [] for k, _ in KEYS}
   951	    for f in files:
   952	        d = json.load(open(f))
   953	        d = d.get("metrics") if isinstance(d, dict) else None
   954	        if not isinstance(d, dict):
   955	            raise ValueError(f"{os.path.basename(f)}: no metrics object to aggregate")
   956	        for k, kk in KEYS:
   957	            if kk not in d:
   958	                raise ValueError(f"{os.path.basename(f)}: does not report {kk}")
   959	            if not _finite_number(d[kk]):
   960	                raise ValueError(f"{os.path.basename(f)}: {kk} = {d[kk]!r} is not a "
   961	                                 "finite number")
   962	            vals[k].append(d[kk])
   963	    n = len(files)
   964	    return {k: (st.mean(v), st.stdev(v) if n > 1 else 0.0) for k, v in vals.items()}, n
   965	
