```bash
# K=8 (K=1: swap dataset config to acousticroom_unseeneval_1.json and K8→K1 in --eval-name)
python eval_FLAC.py --model-config worklog/worklog_yixun/exp_21_bf_fa_cartesian_claude/FLAC_AR_BFC.json \
