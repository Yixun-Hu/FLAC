   941	def build_metrics_record(metrics_dict, ckpt_path, rotate_deg, cond_method, frame_avg_angles,
   942	                         cond_autocast='default', batch_size=None, n_samples=None,
   943	                         dataset_config=None, seed=None, cfg_scale=None, steps=None,
   944	                         eval_name=None, weights_source=None, device=None,
   945	                         rotate_mode='fixed', rotate_seed=None, input_hash=None,
   946	                         assignment_hash=None, stream_count=None, img_w=None,
   947	                         by_scene=None, frame_avg_max_fwd_samples=None,
   948	                         are_lambda=None, are_lambda_source=None, are_anchor=None):
   949	    """Assemble the dict written to the metrics JSON.
   950	
   951	    Extends the legacy ``{metrics, ckpt_path, rotate_deg}`` record with
   952	    ``cond_method``, ``frame_avg_angles`` (the frame-average angles used by the
   953	    :data:`FRAME_AVERAGED_COND_METHODS`; ``None`` for vanilla), ``cond_autocast``, and the ORBIT
   954	    EXECUTION provenance (exp_11): which implementation produced the
   955	    conditioning (``batched`` vs the legacy per-angle ``loop``), its per-forward
   956	    sample cap, and the source SHA. Rows produced by different orbit executions
   957	    are not interchangeable — the batched path changes the train-mode
   958	    augmentation schedule and regroups the evaluation tail batch — so this is
   959	    what makes "legacy-loop" a checkable label rather than a footnote.
   960	
   961	    Under ``rotate_mode='random'`` (exp_14) the record additionally carries the
   962	    §3.3 assignment provenance and nulls ``rotate_deg``; in fixed mode it is
   963	    byte-identical to the legacy record. See :func:`_rotation_provenance`.
   964	
   965	    ``frame_avg_max_fwd_samples`` is the cap this evaluation applied; ``None``
   966	    records the module default, i.e. the value every row already in the record
   967	    was produced under (exp_14 pins it to 64 explicitly on both arms).
   968	    """
   969	    execution, cap = orbit_provenance(cond_method, frame_avg_max_fwd_samples)
   970	    record = {
   971	        "metrics": metrics_dict,
   972	        "ckpt_path": ckpt_path,
   973	        "rotate_deg": rotate_deg,
   974	        "cond_method": cond_method,
   975	        "frame_avg_angles": frame_avg_angles,
   976	        "cond_autocast": cond_autocast,
   977	        "orbit_execution": execution,
   978	        "frame_avg_fwd_cap": cap,
   979	        "source_sha": source_sha(),
   980	        # the batched path regroups the split's TAIL batch, so the schedule that
   981	        # produced a row must be reconstructible from the row itself
   982	        "batch_size": batch_size,
   983	        "n_samples": n_samples,
   984	        # ...and so must the rest of the runtime protocol: which split ran, how
   985	        # many items were actually evaluated, and which weights were used. Omitted
   986	        # values stay explicitly None rather than a plausible-looking guess
   987	        # (round-4 review B2).
   988	        "dataset_config": dataset_config,
   989	        "seed": seed,
   990	        "cfg_scale": cfg_scale,
   991	        "steps": steps,
   992	        "eval_name": eval_name,
   993	        "weights_source": weights_source,
   994	        "device": device,
   995	    }
   996	    record = _rotation_provenance(record, rotate_mode, rotate_seed, input_hash,
   997	                                  assignment_hash, stream_count, img_w)
   998	    record = _per_scene_provenance(record, by_scene)
   999	    return _are_provenance(record, are_lambda, are_lambda_source, are_anchor)
