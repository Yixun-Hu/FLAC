   640	def check_exp21_round(exp21_cells, exp21_status):
   641	    """``[problem, ...]`` - the exp_21 BFC pair publishes whole, at one pin, or not
   642	    at all.
   643	
   644	    ``exp21_status`` maps ``(label, K) -> bool`` and carries the validation that
   645	    was ALREADY computed while rendering: readiness derived from file counts
   646	    alone once published a numeric K=1 row beside a BLOCKED K=8 one (exp_14
   647	    round-3 closure A4/B2).
   648	
   649	    No evidence at all is NOT a failed transaction - it is a registered row that
   650	    has not landed yet, which the generator renders as pending. Same carve-out as
   651	    ``check_q9_round`` and ``check_exp14_round``, and it is what keeps another
   652	    machine's regeneration silent until exp_21 actually measures something.
   653	    """
   654	    present = {key: files for key, files in exp21_cells.items() if files}
   655	    if not present:
   656	        return []
   657	    problems, shas = [], {}
   658	    for label in sorted({lbl for lbl, _k in exp21_cells}):
   659	        for k in (1, 8):
   660	            files = exp21_cells.get((label, k))
   661	            if not files:
   662	                problems.append(f"{label}: K={k} has no evidence - the exp_21 row publishes "
   663	                                "only as a complete K=1 + K=8 pair")
   664	            elif len(files) < MIN_SEEDS:
   665	                problems.append(f"{label}: K={k} has {len(files)}/{MIN_SEEDS} seeds")
   666	            elif not exp21_status.get((label, k), False):
   667	                problems.append(f"{label}: K={k} did not validate - both K must be VALID, "
   668	                                "not merely present, or the pair publishes a number beside "
   669	                                "a refusal")
   670	    # ...and ONE evaluator pin across both K: per-cell validation proves each K
   671	    # internally, but cannot see that the two blocks were measured at different
   672	    # commits, which is precisely what the paired K=1/K=8 reading would inherit.
   673	    for (label, k), files in sorted(present.items()):
   674	        for path in files:
   675	            try:
   676	                with open(path) as fh:
   677	                    sha = json.load(fh).get("source_sha")
   678	            except Exception as exc:               # noqa: BLE001
   679	                problems.append(f"{os.path.basename(path)}: unreadable while checking the "
   680	                                f"exp_21 pin ({exc})")
   681	                continue
   682	            shas.setdefault(str(sha), []).append(f"{label} K={k}")
   683	    if len(shas) > 1:
   684	        detail = "; ".join(f"{sha[:12]}: {sorted(set(cells))}"
   685	                           for sha, cells in sorted(shas.items()))
   686	        problems.append("the exp_21 K=1 and K=8 rows span MORE THAN ONE evaluator pin, so "
   687	                        f"the paired reading is not a within-pin comparison - {detail}")
   688	    return problems
