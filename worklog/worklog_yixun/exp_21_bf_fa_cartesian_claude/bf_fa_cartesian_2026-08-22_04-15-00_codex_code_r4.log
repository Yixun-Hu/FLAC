  1002	def resolve_cond_autocast(mode):
  1003	    """Map a ``--cond-autocast`` mode to ``(enabled, dtype)`` for the conditioning call.
  1004	
  1005	    ``'default'`` -> ``(True, None)``: ``torch.amp.autocast(device)`` with no explicit
  1006	    dtype, i.e. the torch per-device default (fp16 on cuda) -- byte-identical to the
  1007	    exp_01/exp_02 protocol. ``'bf16'`` -> ``(True, torch.bfloat16)``: matches
  1008	    ``finetune_cond``'s bf16-mixed training precision. ``'off'`` -> ``(False, None)``:
  1009	    no autocast (fp32), for exactness measurements.
  1010	    """

# number of GPUs to use for training
num_gpus = 1

# Multi-GPU strategy for PyTorch Lightning
strategy = "auto"

# Precision to use for training
precision = "bf16-mixed"

# Sync BatchNorm stats across GPUs (multi-GPU only; requires num_gpus >= 2)
sync_batchnorm = false

# number of CPU workers for the DataLoader
num_workers = 6

# the random seed
seed = 42

# Batches for gradient accumulation
accum_batches = 1

# Number of steps between checkpoints
checkpoint_every = 10000

# Number of steps between validation runs
val_every = -1

# Maximum number of optimizer steps (HAA finetune uses 1000)
max_steps = 1000000

# trainer checkpoint file to restart training from
ckpt_path = ''

# model checkpoint file to start a new training run from
pretrained_ckpt_path = ''

# Checkpoint path for the pretransform model if needed
pretransform_ckpt_path = ''

# configuration model specifying model hyperparameters
model_config = ''

# configuration for datasets
dataset_config = ''

# configuration for validation datasets
val_dataset_config = ''

# directory to save the checkpoints in
save_dir = ''

# gradient_clip_val passed into PyTorch Lightning Trainer
gradient_clip_val = 0.0

# remove the weight norm from the pretransform model
remove_pretransform_weight_norm = ''

# Logger type to use
logger = 'wandb'

# Inference 
steps = 1.0
cfg_scale = 1.0
store_predictions = false

