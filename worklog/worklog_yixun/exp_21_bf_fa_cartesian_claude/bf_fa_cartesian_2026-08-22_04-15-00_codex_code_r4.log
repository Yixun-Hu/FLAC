   183	def repo_paths(repo_root=None):
   184	    """Resolve every path this generator touches against ONE explicit root.
   185	
   186	    Measurement now runs from pinned worktrees, so the cwd is routinely NOT the
   187	    main checkout. Globbing evidence relative to an ambient cwd would silently
   188	    find nothing (rendering published rows as *pending*) or, worse, find a
   189	    worktree's stale copy. Everything — evidence, validator, output — hangs off
   190	    this one root, which defaults to the main tree this file lives in."""
   191	    root = os.path.realpath(repo_root or REPO)
   192	    return {
   193	        "root": root,
   194	        "out": os.path.join(root, "worklog", "worklog_yixun", "model_comparison.md"),
   195	        "validator": os.path.join(root, "worklog", "worklog_yixun",
   196	                                  "exp_11_fa_orbit_claude", "exp11_validate_rows.py"),
   197	    }
