   144	class Profiler:
   145	    def __init__(self):
   146	        self.ticks = [[time(), None]]
   147	
   148	    def tick(self, msg):
   149	        self.ticks.append([time(), msg])
   150	
   151	    def __repr__(self):
   152	        rep = 80 * "=" + "\n"
   153	        for i in range(1, len(self.ticks)):
   154	            msg = self.ticks[i][1]
   155	            ellapsed = self.ticks[i][0] - self.ticks[i - 1][0]
   156	            rep += msg + f": {ellapsed*1000:.2f}ms\n"
   157	        rep += 80 * "=" + "\n\n\n"
   158	        return rep
