   240	def _load_validator(validator_path=None):
   241	    """Import the validator module from an explicit path.
   242	
   243	    It puts its own repo root on sys.path to reach ``src.*``; make sure that
   244	    root is importable from here too, because a generator run from a pinned
   245	    worktree (or any foreign cwd) has no ``src`` on its path at all — the
   246	    failure mode is an unloadable validator, which fails the gate CLOSED and
   247	    would render every real row BLOCKED for the wrong reason."""
   248	    import importlib.util
   249	    path = os.path.abspath(validator_path or EXP11_VALIDATOR)
   250	    root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(path))))
   251	    if root not in sys.path:
   252	        sys.path.insert(0, root)
   253	    spec = importlib.util.spec_from_file_location("exp11_validate_rows", path)
   254	    mod = importlib.util.module_from_spec(spec)
   255	    spec.loader.exec_module(mod)
