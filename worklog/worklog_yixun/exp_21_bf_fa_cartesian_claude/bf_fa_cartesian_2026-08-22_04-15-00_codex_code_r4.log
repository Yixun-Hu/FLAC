   582	def validate_exp21_cell(files, repo_root=None, expected_k=None):
   583	    """``(ok, problems)`` for one exp_21 row: five registered seeds, one pin.
   584	
   585	    ``expected_k`` comes from the ROW CONTRACT and binding it is the point (the
   586	    exp_14 round-3 review B2 lesson): a homogeneous five-seed K=1 payload
   587	    renamed to match the K=8 glob would otherwise validate under the K=8 label,
   588	    and the table would publish one context size's numbers beside another's name.
   589	
   590	    Empty is not a failure - the generator already renders an empty cell as
   591	    pending, and both BFC rows are registered in advance.
   592	    """
   593	    if not files:
   594	        return True, []
   595	    try:
   596	        V = _load_exp21_validator()
   597	    except Exception as exc:                       # the gate must not fail open
   598	        return False, [f"cannot load the exp_21 validator ({exc})"]
   599	    records, problems = {}, []
   600	    for path in sorted(set(files)):
   601	        try:
   602	            with open(path) as fh:
   603	                records[path] = json.load(fh)
   604	        except (ValueError, OSError) as exc:
   605	            problems.append(f"{os.path.basename(path)}: unreadable ({exc})")
   606	    if problems:
   607	        return False, problems
   608	    seeds, ks, pins = [], set(), set()
   609	    for path, record in sorted(records.items()):
   610	        base = os.path.basename(path)
   611	        try:
   612	            cell = V.parse_eval_name(str((record or {}).get("eval_name") or ""))
   613	        except ValueError as exc:
   614	            problems.append(f"{base}: {exc}")
   615	            continue
   616	        seeds.append(int(cell.seed))
   617	        ks.add(int(cell.k))
   618	        pins.add(str((record or {}).get("source_sha")))
   619	        problems += [f"{base}: {r}" for r in V.validate_metrics_record(record, cell)]
   620	        problems += [f"{base}: {r}" for r in _exp21_metric_reasons(record)]
   621	    # the evidence must be the DECLARED row's, not merely self-consistent
   622	    if expected_k is not None and ks and ks != {int(expected_k)}:
   623	        problems.append(f"the row declares K={int(expected_k)} but its evidence is "
   624	                        f"K {sorted(ks)}: a renamed payload is not a re-measurement")
   625	    # exactly one record per registered seed: "no seed missing" also holds for six
   626	    # files with a duplicate, which agg_files would then average as six
   627	    if sorted(seeds) != list(V.SEEDS):
   628	        counts = {s: seeds.count(s) for s in sorted(set(seeds))}
   629	        dupes = sorted(s for s, n in counts.items() if n > 1)
   630	        problems.append(f"the cell must be exactly {len(V.SEEDS)} records, one per seed "
   631	                        f"{list(V.SEEDS)}; got {len(seeds)} with seeds {sorted(seeds)}"
   632	                        + (f" (duplicated: {dupes})" if dupes else ""))
   633	    if len(pins) > 1:
   634	        problems.append(f"the cell spans MORE THAN ONE evaluator pin {sorted(pins)}: five "
   635	                        "cells measured at different commits are not a row, they are five "
   636	                        "measurements wearing one label")
   637	    return (not problems), problems
