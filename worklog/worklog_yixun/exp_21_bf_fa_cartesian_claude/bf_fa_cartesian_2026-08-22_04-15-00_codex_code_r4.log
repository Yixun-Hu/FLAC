   696	def check_exp14_round(exp14_cells, exp14_status):
   697	    """Which exp_14 arms may publish, and why the others may not.
   698	
   699	    Returns ``(withheld_labels, problems)``.
   700	
   701	    Two rules, deliberately at different scopes (round-3 review B4):
   702	
   703	    * **Per ARM, a two-K transaction.** An arm publishes when BOTH its K rows
   704	      carry a full five-seed block AND BOTH VALIDATED, and not before — a lone K
   705	      would invite a K=8-only comparison against rows that carry both. It does
   706	      NOT wait for the other arms: §5.7 sequences the regeneration on VANL's own
   707	      block completing, so a campaign-wide gate would withhold exactly the row
   708	      that triggered it.
   709	
   710	      ``exp14_status`` maps ``(label, K) -> bool`` and is REQUIRED: readiness
   711	      used to be declared from file counts alone, never seeing the validation
   712	      already computed while rendering, so five valid K=1 files beside five K=8
   713	      files carrying one NaN published a numeric K=1 row next to a BLOCKED K=8
   714	      one — the transaction violated in exactly the direction it exists to
   715	      prevent (round-3 closure A4/B2).
   716	    * **Across ARMS, one campaign pin.** exp_14 is a one-pin campaign and its
   717	      whole point is that VANL-vs-Cn carries no cross-pin difference. If the
   718	      published arms disagree on ``source_sha``, none of them publishes.
   719	    """
   720	    present = {key: files for key, files in exp14_cells.items() if files}
   721	    if not present:
   722	        return set(), []                           # nothing landed yet: not an update
   723	    problems, ready, shas = [], set(), {}
   724	    arms = {exp14_arm_of(label) for label, _k in exp14_cells}
   725	    for arm in sorted(arms):
   726	        rows = {k: exp14_cells.get((label, k))
   727	                for (label, k) in exp14_cells if exp14_arm_of(label) == arm}
   728	        if not any(rows.values()):
   729	            continue                               # this arm has not started
   730	        short = {k: (0 if f is None else len(f)) for k, f in rows.items()
   731	                 if f is None or len(f) < MIN_SEEDS}
   732	        if short:
   733	            problems.append(f"{arm}: publishes only as a complete two-K pair; "
   734	                            + ", ".join(f"K={k} has {n}/{MIN_SEEDS} seeds"
   735	                                        for k, n in sorted(short.items())))
   736	            continue
   737	        # counting files is not validating them: a five-file block can still be
   738	        # refused (a NaN, a wrong checkpoint digest, a missing stream audit), and
   739	        # its partner must not publish beside it.
   740	        invalid = sorted(k for (label, k) in exp14_cells
   741	                         if exp14_arm_of(label) == arm and exp14_cells[(label, k)]
   742	                         and not exp14_status.get((label, k), False))
   743	        if invalid:
   744	            problems.append(f"{arm}: K={', K='.join(str(k) for k in invalid)} did not "
   745	                            "validate — both K must be VALID, not merely present, or "
   746	                            "the pair publishes a number beside a refusal")
   747	            continue
   748	        ready.add(arm)
   749	    for (label, k), files in sorted(present.items()):
   750	        if exp14_arm_of(label) not in ready:
   751	            continue                               # an unready arm cannot fix the pin
   752	        for path in files:
   753	            try:
   754	                with open(path) as fh:
   755	                    sha = json.load(fh).get("source_sha")
   756	            except Exception as exc:
   757	                problems.append(f"{os.path.basename(path)}: unreadable while checking "
   758	                                f"the exp_14 pin ({exc})")
   759	                continue
   760	            shas.setdefault(str(sha), []).append(f"{label} K={k}")
   761	    if len(shas) > 1:
   762	        detail = "; ".join(f"{sha[:12]}: {sorted(set(cells))}"
   763	                           for sha, cells in sorted(shas.items()))
   764	        problems.append("the published exp_14 arms span MORE THAN ONE evaluator pin, so "
   765	                        f"VANL-vs-Cn is not a within-pin comparison — {detail}")
   766	        ready = set()                              # nobody publishes across pins
   767	    withheld = {label for label, _k in exp14_cells
   768	                if exp14_arm_of(label) not in ready}
   769	    return withheld, problems
   770	
