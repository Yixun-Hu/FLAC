   841	def protocol_label(base, exp11, evidence_ready):
   842	    """The row's protocol string. exp_11 rows always disclose 'batched'; the
   843	    historical 'legacy-loop' migration waits for the deferred regeneration."""
   844	    if "fa" not in base:
   845	        return base
   846	    if exp11:
   847	        return base if "batched" in base else f"{base} (batched)"
   848	    if not evidence_ready:
   849	        return base
   850	    return base if "legacy-loop" in base else f"{base} (legacy-loop)"
