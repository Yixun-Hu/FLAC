   772	Q9_REQUIRED_CELLS = 4        # VANL x {K1,K8} and C4L x {K1,K8}
   773	
   774	
   775	def check_q9_round(q9_cells):
   776	    """The Q9 estimand is a WITHIN-PIN delta, so the round is one transaction.
   777	
   778	    Per-cell validation proves each arm x K block internally; it cannot see that
   779	    the four blocks belong together. Without this, one arm could publish without
   780	    its comparator, or the arms could be measured at different evaluator pins and
   781	    still validate individually — and the frame-averaging delta would then be
   782	    confounded with whatever moved between those pins, which is the one thing the
   783	    same-pin design exists to exclude."""
   784	    present = {key: files for key, files in q9_cells.items() if files}
   785	    if not present:
   786	        return []                                   # nothing landed yet: not an update
   787	    problems = []
   788	    if len(present) != Q9_REQUIRED_CELLS:
   789	        missing = [f"{lbl} (K={k})" for (lbl, k), f in sorted(q9_cells.items()) if not f]
   790	        problems.append(f"the Q9 round publishes as ONE transaction: {len(present)}/"
   791	                        f"{Q9_REQUIRED_CELLS} cells have evidence, missing "
   792	                        + (", ".join(missing) or "<unregistered cells>"))
   793	    shas = {}
   794	    for key, files in sorted(present.items()):
   795	        for f in files:
   796	            try:
   797	                sha = json.load(open(f)).get("source_sha")
   798	            except Exception as exc:
   799	                problems.append(f"{os.path.basename(f)}: unreadable while checking the Q9 pin ({exc})")
   800	                continue
   801	            shas.setdefault(str(sha), []).append(f"{key[0]} K={key[1]}")
   802	    if len(shas) > 1:
   803	        detail = "; ".join(f"{sha[:12]}: {sorted(set(cells))}" for sha, cells in sorted(shas.items()))
   804	        problems.append("the Q9 round spans MORE THAN ONE evaluator pin, so the VANL-vs-C4L "
   805	                        f"delta is not a within-pin comparison — {detail}")
   806	    return problems
   807	
   808	
   809	def check_two_k_coverage(status_by_row):
   810	    """Item 4b: an exp_11 table update is a TWO-K transaction.
   811	
   812	    ``status_by_row`` maps ``(label, K) -> ok``. A row that lands only one K, or
   813	    whose other K is blocked, is not a complete update: reporting half of it
   814	    would invite a K=8-only comparison against rows that have both."""
   815	    labels = {label for (label, _k) in status_by_row}
   816	    problems = []
   817	    for label in sorted(labels):
   818	        for k in (1, 8):
   819	            if (label, k) not in status_by_row:
   820	                problems.append(f"{label}: K={k} cell is absent — a table update must carry both K")
   821	            elif not status_by_row[(label, k)]:
   822	                problems.append(f"{label}: K={k} cell did not validate — both K must be valid")
   823	    return problems
