   151	class FakeGeometry(nn.Module):
   152	    """GeometryConditioner stand-in (name matched so ``MultiConditioner`` feeds it
   153	    ``{'coord', 'depth'}``).
   154	
   155	    A nonlinear function of the coord-depth difference field with a nonzero-mean
   156	    coord/depth interaction: ``tanh`` is applied per pixel BEFORE pooling so the
   157	    coord contribution cannot cancel out of the pooled statistic, and the
   158	    azimuthal pooling weight is strictly positive, non-uniform and full-period so
   159	    the statistic also sees the depth ROLL. The output head carries a bias (and a
   160	    sigmoid term), so — as for :class:`FakeDist` — the orbit average is not
   161	    forced to zero by odd symmetry."""
   162	
   163	    def __init__(self, out_dim: int = 5, name: str = "GeometryConditioner",
   164	                 seed: int = 0):
   165	        super().__init__()
   166	        self.name = name
   167	        self.out_dim = out_dim
   168	        self.calls = 0
   169	        self.samples = 0
   170	        self.batch_sizes = []
   171	        self.returns = []
   172	        g = torch.Generator().manual_seed(seed)
   173	        self.register_buffer("proj", torch.randn(3, out_dim, generator=g))
   174	        self.register_buffer("head_b", torch.randn(out_dim, generator=g))
   175	
   176	    def forward(self, coord_list, device=DEV):
   177	        self.calls += 1
   178	        self.samples += len(coord_list)
   179	        self.batch_sizes.append(len(coord_list))
   180	        coords = [c["coord"].to(device) for c in coord_list]
   181	        depths = [c["depth"].to(device) for c in coord_list]
   182	        coord = torch.stack(coords, dim=0)             # [B, 3] or [B, N, 3]
   183	        if coord.ndim == 2:
   184	            coord = coord.unsqueeze(1)
   185	        depth = torch.stack(depths, dim=0)             # [B, 3, H, W]
   186	        B, N, _ = coord.shape
   187	        width = depth.shape[-1]
   188	        col = torch.arange(width, device=device, dtype=coord.dtype)
   189	        w = (1.0 + 0.5 * torch.cos(2.0 * math.pi * col / width)).view(1, 1, 1, width)
   190	        outs = []
   191	        for i in range(N):
   192	            diff = coord[:, i, :, None, None] - depth  # [B, 3, H, W]
   193	            outs.append((torch.tanh(diff) * w).mean(dim=(2, 3)))
   194	        stacked = torch.stack(outs, dim=1)             # [B, N, 3]
   195	        h = stacked @ self.proj + self.head_b
   196	        out = torch.tanh(h) + 0.3 * torch.sigmoid(2.0 * h)
   197	        ret = [out.contiguous(), torch.ones(B, 1, device=device)]
   198	        self.returns.append(ret)
   199	        return ret
