   418	def _orbit(n: int) -> tuple:
   419	    """Uniform Cn yaw orbit in degrees (0.0 first). For W=512 every member is
   420	    an exact, 16-px-patch-aligned column roll (C32 = 16 columns)."""
   421	    return tuple(k * 360.0 / n for k in range(n))
   422	
