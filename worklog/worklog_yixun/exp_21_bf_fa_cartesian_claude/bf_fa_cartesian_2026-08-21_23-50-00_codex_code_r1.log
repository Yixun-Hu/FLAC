   114	class FakeDist(nn.Module):
   115	    """dist_embedder stand-in: deterministic, rotation-sensitive and **non-odd**.
   116	
   117	    ``h = x @ w + b`` mixes the three Cartesian components; the bias plus the
   118	    sigmoid/cos terms make ``f(-u) != -f(u)``, which is what keeps the C4 frame
   119	    average from collapsing to zero (see the module docstring). Records every
   120	    forward's batch size and the exact objects it returned, so the tests can
   121	    assert mask PROVENANCE by identity rather than by value."""
   122	
   123	    def __init__(self, out_dim: int = 6, name: str = "DistEmbedderConditioner",
   124	                 seed: int = 0):
   125	        super().__init__()
   126	        self.name = name
   127	        self.out_dim = out_dim
   128	        self.calls = 0
   129	        self.samples = 0
   130	        self.batch_sizes = []
   131	        self.returns = []
   132	        g = torch.Generator().manual_seed(seed)
   133	        self.register_buffer("w", torch.randn(3, out_dim, generator=g))
   134	        self.register_buffer("b", torch.randn(out_dim, generator=g))
   135	
   136	    def forward(self, x_list, device=DEV):
   137	        self.calls += 1
   138	        self.samples += len(x_list)
   139	        self.batch_sizes.append(len(x_list))
   140	        x = torch.stack(x_list, dim=0).to(device)      # [B, 3] or [B, N, 3]
   141	        if x.dim() == 2:
   142	            x = x.unsqueeze(1)                         # [B, 1, 3]
   143	        B, N, _ = x.shape
   144	        h = x @ self.w + self.b                        # [B, N, out_dim]
   145	        out = torch.tanh(h) * torch.sigmoid(h - 0.5) + 0.25 * torch.cos(h)
   146	        ret = [out.contiguous(), torch.ones(B, N, device=device)]
   147	        self.returns.append(ret)
   148	        return ret
