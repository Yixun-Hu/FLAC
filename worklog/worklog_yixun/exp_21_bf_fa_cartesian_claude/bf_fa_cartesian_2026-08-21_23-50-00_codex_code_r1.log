    59	def _make_md(seed: int = 0) -> dict:
    60	    g = torch.Generator().manual_seed(seed)
    61	    return {
    62	        "source": torch.randn(3, generator=g),
    63	        "source_vit": torch.randn(1, 3, generator=g),
    64	        "context_poses": torch.randn(4, 3, generator=g),
    65	        "context_poses_vit": torch.randn(4, 3, generator=g),
    66	        "context_audio": torch.randn(4, 1, 256, generator=g),
    67	        "depth": _consistent_depth(8, 512),
    68	    }
    69	
