   796	# --------------------------------------------------------------------------- #
   797	# 15. B=1 angle mapping is exact (probe job 3646626 bisect)
   798	#
   799	# The GPU probe showed ALL eight B=1 fp32 cells deviating ~3.5e-4..5.4e-4 while
   800	# every B=8/B=64 cell was clean. Hypothesis 1-3 was a B=1-specific semantic bug
   801	# (off-by-one slicing, angle-major mis-mapping, or a tiny-batch branch in the
   802	# conditioner). These tests are the CPU discriminator: the conditioner below
   803	# ENCODES the rotation it was given, so any mis-mapping of the ``out[k*B:(k+1)*B]``
   804	# slices changes the average by O(1), not by 1e-4. They pass, which excludes the
   805	# semantic hypotheses and leaves the CUDA kernel-precision one (see the probe's
   806	# precision policy).
   807	# --------------------------------------------------------------------------- #
   808	class AngleEncodingGeometry(FakeGeometry):
   809	    """Emits the depth map's roll offset, so the output IS the angle identity.
   810	
   811	    ``rotate_scene_metadata`` rolls the panorama by ``round(deg * W / 360)``
   812	    columns; recovering that shift from the rolled depth and returning it makes a
   813	    wrong angle->slice mapping arithmetically visible in the orbit average."""
   814	
   815	    def forward(self, coord_list, device=DEV):
   816	        shifts = []
   817	        for c in coord_list:
   818	            depth = c["depth"]
   819	            # Use the per-column RADIUS: rotate_scene_metadata rolls the panorama
   820	            # AND rotates the stored 3-vectors, so a single component is not a
   821	            # pure roll -- but the radius is rotation-invariant and shifts exactly
   822	            # by the roll, and _consistent_depth's radius is non-symmetric so the
   823	            # match is unique.
   824	            radius = depth.norm(dim=0)[0, :]
   825	            ref = getattr(self, "_ref", None)
   826	            if ref is None:
   827	                ref = self._ref = radius.clone()        # first sample seen == angle 0
   828	            shift = int(torch.argmin(torch.stack([
   829	                (torch.roll(ref, k) - radius).abs().sum() for k in range(radius.shape[0])
   830	            ])))
   831	            shifts.append(float(shift))
   832	        val = torch.tensor(shifts, device=device).view(len(coord_list), 1, 1)
   833	        out = val.expand(len(coord_list), 1, self.out_dim).contiguous()
   834	        return [out, torch.ones(len(coord_list), 1, device=device)]
   835	
