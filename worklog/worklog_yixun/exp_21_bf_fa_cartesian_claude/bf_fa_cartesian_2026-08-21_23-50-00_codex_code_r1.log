   668	# 14. TRAIN-MODE contract: chunk-shared stochastic draws (disclosed recipe
   669	#     change), determinism and gradient flow  (review finding 1, option 2)
   670	# --------------------------------------------------------------------------- #
   671	class StochasticGeometry(FakeGeometry):
   672	    """Stand-in for train-mode DINOv3 with the REAL draw topology.
   673	
   674	    ``GeometryConditioner`` calls the shared DINO backbone once per coordinate
   675	    (conditioners.py: the ``for i in range(coord.shape[1])`` loop), and each DINO
   676	    forward independently draws its RoPE position rescale. So the unit of
   677	    randomness is the DINO FORWARD, not the conditioner call: one conditioner
   678	    call over K coordinates takes K draws — 9 for the production stack (1 source
   679	    + 8 context) at K=8.
   680	
   681	    What batching changes is which SAMPLES share a draw: a DINO forward now
   682	    covers a whole chunk of stacked angles, so angles inside a chunk share the
   683	    draw the per-angle loop gave them independently, and the total number of
   684	    draws falls from ``C * K`` to ``(1 + n_chunks) * K``. The averaging
   685	    arithmetic is untouched. That is the disclosed recipe change, applied
   686	    identically to every arm (C4L included); these tests pin the NEW contract
   687	    rather than pretending the old one still holds."""
   688	
   689	    def __init__(self, *a, **kw):
   690	        super().__init__(*a, **kw)
   691	        self.draws = 0            # DINO-forward-level draws (one per coordinate)
   692	        self.scale = nn.Parameter(torch.ones(1))
   693	
   694	    def forward(self, coord_list, device=DEV):
   695	        out = super().forward(coord_list, device)
   696	        if self.training:
   697	            n_coords = out[0].shape[1]                   # K: one DINO forward each
   698	            rope = torch.rand(n_coords, device=device)   # consumes global RNG per coordinate
   699	            self.draws += n_coords
   700	            out[0] = out[0] * (1.0 + 0.1 * rope).view(1, n_coords, 1) * self.scale
   701	        else:
   702	            out[0] = out[0] * self.scale
   703	        return out
   704	
   705	
   706	def _stochastic_cond():
   707	    return MultiConditioner({
   708	        "source": FakeDist(), "context_poses": FakeDist(), "context_audio": FakeRIR(),
   709	        "source_vit": StochasticGeometry(), "context_poses_vit": StochasticGeometry(),
   710	    })
   711	
