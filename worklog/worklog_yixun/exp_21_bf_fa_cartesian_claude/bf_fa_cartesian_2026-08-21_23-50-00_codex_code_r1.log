    75	# --------------------------------------------------------------------------- #
    76	# fake conditioners (duck-typed nn.Module, keyed exactly like FLAC)
    77	# --------------------------------------------------------------------------- #
    78	class FakeDist(nn.Module):
    79	    """dist_embedder stand-in: deterministic nonlinear function of its pose
    80	    input, with a call counter."""
    81	
    82	    def __init__(self, out_dim: int = 8, name: str = "DistEmbedderConditioner"):
    83	        super().__init__()
    84	        self.name = name
    85	        self.out_dim = out_dim
    86	        self.calls = 0
    87	        self.samples = 0
    88	        self.batch_sizes = []
    89	
    90	    def forward(self, x_list, device=DEV):
    91	        self.calls += 1
    92	        self.samples += len(x_list)
    93	        self.batch_sizes.append(len(x_list))
    94	        x = torch.stack(x_list, dim=0).to(device)  # [B, 3] or [B, N, 3]
    95	        if x.dim() == 2:
    96	            x = x.unsqueeze(1)  # [B, 1, 3]
    97	        B, N, _ = x.shape
    98	        feat = torch.tanh(x.sum(dim=-1, keepdim=True))  # [B, N, 1]
    99	        out = feat.expand(B, N, self.out_dim).contiguous()
   100	        return [out, torch.ones(B, N, device=device)]
