    67	def _consistent_depth(h: int = H, w: int = W) -> torch.Tensor:
    68	    """Geometrically consistent, NON-axisymmetric equirectangular depth cloud.
    69	
    70	    At column ``j`` the stored vector's xy-azimuth equals ``theta_j``, so a roll
    71	    plus a z-rotation composes exactly (the convention
    72	    ``yaw_transform_consistency`` checks). The radius varies with azimuth
    73	    (periods 2*pi and pi), so every C4 roll genuinely changes the map — a
    74	    constant-radius panorama is a fixed point of the rotation and would hide a
    75	    stale-depth bug."""
    76	    j = torch.arange(w, dtype=torch.float32)
    77	    theta = (j + 0.5) * 2.0 * math.pi / w - math.pi
    78	    i = torch.arange(h, dtype=torch.float32)
    79	    el = (i + 0.5) * math.pi / h - math.pi / 2.0
    80	    theta_g = theta.view(1, w).expand(h, w)
    81	    el_g = el.view(h, 1).expand(h, w)
    82	    d = 3.0 + 1.0 * torch.sin(theta_g) + 0.5 * torch.sin(2.0 * theta_g)
    83	    x = d * torch.cos(el_g) * torch.cos(theta_g)
    84	    y = d * torch.cos(el_g) * torch.sin(theta_g)
    85	    z = d * torch.sin(el_g)
    86	    return torch.stack([x, y, z], dim=0).contiguous()
