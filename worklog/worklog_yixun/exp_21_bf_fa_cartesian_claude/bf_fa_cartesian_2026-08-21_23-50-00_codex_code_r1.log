   189	def cylindrical_pose_features(
   190	    md: Dict[str, object], eps: float = 1e-6
   191	) -> Dict[str, object]:
   192	    """
   193	    Replace absolute pose vectors with yaw-invariant cylindrical features.
   194	
   195	    Each pose ``(x, y, z)`` becomes ``(r, z, dphi)`` where ``r = sqrt(x^2 + y^2)``
   196	    and ``dphi`` is the azimuth measured *relative* to a scene-intrinsic reference
   197	    azimuth. Because every azimuth in a rigidly yaw-rotated scene shifts by the
   198	    same amount, the relative ``dphi`` (and ``r``, ``z``) are invariant under any
   199	    yaw rotation, making these features an exact invariant of the C-infinity yaw
   200	    group.
   201	
   202	    The reference azimuth is the target source's azimuth. If the source lies on
   203	    the vertical axis (``r_s < eps``, azimuth undefined) the reference falls back
   204	    to the azimuth of the largest-``r`` pose among ``{source, context poses}`` --
   205	    still a scene-intrinsic quantity, so invariance is preserved in the fallback.
   206	    If *every* pose is degenerate (largest ``r`` also ``< eps``) every ``dphi``
   207	    is exactly ``0``.
   208	
   209	    Only ``'source'`` and ``'context_poses'`` are transformed; ``'*_vit'`` poses,
   210	    ``'depth'`` and all other keys pass through untouched (same objects). The
   211	    input dict is not mutated: a shallow copy is returned with fresh tensors for
   212	    the replaced keys, preserving each pose tensor's dtype and device.
   213	
   214	    Parameters
   215	    ----------
   216	    md : Dict[str, object]
   217	        One per-sample metadata dict. ``'source'`` (shape ``[3]``) and, optionally,
   218	        ``'context_poses'`` (shape ``[N, 3]``) are read; the last dimension is
   219	        ordered ``(x, y, z)``.
   220	    eps : float, optional
   221	        Radius below which a pose azimuth is treated as undefined (default 1e-6).
   222	
   223	    Returns
   224	    -------
   225	    Dict[str, object]
   226	        A shallow copy of ``md`` with ``'source'`` -> ``(r_s, z_s, 0.0)`` and each
   227	        ``'context_poses'`` row -> ``(r_i, z_i, wrap(phi_i - phi_ref))``.
   228	    """
   229	    out: Dict[str, object] = dict(md)
   230	
   231	    source = md.get("source")
   232	    context = md.get("context_poses")
   233	
   234	    # Candidate poses for the fallback reference azimuth: source + context rows.
   235	    cand_r = []
   236	    cand_phi = []
   237	
   238	    r_s = phi_s = sz = None
   239	    if source is not None:
   240	        assert isinstance(source, torch.Tensor)
   241	        sx, sy, sz = source[..., 0], source[..., 1], source[..., 2]
   242	        r_s = torch.sqrt(sx * sx + sy * sy)
   243	        phi_s = torch.atan2(sy, sx)
   244	        cand_r.append(r_s.reshape(1))
   245	        cand_phi.append(phi_s.reshape(1))
   246	
   247	    r_c = phi_c = cz = None
   248	    if context is not None:
   249	        assert isinstance(context, torch.Tensor)
   250	        cx, cy, cz = context[..., 0], context[..., 1], context[..., 2]
   251	        r_c = torch.sqrt(cx * cx + cy * cy)
   252	        phi_c = torch.atan2(cy, cx)
   253	        cand_r.append(r_c.reshape(-1))
   254	        cand_phi.append(phi_c.reshape(-1))
   255	
   256	    # Reference azimuth: target source, unless degenerate -> largest-r pose.
   257	    # The fallback pose must itself be non-degenerate (its azimuth defined);
   258	    # if even the largest r is < eps the scene is all-degenerate -> dphi == 0.
   259	    phi_ref = None
   260	    if r_s is not None and bool(r_s >= eps):
   261	        phi_ref = phi_s
   262	    elif cand_r:
   263	        all_r = torch.cat(cand_r)
   264	        all_phi = torch.cat(cand_phi)
   265	        max_idx = int(torch.argmax(all_r))
   266	        if bool(all_r[max_idx] >= eps):
   267	            phi_ref = all_phi[max_idx]
   268	
   269	    if source is not None:
   270	        out["source"] = torch.stack([r_s, sz, torch.zeros_like(r_s)])
   271	
   272	    if context is not None:
   273	        if phi_ref is not None:
   274	            dphi = wrap_angle(phi_c - phi_ref)
   275	        else:
   276	            dphi = torch.zeros_like(r_c)
   277	        out["context_poses"] = torch.stack([r_c, cz, dphi], dim=-1)
   278	
   279	    return out
   280	
   281	
   282	def yaw_column_shift(alpha_rad: float, img_w: int) -> int:
   283	    """
   284	    The integer panorama-column shift a yaw angle quantises to: ``round(a*W/2pi) % W``.
   285	
   286	    This is the rule :func:`rotate_scene_metadata` applies, extracted so that code
   287	    which must *record* the applied shift (exp_14's assignment audit, which stores
   288	    a fixed-mode cell's constant offset) reads it from the same place the rotation
   289	    does. Two copies of this rule could drift, and a drifted copy would label a
   290	    cell with an offset it never applied --- the one thing the audit exists to make
   291	    impossible.
   292	
   293	    Parameters
   294	    ----------
   295	    alpha_rad : float
   296	        Requested yaw rotation angle in radians (any sign, any magnitude).
   297	    img_w : int
   298	        Panorama width in columns.
   299	
   300	    Returns
   301	    -------
   302	    int
   303	        The column shift in ``[0, img_w)``.
   304	    """
   305	    return int(round(alpha_rad * img_w / (2.0 * math.pi))) % int(img_w)
   306	
   307	
   308	def azimuth_rotation_matrix(alpha_rad: float) -> torch.Tensor:
   309	    """
   310	    Build a 3x3 rotation matrix about the vertical (z) axis.
   311	
   312	    Parameters
   313	    ----------
   314	    alpha_rad : float
   315	        Rotation angle in radians. Positive values rotate the (x, y) plane
   316	        counter-clockwise, which corresponds to increasing azimuth.
   317	
   318	    Returns
   319	    -------
   320	    torch.Tensor
   321	        A ``[3, 3]`` float32 rotation matrix leaving the z component unchanged.
   322	    """
   323	    c = math.cos(alpha_rad)
   324	    s = math.sin(alpha_rad)
   325	    return torch.tensor([[c, -s, 0.0], [s, c, 0.0], [0.0, 0.0, 1.0]], dtype=torch.float32)
   326	
   327	
   328	def rotate_scene_metadata(
   329	    md: Dict[str, object],
   330	    alpha_rad: float,
   331	    img_w: int,
   332	    pose_keys: Tuple[str, ...] = POSE_KEYS,
   333	) -> Dict[str, object]:
   334	    """
   335	    Apply a physically-consistent yaw rotation to a single sample's metadata.
   336	
   337	    The equirectangular depth map is rolled horizontally by the integer number of
   338	    columns closest to ``alpha_rad`` and its stored per-pixel 3D vectors are rotated
   339	    about z. All pose vectors are rotated about z by the same effective angle.
   340	    ``context_audio``, ``scene`` and any other field pass through unchanged. The
   341	    rotation is exact (no interpolation) because the column shift is quantised and
   342	    the rotation matrix uses the matching effective angle.
   343	
   344	    Parameters
   345	    ----------
   346	    md : Dict[str, object]
   347	        One per-sample metadata dict as produced by the AR/HAA metadata module.
   348	        Expected tensor fields: ``depth`` of shape ``[3, H, W]`` and pose fields
   349	        (``source``, ``source_vit``, ``context_poses``, ``context_poses_vit``)
   350	        whose last dimension is 3.
   351	    alpha_rad : float
   352	        Requested yaw rotation angle in radians.
   353	    img_w : int
   354	        Panorama width in pixels (number of azimuth columns), e.g. 512.
   355	    pose_keys : Tuple[str, ...], optional
   356	        Which pose fields to rotate. Defaults to all of ``POSE_KEYS`` (the
   357	        exp_02 behaviour). Restricting it (e.g. to the ``*_vit`` keys only) leaves
   358	        the unlisted pose fields bit-identical; ``depth`` handling is unaffected.
   359	
   360	    Returns
   361	    -------
   362	    Dict[str, object]
   363	        A shallow-copied metadata dict with ``depth`` and the selected pose fields
   364	        replaced by their rotated versions. The original dict is not mutated.
   365	    """
   366	    dj = yaw_column_shift(alpha_rad, img_w)
   367	    alpha_eff = dj * 2.0 * math.pi / img_w
   368	    rot = azimuth_rotation_matrix(alpha_eff)
   369	
   370	    out: Dict[str, object] = dict(md)
   371	
   372	    if "depth" in md:
   373	        depth = md["depth"]
   374	        assert isinstance(depth, torch.Tensor)
