   494	def fa_cartesian_conditioning(
   495	    conditioner,
   496	    metadata: "list",
   497	    device,
   498	    angles: Tuple[float, ...] = DEFAULT_FRAME_ANGLES,
   499	    max_fwd_samples: "int | None" = None,
