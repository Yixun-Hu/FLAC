    93	        "source_vit": torch.randn(1, 3, generator=g),
    94	        "context_poses": torch.randn(n_ctx, 3, generator=g),
    95	        "context_poses_vit": torch.randn(n_ctx, 3, generator=g),
    96	        "context_audio": torch.randn(n_ctx, 1, 64, generator=g),
    97	        "depth": _consistent_depth(H, width),
    98	        "scene": f"Toy/Toy_idx_{seed}",
    99	    }
