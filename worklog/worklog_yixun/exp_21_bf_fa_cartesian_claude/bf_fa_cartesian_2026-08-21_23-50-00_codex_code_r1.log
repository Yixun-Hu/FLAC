   732	            f"C{n}/B{batch}: {vit} drew {cond.conditioners[vit].draws}, expected {want} "
   733	            f"({forwards} forward(s) x {coords[vit]} coordinate(s))"
   734	        )
   735	        assert len(cond.conditioners[vit].batch_sizes) == forwards
   736	        # ...and strictly fewer than the legacy per-angle loop would have taken
