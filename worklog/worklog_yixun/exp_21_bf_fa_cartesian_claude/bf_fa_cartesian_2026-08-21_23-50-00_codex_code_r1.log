   360	# --------------------------------------------------------------------------- #
   361	# 9. NEGATIVE: stale (unrotated) depth in the averaging loop breaks invariance
   362	# --------------------------------------------------------------------------- #
   363	def _stale_depth_conditioning(cond, metadata, device, angles=yr.DEFAULT_FRAME_ANGLES,
   364	                              vit_ids=VIT_IDS):
   365	    """Deliberately BROKEN mimic of ``invariant_conditioning``: per frame angle
   366	    it rotates the ``*_vit`` poses but feeds the STALE (unrotated) depth map —
   367	    the exact finding-8 bug class. Test-local only; exists to prove the C4
   368	    invariance assertions in this file can actually catch that bug."""
   369	    md_inv = [yr.cylindrical_pose_features(md) for md in metadata]
   370	    base = cond(md_inv, device)
   371	    present = [i for i in vit_ids if i in base]
   372	    img_w = int(metadata[0]["depth"].shape[-1])
   373	    accum = {i: base[i][0].clone() for i in present}
   374	    for g in angles[1:]:
   375	        variants = []
   376	        for m in md_inv:
   377	            v = yr.rotate_scene_metadata(m, math.radians(g), img_w,
   378	                                         pose_keys=tuple(present))
   379	            v["depth"] = m["depth"]  # BUG under test: depth not co-rotated
   380	            variants.append(v)
   381	        part = cond(variants, device, only_ids=present)
   382	        for i in present:
   383	            accum[i] = accum[i] + part[i][0]
   384	    for i in present:
   385	        base[i][0] = accum[i] / float(len(angles))
   386	    return base
   387	
