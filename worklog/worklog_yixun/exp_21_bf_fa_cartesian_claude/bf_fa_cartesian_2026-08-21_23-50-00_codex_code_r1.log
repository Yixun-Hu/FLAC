    77	>         r = r / self.r_scale
    78	>         z = z / self.z_scale
    79	>         r_feat = [r, sin(r * radial_freqs), cos(r * radial_freqs)]
    80	>         z_feat = [z, sin(z * vertical_freqs), cos(z * vertical_freqs)]
    81	>         angle_feat = [sin(dphi * harmonics), cos(dphi * harmonics)]
    82	>         feat = cat(r_feat, z_feat, angle_feat)
