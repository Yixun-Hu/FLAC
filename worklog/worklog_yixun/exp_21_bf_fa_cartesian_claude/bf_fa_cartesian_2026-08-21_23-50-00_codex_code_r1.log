    58	def resolve_frame_avg_cap(max_fwd_samples=None) -> int:
    59	    """The frame-average forward cap this call must use.
    60	
    61	    ``None`` -> :data:`FRAME_AVG_MAX_FWD_SAMPLES` (64), i.e. exactly the
    62	    behaviour every recipe already in the record was run under. Anything else is
    63	    validated and returned as-is; the module global is never rebound, because the
    64	    cap is a per-arm property (exp_14's ``training.frame_avg_max_fwd_samples``)
    65	    and a process-wide assignment would (a) leak into whatever else the process
    66	    later conditions and (b) survive a mid-step crash as a cap nobody declared.
    67	
    68	    Validation is on the RAW value and fail-closed. ``bool`` is rejected before
    69	    ``int`` because ``isinstance(True, int)`` is True and ``max(1, 64 // True)``
    70	    would quietly become a 64-angle chunk plan; a float or a numeric string is
    71	    rejected rather than coerced, because ``int("32")`` succeeding on a typo is
    72	    how an arm gets trained under a cap its config never stated.
    73	    """
    74	    if max_fwd_samples is None:
    75	        return FRAME_AVG_MAX_FWD_SAMPLES
    76	    if isinstance(max_fwd_samples, bool) or not isinstance(max_fwd_samples, int):
    77	        raise ValueError(
    78	            f"max_fwd_samples must be an int (the frame-average per-forward sample "
    79	            f"cap), got {max_fwd_samples!r}"
    80	        )
    81	    if max_fwd_samples < 1:
    82	        raise ValueError(f"max_fwd_samples must be >= 1, got {max_fwd_samples}")
    83	    return int(max_fwd_samples)
