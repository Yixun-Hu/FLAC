   507	# --------------------------------------------------------------------------- #
   508	# 12. batched orbit reproduces the pre-batching AVERAGING ARITHMETIC (exp_11 Q5)
   509	#
   510	# Scope of the claim: identical terms, identical accumulation order, identical
   511	# divisor -- proven here on deterministic conditioners. It is NOT a claim that
   512	# the whole training path is unchanged: train-mode DINOv3 draws its random RoPE
   513	# rescale once per forward, so chunked angles share a draw (a disclosed recipe
   514	# change applied identically to every arm; section 14 pins that new contract).
   515	# --------------------------------------------------------------------------- #
   516	def _reference_orbit_average(cond, metadata, device, angles):
   517	    """The PRE-BATCHING algorithm, reproduced here on purpose.
   518	
   519	    This is deliberately a copy rather than an import: it is the specification
   520	    the batched implementation must reproduce, so it has to keep working even if
   521	    the library's own reference helper is refactored away."""
   522	    md_inv = [yr.cylindrical_pose_features(m) for m in metadata]
   523	    base = cond(md_inv, device)
   524	    present = [i for i in VIT_IDS if i in base]
   525	    img_w = int(metadata[0]["depth"].shape[-1])
   526	    accum = {i: base[i][0].clone() for i in present}
   527	    for g in angles[1:]:
   528	        variants = [
   529	            yr.rotate_scene_metadata(m, math.radians(g), img_w, pose_keys=tuple(present))
   530	            for m in md_inv
   531	        ]
   532	        part = cond(variants, device, only_ids=present)
   533	        for i in present:
   534	            accum[i] = accum[i] + part[i][0]
   535	    for i in present:
   536	        base[i][0] = accum[i] / float(len(angles))
   537	    return base
