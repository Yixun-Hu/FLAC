   424	def _small_md(seed: int = 0, n_ctx: int = 2, depth_h: int = 2) -> dict:
   425	    """Same fields as :func:`_make_md`, smaller. The Cn tests below are O(n^2)
   426	    in conditioner passes (n rotations x an n-element orbit average), so the
   427	    synthetic tensors are shrunk to keep this permanent CPU test cheap. The
   428	    panorama width stays 512, so every orbit member is still an exact
   429	    16-px-aligned column roll, and no group element or tolerance is relaxed."""
   430	    g = torch.Generator().manual_seed(seed)
   431	    return {
   432	        "source": torch.randn(3, generator=g),
   433	        "source_vit": torch.randn(1, 3, generator=g),
   434	        "context_poses": torch.randn(n_ctx, 3, generator=g),
   435	        "context_poses_vit": torch.randn(n_ctx, 3, generator=g),
   436	        "context_audio": torch.randn(n_ctx, 1, 256, generator=g),
   437	        "depth": _consistent_depth(depth_h, 512),
   438	    }
   439	
