    30	# --------------------------------------------------------------------------- #
    31	# geometrically consistent synthetic depth (adapted from test_yaw_symmetry)
    32	# --------------------------------------------------------------------------- #
    33	def _consistent_depth(H: int = 8, W: int = 512) -> torch.Tensor:
    34	    """Geometrically consistent but NON-axisymmetric equirectangular depth
    35	    point cloud.
    36	
    37	    At column ``j`` the stored vector's xy-azimuth still equals ``theta_j``
    38	    (the convention checked by ``yaw_transform_consistency``), so roll +
    39	    z-rotation composes exactly. Unlike a constant-radius panorama — for which
    40	    ``rotate_scene_metadata`` is a *fixed point* of the depth map, hiding
    41	    stale-depth bugs — the radial distance varies with azimuth (periods 2*pi
    42	    and pi, so every C4 roll changes the map). This is what lets the
    43	    stale-depth negative test detect a depth/pose co-rotation bug
    44	    (plan-review finding 8 / cycle-3 Codex review finding 1)."""
    45	    j = torch.arange(W, dtype=torch.float32)
    46	    theta = (j + 0.5) * 2.0 * math.pi / W - math.pi
    47	    i = torch.arange(H, dtype=torch.float32)
    48	    el = (i + 0.5) * math.pi / H - math.pi / 2.0
    49	    theta_g = theta.view(1, W).expand(H, W)
    50	    el_g = el.view(H, 1).expand(H, W)
    51	    # Azimuth-dependent radius, strictly positive (minimum 3.0 - 1.5 = 1.5).
    52	    d = 3.0 + 1.0 * torch.sin(theta_g) + 0.5 * torch.sin(2.0 * theta_g)
    53	    x = d * torch.cos(el_g) * torch.cos(theta_g)
    54	    y = d * torch.cos(el_g) * torch.sin(theta_g)
    55	    z = d * torch.sin(el_g)
    56	    return torch.stack([x, y, z], dim=0).contiguous()
    57	
