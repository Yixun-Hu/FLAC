   393	    correct_0 = yr.invariant_conditioning(cond, md, DEV)
   394	    rot = [yr.rotate_scene_metadata(m, math.radians(90.0), 512) for m in md]
   395	    broken_g = _stale_depth_conditioning(cond, rot, DEV)
   396	    for key in VIT_IDS:
   397	        inv_div = float((broken_g[key][0] - broken_0[key][0]).abs().max())
   398	        avg_div = float((broken_0[key][0] - correct_0[key][0]).abs().max())
   399	        print(
   400	            f"{key}: stale-depth invariance divergence {inv_div:.3e}, "
   401	            f"divergence from correct orbit average {avg_div:.3e}"
   402	        )
   403	        # The broken variant must FAIL the same C4 invariance check the
   404	        # positive test uses...
   405	        assert not torch.allclose(broken_g[key][0], broken_0[key][0], atol=1e-5), (
   406	            f"{key}: stale-depth variant unexpectedly passed the C4 invariance "
   407	            "check — the FakeGeometry/depth fixtures are too weak to pin finding 8"
   408	        )
   409	        # ...and must not reproduce the correct orbit average either.
   410	        assert not torch.allclose(broken_0[key][0], correct_0[key][0], atol=1e-5), (
   411	            f"{key}: stale-depth variant matches the correct orbit average"
   412	        )
