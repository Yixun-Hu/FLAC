   103	class FakeGeometry(nn.Module):
   104	    """GeometryConditioner stand-in (name matched so MultiConditioner feeds it
   105	    ``{'coord', 'depth'}``). Deterministic *nonlinear* function of the
   106	    coord−depth difference field with a genuinely nonzero-mean coord–depth
   107	    interaction: ``tanh`` is applied per-pixel BEFORE pooling, so the coord
   108	    contribution does not cancel out of the pooled statistic (the cycle-3
   109	    review found that a zero-mean linear weight let it cancel), and the
   110	    azimuthal pooling weight is strictly positive and non-uniform, so the
   111	    statistic is also sensitive to the depth roll offset. A wrong
   112	    implementation that rotates depth without the ``*_vit`` poses (or vice
   113	    versa) therefore changes the C4 average and fails the invariance test."""
   114	
   115	    def __init__(self, out_dim: int = 6, name: str = "GeometryConditioner"):
   116	        super().__init__()
   117	        self.name = name
   118	        self.out_dim = out_dim
   119	        self.calls = 0
   120	        self.samples = 0
   121	        self.batch_sizes = []
   122	        g = torch.Generator().manual_seed(0)
   123	        self.register_buffer("proj", torch.randn(3, out_dim, generator=g))
   124	
   125	    def forward(self, coord_list, device=DEV):
   126	        self.calls += 1
   127	        self.samples += len(coord_list)
   128	        self.batch_sizes.append(len(coord_list))
   129	        coords, depths = [], []
   130	        for c in coord_list:
   131	            coords.append(c["coord"].to(device))      # dtype-preserving: the fp64
   132	            depths.append(c["depth"].to(device))      # equivalence case runs in double
   133	        coord = torch.stack(coords, dim=0)  # [B, 3] or [B, N, 3]
   134	        if coord.ndim == 2:
   135	            coord = coord.unsqueeze(1)  # [B, 1, 3]
   136	        depth = torch.stack(depths, dim=0)  # [B, 3, H, W]
   137	        B, N, _ = coord.shape
   138	        W = depth.shape[-1]
   139	        col = torch.arange(W, device=device, dtype=coord.dtype)
   140	        # Strictly positive (in [0.5, 1.5]), non-uniform, full-period profile:
   141	        # nonzero mean (== 1) so the coord term survives pooling; period W so
   142	        # every nontrivial C4 roll misaligns depth content against it.
   143	        w = (1.0 + 0.5 * torch.cos(2.0 * math.pi * col / W)).view(1, 1, 1, W)
   144	        outs = []
   145	        for i in range(N):
   146	            diff = coord[:, i, :, None, None] - depth  # [B, 3, H, W]
   147	            pooled = (torch.tanh(diff) * w).mean(dim=(2, 3))  # [B, 3]
   148	            outs.append(pooled)
   149	        stacked = torch.stack(outs, dim=1)  # [B, N, 3]
   150	        out = torch.tanh(stacked @ self.proj)  # [B, N, out_dim]
   151	        return [out, torch.ones(B, 1, device=device)]
   152	
   153	
   154	class FakeRIR(nn.Module):
   155	    """RIR encoder stand-in: constant-shaped output, a call counter, and an
   156	    internal BatchNorm1d whose ``num_batches_tracked`` must increment exactly
   157	    once per ``invariant_conditioning`` call (finding-2 regression guard)."""
   158	
   159	    def __init__(self, out_dim: int = 8, name: str = "RIRConditioner"):
   160	        super().__init__()
   161	        self.name = name
   162	        self.out_dim = out_dim
   163	        self.calls = 0
   164	        self.samples = 0
   165	        self.batch_sizes = []
   166	        self.bn = nn.BatchNorm1d(out_dim)
   167	
   168	    def forward(self, audios_list, device=DEV):
   169	        self.calls += 1
   170	        self.samples += len(audios_list)
   171	        self.batch_sizes.append(len(audios_list))
   172	        audios = torch.stack(audios_list, dim=0).to(device)  # [B, N, C, T]
   173	        B, N = audios.shape[0], audios.shape[1]
   174	        flat = audios.reshape(B * N, -1)[:, : self.out_dim]  # [B*N, out_dim]
   175	        feat = self.bn(flat)  # increments num_batches_tracked by 1
   176	        out = feat.reshape(B, N, self.out_dim)
   177	        return [out, torch.ones(B, 1, device=device)]
   178	
   179	
   180	def _build_cond(with_geometry: bool = True) -> MultiConditioner:
   181	    conditioners = {
   182	        "source": FakeDist(),
   183	        "context_poses": FakeDist(),
   184	        "context_audio": FakeRIR(),
   185	    }
   186	    if with_geometry:
   187	        conditioners["source_vit"] = FakeGeometry()
   188	        conditioners["context_poses_vit"] = FakeGeometry()
   189	    return MultiConditioner(conditioners)
   190	
   191	
