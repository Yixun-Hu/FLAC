   767	def test_train_mode_gradients_reach_the_conditioner(single_thread):
   768	    """The batched orbit must stay in the autograd graph.
   769	
   770	    A nonzero aggregate gradient alone would not prove that: the base pass could
   771	    supply all of it. So the orbit's contribution is isolated by comparing the
   772	    gradient of a C8 average against a single-angle (C1) run on the same inputs —
   773	    if the rotated chunks were detached, the two would be identical."""
   774	    def grad_for(angles, seed=7):
   775	        cond = _stochastic_cond().train()
   776	        torch.manual_seed(seed)
   777	        out = yr.invariant_conditioning(cond, _small_batch(8), DEV, angles)
   778	        loss = sum(out[k][0].float().pow(2).mean() for k in VIT_IDS)
   779	        cond.zero_grad(set_to_none=True)
   780	        loss.backward()
   781	        return {v: cond.conditioners[v].scale.grad.clone() for v in VIT_IDS}
   782	
   783	    orbit_grad = grad_for(_orbit(8))
   784	    base_only_grad = grad_for((0.0,))
   785	    for vit in VIT_IDS:
   786	        g = orbit_grad[vit]
   787	        assert g is not None, f"{vit}: no gradient reached the conditioner"
   788	        assert torch.isfinite(g).all(), f"{vit}: non-finite gradient {g}"
   789	        assert float(g.abs().max()) > 0.0, f"{vit}: zero gradient — the orbit is detached"
   790	        assert not torch.equal(g, base_only_grad[vit]), (
   791	            f"{vit}: the C8 gradient equals the base-only gradient — the rotated chunks "
   792	            "contribute nothing, i.e. the orbit is outside the graph"
   793	        )
