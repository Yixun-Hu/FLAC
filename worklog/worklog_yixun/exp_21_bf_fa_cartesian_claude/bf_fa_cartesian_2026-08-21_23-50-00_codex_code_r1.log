   687	    dimension into chunks of at most ``cap`` samples (default
   688	    :data:`FRAME_AVG_MAX_FWD_SAMPLES`; whole angles per chunk, so a chunk is
   689	    ``k * B`` samples), each chunk is one conditioner call, and the stacked output
   690	    is split back per angle. Terms are accumulated in the INPUT ANGLE ORDER
   691	    starting from the angle-0 base, so the additions are never reassociated: the
   692	    averaging arithmetic is identical to the loop.
   693	
   694	    ``cap_is_explicit`` only selects which knob the over-cap error names — the
   695	    module constant, or the config key that overrode it. A caller that hands us a
   696	    cap it read from a config must not be told to edit a module global.
   697	
   698	    What is NOT identical is the augmentation schedule under train-mode DINOv3:
   699	    its random RoPE rescale is drawn once per forward, so a chunk's angles share
   700	    a draw (see :data:`FRAME_AVG_MAX_FWD_SAMPLES` for the disclosure). In eval
   701	    mode there is no such draw and the two paths agree numerically.
   702	
   703	    Only the ``present`` (ViT) ids are re-run; masks come from the base pass.
   704	    A batch larger than the cap is rejected rather than silently exceeding it,
   705	    because a chunk cannot be smaller than one angle.
   706	    """
   707	    accum = {i: base[i][0].clone() for i in present}
   708	    rest = angles[1:]
   709	    if not rest:
   710	        return accum
   711	    if cap is None:
   712	        cap = FRAME_AVG_MAX_FWD_SAMPLES
   713	    cap_name = ("training.frame_avg_max_fwd_samples" if cap_is_explicit
   714	                else "FRAME_AVG_MAX_FWD_SAMPLES")
   715	    batch = len(md_inv)
   716	    if batch > cap:
   717	        raise ValueError(
   718	            f"batch {batch} exceeds {cap_name} "
   719	            f"({cap}): a frame-average chunk is whole angles, so it "
   720	            "cannot be split below one angle -- lower the batch or raise the cap deliberately"
   721	        )
   722	    angles_per_chunk = max(1, cap // batch)
   723	    for start in range(0, len(rest), angles_per_chunk):
   724	        chunk = rest[start:start + angles_per_chunk]
   725	        stacked = []
   726	        for g in chunk:
   727	            stacked.extend(_rotated_variants(md_inv, g, img_w, present))
   728	        part = conditioner(stacked, device, only_ids=present)
   729	        for i in present:
   730	            out = part[i][0]
   731	            if out.shape[0] != len(chunk) * batch:
   732	                raise RuntimeError(
   733	                    f"{i}: batched orbit forward returned {out.shape[0]} rows for "
   734	                    f"{len(chunk)} angle(s) x {batch} sample(s)"
   735	                )
   736	            for k in range(len(chunk)):          # ascending angle order preserved
   737	                accum[i] = accum[i] + out[k * batch:(k + 1) * batch]
   738	    return accum
   739	
   740	
   741	def yaw_transform_consistency(
   742	    depth: torch.Tensor, img_w: int, angles_deg: Tuple[float, ...]
   743	) -> Dict[float, float]:
   744	    """
   745	    Verify that yaw-rotating a depth panorama keeps it a valid equirectangular map.
   746	
   747	    A consistent equirectangular depth point cloud stores, at column ``j``, a 3D
   748	    vector whose horizontal azimuth equals that column's azimuth ``theta_j`` (because
   749	    ``x = d*cos(phi)*cos(theta)`` and ``y = d*cos(phi)*sin(theta)``). A physically
   750	    correct yaw rotation --- a horizontal roll of ``dj`` columns together with a
   751	    matching rotation of the stored vectors about z --- must preserve this property.
   752	    If the roll direction and the rotation-matrix sign disagree, the rotated map is
   753	    no longer a valid panorama and the per-column azimuth deviation becomes large
   754	    (about twice the rotation angle). This is the automated sign sanity-check.
   755	
   756	    Parameters
   757	    ----------
   758	    depth : torch.Tensor
   759	        A single depth point cloud of shape ``[3, H, W]`` in the panorama camera frame.
   760	    img_w : int
   761	        Panorama width in pixels (number of azimuth columns).
   762	    angles_deg : Tuple[float, ...]
   763	        Yaw angles in degrees to test for consistency (0 deg is always included as a
   764	        control).
   765	
   766	    Returns
   767	    -------
   768	    Dict[float, float]
   769	        Mapping from angle in degrees to the maximum per-pixel azimuth deviation in
   770	        radians, excluding near-pole pixels where azimuth is undefined. Values near
   771	        zero indicate a geometrically consistent transform.
   772	    """
   773	    j = torch.arange(img_w, device=depth.device, dtype=depth.dtype)
   774	    theta = ((j + 0.5) * 2.0 * math.pi / img_w - math.pi).unsqueeze(0)
   775	
   776	    def max_dev(pc: torch.Tensor) -> float:
   777	        x, y = pc[0], pc[1]
   778	        az = torch.atan2(y, x)
   779	        diff = (az - theta + math.pi) % (2.0 * math.pi) - math.pi
   780	        mag = torch.sqrt(x * x + y * y)
   781	        mask = mag > 1e-3
   782	        if bool(mask.sum() == 0):
   783	            return float("nan")
   784	        return float(diff[mask].abs().max().item())
   785	
   786	    report = {0.0: max_dev(depth)}
   787	    for deg in angles_deg:
   788	        rotated = rotate_scene_metadata({"depth": depth}, math.radians(deg), img_w)["depth"]
   789	        assert isinstance(rotated, torch.Tensor)
   790	        report[float(deg)] = max_dev(rotated)
   791	    return report

