   806	def verify_stream_count(stream, dataset_count, expected=None):
   807	    """Substitution guard: one stream position per split item, and the right split.
   808	
   809	    Two independent checks, because they catch different failures:
   810	
   811	    * ``len(stream) == dataset_count`` --- a short stream means items were dropped,
   812	      a long one that they were served twice. This compares the run against
   813	      itself, so it can only detect an inconsistency, never a wrong split.
   814	    * ``... == expected`` --- the campaign's PRE-REGISTERED item count (6,337 for
   815	      the published unseen split, announcement 01). Without it the first check is
   816	      tautological: a zero-item or subsampled dataset is perfectly self-consistent
   817	      and used to produce a valid-looking artifact (review B1). Supplied by the
   818	      launch kit; omitting it leaves only the weaker check.
   819	
   820	    Either failure FAILS the cell rather than reporting a number (plan §3.3).
   821	    """
   822	    got = len(stream)
   823	    if dataset_count is None:
   824	        raise RuntimeError(
   825	            "cannot verify the rotation stream: the dataset item count is unknown."
   826	        )
   827	    dataset_count = int(dataset_count)
   828	    if got != dataset_count:
   829	        raise RuntimeError(
   830	            f"rotation stream has {got} positions but the dataset holds {dataset_count} "
   831	            "items: the evaluated split does not match the configured one (dropped, "
   832	            "duplicated or substituted items). Refusing to report metrics."
   833	        )
   834	    if expected is None:
   835	        return
   836	    expected = int(expected)
   837	    if expected <= 0:
   838	        raise RuntimeError(
   839	            f"expected_stream_count must be a positive item count, got {expected}."
   840	        )
   841	    if dataset_count != expected:
   842	        raise RuntimeError(
   843	            f"rotation stream and dataset agree on {got} items, but the pre-registered "
   844	            f"split has {expected}: this cell evaluated a different split than the "
   845	            "campaign declares (announcement 01 forbids new or subsampled eval "
   846	            "configurations). Refusing to report metrics."
   847	        )
