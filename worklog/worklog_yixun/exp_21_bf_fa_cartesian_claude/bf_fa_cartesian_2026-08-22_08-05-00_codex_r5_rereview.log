   280	# --------------------------------------------------------------------------- #
   281	# the per-arm trained-as expectation
   282	# --------------------------------------------------------------------------- #
   283	def _type_strict_equal(got, want):
   284	    """Equality that does NOT let ``1`` pass for ``1.0`` — element-wise.
   285	
   286	    Python compares ``[0, 90, 180, 270] == [0.0, 90.0, 180.0, 270.0]`` as True and
   287	    both are ``list``, so a container-level type check misses exactly the drift
   288	    this is here to catch (caught by test, not by inspection). The factory
   289	    distinguishes the two, so this must as well.
   290	    """
   291	    if type(got) is not type(want):
   292	        return False
   293	    if isinstance(want, list):
   294	        return (len(got) == len(want)
   295	                and all(_type_strict_equal(g, w) for g, w in zip(got, want)))
   296	    if isinstance(want, dict):
   297	        return (set(got) == set(want)
   298	                and all(_type_strict_equal(got[k], want[k]) for k in want))
   299	    return got == want
   300	
   301	
   302	def check_embedded_training(embedded_model_config, arm):
   303	    """``[reason, ...]`` naming every way this checkpoint is not ``arm``'s.
   304	
   305	    Pure, so it is testable without a 700 MB file. ``eval_FLAC`` enforces the BFC
   306	    case itself before any model is built; this is what holds the COMPARATOR
   307	    checkpoints to their own (different) shapes, and it is why the expectations
   308	    are declared per arm rather than as one template.
   309	    """
   310	    if arm not in ARMS:
   311	        return [f"unknown arm {arm!r}"]
   312	    if not isinstance(embedded_model_config, dict) or not embedded_model_config:
   313	        return [f"{arm}: the checkpoint carries no embedded 'model_config' "
   314	                f"({type(embedded_model_config).__name__}), so the arm it was TRAINED "
   315	                "as cannot be proven (announcement 05)"]
   316	    training = embedded_model_config.get("training")
   317	    if not isinstance(training, dict):
   318	        return [f"{arm}: the embedded model_config has no 'training' block "
   319	                f"(found {training!r})"]
   320	
   321	    reasons = []
   322	    for key, want in sorted(ARMS[arm]["expected_training"].items()):
   323	        present = key in training
   324	        if want is ABSENT:
   325	            if present:
   326	                reasons.append(
   327	                    f"{arm}: embedded training.{key} is {training[key]!r}, but this "
   328	                    "arm's checkpoint predates that knob and must not declare it — a "
   329	                    "checkpoint that does is not the artifact this row publishes")
   330	            continue
   331	        if key == "cond_method":
   332	            # an absent cond_method IS the factory default, and that is what those
   333	            # weights trained under (exp_07 P1's embedded config is this shape)
   334	            got = training.get(key, "vanilla")
   335	        elif not present:
   336	            reasons.append(f"{arm}: embedded training.{key} is absent, required {want!r}")
   337	            continue
   338	        else:
   339	            got = training[key]
   340	        if not _type_strict_equal(got, want):
   341	            reasons.append(
   342	                f"{arm}: embedded training.{key} is {got!r} ({type(got).__name__}), "
   343	                f"required {want!r} ({type(want).__name__}) — type-strictly, element "
   344	                "by element, which is the distinction the factory itself enforces")
   345	    return reasons
   346	
   347	
   348	def preflight(arm, root=None):
   349	    """Hold ``arm``'s checkpoint to its training contract. Returns its sha256.
   350	
   351	    Imports torch lazily and reads on CPU: this is a cheap, GPU-free gate the
   352	    driver runs ONCE per arm, before that arm's cells, so a wrong-arm campaign
   353	    costs one checkpoint read rather than ten evaluations.
   354	    """
   355	    import torch                                  # noqa: PLC0415 - lazy on purpose
   356	    root = root or repo_root()
   357	    path = resolve_ckpt(arm, root=root)
   358	    ckpt = torch.load(path, map_location="cpu", weights_only=False)
   359	    reasons = check_embedded_training(ckpt.get("model_config"), arm)
   360	    if reasons:
   361	        raise SystemExit("TRAINED-AS PREFLIGHT FAILED for " + arm + ":\n  - "
   362	                         + "\n  - ".join(reasons))
   363	    import hashlib
   364	    digest = hashlib.sha256()
   365	    with open(path, "rb") as handle:
   366	        for block in iter(lambda: handle.read(1 << 20), b""):
   367	            digest.update(block)
   368	    return digest.hexdigest()
   369	
   370	
   371	def main(argv=None):
   372	    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
   373	    sub = parser.add_subparsers(dest="cmd", required=True)
   374	    p_list = sub.add_parser("commands", help="print every cell's command, one per line")
   375	    p_list.add_argument("--arm", choices=list(ARM_ORDER), default=None)
   376	    p_list.add_argument("--placeholder", default=None,
   377	                        help="stand-in for an unresolved checkpoint epoch (dry runs)")
   378	    p_list.add_argument("--with-paths", action="store_true",
   379	                        help="prefix each line with the metrics JSON it produces")
   380	    p_pre = sub.add_parser("preflight", help="hold an arm's checkpoint to its contract")
   381	    p_pre.add_argument("arm", choices=list(ARM_ORDER))
   382	    args = parser.parse_args(argv)
   383	
   384	    if args.cmd == "preflight":
   385	        print(f"{args.arm} trained-as preflight OK; ckpt_sha256 {preflight(args.arm)}")
   386	        return 0
   387	
   388	    for cell in inventory():
   389	        if args.arm and cell.arm != args.arm:
   390	            continue
   391	        argv_tokens = command(cell.arm, cell.k, cell.seed, cell.rotate_deg,
   392	                              placeholder=args.placeholder)
   393	        line = " ".join(argv_tokens)
   394	        if args.with_paths:
   395	            line = (os.path.relpath(metrics_path(cell.arm, cell.k, cell.seed,
   396	                                                 cell.rotate_deg,
   397	                                                 placeholder=args.placeholder),
   398	                                    repo_root()) + "\t" + line)
   399	        print(line)
   400	    return 0
   401	
   402	
   403	if __name__ == "__main__":
   404	    sys.exit(main())
     1	#!/usr/bin/env bash
     2	# ============================================================================
     3	# bfc_eval_driver.sh — exp_21's whole evaluation campaign, driven from ONE
     4	# protocol definition.
     5	#
     6	# 34 cells, in this order:
     7	#   10  BFC registered      5 seeds x {K1, K8}      -> the Table row pair
     8	#    4  BFC invariance grid K8/s42 at 45/90/180/270 -> plan §5 acceptance test
     9	#   10  BFre (B-F @40k)     5 seeds x {K1, K8}      -\  D6: both comparators
    10	#   10  P1re (P1  @40k)     5 seeds x {K1, K8}      -/  re-evaluated at THIS pin
    11	#
    12	# The grid's 0-degree member is the registered K8/seed-42 cell itself — it
    13	# carries --record-stream like every registered cell now does, so re-running it
    14	# under a second name would publish two measurements of one thing (plan §5:
    15	# "14 unique BFC cells — 10 registered + 4 extra grid angles, the K8/s42/0 cell
    16	# shared"). Hence 34 invocations, not 35.
    17	#
    18	# THIS SCRIPT RESTATES NO FLAG. Every command comes from exp21_protocol.py, which
    19	# imports its constants from exp21_validate_cell.py — the same module the model-
    20	# comparison table admits rows with. That is the whole design: the thing that
    21	# RUNS the evaluation and the thing that JUDGES it cannot disagree, because there
    22	# is one definition (announcement 05: eval-protocol flags are part of the
    23	# experiment, never defaults; `--cond-autocast bf16` alone moved the same
    24	# checkpoint's T60 between 8.202 and 10.652 in the exp_10 record).
    25	#
    26	# Modes (env):
    27	#   DRY_RUN=1   print all 34 commands and exit. Touches nothing, needs no GPU.
    28	#               PLACEHOLDER=<s> renders BFC's unresolved epoch number as <s>, so
    29	#               the inventory can be reviewed before the arm has trained.
    30	#   ARM=<name>  restrict to one of BFC | BFre | P1re.
    31	#
    32	# Resume is by ARTIFACT ADMISSION, not by a bookmark: a cell is skipped only when
    33	# its metrics JSON already exists AND validates against the registered protocol
    34	# (exp_17's roteval runners resume the same way). A half-written or protocol-wrong
    35	# artifact is therefore re-run rather than trusted, and re-running the driver
    36	# after any interruption is safe.
    37	#
    38	# Written by the Coder seat (Claude Opus 5, max effort), exp_21 round 5.
    39	# ============================================================================
    40	set -uo pipefail
    41	
    42	EXPDIR="worklog/worklog_yixun/exp_21_bf_fa_cartesian_claude"
    43	PROTOCOL="${EXPDIR}/exp21_protocol.py"
    44	TS="$(date '+%Y-%m-%d_%H-%M-%S')"
    45	LOG="${EXPDIR}/bf_fa_cartesian_${TS}_eval_driver.log"
    46	
    47	DRY_RUN="${DRY_RUN:-0}"
    48	ARM="${ARM:-}"
    49	PLACEHOLDER="${PLACEHOLDER:-}"
    50	
    51	_bool01() { case "$2" in 0|1) return 0;; *) echo "$1 must be 0 or 1, got '$2' - abort"; return 1;; esac; }
    52	_bool01 DRY_RUN "$DRY_RUN" || exit 2
    53	case "$ARM" in ""|BFC|BFre|P1re) ;; *) echo "ARM must be BFC, BFre or P1re, got '$ARM' - abort"; exit 2;; esac
    54	
    55	[ -f "$PROTOCOL" ] || { echo "missing ${PROTOCOL} - abort"; exit 2; }
    56	[ -f "eval_FLAC.py" ] || { echo "run from the repo root (no ./eval_FLAC.py here) - abort"; exit 2; }
    57	
    58	ARM_ARGS=(); [ -n "$ARM" ] && ARM_ARGS=(--arm "$ARM")
    59	PH_ARGS=();  [ -n "$PLACEHOLDER" ] && PH_ARGS=(--placeholder "$PLACEHOLDER")
    60	
    61	# ---------------------------------------------------------------------------
    62	# DRY RUN: the inventory, verbatim, nothing else.
    63	# ---------------------------------------------------------------------------
    64	if [ "$DRY_RUN" = "1" ]; then
    65	  python "$PROTOCOL" commands "${ARM_ARGS[@]}" "${PH_ARGS[@]}" || exit 2
    66	  exit 0
    67	fi
    68	
    69	# ---------------------------------------------------------------------------
    70	# Real run.
    71	# ---------------------------------------------------------------------------
    72	exec > >(tee -a "$LOG") 2>&1
    73	echo "=== exp_21 eval driver started $(date '+%Y-%m-%d %H:%M:%S') ==="
    74	echo "protocol: ${PROTOCOL} | arm filter: ${ARM:-<all>} | log: ${LOG}"
    75	echo "source_sha: $(git rev-parse HEAD 2>/dev/null || echo unknown)"
    76	
    77	# Refuse to share the GPUs with another evaluation: two eval_FLAC runs at batch
    78	# 64 do not fit, and a half-run cell is worse than an unrun one.
    79	if pgrep -af "python .*eval_FLAC\.py" | grep -v "$$" >/dev/null 2>&1; then
    80	  echo "REFUSING: another eval_FLAC.py is already running:"
    81	  pgrep -af "python .*eval_FLAC\.py"
    82	  exit 2
    83	fi
    84	
    85	# --- per-arm trained-as preflight (r5 full review, findings 1 + 4) ----------
    86	# One CPU checkpoint read per arm, BEFORE any of its cells: a wrong-arm campaign
    87	# then costs one read instead of ten evaluations. eval_FLAC enforces the BFC
    88	# contract itself on every cell; this is what holds the two COMPARATOR
    89	# checkpoints to their own (different, historically-shaped) contracts.
    90	for arm in BFC BFre P1re; do
    91	  [ -n "$ARM" ] && [ "$ARM" != "$arm" ] && continue
    92	  echo "--- trained-as preflight: ${arm} ---"
    93	  python "$PROTOCOL" preflight "$arm" || {
    94	    echo "preflight FAILED for ${arm} - refusing to evaluate this arm"; exit 2; }
    95	done
    96	
    97	# --- the cells ---------------------------------------------------------------
    98	mapfile -t CELLS < <(python "$PROTOCOL" commands "${ARM_ARGS[@]}" --with-paths) || exit 2
    99	[ "${#CELLS[@]}" -gt 0 ] || { echo "no cells to run - abort"; exit 2; }
   100	echo "cells to consider: ${#CELLS[@]}"
   101	
   102	ran=0; skipped=0; failed=0
   103	for entry in "${CELLS[@]}"; do
   104	  metrics_json="${entry%%$'\t'*}"
   105	  cmd="${entry#*$'\t'}"
   106	  name="$(basename "$metrics_json")"
   107	
   108	  # ADMISSION-GATE RESUME: an existing artifact is trusted only if it still
   109	  # validates as this cell's registered measurement AND carries its full-split
   110	  # sidecar. Anything else is re-run.
   111	  if [ -f "$metrics_json" ]; then
   112	    if python - "$metrics_json" <<'PY'
   113	import importlib.util, json, os, sys
   114	here = os.path.join("worklog", "worklog_yixun", "exp_21_bf_fa_cartesian_claude")
   115	spec = importlib.util.spec_from_file_location(
   116	    "exp21_validate_cell", os.path.join(here, "exp21_validate_cell.py"))
   117	V = importlib.util.module_from_spec(spec); spec.loader.exec_module(V)
   118	path = sys.argv[1]
   119	try:
   120	    record = json.load(open(path))
   121	except Exception as exc:
   122	    print(f"  existing artifact unreadable ({exc})"); sys.exit(1)
   123	reasons = V.stream_sidecar_reasons(path)
   124	name = str(record.get("eval_name") or "")
   125	try:
   126	    reasons += V.validate_metrics_record(record, V.parse_eval_name(name))
   127	except ValueError:
   128	    # a comparator or grid cell: not a registered TABLE cell, so the row
   129	    # validator cannot judge it. The sidecar + a finite metrics block is what
   130	    # can be checked here; the table gate judges the rows themselves.
   131	    metrics = record.get("metrics")
   132	    if not isinstance(metrics, dict) or not metrics:
   133	        reasons.append("no metrics block")
   134	    if record.get(V.CKPT_SHA_FIELD) is None:
   135	        reasons.append(f"no {V.CKPT_SHA_FIELD}")
   136	    if record.get(V.TRAINED_FIELD) is None:
   137	        reasons.append(f"no {V.TRAINED_FIELD}")
   138	for r in reasons:
   139	    print("  " + r)
   140	sys.exit(1 if reasons else 0)
   141	PY
   142	    then
   143	      echo "SKIP (already valid): ${name}"; skipped=$((skipped + 1)); continue
   144	    else
   145	      echo "RE-RUN (existing artifact did not validate): ${name}"
   146	    fi
   147	  fi
   148	
   149	  echo "--- $(date '+%H:%M:%S') RUN: ${name}"
   150	  echo "    ${cmd}"
   151	  # Split into an argv array rather than running an unquoted ${cmd}: word
   152	  # splitting alone is what is wanted here, and bare expansion would ALSO
   153	  # pathname-expand any token containing a glob character.
   154	  IFS=' ' read -r -a _tok <<< "$cmd"
   155	  if "${_tok[@]}"; then ran=$((ran + 1)); else
   156	    rc=$?; failed=$((failed + 1)); echo "    CELL FAILED (rc=${rc}): ${name}"
   157	  fi
   158	done
   159	
   160	echo "=== exp_21 eval driver done $(date '+%Y-%m-%d %H:%M:%S'): ${ran} run, ${skipped} skipped, ${failed} failed ==="
   161	[ "$failed" -eq 0 ] || exit 1
   162	exit 0

