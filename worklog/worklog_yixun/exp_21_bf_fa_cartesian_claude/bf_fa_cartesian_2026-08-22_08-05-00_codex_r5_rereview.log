   711	def check_exp21_round(exp21_cells, exp21_status):
   712	    """``[problem, ...]`` - the exp_21 BFC pair publishes whole, at one pin, or not
   713	    at all.
   714	
   715	    ``exp21_status`` maps ``(label, K) -> bool`` and carries the validation that
   716	    was ALREADY computed while rendering: readiness derived from file counts
   717	    alone once published a numeric K=1 row beside a BLOCKED K=8 one (exp_14
   718	    round-3 closure A4/B2).
   719	
   720	    No evidence at all is NOT a failed transaction - it is a registered row that
   721	    has not landed yet, which the generator renders as pending. Same carve-out as
   722	    ``check_q9_round`` and ``check_exp14_round``, and it is what keeps another
   723	    machine's regeneration silent until exp_21 actually measures something.
   724	    """
   725	    present = {key: files for key, files in exp21_cells.items() if files}
   726	    if not present:
   727	        return []
   728	    problems, shas = [], {}
   729	    for label in sorted({lbl for lbl, _k in exp21_cells}):
   730	        for k in (1, 8):
   731	            files = exp21_cells.get((label, k))
   732	            if not files:
   733	                problems.append(f"{label}: K={k} has no evidence - the exp_21 row publishes "
   734	                                "only as a complete K=1 + K=8 pair")
   735	            elif len(files) < MIN_SEEDS:
   736	                problems.append(f"{label}: K={k} has {len(files)}/{MIN_SEEDS} seeds")
   737	            elif not exp21_status.get((label, k), False):
   738	                problems.append(f"{label}: K={k} did not validate - both K must be VALID, "
   739	                                "not merely present, or the pair publishes a number beside "
   740	                                "a refusal")
   741	    # ...and ONE evaluator pin across both K: per-cell validation proves each K
   742	    # internally, but cannot see that the two blocks were measured at different
   743	    # commits, which is precisely what the paired K=1/K=8 reading would inherit.
   744	    ckpts, digests = {}, {}
   745	    try:
   746	        sha_field = _load_exp21_validator().CKPT_SHA_FIELD
   747	    except Exception:                              # the gate must not fail open
   748	        return problems + ["cannot load the exp_21 validator to check checkpoint "
   749	                           "digests across the two K rows"]
   750	    for (label, k), files in sorted(present.items()):
   751	        for path in files:
   752	            try:
   753	                with open(path) as fh:
   754	                    record = json.load(fh)
   755	            except Exception as exc:               # noqa: BLE001
   756	                problems.append(f"{os.path.basename(path)}: unreadable while checking the "
   757	                                f"exp_21 pin ({exc})")
   758	                continue
   759	            shas.setdefault(str(record.get("source_sha")), []).append(f"{label} K={k}")
   760	            ckpts.setdefault(os.path.normpath(str(record.get("ckpt_path"))),
   761	                             []).append(f"{label} K={k}")
   762	            digests.setdefault(str(record.get(sha_field, "<absent>")),
   763	                               []).append(f"{label} K={k}")
   764	    # ONE checkpoint across BOTH K (r4 review BLOCKING 3). K=1 and K=8 evaluate
   765	    # the same weights and differ only in context size; per-cell validation
   766	    # proves each block internally and cannot see that they came from different
   767	    # runs, which would make the paired K reading a comparison of two models.
   768	    if len(ckpts) > 1:
   769	        detail = "; ".join(f"{os.path.basename(c)}: {sorted(set(cells))}"
   770	                           for c, cells in sorted(ckpts.items()))
   771	        problems.append("the exp_21 K=1 and K=8 rows were produced from MORE THAN ONE "
   772	                        f"checkpoint - {detail}")
   773	    # ...and the BYTES, not just the path (r5 review BLOCKING 2). One path across
   774	    # both K is satisfied by K=1 consistently loading bytes A while K=8 loads
   775	    # bytes B -- a re-trained arm written to the same filename, which is exactly
   776	    # what a digest exists to make visible.
   777	    if len(digests) > 1 or "<absent>" in digests:
   778	        detail = "; ".join(f"{d[:12]}: {sorted(set(cells))}"
   779	                           for d, cells in sorted(digests.items()))
   780	        problems.append(f"the exp_21 K=1 and K=8 rows do not share ONE proven "
   781	                        f"{sha_field} - {detail}")
   782	    if len(shas) > 1:
   783	        detail = "; ".join(f"{sha[:12]}: {sorted(set(cells))}"
   784	                           for sha, cells in sorted(shas.items()))
   785	        problems.append("the exp_21 K=1 and K=8 rows span MORE THAN ONE evaluator pin, so "
   786	                        f"the paired reading is not a within-pin comparison - {detail}")
   787	    return problems
