   183	def parse_ckpt_step(ckpt_path):
   184	    """The optimizer step a checkpoint path names; ``ValueError`` if it does not.
   185	
   186	    Exactly one ``step=<n>`` token, on a ``.ckpt``: two tokens are ambiguous and
   187	    none is unprovable, and both are more likely to be a path built by hand than
   188	    one PL wrote.
   189	    """
   190	    if not isinstance(ckpt_path, str) or not ckpt_path.endswith(".ckpt"):
   191	        raise ValueError(f"ckpt_path {ckpt_path!r} is not a .ckpt path")
   192	    steps = CKPT_STEP_RE.findall(os.path.basename(ckpt_path))
   193	    if len(steps) != 1:
   194	        raise ValueError(
   195	            f"ckpt_path {ckpt_path!r} names {len(steps)} 'step=<n>' tokens; a registered "
   196	            "cell evaluates one PL checkpoint, whose basename carries exactly one")
   197	    return int(steps[0])
