   214	def repo_paths(repo_root=None):
   215	    """Resolve every path this generator touches against ONE explicit root.
   216	
   217	    Measurement now runs from pinned worktrees, so the cwd is routinely NOT the
   218	    main checkout. Globbing evidence relative to an ambient cwd would silently
   219	    find nothing (rendering published rows as *pending*) or, worse, find a
   220	    worktree's stale copy. Everything — evidence, validator, output — hangs off
   221	    this one root, which defaults to the main tree this file lives in."""
   222	    root = os.path.realpath(repo_root or REPO)
   223	    return {
   224	        "root": root,
   225	        "out": os.path.join(root, "worklog", "worklog_yixun", "model_comparison.md"),
   226	        "validator": os.path.join(root, "worklog", "worklog_yixun",
   227	                                  "exp_11_fa_orbit_claude", "exp11_validate_rows.py"),
   228	    }
