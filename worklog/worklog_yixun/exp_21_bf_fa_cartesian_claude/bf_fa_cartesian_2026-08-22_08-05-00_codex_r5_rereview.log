   147	def _repo_root(start=None):
   148	    """Marker-walk to the repo root; survives worklog relocations."""
   149	    path = os.path.abspath(start or os.path.dirname(os.path.abspath(__file__)))
   150	    while not os.path.isdir(os.path.join(path, ".git")):
   151	        parent = os.path.dirname(path)
   152	        if parent == path:
   153	            raise RuntimeError("repo root (.git) not found from " + str(start))
   154	        path = parent
