   805	def _load_exp21_protocol(path=None):
   806	    """exp_21's campaign definition (arms, flags, per-arm training contracts)."""
   807	    import importlib.util
   808	    target = os.path.abspath(path or EXP21_PROTOCOL)
   809	    spec = importlib.util.spec_from_file_location("exp21_protocol", target)
   810	    if spec is None or spec.loader is None:
   811	        raise ImportError(f"cannot load the exp_21 protocol from {target}")
   812	    module = importlib.util.module_from_spec(spec)
   813	    spec.loader.exec_module(module)
   814	    return module
