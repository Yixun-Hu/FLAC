   176	def _record(**kw):
   177	    base = dict(rotate_deg=0.0, cond_method="fa_cartesian",
   178	                frame_avg_angles=list(ANGLES), cond_autocast="bf16", batch_size=64,
   179	                n_samples=6337, dataset_config="ds.json", seed=42, cfg_scale=1.0,
   180	                steps=1, eval_name="e", weights_source="ema", device="cpu",
   181	                frame_avg_max_fwd_samples=EVAL_CAP)
   182	    base.update(kw)
   183	    return eval_FLAC.build_metrics_record({"T60": 1.0}, "c/epoch=8-step=40000.ckpt",
   184	                                          **base)
