   817	def validate_exp21c_cell(files, repo_root=None, expected_k=None, expected_arm=None):
   818	    """``(ok, problems)`` for one D6 comparator row.
   819	
   820	    The SAME machinery as ``validate_exp21_cell`` -- deliberately, since the whole
   821	    point of D6 is that these cells and BFC's are one campaign. What differs is
   822	    the arm PROFILE (its cond_method, whether it runs an orbit, and what its
   823	    checkpoint must have been TRAINED as), which the protocol module owns.
   824	    """
   825	    if not files:
   826	        return True, []
   827	    try:
   828	        V = _load_exp21_validator()
   829	        P = _load_exp21_protocol()
   830	    except Exception as exc:                       # the gate must not fail open
   831	        return False, [f"cannot load the exp_21 protocol/validator ({exc})"]
   832	    if expected_arm not in P.ARMS:
   833	        return False, [f"row is not registered to a campaign arm ({expected_arm!r})"]
   834	    prof = P.arm_profile(expected_arm)
   835	
   836	    records, problems = {}, []
   837	    for path in sorted(set(files)):
   838	        try:
   839	            with open(path) as fh:
   840	                records[path] = json.load(fh)
   841	        except (ValueError, OSError) as exc:
   842	            problems.append(f"{os.path.basename(path)}: unreadable ({exc})")
   843	    if problems:
   844	        return False, problems
   845	
   846	    seeds, ks, pins, ckpts, shas, without_sha = [], set(), set(), set(), set(), []
   847	    for path, record in sorted(records.items()):
   848	        base = os.path.basename(path)
   849	        try:
   850	            cell = V.parse_arm_eval_name(str((record or {}).get("eval_name") or ""),
   851	                                         prof["eval_prefix"])
   852	        except ValueError as exc:
   853	            problems.append(f"{base}: {exc}")
   854	            continue
   855	        seeds.append(int(cell.seed))
   856	        ks.add(int(cell.k))
   857	        pins.add(str((record or {}).get("source_sha")))
   858	        ckpts.add(os.path.normpath(str((record or {}).get("ckpt_path"))))
   859	        sha = (record or {}).get(V.CKPT_SHA_FIELD)
   860	        (without_sha.append(base) if sha is None else shas.add(str(sha)))
   861	        problems += [f"{base}: {r}" for r in V.validate_metrics_record(record, cell, prof)]
   862	        problems += [f"{base}: {r}" for r in _exp21_metric_reasons(record)]
   863	        problems += [f"{base}: {r}" for r in V.stream_sidecar_reasons(path)]
   864	    if len(ckpts) > 1:
   865	        problems.append(f"the cell spans MORE THAN ONE checkpoint {sorted(ckpts)}: the five "
   866	                        "seeds of a row are five samplings of ONE checkpoint")
   867	    if without_sha:
   868	        problems.append(f"{len(without_sha)} of {len(records)} records carry no "
   869	                        f"{V.CKPT_SHA_FIELD} ({sorted(without_sha)}): an unproven "
   870	                        "checkpoint identity is not a proven one")
   871	    if len(shas) > 1:
   872	        problems.append(f"the cell spans MORE THAN ONE {V.CKPT_SHA_FIELD} {sorted(shas)}: "
   873	                        "the same path can name different bytes")
   874	    if expected_k is not None and ks and ks != {int(expected_k)}:
   875	        problems.append(f"the row declares K={int(expected_k)} but its evidence is "
   876	                        f"K {sorted(ks)}: a renamed payload is not a re-measurement")
   877	    if sorted(seeds) != list(V.SEEDS):
   878	        counts = {s: seeds.count(s) for s in sorted(set(seeds))}
   879	        dupes = sorted(s for s, n in counts.items() if n > 1)
   880	        problems.append(f"the cell must be exactly {len(V.SEEDS)} records, one per seed "
   881	                        f"{list(V.SEEDS)}; got {len(seeds)} with seeds {sorted(seeds)}"
   882	                        + (f" (duplicated: {dupes})" if dupes else ""))
   883	    if len(pins) > 1:
   884	        problems.append(f"the cell spans MORE THAN ONE evaluator pin {sorted(pins)}")
   885	    return (not problems), problems
