   187	def test_the_record_carries_the_digest_beside_the_path_it_proves():
   188	    rec = _record(ckpt_sha256=DIGEST)
   189	    assert rec["ckpt_sha256"] == DIGEST
   190	    # adjacency is deliberate: a reader looking for checkpoint identity finds
   191	    # both halves in one place, and the order is part of the file
   192	    keys = list(rec)
   193	    assert keys[keys.index("ckpt_path") + 1] == "ckpt_sha256"
