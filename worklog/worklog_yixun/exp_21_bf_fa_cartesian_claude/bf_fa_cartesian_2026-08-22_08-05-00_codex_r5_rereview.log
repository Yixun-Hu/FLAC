   778	def verify_stream_positions(stream):
   779	    """Substitution guard, positionally: stream position ``i`` must be dataset item ``i``.
   780	
   781	    Evaluation runs with ``shuffle=False`` over a sequential sampler, so this
   782	    holds by construction --- unless ``SampleDataset.__getitem__`` substituted a
   783	    random other item after a load or silence failure, which is exactly the event
   784	    the assignment audit exists to catch. A hash can only reveal that by
   785	    comparison against another cell; this catches it in the cell that suffered it.
   786	
   787	    Raises ``RuntimeError`` naming the FIRST offending position. An item without
   788	    an ``idx`` cannot be checked and is not silently accepted.
   789	    """
   790	    for row in stream.rows:
   791	        if row.dataset_idx is None:
   792	            raise RuntimeError(
   793	                f"rotation stream position {row.position} has no dataset 'idx', so it "
   794	                "cannot be checked against its position. Refusing to report metrics."
   795	            )
   796	        if row.dataset_idx != row.position:
   797	            raise RuntimeError(
   798	                f"rotation stream position {row.position} carries dataset idx "
   799	                f"{row.dataset_idx} (target {row.target_id!r}): the dataset served a "
   800	                "different item than the sequential sampler asked for -- "
   801	                "SampleDataset substitutes a random item on a load/silence failure. "
   802	                "Refusing to report metrics."
   803	            )
   804	
