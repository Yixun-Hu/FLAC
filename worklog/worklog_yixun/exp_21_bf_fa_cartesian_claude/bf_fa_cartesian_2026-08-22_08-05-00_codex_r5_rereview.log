    64	@pytest.fixture(autouse=True)
    65	def single_thread():
    66	    """One intra-op thread (restored afterwards): the batch-64 orbit below runs
    67	    256 tiny conditioner rows, where torch's default pool spends its time
    68	    launching threads."""
    69	    prev = torch.get_num_threads()
    70	    torch.set_num_threads(1)
    71	    try:
    72	        yield
