   257	Cell = namedtuple("Cell", "arm k seed rotate_deg kind")
   258	
   259	
   260	def inventory():
   261	    """Every cell of the campaign, in execution order.
   262	
   263	    34 cells: 10 registered BFC (5 seeds x 2 K) + 4 invariance-grid angles at
   264	    K=8/seed 42 + 10 BFre + 10 P1re. The grid's 0-degree member is the registered
   265	    K8/s42 cell — shared, not re-run (plan §5).
   266	    """
   267	    cells = []
   268	    for k in KS:
   269	        for seed in SEEDS:
   270	            cells.append(Cell("BFC", k, seed, 0.0, "registered"))
   271	    for deg in GRID_ANGLES:
   272	        cells.append(Cell("BFC", GRID_K, GRID_SEED, deg, "grid"))
   273	    for arm in ("BFre", "P1re"):
   274	        for k in KS:
   275	            for seed in SEEDS:
   276	                cells.append(Cell(arm, k, seed, 0.0, "comparator"))
   277	    return cells
