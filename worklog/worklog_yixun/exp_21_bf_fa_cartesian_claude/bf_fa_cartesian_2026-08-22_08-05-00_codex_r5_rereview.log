   200	def per_scene_reasons(record):
   201	    """``[reason, ...]`` for the per-scene payload ``--record-per-scene`` writes.
   202	
   203	    The flat metrics remain the table estimand; this block is the registered
   204	    AUXILIARY estimand (the paper-style per-scene mean), and a row published
   205	    without it silently drops a deliverable the registered command produced.
   206	    """
   207	    reasons = []
   208	    by_scene = record.get("by_scene")
   209	    if not isinstance(by_scene, dict) or not by_scene:
   210	        return [f"by_scene is {by_scene!r}: the registered command passes "
   211	                "--record-per-scene, so the per-scene payload is part of the record "
   212	                "(plan §3g requires the ten room families)"]
   213	    if record.get("per_scene_schema") != PER_SCENE_SCHEMA:
   214	        reasons.append(f"per_scene_schema is {record.get('per_scene_schema', '<absent>')!r}, "
   215	                       f"not {PER_SCENE_SCHEMA}: a payload written under another schema "
   216	                       "does not mean what this gate reads")
   217	    if record.get("scene_count") != len(by_scene):
   218	        reasons.append(f"scene_count {record.get('scene_count', '<absent>')!r} != the "
   219	                       f"{len(by_scene)} scene(s) actually recorded")
   220	    got = tuple(sorted(by_scene))
   221	    if got != EXPECTED_SCENE_KEYS:
   222	        missing = [k for k in EXPECTED_SCENE_KEYS if k not in by_scene]
   223	        extra = [k for k in got if k not in EXPECTED_SCENE_KEYS]
   224	        reasons.append(
   225	            "by_scene is not the registered AR room-family grouping"
   226	            + (f"; missing {missing}" if missing else "")
   227	            + (f"; unexpected {extra}" if extra else "")
   228	            + " -- two different groupings of the same size are the same number of "
   229	              "scenes and a DIFFERENT estimand")
   230	    # Every family's payload must itself be usable evidence: the per-seed
   231	    # observation is the mean OVER these ten values, so one NaN or one missing
   232	    # T60 does not degrade the estimate, it destroys it.
   233	    for scene in sorted(set(EXPECTED_SCENE_KEYS) & set(by_scene)):
   234	        payload = by_scene[scene]
   235	        if not isinstance(payload, dict):
   236	            reasons.append(f"by_scene[{scene!r}] is {payload!r}, not a metric map")
   237	            continue
   238	        for metric in REQUIRED_SCENE_METRICS:
   239	            if metric not in payload:
   240	                reasons.append(f"by_scene[{scene!r}] does not report {metric}")
   241	            elif not _finite(payload[metric]):
   242	                reasons.append(f"by_scene[{scene!r}].{metric} = {payload[metric]!r} is not "
   243	                               "a finite number")
   244	        for metric in OPTIONAL_SCENE_METRICS:
   245	            if metric in payload and not _finite(payload[metric]):
   246	                reasons.append(f"by_scene[{scene!r}].{metric} = {payload[metric]!r} is not "
   247	                               "a finite number")
   248	    return reasons
