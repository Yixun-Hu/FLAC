   621	def validate_exp21_cell(files, repo_root=None, expected_k=None):
   622	    """``(ok, problems)`` for one exp_21 row: five registered seeds, one pin.
   623	
   624	    ``expected_k`` comes from the ROW CONTRACT and binding it is the point (the
   625	    exp_14 round-3 review B2 lesson): a homogeneous five-seed K=1 payload
   626	    renamed to match the K=8 glob would otherwise validate under the K=8 label,
   627	    and the table would publish one context size's numbers beside another's name.
   628	
   629	    Empty is not a failure - the generator already renders an empty cell as
   630	    pending, and both BFC rows are registered in advance.
   631	    """
   632	    if not files:
   633	        return True, []
   634	    try:
   635	        V = _load_exp21_validator()
   636	    except Exception as exc:                       # the gate must not fail open
   637	        return False, [f"cannot load the exp_21 validator ({exc})"]
   638	    records, problems = {}, []
   639	    for path in sorted(set(files)):
   640	        try:
   641	            with open(path) as fh:
   642	                records[path] = json.load(fh)
   643	        except (ValueError, OSError) as exc:
   644	            problems.append(f"{os.path.basename(path)}: unreadable ({exc})")
   645	    if problems:
   646	        return False, problems
   647	    seeds, ks, pins = [], set(), set()
   648	    ckpts, shas, without_sha = set(), set(), []
   649	    for path, record in sorted(records.items()):
   650	        base = os.path.basename(path)
   651	        try:
   652	            cell = V.parse_eval_name(str((record or {}).get("eval_name") or ""))
   653	        except ValueError as exc:
   654	            problems.append(f"{base}: {exc}")
   655	            continue
   656	        seeds.append(int(cell.seed))
   657	        ks.add(int(cell.k))
   658	        pins.add(str((record or {}).get("source_sha")))
   659	        ckpts.add(os.path.normpath(str((record or {}).get("ckpt_path"))))
   660	        sha = (record or {}).get(V.CKPT_SHA_FIELD)
   661	        if sha is None:
   662	            without_sha.append(base)
   663	        else:
   664	            shas.add(str(sha))
   665	        problems += [f"{base}: {r}" for r in V.validate_metrics_record(record, cell)]
   666	        problems += [f"{base}: {r}" for r in _exp21_metric_reasons(record)]
   667	        # FULL-SPLIT PROOF (r5 review BLOCKING 3). n_samples counts what the loop
   668	        # saw, and the loop counts silently substituted items too; the registered
   669	        # command therefore records the assignment stream, and the sidecar is
   670	        # REQUIRED evidence rather than an optional extra.
   671	        problems += [f"{base}: {r}" for r in V.stream_sidecar_reasons(path)]
   672	    # CHECKPOINT IDENTITY (r4 review BLOCKING 3). Every per-record rule can pass
   673	    # while the five seeds sample five DIFFERENT 40k checkpoints -- two runs of
   674	    # the same arm, or a re-run after a crash -- which is not one measurement
   675	    # with five samplings, it is five measurements wearing one label.
   676	    if len(ckpts) > 1:
   677	        problems.append(f"the cell spans MORE THAN ONE checkpoint {sorted(ckpts)}: the five "
   678	                        "seeds of a row are five samplings of ONE checkpoint")
   679	    # ...and the digest, which the eval driver now always records (r5 review
   680	    # BLOCKING 2). Path identity is only the floor: a path proves which file was
   681	    # NAMED, a digest proves which bytes were LOADED. Absence BLOCKS -- the record
   682	    # without a digest is exactly where a substituted or re-trained checkpoint
   683	    # would hide, and the per-record gate names it too, so this is the cross-record
   684	    # half only.
   685	    if without_sha:
   686	        problems.append(f"{len(without_sha)} of {len(records)} records carry no "
   687	                        f"{V.CKPT_SHA_FIELD} ({sorted(without_sha)}): an unproven "
   688	                        "checkpoint identity is not a proven one")
   689	    if len(shas) > 1:
   690	        problems.append(f"the cell spans MORE THAN ONE {V.CKPT_SHA_FIELD} {sorted(shas)}: "
   691	                        "the same path can name different bytes")
   692	    # the evidence must be the DECLARED row's, not merely self-consistent
   693	    if expected_k is not None and ks and ks != {int(expected_k)}:
   694	        problems.append(f"the row declares K={int(expected_k)} but its evidence is "
   695	                        f"K {sorted(ks)}: a renamed payload is not a re-measurement")
   696	    # exactly one record per registered seed: "no seed missing" also holds for six
   697	    # files with a duplicate, which agg_files would then average as six
   698	    if sorted(seeds) != list(V.SEEDS):
   699	        counts = {s: seeds.count(s) for s in sorted(set(seeds))}
   700	        dupes = sorted(s for s, n in counts.items() if n > 1)
   701	        problems.append(f"the cell must be exactly {len(V.SEEDS)} records, one per seed "
   702	                        f"{list(V.SEEDS)}; got {len(seeds)} with seeds {sorted(seeds)}"
   703	                        + (f" (duplicated: {dupes})" if dupes else ""))
   704	    if len(pins) > 1:
   705	        problems.append(f"the cell spans MORE THAN ONE evaluator pin {sorted(pins)}: five "
   706	                        "cells measured at different commits are not a row, they are five "
   707	                        "measurements wearing one label")
   708	    return (not problems), problems
