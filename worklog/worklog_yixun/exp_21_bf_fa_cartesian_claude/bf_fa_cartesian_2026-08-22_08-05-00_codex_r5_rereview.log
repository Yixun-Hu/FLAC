   259	def _stub(monkeypatch, tmp_path, ckpt_payload, file_training=None):
   260	    """Toy configs + a checkpoint whose embedded config the test chooses.
   261	
   262	    ``create_model_from_config`` is replaced by a FORBIDDEN stub: the binding is
   263	    required to refuse before any model exists, so a test that reaches
   264	    construction fails with a message that says so rather than with whatever the
   265	    stub would have returned.
   266	    """
   267	    model_cfg = tmp_path / "model.json"
   268	    model_cfg.write_text(json.dumps({
   269	        "model_type": "diffusion_cond", "sample_size": 64, "sample_rate": 22050,
   270	        "audio_channels": 1,
   271	        "training": file_training or {"use_ema": False, "cond_method": "fa_cartesian"},
   272	    }))
   273	    dataset_cfg = tmp_path / "dataset.json"
   274	    dataset_cfg.write_text(json.dumps({"datasets": [{"id": "toy"}]}))
   275	    ckpt = tmp_path / "toy.ckpt"
   276	    torch.save(ckpt_payload, str(ckpt))
   277	
   278	    monkeypatch.setattr(
   279	        eval_FLAC, "create_training_wrapper_from_config",
   280	        lambda cfg, model: _FakeModule())
   281	    monkeypatch.setattr(eval_FLAC, "create_dataloader_from_config", lambda *a, **k: [])
   282	    monkeypatch.setattr(
   283	        eval_FLAC, "create_metric_callback_from_config",
   284	        lambda *a, **k: types.SimpleNamespace(
   285	            update_metrics=lambda *a, **k: None,
   286	            compute_metrics=lambda split: {"T60": 1.0}))
   287	    return str(model_cfg), str(dataset_cfg), str(ckpt)
   288	
   289	
   290	def _allow_construction(monkeypatch):
   291	    monkeypatch.setattr(
   292	        eval_FLAC, "create_model_from_config",
   293	        lambda cfg: types.SimpleNamespace(load_state_dict=lambda sd, strict=False: ([], [])))
   294	
   295	
   296	def _forbid_construction(monkeypatch):
   297	    def _boom(cfg):
   298	        raise AssertionError(
   299	            "create_model_from_config was reached: the trained-as binding did not "
   300	            "refuse before model/GPU construction")
   301	    monkeypatch.setattr(eval_FLAC, "create_model_from_config", _boom)
   302	
   303	
   304	def _run(model_cfg, dataset_cfg, ckpt, **kw):
   305	    args = dict(steps=1, cfg_scale=1.0, device="cpu", eval_name="e",
   306	                cond_method="fa_cartesian", frame_avg_angles=tuple(ANGLES),
   307	                frame_avg_max_fwd_samples=EVAL_CAP, cond_autocast="bf16",
   308	                batch_size=64)
   309	    args.update(kw)
   310	    return eval_FLAC.evaluate_model(model_cfg, dataset_cfg, ckpt, **args)
   311	
