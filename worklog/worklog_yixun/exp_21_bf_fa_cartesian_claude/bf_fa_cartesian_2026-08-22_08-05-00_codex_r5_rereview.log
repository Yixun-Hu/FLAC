   121	# 2. provenance — fa_cartesian rows must carry POPULATED orbit fields
   122	# --------------------------------------------------------------------------- #
   123	def test_orbit_provenance_treats_fa_cartesian_like_fa_invariant():
   124	    """``fa_cartesian`` executes the SAME batched orbit executor, so its rows must
   125	    say so. ``("n/a", None)`` would be false provenance in the other direction
