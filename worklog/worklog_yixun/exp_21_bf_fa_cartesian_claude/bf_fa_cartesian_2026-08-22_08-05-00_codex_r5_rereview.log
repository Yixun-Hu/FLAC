   888	def check_exp21_cross_arm(cells, status):
   889	    """``(withheld_keys, problems, notes)`` — the D6 paired reading, or none of it.
   890	
   891	    ``cells`` maps ``(label, K) -> files`` across BFC *and* both comparators;
   892	    ``status`` carries each cell's already-computed validation.
   893	
   894	    A paired delta is only a delta if both sides were measured the same way. The
   895	    per-row gates prove each arm internally and CANNOT see that BFC was measured
   896	    at one evaluator commit and its comparator at another — which is precisely
   897	    the reading D6 exists to make safe. So: one ``source_sha`` across every
   898	    landed exp_21 row, or every one of them is withheld rather than published
   899	    beside numbers it must not be subtracted from.
   900	
   901	    Nothing landed yet is not a failed transaction — it is a set of rows
   902	    registered in advance, which the generator renders as pending.
   903	
   904	    THE NOTE is the other half of finding 4, and it is why this returns notes at
   905	    all. The historical B-F and P1 rows stay exactly as they are (other sessions
   906	    own that history, and this file has concurrent writers), so the
   907	    paired-vs-contextual distinction is stated HERE, about these rows, naming the
   908	    historical ones as contextual-only.
   909	    """
   910	    present = {key: files for key, files in cells.items() if files}
   911	    if not present:
   912	        return set(), [], []
   913	    problems, notes, pins = [], [], {}
   914	    for (label, k), files in sorted(present.items()):
   915	        if not status.get((label, k), False):
   916	            continue                       # its own row gate already blocked it
   917	        for path in files:
   918	            try:
   919	                with open(path) as fh:
   920	                    record = json.load(fh)
  1030	    Per-cell validation proves each arm x K block internally; it cannot see that
  1031	    the four blocks belong together. Without this, one arm could publish without
  1032	    its comparator, or the arms could be measured at different evaluator pins and
  1033	    still validate individually — and the frame-averaging delta would then be
  1034	    confounded with whatever moved between those pins, which is the one thing the
  1035	    same-pin design exists to exclude."""
  1036	    present = {key: files for key, files in q9_cells.items() if files}
  1037	    if not present:
  1038	        return []                                   # nothing landed yet: not an update
  1039	    problems = []
  1040	    if len(present) != Q9_REQUIRED_CELLS:
  1041	        missing = [f"{lbl} (K={k})" for (lbl, k), f in sorted(q9_cells.items()) if not f]
  1042	        problems.append(f"the Q9 round publishes as ONE transaction: {len(present)}/"
  1043	                        f"{Q9_REQUIRED_CELLS} cells have evidence, missing "
  1044	                        + (", ".join(missing) or "<unregistered cells>"))
  1045	    shas = {}
  1046	    for key, files in sorted(present.items()):
  1047	        for f in files:
  1048	            try:
  1049	                sha = json.load(open(f)).get("source_sha")
