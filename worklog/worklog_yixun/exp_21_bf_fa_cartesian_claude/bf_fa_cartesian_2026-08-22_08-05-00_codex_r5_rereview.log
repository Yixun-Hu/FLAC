   231	    argv = [
   232	        "python", "eval_FLAC.py",
   233	        "--model-config", REPO_RELATIVE_MODEL_CONFIGS[arm],
   234	        "--dataset-config", V.DATASET_CONFIG[int(k)],
   235	        "--ckpt-path", os.path.relpath(
   236	            resolve_ckpt(arm, root=root, placeholder=placeholder), root or repo_root()),
   237	        "--cond-method", spec["cond_method"],
   238	    ]
   239	    if spec["cond_method"] in FRAME_AVERAGED:
   240	        argv += ["--frame-avg-angles",
   241	                 ",".join(_deg_token(a) for a in V.FRAME_AVG_ANGLES),
   242	                 "--frame-avg-max-fwd-samples", str(V.FRAME_AVG_FWD_CAP)]
   243	    argv += [
   244	        "--rotate-mode", "fixed", "--rotate-deg", _deg_token(rotate_deg),
   245	        "--cond-autocast", V.COND_AUTOCAST,
   246	        "--batch-size", str(V.BATCH_SIZE),
   247	        "--cfg-scale", str(V.CFG_SCALE),
   248	        "--steps", str(V.STEPS),
   249	        "--record-per-scene",
   250	        "--record-stream", "--expected-stream-count", str(EXPECTED_COUNT),
   251	        "--seed", str(int(seed)),
   252	        "--eval-name", eval_name(arm, k, seed, rotate_deg),
