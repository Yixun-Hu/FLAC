   330	def _positional_reasons(tuples):
   331	    """Re-run eval_FLAC's substitution guard on the DURABLE payload.
   332	
   333	    ``verify_stream_positions`` (eval_FLAC.py:639) raises inside the run, so a
   334	    passing cell leaves no positive trace of it in the metrics record. The
   335	    sidecar, however, carries the whole ordered stream --- each entry is
   336	    ``[position, "<dataset_idx>|<relpath>", [context ids], img_w]`` --- so the
   337	    check is recomputable here, from evidence, by anyone.
   338	
   339	    That matters because the event it catches is silent: ``SampleDataset``
   340	    substitutes a RANDOM OTHER item on a load or silence failure, and the
   341	    substituted sample carries its own ``idx``. Position i then holds item j.
   342	    """
   343	    reasons = []
   344	    for i, entry in enumerate(tuples):
   345	        if not (isinstance(entry, list) and len(entry) == 4):
   346	            reasons.append(f"input_tuples[{i}] is {entry!r}, not "
   347	                           "[position, target_id, context_ids, img_w]")
   348	            break
   349	        position, target_id = entry[0], entry[1]
   350	        if position != i:
   351	            reasons.append(f"input_tuples[{i}] is recorded at position {position!r}: "
   352	                           "the stream is not in evaluation order")
   353	            break
   354	        head = str(target_id).split("|", 1)[0]
   355	        try:
   356	            dataset_idx = int(head)
   357	        except (TypeError, ValueError):
   358	            reasons.append(f"input_tuples[{i}] target id {target_id!r} carries no "
   359	                           "dataset index, so it cannot be checked against its "
   360	                           "position")
   361	            break
   362	        if dataset_idx != i:
   363	            reasons.append(
   364	                f"stream position {i} carries dataset idx {dataset_idx} "
   365	                f"(target {target_id!r}): the dataset served a DIFFERENT item than "
   366	                "the sequential sampler asked for -- SampleDataset substitutes a "
   367	                "random item on a load/silence failure, and the substituted sample "
   368	                "still counts toward n_samples")
   369	            break
   370	    return reasons
