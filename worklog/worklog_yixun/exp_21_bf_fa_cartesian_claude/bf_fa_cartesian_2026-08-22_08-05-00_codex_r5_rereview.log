   278	def ckpt_reasons(record, prof=None):
   279	    """``[reason, ...]`` for the checkpoint this record names.
   280	
   281	    Identity ACROSS the cell (one path, one digest) is a cross-record property
   282	    and lives with the caller; this is the per-record half: the right step, a
   283	    REQUIRED well-formed digest, and the trained-as receipt.
   284	    """
   285	    prof = prof or BFC_PROFILE
   286	    reasons = []
   287	    try:
   288	        step = parse_ckpt_step(record.get("ckpt_path"))
   289	    except ValueError as exc:
   290	        return [str(exc)]
   291	    if step != STEP:
   292	        reasons.append(f"ckpt_path {record.get('ckpt_path')!r} is at step {step}; this row "
   293	                       f"publishes the step-{STEP} checkpoint only (a substring test would "
   294	                       f"have accepted it: {STEP} is a prefix of {step} for step=400000)")
   295	    sha = record.get(CKPT_SHA_FIELD, None)
   296	    if sha is None:
   297	        reasons.append(
   298	            f"the record carries no {CKPT_SHA_FIELD}: a path proves which file was "
   299	            "NAMED, only a digest proves which bytes were LOADED, and the record "
   300	            "without one is exactly where a substituted or re-trained checkpoint "
   301	            "would hide (eval_FLAC records it for every run)")
   302	    elif not (isinstance(sha, str) and CKPT_SHA_RE.match(sha)):
   303	        reasons.append(f"{CKPT_SHA_FIELD} {sha!r} is not a lowercase 64-hex digest")
   304	
   305	    trained = record.get(TRAINED_FIELD, None)
   306	    if trained is None:
   307	        reasons.append(
   308	            f"the record carries no {TRAINED_FIELD}: cond_method records how this "
   309	            "EVALUATION conditioned, which a vanilla or B-F checkpoint would also "
   310	            "produce under --cond-method fa_cartesian. Its absence means the "
   311	            "trained-as binding did not run, so the arm is unproven (announcement 05)")
   312	    elif trained != prof["trained_cond_method"]:
   313	        reasons.append(
   314	            f"{TRAINED_FIELD} is {trained!r}: these weights were TRAINED under a "
   315	            f"different conditioning than {prof['trained_cond_method']!r}, whatever "
   316	            "the evaluation claims")
   317	    return reasons
