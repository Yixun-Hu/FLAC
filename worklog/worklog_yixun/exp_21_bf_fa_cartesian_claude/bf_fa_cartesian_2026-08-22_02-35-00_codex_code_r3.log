   350	def apply_are_addback(latents, bank, are_lambda, metadata, device):
   351	    """``z_hat + lambda * A_query`` for one batch, before the decode.
   352	
   353	    ``metadata`` is the POST-rotation metadata: ``r`` is rotation-invariant and the
   354	    LOS lookup direction co-rotates with the panorama, so the anchor is the same
   355	    under a rotated and an unrotated evaluation. That invariance is a design goal
   356	    of the port (plan §2, yaw note), which is why the add-back sits here rather
   357	    than being computed from a pre-rotation copy.
   358	    """
   359	    return apply_anchor_addback(latents, compute_are_anchors(bank, metadata, device),
   360	                                are_lambda)
