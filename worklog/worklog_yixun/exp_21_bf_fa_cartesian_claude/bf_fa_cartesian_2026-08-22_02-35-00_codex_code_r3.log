   363	def build_output_paths(
   364	    ckpt_path,
   365	    steps,
   366	    cfg_scale,
   367	    eval_name,
   368	    cond_method='vanilla',
   369	    rotate_deg=0.0,
   370	    n_angles=4,
   371	    rotate_mode='fixed',
   372	    rotate_seed=None,
   373	    are_lambda=None,
   374	):
   375	    """Construct the metrics-JSON and predictions-.pt output paths for one run.
   376	
   377	    Pure (no filesystem access): both paths sit in ``ckpt_path``'s directory,
   378	    named ``<ckpt>_<kind>_<steps>_<cfg>_<eval_name><method><rot>.<ext>``.
   379	
   380	    The vanilla + ``rotate_deg == 0`` name is byte-identical to the legacy
   381	    ``eval_FLAC`` output, so exp_01 / exp_02 artifacts reproduce exactly. A
   382	    non-vanilla ``cond_method`` inserts ``_<cond_method>_a<n_angles>`` and a
   383	    non-zero ``rotate_deg`` appends ``_rot<int(rotate_deg)>``. Both suffixes now
   384	    also land on the predictions name -- fixing the exp_02 bug where two
   385	    ``rotate_deg`` values sharing an ``eval_name`` overwrote one predictions file.
   386	
   387	    ``rotate_mode='random'`` (exp_14) replaces the angle suffix with
   388	    ``_rotrand<rotate_seed>``; the fixed-mode names are unchanged down to the byte.
   389	
   390	    Returns
   391	    -------
   392	    dict
   393	        ``{'metrics': <...>.json, 'predictions': <...>.pt}``.
   394	    """
   395	    ckpt_name = os.path.basename(ckpt_path).replace('.ckpt', '')
   396	    directory = os.path.dirname(ckpt_path)
   397	    method_suffix = '' if cond_method == 'vanilla' else f'_{cond_method}_a{n_angles}'
   398	    rot = rotation_suffix(rotate_mode, rotate_deg, rotate_seed)
   399	    stem = f'{steps}_{cfg_scale}_{eval_name}{method_suffix}{rot}{are_suffix(are_lambda)}'
   400	    return {
   401	        'metrics': os.path.join(directory, f'{ckpt_name}_metrics_{stem}.json'),
   402	        'predictions': os.path.join(directory, f'{ckpt_name}_predictions_{stem}.pt'),
   403	    }
