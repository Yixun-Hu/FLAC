   860	def split_per_scene_metrics(metrics_dict):
   861	    """``(flat_metrics, by_scene_or_None)``.
   862	
   863	    ``AcousticMetricsCallback.compute_metrics`` returns the per-scene map nested
   864	    INSIDE the metrics dict under ``by_scene``. The record keeps ``metrics`` flat
   865	    and numeric -- every existing consumer reads ``record["metrics"][key]`` as a
   866	    number, and the exp_11 row validator pins that key set exactly -- so the map
   867	    is lifted out here and recorded beside it instead.
   868	    """
   869	    if "by_scene" not in metrics_dict:
   870	        return dict(metrics_dict), None
   871	    flat = {k: v for k, v in metrics_dict.items() if k != "by_scene"}
   872	    return flat, metrics_dict["by_scene"]
