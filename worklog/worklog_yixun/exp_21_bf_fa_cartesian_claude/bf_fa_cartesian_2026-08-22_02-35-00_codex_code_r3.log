   806	def orbit_provenance(cond_method, frame_avg_max_fwd_samples=None):
   807	    """``(orbit_execution, frame_avg_fwd_cap)`` for a conditioning method.
   808	
   809	    A vanilla evaluation executes NO orbit, so labelling it ``batched`` would be
   810	    false provenance and would make a vanilla row look protocol-compatible with a
   811	    batched frame-averaged row. Every method in
   812	    :data:`FRAME_AVERAGED_COND_METHODS` runs the SAME batched executor
   813	    (``_orbit_average_batched``) under the same cap, so the provenance is
   814	    identical for all of them -- the arms differ in which conditioning function
   815	    the executor is applied to, which the ``cond_method`` field already records.
   816	
   817	    The recorded cap is the one the run ACTUALLY applied. ``None`` -> the module
   818	    default (64), which is what every historical row carries and what exp_14 pins
   819	    as the common EVALUATION cap for both arms: each arm's TRAINING cap is a
   820	    property of its checkpoint, and the comparison is between training policies,
   821	    never between evaluation policies (plan §3.1)."""
   822	    if cond_method in FRAME_AVERAGED_COND_METHODS:
   823	        return ORBIT_EXECUTION, resolve_frame_avg_cap(frame_avg_max_fwd_samples)
   824	    return "n/a", None
