   780	def resolve_weights_source(training_config, state_dict_keys):
   781	    """Which weights an evaluation will actually use: ``'ema'`` or ``'online'``.
   782	
   783	    ``evaluate_model`` swaps in EMA weights only when the config asks for them AND
   784	    the checkpoint carries ``diffusion_ema.ema_model.*`` entries; otherwise it
   785	    silently evaluates the online weights. A screen that merely *asserts* EMA in a
   786	    sidecar can therefore be wrong, so the record states what actually happened
   787	    (round-4 review B1)."""
   788	    wants_ema = bool((training_config or {}).get("use_ema", False))
   789	    has_ema = any(str(k).startswith("diffusion_ema.ema_model.") for k in state_dict_keys)
   790	    return "ema" if (wants_ema and has_ema) else "online"
