    71	# The conditioning methods this evaluator implements, and -- within them -- the
    72	# ones that execute a frame-average ORBIT.
    73	#
    74	# ONE enumeration rather than an equality test per site (exp_21 round 3). Four
    75	# places have to agree about which methods are frame-averaged: the orbit
    76	# provenance, the recorded angle list, the conditioning dispatch and the CLI. A
    77	# site that silently disagrees does not crash -- it writes a plausible record.
    78	# A row whose ``cond_method`` names an orbit method while its
    79	# ``frame_avg_angles``/``frame_avg_fwd_cap`` are null is exactly the artifact the
    80	# exp_21 admission validator rejects, and it would be rejected only after the GPU
    81	# hours that produced it.
    82	#
    83	# ``fa_invariant`` (exp_03 / B-F): cylindrical pose invariants + a C4 frame
    84	# average of the ViT depth path. ``fa_cartesian`` (exp_21 / BFC): one C4 frame
    85	# average over all four pose/geometry conditioners, poses left raw Cartesian.
    86	# They differ in the conditioning FUNCTION called and in nothing about the
    87	# evaluation protocol around it -- which is what makes them comparable.
    88	FRAME_AVERAGED_COND_METHODS = ("fa_invariant", "fa_cartesian")
    89	COND_METHODS = ("vanilla",) + FRAME_AVERAGED_COND_METHODS
