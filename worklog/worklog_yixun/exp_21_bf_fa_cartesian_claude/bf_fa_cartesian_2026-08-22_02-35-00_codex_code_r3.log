   512	def canonical_stream_hash(tuples):
   513	    """sha256 over an ordered tuple stream, in the pre-registered serialization.
   514	
   515	    One JSON array per tuple (``sort_keys=True``, ``separators=(",", ":")``),
   516	    LF-joined, UTF-8 (plan §3.3, review B5). Fixed here rather than left to
   517	    ``json`` defaults because this string is the cross-machine contract: two cells
   518	    are declared rotation-matched iff these digests agree, so whitespace or key
   519	    ordering may never depend on the writer.
   520	    """
   521	    payload = "\n".join(
   522	        json.dumps(list(t), sort_keys=True, separators=(",", ":")) for t in tuples
   523	    )
   524	    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
