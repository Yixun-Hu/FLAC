   340	def are_suffix(are_lambda=None):
   341	    """``''`` / ``'_are0'`` / ``'_are0p5'`` / ``'_are1'`` — the lambda's filename token.
   342	
   343	    Empty for a non-ARE run, so every legacy artifact name is byte-identical.
   344	    Non-empty otherwise, because AR3 evaluates ONE checkpoint at three lambdas and
   345	    they must not overwrite one another's metrics file.
   346	    """
   347	    return '' if are_lambda is None else '_are' + rot_token(are_lambda)
