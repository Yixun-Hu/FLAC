   569	def test_registered_template_parses_and_passes_every_fail_fast(tmp_path, extra, name):
   570	    """The §5 templates must be executable as written. This is a DRY check: the
   571	    process dies at the first file open, which proves argparse accepted every
   572	    flag and that the cond_method / cap / rotation / autocast validators all
   573	    passed — the four gates that would otherwise fail a real cell after it had
   574	    already been queued behind 40k training steps."""
   575	    argv = [sys.executable, "eval_FLAC.py",
   576	            "--model-config", str(tmp_path / "no_such_model_config.json"),
   577	            "--ckpt-path", str(tmp_path / "no_such.ckpt"),
   578	            "--eval-name", name] + _TEMPLATE_TAIL + extra
   579	    proc = subprocess.run(argv, capture_output=True, cwd=REPO_ROOT)
   580	    err = proc.stderr.decode()
   581	    assert proc.returncode != 0
   582	    assert "FileNotFoundError" in err, err[-3000:]
   583	    assert "no_such_model_config.json" in err
   584	    for forbidden in ("invalid choice", "unrecognized arguments",
   585	                      "Unknown cond_method", "Unknown cond_autocast",
   586	                      "frame_avg_max_fwd_samples"):
   587	        assert forbidden not in err, f"{forbidden!r} in stderr:\n{err[-3000:]}"
