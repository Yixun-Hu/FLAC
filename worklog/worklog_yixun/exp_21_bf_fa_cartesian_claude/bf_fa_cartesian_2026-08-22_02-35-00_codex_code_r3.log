   902	def _per_scene_provenance(record, by_scene):
   903	    """Add the per-scene block -- ONLY when the run actually recorded one.
   904	
   905	    Fixed-mode legacy records stay byte-identical (review B4, still binding), so
   906	    nothing is added, removed or reordered unless ``--record-per-scene`` asked
   907	    for it. An EMPTY map is refused rather than recorded: a run that asked for
   908	    per-scene results and produced none did not measure the estimand, and
   909	    recording ``{}`` would publish that silence as a fact.
   910	    """
   911	    if by_scene is None:
   912	        return record
   913	    if not isinstance(by_scene, dict) or not by_scene:
   914	        raise ValueError(
   915	            f"per-scene recording produced {by_scene!r}: a run that asked for "
   916	            "per-scene results and produced none did not measure the per-scene "
   917	            "estimand, so there is nothing to record."
   918	        )
   919	    record["by_scene"] = by_scene
   920	    record["per_scene_schema"] = PER_SCENE_SCHEMA
   921	    record["scene_count"] = len(by_scene)
   922	    return record
