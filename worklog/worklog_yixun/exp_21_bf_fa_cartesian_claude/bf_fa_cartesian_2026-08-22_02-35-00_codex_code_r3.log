   720	
   721	def apply_rotation_plan(metadata, plan, generator=None, stream=None):
   722	    """Apply one batch's yaw rotation, per the resolved :class:`RotationPlan`.
   723	
   724	    Fixed mode reproduces the legacy eval-loop branch exactly: nothing at all
   725	    happens at ``rotate_deg == 0`` (the same list object is returned, and no
   726	    ``depth`` key is required), and a non-zero angle rotates every sample by it.
   727	    Passing a ``stream`` in fixed mode (``--record-stream``) additionally records
   728	    each position with the run's CONSTANT column shift --- 0 for an unrotated Z
   729	    cell --- taken from :func:`yaw_column_shift`, the same rule the rotation
   730	    itself applies. Recording never changes what is returned.
   731	
   732	    Random mode draws the WHOLE batch's offsets first --- one contiguous slice of
   733	    the dedicated generator's stream, in item order --- and only then does any
   734	    per-sample work. That ordering is what makes the assignment independent of
   735	    how the loader chunks the split. Each sample's PRE-rotation identity is
   736	    recorded into ``stream`` before it is rotated, so the audit describes the item
   737	    rather than the rotation.
   738	
   739	    Both ``generator`` and ``stream`` are required in random mode: a missing
   740	    generator would silently draw from the global RNG (perturbing the
   741	    evaluation's own sampling noise), and a missing stream would run an
   742	    unauditable assignment. Neither is used in fixed mode.
   743	    """
   744	    if plan.is_random:
   745	        if generator is None or stream is None:
   746	            raise ValueError(
   747	                "random rotation mode requires both a dedicated generator and a "
   748	                "RotationStream: without them the assignment is neither isolated "
   749	                "from the global RNG nor auditable."
   750	            )
   751	        if len(metadata) == 0:
   752	            return metadata
   753	        img_w = _batch_img_w(metadata)
   754	        # Draw the whole batch up front, in stream order, BEFORE any per-sample work.
   755	        offsets = draw_yaw_offsets(len(metadata), img_w, generator).tolist()
   756	        angles = offsets_to_radians(offsets, img_w)
   757	        rotated = []
   758	        for md, offset, alpha in zip(metadata, offsets, angles):
   759	            stream.record(md, offset, img_w)
   760	            rotated.append(rotate_scene_metadata(md, alpha, img_w))
   761	        return rotated
   762	
   763	    # Fixed mode. With no stream and no angle there is nothing to do at all --
   764	    # not even a depth lookup, which the legacy branch never made.
   765	    if stream is None and plan.rotate_deg == 0.0:
   766	        return metadata
   767	    if len(metadata) == 0:
   768	        return metadata
   769	    img_w = _batch_img_w(metadata)
   770	    alpha_rad = math.radians(plan.rotate_deg)
   771	    if stream is not None:
   772	        dj = yaw_column_shift(alpha_rad, img_w)
   773	        for md in metadata:
   774	            stream.record(md, dj, img_w)
   775	    if plan.rotate_deg != 0.0:
   776	        return [rotate_scene_metadata(md, alpha_rad, img_w) for md in metadata]
   777	    return metadata
