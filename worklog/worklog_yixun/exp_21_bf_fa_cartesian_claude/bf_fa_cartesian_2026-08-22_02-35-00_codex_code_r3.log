   711	def _batch_img_w(metadata):
   712	    """Panorama width for a batch, from the first sample's depth map."""
   713	    if "depth" not in metadata[0]:
   714	        raise ValueError(
   715	            "yaw rotation needs the depth panorama to define the column grid, but "
   716	            "this sample's metadata has no 'depth' key."
   717	        )
   718	    return int(metadata[0]["depth"].shape[-1])
