   248	# --------------------------------------------------------------------------- #
   249	# 3. evaluate_model — acceptance, flag resolution, and what lands in the record
   250	# --------------------------------------------------------------------------- #
   251	class _RecordingConditioner:
   252	    """The raw ``MultiConditioner`` slot: records every direct call so a test can
   253	    prove the VANILLA path ran (or, for the frame-averaged methods, that it
   254	    did not)."""
   255	
   256	    def __init__(self):
   257	        self.calls = []
   258	
   259	    def __call__(self, metadata, device, **kwargs):
   260	        self.calls.append({"metadata": metadata, "device": device, "kwargs": kwargs})
   261	        return {"stub": [torch.zeros(len(metadata), 1), None]}
   262	
   263	
   264	class _FakeEvalModule:
   265	    """Minimal stand-in for the PL wrapper ``evaluate_model`` drives: chainable
   266	    ``eval()``/``requires_grad_()``/``to()``, a ``.diffusion`` with no
   267	    pretransform, and a ``.device``. With an EMPTY dataloader the eval loop body
   268	    never runs, so no conditioner, sampler or GPU is touched — the run exercises
   269	    exactly the validation, resolution and record-writing stages under test.
   270	
   271	    It also carries the handful of attributes the loop BODY reads
   272	    (``io_channels``, ``dist_shift``, ``get_conditioning_inputs``, a model with a
   273	    ``diffusion_objective``), so the dispatch tests below can drive one real
   274	    batch through it with the sampler stubbed.
   275	
   276	    Kept local rather than imported from ``test_eval_paths``: importing that
   277	    module inserts the exp_02 worklog directory into ``sys.path`` and imports its
   278	    comparator, which would make this file's collection depend on a worklog
   279	    folder a pinned worktree need not carry (the trap ``eval_FLAC._load_exp16_readback``
   280	    documents)."""
   281	
   282	    def __init__(self):
   283	        self.conditioner = _RecordingConditioner()
   284	        self.diffusion = types.SimpleNamespace(
   285	            model=types.SimpleNamespace(diffusion_objective="rectified_flow"),
   286	            pretransform=None,
   287	            conditioner=self.conditioner,
   288	            io_channels=1,
   289	            dist_shift=1.0,
   290	            get_conditioning_inputs=lambda conditioning: {},
   291	        )
   292	        self.device = "cpu"
   293	
   294	    def eval(self):
   295	        return self
   296	
   297	    def requires_grad_(self, flag):
   298	        return self
   299	
   300	    def to(self, device):
   301	        return self
   302	
   303	
   304	def _stub_eval_deps(monkeypatch, tmp_path):
   305	    """Write a toy model/dataset/ckpt triple and stub the four factories
   306	    ``evaluate_model`` calls, at the ``eval_FLAC`` namespace."""
   307	    model_cfg = tmp_path / "model.json"
   308	    model_cfg.write_text(json.dumps({
   309	        "model_type": "diffusion_cond", "sample_size": 64, "sample_rate": 22050,
   310	        "audio_channels": 1, "training": {"use_ema": False, "cond_method": "fa_cartesian"},
   311	    }))
   312	    dataset_cfg = tmp_path / "dataset.json"
   313	    dataset_cfg.write_text(json.dumps({"datasets": [{"id": "toy"}]}))
   314	    ckpt = tmp_path / "toy.ckpt"
   315	    torch.save({"state_dict": {}}, str(ckpt))
   316	
   317	    monkeypatch.setattr(
   318	        eval_FLAC, "create_model_from_config",
   319	        lambda cfg: types.SimpleNamespace(load_state_dict=lambda sd, strict=False: ([], [])),
   320	    )
   321	    monkeypatch.setattr(
   322	        eval_FLAC, "create_training_wrapper_from_config",
   323	        lambda cfg, model: _FakeEvalModule(),
   324	    )
   325	    monkeypatch.setattr(eval_FLAC, "create_dataloader_from_config", lambda *a, **k: [])
   326	    monkeypatch.setattr(
   327	        eval_FLAC, "create_metric_callback_from_config",
   328	        lambda *a, **k: types.SimpleNamespace(
   329	            update_metrics=lambda *a, **k: None,
   330	            compute_metrics=lambda split: {"T60": 1.0},
   331	        ),
   332	    )
   333	    return str(model_cfg), str(dataset_cfg), str(ckpt)
   334	
