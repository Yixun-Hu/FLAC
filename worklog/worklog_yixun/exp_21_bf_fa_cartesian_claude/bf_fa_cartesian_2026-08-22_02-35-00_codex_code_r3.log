   846	    record["rotate_seed"] = rotate_seed
   847	    record["input_hash"] = input_hash
   848	    record["assignment_hash"] = assignment_hash
   849	    record["stream_count"] = stream_count
   850	    record["img_w"] = img_w
   851	    return record
