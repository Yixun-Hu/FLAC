  1059	def check_load_integrity(missing, unexpected, allow_partial_load=False,
  1060	                         whitelist_prefixes=LOAD_WHITELIST_PREFIXES):
  1070	    n_benign = len(list(unexpected)) - len(stray)
  1071	    print(f"Checkpoint load: {len(missing)} missing, {len(stray)} stray unexpected, "
  1072	          f"{n_benign} whitelisted wrapper-leftover keys.")
  1073	    if not (missing or stray):
  1074	        return
  1075	    msg = (f"Checkpoint did not load cleanly: {len(missing)} missing keys "
  1076	           f"(first: {missing[:5]}), {len(stray)} stray unexpected keys "
  1077	           f"(first: {stray[:5]}). Wrong model-config/checkpoint pairing? "
  1078	           "Re-export the checkpoint, or pass --allow-partial-load to continue anyway.")
  1079	    if allow_partial_load:
  1080	        print("WARNING (--allow-partial-load): " + msg)
  1081	    else:
  1082	        raise RuntimeError(msg)
