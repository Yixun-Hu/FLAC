   121	
   122	class RotationPlan(NamedTuple):
   123	    """The resolved yaw-rotation protocol for one evaluation run.
   124	
   125	    ``mode='fixed'``  -- the legacy behaviour: every sample is rotated by the same
   126	    ``rotate_deg`` (0.0 meaning "not rotated at all"); ``rotate_seed`` is None.
   127	
   128	    ``mode='random'`` -- exp_14's estimand: each sample independently draws a
   129	    panorama-column offset from a generator seeded with ``rotate_seed``, so no
   130	    single angle describes the run and ``rotate_deg`` is None (recorded as JSON
   131	    ``null``), not 0.0 -- an unrotated run and a randomly-rotated one must never
   132	    be readable as the same protocol.
   133	    """
   134	    mode: str
   135	    rotate_deg: Optional[float]
   136	    rotate_seed: Optional[int]
   137	
   138	    @property
   139	    def is_random(self):
   140	        return self.mode == 'random'
   141	
   142	
   143	def resolve_rotation_plan(rotate_mode='fixed', rotate_deg=0.0, rotate_seed=None,
   144	                          eval_seed=None):
   145	    """Resolve (and validate) the rotation protocol before anything else runs.
   146	
   147	    Every failure here is a HARD error, never a silent precedence rule --- this is
   148	    the announcement-05 trap (eval-protocol flags are part of the experiment): a
   149	    mismatched flag produces plausible-looking, catastrophically wrong numbers.
   150	
   151	    - ``random`` with a non-zero ``rotate_deg``: a fixed angle and a per-sample
   152	      draw are mutually exclusive protocols, so there is no correct winner.
   153	    - ``fixed`` with an explicit ``rotate_seed``: silently ignoring it would let a
   154	      manifest record a rotation seed that influenced nothing (review B4).
   155	    - ``random`` with no seed anywhere: the assignment would be unreproducible.
   156	
   157	    In ``random`` mode an omitted ``rotate_seed`` resolves to the EVAL seed
   158	    (Yixun 2026-08-10), so a cell's rotation assignment is a function of the seed
   159	    it already reports.
   160	    """
   161	    if rotate_mode not in ROTATE_MODES:
   162	        raise ValueError(
   163	            f"Unknown rotate_mode: {rotate_mode!r}; valid options: {list(ROTATE_MODES)}."
   164	        )
   165	    if rotate_mode == 'fixed':
   166	        if rotate_seed is not None:
   167	            raise ValueError(
   168	                f"rotate_seed={rotate_seed!r} (--rotate-seed) is meaningless with "
   169	                "rotate_mode='fixed' and must not be silently ignored: a fixed rotation "
   170	                "draws nothing. Pass --rotate-mode random to use it."
   171	            )
   172	        return RotationPlan('fixed', float(rotate_deg), None)
   173	
   174	    if float(rotate_deg) != 0.0:
   175	        raise ValueError(
   176	            f"rotate_mode='random' is incompatible with rotate_deg={rotate_deg!r} "
   177	            "(--rotate-deg): a per-sample random yaw and a single fixed angle are "
   178	            "different protocols. Drop --rotate-deg (or use --rotate-mode fixed)."
   179	        )
   180	    resolved = rotate_seed if rotate_seed is not None else eval_seed
   330	
   331	    embedded_training = embedded_model_config.get("training") or {}
   332	    lam, source = resolve_are_lambda(embedded_training, are_lambda)
   333	    if lam is None:
   334	        # reachable only when a --are-lambda was passed against a config that
   335	        # declares neither key; resolve_are_lambda has already raised for that.
   336	        return None, None, None
   337	    return lam, source, dict(embedded_training[ARE_ANCHOR_KEY])
