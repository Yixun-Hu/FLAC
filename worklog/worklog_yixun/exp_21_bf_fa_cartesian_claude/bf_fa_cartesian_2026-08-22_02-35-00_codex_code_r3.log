   548	# The plan §5 registered templates, verbatim except for the two paths a dry run
   549	# must NOT have (the model config is opened first, so a nonexistent one stops the
   550	# run right after every flag has been parsed AND every fail-fast validator has
   551	# passed — no ckpt read, no model, no GPU).
   552	_TEMPLATE_TAIL = [
   553	    "--dataset-config", "src/configs/dataset_configs/AR/eval/acousticroom_unseeneval.json",
   554	    "--cond-method", "fa_cartesian",
   555	    "--frame-avg-angles", "0,90,180,270",
