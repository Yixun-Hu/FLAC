    92	def rot_suffix(rotate_deg):
    93	    """The injective filename suffix for a yaw offset: ``5.625 -> '_rot5p625'``.
    94	
    95	    Integer rotations keep their historical byte-identical form (exp_02's
    96	    ``_rot180`` artifacts must still resolve); fractional ones would collide
    97	    under ``int()`` -- R3 evaluates 5.625 deg, which used to land on ``_rot5``
    98	    alongside 5 deg -- so they get a decimal-safe form (round-4 review B3).
    99	
   100	    Exposed as its own function because the R3 EVAL NAME needs the same
   101	    rendering as the filename: five rotation rows of one cell otherwise share an
   102	    eval name, and the identity that distinguishes them lives only in a field.
   103	    """
   104	    return '' if float(rotate_deg) == 0.0 else '_rot' + rot_token(rotate_deg)
   105	
   106	
   107	def rot_token(rotate_deg):
   108	    """The decimal-safe rendering of a yaw offset, with no empty case.
   109	
   110	    ``rot_suffix`` renders 0 as the empty string so unrotated filenames stay
   111	    byte-identical to the legacy ones. An eval NAME cannot do that -- `rot` with
   112	    nothing after it is not a name -- so the R3 naming uses this instead:
   113	    ``0 -> '0'``, ``5.625 -> '5p625'``.
   114	    """
   115	    d = float(rotate_deg)
   116	    return str(int(d)) if d.is_integer() else repr(d).replace('.', 'p')
   117	
