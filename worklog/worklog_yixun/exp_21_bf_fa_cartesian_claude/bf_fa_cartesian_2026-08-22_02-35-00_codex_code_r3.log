  1002	def resolve_cond_autocast(mode):
  1003	    """Map a ``--cond-autocast`` mode to ``(enabled, dtype)`` for the conditioning call.
  1004	
  1005	    ``'default'`` -> ``(True, None)``: ``torch.amp.autocast(device)`` with no explicit
  1006	    dtype, i.e. the torch per-device default (fp16 on cuda) -- byte-identical to the
  1007	    exp_01/exp_02 protocol. ``'bf16'`` -> ``(True, torch.bfloat16)``: matches
  1008	    ``finetune_cond``'s bf16-mixed training precision. ``'off'`` -> ``(False, None)``:
  1009	    no autocast (fp32), for exactness measurements.
  1010	    """
  1011	    modes = {"default": (True, None), "bf16": (True, torch.bfloat16), "off": (False, None)}
  1012	    if mode not in modes:
  1013	        raise ValueError(f"Unknown cond_autocast: {mode!r}; valid options: {sorted(modes)}.")
  1014	    return modes[mode]
