   431	def sample_target_id(md):
   432	    """Identity of the target item at one stream position: ``'<idx>|<relpath>'``.
   433	
   434	    ``SampleDataset.__getitem__`` silently substitutes a *random other item* when
   435	    a file fails to load or is silent (``return self[random.randrange(len(self))]``),
   436	    and the substituted sample carries its OWN ``idx``/``relpath``. Recording both
   437	    is therefore what makes the stream auditable: a hash over offsets alone would
   438	    prove the RNG sequence and nothing about which item received which offset.
   439	
   440	    Falls back to the absolute ``path`` when ``relpath`` is absent (it is only set
   441	    when the file sits under a configured root). An item with neither is a
   442	    hard error: an unidentifiable position makes the whole audit worthless.
   443	    """
   444	    idx = md.get('idx', None)
   445	    rel = md.get('relpath', None) or md.get('path', None)
   446	    if rel is None:
   447	        raise ValueError(
   448	            "cannot record stream identity: metadata carries neither 'relpath' nor "
   449	            "'path'. The assignment audit (plan §3.3) requires a per-item identity."
   450	        )
   451	    return f'{idx}|{rel}'
