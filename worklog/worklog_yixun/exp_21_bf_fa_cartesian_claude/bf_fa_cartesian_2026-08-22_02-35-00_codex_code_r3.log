   875	def resolve_metrics_payload(computed, record_per_scene=False):
   876	    """``(metrics_dict, by_scene)`` — what the record will carry.
   877	
   878	    FROZEN UNLESS ASKED (round-3 closure A1/B1). The callback emits ``by_scene``
   879	    on its own for some configurations — HAA turns per-scene metrics on
   880	    independently of this flag (``metric_callback.py``) — so lifting the block
   881	    unconditionally rewrote records that never asked for it: the legacy NESTED
   882	    ``metrics["by_scene"]`` disappeared and three top-level keys appeared. That
   883	    is exactly the re-keying of historical rows the byte-compat contract exists
   884	    to prevent, and it was invisible to the snapshot matrix, whose payloads carry
   885	    no per-scene block at all.
   886	
   887	    Without the flag the callback result is passed through untouched. With it,
   888	    the block is lifted — and a callback that produced none is an error, because
   889	    the run asked for the estimand and did not measure it.
   890	    """
   891	    if not record_per_scene:
   892	        return computed, None
   893	    metrics_dict, by_scene = split_per_scene_metrics(computed)
   894	    if by_scene is None:
   895	        raise RuntimeError(
   896	            "--record-per-scene was requested but the metric callback returned no "
   897	            "per-scene block; the per-scene estimand was not measured."
   898	        )
   899	    return metrics_dict, by_scene
