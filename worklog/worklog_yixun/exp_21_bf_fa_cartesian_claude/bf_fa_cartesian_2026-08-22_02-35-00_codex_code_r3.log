   941	def build_metrics_record(metrics_dict, ckpt_path, rotate_deg, cond_method, frame_avg_angles,
   942	                         cond_autocast='default', batch_size=None, n_samples=None,
   943	                         dataset_config=None, seed=None, cfg_scale=None, steps=None,
   944	                         eval_name=None, weights_source=None, device=None,
   945	                         rotate_mode='fixed', rotate_seed=None, input_hash=None,
   946	                         assignment_hash=None, stream_count=None, img_w=None,
