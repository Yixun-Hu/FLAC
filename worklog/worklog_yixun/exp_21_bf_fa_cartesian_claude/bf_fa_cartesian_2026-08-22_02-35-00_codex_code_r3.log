   972	        "ckpt_path": ckpt_path,
   973	        "rotate_deg": rotate_deg,
   974	        "cond_method": cond_method,
   975	        "frame_avg_angles": frame_avg_angles,
   976	        "cond_autocast": cond_autocast,
   977	        "orbit_execution": execution,
   978	        "frame_avg_fwd_cap": cap,
   979	        "source_sha": source_sha(),
