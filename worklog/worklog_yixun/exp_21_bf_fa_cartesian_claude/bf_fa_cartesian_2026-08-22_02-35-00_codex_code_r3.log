   421	class StreamRow(NamedTuple):
   422	    """One position of the evaluation stream, as it was actually evaluated."""
   423	    position: int
   424	    target_id: str
   425	    context_ids: List[str]
   426	    img_w: int
   427	    offset: Optional[int]
   428	    dataset_idx: Optional[int] = None
   429	
   430	
   680	
   681	    Either failure FAILS the cell rather than reporting a number (plan §3.3).
   682	    """
   683	    got = len(stream)
   684	    if dataset_count is None:
   685	        raise RuntimeError(
   686	            "cannot verify the rotation stream: the dataset item count is unknown."
   687	        )
   688	    dataset_count = int(dataset_count)
   689	    if got != dataset_count:
   690	        raise RuntimeError(
   691	            f"rotation stream has {got} positions but the dataset holds {dataset_count} "
   692	            "items: the evaluated split does not match the configured one (dropped, "
   693	            "duplicated or substituted items). Refusing to report metrics."
   694	        )
   695	    if expected is None:
   696	        return
   697	    expected = int(expected)
   698	    if expected <= 0:
   699	        raise RuntimeError(
   700	            f"expected_stream_count must be a positive item count, got {expected}."
   701	        )
   702	    if dataset_count != expected:
   703	        raise RuntimeError(
   704	            f"rotation stream and dataset agree on {got} items, but the pre-registered "
   705	            f"split has {expected}: this cell evaluated a different split than the "
   706	            "campaign declares (announcement 01 forbids new or subsampled eval "
   707	            "configurations). Refusing to report metrics."
   708	        )
