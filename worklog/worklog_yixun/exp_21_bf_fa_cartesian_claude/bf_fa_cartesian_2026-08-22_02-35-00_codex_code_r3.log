   485	def test_the_eval_loop_calls_fa_cartesian_conditioning_for_fa_cartesian(
   486	        tmp_path, monkeypatch):
   487	    """The dispatch branch, executed. Delete it and this fails: the call list
   488	    would show the raw conditioner instead. The call SHAPE is pinned too —
   489	    conditioner, metadata and device positionally, then the angle tuple
   490	    positionally, then ``max_fwd_samples`` as a keyword — the same form the
   491	    fa_invariant branch issues, so the arms differ in the function and in nothing
   492	    about how it is invoked (round-2 call-shape discipline, extended to eval)."""
   493	    module, calls = _run_one_batch(tmp_path, monkeypatch, "fa_cartesian")
   494	
   495	    assert [c["fn"] for c in calls] == ["fa_cartesian"], calls
   496	    args, kwargs = calls[0]["args"], calls[0]["kwargs"]
   497	    assert args[0] is module.diffusion.conditioner
   498	    assert len(args[1]) == 2 and all("depth" in md for md in args[1])  # batch metadata
   499	    assert args[2] == "cpu"
   500	    assert args[3] == tuple(ANGLES)                    # angles POSITIONAL, as for fa_invariant
   501	    assert kwargs == {"max_fwd_samples": EVAL_CAP}     # cap by KEYWORD, nothing else
   502	    # ...and the raw single-pass conditioner was never used: a frame-averaged arm
   503	    # that quietly ran vanilla would still write a record claiming a C4 orbit.
   504	    assert module.conditioner.calls == []
   505	
