   432	# --------------------------------------------------------------------------- #
   433	# 3b. the CONDITIONING DISPATCH itself — which function the eval loop calls
   434	# --------------------------------------------------------------------------- #
   435	# The tests above drive evaluate_model with an EMPTY dataloader, so they never
   436	# execute the loop body: deleting the fa_cartesian dispatch branch would leave
   437	# every one of them green while the arm silently evaluated as VANILLA — a
   438	# single-pass conditioning reported under a record that claims a C4 orbit, which
   439	# is the announcement-05 failure in its worst form (plausible numbers, wrong
   440	# arm). That is the exact coverage defect the r2 review caught on the training
   441	# side, so the branch gets its own pin: one real batch through the loop, with
   442	# only the sampler stubbed.
   443	def _one_batch_loader(n=2):
   444	    """A dataloader of exactly one batch: (reals, metadata) with real depth
   445	    panoramas and poses, since the loop's metric stage reads md['depth'],
   446	    md['source'] and md['scene']."""
   447	    return [(torch.zeros(n, 1, 64), _batch(n))]
   448	
   449	
   450	def _spy_conditioning(monkeypatch):
   451	    """Replace both frame-average entry points with recording spies (at the
   452	    eval_FLAC namespace, which is where the dispatch resolves them)."""
   453	    calls = []
   454	
   455	    def make(name):
   456	        def spy(*args, **kwargs):
   457	            calls.append({"fn": name, "args": args, "kwargs": kwargs})
   458	            return {"stub": [torch.zeros(len(args[1]), 1), None]}
   459	        return spy
   460	
   461	    monkeypatch.setattr(eval_FLAC, "fa_cartesian_conditioning", make("fa_cartesian"))
   462	    monkeypatch.setattr(eval_FLAC, "invariant_conditioning", make("fa_invariant"))
   463	    monkeypatch.setattr(
   464	        "src.inference.sampling.sample_discrete_euler",
   465	        lambda model, noise, steps, **kw: torch.zeros_like(noise),
   466	    )
   467	    return calls
   468	
   469	
   470	def _run_one_batch(tmp_path, monkeypatch, cond_method, **kwargs):
   471	    model_cfg, dataset_cfg, ckpt = _stub_eval_deps(monkeypatch, tmp_path)
   472	    module = _FakeEvalModule()
   473	    monkeypatch.setattr(
   474	        eval_FLAC, "create_training_wrapper_from_config", lambda cfg, model: module)
   475	    monkeypatch.setattr(
   476	        eval_FLAC, "create_dataloader_from_config", lambda *a, **k: _one_batch_loader())
   477	    calls = _spy_conditioning(monkeypatch)
   478	    eval_FLAC.evaluate_model(
   479	        model_cfg, dataset_cfg, ckpt, steps=1, cfg_scale=1.0, device="cpu",
   480	        eval_name="disp", cond_method=cond_method, cond_autocast="bf16",
   481	        frame_avg_max_fwd_samples=EVAL_CAP, **kwargs)
   482	    return module, calls
   483	
