   793	def source_sha():
   794	    """Short-circuited ``git rev-parse HEAD`` for provenance; ``'unknown'`` if git
   795	    is unavailable. Provenance must never be able to break an evaluation."""
   796	    try:
   797	        out = subprocess.check_output(
   798	            ["git", "rev-parse", "HEAD"], cwd=os.path.dirname(os.path.abspath(__file__)),
   799	            stderr=subprocess.DEVNULL, timeout=10,
   800	        )
   801	        return out.decode().strip() or "unknown"
   802	    except Exception:
   803	        return "unknown"
