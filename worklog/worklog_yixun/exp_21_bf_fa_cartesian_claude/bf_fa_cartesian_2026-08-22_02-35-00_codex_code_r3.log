   590	# --------------------------------------------------------------------------- #
   591	# 5. the EVAL chunk plan (plan §3h item 10) — NO-CHANGE PIN on §2's split
   592	# --------------------------------------------------------------------------- #
   593	def test_eval_batch_64_needs_cap_64_and_cap_32_is_refused():
   594	    """NO-CHANGE PIN. The plan declares TRAINING and EVAL chunk plans separately:
   595	    training runs cap 32 at micro-batch 32 (one angle per chunk), evaluation runs
   596	    batch 64 and therefore REQUIRES cap >= 64 — a chunk is whole angles and cannot
   597	    be split below one. Pinned against the function the eval path calls, so the
   598	    §5 template's ``--frame-avg-max-fwd-samples 64`` is a checked requirement
   599	    rather than a convention: at cap 32 the registered command would abort on the
   600	    first batch, hours into a queued cell."""
   601	    md = _batch(64)
   602	    cond = _build_cond()
   603	    out = yr.fa_cartesian_conditioning(cond, md, "cpu", C4, max_fwd_samples=64)
   604	    # batch 64, cap 64 -> one angle per chunk: the base pass plus three chunks.
