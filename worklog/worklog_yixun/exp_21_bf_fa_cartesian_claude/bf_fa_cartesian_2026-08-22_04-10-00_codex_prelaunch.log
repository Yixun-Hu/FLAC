   308	def azimuth_rotation_matrix(alpha_rad: float) -> torch.Tensor:
   309	    """
   310	    Build a 3x3 rotation matrix about the vertical (z) axis.
   311	
   312	    Parameters
   313	    ----------
   314	    alpha_rad : float
   315	        Rotation angle in radians. Positive values rotate the (x, y) plane
   316	        counter-clockwise, which corresponds to increasing azimuth.
