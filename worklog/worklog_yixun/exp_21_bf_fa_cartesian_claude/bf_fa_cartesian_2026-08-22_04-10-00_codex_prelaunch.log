   376	def preflight(arm, root=None):
   377	    """Hold ``arm``'s checkpoint to its contract -- BOTH halves. Returns its sha256.
   378	
   379	    A cheap, GPU-free gate the driver runs ONCE per arm, before that arm's cells,
   380	    so a wrong-arm campaign costs one checkpoint read rather than ten evaluations.
   381	
   382	    Two independent things are checked, and a failure of either ABORTS (r5
   383	    re-review, BLOCKING 3 -- it used to print whatever digest it encountered and
   384	    continue, which made it a label rather than a gate):
   385	
   386	    * the embedded training config IS this arm's (what the weights were trained as);
   387	    * the file's bytes ARE the reviewed artifact's, where one is pinned. BFC pins
   388	      nothing because it has not trained yet; its uniformity is enforced across
   389	      its own cells by the table gate instead.
   390	    """
   391	    root = root or repo_root()
   392	    path = resolve_ckpt(arm, root=root)
   393	    reasons = check_embedded_training(_load_embedded_config(path), arm)
   394	    if reasons:
   395	        raise SystemExit("TRAINED-AS PREFLIGHT FAILED for " + arm + ":\n  - "
   396	                         + "\n  - ".join(reasons))
   397	    digest = _file_sha256(path)
   398	    want = ARMS[arm].get("ckpt_sha256")
   399	    if want is not None and digest != want:
   400	        raise SystemExit(
   401	            f"CHECKPOINT DIGEST PREFLIGHT FAILED for {arm}: {path} hashes to\n"
   402	            f"  {digest}\nbut the reviewed comparator artifact is\n  {want}\n"
   403	            "These are not the same bytes, so this is not the comparator the "
   404	            "campaign approved -- refusing to evaluate it under that row's name.")
   405	    return digest
