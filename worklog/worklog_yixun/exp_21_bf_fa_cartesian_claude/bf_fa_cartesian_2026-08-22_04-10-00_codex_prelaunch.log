   295	def _type_strict_equal(got, want):
   296	    """Equality that does NOT let ``1`` pass for ``1.0`` — element-wise.
   297	
   298	    Python compares ``[0, 90, 180, 270] == [0.0, 90.0, 180.0, 270.0]`` as True and
   299	    both are ``list``, so a container-level type check misses exactly the drift
   300	    this is here to catch (caught by test, not by inspection). The factory
   301	    distinguishes the two, so this must as well.
   302	    """
   303	    if type(got) is not type(want):
   304	        return False
   305	    if isinstance(want, list):
   306	        return (len(got) == len(want)
   307	                and all(_type_strict_equal(g, w) for g, w in zip(got, want)))
   308	    if isinstance(want, dict):
   309	        return (set(got) == set(want)
   310	                and all(_type_strict_equal(got[k], want[k]) for k in want))
   311	    return got == want
