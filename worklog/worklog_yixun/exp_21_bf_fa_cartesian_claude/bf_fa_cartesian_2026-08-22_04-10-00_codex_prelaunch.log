   352	class MultiConditioner(nn.Module):
   353	    """
   354	    A module that applies multiple conditioners to an input dictionary based on the keys
   355	
   356	    Args:
   357	        conditioners: a dictionary of conditioners with keys corresponding to the keys of the conditioning input dictionary (e.g. "prompt")
   358	        default_keys: a dictionary of default keys to use if the key is not in the input dictionary (e.g. {"prompt_t5": "prompt"})
   359	    """
   360	    def __init__(self, conditioners: tp.Dict[str, Conditioner], default_keys: tp.Dict[str, str] = {}, pre_encoded_keys: tp.List[str] = []):
   361	        super().__init__()
   362	
   363	        self.conditioners = nn.ModuleDict(conditioners)
   364	        self.default_keys = default_keys
   365	        self.pre_encoded_keys = pre_encoded_keys
   366	
   367	    def forward(self, batch_metadata: tp.List[tp.Dict[str, tp.Any]], device: tp.Union[torch.device, str], only_ids: tp.Optional[tp.Iterable[str]] = None) -> tp.Dict[str, tp.Any]:
   368	        # only_ids: when given, run (and return) exactly the conditioners whose id
   369	        # is in this collection; default None keeps the full behaviour unchanged.
   370	        # Used by yaw_rotation.invariant_conditioning to re-run only the ViT
   371	        # conditioners per rotation frame without re-running stateful non-ViT ones.
   372	        output = {}
   373	
   374	        for key, conditioner in self.conditioners.items():
   375	            if only_ids is not None and key not in only_ids:
   376	                continue
   377	            condition_key = key
   378	
   379	            conditioner_inputs = []
   380	
   381	            for x in batch_metadata:
   382	                if condition_key not in x:
   383	                    if condition_key in self.default_keys:
   384	                        condition_key = self.default_keys[condition_key]
   385	                    else:
   386	                        raise ValueError(f"Conditioner key {condition_key} not found in batch metadata")
   387	                
   388	                if conditioner.name == 'GeometryConditioner':
   389	                    add_input = 'depth'
   390	                    if add_input not in x:
   391	                        raise ValueError(f"Conditioner {key} requires depth input, but it is not present in the batch metadata")
   392	                    else:
   393	                        if isinstance(x[condition_key], list) or isinstance(x[condition_key], tuple) and len(x[condition_key]) == 1:
   394	                            coord = x[condition_key][0]
   395	                        else: 
   396	                            coord = x[condition_key]
   397	                    if isinstance(x[add_input], list) or isinstance(x[add_input], tuple) and len(x[add_input]) == 1:
   398	                        conditioner_input = {'coord': coord, 'depth': x[add_input][0]}
   399	                    else:
   400	                        conditioner_input = {'coord': x[condition_key], 'depth': x[add_input]}
   401	
   402	                else:
   403	                    #Unwrap the condition info if it's a single-element list or tuple, this is to support collation functions that wrap everything in a list
   404	                    if isinstance(x[condition_key], list) or isinstance(x[condition_key], tuple) and len(x[condition_key]) == 1:
   405	                        conditioner_input = x[condition_key][0]
   406	                    else:
   407	                        conditioner_input = x[condition_key]
   408	
   409	                conditioner_inputs.append(conditioner_input)
