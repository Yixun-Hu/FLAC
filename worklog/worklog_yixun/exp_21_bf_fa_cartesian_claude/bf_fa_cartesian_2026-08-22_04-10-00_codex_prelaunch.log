    80	    ir_file_name = ir_file_path.split("/")[-1]
    81	    src_node, rec_node = int(ir_file_name.split("_")[0][1:]), int(ir_file_name.split("_")[1][1:])
    82	    json_file_name = "S00" + str(src_node) + "_R00" + str(rec_node) + ".json"
    83	    metadata_file_path = os.path.join(metadata_path, scene_name, scene_id, json_file_name)
    84	    with open(metadata_file_path, "r") as fin:
