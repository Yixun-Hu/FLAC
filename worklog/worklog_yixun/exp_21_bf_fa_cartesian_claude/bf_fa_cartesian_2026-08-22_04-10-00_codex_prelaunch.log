   694	def _orbit_average_batched(conditioner, md_inv, base, present, angles, img_w, device,
   695	                           cap=None, cap_is_explicit=False):
   696	    """Same orbit sum as :func:`_orbit_average_loop`, executed as a few large forwards.
   697	
   698	    The rotated variants of consecutive angles are concatenated along the batch
   699	    dimension into chunks of at most ``cap`` samples (default
   700	    :data:`FRAME_AVG_MAX_FWD_SAMPLES`; whole angles per chunk, so a chunk is
   701	    ``k * B`` samples), each chunk is one conditioner call, and the stacked output
   702	    is split back per angle. Terms are accumulated in the INPUT ANGLE ORDER
   703	    starting from the angle-0 base, so the additions are never reassociated: the
   704	    averaging arithmetic is identical to the loop.
   705	
   706	    ``cap_is_explicit`` only selects which knob the over-cap error names — the
   707	    module constant, or the config key that overrode it. A caller that hands us a
   708	    cap it read from a config must not be told to edit a module global.
   709	
   710	    What is NOT identical is the augmentation schedule under train-mode DINOv3:
   711	    its random RoPE rescale is drawn once per forward, so a chunk's angles share
   712	    a draw (see :data:`FRAME_AVG_MAX_FWD_SAMPLES` for the disclosure). In eval
   713	    mode there is no such draw and the two paths agree numerically.
   714	
   715	    Only the ``present`` (ViT) ids are re-run; masks come from the base pass.
   716	    A batch larger than the cap is rejected rather than silently exceeding it,
   717	    because a chunk cannot be smaller than one angle.
   718	    """
   719	    accum = {i: base[i][0].clone() for i in present}
   720	    rest = angles[1:]
   721	    if not rest:
   722	        return accum
   723	    if cap is None:
   724	        cap = FRAME_AVG_MAX_FWD_SAMPLES
   725	    cap_name = ("training.frame_avg_max_fwd_samples" if cap_is_explicit
   726	                else "FRAME_AVG_MAX_FWD_SAMPLES")
   727	    batch = len(md_inv)
   728	    if batch > cap:
   729	        raise ValueError(
   730	            f"batch {batch} exceeds {cap_name} "
   731	            f"({cap}): a frame-average chunk is whole angles, so it "
   732	            "cannot be split below one angle -- lower the batch or raise the cap deliberately"
   733	        )
   734	    angles_per_chunk = max(1, cap // batch)
   735	    for start in range(0, len(rest), angles_per_chunk):
   736	        chunk = rest[start:start + angles_per_chunk]
   737	        stacked = []
   738	        for g in chunk:
   739	            stacked.extend(_rotated_variants(md_inv, g, img_w, present))
   740	        part = conditioner(stacked, device, only_ids=present)
   741	        for i in present:
   742	            out = part[i][0]
   743	            if out.shape[0] != len(chunk) * batch:
   744	                raise RuntimeError(
   745	                    f"{i}: batched orbit forward returned {out.shape[0]} rows for "
   746	                    f"{len(chunk)} angle(s) x {batch} sample(s)"
   747	                )
   748	            for k in range(len(chunk)):          # ascending angle order preserved
   749	                accum[i] = accum[i] + out[k * batch:(k + 1) * batch]
   750	    return accum

