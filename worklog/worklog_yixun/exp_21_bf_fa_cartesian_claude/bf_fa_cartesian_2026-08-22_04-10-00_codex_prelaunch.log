   160	def offsets_to_radians(offsets: Sequence, img_w: int) -> List[float]:
   161	    """
   162	    Convert panorama-column offsets to yaw angles in radians: ``d * 2*pi / img_w``.
   163	
   164	    Exact by construction on the column grid — :func:`rotate_scene_metadata`
   165	    re-quantises the angle back to ``round(alpha * img_w / 2pi) % img_w`` and
   166	    recovers the same ``d`` for every offset in the support (pinned by test), so
   167	    the recorded offset and the applied rotation can never disagree.
   168	
   169	    Parameters
   170	    ----------
   171	    offsets : Sequence
   172	        Column offsets: a ``torch.Tensor``, list, or any iterable of integers.
   173	    img_w : int
   174	        Panorama width in columns.
   175	
   176	    Returns
   177	    -------
   178	    List[float]
   179	        One angle in radians per offset, in the input order.
   180	    """
   181	    img_w = int(img_w)
   182	    if img_w <= 0:
   183	        raise ValueError(f"img_w must be > 0, got {img_w}")
   184	    if isinstance(offsets, torch.Tensor):
   185	        offsets = offsets.tolist()
   186	    return [float(int(d)) * 2.0 * math.pi / float(img_w) for d in offsets]
   187	
   188	
   189	def cylindrical_pose_features(
   190	    md: Dict[str, object], eps: float = 1e-6
   191	) -> Dict[str, object]:
   192	    """
   193	    Replace absolute pose vectors with yaw-invariant cylindrical features.
   194	
   195	    Each pose ``(x, y, z)`` becomes ``(r, z, dphi)`` where ``r = sqrt(x^2 + y^2)``
   196	    and ``dphi`` is the azimuth measured *relative* to a scene-intrinsic reference
   197	    azimuth. Because every azimuth in a rigidly yaw-rotated scene shifts by the
   198	    same amount, the relative ``dphi`` (and ``r``, ``z``) are invariant under any
   199	    yaw rotation, making these features an exact invariant of the C-infinity yaw
   200	    group.
   201	
   202	    The reference azimuth is the target source's azimuth. If the source lies on
   203	    the vertical axis (``r_s < eps``, azimuth undefined) the reference falls back
   204	    to the azimuth of the largest-``r`` pose among ``{source, context poses}`` --
   205	    still a scene-intrinsic quantity, so invariance is preserved in the fallback.
   206	    If *every* pose is degenerate (largest ``r`` also ``< eps``) every ``dphi``
   207	    is exactly ``0``.
   208	
   209	    Only ``'source'`` and ``'context_poses'`` are transformed; ``'*_vit'`` poses,
   210	    ``'depth'`` and all other keys pass through untouched (same objects). The
   211	    input dict is not mutated: a shallow copy is returned with fresh tensors for
   212	    the replaced keys, preserving each pose tensor's dtype and device.
   213	
   214	    Parameters
   215	    ----------
   216	    md : Dict[str, object]
   217	        One per-sample metadata dict. ``'source'`` (shape ``[3]``) and, optionally,
   218	        ``'context_poses'`` (shape ``[N, 3]``) are read; the last dimension is
   219	        ordered ``(x, y, z)``.
   220	    eps : float, optional
   221	        Radius below which a pose azimuth is treated as undefined (default 1e-6).
   222	
   223	    Returns
   224	    -------
   225	    Dict[str, object]
   226	        A shallow copy of ``md`` with ``'source'`` -> ``(r_s, z_s, 0.0)`` and each
   227	        ``'context_poses'`` row -> ``(r_i, z_i, wrap(phi_i - phi_ref))``.
   228	    """
   229	    out: Dict[str, object] = dict(md)
   230	
   231	    source = md.get("source")
   232	    context = md.get("context_poses")
   233	
   234	    # Candidate poses for the fallback reference azimuth: source + context rows.
   235	    cand_r = []
   236	    cand_phi = []
   237	
   238	    r_s = phi_s = sz = None
   239	    if source is not None:
   240	        assert isinstance(source, torch.Tensor)
   241	        sx, sy, sz = source[..., 0], source[..., 1], source[..., 2]
   242	        r_s = torch.sqrt(sx * sx + sy * sy)
   243	        phi_s = torch.atan2(sy, sx)
   244	        cand_r.append(r_s.reshape(1))
   245	        cand_phi.append(phi_s.reshape(1))
   246	
   247	    r_c = phi_c = cz = None
   248	    if context is not None:
   249	        assert isinstance(context, torch.Tensor)
   250	        cx, cy, cz = context[..., 0], context[..., 1], context[..., 2]
   251	        r_c = torch.sqrt(cx * cx + cy * cy)
   252	        phi_c = torch.atan2(cy, cx)
   253	        cand_r.append(r_c.reshape(-1))
   254	        cand_phi.append(phi_c.reshape(-1))
   255	
   256	    # Reference azimuth: target source, unless degenerate -> largest-r pose.
   257	    # The fallback pose must itself be non-degenerate (its azimuth defined);
   258	    # if even the largest r is < eps the scene is all-degenerate -> dphi == 0.
   259	    phi_ref = None
   260	    if r_s is not None and bool(r_s >= eps):
   261	        phi_ref = phi_s
   262	    elif cand_r:
   263	        all_r = torch.cat(cand_r)
   264	        all_phi = torch.cat(cand_phi)
   265	        max_idx = int(torch.argmax(all_r))
   266	        if bool(all_r[max_idx] >= eps):
   267	            phi_ref = all_phi[max_idx]
   268	
   269	    if source is not None:
   270	        out["source"] = torch.stack([r_s, sz, torch.zeros_like(r_s)])
   271	
   272	    if context is not None:
   273	        if phi_ref is not None:
   274	            dphi = wrap_angle(phi_c - phi_ref)
   275	        else:
   276	            dphi = torch.zeros_like(r_c)
   277	        out["context_poses"] = torch.stack([r_c, cz, dphi], dim=-1)
   278	
   279	    return out
