   135	
   136	
   137	def compare(label, a, b, tol):
   138	    """``(ok, worst)`` over every conditioning id, printing the per-id max abs diff."""
   139	    assert set(a) == set(b), f"{label}: id sets differ, {sorted(a)} vs {sorted(b)}"
