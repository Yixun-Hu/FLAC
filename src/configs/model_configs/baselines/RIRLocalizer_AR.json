{
    "model_type": "rir_coordinate_localizer",
    "sample_size": 10240,
    "sample_rate": 22050,
    "audio_channels": 1,
    "model": {
        "architecture": "resnet18",
        "feature_dimensions": 512,
        "output_dimensions": 3
    },
    "preprocessing": {
        "n_fft": 511,
        "hop_length": 40,
        "win_length": 248,
        "log_epsilon": 1e-8,
        "input_normalization": "none"
    },
    "training": {
        "batch_size": 128,
        "num_workers": 12,
        "validation_room_fraction": 0.1,
        "learning_rate": 0.0001,
        "minimum_learning_rate": 0.000001,
        "weight_decay": 0.0001,
        "optimizer_betas": [0.9, 0.999],
        "optimizer_epsilon": 1e-8,
        "max_steps": 30000,
        "warmup_steps": 1000,
        "validation_every_steps": 1000,
        "early_stopping_patience": 6,
        "gradient_clip_norm": 1.0,
        "precision": "bf16-mixed",
        "augmentation": "none",
        "loss": "meter_l1_distance",
        "coordinate_target": "source_xyz_minus_receiver_xyz_meters",
        "sampler": "room_balanced"
    }
}
